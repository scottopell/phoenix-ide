diff --git a/lib/phoenix.d.ts b/lib/phoenix.d.ts
new file mode 100644
index 0000000..652900c
--- /dev/null
+++ b/lib/phoenix.d.ts
@@ -0,0 +1,38 @@
+import type {Chunk, Event, InitialConstruct, ParseContext, ParseOptions, Point, Token, TokenizeContext} from 'micromark-util-types'
+export {preprocess} from './preprocess.js'
+export {postprocess} from './postprocess.js'
+export {document} from './initialize/document.js'
+
+export interface PhoenixParseContext extends ParseContext {
+  /** Called only before a new root flow, outside containers. True requires
+   * setting the document control's stop flag; it yields without consuming. */
+  onRootFlow?: (point: Point) => boolean
+}
+export function parse(options?: ParseOptions | null): PhoenixParseContext
+
+export interface TokenizerControl {
+  /** Terminal yield for this session; not a resumable pause. */
+  stop?: boolean
+  /** Observes an outer container exit, including speculative exits. */
+  onContainerExit?: (token: Token) => void
+}
+export interface BorrowedControl extends TokenizerControl {
+  readonly tape: readonly Chunk[]
+  /** Exclusive source offset at which to supply EOF without advancing. */
+  readonly end?: number
+}
+export interface WritableControl extends TokenizerControl {
+  tape?: never
+  end?: never
+}
+export interface ControlledContext extends TokenizeContext {
+  readonly containerDepth: number
+  /** Runs the existing tape without final resolution; events are session-owned. */
+  run(): Event[]
+}
+export interface BorrowedContext extends ControlledContext {
+  /** Borrowed tape cannot be appended to (also rejected at runtime). */
+  write: never
+}
+export function createTokenizer(parser: ParseContext, initialize: InitialConstruct, from: Point, control: BorrowedControl): BorrowedContext
+export function createTokenizer(parser: ParseContext, initialize: InitialConstruct, from?: Omit<Point, '_bufferIndex' | '_index'>, control?: WritableControl): ControlledContext
