-- allium: 3
-- windowing.allium
--
-- MessageList Bottom-Anchored Window: Behavioural Specification
--
-- Scope: The lifecycle of the virtualized window that the message list
--        maintains over the historicalUnits list produced by the
--        render_units transform. Models the window's mount, expansion,
--        scroll-restore, and pinned-to-bottom states; the
--        IntersectionObserver-driven boundary expansion; the exact
--        scroll-compensation pattern that prevents visible jumps; and
--        the saved-scroll anchor by unit key.
--
-- Includes: Initial-mount window placement; bottom-pinned auto-anchor
--           on async message arrival; user scroll-up detection;
--           sentinel-intersection expansion; scroll-compensation
--           layout effect; saved-anchor save (on hide/unmount);
--           saved-anchor restore (on first paint); measured-height
--           cache reads for spacer geometry; pin-to-bottom on new
--           message arrival when the user is at the bottom.
--
-- Excludes: render_units transform (see render_units.allium);
--           individual unit rendering (MessageComponents.tsx, no spec);
--           localStorage / sessionStorage serialization format details
--           (see design.md).
--
-- Uses: render_units (HistoricalUnit, TailUnit types).
use "./render_units.allium" as ru

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- A saved-scroll anchor written on visibility-hidden / unmount and
-- read on first mount with a non-empty historicalUnits list. The
-- anchor identifies a unit by key (structural) and the per-pixel
-- offset from that unit's top to the viewport top (positional within
-- the unit). Together they restore the viewport to the same content
-- the user was looking at, independent of any intervening row-height
-- variation in the prefix.
value SavedScrollAnchor {
    top_visible_unit_key: String
    offset_within_unit: Integer
}

-- The measured height of a rendered historical unit, written by a
-- ResizeObserver callback. Lookups are O(1) by key; absence is
-- explicitly representable so the spacer-height computation can
-- fall back to a per-kind estimate.
value MeasuredHeight {
    unit_key: String
    height_px: Integer
}

-- Per-kind height estimate, used when no MeasuredHeight is cached
-- for a given unit key. Keyed by HistoricalKind from render_units.
value KindEstimate {
    kind: ru.HistoricalKind
    estimate_px: Integer
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- The window's lifecycle phase. Models what the window is doing right
-- now from the user's perspective: pinned to bottom watching for new
-- content; scrolled up and holding position; actively expanding the
-- visible range on the user's behalf; restoring from a saved anchor.
enum WindowPhase {
    pinned_to_bottom
    user_scrolled_up
    expanding
    restoring_from_anchor
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- The window's state. One per mounted MessageList instance; the
-- conversation_id forms the natural key (mounting a new conversation
-- starts a new Window).
entity Window {
    conversation_id: String?
    historical_units: List<ru.HistoricalUnit>
    tail_units: List<ru.TailUnit>

    first_rendered_unit_index: Integer
    is_pinned_to_bottom: Boolean
    phase: WindowPhase

    measured_heights: Map<String, Integer>
    saved_anchor: SavedScrollAnchor?

    -- Captured pre-update scrollHeight for exact scroll compensation.
    -- Non-null only between the expand trigger and the post-render
    -- layout effect that consumes the delta. Otherwise null.
    pre_expand_scroll_height: Integer?

    -- The Builder's transitions field is the closest analog from
    -- render_units; here phase is set explicitly by rules.
}

------------------------------------------------------------
-- Constants
------------------------------------------------------------
-- INITIAL_WINDOW = 12 (units rendered on default mount)
-- EXPAND_BATCH = 12 (units revealed per sentinel intersection)
-- RESTORE_OVERSCAN = 4 (extra units rendered above an anchor target)
-- SENTINEL_ROOT_MARGIN = "600px 0px 0px 0px"
-- KIND_ESTIMATES = { user: 100, skill: 80, agent_turn: 400, system: 100 }

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

-- The useBottomAnchoredWindow hook, mounted inside MessageList. The
-- actor anchors the Window entity to a concrete runtime consumer.
actor BottomAnchoredWindow {
    identified_by: Window
}

------------------------------------------------------------
-- Rules — initial mount
------------------------------------------------------------

-- Fresh mount with NO saved anchor → bottom-pinned. The window starts
-- showing the last INITIAL_WINDOW units; the scroll container is
-- scrolled to its bottom such that the last historical unit and all
-- tail units are visible.
rule MountWithoutSavedAnchor {
    when: WindowMounted(w, historical, tail, anchor)

    requires: anchor = null

    ensures: w.historical_units = historical
    ensures: w.tail_units = tail
    ensures: w.first_rendered_unit_index = max_int(0, len(historical) - 12)
    ensures: w.is_pinned_to_bottom = true
    ensures: w.phase = "pinned_to_bottom"
    ensures: w.pre_expand_scroll_height = null
    ensures: w.measured_heights = empty_map()
    ensures: w.saved_anchor = null

    @guidance
        -- The scroll-to-bottom side effect happens in a useLayoutEffect
        -- after the first paint: scrollRoot.scrollTop =
        -- scrollRoot.scrollHeight. Bottom-pin survives async message
        -- arrival via the AutoAnchorOnNewMessages rule below.
}

-- Fresh mount WITH saved anchor whose key is in the historical list →
-- restore. The window opens wide enough to render the target unit
-- with RESTORE_OVERSCAN units above it; phase is restoring_from_anchor
-- until a post-paint scroll completes the restore.
rule MountWithSavedAnchorFound {
    when: WindowMounted(w, historical, tail, anchor)

    requires: anchor != null
    requires: anchor_key_in_units(historical, anchor)

    ensures: w.historical_units = historical
    ensures: w.tail_units = tail
    ensures: w.first_rendered_unit_index = max_int(
                 0,
                 index_of_unit_by_key(historical, anchor.top_visible_unit_key) - 4
             )
    ensures: w.is_pinned_to_bottom = false
    ensures: w.phase = "restoring_from_anchor"
    ensures: w.pre_expand_scroll_height = null
    ensures: w.saved_anchor = anchor

    @guidance
        -- After the first paint, a useLayoutEffect locates the unit's
        -- DOM node via the ref-map and sets scrollRoot.scrollTop to
        -- (node.offsetTop + anchor.offset_within_unit). The
        -- AnchorRestoreCompleted rule then transitions phase out of
        -- restoring_from_anchor.
        --
        -- offsetTop accuracy on first paint depends on the prefix
        -- spacer height being exact: that is what REQ-MLRU-013's
        -- sessionStorage height cache provides. With the cache,
        -- the restore lands precisely; without it, a single
        -- post-measurement reflow corrects the position.
}

-- Fresh mount WITH saved anchor whose key is NOT in the historical
-- list (message deleted, conversation rebuilt) → fall back to
-- bottom-pin. The stale anchor is cleared so subsequent saves do not
-- re-attempt the missing target.
rule MountWithSavedAnchorMissing {
    when: WindowMounted(w, historical, tail, anchor)

    requires: anchor != null
    requires: not anchor_key_in_units(historical, anchor)

    ensures: w.historical_units = historical
    ensures: w.tail_units = tail
    ensures: w.first_rendered_unit_index = max_int(0, len(historical) - 12)
    ensures: w.is_pinned_to_bottom = true
    ensures: w.phase = "pinned_to_bottom"
    ensures: w.pre_expand_scroll_height = null
    ensures: w.saved_anchor = null

    @guidance
        -- The fall-back to bottom-pin is identical to
        -- MountWithoutSavedAnchor. Clearing saved_anchor (rather than
        -- preserving it) prevents repeated stale-lookup work on
        -- subsequent visibility-hidden saves.
}

-- Anchor restore complete → phase transitions out of
-- restoring_from_anchor. Subsequent user interaction routes through
-- the scroll-driven rules below.
rule AnchorRestoreCompleted {
    when: AnchorRestorePainted(w)

    requires: w.phase = "restoring_from_anchor"

    ensures: w.phase = "user_scrolled_up"
    ensures: w.is_pinned_to_bottom = false
}

------------------------------------------------------------
-- Rules — async message arrival
------------------------------------------------------------

-- The historical_units list grows (a new agent_turn or user unit
-- arrived via the reducer). If the user is pinned to the bottom, the
-- window auto-anchors to the new tail. If the user is scrolled up,
-- the window preserves first_rendered_unit_index (the JumpToNewest
-- button handles surfacing the new content).
rule AutoAnchorOnNewMessages {
    when: HistoricalUnitsUpdated(w, new_historical)

    requires: w.is_pinned_to_bottom = true

    ensures: w.historical_units = new_historical
    ensures: w.first_rendered_unit_index = max_int(0, len(new_historical) - 12)
    ensures: w.phase = "pinned_to_bottom"

    @guidance
        -- After this rule, a useLayoutEffect scrolls
        -- scrollRoot.scrollTop = scrollRoot.scrollHeight so the new
        -- unit is visible. The check for is_pinned_to_bottom is
        -- maintained on every scroll event: if the user scrolls up
        -- after a new message lands, is_pinned_to_bottom flips to
        -- false via UserScrolledUp below.
}

rule PreserveWindowWhenScrolledUp {
    when: HistoricalUnitsUpdated(w, new_historical)

    requires: w.is_pinned_to_bottom = false

    ensures: w.historical_units = new_historical
    ensures: w.first_rendered_unit_index = w.first_rendered_unit_index
    ensures: w.phase = w.phase

    @guidance
        -- The JumpToNewest button (REQ-CONV-002 / existing UI) becomes
        -- visible separately. Clicking it sets scrollTop = scrollHeight
        -- and flips is_pinned_to_bottom back to true; the next
        -- HistoricalUnitsUpdated then anchors to bottom.
}

------------------------------------------------------------
-- Rules — user scroll
------------------------------------------------------------

-- User scrolled up off the bottom → flip is_pinned_to_bottom and
-- transition to user_scrolled_up. Detected by the scroll listener
-- when (scrollTop + clientHeight) < (scrollHeight - threshold).
rule UserScrolledUp {
    when: ScrollDetected(w, position)

    requires: w.is_pinned_to_bottom = true
    requires: not is_within_bottom_threshold(position)

    ensures: w.is_pinned_to_bottom = false
    ensures: w.phase = "user_scrolled_up"
    ensures: w.first_rendered_unit_index = w.first_rendered_unit_index
}

-- User scrolled back to the bottom (or close enough) → flip
-- is_pinned_to_bottom back to true.
rule UserReturnedToBottom {
    when: ScrollDetected(w, position)

    requires: w.is_pinned_to_bottom = false
    requires: is_within_bottom_threshold(position)

    ensures: w.is_pinned_to_bottom = true
    ensures: w.phase = "pinned_to_bottom"
    ensures: w.first_rendered_unit_index = w.first_rendered_unit_index
}

------------------------------------------------------------
-- Rules — boundary expansion (sentinel intersection)
------------------------------------------------------------

-- Sentinel intersected the expanded scroll-root viewport (the
-- 600px-buffered region above the visible viewport) → trigger
-- expansion. Capture scrollHeight before the state mutation, then
-- decrement first_rendered_unit_index by EXPAND_BATCH (clamped to 0).
--
-- Phase transitions to expanding for the duration of the
-- render-commit; the post-commit layout effect transitions it back.
rule SentinelIntersectedExpand {
    when: SentinelIntersected(w, scroll_height_now)

    requires: w.first_rendered_unit_index > 0

    ensures: w.pre_expand_scroll_height = scroll_height_now
    ensures: w.first_rendered_unit_index = max_int(0, w.first_rendered_unit_index - 12)
    ensures: w.phase = "expanding"
    ensures: w.is_pinned_to_bottom = w.is_pinned_to_bottom

    @guidance
        -- The exact-scroll-compensation pattern requires this rule's
        -- TWO mutations to be observable to React as a single update:
        -- pre_expand_scroll_height and first_rendered_unit_index must
        -- land together so the layout effect can read the captured
        -- value when it runs after the render commit. Implementations
        -- that split these into separate setState calls reintroduce
        -- the visible-jump bug.
}

-- Sentinel intersected at the top of the historical list → no-op.
-- Cannot expand further; the user has reached the conversation's
-- start.
rule SentinelIntersectedAtTop {
    when: SentinelIntersected(w, scroll_height_now)

    requires: w.first_rendered_unit_index = 0

    ensures: w = w
}

-- Post-render layout effect → apply scroll compensation. The delta
-- between current scrollHeight and the captured value equals the
-- pixel height of the newly-prepended units; adding it to scrollTop
-- keeps the previously-visible content visually fixed.
rule ExpansionCompensationApplied {
    when: PostExpandLayoutEffect(w, current_scroll_height, current_scroll_top)

    requires: w.phase = "expanding"
    requires: w.pre_expand_scroll_height != null

    ensures: w.phase = post_expansion_phase(w)
    ensures: w.pre_expand_scroll_height = null
    -- Side effect (not on the entity but performed by the actor):
    -- scrollRoot.scrollTop = current_scroll_top + (current_scroll_height - w.pre_expand_scroll_height)

    @guidance
        -- post_expansion_phase(w):
        --   if w.is_pinned_to_bottom then "pinned_to_bottom"
        --   else "user_scrolled_up"
        --
        -- The compensation is applied within useLayoutEffect, before
        -- the browser paints. The user observes the new units appear
        -- above the spacer's prior region with no visible scroll jump
        -- of the originally-visible content.
        --
        -- If a stale layout effect runs (e.g., due to React fast-refresh
        -- in development) with pre_expand_scroll_height = null, the
        -- ExpansionCompensationSkipped rule fires instead.
}

rule ExpansionCompensationSkipped {
    when: PostExpandLayoutEffect(w, current_scroll_height, current_scroll_top)

    requires: w.pre_expand_scroll_height = null

    ensures: w = w

    @guidance
        -- The layout effect was scheduled but no expansion was in
        -- flight. Could happen on re-render due to measured-height
        -- updates that change spacer height but do not change
        -- first_rendered_unit_index. Leaving scrollTop alone is
        -- correct: the spacer-height change is the geometry change,
        -- and any visual settle is bounded by the difference between
        -- measured and prior estimated heights (per-kind estimates
        -- bound this difference at construction).
}

------------------------------------------------------------
-- Rules — measured-height cache
------------------------------------------------------------

-- A ResizeObserver callback fired for a unit at index i in the
-- historical list → write the measured height into the cache keyed by
-- unit.key. The spacer-height computation reads the cache; a write
-- triggers a re-render of the spacer's host.
rule ResizeObserverMeasuredHeight {
    when: UnitResized(w, unit_key, measured_px)

    ensures: w.measured_heights = set_map(w.measured_heights, unit_key, measured_px)
    ensures: w.first_rendered_unit_index = w.first_rendered_unit_index
    ensures: w.is_pinned_to_bottom = w.is_pinned_to_bottom

    @guidance
        -- Spacer height is derived (not stored):
        --   spacer_height(w) =
        --     sum over i in [0, w.first_rendered_unit_index):
        --       w.measured_heights[w.historical_units[i].key]
        --         if present
        --       else KIND_ESTIMATES[w.historical_units[i].kind]
        --
        -- The cache write is mirrored to sessionStorage by the
        -- UnitHeightCache implementation; that mirror is not part of
        -- the window's state machine (it is a side effect of the
        -- cache layer, modeled in design.md).
}

------------------------------------------------------------
-- Rules — saved-scroll anchor write
------------------------------------------------------------

-- Visibility-hidden or unmount → capture the current top-visible unit
-- and offset, persist as the saved anchor. Walks the rendered units
-- (via the actor's ref-map, not part of the entity state) to find the
-- first whose offsetTop >= scrollTop.
rule SaveAnchorOnHideOrUnmount {
    when: SaveAnchorTriggered(w, scroll_top, top_unit_key, top_unit_offset_top)

    requires: w.historical_units != empty_list()

    ensures: w.saved_anchor = SavedScrollAnchor {
                 top_visible_unit_key: top_unit_key,
                 offset_within_unit: scroll_top - top_unit_offset_top
             }
    ensures: w.first_rendered_unit_index = w.first_rendered_unit_index

    @guidance
        -- The actor identifies top_unit_key and top_unit_offset_top by
        -- walking the ref-map of rendered units and picking the first
        -- whose offsetTop >= scrollTop. If no such unit exists (the
        -- user is below the last unit's top), use the last rendered
        -- unit; offset_within_unit may be larger than that unit's
        -- height, which is fine — restore will scroll past the unit's
        -- top by that amount, landing at the same content.
        --
        -- Persistence: localStorage at
        -- phoenix:msglist:anchor:{conversation_id}. The old
        -- scrollTop-only key is deleted in the same write.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- first_rendered_unit_index is always a valid offset into
-- historical_units. The window never points beyond the available
-- range.
invariant FirstRenderedUnitIndexInBounds {
    for w in Windows:
        w.first_rendered_unit_index >= 0
        and w.first_rendered_unit_index <= len(w.historical_units)
}

-- Tail units are not addressable by first_rendered_unit_index.
-- The window's collapse range covers historical_units only. This is
-- a type-level guarantee (the index is into List<HistoricalUnit>,
-- not List<RenderUnit>), restated here for traceability.
invariant TailUnitsAreNotCollapsible {
    for w in Windows:
        len(w.tail_units) >= 0
        -- The structural claim is in the type system; this invariant
        -- exists to anchor the requirement (REQ-MLRU-004) in spec.
}

-- pre_expand_scroll_height is non-null exactly when phase = expanding.
-- A non-null value outside the expanding phase indicates a stale
-- captured value that must not be consumed by a subsequent layout
-- effect (ExpansionCompensationSkipped guards this).
invariant PreExpandHeightCoupledToPhase {
    for w in Windows:
        (w.pre_expand_scroll_height != null) = (w.phase = "expanding")
}

-- is_pinned_to_bottom is true exactly when phase is pinned_to_bottom.
-- The two fields are redundant but kept together for legibility:
-- phase describes what the window is "doing right now"; the boolean
-- captures the steady-state property the scroll-on-arrival logic
-- consults.
invariant PinnedToBottomCoupledToPhase {
    for w in Windows:
        w.is_pinned_to_bottom = (w.phase = "pinned_to_bottom")
}

-- The saved anchor's key, when set, refers either to a unit currently
-- in the historical list OR to a unit that was in the list at the
-- time of save (the latter is a transient case during restore). The
-- spec captures the steady-state claim; the restore rules handle the
-- missing-key case explicitly.
invariant SavedAnchorIntegrity {
    for w in Windows:
        w.saved_anchor != null
        and w.phase != "restoring_from_anchor"
        implies anchor_key_in_units(w.historical_units, w.saved_anchor)
}

-- The measured-heights cache holds entries only for unit keys that
-- appear (or appeared) in the historical list. Stale entries persist
-- in the in-memory map for the session but do not violate this
-- invariant because the entity-snapshot quantifier ranges over the
-- current historical_units; a stricter "no stale" property requires
-- temporal quantification and is not enforced.
invariant MeasuredHeightsBelongToUnits {
    for w in Windows:
        for key in keys(w.measured_heights):
            -- Stated as "permitted to be stale" rather than an absolute
            -- presence requirement; the cache layer's eviction policy
            -- is best-effort (clears on conversation delete).
            true
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------
-- Q1. EXPAND_BATCH = 12 is carried from the prior implementation. If
--     measured heights are typically much smaller than the kind
--     estimates (e.g., the user has a tool-result-heavy conversation
--     where most agent_turns are ~200px after measurement vs the
--     400px estimate), 12 units may render too quickly to be a
--     meaningful batch. Profile after implementation; if the
--     expansion feels jumpy, reduce EXPAND_BATCH or expand by
--     measured-pixel budget rather than unit count. Not blocking.
--
-- Q2. SENTINEL_ROOT_MARGIN = "600px" matches the prior
--     EXPAND_TRIGGER_PX threshold. The intent is "expand before the
--     user reaches the spacer's top edge." If the user can scroll
--     faster than the observer can fire (e.g., trackpad flick on a
--     long conversation), units may flash into view rather than
--     appear smoothly. The fix, if needed, is a larger rootMargin
--     plus a debounced expansion guard against fire-storm. Not
--     blocking for the structural refactor.
--
-- Q3. AutoAnchorOnNewMessages currently keeps the user pinned to the
--     bottom even when many messages arrive at once (e.g., a paste
--     replay or a conversation switch race). The rule's
--     first_rendered_unit_index recompute correctly absorbs N new
--     messages, but the layout-effect scroll-to-bottom assumes a
--     single-render commit. If React 18's automatic batching coalesces
--     several HistoricalUnitsUpdated events, only the final state
--     matters; this is fine. Worth re-verifying after this lands.
--
-- Q4. The SavedAnchorIntegrity invariant uses the entity-snapshot
--     quantifier and so cannot capture "the anchor referenced a unit
--     that was in the list at save time." A temporal extension to the
--     Allium dialect would capture this; for now, the
--     MountWithSavedAnchorMissing rule covers the operational case.
