-- allium: 3
-- windowing.allium
--
-- MessageList Bottom-Anchored Window: Behavioural Specification
--
-- Scope: The lifecycle of the virtualized window that the message list
--        maintains over the historicalUnits list produced by the
--        render_units transform. Models the window's mount, expansion,
--        and pinned-to-bottom states; the IntersectionObserver-driven
--        boundary expansion. Visible-content position preservation
--        during reflow is delegated to the browser via CSS
--        `overflow-anchor` rather than a hand-rolled layout-effect
--        scroll compensation.
--
-- Includes: Initial-mount window placement (always bottom-pinned);
--           bottom-pinned auto-anchor on async message arrival; user
--           scroll-up detection; sentinel-intersection expansion;
--           measured-height cache reads for spacer geometry;
--           pin-to-bottom on new message arrival when the user is at
--           the bottom.
--
-- Excludes: render_units transform (see render_units.allium);
--           individual unit rendering (MessageComponents.tsx, no spec);
--           saved-scroll restoration — REQ-CONV-013 and REQ-MLRU-009
--           were deprecated and the entire save/restore/ack-snapshot
--           path was removed.
--           Scroll-jump prevention during prefix reflow is delegated
--           to the browser's CSS scroll-anchoring (overflow-anchor:
--           auto on #main-area, overflow-anchor: none on the spacer
--           divs). This spec models the windowing state machine but
--           not the compensation mechanism, because the mechanism
--           lives in the browser, not in user code.
--
-- Uses: render_units (HistoricalUnit, TailUnit types).
use "./render_units.allium" as ru

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- The measured height of a rendered historical unit, written by a
-- ResizeObserver callback. Lookups are O(1) by key; absence is
-- explicitly representable so the spacer-height computation can
-- fall back to a per-kind estimate.
value MeasuredHeight {
    unit_key: String
    height_px: Integer
}

-- Per-kind height estimate, used when no MeasuredHeight is cached
-- for a given unit key. Keyed by HistoricalKind from render_units.
value KindEstimate {
    kind: ru.HistoricalKind
    estimate_px: Integer
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- The window's lifecycle phase. Models what the window is doing right
-- now from the user's perspective: pinned to bottom watching for new
-- content; scrolled up and holding position.
--
-- The previous `expanding` phase was an internal bookkeeping state
-- used by the hand-rolled scroll-compensation layout effect. With CSS
-- `overflow-anchor` doing the compensation, expansion is no longer a
-- multi-step state machine — the window range mutates in a single
-- render commit and the browser handles the visible-anchor preservation.
enum WindowPhase {
    pinned_to_bottom
    user_scrolled_up
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- The window's state. One per mounted MessageList instance; the
-- conversation_id forms the natural key (mounting a new conversation
-- starts a new Window).
entity Window {
    conversation_id: String?
    historical_units: List<ru.HistoricalUnit>
    tail_units: List<ru.TailUnit>

    first_rendered_unit_index: Integer
    last_rendered_unit_index: Integer
    is_pinned_to_bottom: Boolean
    phase: WindowPhase

    measured_heights: Map<String, Integer>
}

------------------------------------------------------------
-- Constants
------------------------------------------------------------
-- INITIAL_WINDOW = 12 (units rendered on default mount)
-- EXPAND_BATCH = 12 (units revealed per sentinel intersection)
-- MAX_RENDERED_UNITS = 48 (historical units retained in DOM after expansion)
-- SENTINEL_ROOT_MARGIN = "600px 0px 0px 0px"
-- BOTTOM_SENTINEL_ROOT_MARGIN = "0px 0px 600px 0px"
-- KIND_ESTIMATES = { user: 100, skill: 80, agent_turn: 400, system: 100,
--                    pending_user: 100 }

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

-- The useBottomAnchoredWindow hook, mounted inside MessageList. The
-- actor anchors the Window entity to a concrete runtime consumer.
actor BottomAnchoredWindow {
    identified_by: Window
}

------------------------------------------------------------
-- Rules — initial mount
------------------------------------------------------------

-- Fresh mount → bottom-pinned. The window starts showing the last
-- INITIAL_WINDOW units; the scroll container is scrolled to its bottom
-- such that the last historical unit and all tail units are visible.
-- This is the SOLE mount strategy; saved-scroll restoration was removed
-- alongside REQ-CONV-013.
rule MountBottomPinned {
    when: WindowMounted(w, historical, tail)

    ensures: w.historical_units = historical
    ensures: w.tail_units = tail
    ensures: w.first_rendered_unit_index = max_int(0, len(historical) - 12)
    ensures: w.last_rendered_unit_index = len(historical)
    ensures: w.is_pinned_to_bottom = true
    ensures: w.phase = "pinned_to_bottom"
    ensures: w.measured_heights = empty_map()

    @guidance
        -- The scroll-to-bottom side effect happens in a useLayoutEffect
        -- after the first paint: scrollRoot.scrollTop =
        -- scrollRoot.scrollHeight. Bottom-pin survives async message
        -- arrival via the AutoAnchorOnNewMessages rule below.
}

------------------------------------------------------------
-- Rules — async message arrival
------------------------------------------------------------

-- The historical_units list grows (a new agent_turn or user unit
-- arrived via the reducer, or a pending_user unit was appended). If
-- the user is pinned to the bottom, the window auto-anchors to the new
-- tail. If the user is scrolled up, the window preserves
-- first_rendered_unit_index (the JumpToNewest button handles surfacing
-- the new content).
--
-- Pending → sent acknowledgement is NOT a new historical unit: it is
-- an in-place keyed replacement of an existing `pending_user` unit by
-- a `user` unit with the same key (localId == message_id at ack). The
-- list length and indexes are unchanged; the unit's kind/payload
-- differs. No special handling is required — React's reconciler
-- updates the keyed node and the window state is invariant.
rule AutoAnchorOnNewMessages {
    when: HistoricalUnitsUpdated(w, new_historical)

    requires: w.is_pinned_to_bottom = true
    requires: len(new_historical) > len(w.historical_units)

    ensures: w.historical_units = new_historical
    ensures: w.first_rendered_unit_index = max_int(0, len(new_historical) - 12)
    ensures: w.last_rendered_unit_index = len(new_historical)
    ensures: w.phase = "pinned_to_bottom"

    @guidance
        -- After this rule, a useLayoutEffect scrolls
        -- scrollRoot.scrollTop = scrollRoot.scrollHeight so the new
        -- unit is visible. The check for is_pinned_to_bottom is
        -- maintained on every scroll event: if the user scrolls up
        -- after a new message lands, is_pinned_to_bottom flips to
        -- false via UserScrolledUp below.
}

rule PreserveWindowWhenScrolledUp {
    when: HistoricalUnitsUpdated(w, new_historical)

    requires: w.is_pinned_to_bottom = false
    requires: len(new_historical) > len(w.historical_units)

    ensures: w.historical_units = new_historical
    ensures: w.first_rendered_unit_index = w.first_rendered_unit_index
    ensures: w.last_rendered_unit_index = w.last_rendered_unit_index
    ensures: w.phase = w.phase

    @guidance
        -- The JumpToNewest button (REQ-CONV-002 / existing UI) becomes
        -- visible separately. Clicking it sets scrollTop = scrollHeight
        -- and flips is_pinned_to_bottom back to true; the next
        -- HistoricalUnitsUpdated then anchors to bottom.
}

-- Length-preserving update (e.g., pending → sent in-place keyed
-- replacement): historical_units payload changes but len is the same.
-- Window indexes and pin state are invariant.
rule InPlaceUnitUpdate {
    when: HistoricalUnitsUpdated(w, new_historical)

    requires: len(new_historical) = len(w.historical_units)

    ensures: w.historical_units = new_historical
    ensures: w.first_rendered_unit_index = w.first_rendered_unit_index
    ensures: w.last_rendered_unit_index = w.last_rendered_unit_index
    ensures: w.is_pinned_to_bottom = w.is_pinned_to_bottom
    ensures: w.phase = w.phase

    @guidance
        -- This rule covers the pending → sent transition. Because the
        -- pending_user unit and the eventual user unit share a key
        -- (localId == message_id at ack), React's reconciler treats
        -- this as a keyed update on a single DOM node, not a
        -- remove/insert pair. No scroll compensation is required.
}

------------------------------------------------------------
-- Rules — user scroll
------------------------------------------------------------

-- User scrolled up off the bottom → flip is_pinned_to_bottom and
-- transition to user_scrolled_up. Detected by the scroll listener
-- when (scrollTop + clientHeight) < (scrollHeight - threshold).
rule UserScrolledUp {
    when: ScrollDetected(w, position)

    requires: w.is_pinned_to_bottom = true
    requires: not is_within_bottom_threshold(position)

    ensures: w.is_pinned_to_bottom = false
    ensures: w.phase = "user_scrolled_up"
    ensures: w.first_rendered_unit_index = w.first_rendered_unit_index
}

-- User scrolled back to the bottom (or close enough) → flip
-- is_pinned_to_bottom back to true.
rule UserReturnedToBottom {
    when: ScrollDetected(w, position)

    requires: w.is_pinned_to_bottom = false
    requires: is_within_bottom_threshold(position)

    ensures: w.is_pinned_to_bottom = true
    ensures: w.phase = "pinned_to_bottom"
    ensures: w.first_rendered_unit_index = w.first_rendered_unit_index
}

------------------------------------------------------------
-- Rules — boundary expansion (sentinel intersection)
------------------------------------------------------------

-- Sentinel intersected the expanded scroll-root viewport (the
-- 600px-buffered region above the visible viewport) → trigger
-- expansion. Decrement first_rendered_unit_index by EXPAND_BATCH
-- (clamped to 0). If the resulting rendered range exceeds
-- MAX_RENDERED_UNITS, move the newer overflow into the bottom spacer
-- by decreasing last_rendered_unit_index.
--
-- No scrollHeight capture, no post-render compensation rule. The
-- browser's CSS `overflow-anchor` keeps the topmost in-viewport
-- render-unit element fixed as the prepended units expand the
-- document upward. The spacer divs are opted out via
-- `overflow-anchor: none` so the browser doesn't anchor on them.
rule SentinelIntersectedExpand {
    when: SentinelIntersected(w)

    requires: w.first_rendered_unit_index > 0

    ensures: w.first_rendered_unit_index = max_int(0, w.first_rendered_unit_index - 12)
    ensures: w.last_rendered_unit_index = min_int(
                 w.last_rendered_unit_index,
                 w.first_rendered_unit_index + 48
             )
    ensures: w.is_pinned_to_bottom = w.is_pinned_to_bottom
    ensures: w.phase = w.phase

    @guidance
        -- The visible-content-stable invariant is enforced by the
        -- browser via overflow-anchor, not by user code. The window
        -- state mutates in a single setState; the next render commit
        -- includes the new units and the browser silently increments
        -- scrollTop to keep the anchor's viewport position fixed.
}

-- Bottom sentinel intersected while newer historical units are collapsed
-- below the rendered range → shift the bounded window toward the tail.
rule BottomSentinelIntersectedExpand {
    when: BottomSentinelIntersected(w)

    requires: w.last_rendered_unit_index < len(w.historical_units)

    ensures: w.last_rendered_unit_index = min_int(len(w.historical_units), w.last_rendered_unit_index + 12)
    ensures: w.first_rendered_unit_index = max_int(
                 0,
                 min_int(w.first_rendered_unit_index + 12, w.last_rendered_unit_index - 48)
             )
    ensures: w.is_pinned_to_bottom = w.is_pinned_to_bottom
    ensures: w.phase = w.phase
}

-- Sentinel intersected at the top of the historical list → no-op.
-- Cannot expand further; the user has reached the conversation's
-- start.
rule SentinelIntersectedAtTop {
    when: SentinelIntersected(w)

    requires: w.first_rendered_unit_index = 0

    ensures: w = w
}

------------------------------------------------------------
-- Rules — measured-height cache
------------------------------------------------------------

-- A ResizeObserver callback fired for a unit at index i in the
-- historical list → write the measured height into the cache keyed by
-- unit.key. The spacer-height computation reads the cache; a write
-- triggers a re-render of the spacer's host. The cache is in-memory
-- only — REQ-MLRU-013's sessionStorage mirror was deprecated alongside
-- the saved-scroll restore it served.
rule ResizeObserverMeasuredHeight {
    when: UnitResized(w, unit_key, measured_px)

    ensures: w.measured_heights = set_map(w.measured_heights, unit_key, measured_px)
    ensures: w.first_rendered_unit_index = w.first_rendered_unit_index
    ensures: w.last_rendered_unit_index = w.last_rendered_unit_index
    ensures: w.is_pinned_to_bottom = w.is_pinned_to_bottom

    @guidance
        -- Top spacer and bottom spacer heights are derived (not stored):
        --   top_spacer_height(w) =
        --     sum over i in [0, w.first_rendered_unit_index): measured_or_estimated(i)
        --   bottom_spacer_height(w) =
        --     sum over i in [w.last_rendered_unit_index, len(w.historical_units)): measured_or_estimated(i)
        -- where measured_or_estimated(i) reads w.measured_heights by unit key
        -- when present and otherwise falls back to KIND_ESTIMATES by kind.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- first_rendered_unit_index and last_rendered_unit_index are always a
-- valid half-open range into historical_units.
invariant RenderedUnitRangeInBounds {
    for w in Windows:
        w.first_rendered_unit_index >= 0
        and w.first_rendered_unit_index <= w.last_rendered_unit_index
        and w.last_rendered_unit_index <= len(w.historical_units)
}

-- After expansion, the historical DOM window remains bounded.
invariant RenderedUnitRangeBounded {
    for w in Windows:
        len(w.historical_units) <= 48
        or (w.last_rendered_unit_index - w.first_rendered_unit_index) <= 48
}

-- Tail units are not addressable by first_rendered_unit_index.
-- The window's collapse range covers historical_units only. This is
-- a type-level guarantee (the index is into List<HistoricalUnit>,
-- not List<RenderUnit>), restated here for traceability.
invariant TailUnitsAreNotCollapsible {
    for w in Windows:
        len(w.tail_units) >= 0
        -- The structural claim is in the type system; this invariant
        -- exists to anchor the requirement (REQ-MLRU-004) in spec.
}

-- is_pinned_to_bottom is true exactly when phase is pinned_to_bottom.
-- The two fields are redundant but kept together for legibility:
-- phase describes what the window is "doing right now"; the boolean
-- captures the steady-state property the scroll-on-arrival logic
-- consults.
invariant PinnedToBottomCoupledToPhase {
    for w in Windows:
        w.is_pinned_to_bottom = (w.phase = "pinned_to_bottom")
}

-- Visible-content stability during expansion is delegated to the
-- browser's CSS scroll-anchoring. There is no entity-level invariant
-- to assert because the compensation is not modeled here — the
-- `overflow-anchor: auto` on the scroll root + `overflow-anchor:
-- none` on the spacer divs is the mechanism, and the browser's
-- scroll-anchoring algorithm is its specification. Spec sees:
-- first_rendered_unit_index decreases by EXPAND_BATCH; the user does
-- not perceive a visible jump. The "does not jump" property is
-- empirical (verified in browser smoke tests) rather than a derivable
-- invariant of this state machine.

-- The measured-heights cache holds entries only for unit keys that
-- appear (or appeared) in the historical list. Stale entries persist
-- in the in-memory map for the session but do not violate this
-- invariant because the entity-snapshot quantifier ranges over the
-- current historical_units; a stricter "no stale" property requires
-- temporal quantification and is not enforced.
invariant MeasuredHeightsBelongToUnits {
    for w in Windows:
        for key in keys(w.measured_heights):
            -- Stated as "permitted to be stale" rather than an absolute
            -- presence requirement; the cache layer's eviction policy
            -- is best-effort (clears on conversation mount).
            true
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------
-- Q1. EXPAND_BATCH = 12 is carried from the prior implementation. If
--     measured heights are typically much smaller than the kind
--     estimates (e.g., the user has a tool-result-heavy conversation
--     where most agent_turns are ~200px after measurement vs the
--     400px estimate), 12 units may render too quickly to be a
--     meaningful batch. Profile after implementation; if the
--     expansion feels jumpy, reduce EXPAND_BATCH or expand by
--     measured-pixel budget rather than unit count. Not blocking.
--
-- Q2. SENTINEL_ROOT_MARGIN = "600px" matches the prior
--     EXPAND_TRIGGER_PX threshold. The intent is "expand before the
--     user reaches the spacer's top edge." If the user can scroll
--     faster than the observer can fire (e.g., trackpad flick on a
--     long conversation), units may flash into view rather than
--     appear smoothly. The fix, if needed, is a larger rootMargin
--     plus a debounced expansion guard against fire-storm. Not
--     blocking for the structural refactor.
--
-- Q3. AutoAnchorOnNewMessages currently keeps the user pinned to the
--     bottom even when many messages arrive at once (e.g., a paste
--     replay or a conversation switch race). The rule's
--     first_rendered_unit_index recompute correctly absorbs N new
--     messages, but the layout-effect scroll-to-bottom assumes a
--     single-render commit. If React 18's automatic batching coalesces
--     several HistoricalUnitsUpdated events, only the final state
--     matters; this is fine. Worth re-verifying after this lands.
