-- allium: 3
-- Message-list scroll policy
--
-- Scope: durable tail-follow intent, explicit touch gesture state, unread
-- policy, geometry observation, and bounded mount recovery. Browser and
-- Virtuoso scroll physics are outside this policy.

config {
    settle_window_ms: Integer = 3000
}

enum Lifecycle { unmeasured measured_empty mount_rescue live }
enum FollowMode { following reading returning_to_tail }
enum GestureMode { idle touch_stationary touch_moved }
enum EffectKind {
    snap_to_last_index
    schedule_tail_follow
    schedule_dom_bottom_write
    write_dom_bottom
    start_settle_watch
    stop_settle_watch
    show_unread
    clear_unread
}

entity ScrollPolicy {
    conversation_id: String?
    lifecycle: Lifecycle
    follow_mode: FollowMode
    gesture_mode: GestureMode
    mode_before_gesture: FollowMode
    gesture_departed_bottom: Boolean
    at_bottom: Boolean
    unread: Boolean
    previous_total_height: Integer
    last_scroll_top: Integer
    settle_deadline: Integer

    transitions lifecycle {
        unmeasured -> measured_empty
        unmeasured -> mount_rescue
        measured_empty -> mount_rescue
        measured_empty -> unmeasured
        mount_rescue -> live
        mount_rescue -> unmeasured
        live -> unmeasured
    }

    transitions follow_mode {
        following -> reading
        following -> returning_to_tail
        reading -> following
        reading -> returning_to_tail
        returning_to_tail -> following
        returning_to_tail -> reading
    }

    transitions gesture_mode {
        idle -> touch_stationary
        touch_stationary -> touch_moved
        touch_stationary -> idle
        touch_moved -> idle
    }
}

entity ScrollEffect {
    policy: ScrollPolicy
    kind: EffectKind
}

surface ScrollPolicyAdapter {
    facing policy: ScrollPolicy

    exposes:
        policy.lifecycle
        policy.follow_mode
        policy.gesture_mode
        policy.at_bottom
        policy.unread

    provides:
        ConversationChanged(policy, conversation_id)
        ConversationMeasured(policy, conversation_id, total_height, unit_count, now_ms)
        ScrollerAttached(policy, snapshot)
        DownwardMovement(policy, snapshot)
        ViewportPinnedChanged(policy, at_bottom)
        InteractionStarted(policy)
        TouchStarted(policy)
        TouchMoved(policy)
        TouchEnded(policy, remaining_touches)
        TouchCancelled(policy, remaining_touches)
        UpwardIntent(policy)
        NavigationJumped(policy)
        TailContentAdvanced(policy)
        HeightChanged(policy, total_height, unit_count, cause)
        SettleProbe(policy, stranded, now_ms)
        JumpToNewestRequested(policy, unit_count)
}

surface ScrollPolicyEffectSink {
    facing effect: ScrollEffect

    exposes:
        effect.policy
        effect.kind
}

rule ScrollerAttachmentUpdatesReadyGeometry {
    when: ScrollerAttached(policy, snapshot)
    requires: policy.lifecycle in { mount_rescue, live }
    ensures: policy.last_scroll_top = snapshot.scroll_top
}

rule DownwardMovementUpdatesGeometryWithoutChangingOwnership {
    when: DownwardMovement(policy, snapshot)
    requires: policy.lifecycle in { mount_rescue, live }
    ensures: policy.last_scroll_top = snapshot.scroll_top
    ensures: policy.follow_mode = policy.follow_mode
}

rule PopulatedMeasurementStartsMountRescue {
    when: ConversationMeasured(policy, conversation_id, total_height, unit_count, now_ms)
    requires: policy.lifecycle = unmeasured
    requires: unit_count > 0
    ensures: policy.conversation_id = conversation_id
    ensures: policy.lifecycle = mount_rescue
    ensures: policy.follow_mode = following
    ensures: policy.gesture_mode = idle
    ensures: policy.at_bottom = true
    ensures: policy.unread = false
    ensures: policy.previous_total_height = total_height
    ensures: policy.settle_deadline = now_ms + config.settle_window_ms
    ensures: ScrollEffect.created(policy: policy, kind: start_settle_watch)
    ensures: ScrollEffect.created(policy: policy, kind: schedule_dom_bottom_write)
}

rule EmptyMeasurementWaitsForContent {
    when: ConversationMeasured(policy, conversation_id, total_height, unit_count, _)
    requires: policy.lifecycle = unmeasured
    requires: unit_count = 0
    ensures: policy.conversation_id = conversation_id
    ensures: policy.lifecycle = measured_empty
    ensures: policy.previous_total_height = total_height
}

rule FirstContentAfterEmptyStartsRescueAndSnaps {
    when: ConversationMeasured(policy, conversation_id, total_height, unit_count, now_ms)
    requires: policy.lifecycle = measured_empty
    requires: unit_count > 0
    ensures: policy.conversation_id = conversation_id
    ensures: policy.lifecycle = mount_rescue
    ensures: policy.follow_mode = following
    ensures: policy.previous_total_height = total_height
    ensures: policy.settle_deadline = now_ms + config.settle_window_ms
    ensures: ScrollEffect.created(policy: policy, kind: snap_to_last_index)
    ensures: ScrollEffect.created(policy: policy, kind: start_settle_watch)
    ensures: ScrollEffect.created(policy: policy, kind: schedule_dom_bottom_write)
}

rule InteractionPermanentlyExitsMountRescue {
    when: InteractionStarted(policy)
    requires: policy.lifecycle = mount_rescue
    ensures: policy.lifecycle = live
    ensures: policy.follow_mode = following
    ensures: ScrollEffect.created(policy: policy, kind: stop_settle_watch)
}

rule NavigationFromLiveTakesReadingOwnership {
    when: NavigationJumped(policy)
    requires: policy.lifecycle = live
    ensures: policy.follow_mode = reading
}

rule NavigationExitsMountRescueIntoReading {
    when: NavigationJumped(policy)
    requires: policy.lifecycle = mount_rescue
    ensures: policy.lifecycle = live
    ensures: policy.follow_mode = reading
    ensures: ScrollEffect.created(policy: policy, kind: stop_settle_watch)
}

rule UpwardIntentFromLiveTakesReadingOwnership {
    when: UpwardIntent(policy)
    requires: policy.lifecycle = live
    ensures: policy.follow_mode = reading
}

rule UpwardIntentExitsMountRescueIntoReading {
    when: UpwardIntent(policy)
    requires: policy.lifecycle = mount_rescue
    ensures: policy.lifecycle = live
    ensures: policy.follow_mode = reading
    ensures: ScrollEffect.created(policy: policy, kind: stop_settle_watch)
}

rule LiveTouchStartRemembersFollowMode {
    when: TouchStarted(policy)
    requires: policy.lifecycle = live
    ensures: policy.gesture_mode = touch_stationary
    ensures: policy.mode_before_gesture = policy.follow_mode
    ensures: policy.gesture_departed_bottom = not policy.at_bottom
}

rule MountTouchStartExitsRescueAndRemembersFollowing {
    when: TouchStarted(policy)
    requires: policy.lifecycle = mount_rescue
    ensures: policy.lifecycle = live
    ensures: policy.follow_mode = following
    ensures: policy.gesture_mode = touch_stationary
    ensures: policy.mode_before_gesture = following
    ensures: policy.gesture_departed_bottom = not policy.at_bottom
    ensures: ScrollEffect.created(policy: policy, kind: stop_settle_watch)
}

rule TouchMovementTakesReadingOwnership {
    when: TouchMoved(policy)
    requires: policy.gesture_mode in { touch_stationary, touch_moved }
    ensures: policy.gesture_mode = touch_moved
    ensures: policy.follow_mode = reading
}

rule TapEndRestoresPreGestureMode {
    when: TouchEnded(policy, remaining_touches)
    requires: remaining_touches = 0
    requires: policy.gesture_mode = touch_stationary
    ensures: policy.gesture_mode = idle
    ensures: policy.follow_mode = policy.mode_before_gesture
}

rule MovedTouchEndPreservesReadingOwnership {
    when: TouchEnded(policy, remaining_touches)
    requires: remaining_touches = 0
    requires: policy.gesture_mode = touch_moved
    ensures: policy.gesture_mode = idle
    ensures: policy.follow_mode = reading
}

rule StationaryTouchCancellationRestoresPreGestureMode {
    when: TouchCancelled(policy, remaining_touches)
    requires: remaining_touches = 0
    requires: policy.gesture_mode = touch_stationary
    ensures: policy.gesture_mode = idle
    ensures: policy.follow_mode = policy.mode_before_gesture
}

rule MovedTouchCancellationPreservesReadingOwnership {
    when: TouchCancelled(policy, remaining_touches)
    requires: remaining_touches = 0
    requires: policy.gesture_mode = touch_moved
    ensures: policy.gesture_mode = idle
    ensures: policy.follow_mode = reading
}

rule TouchEndWithRemainingTouchesPreservesGesture {
    when: TouchEnded(policy, remaining_touches)
    requires: remaining_touches > 0
    requires: policy.gesture_mode in { touch_stationary, touch_moved }
    ensures: policy.gesture_mode = policy.gesture_mode
}

rule TouchCancelWithRemainingTouchesPreservesGesture {
    when: TouchCancelled(policy, remaining_touches)
    requires: remaining_touches > 0
    requires: policy.gesture_mode in { touch_stationary, touch_moved }
    ensures: policy.gesture_mode = policy.gesture_mode
}

rule LeavingBottomWhileIdleUpdatesGeometry {
    when: ViewportPinnedChanged(policy, at_bottom)
    requires: at_bottom = false
    requires: policy.lifecycle in { mount_rescue, live }
    requires: policy.gesture_mode = idle
    ensures: policy.at_bottom = false
}

rule LeavingBottomDuringTouchIsRemembered {
    when: ViewportPinnedChanged(policy, at_bottom)
    requires: at_bottom = false
    requires: policy.gesture_mode in { touch_stationary, touch_moved }
    ensures: policy.at_bottom = false
    ensures: policy.gesture_departed_bottom = true
}

rule BottomDuringStationaryTouchOnlyUpdatesGeometry {
    when: ViewportPinnedChanged(policy, at_bottom)
    requires: at_bottom = true
    requires: policy.gesture_mode = touch_stationary
    ensures: policy.at_bottom = true
}

rule BottomDuringMovedTouchCannotReleaseOwnership {
    when: ViewportPinnedChanged(policy, at_bottom)
    requires: at_bottom = true
    requires: policy.gesture_mode = touch_moved
    ensures: policy.at_bottom = true
    ensures: policy.follow_mode = reading
}

rule LiveIdleBottomConfirmationRestoresFollowing {
    when: ViewportPinnedChanged(policy, at_bottom)
    requires: at_bottom = true
    requires: policy.gesture_mode = idle
    requires: policy.lifecycle = live
    ensures: policy.at_bottom = true
    ensures: policy.follow_mode = following
    ensures: policy.unread = false
    ensures: ScrollEffect.created(policy: policy, kind: clear_unread)
}

rule MountBottomConfirmationKeepsRescueActive {
    when: ViewportPinnedChanged(policy, at_bottom)
    requires: at_bottom = true
    requires: policy.lifecycle = mount_rescue
    ensures: policy.lifecycle = mount_rescue
    ensures: policy.at_bottom = true
}

rule TailAdvanceWhileReadingShowsUnread {
    when: TailContentAdvanced(policy)
    requires: policy.lifecycle = live
    requires: policy.follow_mode = reading
    ensures: policy.unread = true
    ensures: ScrollEffect.created(policy: policy, kind: show_unread)
}

rule TailAdvanceWhileFollowingKeepsUnreadClear {
    when: TailContentAdvanced(policy)
    requires: policy.lifecycle = live
    requires: policy.follow_mode in { following, returning_to_tail }
    requires: policy.gesture_mode != touch_moved
    ensures: policy.unread = false
    ensures: ScrollEffect.created(policy: policy, kind: schedule_tail_follow)
}

rule FollowingHeightChangePreservesTail {
    when: HeightChanged(policy, total_height, unit_count, _)
    requires: policy.lifecycle = live
    requires: policy.follow_mode in { following, returning_to_tail }
    requires: policy.gesture_mode != touch_moved
    requires: unit_count > 0
    ensures: policy.previous_total_height = total_height
    ensures: policy.unread = false
    ensures: ScrollEffect.created(policy: policy, kind: snap_to_last_index)
}

rule ReadingTailGrowthShowsUnreadWithoutScrolling {
    when: HeightChanged(policy, total_height, unit_count, cause)
    requires: policy.lifecycle = live
    requires: policy.follow_mode = reading
    requires: unit_count > 0
    requires: cause = tail_activity
    requires: total_height > policy.previous_total_height
    ensures: policy.previous_total_height = total_height
    ensures: policy.unread = true
    ensures: ScrollEffect.created(policy: policy, kind: show_unread)
}

rule ReadingUnrelatedGrowthDoesNotChangeUnreadOrScroll {
    when: HeightChanged(policy, total_height, unit_count, cause)
    requires: policy.lifecycle = live
    requires: policy.follow_mode = reading
    requires: unit_count > 0
    requires: cause = unrelated_layout
    ensures: policy.previous_total_height = total_height
}

rule MountHeightChangeSchedulesBottomCorrection {
    when: HeightChanged(policy, total_height, unit_count, _)
    requires: policy.lifecycle = mount_rescue
    requires: unit_count > 0
    ensures: policy.previous_total_height = total_height
    ensures: ScrollEffect.created(policy: policy, kind: schedule_dom_bottom_write)
}

rule MountProbeWritesCurrentDomBottomWhenStranded {
    when: SettleProbe(policy, stranded, now_ms)
    requires: policy.lifecycle = mount_rescue
    requires: stranded = true
    requires: now_ms <= policy.settle_deadline
    ensures: ScrollEffect.created(policy: policy, kind: write_dom_bottom)
}

rule SettledMountProbeBeforeDeadlineDoesNothing {
    when: SettleProbe(policy, stranded, now_ms)
    requires: policy.lifecycle = mount_rescue
    requires: stranded = false
    requires: now_ms <= policy.settle_deadline
    ensures: policy.lifecycle = mount_rescue
}

rule LiveSettleProbeDoesNothing {
    when: SettleProbe(policy, _, _)
    requires: policy.lifecycle = live
    ensures: policy.lifecycle = live
}

rule MountProbeExpiresIntoFollowing {
    when: SettleProbe(policy, _, now_ms)
    requires: policy.lifecycle = mount_rescue
    requires: now_ms > policy.settle_deadline
    ensures: policy.lifecycle = live
    ensures: policy.follow_mode = following
    ensures: ScrollEffect.created(policy: policy, kind: stop_settle_watch)
}

rule JumpToNewestRequestsTailReturn {
    when: JumpToNewestRequested(policy, unit_count)
    requires: policy.lifecycle = live
    requires: unit_count > 0
    ensures: policy.follow_mode = returning_to_tail
    ensures: policy.unread = false
    ensures: ScrollEffect.created(policy: policy, kind: clear_unread)
    ensures: ScrollEffect.created(policy: policy, kind: snap_to_last_index)
}

rule LiveConversationChangeResetsSessionAtomically {
    when: ConversationChanged(policy, conversation_id)
    requires: policy.lifecycle = live
    requires: policy.conversation_id != conversation_id
    ensures: policy.conversation_id = conversation_id
    ensures: policy.lifecycle = unmeasured
    ensures: policy.follow_mode = following
    ensures: policy.gesture_mode = idle
    ensures: policy.at_bottom = true
    ensures: policy.unread = false
    ensures: ScrollEffect.created(policy: policy, kind: clear_unread)
}

rule MountConversationChangeStopsRescueAndResetsSession {
    when: ConversationChanged(policy, conversation_id)
    requires: policy.lifecycle = mount_rescue
    requires: policy.conversation_id != conversation_id
    ensures: policy.conversation_id = conversation_id
    ensures: policy.lifecycle = unmeasured
    ensures: policy.follow_mode = following
    ensures: policy.gesture_mode = idle
    ensures: policy.at_bottom = true
    ensures: policy.unread = false
    ensures: ScrollEffect.created(policy: policy, kind: stop_settle_watch)
    ensures: ScrollEffect.created(policy: policy, kind: clear_unread)
}

rule UnreadyConversationChangeResetsIdentity {
    when: ConversationChanged(policy, conversation_id)
    requires: policy.lifecycle in { unmeasured, measured_empty }
    requires: policy.conversation_id != conversation_id
    ensures: policy.conversation_id = conversation_id
    ensures: policy.lifecycle = unmeasured
}

invariant OnlyExplicitTailReturnReleasesReading {
    for policy in ScrollPolicy:
        policy.follow_mode = reading implies policy.lifecycle = live
}

invariant DirectDomWritesBelongOnlyToMountRescue {
    for effect in ScrollEffect:
        effect.kind = write_dom_bottom implies effect.policy.lifecycle = mount_rescue
}

invariant MountRescueHasBoundedDeadline {
    for policy in ScrollPolicy:
        policy.lifecycle = mount_rescue implies policy.settle_deadline > 0
}

invariant MovedTouchOwnsViewport {
    for policy in ScrollPolicy:
        policy.gesture_mode = touch_moved implies policy.follow_mode = reading
}

invariant EffectsBelongToPolicy {
    for effect in ScrollEffect:
        effect.policy != null
}
