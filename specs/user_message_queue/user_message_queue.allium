-- allium: 3
-- user_message_queue.allium
--
-- User Message Queue: Client-Side Optimistic Delivery Contract
--
-- Scope: the browser-local queue used to preserve user-authored messages
--        until authoritative server history reflects them. This is the client
--        bridge between POST /chat idempotency (`message_id = localId`), SSE
--        init/message delivery, offline retry, and steering queue display.
--
-- Excludes: server execution state machine internals; SSE wire ordering (see
--           specs/sse_wire/sse_wire.allium); ConversationAtom per-event reducer
--           semantics (see specs/conversation_atom/conversation_atom.allium).
--
-- Supersedes: tasks/02682-p3-ready--distill-user-message-queue-allium-spec.md.

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value ImageData {
    data: String
    media_type: String
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity ConversationScope {
    conversation_id: String
}

entity LocalQueueEntry {
    scope: ConversationScope
    local_id: String
    text: String
    images: List<ImageData>
    status: QueueStatus
    accepted_by_server: Boolean
    visible: Boolean

    transitions status {
        pending -> failed
        pending -> steering_queued
        pending -> reconciled
        pending -> recoverable_inconsistency
        failed -> pending
        failed -> dismissed
        steering_queued -> reconciled
        steering_queued -> failed
        steering_queued -> dismissed
        recoverable_inconsistency -> pending
        recoverable_inconsistency -> dismissed
        terminal: reconciled
        terminal: dismissed
    }
}

entity AuthoritativeUserMessage {
    scope: ConversationScope
    message_id: String
}

entity PendingRender {
    entry: LocalQueueEntry
}

entity FailedRender {
    entry: LocalQueueEntry
}

entity RecoverableInconsistencyRender {
    entry: LocalQueueEntry
    surfaced: Boolean
}

entity PostAttempt {
    entry: LocalQueueEntry
    message_id: String
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum QueueStatus {
    pending
    failed
    steering_queued
    recoverable_inconsistency
    reconciled
    dismissed
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule EnqueueLocalMessage {
    when: UserSendsMessage(scope, local_id, text, images)

    requires: text != "" or images != empty_list

    ensures: LocalQueueEntry.created(
        scope: scope,
        local_id: local_id,
        text: text,
        images: images,
        status: pending,
        accepted_by_server: false,
        visible: true
    )

    @guidance
        -- Implementation: useMessageQueue.enqueue generates `localId`, stores
        -- text/images/timestamp/status, and persists under
        -- `phoenix:queue:${conversationId}`. The optimistic bubble is rendered
        -- before POST success so navigation/offline failures do not erase the
        -- user's words.
}

rule PostUsesLocalIdAsMessageId {
    when: SendPostStarted(entry)

    requires: entry.status = pending

    ensures: PostAttempt.created(entry: entry, message_id: entry.local_id)

    @guidance
        -- Implementation: api.sendMessage sends JSON field
        -- `message_id: localId`. The server's idempotency check and the client
        -- derivation both depend on this exact identity join.
}

rule PostAcceptedAsSteeringQueued {
    when: SendPostSucceeded(entry, steering)

    requires: entry.status = pending
    requires: steering

    ensures: entry.accepted_by_server = true
    ensures: entry.status = steering_queued
}

rule PostAcceptedAsPendingReflection {
    when: SendPostSucceeded(entry, steering)

    requires: entry.status = pending
    requires: not steering

    ensures: entry.accepted_by_server = true
    ensures: entry.status = pending
}

rule PostFailedIsRetryable {
    when: SendPostFailed(entry)

    requires: entry.status = pending or entry.status = steering_queued

    ensures: entry.status = failed
    ensures: FailedRender.created(entry: entry)
}

rule RetryFailedMessage {
    when: UserRetries(entry)

    requires: entry.status = failed or entry.status = recoverable_inconsistency

    ensures: entry.status = pending
}

rule DismissLocalMessage {
    when: UserDismisses(entry)

    requires: entry.status = failed or entry.status = steering_queued or entry.status = recoverable_inconsistency

    ensures: entry.status = dismissed
    ensures: entry.visible = false
}

rule AuthoritativeHistoryObserved {
    when: ServerHistoryObserved(scope, message_id)

    ensures: AuthoritativeUserMessage.created(
        scope: scope,
        message_id: message_id
    )
}

rule AuthoritativeMessageReconcilesQueueEntry {
    when: ServerHistoryContains(msg, entry)

    requires: msg.scope = entry.scope
    requires: msg.message_id = entry.local_id
    requires: entry.status = pending or entry.status = steering_queued or entry.status = recoverable_inconsistency

    ensures: entry.status = reconciled
    ensures: entry.visible = false

    @guidance
        -- Implementation: derivePendingMessages filters queue entries whose
        -- `localId` appears in `atom.messages[*].message_id`; no imperative
        -- markSent action is needed. This applies equally to rehydrated local
        -- entries after page reload.
}

rule DerivePendingRender {
    when: RenderConversation(scope)

    ensures:
        for entry in LocalQueueEntries where scope = scope:
            if entry.status = pending or entry.status = steering_queued:
                PendingRender.created(entry: entry)
}

rule DeriveFailedRender {
    when: RenderConversation(scope)

    ensures:
        for entry in LocalQueueEntries where scope = scope and entry.status = failed:
            FailedRender.created(entry: entry)
}

rule AcceptedButCausallyProvenMissingBecomesRecoverable {
    when: LaterTurnActivityProvesAcceptance(entry)

    requires: entry.accepted_by_server = true
    requires: entry.status = pending or entry.status = steering_queued
    requires: not AuthoritativeUserMessage{scope: entry.scope, message_id: entry.local_id}

    ensures: entry.status = recoverable_inconsistency
    ensures: RecoverableInconsistencyRender.created(entry: entry, surfaced: true)

    @guidance
        -- This is the liveness/recovery obligation: once server behaviour proves
        -- the local message was accepted, the UI must not silently keep a
        -- spinner forever. Current implementation prevents the known cause by
        -- making SSE init gap-free; if another cause appears, it must surface an
        -- explicit retry/recovery path rather than indefinite pending display.
}

rule SteeringQueuedDrainsOnAuthoritativeMessage {
    when: ServerHistoryContains(msg, entry)

    requires: entry.status = steering_queued
    requires: msg.scope = entry.scope
    requires: msg.message_id = entry.local_id

    ensures: entry.status = reconciled
    ensures: entry.visible = false
}

rule RehydrateQueueForConversationOnly {
    when: PageLoadsConversation(scope)

    ensures:
        for entry in LocalQueueEntries where entry.scope = scope:
            if entry.status = pending or entry.status = steering_queued or entry.status = failed or entry.status = recoverable_inconsistency:
                entry.visible = true

    @guidance
        -- Queue storage is scoped by conversation id. Navigating between
        -- conversations must not render another conversation's local entries,
        -- even for a single frame.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant RenderedUserMessagesAreUnionWithoutDuplicates {
    for entry in LocalQueueEntries:
        PendingRender{entry: entry} implies
            (entry.status = pending or entry.status = steering_queued)
            and not AuthoritativeUserMessage{scope: entry.scope, message_id: entry.local_id}

    for msg in AuthoritativeUserMessages:
        no PendingRender{entry: LocalQueueEntry{scope: msg.scope, local_id: msg.message_id}}
}

invariant LocalStorageScopedByConversation {
    for entry in LocalQueueEntries:
        entry.scope.conversation_id != ""
}

invariant AcceptedMessagesDoNotRemainSilentPendingForever {
    for entry in LocalQueueEntries:
        entry.accepted_by_server and (entry.status = pending or entry.status = steering_queued) implies
            AuthoritativeUserMessage{scope: entry.scope, message_id: entry.local_id}
            or entry.status = recoverable_inconsistency
}
