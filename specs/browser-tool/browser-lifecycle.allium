-- allium: 3
-- browser-lifecycle.allium
--
-- Browser Session Lifecycle: Behavioural Specification
--
-- Scope: WorkScope-keyed ownership of BrowserSession, lifecycle transitions
-- of BrowserSessionManager (create / kill / idle), the cleanup-cascade
-- preservation rule, and the SSE lifecycle event semantics.
--
-- Excludes:
--   - Chrome/CDP internals (page navigation, console capture, screencast).
--   - Profiling sub-machines — see browser-profiling.allium.
--   - Tool surfaces (browser_navigate etc) — covered in requirements.md.
--
-- Requirement traceability:
--   REQ-BT-010, REQ-BT-011, REQ-BT-012 (existing per-conversation surface).
--   REQ-BROWSER-WS-001..004 (WorkScope ownership).
-- Dependencies: specs/bedrock/bedrock.allium

use "../bedrock/bedrock.allium" as bedrock

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

-- The agent driving browser tools. Identity scoping mirrors tmux/bash:
-- the agent's tools resolve their conversation's WorkScope via
-- ToolContext.work_scope.
actor LlmAgent {
    identified_by: bedrock/Conversation
}

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The Chrome / Chromium process the manager spawns. Phoenix owns the
-- process lifetime: launched on first get_session per scope, dropped on
-- kill_session or idle cleanup. Phoenix does not crash-recover Chrome
-- across Phoenix restarts — sessions are in-memory only.
external entity ChromeProcess {
    user_data_dir: String
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- The durable-owner key for work-affine resources. Defined in
-- crates/phoenix-ide/src/work_scope.rs. Variants carry the worktree path
-- or the conversation id; stable_key() makes the two namespaces disjoint
-- via "worktree:" and "conversation:" prefixes.
value WorkScope {
    kind: WorkScopeKind
    inner: String
}

-- SSE-bound lifecycle event. Carries the WorkScope so the bridge can fan
-- the edge out to every runtime handle whose conversation resolves to
-- the same scope (continuation members).
value BrowserSessionLifecycleEvent {
    work_scope: WorkScope
    kind: BrowserLifecycleKind
}

value BrowserSessionStateEvent {
    conversation: bedrock/Conversation
    active: Boolean
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum WorkScopeKind {
    worktree
    | conversation
}

enum BrowserLifecycleKind {
    active
    | teardown_pending
    | teardown_retry_pending
    | inactive
    | teardown_failed
}

-- Every non-retired reservation occupies the manager's existing registry key.
enum SessionStatus {
    uninitialized
    | live
    | pre_spawn_failed
    | unobservable_attempt
    | teardown_failed
    | torn_down
}

enum BrowserProfilePolicy {
    stable_scope
    | cli_transient
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- One tracked BrowserSession per WorkScope. Continuation conversations that
-- resolve to the same scope share the entity rather than creating their
-- own (REQ-BROWSER-WS-001, REQ-BROWSER-WS-002).
entity BrowserSession {
    scope: WorkScope

    status: SessionStatus
    profile_policy: BrowserProfilePolicy
    user_data_dir: String

    transitions status {
        uninitialized -> live
        uninitialized -> pre_spawn_failed
        uninitialized -> unobservable_attempt
        uninitialized -> teardown_failed
        pre_spawn_failed -> torn_down
        unobservable_attempt -> unobservable_attempt
        live -> teardown_failed
        live -> torn_down
        teardown_failed -> teardown_failed
        teardown_failed -> torn_down
        terminal: torn_down
    }

    chrome: ChromeProcess?

    @invariant CliTransientProfileAdmission
        -- CLI transient profiles are selected only by the standalone CLI policy. A
        -- genuinely fresh or authoritatively retired lifetime receives a new actual
        -- path; cleanup follows that path. A retained owned or unobservable attempt
        -- prevents any replacement lifetime regardless of its proposed path. IDE
        -- managers retain the stable_scope policy and scope-derived path.

    @invariant InitializationAuthority
        -- The reservation exists before any potentially spawning operation. A
        -- returned browser, handler, adopted group, actual profile path, and marker
        -- state remain owned across partial initialization and cleanup failure.
        -- Caller cancellation does not cancel the manager-owned driver. Close
        -- retries retained authority; an unobservable attempt cannot prove absence
        -- or authorize deletion, fallback spawning, or a new profile lifetime.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- REQ-BROWSER-WS-001: at most one tracked session per scope. A retained
-- teardown_failed session still occupies the HashMap key and cannot be replaced.
invariant OneSessionPerScope {
    for s in BrowserSession where s.status != torn_down:
        count(BrowserSession{scope: s.scope, status: live})
            + count(BrowserSession{scope: s.scope, status: teardown_failed})
            + count(BrowserSession{scope: s.scope, status: uninitialized})
            + count(BrowserSession{scope: s.scope, status: pre_spawn_failed})
            + count(BrowserSession{scope: s.scope, status: unobservable_attempt}) <= 1
}

-- Disjoint namespaces: a Worktree scope with the same `inner` as a
-- Conversation scope addresses a different session.
invariant ScopeNamespaceDisjoint {
    for s1 in BrowserSession:
        for s2 in BrowserSession where s1 != s2:
            s1.scope = s2.scope implies s1.scope.kind = s2.scope.kind
}

-- The user data dir is derived from WorkScope::stable_key(). Two sessions
-- that share a scope therefore share the on-disk Chrome profile (which is
-- precisely why continuations inherit cookies / localStorage / open tabs).
invariant ReadyHasRetainedChrome {
    for s in BrowserSession where s.status = live or s.status = teardown_failed:
        s.chrome != null
}

invariant RetainedChromeUsesActualProfile {
    for s in BrowserSession where s.chrome != null:
        s.chrome.user_data_dir = s.user_data_dir
}

invariant UserDataDirDerivedFromScope {
    for s in BrowserSession where s.profile_policy = stable_scope:
        s.user_data_dir = user_data_dir_for_scope(s.scope)
}

------------------------------------------------------------
-- Lifecycle Rules
------------------------------------------------------------

-- REQ-BROWSER-WS-001 / REQ-BT-010: lazy creation on first get_session for
-- a given scope.
-- Helpers:
-- user_data_dir_for_scope(scope: WorkScope) -> String: the stable IDE path.
-- actual_user_data_dir_for_scope(scope: WorkScope) -> String: the path captured
-- from the uniquely owned reservation before cleanup, independent of policy.

rule SessionCreatedOnFirstGet {
    when: AgentCallsBrowserSession(scope, profile_policy, user_data_dir)

    requires: not exists BrowserSession{scope: scope, status: live}
    requires: not exists BrowserSession{scope: scope, status: teardown_failed}
    requires: not exists BrowserSession{scope: scope, status: uninitialized}
    requires: not exists BrowserSession{scope: scope, status: pre_spawn_failed}
    requires: not exists BrowserSession{scope: scope, status: unobservable_attempt}

    ensures: BrowserSession.created(
        scope: scope,
        profile_policy: profile_policy,
        user_data_dir: user_data_dir,
        status: uninitialized
    )

    @guidance
        -- Reserve under the existing scope/actor fence before spawning. IDE callers
        -- select stable_scope; only standalone CLI construction selects
        -- cli_transient. The retained driver owns initialization and listener setup.

}

rule InitializationBecomesReady {
    when: BrowserInitializationSucceeded(session, chrome)
    requires: session.status = uninitialized
    ensures: session.status = live
    ensures: session.chrome = chrome
    ensures: BrowserSessionLifecycleEvent.emitted(
        work_scope: session.scope,
        kind: active
    )
}

rule InitializationFailsBeforeSpawn {
    when: BrowserPreparationFailed(session)
    requires: session.status = uninitialized
    ensures: session.status = pre_spawn_failed
}

rule InitializationFailsWithRetainedBrowser {
    when: BrowserPartialInitializationFailed(session, chrome)
    requires: session.status = uninitialized
    ensures: session.status = teardown_failed
    ensures: session.chrome = chrome
}

rule InitializationFailsWithoutRecoverableHandle {
    when: BrowserLaunchAuthorityUnobservable(session)
    requires: session.status = uninitialized
    ensures: session.status = unobservable_attempt
}

rule PreSpawnFailureRetires {
    when: BrowserPreSpawnReservationClosed(session)
    requires: session.status = pre_spawn_failed
    ensures: session.status = torn_down
    @guidance
        -- Do not delete a pre-existing or untrusted profile. No potentially spawning
        -- operation occurred for this reservation.
}

-- REQ-BROWSER-WS-002: a continuation member calling get_session with the
-- same scope as a still-live predecessor receives the predecessor's Arc.
-- No new entity is created, no lifecycle event is emitted — the session
-- was already active and the UI's initial enriched view will reflect it
-- via is_active(&scope).
rule ContinuationReusesSession {
    when: AgentCallsBrowserSession(scope, profile_policy, user_data_dir)

    requires: exists BrowserSession{scope: scope, status: live}

    ensures: not BrowserSession.created
    ensures: not BrowserSessionLifecycleEvent.emitted
}

-- These execution-row cascade rules apply only when the ProductConversation
-- is not being retired. Aggregate Close/Delete uses durable retirement authority:
-- same-aggregate continuation/subagent rows do not veto resource cleanup; only
-- a distinct still-Open aggregate retains a scope, with identity conflicts surfaced.
-- REQ-BROWSER-WS-003: cleanup-cascade tear-down when no live conversation
-- other than the one being deleted still owns the scope. The orchestrator
-- sets `inheritor_scope` to Some(work_scope) iff a live conversation
-- OTHER THAN the deleted one resolves to that scope (a continuation that
-- inherits it, or a live sibling such as a Work-mode sub-agent sharing its
-- parent's scope), and None otherwise. A live conversation is one that is BOTH
-- non-terminal in state AND not archived, determined from the persisted
-- conversation rows in the DATABASE — NOT from the set of live runtime
-- handles. A non-terminal conversation with no runtime handle (after a server
-- restart or runtime eviction) is still a live owner; enumerating handles
-- would tear down a scope whose surviving owner is handle-less. An archived
-- conversation does not count as a live owner even while non-terminal, because
-- archiving a chain archives earlier members before the leaf's cascade runs.
-- The deleted conversation is excluded from that
-- enumeration: the cascade runs before its terminal-state write, so it still
-- reads non-terminal, and excluding it is what makes this rule reachable when
-- it is the last live owner. Preservation is the complementary case — see
-- CascadePreservesOnScopeMatch below.
--
-- The inheritor-scope derivation reads the persisted conversation rows. When
-- the DB is unreadable the live-owner question is unanswerable, so the
-- orchestrator refuses the whole cascade and surfaces the error rather than
-- proceeding from an assumed-live answer (which would skip every teardown
-- while the row is archived/deleted, orphaning resources with no retry). The
-- refusal precedes every side effect, so CleanupCascadeRunFor never fires in
-- that case and both cascade rules below remain exact. This is the opposite
-- of the idle reaper, which fails closed and preserves on an unreadable DB —
-- there preserving is the safe error response, here it is the unsafe one.
rule BrowserScopeRetirementBlocksAuthorityPromotion {
    when: BrowserScopeRetirementRequested(work_scope)

    ensures: BrowserScopeRetirementFenceEstablished(work_scope)
    ensures: not BrowserSessionAuthorityPromoted(work_scope)

    @guidance
        -- Promotion and retirement admission share the manager-state write lock.
        -- A fenced scope or actor key rejects promotion before its session entry
        -- can move to the shared WorkScope key. Reopening admission preserves the
        -- destination retirement generation; a restricted session may promote only
        -- when the destination generation still matches the one observed at creation.
}

rule CascadeTearsDownWhenNoInheritor {
    when: BrowserTeardownSucceeded(conversation, inheritor_scope)

    let work_scope = resolve_work_scope(conversation)

    requires: inheritor_scope != Some(work_scope)
    requires: exists BrowserSession{scope: work_scope, status: live}

    ensures: BrowserSession.transitioned(
        scope: work_scope,
        from: live,
        to: torn_down
    )
    ensures: BrowserSessionLifecycleEvent.emitted(
        work_scope: work_scope,
        kind: inactive
    )
    ensures: UserDataDirRemoved(actual_user_data_dir_for_scope(work_scope))

    @guidance
        -- The kill awaits explicit Chrome termination before removing the
        -- user data dir and manager entry. Teardown completion therefore
        -- means the process and its SingletonLock have been released.
}

-- REQ-BROWSER-WS-003: cleanup-cascade preservation when a live conversation
-- A failed process termination or profile removal retains the manager entry as
-- a retryable control-plane resource, but the session is not reusable.
rule CascadeTeardownFailureRetained {
    when: BrowserTeardownFailed(conversation, inheritor_scope)

    let work_scope = resolve_work_scope(conversation)

    requires: inheritor_scope != Some(work_scope)
    requires: exists BrowserSession{scope: work_scope, status: live}

    ensures: BrowserSession.transitioned(
        scope: work_scope,
        from: live,
        to: teardown_failed
    )
    ensures: BrowserSessionLifecycleEvent.emitted(
        work_scope: work_scope,
        kind: teardown_failed
    )
    ensures: not UserDataDirRemoved(actual_user_data_dir_for_scope(work_scope))
}

rule FailedTeardownRetryStarts {
    when: BrowserTeardownRetryStarted(work_scope)

    requires: exists BrowserSession{scope: work_scope, status: teardown_failed}

    ensures: BrowserSessionLifecycleEvent.emitted(
        work_scope: work_scope,
        kind: teardown_retry_pending
    )
}

-- A retry is tied to one teardown generation. Its completion cannot be inferred
-- from a later generation's state.
rule FailedTeardownRetrySucceeds {
    when: BrowserTeardownRetrySucceeded(work_scope)

    requires: exists BrowserSession{scope: work_scope, status: teardown_failed}

    ensures: BrowserSession.transitioned(
        scope: work_scope,
        from: teardown_failed,
        to: torn_down
    )
    ensures: BrowserSessionLifecycleEvent.emitted(
        work_scope: work_scope,
        kind: inactive
    )
    ensures: UserDataDirRemoved(actual_user_data_dir_for_scope(work_scope))
}

rule FailedTeardownRetryFails {
    when: BrowserTeardownRetryFailed(work_scope)

    requires: exists BrowserSession{scope: work_scope, status: teardown_failed}

    ensures: BrowserSession.status = teardown_failed
    ensures: BrowserSessionLifecycleEvent.emitted(
        work_scope: work_scope,
        kind: teardown_failed
    )
    ensures: not UserDataDirRemoved(actual_user_data_dir_for_scope(work_scope))
}

-- REQ-BROWSER-WS-003: cleanup-cascade preservation when a live conversation
-- other than the one being deleted still owns the scope — a continuation
-- that inherits it, or a live sibling such as a Work-mode sub-agent sharing
-- its parent's scope. Ordinary continuations retain the selected parent's
-- exact persisted scope, including Direct/non-Git members; new transcript
-- identity does not select a different browser resource owner. Distinct
-- historical scope identities remain separate regardless of cwd equality.
rule CascadePreservesOnScopeMatch {
    when: CleanupCascadeRunFor(conversation, inheritor_scope)

    let work_scope = resolve_work_scope(conversation)

    requires: inheritor_scope = Some(work_scope)

    ensures: not BrowserSession.transitioned
    ensures: not BrowserSessionLifecycleEvent.emitted
    ensures: not UserDataDirRemoved

    @guidance
        -- The skip is observable only as a `debug` log line — the
        -- absence of a kill is otherwise indistinguishable from "no
        -- session existed." REQ-BROWSER-WS-004.
}

-- REQ-BT-010: liveness-gated idle cleanup. The manager's background task
-- tears down a live session only when it is BOTH idle past IDLE_TIMEOUT AND
-- its scope owns no live conversation. Liveness is "does any live conversation
-- resolve to this scope?" — where a live conversation is one that is BOTH
-- non-terminal in state AND not archived — using the same scope resolution the
-- lifecycle fan-out uses (resolve_work_scope, REQ-BROWSER-WS-002) against
-- bedrock's is_terminal and the archived flag. The IDLE_TIMEOUT timer is a
-- backstop for genuinely
-- abandoned scopes, not a hard cap on live work: a conversation alive in the
-- UI but quiet on browser tools keeps its session regardless of idle age.
-- specs/git-repository/ REQ-PROJ-025 guarantees at
-- most one non-terminal conversation per scope, so the liveness question has
-- a single decisive answer. The gate mirrors the cascade path
-- (CascadePreservesOnScopeMatch), which preserves a session whose scope is
-- still owned by any live conversation — a continuation or a live sibling
-- such as a Work-mode sub-agent sharing its parent's scope.
rule IdleSessionCleanedUp {
    when: IdleBrowserTeardownSucceeded(session)

    for session in BrowserSession where session.status = live:
        let scope_is_live = bedrock/Conversations.any(c =>
            resolve_work_scope(c) = session.scope and not c.is_terminal and not c.archived)

        requires: (now - session.last_activity) > IDLE_TIMEOUT
        requires: not scope_is_live

        ensures: session.status = torn_down
        ensures: BrowserSessionLifecycleEvent.emitted(
            work_scope: session.scope,
            kind: inactive
        )
        ensures: UserDataDirRemoved(session.user_data_dir)
}

rule IdleSessionTeardownFailureRetained {
    when: IdleBrowserTeardownFailed(session)

    requires: session.status = live
    requires: (now - session.last_activity) > IDLE_TIMEOUT
    requires: not bedrock/Conversations.any(c =>
        resolve_work_scope(c) = session.scope and not c.is_terminal and not c.archived)

    ensures: session.status = teardown_failed
    ensures: BrowserSessionLifecycleEvent.emitted(
        work_scope: session.scope,
        kind: teardown_failed
    )
    ensures: not UserDataDirRemoved(session.user_data_dir)
}

-- REQ-BT-010: the skip path. An idle session whose scope is still live — a
-- non-terminal, non-archived conversation resolves to it — is NOT torn down on the idle
-- tick. It is re-checked on the next interval. This is the standing
-- guarantee that liveness preempts the idle timer.
rule IdleSessionPreservedWhileScopeLive {
    when: IdleCleanupTickFires()

    for session in BrowserSession where session.status = live:
        let scope_is_live = bedrock/Conversations.any(c =>
            resolve_work_scope(c) = session.scope and not c.is_terminal and not c.archived)

        requires: scope_is_live

        ensures: session.status = live
        ensures: not BrowserSessionLifecycleEvent.emitted
}

------------------------------------------------------------
-- Lifecycle Event Fan-Out
------------------------------------------------------------

-- REQ-BROWSER-WS-002: each emitted BrowserSessionLifecycleEvent is fanned
-- out by the runtime bridge to every live runtime handle whose
-- conversation resolves to the event's scope. A worktree-scoped session
-- may have multiple continuation members subscribed to SSE; all of them
-- need the state edge.
rule LifecycleEventFannedOut {
    when: BrowserSessionLifecycleEvent.emitted(scope, kind)

    ensures: for c in bedrock/Conversation
             where resolve_work_scope(c) = scope
             and live_runtime_exists(c):
        BrowserSessionStateEvent.emitted(
            conversation: c,
            active: kind = active or kind = teardown_pending
        )

    @guidance
        -- The bridge iterates the runtimes map and, for each handle,
        -- looks up the conversation in the DB to derive its scope. N is
        -- typically small (active runtimes only); the per-event cost is
        -- one DB read per live runtime. No precomputed scope index is
        -- maintained.
}

------------------------------------------------------------
-- Capability-Gap Logging
------------------------------------------------------------

-- REQ-BROWSER-WS-004: the three known capability-gap edges (get_existing
-- miss, cascade skip, sink-closed) MUST produce `debug` log lines so an
-- operator can distinguish "no event" (working as intended) from "event
-- got lost" (a bug to investigate).
invariant DebugLogOnCapabilityGap {
    for call in GetExistingCall where call.result = none:
        DebugLog.emitted(call.scope)
}
