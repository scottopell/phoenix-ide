-- allium: 3
-- chat-completions.allium
--
-- OpenAI-compatible Chat Completions wire contract.
--
-- Scope: Translation of llm/LlmRequest into Chat Completions messages,
--        normalization of non-streaming and streaming responses into
--        llm/LlmResponse, and classification of Chat stream failures.
--
-- Includes: Exact endpoint selection; message/tool/image translation;
--           tool-call ID preservation; capability-gap logging; cached-token
--           accounting; private-reasoning omission; finish-reason handling;
--           streaming usage requests, tool-fragment assembly, and terminality.
--
-- Excludes: Shared request/response vocabulary and error taxonomy (llm.allium);
--           Anthropic Messages (anthropic.allium); OpenAI Responses
--           (responses.allium); model discovery and picker presentation.
--
-- Normative companions: requirements.md REQ-LLM-001, 002, 004, 005, 006, 007, 008, 009.

use "./llm.allium" as llm

-- First-party OpenAI contracts and compatible-route capability boundaries:
-- https://developers.openai.com/api/docs/guides/function-calling
-- https://developers.openai.com/api/reference/resources/chat/subresources/completions/methods/create
-- A compatible message shape does not establish native tool-choice support.

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum ChatStreamStatus { accumulating | done | failed }
enum ChatFinishReason { stop | tool_calls | length | content_filter | other }
enum ChatMessageRole { system | user | assistant | tool }
enum ChatContentKind { text | image_url }

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value ChatUsage {
    prompt_tokens: Integer
    completion_tokens: Integer
    cached_prompt_tokens: Integer
}

value ChatToolCall {
    id: String
    name: String
    arguments: String
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity ChatEndpoint {
    exact_url: String
}

entity ChatWireMessage {
    role: ChatMessageRole
    content_kinds: List<ChatContentKind>
    tool_call_id: String?
    tool_calls: List<ChatToolCall>
}

entity ChatRequest {
    model: String
    messages: List<ChatWireMessage>
    stream: Boolean
    include_usage: Boolean
    tool_count: Integer
    tool_choice: ChatToolChoice
    reasoning_effort: String?
}

entity ChatToolChoice {
    availability: llm/ToolAvailability
    kind: ChatAutoTools | ChatNoTools | ChatAllowedTools | ChatAdvisoryTools
}

variant ChatAutoTools : ChatToolChoice {}
variant ChatNoTools : ChatToolChoice {}
variant ChatAdvisoryTools : ChatToolChoice {}
variant ChatAllowedTools : ChatToolChoice {
    allowed_names: List<String>
}

entity ChatResponse {
    finish_reason: ChatFinishReason
    final_text: String?
    refusal: String?
    private_reasoning: String?
    tool_calls: List<ChatToolCall>
    usage: ChatUsage?
}

entity ChatStream {
    status: ChatStreamStatus
    terminal_observed: Boolean
    text: String
    tool_calls: List<ChatToolCall>
    usage: ChatUsage?
    provider_event_count: Integer
    generation_event_count: Integer

    transitions status {
        accumulating -> done
        accumulating -> failed
        terminal: done, failed
    }
}

entity ChatDroppedProviderBlock {
    block_kind: llm/ContentKind
    logged: Boolean
}

entity ChatPrivateReasoningOmission {
    bytes: Integer
    logged: Boolean
}

------------------------------------------------------------
-- Contracts — provider tool selection and historical calls
------------------------------------------------------------

contract ChatToolContinuation {
    continue_exchange: (messages: List<ChatWireMessage>, availability: llm/ToolAvailability) -> List<ChatWireMessage>
    select_tools: (availability: llm/ToolAvailability, support: llm/NativeToolRestrictionSupport) -> ChatToolChoice

    @invariant ToolPolicyIsRenderedForChat
        -- Derive this request's selection from current conversation policy.
        -- Never serialize Anthropic tool-change events or private blocks,
        -- Responses allowed_tools shapes, or Responses continuation handles
        -- and reasoning items. Apply this exact route's supported Chat controls
        -- or advisory restrictions with independent execution admission.

    @invariant HistoricalCallsRemainPaired
        -- Preserve assistant tool_calls (IDs, names, JSON arguments) and their
        -- subsequent tool-role results with matching tool_call_id. Answer every
        -- pending call before proceeding; do not leave an orphaned result or
        -- remove a call/result because its function is no longer executable.
        -- Failure is represented in tool-message content; there is no portable
        -- Anthropic is_error field. Keep the original error evidence.

    @invariant SelectionDoesNotRewriteMessages
        -- tools describes functions the model may call on the current request;
        -- tool_choice controls new generation, not historical tool-call identity.
        -- First-party OpenAI supports auto, none, required, named selection,
        -- and allowed_tools. There is no documented monotonic-callability rule
        -- or requirement to delete history when callability changes.
        -- Retaining definitions while narrowing allowed_tools is a supported
        -- way to preserve history and avoid changes to the cached declarations.
        -- This does not prove acceptance of omitted historical definitions by
        -- every model or compatible endpoint.

    @invariant ChatAllowedToolsWireShape
        -- A restricted nonempty subset uses tool_choice =
        -- {type:"allowed_tools", allowed_tools:{mode:"auto",tools:[
        --   {type:"function",function:{name:N}}]}}.
        -- All selected functions have complete declarations in tools.
        -- The nested allowed_tools object and nested function.name distinguish
        -- this shape from the Responses API. Full eligibility uses auto;
        -- empty eligibility uses none. required is not Phoenix's default.

    @invariant CompatibilityDoesNotImplyNativeRestriction
        -- Native controls require a verified exact endpoint/model capability.
        -- Third-party compatibility alone establishes neither allowed_tools
        -- support nor acceptance of history whose declarations are absent.
        -- Unknown/unsupported routes retain definitions, append instructions
        -- describing the restriction, and enforce unavailable results locally.
        -- Use verified basic tool_choice controls where available; do not send
        -- allowed_tools speculatively, or erase history to conceal rejection.

    @invariant ReasoningContractIsRouteSpecific
        -- First-party Chat Completions does not use the Responses reasoning-item
        -- replay protocol. A third-party reasoning_content field is not portable
        -- proof of that protocol and never becomes visible answer text.
        -- A provider requiring private reasoning echo needs its own explicit
        -- continuation capability contract; do not infer it from Chat compatibility.
}

------------------------------------------------------------
-- Helpers (pure functions referenced by the rules below)
------------------------------------------------------------
--
-- Allium has no formal helper-function declaration; rules call these by
-- bare identifier. This block is the single source of truth for signatures
-- and semantics.
--
--   wire_model_name(request: llm/LlmRequest) -> String
--       Returns the selected route's configured wire model name. This may
--       differ from the user-facing registry ID; no model-family or backend
--       inference changes it.
--
--   translate_chat_messages(request: llm/LlmRequest) -> List<ChatWireMessage>
--       Translates the request in source order. System segments become a
--       system message; user and assistant text/image blocks retain order;
--       ToolUse becomes assistant tool_calls; ToolResult becomes a tool-role
--       message whose tool_call_id is the exact model-issued ID. Unsupported
--       content is consumed only through a declared logged-drop rule.
--       An explicit effective effort is encoded in reasoning_effort using its
--       provider-native wire name; model-native default effort omits the field.
--
--   normalize_chat_usage(usage: ChatUsage?) -> llm/Usage
--       Null usage yields zero usage. Otherwise cached_prompt_tokens is read
--       from wire prompt_tokens_details.cached_tokens, must not exceed the
--       inclusive wire prompt_tokens total, and is split into Phoenix's
--       cache-read bucket. Uncached input is prompt_tokens minus cached reads;
--       output is completion_tokens. Provider reasoning tokens come from
--       completion_tokens_details.reasoning_tokens and remain usage metadata,
--       never visible reasoning content.
--
--   normalized_visible_text(response: ChatResponse) -> String?
--       Returns exactly one public text carrier: refusal when present,
--       otherwise final_text. Private wire reasoning_content maps to
--       response.private_reasoning and is never included.
--
--   normalized_tool_ids(response: ChatResponse) -> List<String>
--       Returns tool-call IDs from the normalized llm/LlmResponse in source
--       order.
--
--   wire_tool_ids(response: ChatResponse) -> List<String>
--       Returns response.tool_calls IDs in wire order. Equality with
--       normalized_tool_ids proves IDs are preserved rather than regenerated.
--
--   classify_chat_error(code: JSON scalar?, message: String) -> llm/LlmError
--       Numeric values and numeric strings retain HTTP classification. Named
--       string codes use
--       the shared exhaustive error taxonomy. Missing and unknown inline
--       stream codes use the shared server-error policy because no transport
--       status is available in an inline event.
--
--   length(value: String) -> Integer
--       Returns the UTF-8 byte length used by content-free omission logging;
--       it never exposes or persists the private reasoning text.
--
------------------------------------------------------------

------------------------------------------------------------
-- Rules — endpoint and request translation
------------------------------------------------------------

rule ChatToolChoiceSelected {
    when: SelectChatTools(availability, support)
    requires: support = supported
    ensures:
        if availability.callable_names.count = 0:
            ChatNoTools.created(availability: availability)
        else:
            if availability.callable_names.count = availability.declarations.count:
                ChatAutoTools.created(availability: availability)
            else:
                ChatAllowedTools.created(availability: availability, allowed_names: availability.callable_names)
}

rule ChatAdvisoryToolChoiceSelected {
    when: SelectChatTools(availability, support)
    requires: support in { unsupported, unknown }
    ensures: ChatAdvisoryTools.created(availability: availability)
}

rule ChatEndpointResolved {
    when: ResolveChatEndpoint(configured_url?)

    ensures:
        if configured_url != null:
            ChatEndpoint.created(exact_url: configured_url)
        else:
            ChatEndpoint.created(exact_url: "https://api.openai.com/v1/chat/completions")
}

rule ChatRequestTranslated {
    when: TranslateChatRequest(request, choice)

    requires: choice.availability = request.tool_availability

    ensures: ChatRequest.created(
        model: wire_model_name(request),
        messages: translate_chat_messages(request),
        stream: false,
        include_usage: false,
        tool_count: request.tool_count,
        tool_choice: choice,
        reasoning_effort: request.effective_effort.explicit_level
    )

    @guidance
        -- System content becomes one system message. User/assistant text and
        -- images preserve source order. ToolUse becomes assistant tool_calls;
        -- ToolResult becomes a tool-role message carrying the exact model-issued
        -- tool_call_id. Tool definitions use function-tool wire shape.
}

rule ChatStreamingRequested {
    when: TranslateStreamingChatRequest(request, choice)

    requires: choice.availability = request.tool_availability

    ensures: ChatRequest.created(
        model: wire_model_name(request),
        messages: translate_chat_messages(request),
        stream: true,
        include_usage: true,
        tool_count: request.tool_count,
        tool_choice: choice,
        reasoning_effort: request.effective_effort.explicit_level
    )
}

rule UnsupportedProviderBlockLoggedAndDropped {
    when: TranslateChatContent(block)

    requires: block.kind not in { text, image, tool_use, tool_result }

    ensures: ChatDroppedProviderBlock.created(
        block_kind: block.kind,
        logged: true
    )
}

rule AssistantImageLoggedAndDropped {
    when: TranslateAssistantChatContent(block)

    requires: block.kind = image

    ensures: ChatDroppedProviderBlock.created(
        block_kind: image,
        logged: true
    )
}

rule ToolResultImagesLoggedAndDropped {
    when: TranslateChatContent(block)

    requires: block.kind = tool_result
    requires: block.tool_result_images.count > 0

    ensures: ChatDroppedProviderBlock.created(
        block_kind: tool_result,
        logged: true
    )
}

------------------------------------------------------------
-- Rules — response normalization
------------------------------------------------------------

rule ChatTextNormalized {
    when: NormalizeChatResponse(response)

    requires: response.finish_reason in { stop, other }
    requires: response.final_text != null

    ensures: llm/LlmResponse.created(
        end_turn: true,
        usage: normalize_chat_usage(response.usage)
    )
}

rule ChatRefusalNormalized {
    when: NormalizeChatResponse(response)

    requires: response.finish_reason in { stop, other }
    requires: response.refusal != null

    ensures: llm/LlmResponse.created(
        end_turn: true,
        usage: normalize_chat_usage(response.usage)
    )
    ensures: normalized_visible_text(response) = response.refusal
}

rule ChatToolCallsNormalized {
    when: NormalizeChatResponse(response)

    requires: response.finish_reason = tool_calls
    requires: response.tool_calls.count > 0

    ensures: llm/LlmResponse.created(
        end_turn: false,
        usage: normalize_chat_usage(response.usage)
    )
    ensures: normalized_tool_ids(response) = wire_tool_ids(response)
}

rule PrivateReasoningOmitted {
    when: NormalizeChatResponse(response)

    requires: response.private_reasoning != null

    ensures: ChatPrivateReasoningOmission.created(
        bytes: length(response.private_reasoning),
        logged: true
    )
    ensures: normalized_visible_text(response) = response.final_text
}

rule ChatLengthFinishRejected {
    when: NormalizeChatResponse(response)

    requires: response.finish_reason = length

    ensures: llm/LlmError.created(
        kind: invalid_response,
        message: "Chat completion ended at its output token limit",
        recovery_in_progress: false,
        has_quota: false
    )
}

rule ChatContentFilterRejected {
    when: NormalizeChatResponse(response)

    requires: response.finish_reason = content_filter

    ensures: llm/LlmError.created(
        kind: content_filter,
        message: "Chat completion was blocked by the provider content filter",
        recovery_in_progress: false,
        has_quota: false
    )
}

------------------------------------------------------------
-- Rules — streaming accumulation
------------------------------------------------------------

rule ChatStreamEventObserved {
    when: ChatStreamEventReceived(stream, generation_kind?)

    requires: stream.status = accumulating

    ensures: stream.provider_event_count = stream.provider_event_count + 1
    ensures:
        if generation_kind != null:
            stream.generation_event_count = stream.generation_event_count + 1
}

rule ChatStreamCompleted {
    when: ChatTerminalEventReceived(stream, finish_reason, usage?)

    requires: stream.status = accumulating
    requires: finish_reason in { stop, tool_calls, other }

    ensures: stream.status = done
    ensures: stream.terminal_observed = true
    ensures: stream.usage = usage
    ensures: llm/LlmResponse.created(
        end_turn: stream.tool_calls.count = 0,
        usage: normalize_chat_usage(stream.usage)
    )
}

rule ChatDoneSentinelObserved {
    when: ChatDoneSentinelReceived(stream)

    requires: stream.status = accumulating

    ensures: stream.status = done
    ensures: stream.terminal_observed = true
}

rule ChatInlineErrorRejected {
    when: ChatInlineErrorReceived(stream, code, message)

    requires: stream.status = accumulating

    ensures: stream.status = failed
    ensures: classify_chat_error(code, message)
}

rule ChatStreamWithoutTerminalRejected {
    when: ChatTransportEnded(stream)

    requires: stream.status = accumulating
    requires: stream.terminal_observed = false

    ensures: stream.status = failed
    ensures: llm/LlmError.created(
        kind: invalid_response,
        message: "Chat completion stream ended without a terminal event",
        recovery_in_progress: false,
        has_quota: false
    )
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant ChatCachedTokensAreSubsetOfPromptTokens {
    for response in ChatResponses where response.usage != null:
        response.usage.cached_prompt_tokens <= response.usage.prompt_tokens
}

invariant ChatToolResultReferencesModelIssuedCall {
    for message in ChatWireMessages where message.role = tool:
        message.tool_call_id != null
}

invariant ChatAllowedSelectionMatchesCurrentEligibility {
    for choice in ChatToolChoices where choice.kind = ChatAllowedTools:
        choice.allowed_names = choice.availability.callable_names
        choice.allowed_names.count > 0
        choice.allowed_names.count < choice.availability.declarations.count
}

invariant ChatCompletedStreamsObservedTerminal {
    for stream in ChatStreams where stream.status = done:
        stream.terminal_observed = true
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface ChatCompletionsBoundary {
    facing: PhoenixRuntime

    context request: llm/LlmRequest
    context endpoint: ChatEndpoint
    context chat_request: ChatRequest
    context message: ChatWireMessage
    context response: ChatResponse
    context stream: ChatStream
    context dropped: ChatDroppedProviderBlock
    context reasoning_omission: ChatPrivateReasoningOmission

    contracts:
        fulfils ChatToolContinuation
        fulfils llm/ToolHistoryIntegrity
        demands llm/ProviderRequestProjection

    exposes:
        endpoint.exact_url
        chat_request.model
        chat_request.messages
        chat_request.stream
        chat_request.include_usage
        chat_request.reasoning_effort
        chat_request.tool_choice
        message.content_kinds
        stream.text
        dropped.block_kind
        dropped.logged
        reasoning_omission.bytes
        reasoning_omission.logged

    provides:
        SelectChatTools(availability, support)
        ResolveChatEndpoint(configured_url?)
        TranslateChatRequest(request, choice)
        TranslateStreamingChatRequest(request, choice)
        TranslateChatContent(block)
        TranslateAssistantChatContent(block)
        NormalizeChatResponse(response)
        ChatStreamEventReceived(stream, generation_kind?)
        ChatTerminalEventReceived(stream, finish_reason, usage?)
        ChatDoneSentinelReceived(stream)
        ChatInlineErrorReceived(stream, code, message)
        ChatTransportEnded(stream)
}
