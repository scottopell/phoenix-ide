-- allium: 3
-- llm.allium
--
-- LLM Provider: shared vocabulary and provider-agnostic contracts.
--
-- Scope: The internal request/response vocabulary every LLM provider
--        translates to and from, the exhaustive error taxonomy, and the
--        invariants that hold regardless of which provider served a turn.
--        This is the base module imported by the per-provider wire specs.
--
-- Includes: The internal ContentBlock kinds; LlmRequest / LlmResponse /
--           LlmMessage shape; the Usage token-accounting value; the
--           streaming TokenChunk; the LlmErrorKind taxonomy and its
--           automatic retry and user-resume partitions; the rule that structured quota
--           detail is carried by an error iff it is a usage-limit
--           exhaustion.
--
-- Excludes: Provider wire formats — request translation, response
--           normalization, the SSE streaming accumulators (see
--           anthropic.allium, responses.allium, and chat-completions.allium).
--           Error *classification* — the mapping from an HTTP status or
--           SSE payload to an LlmErrorKind. That is per-provider; this
--           module only fixes the taxonomy the classifiers must target.
--           Gateway routing, model registry, model discovery.
--
-- Self-contained: no `use` imports. The per-provider specs import
--           this file as `llm` and create llm/LlmError and
--           llm/LlmResponse instances through their own rules.
--
-- Wire discriminants and native tool restrictions are provider-specific.
-- Shared vocabulary must preserve the distinction between a retained tool
-- declaration, eligibility for a new invocation, and evidence of a past call.
--
-- Normative companions:
--   specs/llm/requirements.md  — REQ-LLM-001..009
--   specs/llm/design.md        — LlmService, LlmError, LlmErrorKind
--   specs/llm/anthropic.allium — Anthropic Messages wire contract
--   specs/llm/responses.allium — OpenAI Responses API wire contract
--   specs/llm/chat-completions.allium — OpenAI-compatible Chat Completions wire contract
--
-- Cross-references:
--   crates/phoenix-core/src/domain/llm_types.rs — ContentBlock, LlmRequest,
--                                                  LlmResponse, Usage, ImageSource
--   crates/phoenix-llm/src/error.rs             — LlmError, LlmErrorKind
--   crates/phoenix-llm/src/lib.rs               — TokenChunk, LlmService trait

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- Role of a conversation message. Phoenix has no `system` role: system
-- prompt content is carried separately on LlmRequest.system and each
-- provider places it in its own format (Anthropic top-level `system`,
-- Responses API `instructions`).
enum MessageRole { user | assistant }

-- A compatible endpoint's wire format alone does not prove feature support.
enum NativeToolRestrictionSupport { supported | unsupported | unknown }
enum ToolAdmissionStatus { admitted | unavailable }

-- The discriminant of an internal ContentBlock. The string values are
-- exactly ContentBlock::type_tag() in types.rs — the serde `type` tag of
-- the internal representation, which is NOT necessarily the wire tag any
-- provider emits (that mapping is the subject of the per-provider specs).
--
-- text, image, tool_use and tool_result are the portable kinds: every
-- provider can represent them. The remaining nine are Anthropic
-- server-handled blocks — executed by the Anthropic API and preserved
-- verbatim for multi-turn history fidelity. A provider with no wire
-- equivalent must drop them through a logged capability gap, never
-- silently (see responses.allium ResponsesServerBlockDropped).
enum ContentKind {
    text
    | image
    | tool_use
    | tool_result
    | server_tool_use
    | tool_search_tool_result
    | web_search_tool_result
    | web_fetch_tool_result
    | code_execution_tool_result
    | bash_code_execution_tool_result
    | text_editor_code_execution_tool_result
    | mcp_tool_use
    | mcp_tool_result
}

-- Exhaustive error taxonomy. No `Unknown`, no catch-all: adding a class
-- forces a variant here and an explicit decision in every classifier and
-- every consumer (REQ-LLM-006). The automatic retry / user-resume split is a
-- structural property — see the derived fields on LlmError
-- and the RetryablePartition invariant.
--
-- rate_limit and usage_limit_reached are deliberately distinct: a 429
-- can be a transient per-window throttle (retry in seconds) or a quota
-- window exhausted on a calendar boundary (retry next week). Collapsing
-- them either wastes retries or misclassifies recovery.
enum LlmErrorKind {
    network
    | timed_out
    | rate_limit
    | usage_limit_reached
    | server_error
    | server_overloaded
    | auth
    | invalid_request
    | prompt_rejected
    | invalid_response
    | content_filter
    | context_window_exceeded
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- A base64-encoded image. The only ImageSource variant in types.rs.
value ImageBase64 {
    media_type: String
    data: String
}

-- One system-prompt segment. `cache` requests an Anthropic per-block
-- cache_control anchor. OpenAI instructions cannot carry breakpoints; its
-- explicit markers are placed on supported message content blocks.
value SystemContent {
    text: String
    cache: Boolean
}

-- Token accounting for one completed turn. `context_window_used` is the
-- single definition of "how full is the window" — input + output + both
-- cache buckets. Each provider's normalizer must populate the buckets so
-- this sum equals the provider's own reported total (see
-- ResponsesCachedSubsetOfInput in responses.allium).
value Usage {
    input_tokens: Integer
    output_tokens: Integer
    cache_creation_tokens: Integer
    cache_read_tokens: Integer

    context_window_used:
        input_tokens + output_tokens + cache_creation_tokens + cache_read_tokens
}

-- One content block inside a message. Phoenix's internal representation,
-- before any provider translation. `kind` is the discriminator.
--
-- `tool_result_images` is the load-bearing field for the wire
-- discriminant contract: a tool_result with a non-empty image list
-- forces a structured (multi-part) wire encoding. The list is empty
-- for every kind other than tool_result.
value ContentBlock {
    kind: ContentKind
    tool_result_images: List<ImageBase64>
    tool_result_is_error: Boolean
}

-- One conversation message handed to a provider.
value LlmMessage {
    source_message_id: String?
    role: MessageRole
    content: List<ContentBlock>
}

-- The resolved effort state carried to provider translation. Only an explicit
-- conversation override has an explicit_level; native-known, native-unknown,
-- and unsupported states leave it null so providers retain native behavior.
value EffectiveEffort {
    explicit_level: String?
}

value ToolDeclaration {
    name: String
    description: String
    input_schema: Any
}

-- A provider-agnostic completion request. `tool_count` is derived from
-- retained declarations, not from the subset eligible for new execution.
-- `cache_key` is the caller-chosen prompt-cache cohort
-- id (PromptCacheKey) — mandatory on the typed request; consumed by the
-- Responses API as `prompt_cache_key`, ignored by Anthropic.
value LlmRequest {
    system: List<SystemContent>
    messages: List<LlmMessage>
    tool_availability: ToolAvailability
    tool_count: tool_availability.declarations.count
    max_tokens: Integer?
    effective_effort: EffectiveEffort
    cache_key: String
}

-- A streaming chunk forwarded to the UI mid-turn. Phoenix's TokenChunk
-- has exactly one variant: a text delta. Tool-call argument fragments
-- are NOT streamed — they are accumulated provider-side and only appear
-- in the final assembled LlmResponse. See the per-provider streaming
-- accumulators for where text chunks are forwarded.
value TokenChunk {
    text: String
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- One request's tool policy. Definitions describe tools for provider history
-- and rendering; callable_names authorizes new execution. They have different
-- consumers and may differ when a phase ends or a service becomes unavailable.
-- Each name retains its latest authentic declaration when absent from the live
-- catalog. Native continuation separately owns immutable initial declarations
-- and the complete ordered definition changes used for its historical prefix.
entity ToolAvailability {
    declarations: List<ToolDeclaration>
    callable_names: List<String>
}

-- A route identifies the concrete provider endpoint and execution protocol,
-- including the selected account ID for account-bound Codex execution. An
-- ordinary token refresh for that account does not change the route identity.
-- The continuation identity changes when a provider switch settles.
entity ConversationProviderContext {
    conversation_id: String
    route_id: String
    continuation_id: String
    tool_availability: ToolAvailability
}

entity ToolAdmission {
    tool_name: String
    status: ToolAdmissionStatus
}

-- A provider-agnostic completion response. Created by each provider's
-- normalizer. `end_turn` means the model has nothing further to do (no
-- pending tool calls). The normalized content blocks are not modelled as
-- a field — per-block normalization is documented in each provider
-- spec's @guidance; this entity exists so cross-provider invariants
-- (token accounting) can range over completed responses.
entity LlmResponse {
    end_turn: Boolean
    usage: Usage
}

-- A classified LLM failure. Created by the per-provider error
-- classifiers (Anthropic SSE / HTTP status; Responses SSE / codex
-- backend). `kind` is set once at creation and never transitions.
--
-- `auto_retryable`, `overload_retryable`, and `user_resumable` are derived,
-- not stored: each decision is a pure function of `kind`, so the generic and
-- selected-model overload policies cannot drift into one another.
-- `has_quota` records whether structured QuotaDetails is attached; it is
-- bound to `usage_limit_reached` by QuotaBoundToUsageLimit.
entity LlmError {
    kind: LlmErrorKind
    message: String
    -- True when a recovery mechanism (e.g. the credential helper) is
    -- already running and may resolve this error; the state machine
    -- waits rather than treating the error as terminal.
    recovery_in_progress: Boolean
    -- True iff structured codex QuotaDetails (plan, reset time, window
    -- snapshots, credits) is attached to this error.
    has_quota: Boolean

    -- Generic automatic runtime retry decision. A malformed response is a
    -- server/transport fault, so it joins the transient-failure kinds.
    auto_retryable: kind = network or kind = timed_out or kind = rate_limit or kind = server_error or kind = invalid_response

    -- Dedicated same-model capacity retry decision. This is separate from the
    -- generic policy because its attempt budget, backoff, persistence, and
    -- absolute window differ.
    overload_retryable: kind = server_overloaded

    -- User-triggered resume from a persisted conversation error. Auth is not
    -- auto-retryable, but is resumable after credentials are fixed.
    -- usage_limit_reached is never auto-retried, but its quota window resets
    -- on a clock boundary, so the user can resume once the window clears.
    user_resumable: kind = auth or kind = network or kind = timed_out or kind = rate_limit or kind = server_error or kind = invalid_response or kind = server_overloaded or kind = usage_limit_reached or kind = prompt_rejected or kind = invalid_request
}

------------------------------------------------------------
-- Selected-model overload retry (REQ-LLM-006b)
------------------------------------------------------------

value OverloadRetryState {
    logical_identity: String
    target_kind: ordinary | continuation
    model_id: String
    target_attempt: Integer
    phase: waiting | in_flight
    retry_at: Timestamp?
    started_at: Timestamp
    deadline_at: Timestamp
    continuation_operation_id: String?
}

entity ActiveOverloadRetry {
    conversation_id: String
    retry: OverloadRetryState
}

rule FirstServerOverloadSchedulesSameModelRetry {
    when: ServerOverloadObserved(conversation_id, logical_identity, model_id, failed_attempt, observed_at, retry_after?)
    requires: failed_attempt < 5
    requires: retry_after = null or retry_after <= 30.seconds
    let target_attempt = failed_attempt + 1
    let wait = overload_wait(logical_identity, target_attempt, retry_after)
    requires: observed_at + wait < observed_at + 120.seconds
    ensures: ActiveOverloadRetry{conversation_id: conversation_id}.retry = OverloadRetryState{
        logical_identity: logical_identity,
        target_kind: ordinary,
        model_id: model_id,
        target_attempt: target_attempt,
        phase: waiting,
        retry_at: observed_at + wait,
        started_at: observed_at,
        deadline_at: observed_at + 120.seconds,
        continuation_operation_id: null
    }
    ensures: SameModelRetryScheduled(conversation_id, model_id, target_attempt, wait)
}

rule ContinuationServerOverloadSchedulesSameOperationRetry {
    when: ContinuationServerOverloadObserved(conversation_id, operation_id, model_id, failed_attempt, observed_at, retry_after?)
    requires: failed_attempt < 5
    requires: retry_after = null or retry_after <= 30.seconds
    let target_attempt = failed_attempt + 1
    let wait = overload_wait(operation_id, target_attempt, retry_after)
    requires: observed_at + wait < observed_at + 120.seconds
    ensures: ActiveOverloadRetry{conversation_id: conversation_id}.retry = OverloadRetryState{
        logical_identity: operation_id,
        target_kind: continuation,
        model_id: model_id,
        target_attempt: target_attempt,
        phase: waiting,
        retry_at: observed_at + wait,
        started_at: observed_at,
        deadline_at: observed_at + 120.seconds,
        continuation_operation_id: operation_id
    }
    ensures: SameContinuationRetryScheduled(conversation_id, operation_id, model_id, target_attempt, wait)
}

rule RepeatedServerOverloadPreservesWindow {
    when: ServerOverloadRetryFailed(retry, observed_at, retry_after?)
    requires: retry.retry.phase = in_flight
    requires: retry.retry.target_attempt < 5
    requires: retry_after = null or retry_after <= 30.seconds
    let target_attempt = retry.retry.target_attempt + 1
    let wait = overload_wait(retry.retry.logical_identity, target_attempt, retry_after)
    requires: observed_at + wait < retry.retry.deadline_at
    ensures: retry.retry.target_attempt = target_attempt
    ensures: retry.retry.phase = waiting
    ensures: retry.retry.retry_at = observed_at + wait
    ensures: retry.retry.started_at = previous(retry.retry.started_at)
    ensures: retry.retry.deadline_at = previous(retry.retry.deadline_at)
    ensures: retry.retry.model_id = previous(retry.retry.model_id)
}

rule OrdinaryOverloadRetryStopsInError {
    when: OverloadRetryCannotContinue(retry, reason)
    requires: retry.retry.target_kind = ordinary
    requires: reason in { attempts_exhausted, retry_after_over_30_seconds, deadline_exhausted }
    ensures: not exists ActiveOverloadRetry{conversation_id: retry.conversation_id}
    ensures: OrdinaryConversationError(retry.conversation_id, server_overloaded, reason)
    ensures: VisibleOverloadFailure(retry.conversation_id, ordinary, reason)
}

rule ContinuationOverloadRetryStopsRecoverably {
    when: OverloadRetryCannotContinue(retry, reason)
    requires: retry.retry.target_kind = continuation
    requires: reason in { attempts_exhausted, retry_after_over_30_seconds, deadline_exhausted }
    ensures: not exists ActiveOverloadRetry{conversation_id: retry.conversation_id}
    ensures: RecoverableContinuationFailure(
        retry.conversation_id,
        retry.retry.continuation_operation_id,
        server_overloaded,
        reason)
    ensures: VisibleOverloadFailure(retry.conversation_id, continuation, reason)
}

rule OverloadRetryRestoredBeforeDeadline {
    when: RuntimeStartsWithOverloadRetry(retry, now)
    requires: now < retry.retry.deadline_at
    ensures: ExactlyOneOverloadStartupAction(retry.conversation_id, retry.retry.phase, retry.retry.retry_at)
    ensures: OverloadDeadlinePreserved(retry.conversation_id, retry.retry.deadline_at)
}

rule OverloadRetryExpiresOnRestart {
    when: RuntimeStartsWithOverloadRetry(retry, now)
    requires: now >= retry.retry.deadline_at
    ensures: not ProviderRequestDispatched(retry.conversation_id)
    ensures: OverloadRetryCannotContinue(retry, deadline_exhausted)
}

rule OverloadAuthorityRetired {
    when: OverloadRetryRetirementRequested(retry, cause)
    requires: cause in { user_cancelled, close_settlement }
    ensures: not exists ActiveOverloadRetry{conversation_id: retry.conversation_id}
    ensures: OverloadTimerAuthorityRetired(retry.conversation_id)
    ensures: OverloadProviderAdmissionRetired(retry.conversation_id)
}

-- Helpers:
--   overload_wait(logical_identity: String, target_attempt: Integer,
--                 retry_after: Duration?) -> Duration
--       Uses nominal waits 4/8/16/32 seconds for target attempts 2/3/4/5,
--       applies deterministic inclusive +/-25% jitter from logical_identity and
--       target_attempt, then takes a valid retry_after not exceeding 30 seconds
--       as a floor.
--   ExactlyOneOverloadStartupAction(conversation_id, phase, retry_at)
--       Waiting before retry_at rearms one timer; waiting at or after retry_at
--       dispatches once; in_flight redispatches once. No branch opens a second
--       overload loop.

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract ToolHistoryIntegrity {
    project_history: (messages: List<LlmMessage>, availability: ToolAvailability) -> List<LlmMessage>
    admit_tool: (availability: ToolAvailability, tool_name: String) -> ToolAdmission

    @invariant AvailabilityDoesNotEraseEvidence
        -- A declaration or callability change does not delete, flatten, or
        -- rewrite historical tool calls, arguments, results, error status,
        -- attachments, tool-search references, or provider replay owners.
        -- Explicit context-management transformations and logged cross-provider
        -- capability gaps have their own contracts; tool unavailability is not
        -- a context-management or unsupported-content transformation.

    @invariant ExecutionRequiresCurrentAuthority
        -- Every new invocation requires its originating request's callable
        -- snapshot as well as live execution authority. The dispatched tool's
        -- input schema must equal its authentic originating declaration.
        -- The request snapshot survives restart; absence grants no admission.
        -- Live catalog changes can revoke admission, never expand it or run
        -- arguments against a different schema. Each invocation is checked
        -- against current callable_names,
        -- including calls issued before a policy change and calls admitted
        -- through advisory-only provider restrictions. Retained declarations
        -- grant no execution authority. An unavailable invocation receives one
        -- explicit error result paired with its original call ID, without
        -- executing it or removing the assistant turn.
        -- Tool implementations and MCP servers own argument-value validation;
        -- this admission contract binds a call to its declared tool schema.

    @invariant PrivateReplaySurvivesProjection
        -- Provider-private continuation data belongs to its originating
        -- provider and exact assistant owner, outside public transcript data.
        -- Preserve required opaque items and positions through retry/restart;
        -- clear them only at an authoritative settlement/abandonment boundary.
        -- Never repair a mismatch by replacing the saved owner snapshot with
        -- transformed content or by silently omitting required private data.
        -- Provider contracts distinguish signed Anthropic blocks from opaque
        -- Responses reasoning items; neither is generic visible text.

    @invariant ProviderCapabilitiesAreExplicit
        -- Native restrictions are selected by the exact route/model capability,
        -- not inferred from an OpenAI-compatible URL or provider family name.
        -- Without verified native support, retain required definitions/history,
        -- communicate current restrictions, and enforce them in the executor.
        -- Never silently serialize an unsupported native control.
}

-- REQ-LLM-004i: policy, history integrity, and provider-context boundaries.
contract ProviderRequestProjection {
    render_request: (request: LlmRequest, context: ConversationProviderContext) -> Any

    @invariant PolicyBelongsToConversation
        -- Render every request for its selected route from the conversation's
        -- current tool policy. A provider switch preserves retained declarations,
        -- current callable names, and public call/result history. Request policy
        -- is a snapshot of that authority, not a second mutable authority.

    @invariant WireControlsBelongToTarget
        -- Only the selected adapter emits native controls supported by its exact
        -- route/model. Anthropic tool-change events never enter Responses or
        -- Chat requests; OpenAI allowed_tools never enters Anthropic requests.
        -- Provider-specific events live outside portable public messages.
        -- Omitting a foreign wire control does not remove its conversation policy.

    @invariant ContinuationBelongsToContext
        -- Resolve the selected service once before request preparation. Derive
        -- continuation identity and project private replay for that service,
        -- then dispatch through the same immutable service binding. A registry
        -- reload cannot retarget prepared data to a different account or route.
        -- Private replay, native tool-change events, and server/transport
        -- continuation handles are bound to their originating route and
        -- continuation identity. Retry/restart of the same context retains
        -- required data and positions under the same account. Switching Codex
        -- accounts changes the route identity and retires the old context before
        -- provider I/O. A settled provider switch atomically
        -- retires that context with the settings/handoff transition and starts
        -- a fresh identity; it leaves no suspended provider context to resume.
        -- Returning to a route establishes current policy afresh, without
        -- reviving retired private data, native events, or transport handles.
        -- Stale outcomes from the retired identity cannot restore them.
        -- A request history projection that omits native tool-change anchors or
        -- makes their insertion position illegal through adjacent user turns
        -- retires the whole native prefix/event context and
        -- establishes current policy at a legal visible anchor. It does not
        -- relocate or selectively filter old events, rewrite private owners,
        -- or retire required private replay within an unsettled exchange.
        -- Switching does not execute pending tools again or orphan their results;
        -- settlement follows the authoritative exchange boundary in REQ-LLM-005.
}

------------------------------------------------------------
-- Rules — current execution eligibility
------------------------------------------------------------

rule ProviderSwitchSettled {
    when: SettleProviderSwitch(context, expected_continuation_id, target_route_id, fresh_continuation_id)
    requires: context.continuation_id = expected_continuation_id
    requires: target_route_id != context.route_id
    requires: fresh_continuation_id != expected_continuation_id
    ensures: context.route_id = target_route_id
    ensures: context.continuation_id = fresh_continuation_id
    @guidance
        -- Apply only at an admitted settlement/abandonment boundary. Commit the
        -- route selection and context retirement atomically, preserving the
        -- conversation's tool authority and public history. The fresh identity
        -- is newly allocated, never a previously retired identity.
}

rule CurrentToolAdmitted {
    when: EvaluateToolAdmission(availability, tool_name)
    requires: tool_name in availability.callable_names
    ensures: ToolAdmission.created(tool_name: tool_name, status: admitted)
}

rule UnavailableToolNotAdmitted {
    when: EvaluateToolAdmission(availability, tool_name)
    requires: not (tool_name in availability.callable_names)
    ensures: ToolAdmission.created(tool_name: tool_name, status: unavailable)
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant CallableToolsHaveDeclarations {
    for availability in ToolAvailabilities:
        for name in availability.callable_names:
            availability.declarations.any(tool => tool.name = name)
}

invariant ToolDeclarationNamesUnique {
    for availability in ToolAvailabilities:
        availability.declarations.name.unique.count = availability.declarations.count
        availability.callable_names.unique.count = availability.callable_names.count
}

-- Structured quota detail is attached to an error if and only if the
-- error is a usage-limit exhaustion. The `usage_limit_reached`
-- constructor in error.rs always builds QuotaDetails; no other
-- constructor sets it. A violation would mean either a quota indicator
-- with no backing data, or an exhaustion error the UI cannot render
-- plan-aware recovery for.
invariant QuotaBoundToUsageLimit {
    for e in LlmErrors:
        e.has_quota implies e.kind = usage_limit_reached
        (e.kind = usage_limit_reached) implies e.has_quota
}

-- The auto-retryable set is exactly {network, timed_out, rate_limit,
-- server_error, invalid_response}.
-- Because `auto_retryable` is a derived field this holds by construction; the
-- invariant is the place a future taxonomy change is forced to restate
-- the partition deliberately rather than let a new kind default into
-- either bucket.
invariant AutoRetryablePartition {
    for e in LlmErrors:
        e.auto_retryable = (e.kind = network or e.kind = timed_out or e.kind = rate_limit or e.kind = server_error or e.kind = invalid_response)
}

invariant OverloadRetryablePartition {
    for e in LlmErrors:
        e.overload_retryable = (e.kind = server_overloaded)
        e.overload_retryable implies not e.auto_retryable
}

invariant UserResumablePartition {
    for e in LlmErrors:
        e.user_resumable = (e.kind = auth or e.kind = network or e.kind = timed_out or e.kind = rate_limit or e.kind = server_error or e.kind = invalid_response or e.kind = server_overloaded or e.kind = usage_limit_reached or e.kind = prompt_rejected or e.kind = invalid_request)
}

-- Token accounting is non-negative. Each count is an unsigned quantity
-- from the provider; the normalizers must not produce a negative bucket
-- (the Responses normalizer subtracts cached tokens out of input_tokens
-- and must saturate at zero — see responses.allium).
invariant UsageNonNegative {
    for r in LlmResponses:
        r.usage.input_tokens >= 0
        r.usage.output_tokens >= 0
        r.usage.cache_creation_tokens >= 0
        r.usage.cache_read_tokens >= 0
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface LlmToolPolicyBoundary {
    facing: PhoenixRuntime
    context availability: ToolAvailability
    contracts:
        fulfils ToolHistoryIntegrity
    provides:
        EvaluateToolAdmission(availability, tool_name)
}

surface ConversationProviderBoundary {
    facing: PhoenixRuntime
    context context: ConversationProviderContext
    contracts:
        fulfils ProviderRequestProjection
    provides:
        SettleProviderSwitch(context, expected_continuation_id, target_route_id, fresh_continuation_id)
}
