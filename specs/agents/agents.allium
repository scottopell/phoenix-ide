-- allium: 3
-- Named workers, execution preferences, and the callable catalog.
-- REQ-AG-004 through REQ-AG-012. Spawn admission and lifecycle are in
-- ../subagents/subagents.allium; filesystem-agent requirements are retired.

value ExecutionCandidate {
    model: String
    connection: String
    reasoning_effort: String?
}

value AgentDefinition {
    name: String
    description: String
    instructions: String
    execution: List<ExecutionCandidate>
}

value TierDefinition {
    name: String
    execution: List<ExecutionCandidate>
}

value ResolvedExecution {
    model: String
    connection: String
    reasoning_effort: String?
}

entity ParentConfiguration {
    runtime_id: String
    agents: List<AgentDefinition>
    tiers: List<TierDefinition>
}

entity CallableCatalog {
    runtime_id: String
    request_id: String
    agents: List<AgentDefinition>
    tiers: List<TierDefinition>
    routes: List<ResolvedExecution>
}

-- Helpers:
-- load_user_configuration(): version-1 XDG TOML, read once per parent runtime;
--   missing file means empty agents/tiers. Invalid schema/version is diagnosed.
-- configuration_valid(configuration): format and version validity.
-- available_routes(): configured, enabled backend slots with required credentials
--   and registered models. Provider-family membership alone is insufficient.
-- resolve_catalog(configuration, routes, parent_execution): resolves all named
--   worker and tier defaults against these routes. Unavailable candidates are
--   skipped in order. A reached candidate with known incompatible effort makes
--   that selection invalid, rather than advancing to its next candidate.
--   Candidates with omitted effort use their own model's native default.
--   Workers without candidates inherit parent_execution. Unusable/invalid
--   selections are excluded and carry actionable configuration diagnostics.
-- render_schema(catalog): sorted deterministic names/descriptions, usable routes,
--   route-supported explicit effort choices, and one optional execution selector.
-- resolved_child_persona(child): child-persisted instructions, absent for anonymous.
-- environment_grounding(child), submit_suffix(child), base_preamble(child):
--   non-persona prompt sections governed by ../subagents/subagents.allium.

rule LoadParentConfiguration {
    when: ParentRuntimeCreated(runtime_id)
    let configuration = load_user_configuration()
    requires: configuration_valid(configuration)
    ensures: ParentConfiguration.created(
        runtime_id: runtime_id,
        agents: configuration.agents,
        tiers: configuration.tiers)
}

rule DiagnoseInvalidConfiguration {
    when: ParentRuntimeCreated(runtime_id)
    let configuration = load_user_configuration()
    requires: not configuration_valid(configuration)
    ensures: ConfigurationDiagnostic(runtime_id, configuration)
}

rule ResolveRequestCatalog {
    when: ParentRequestPrepared(runtime_id, request_id, parent_execution)
    let configuration = ParentConfiguration{runtime_id: runtime_id}
    let catalog = resolve_catalog(configuration, available_routes(), parent_execution)
    ensures: CallableCatalog.created(
        runtime_id: runtime_id,
        request_id: request_id,
        agents: catalog.agents,
        tiers: catalog.tiers,
        routes: catalog.routes)
    ensures: ConfigurationDiagnosticsPublished(runtime_id, catalog)
    ensures: SpawnToolSchemaPrepared(request_id, render_schema(catalog))

    @guidance
        -- The executor consumes this request's resolved catalog; it does not
        -- reread config or resolve a bare model identifier through another
        -- connection. Availability refresh occurs at request boundaries, with
        -- no watcher or provider-outage retry framework.
}

rule ComposeSubAgentPersona {
    when: SubAgentSystemPromptRequested(child)
    let persona = resolved_child_persona(child)
    requires: persona != absent
    ensures: SubAgentSystemPrompt(child,
        prompt: persona + environment_grounding(child) + submit_suffix(child))
}

rule ComposeSubAgentDefaultPreamble {
    when: SubAgentSystemPromptRequested(child)
    let persona = resolved_child_persona(child)
    requires: persona = absent
    ensures: SubAgentSystemPrompt(child,
        prompt: base_preamble(child) + environment_grounding(child) + submit_suffix(child))
}

contract CallableSelection {
    @invariant DefaultUsability
        -- Every advertised worker and tier has a resolved usable default in
        -- its request snapshot. Unavailable defaults are not delegated to the
        -- caller to discover by failing a spawn.
    @invariant RouteIdentity
        -- Model, logical connection, and effort travel as one resolved choice.
        -- Connection names identify configured backend slots, not accounts or
        -- endpoints preserved across operator reconfiguration.
    @invariant AuthoritySeparation
        -- Worker definitions have no mode, tools, or authority. Permissions
        -- depend only on the spawn request and parent's authority.
    @invariant SnapshotConsistency
        -- Schema and spawn admission share a request snapshot. An active child
        -- retains its resolved persona and execution through runtime recreation;
        -- it does not consult named-worker or tier preferences again. A missing
        -- route is an error, never silent provider or model substitution.
}
