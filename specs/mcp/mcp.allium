-- allium: 3
-- MCP Client Specification
--
-- Phoenix as an MCP client. Governs the per-server connection lifecycle
-- across two transports (stdio, Streamable HTTP), the HTTP OAuth 2.1
-- authorization sub-lifecycle, tool exposure, reload reconciliation, and
-- per-server enable/disable.
--
-- The JSON-RPC protocol (initialize, tools/list, tools/call, notifications)
-- is identical across transports; this spec models the lifecycle states a
-- server moves through, not the protocol framing. Code: McpClientManager /
-- McpServer / McpTool in crates/phoenix-tools/src/mcp.rs.

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- The deprecated two-endpoint HTTP+SSE transport (2024-11-05) is not
    -- implemented natively; such servers are reached via the mcp-remote
    -- stdio bridge. Held as a config constant so the decision is a checkable
    -- invariant rather than prose (REQ-MCP-019).
    legacy_sse_native: Boolean = false
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum Transport { stdio | http }

-- Connection state, unified across transports. `disabled` is NOT here:
-- enable/disable is orthogonal to connection (a server can be ready and
-- disabled at once), modeled by the `enabled` field.
enum ConnState { connecting | ready | reconnecting | unauthorized | failed }

-- HTTP authorization scheme. `none` for stdio and for HTTP servers that need
-- no credentials; `static` for a config-supplied bearer token / headers;
-- `oauth` once a 401 has shown the server requires OAuth 2.1.
enum AuthScheme { none | static | oauth }

-- Sub-lifecycle within auth_scheme = oauth.
enum OAuthPhase { discovering | registering | awaiting_user | authorized | refreshing }

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- One configured MCP server connection.
entity McpServer {
    name: String
    transport: Transport
    state: ConnState
    auth_scheme: AuthScheme

    -- Whether this server's tools are offered to conversations. Disabling
    -- retains the connection; only exposure is gated (REQ-MCP-016).
    enabled: Boolean

    -- Discovered tool names, present only once the handshake completes.
    tools: List<String>          when state = ready

    -- HTTP session id from the Mcp-Session-Id response header (REQ-MCP-005).
    session_id: String?          when transport = http

    -- OAuth flow position, present only for OAuth servers.
    oauth_phase: OAuthPhase      when auth_scheme = oauth

    -- The authorization URL the user must open, present only while blocked
    -- on authorization (REQ-MCP-013).
    pending_auth_url: String?    when state = unauthorized

    -- Failure cause retained for the status API (REQ-MCP-018).
    last_error: String           when state = failed
}

-- Persisted client identity for an authorization server. Keyed by the
-- authorization server (not the MCP server) so resources sharing one
-- authorization server share a single registration -- registration happens
-- once per authorization server (REQ-MCP-010). A confidential client also
-- persists its secret + token-endpoint auth method, needed to authenticate
-- code exchange and refresh after a restart.
entity OAuthRegistration {
    auth_server: String
    client_id: String
    client_secret: String?
    token_endpoint_auth_method: String
}

-- Persisted OAuth tokens (plaintext in SQLite, consistent with existing
-- operator-state storage). Looked up by server_name but audience-bound to
-- `resource` (the canonical resource URI): a stored, unexpired token is reused
-- on reconnect only while its resource still matches the server's configured
-- URL (REQ-MCP-012).
entity OAuthToken {
    server_name: String
    resource: String
    -- The scope set granted with this token. Persisted so a step-up after a
    -- restart can request the union of prior and challenged scopes (REQ-MCP-012).
    scopes: List<String>
    access_token: String
    refresh_token: String?
    expires_at: Timestamp
}

------------------------------------------------------------
-- Actors
------------------------------------------------------------

-- The Phoenix server process / MCP manager. Drives connection and protocol.
actor Server {}

-- A human operator. Completes browser authorization and toggles servers.
actor Operator {}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The operator's view of one server plus the controls they can drive.
surface McpControl {
    facing: Operator

    context srv: McpServer

    exposes:
        srv.state
        srv.enabled
        srv.transport
        srv.tools when srv.state = ready
        srv.pending_auth_url when srv.state = unauthorized
        srv.last_error when srv.state = failed

    provides:
        DisableServer(srv)
            when srv.enabled
        EnableServer(srv)
            when not srv.enabled
        OperatorCompletedAuthorization(srv, code)
            when srv.state = unauthorized and srv.oauth_phase = awaiting_user
}

------------------------------------------------------------
-- Rules: connection bring-up
------------------------------------------------------------

-- Discovery materializes a server in the connecting state. Static/no-auth
-- servers carry their scheme from config; OAuth is discovered later via 401.
-- Disjoint from ServerDiscoveredWithStoredToken by needs_token_restore.
rule ServerDiscovered {
    when: ConfigServerDiscovered(name, transport, auth_scheme)

    requires: not needs_token_restore(name, transport, auth_scheme)

    ensures: McpServer.created(
        name: name,
        transport: transport,
        state: connecting,
        auth_scheme: auth_scheme,
        enabled: not is_disabled(name)
    )

    @guidance
        -- read_all_configs classifies each mcpServers entry into a transport
        -- (command -> stdio, type:http + url -> http) and an auth_scheme.
        -- auth_scheme = static ONLY when an explicit auth credential (bearer
        -- token or auth header) is configured; generic per-request headers (org
        -- id, beta flag) do NOT imply static and must not preempt OAuth -- they
        -- ride every request under any scheme. OAuth is selected by the
        -- top-level oauth field (Claude Code's shape), not under auth. A config
        -- OAuth entry is NOT pre-authorized: it materializes auth_scheme =
        -- none, so the first 401 drives the OAuth flow. A pre-configured client
        -- (oauth.clientId) is not seeded here: the authorization server is not
        -- named in config, so seeding waits until discovery resolves the issuer
        -- (OAuthClientPreconfigured). start_background_discovery / connect_one
        -- then spawns or connects (REQ-MCP-001).
}

-- Discovery of an HTTP server that has no config credential but DOES have a
-- stored, unexpired OAuth token bound to its current resource (the
-- authorize-once case across a restart/reload): materialize it already
-- OAuth-authorized so HttpConnected attaches the stored bearer to the very
-- first initialize, with no 401 round trip and no re-prompt (REQ-MCP-012).
rule ServerDiscoveredWithStoredToken {
    when: ConfigServerDiscovered(name, transport, auth_scheme)

    requires: needs_token_restore(name, transport, auth_scheme)

    ensures: McpServer.created(
        name: name,
        transport: transport,
        state: connecting,
        auth_scheme: oauth,
        oauth_phase: authorized,
        enabled: not is_disabled(name)
    )

    @guidance
        -- needs_token_restore is true iff transport = http, the config carries
        -- no explicit credential (auth_scheme = none), and a stored OAuthToken
        -- exists whose resource matches the server's configured URI and is
        -- unexpired. ReloadAddsServer applies the same restoration. The bearer
        -- is loaded from the persisted token; refresh/step-up proceed normally.
}


-- A stdio server completes initialize + first tools/list and is ready.
-- Covers both first connect and post-respawn reconnect.
rule StdioConnected {
    when: ServerInitialized(srv)

    requires: srv.transport = stdio
    requires: srv.state in { connecting, reconnecting }

    ensures: srv.state = ready
    ensures: srv.tools = discovered_tools(srv)

    @guidance
        -- McpServer::initialize (protocolVersion handshake +
        -- notifications/initialized) then list_tools (paginated via
        -- nextCursor). REQ-MCP-002, REQ-MCP-003.
}

-- An HTTP server completes initialize + first tools/list and is ready,
-- capturing the session id. Covers first connect, post-reconnect, and the
-- retry after OAuth authorization (state returns to connecting).
rule HttpConnected {
    when: ServerInitialized(srv)

    requires: srv.transport = http
    requires: srv.state in { connecting, reconnecting }

    ensures: srv.state = ready
    ensures: srv.tools = discovered_tools(srv)
    ensures: srv.session_id = session_id_from_init(srv)

    @guidance
        -- POST initialize to the MCP endpoint; the response may be
        -- application/json or text/event-stream (REQ-MCP-004). session_id_from_
        -- init is null for a stateless server that returns no Mcp-Session-Id;
        -- such a server still reaches ready. When present, send the session id
        -- (plus MCP-Protocol-Version) on every subsequent request
        -- (REQ-MCP-005). A static-auth server attaches its config bearer token
        -- and reaches ready directly, never entering the OAuth sub-lifecycle
        -- (REQ-MCP-008); an OAuth server attaches Authorization: Bearer on
        -- every request including this handshake (REQ-MCP-012).
}

-- Connect or handshake failed (non-auth). Entry retained with the cause.
rule ConnectFailed {
    when: ServerConnectFailed(srv, error)

    requires: srv.state in { connecting, reconnecting }

    ensures: srv.state = failed
    ensures: srv.last_error = error

    @guidance
        -- connect_one Err. The server stays in the status response with its
        -- error rather than vanishing; reload retries it (REQ-MCP-018).
}

-- A step in the OAuth flow failed: PRM/AS metadata fetch, client registration,
-- PKCE-support check, or code/token exchange. The server is retained as failed
-- with the cause rather than stranded mid-flow (REQ-MCP-018). Refresh failure
-- is handled separately (TokenRefreshFailed re-prompts rather than failing).
rule OAuthFlowFailed {
    when: OAuthFlowFailed(srv, error)

    requires: srv.oauth_phase in { discovering, registering, awaiting_user }

    ensures: srv.state = failed
    ensures: srv.last_error = error
    ensures: PendingAuthorizationCancelled(srv)

    @guidance
        -- Cancelling the pending flow clears any surfaced authorization URL, so
        -- PendingUrlOnlyWhileUnauthorized holds once the server is `failed` and
        -- status/UI consumers do not see a stale authorize link for a dead flow.
}

------------------------------------------------------------
-- Rules: HTTP recovery
------------------------------------------------------------

-- A transport error (reset, timeout) on a ready HTTP server reconnects
-- rather than failing the server outright (REQ-MCP-007).
rule HttpTransportErrorReconnects {
    when: HttpTransportError(srv)

    requires: srv.transport = http
    requires: srv.state = ready

    ensures: srv.state = reconnecting
}

-- HTTP 404 means the server-side session is gone. Drop it and re-initialize.
rule HttpSessionExpired {
    when: HttpSessionNotFound(srv)

    requires: srv.transport = http
    requires: srv.state = ready

    ensures: srv.state = reconnecting
    ensures: srv.session_id = null

    @guidance
        -- 404 on a session-bearing request -> treat session as expired,
        -- re-run initialize (REQ-MCP-005).
}

-- A stdio server's process exited; respawn and reconnect (REQ-MCP-003).
rule StdioCrashed {
    when: StdioProcessExited(srv)

    requires: srv.transport = stdio
    requires: srv.state = ready

    ensures: srv.state = reconnecting

    @guidance
        -- is_alive / the transport's TransportError::Disconnected
        -- classification detect the crash; respawn re-initializes before
        -- the failed tools/call is retried once.
}

------------------------------------------------------------
-- Rules: HTTP OAuth authorization
------------------------------------------------------------

-- First 401 on a server without static creds: it needs OAuth. Enter the
-- discovery phase. Disjoint from the refresh and static-reject rules below
-- by auth_scheme.
rule OAuthRequired {
    when: HttpRequestUnauthorized(srv)

    requires: srv.transport = http
    requires: srv.auth_scheme = none

    ensures: srv.auth_scheme = oauth
    ensures: srv.state = unauthorized
    ensures: srv.oauth_phase = discovering

    @guidance
        -- 401 + WWW-Authenticate -> Protected Resource Metadata (RFC 9728)
        -- -> Authorization Server Metadata (RFC 8414). REQ-MCP-009.
        -- An authorization server reached via the resource's advertised
        -- authorization_servers list is trusted to declare its own issuer:
        -- accept metadata whose issuer differs from the fetch URL (rejecting
        -- only metadata with no issuer), and key the registration by the
        -- declared issuer. A directly-named issuer keeps exact equality.
}

-- A 401 on a server using static config credentials is a hard failure --
-- there is no interactive flow to recover into.
rule StaticAuthRejected {
    when: HttpRequestUnauthorized(srv)

    requires: srv.auth_scheme = static

    ensures: srv.state = failed
    ensures: srv.last_error = static_auth_error(srv)
}

-- Metadata resolved: move to client registration.
rule OAuthMetadataResolved {
    when: OAuthMetadataReady(srv)

    requires: srv.oauth_phase = discovering

    ensures: srv.oauth_phase = registering
}

-- A client identity already exists for this server's authorization server
-- (cached from a prior registration, possibly shared with another resource):
-- reuse it and prompt the user.
rule OAuthClientReused {
    when: OAuthClientResolved(srv)

    requires: srv.oauth_phase = registering
    requires: has_registration(srv)

    ensures: srv.oauth_phase = awaiting_user
    ensures: srv.pending_auth_url = authorization_url(srv)
}

-- No cached registration, but the config carries a pre-configured public
-- client (oauth.clientId): now that discovery has resolved the issuer the
-- config did not name, seed the OAuthRegistration under it with the client_id
-- from config, no secret, and no token-endpoint client authentication (the
-- authorization-code + PKCE flow needs none). Prefer this over DCR
-- (REQ-MCP-010).
rule OAuthClientPreconfigured {
    when: OAuthClientResolved(srv)

    requires: srv.oauth_phase = registering
    requires: not has_registration(srv)
    requires: has_preconfigured_client(srv)

    ensures: OAuthRegistration.created(
        auth_server: auth_server_of(srv),
        client_id: preconfigured_client_id(srv),
        client_secret: null,
        token_endpoint_auth_method: "none"
    )
    ensures: srv.oauth_phase = awaiting_user
    ensures: srv.pending_auth_url = authorization_url(srv)

    @guidance
        -- When the pre-configured client pins a loopback callback port (its
        -- app allows only http://localhost:<port>/callback and cannot register
        -- Phoenix's own route), the authorization_url's redirect_uri is that
        -- loopback URI, and a listener on that port (bound before the URL is
        -- surfaced, on both IP families, accepting until the flow resolves)
        -- bounces the browser's callback to the real /api/mcp/oauth/callback
        -- route (REQ-MCP-020). Otherwise the redirect is Phoenix's server route.
        -- A cached registration is reused only when its client_id still matches
        -- the configured one; a re-keyed clientId replaces the stale row.
}

-- No cached registration and no pre-configured client: acquire one via RFC
-- 7591 dynamic client registration, persist it keyed by the authorization
-- server, prompt the user.
rule OAuthClientRegistered {
    when: OAuthClientResolved(srv)

    requires: srv.oauth_phase = registering
    requires: not has_registration(srv)
    requires: not has_preconfigured_client(srv)

    ensures: OAuthRegistration.created(
        auth_server: auth_server_of(srv),
        client_id: registered_client_id(srv),
        client_secret: registered_client_secret(srv),
        token_endpoint_auth_method: registered_auth_method(srv)
    )
    ensures: srv.oauth_phase = awaiting_user
    ensures: srv.pending_auth_url = authorization_url(srv)

    @guidance
        -- Client identity preference: cached registration (keyed by
        -- authorization server) -> pre-configured client (OAuthClientPreconfigured)
        -- -> Client ID Metadata Document -> RFC 7591 dynamic client registration
        -- as the fallback. Reused across MCP servers sharing the authorization
        -- server (REQ-MCP-010). The authorization URL carries the PKCE challenge
        -- (the client first verifies code_challenge_methods_supported) and the
        -- RFC 8707 resource indicator; the verifier is held for the token
        -- exchange (REQ-MCP-011).
}

-- The operator completed the browser authorization; exchange the code for
-- tokens, persist them, and retry the connection.
rule OAuthAuthorized {
    when: OperatorCompletedAuthorization(srv, code)

    requires: srv.oauth_phase = awaiting_user
    requires: callback_state_matches(srv, code)
    requires: redirect_issuer_valid(srv, code)

    ensures: OAuthToken.created(
        server_name: srv.name,
        resource: server_resource(srv),
        scopes: granted_scopes(srv, code),
        access_token: exchanged_access_token(srv, code),
        refresh_token: exchanged_refresh_token(srv, code),
        expires_at: token_expiry(srv, code)
    )
    ensures: srv.oauth_phase = authorized
    ensures: srv.pending_auth_url = null
    ensures: srv.state = connecting

    @guidance
        -- The local callback first checks the `state` nonce: a redirect whose
        -- state does not match this pending flow is rejected before any
        -- exchange (callback_state_matches), so a code from another tab or
        -- pending server cannot be persisted under the wrong server
        -- (REQ-MCP-011). It also checks the `iss` parameter against the
        -- validated authorization-server metadata (redirect_issuer_valid) to
        -- reject authorization-server mix-up before the code reaches the token
        -- endpoint. Then exchange code + PKCE verifier (plus the RFC 8707
        -- resource indicator) at the token endpoint, persist the token bound to
        -- the resource URI, clear the pending URL, and re-enter connecting so
        -- HttpConnected drives the now-authorized handshake to ready
        -- (REQ-MCP-011, REQ-MCP-012).
}

-- A 401 on a previously authorized server: the access token expired or was
-- revoked. Refresh rather than re-prompt.
rule TokenRefreshNeeded {
    when: HttpRequestUnauthorized(srv)

    requires: srv.auth_scheme = oauth
    requires: srv.oauth_phase = authorized

    ensures: srv.oauth_phase = refreshing
}

-- Refresh succeeded: update the stored token (including a rotated refresh
-- token, if the server issued one), return to authorized.
rule TokenRefreshed {
    when: OAuthTokenRefreshed(srv)

    requires: srv.oauth_phase = refreshing

    ensures: OAuthToken{server_name: srv.name}.access_token = refreshed_access_token(srv)
    ensures: OAuthToken{server_name: srv.name}.refresh_token = refreshed_refresh_token(srv)
    ensures: OAuthToken{server_name: srv.name}.expires_at = refreshed_expiry(srv)
    ensures: srv.oauth_phase = authorized

    @guidance
        -- The request whose 401 triggered the refresh (a tools/call or
        -- initialize) is replayed by the executor with the refreshed bearer
        -- once authorized, so a normal token expiry never surfaces as a tool
        -- failure (see deferred ReAuthCallRetry). The state machine models the
        -- refresh; holding and replaying the specific request is executor-level.
}

-- Refresh failed: discard the stale token so it cannot be reused or
-- duplicated, and make the user authorize again. Re-enter discovery; the
-- cached registration (keyed by authorization server) lets OAuthClientReused
-- skip DCR.
rule TokenRefreshFailed {
    when: OAuthRefreshFailed(srv)

    requires: srv.oauth_phase = refreshing

    ensures: not exists OAuthToken{server_name: srv.name}
    ensures: srv.state = unauthorized
    ensures: srv.oauth_phase = discovering

    @guidance
        -- Delete the persisted token row before re-prompting. Without this the
        -- stale token still satisfies the token invariants and a later
        -- OAuthAuthorized would create a duplicate row for the same server
        -- (REQ-MCP-012).
}

-- A tool call on an authorized server returns 403 insufficient_scope: this is
-- a step-up request, not a terminal error. Discard the narrow token and
-- re-authorize for the expanded scope. The cached registration is reused, so
-- the user re-consents but no new client is registered.
rule InsufficientScopeStepUp {
    when: HttpInsufficientScope(srv)

    requires: srv.auth_scheme = oauth
    requires: srv.oauth_phase = authorized

    ensures: not exists OAuthToken{server_name: srv.name}
    ensures: srv.state = unauthorized
    ensures: srv.oauth_phase = awaiting_user
    ensures: srv.pending_auth_url = authorization_url(srv)

    @guidance
        -- 403 insufficient_scope + WWW-Authenticate carries the required
        -- scope. The authorization URL requests the UNION of the existing
        -- token's persisted `scopes` and the challenged scope (read before the
        -- token is discarded), so a step-up never drops earlier grants on
        -- servers that issue exactly the requested set -- which would break
        -- other tools and bounce through re-auth (REQ-MCP-012). Persisting
        -- `scopes` on the token makes the prior set available even after a
        -- restart. Discarding first keeps exactly one token per server when
        -- OAuthAuthorized re-creates it. The tools/call that triggered the
        -- step-up is held by the executor and replayed once the server returns
        -- to ready (see deferred ReAuthCallRetry), so the user/LLM does not
        -- re-invoke it.
}

------------------------------------------------------------
-- Rules: tools, reload, enable/disable
------------------------------------------------------------

-- Server signaled notifications/tools/list_changed; refresh the tool list.
rule ToolsListChanged {
    when: ServerToolsListChanged(srv)

    requires: srv.state = ready

    ensures: srv.tools = discovered_tools(srv)

    @guidance
        -- Sets tools_changed; tool_definitions refreshes lazily on the next
        -- read. For HTTP the notification arrives on the GET SSE stream
        -- (REQ-MCP-006); for stdio, inline on stdout. REQ-MCP-014.
}

-- Reload found a new server in config with no usable stored token: bring it
-- up from config. Honors the persisted disabled set. Disjoint from
-- ReloadAddsServerWithStoredToken by needs_token_restore.
rule ReloadAddsServer {
    when: ReloadAddedServer(name, transport, auth_scheme)

    requires: not needs_token_restore(name, transport, auth_scheme)

    ensures: McpServer.created(
        name: name,
        transport: transport,
        state: connecting,
        auth_scheme: auth_scheme,
        enabled: not is_disabled(name)
    )
}

-- Reload added an HTTP server that already has a stored, unexpired,
-- resource-matched token: restore it OAuth-authorized, mirroring
-- ServerDiscoveredWithStoredToken, so the first initialize is authenticated
-- and the user is not re-prompted (REQ-MCP-012).
rule ReloadAddsServerWithStoredToken {
    when: ReloadAddedServer(name, transport, auth_scheme)

    requires: needs_token_restore(name, transport, auth_scheme)

    ensures: McpServer.created(
        name: name,
        transport: transport,
        state: connecting,
        auth_scheme: oauth,
        oauth_phase: authorized,
        enabled: not is_disabled(name)
    )
}

-- Reload found a server's config changed: restart it (REQ-MCP-015), applying
-- the reloaded auth scheme. For HTTP, drop the stale session id so the fresh
-- initialize does not echo an old Mcp-Session-Id to the new/restarted endpoint.
rule ReloadRestartsServer {
    when: ReloadServerConfigChanged(srv, new_auth_scheme)

    ensures: srv.state = reconnecting
    ensures: srv.auth_scheme = new_auth_scheme

    @guidance
        -- reload_from_configs compares McpServerConfig with PartialEq across
        -- the Stdio/Http variants; a changed command/args/env or url/headers/
        -- auth triggers terminate + reconnect. new_auth_scheme is the reloaded
        -- config's scheme (none for a config OAuth server, which re-derives via
        -- 401, or static when reconfigured to a config credential), so a server
        -- moved OAuth->static attaches its new static credential on reconnect
        -- rather than re-entering OAuth.
}

-- Clear the HTTP session id on restart so the next initialize starts a fresh
-- session rather than reusing a stale one (mirrors HttpSessionExpired).
rule ReloadClearsHttpSession {
    when: ReloadServerConfigChanged(srv, new_auth_scheme)

    requires: srv.transport = http

    ensures: srv.session_id = null
}

-- Reload invalidated an OAuth server's credential: either it was repointed
-- (resource/authorization-server changed) or its config moved away from OAuth
-- (to static/none) without changing the URL. Either way the stored token must
-- not survive -- discard it and cancel any pending flow so
-- TokenImpliesOAuthServer is not violated (REQ-MCP-011, REQ-MCP-012). The new
-- auth_scheme is applied by ReloadRestartsServer; this rule does not set it.
-- Fires alongside ReloadRestartsServer.
rule ReloadInvalidatesOAuth {
    when: ReloadServerConfigChanged(srv, new_auth_scheme)

    requires: srv.transport = http
    requires: srv.auth_scheme = oauth
    requires: oauth_invalidated_by_reload(srv)

    ensures: not exists OAuthToken{server_name: srv.name}
    ensures: PendingAuthorizationCancelled(srv)

    @guidance
        -- oauth_invalidated_by_reload = resource_changed OR the new config no
        -- longer selects OAuth. ReloadRestartsServer sets auth_scheme to
        -- new_auth_scheme (none for a repointed OAuth server -> the next 401
        -- re-enters OAuthRequired; static when reconfigured to a credential).
        -- Deleting the token before that scheme change keeps AuthorizedImplies
        -- Token satisfied. Cancelling the pending flow rotates the per-flow
        -- `state` nonce and drops the pending URL, so a callback from the
        -- pre-repoint flow no longer satisfies callback_state_matches.
}

-- Reload reconfigured a server that is mid-authorization (awaiting_user) with
-- no token persisted yet: the pending flow targets the old config and must be
-- cancelled even though there is no token to discard, or a delayed callback
-- from the old resource could satisfy the still-current flow (REQ-MCP-011).
-- The new auth_scheme is applied by ReloadRestartsServer.
rule ReloadCancelsPendingAuth {
    when: ReloadServerConfigChanged(srv, new_auth_scheme)

    requires: srv.transport = http
    requires: srv.auth_scheme = oauth
    requires: srv.oauth_phase = awaiting_user

    ensures: PendingAuthorizationCancelled(srv)
}

-- Reload visited a server whose config is unchanged but which is in the failed
-- state: retry it (clearing the retained error on the subsequent successful
-- connect). A healthy unchanged server is left untouched -- no rule fires
-- (REQ-MCP-018).
rule ReloadRetriesFailedServer {
    when: ReloadServerUnchanged(srv)

    requires: srv.state = failed

    ensures: srv.state = connecting
}

-- Reload found a server gone from config: disconnect and forget it, including
-- its stored token (otherwise it would orphan a token with no owning server,
-- violating TokenImpliesOAuthServer). The shared OAuthRegistration is NOT
-- deleted -- it is keyed by authorization server and may back other servers.
rule ReloadRemovesServer {
    when: ReloadRemovedServer(srv)

    ensures: not exists OAuthToken{server_name: srv.name}
    ensures: not exists srv

    @guidance
        -- terminate() the connection and discard the persisted token. Leave the
        -- per-authorization-server registration in place for servers that still
        -- share it. HTTP session teardown is the sibling rule below.
}

-- Removing a session-bearing HTTP server ends its remote session with a DELETE
-- before the server is forgotten, so the common config-remove path does not
-- leak the session until expiry (REQ-MCP-005). Mirrors the shutdown teardown;
-- fires alongside ReloadRemovesServer.
rule ReloadDeletesRemovedHttpSession {
    when: ReloadRemovedServer(srv)

    requires: srv.transport = http
    requires: srv.session_id != null

    ensures: SessionDeleted(srv)
}

-- Operator disables a server: stop offering its tools, keep the connection,
-- and persist the disabled state so it survives a restart.
rule ServerDisabled {
    when: DisableServer(srv)

    requires: srv.enabled

    ensures: srv.enabled = false
    ensures: DisabledSetAdds(srv.name)

    @guidance
        -- disable_server adds the name to the disabled set, persisted in the
        -- mcp_disabled_servers table. The connection is retained (REQ-MCP-016).
}

-- Operator re-enables a server: resume offering its tools, and remove it from
-- the persisted disabled set so discovery/reload-add do not re-disable it
-- after a restart (the persisted counterpart of ServerDisabled).
rule ServerEnabled {
    when: EnableServer(srv)

    requires: not srv.enabled

    ensures: srv.enabled = true
    ensures: DisabledSetRemoves(srv.name)

    @guidance
        -- enable_server deletes the name from mcp_disabled_servers, so a later
        -- is_disabled(name) at discovery returns false (REQ-MCP-016).
}

-- Phoenix is shutting down a session-bearing HTTP server: end the remote
-- session with an HTTP DELETE so the server does not leak it until expiry
-- (REQ-MCP-005).
rule HttpSessionDeletedOnShutdown {
    when: ServerShuttingDown(srv)

    requires: srv.transport = http
    requires: srv.session_id != null

    ensures: SessionDeleted(srv)
    ensures: srv.session_id = null

    @guidance
        -- shutdown() issues DELETE with the Mcp-Session-Id for each connected
        -- HTTP server, mirroring the reload-remove path's session teardown.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- The deprecated transport is never implemented natively (REQ-MCP-019).
invariant LegacySseNotNative {
    not config.legacy_sse_native
}

-- Only HTTP servers carry auth schemes; stdio is always unauthenticated.
invariant StdioHasNoAuth {
    for s in McpServers:
        s.transport = stdio implies s.auth_scheme = none
}

-- A session id only exists for HTTP servers.
invariant SessionImpliesHttp {
    for s in McpServers:
        s.session_id != null implies s.transport = http
}

-- A pending authorization URL only exists while blocked on authorization.
invariant PendingUrlOnlyWhileUnauthorized {
    for s in McpServers:
        s.pending_auth_url != null implies s.state = unauthorized
}

-- An OAuth server that has authorized (or is refreshing) has a persisted
-- token; a stored token belongs to an OAuth server (REQ-MCP-012).
invariant AuthorizedImpliesToken {
    for s in McpServers:
        s.oauth_phase in { authorized, refreshing }
            implies exists t in OAuthTokens where t.server_name = s.name
}

invariant TokenImpliesOAuthServer {
    for t in OAuthTokens:
        exists s in McpServers where s.name = t.server_name and s.auth_scheme = oauth
}

-- Exactly one token per server: refresh-failure and step-up discard the old
-- token before OAuthAuthorized re-creates it, so a stale credential can never
-- coexist with or be duplicated by a fresh one (REQ-MCP-012).
invariant OneTokenPerServer {
    for a in OAuthTokens:
        for b in OAuthTokens:
            a.server_name = b.server_name implies a = b
}

------------------------------------------------------------
-- Helpers
------------------------------------------------------------

-- discovered_tools(srv): List<String>
--   The tool names from the server's tools/list response (paginated).
--
-- is_disabled(name): Bool
--   True iff `name` is in the persisted disabled set (the mcp_disabled_servers
--   table). Read at discovery/reload-add so a server disabled before a restart
--   stays disabled (REQ-MCP-016).
--
-- has_preconfigured_client(srv): Bool
--   True iff srv's config is OAuth carrying a pre-configured public client
--   (HttpAuth::OAuth(Some(PreconfiguredClient)) -- the oauth.clientId shape).
--
-- preconfigured_client_id(srv): String
--   The clientId from srv's config. Seeded into the OAuthRegistration (with no
--   secret) so a DCR-less authorization server is reused, not re-registered
--   (REQ-MCP-010).
--
-- granted_scopes(srv, code): List<String>
--   The scope set the authorization server granted in the token response for
--   `code` (the `scope` parameter, defaulting to the requested scopes). Stored
--   as OAuthToken.scopes.
--
-- session_id_from_init(srv): String?
--   The Mcp-Session-Id header value on the initialize response, or null for a
--   stateless server that returns no session header.
--
-- server_resource(srv): String
--   The canonical resource URI of srv -- the audience an issued token is bound
--   to, and the OAuthToken.resource value.
--
-- resource_changed(srv): Bool
--   True iff srv's configured URL / authorization server (its canonical
--   resource URI) differs from the one a persisted token is bound to.
--
-- oauth_invalidated_by_reload(srv): Bool
--   True iff a reload makes srv's stored OAuth token unusable: resource_changed
--   (repoint) OR the new config no longer selects OAuth (auth mode left OAuth).
--
-- callback_state_matches(srv, code): Bool
--   True iff the OAuth redirect that carried `code` presented the `state`
--   nonce issued for srv's still-current pending flow. A flow cancelled by
--   ReloadInvalidatesOAuth / ReloadCancelsPendingAuth rotates the nonce, so a
--   stale callback fails.
--
-- redirect_issuer_valid(srv, code): Bool
--   True iff the redirect's `iss` (when the authorization server returns one or
--   advertises authorization_response_iss_parameter_supported) matches the
--   issuer of srv's validated authorization-server metadata. Defends against
--   authorization-server mix-up.
--
-- needs_token_restore(name, transport, auth_scheme): Bool
--   True iff transport = http, the config carries no explicit credential
--   (auth_scheme = none), and a stored OAuthToken exists for `name` whose
--   resource matches the configured URI and is still usable -- either its
--   access token is unexpired OR it carries a refresh token. The restore
--   materializes the server already OAuth-authorized; an expired-but-
--   refreshable token rides the normal expiry path (a 401 on first use drives
--   TokenRefreshNeeded -> silent refresh), so offline access-token expiry never
--   forces a browser re-prompt (REQ-MCP-012). Only a fully dead token (expired,
--   no refresh token) makes this false and falls through to discovery.
--
-- auth_server_of(srv): String
--   The identifier (issuer) of the authorization server protecting srv,
--   resolved during OAuth discovery. The key under which a client
--   registration is stored and reused.
--
-- has_registration(srv): Bool
--   True iff a persisted OAuthRegistration exists for auth_server_of(srv) --
--   i.e. a client identity is already available for srv's authorization
--   server (pre-configured or previously registered).
--
-- registered_client_id(srv): String
-- registered_client_secret(srv): String?
-- registered_auth_method(srv): String
--   The client identity obtained for srv's authorization server: pre-configured,
--   a Client ID Metadata Document value, or the RFC 7591 registration result.
--   The secret is null for a public client; the auth method records how the
--   client authenticates at the token endpoint (e.g. none, client_secret_post).
--
-- authorization_url(srv): String
--   The OAuth 2.1 authorization-code URL the operator opens in a browser,
--   carrying the PKCE challenge (built only after confirming the authorization
--   server advertises code_challenge_methods_supported), the RFC 8707 resource
--   indicator, and the `state` nonce. For a step-up (InsufficientScopeStepUp)
--   it requests the union of previously granted and newly challenged scopes.
--
-- exchanged_access_token(srv, code): String
-- exchanged_refresh_token(srv, code): String?
-- token_expiry(srv, code): Timestamp
--   The token endpoint's response to exchanging the authorization code plus
--   the PKCE verifier.
--
-- refreshed_access_token(srv): String
-- refreshed_refresh_token(srv): String?
-- refreshed_expiry(srv): Timestamp
--   The token endpoint's response to a refresh-token grant. The refresh token
--   is the server's replacement when it rotates, otherwise the existing one.
--
-- static_auth_error(srv): String
--   The error recorded when a static-credential server is rejected with 401.

------------------------------------------------------------
-- Deferred
------------------------------------------------------------

deferred ToolCallCancellationSafety    -- see: crates/phoenix-tools/src/mcp.rs
    -- REQ-MCP-017. Cancellation safety and tool-error surfacing are executor
    -- mechanics, not connection-lifecycle states: McpTool::run spawns the
    -- tools/call as a detached task and selects on the cancellation token, so
    -- a cancel cannot drop an in-flight stdio write mid-frame, and a server
    -- isError result becomes a ToolOutput::Error rather than a Success. This
    -- is emergent from the tool-execution path and the ToolOutput enum, below
    -- the granularity of the ConnState machine modeled here.
    -- Location: crates/phoenix-tools/src/mcp.rs (McpTool::run)

deferred ReAuthCallRetry    -- see: crates/phoenix-tools/src/mcp.rs
    -- REQ-MCP-012. Replaying the request whose 401/403 triggered a re-auth is
    -- an executor continuation, not a connection-lifecycle state, and covers
    -- both re-auth paths symmetrically: a 403 insufficient_scope step-up
    -- (re-authorized with the union scope) and a 401 silent token refresh. In
    -- both, the in-flight request future awaits the server's return to ready
    -- and re-issues the same request, so the LLM never sees the interruption.
    -- The ConnState/OAuthPhase machine models the re-authorization/refresh;
    -- holding and replaying the specific call belongs to the tool-execution
    -- path. Location: crates/phoenix-tools/src/mcp.rs (McpTool::run / call_tool)

