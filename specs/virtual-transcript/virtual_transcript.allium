-- allium: 3
-- Platform-neutral physical transcript positioning

use "../messagelist-render-units/scroll_policy.allium" as scroll

enum CommandKind { restore_after_prefix_expansion jump_to_message }
enum PhaseKind { resolving_target awaiting_physical }
config {
    conformance_tolerance: Decimal = 2.0
}

value HistoryViewIdentity {
    conversation_id: String
    generation: Integer
    transcript_generation: Integer
}

value CommandIdentity {
    key: String
    token: String
    request_token: String
    view: HistoryViewIdentity
    kind: CommandKind
    message_id: String
}

entity TranscriptView {
    current_view: HistoryViewIdentity?
    ordered_keys: List<String>
    measured_keys: Set<String>
    rendered_start: Integer
    rendered_end: Integer
    layout_revision: Integer
    active_command: ActiveCommand?
    phase: PositioningPhase?
    terminal_command_keys: Set<String>
}

entity ActiveCommand {
    identity: CommandIdentity
    viewport_start_offset: Decimal?
}

entity PositioningPhase {
    kind: PhaseKind
    target_index: Integer?
    issued_layout_revision: Integer?
}

entity FixtureCorpus {
    schema_path: String
    scenarios_path: String
    schema_version: String
    scenario_ids: Set<String>
}

surface TranscriptPositioningReducer {
    facing view: TranscriptView

    provides:
        InputIdle(view, history_view)
        InputPositioning(view, command_key, token, request_token, history_view, kind, message_id, viewport_start_offset)
        TargetResolved(view, command_key, target_index)
        TargetMissing(view, command_key)
        PositionIssued(view, command_key, target_index, layout_revision)
        PhysicalObserved(view, command_key, visible_range, actual_offset, layout_revision)
        UserInterrupted(view)
        ExecutorDetached(view)
        UnitMeasured(view, unit_key, extent)

    emits:
        ResolveTarget(command_key, message_id)
        Position(command_key, target_index, align, viewport_start_offset)
        Finish(command_key, result)

    exposes:
        view.current_view
        view.active_command
        view.phase
        view.terminal_command_keys
}

surface VirtualTranscriptFixtures {
    facing corpus: FixtureCorpus

    provides:
        CorpusLoaded(corpus)

    exposes:
        corpus.schema_path
        corpus.scenarios_path
        corpus.schema_version
        corpus.scenario_ids
}

rule IdleInputCreatesClosedIdleStateForView {
    when: InputIdle(view, history_view)
    requires: view.active_command = null
    ensures: view.current_view = history_view
    ensures: view.active_command = null
    ensures: view.phase = null
}

rule PositioningInputStartsOneResolvingCommand {
    when: InputPositioning(view, command_key, token, request_token, history_view, kind, message_id, viewport_start_offset)
    requires: view.active_command = null
    requires: not view.terminal_command_keys.contains(command_key)
    ensures: view.current_view = history_view
    ensures: view.active_command = ActiveCommand(
        identity: CommandIdentity(
            key: command_key,
            token: token,
            request_token: request_token,
            view: history_view,
            kind: kind,
            message_id: message_id
        ),
        viewport_start_offset: viewport_start_offset
    )
    ensures: view.phase = PositioningPhase(
        kind: resolving_target,
        target_index: null,
        issued_layout_revision: null
    )
    ensures: ResolveTarget(command_key, message_id).emitted()
}

rule IdenticalPositioningInputIsIdempotent {
    when: InputPositioning(view, command_key, _, _, history_view, _, _, _)
    requires: view.active_command != null
    requires: view.active_command.identity.key = command_key
    requires: view.active_command.identity.view = history_view
    ensures: view.active_command = view.active_command
    ensures: view.phase = view.phase
}

rule ReplacementInputSupersedesPriorCommandBeforeResolvingNewCommand {
    when: InputPositioning(view, command_key, token, request_token, history_view, kind, message_id, viewport_start_offset)
    requires: view.active_command != null
    requires: view.active_command.identity.key != command_key
        or view.active_command.identity.view != history_view
    requires: not view.terminal_command_keys.contains(view.active_command.identity.key)
    requires: not view.terminal_command_keys.contains(command_key)
    ensures: Finish(view.active_command.identity.key, superseded).emitted()
    ensures: view.terminal_command_keys.add(view.active_command.identity.key)
    ensures: view.current_view = history_view
    ensures: view.active_command = ActiveCommand(
        identity: CommandIdentity(
            key: command_key,
            token: token,
            request_token: request_token,
            view: history_view,
            kind: kind,
            message_id: message_id
        ),
        viewport_start_offset: viewport_start_offset
    )
    ensures: view.phase = PositioningPhase(
        kind: resolving_target,
        target_index: null,
        issued_layout_revision: null
    )
    ensures: ResolveTarget(command_key, message_id).emitted()
}

rule IdleInputSupersedesActiveCommandWithoutResolvingNewCommand {
    when: InputIdle(view, history_view)
    requires: view.active_command != null
    requires: not view.terminal_command_keys.contains(view.active_command.identity.key)
    ensures: Finish(view.active_command.identity.key, superseded).emitted()
    ensures: view.terminal_command_keys.add(view.active_command.identity.key)
    ensures: view.current_view = history_view
    ensures: view.active_command = null
    ensures: view.phase = null
}

rule ViewChangeResetsTerminalIdentityScope {
    when: InputIdle(view, history_view)
        or InputPositioning(view, _, _, _, history_view, _, _, _)
    requires: view.current_view != null
    requires: view.current_view != history_view
    ensures: view.terminal_command_keys = {}
}

rule TerminalInputCannotReactivateCommandWithinSameView {
    when: InputPositioning(view, command_key, _, _, history_view, _, _, _)
    requires: view.active_command = null
    requires: view.current_view = history_view
    requires: view.terminal_command_keys.contains(command_key)
    ensures: view.active_command = null
    ensures: view.phase = null
}

rule TargetResolutionEvidenceIssuesPosition {
    when: TargetResolved(view, command_key, target_index)
    requires: view.active_command != null
    requires: view.phase != null
    requires: view.active_command.identity.key = command_key
    requires: view.phase.kind = resolving_target
    requires: not view.terminal_command_keys.contains(command_key)
    ensures: view.phase = PositioningPhase(
        kind: awaiting_physical,
        target_index: target_index,
        issued_layout_revision: null
    )
    ensures: Position(command_key, target_index, "start", view.active_command.viewport_start_offset).emitted()
}

rule TargetMissingEvidenceFinishesCommand {
    when: TargetMissing(view, command_key)
    requires: view.active_command != null
    requires: view.phase != null
    requires: view.active_command.identity.key = command_key
    requires: view.phase.kind = resolving_target
    requires: not view.terminal_command_keys.contains(command_key)
    ensures: Finish(command_key, target_missing).emitted()
    ensures: view.terminal_command_keys.add(command_key)
    ensures: view.active_command = null
    ensures: view.phase = null
}

rule PositionIssuedRecordsAuthoritativeLayoutRevision {
    when: PositionIssued(view, command_key, target_index, layout_revision)
    requires: view.active_command != null
    requires: view.phase != null
    requires: view.active_command.identity.key = command_key
    requires: view.phase.kind = awaiting_physical
    requires: view.phase.target_index = target_index
    requires: view.phase.issued_layout_revision = null
        or layout_revision >= view.phase.issued_layout_revision
    ensures: view.phase.issued_layout_revision = layout_revision
}

rule OlderPositionIssuedCannotMoveIssuedRevisionBackward {
    when: PositionIssued(view, command_key, target_index, layout_revision)
    requires: view.active_command != null
    requires: view.phase != null
    requires: view.active_command.identity.key = command_key
    requires: view.phase.kind = awaiting_physical
    requires: view.phase.target_index = target_index
    requires: view.phase.issued_layout_revision != null
    requires: layout_revision < view.phase.issued_layout_revision
    ensures: view.phase = view.phase
}

rule PhysicalObservationAppliesJumpWhenIssuedTargetIsVisible {
    when: PhysicalObserved(view, command_key, visible_range, _, layout_revision)
    requires: view.active_command != null
    requires: view.phase != null
    requires: view.active_command.identity.key = command_key
    requires: view.active_command.identity.kind = jump_to_message
    requires: view.phase.kind = awaiting_physical
    requires: view.phase.issued_layout_revision != null
    requires: layout_revision >= view.phase.issued_layout_revision
    requires: visible_range != null
    requires: visible_range.start_index <= view.phase.target_index
    requires: visible_range.end_index >= view.phase.target_index
    requires: not view.terminal_command_keys.contains(command_key)
    ensures: Finish(command_key, applied).emitted()
    ensures: view.terminal_command_keys.add(command_key)
    ensures: view.active_command = null
    ensures: view.phase = null
}

rule PhysicalObservationAppliesRestoreWhenIssuedTargetOffsetMatches {
    when: PhysicalObserved(view, command_key, visible_range, actual_offset, layout_revision)
    requires: view.active_command != null
    requires: view.phase != null
    requires: view.active_command.identity.key = command_key
    requires: view.active_command.identity.kind = restore_after_prefix_expansion
    requires: view.phase.kind = awaiting_physical
    requires: view.phase.issued_layout_revision != null
    requires: layout_revision >= view.phase.issued_layout_revision
    requires: visible_range != null
    requires: visible_range.start_index <= view.phase.target_index
    requires: visible_range.end_index >= view.phase.target_index
    requires: actual_offset != null
    requires: absolute(actual_offset - view.active_command.viewport_start_offset) <= config.conformance_tolerance
    requires: not view.terminal_command_keys.contains(command_key)
    ensures: Finish(command_key, applied).emitted()
    ensures: view.terminal_command_keys.add(command_key)
    ensures: view.active_command = null
    ensures: view.phase = null
}

rule PhysicalObservationBeforeIssuedRevisionCannotFinish {
    when: PhysicalObserved(view, command_key, _, _, layout_revision)
    requires: view.active_command != null
    requires: view.phase != null
    requires: view.active_command.identity.key = command_key
    requires: view.phase.kind = awaiting_physical
    requires: view.phase.issued_layout_revision = null
        or layout_revision < view.phase.issued_layout_revision
    ensures: view.active_command = view.active_command
    ensures: view.phase = view.phase
}

rule PhysicalObservationWithoutVisibleTargetCannotFinish {
    when: PhysicalObserved(view, command_key, visible_range, _, layout_revision)
    requires: view.active_command != null
    requires: view.phase != null
    requires: view.active_command.identity.key = command_key
    requires: view.phase.kind = awaiting_physical
    requires: view.phase.issued_layout_revision != null
    requires: layout_revision >= view.phase.issued_layout_revision
    requires: visible_range = null
        or visible_range.start_index > view.phase.target_index
        or visible_range.end_index < view.phase.target_index
    ensures: view.active_command = view.active_command
    ensures: view.phase = view.phase
}

rule PhysicalRestoreObservationWithoutMatchingOffsetCannotFinish {
    when: PhysicalObserved(view, command_key, visible_range, actual_offset, layout_revision)
    requires: view.active_command != null
    requires: view.phase != null
    requires: view.active_command.identity.key = command_key
    requires: view.active_command.identity.kind = restore_after_prefix_expansion
    requires: view.phase.kind = awaiting_physical
    requires: view.phase.issued_layout_revision != null
    requires: layout_revision >= view.phase.issued_layout_revision
    requires: visible_range != null
    requires: visible_range.start_index <= view.phase.target_index
    requires: visible_range.end_index >= view.phase.target_index
    requires: actual_offset = null
        or absolute(actual_offset - view.active_command.viewport_start_offset) > config.conformance_tolerance
    ensures: view.active_command = view.active_command
    ensures: view.phase = view.phase
}

rule UserInterruptionSupersedesActiveCommand {
    when: UserInterrupted(view)
    requires: view.active_command != null
    requires: not view.terminal_command_keys.contains(view.active_command.identity.key)
    ensures: Finish(view.active_command.identity.key, superseded).emitted()
    ensures: view.terminal_command_keys.add(view.active_command.identity.key)
    ensures: view.active_command = null
    ensures: view.phase = null
}

rule ExecutorDetachSupersedesActiveCommand {
    when: ExecutorDetached(view)
    requires: view.active_command != null
    requires: not view.terminal_command_keys.contains(view.active_command.identity.key)
    ensures: Finish(view.active_command.identity.key, superseded).emitted()
    ensures: view.terminal_command_keys.add(view.active_command.identity.key)
    ensures: view.active_command = null
    ensures: view.phase = null
}

rule StaleTargetResolutionEventsHaveNoEffect {
    when: TargetResolved(view, command_key, _)
        or TargetMissing(view, command_key)
    requires: view.active_command = null
        or view.active_command.identity.key != command_key
        or view.phase = null
        or view.phase.kind != resolving_target
        or view.terminal_command_keys.contains(command_key)
    ensures: view.active_command = view.active_command
    ensures: view.phase = view.phase
}

rule StalePhysicalEventsHaveNoEffect {
    when: PositionIssued(view, command_key, _, _)
        or PhysicalObserved(view, command_key, _, _, _)
    requires: view.active_command = null
        or view.active_command.identity.key != command_key
        or view.phase = null
        or view.phase.kind != awaiting_physical
        or view.terminal_command_keys.contains(command_key)
    ensures: view.active_command = view.active_command
    ensures: view.phase = view.phase
}

rule MeasurementUpdatesAuthoritativeLayoutOnly {
    when: UnitMeasured(view, unit_key, extent)
    requires: view.ordered_keys.contains(unit_key)
    requires: extent > 0
    ensures: view.measured_keys.contains(unit_key)
    ensures: view.layout_revision = view.layout_revision + 1
    ensures: view.active_command = view.active_command
    ensures: view.phase = view.phase
}

rule FixtureCorpusLoadedFromRootVersionedJson {
    when: CorpusLoaded(corpus)
    ensures: corpus.schema_path = "fixtures/virtual-transcript/v1/schema.json"
    ensures: corpus.scenarios_path = "fixtures/virtual-transcript/v1/scenarios.json"
    ensures: corpus.schema_version = "virtual-transcript.scenarios.v1"
    ensures: corpus.scenario_ids = {
        "prefix-insertion-within-tall-unit",
        "resize-above-anchor",
        "alias-navigation",
        "orphan-target",
        "streaming-growth-reading",
        "streaming-growth-following",
        "supersession"
    }
}

invariant OrderedKeysAreUnique {
    view.ordered_keys.to_set().count() = view.ordered_keys.count()
}

invariant RenderedWindowStartsWithinSequence {
    view.ordered_keys.count() = 0 or view.rendered_start < view.ordered_keys.count()
}

invariant RenderedWindowEndsWithinSequence {
    view.ordered_keys.count() = 0 or view.rendered_end < view.ordered_keys.count()
}

invariant RenderedWindowIsContiguous {
    view.rendered_start <= view.rendered_end
}

invariant AtMostOneActiveCommandPerTranscriptView {
    view.active_command = null or view.phase != null
}

invariant ActiveCommandBelongsToCurrentView {
    view.active_command != null implies view.active_command.identity.view = view.current_view
}

invariant TerminalIdentitySetIsScopedToCurrentView {
    view.current_view = null implies view.terminal_command_keys = {}
}

invariant FinishedCommandsHaveNoActivePhysicalAuthority {
    view.active_command = null implies view.phase = null
}

contract TranscriptPositioningSafety {
    validate: (view: TranscriptView) -> Boolean

    @invariant PureReducerEventsProduceEffectsOnly
        -- Input, target-resolution, issued-position, physical-observation,
        -- interruption, and detach events mutate only reducer state and emit
        -- resolve_target, position, or finish effects; physical DOM/native writes
        -- are performed by the effect executor.

    @invariant FinishIsExactOncePerCommandKeyWithinView
        -- A command key enters terminal_command_keys when and only when a finish
        -- effect is emitted for that key, so duplicate or stale events cannot
        -- produce a second terminal result.

    @invariant PositionSuccessRequiresIssuedRevisionAndPhysicalEvidence
        -- Applied completion requires a matching active command, an issued
        -- layout revision, a physical observation at or after that revision, and
        -- visible target evidence; restore commands additionally require offset
        -- conformance within config.conformance_tolerance.

    @invariant SupersessionCausesAreReducerInputs
        -- Replacement, null idle input, view identity change, user interruption,
        -- and executor detach all terminate the active command as superseded
        -- before stale work can write position or finish successfully.
}
