-- allium: 3
-- Platform-neutral physical transcript positioning

use "../messagelist-render-units/scroll_policy.allium" as scroll

enum ViewportOwner { system reader }
enum TransactionKind { preserve_anchor navigate follow_tail initial_tail }
enum TransactionResult { applied target_missing superseded }
config {
    conformance_tolerance: Decimal = 2.0
}

entity TranscriptView {
    generation: Integer
    owner: ViewportOwner
    ordered_keys: List<String>
    measured_keys: Set<String>
    rendered_start: Integer
    rendered_end: Integer
    active_transaction: PositionTransaction?
}

entity PhysicalAnchor {
    unit_key: String
    viewport_start_offset: Decimal
}

entity PositionTransaction {
    view: TranscriptView
    token: String
    generation: Integer
    kind: TransactionKind
    anchor: PhysicalAnchor?
    target_key: String?
}

surface VirtualTranscript {
    facing view: TranscriptView

    provides:
        ViewReplaced(view, generation, ordered_keys)
        ReaderAnchorCaptured(view, unit_key, viewport_start_offset)
        PositionRequested(view, token, generation, kind, unit_key, viewport_start_offset)
        CommandReplaced(view, token?, generation?, kind?)
        UnitMeasured(view, unit_key, extent)
        GeometryObserved(view, unit_key, viewport_start_offset)
        CommandFinished(view, token, generation, result)
        TransactionSuperseded(view, token)

    exposes:
        view.rendered_start
        view.rendered_end
        view.active_transaction
}

rule ViewReplacementDiscardsPhysicalState {
    when: ViewReplaced(view, generation, ordered_keys)
    requires: generation > view.generation
    ensures: view.generation = generation
    ensures: view.ordered_keys = ordered_keys
    ensures: view.measured_keys = {}
    ensures: view.active_transaction = null
}

rule ReaderCaptureIncludesIdentityAndGeometry {
    when: ReaderAnchorCaptured(view, unit_key, viewport_start_offset)
    requires: view.owner = reader
    requires: view.ordered_keys.contains(unit_key)
    ensures: PhysicalAnchor(unit_key: unit_key, viewport_start_offset: viewport_start_offset).created()
}

rule PositionRequestOwnsOneTransaction {
    when: PositionRequested(view, token, generation, kind, unit_key, viewport_start_offset)
    requires: generation = view.generation
    requires: view.active_transaction = null
    ensures: view.active_transaction = PositionTransaction(
        view: view,
        token: token,
        generation: generation,
        kind: kind,
        anchor: PhysicalAnchor(unit_key: unit_key, viewport_start_offset: viewport_start_offset),
        target_key: unit_key
    )
}

rule CommandReplacementSupersedesPriorTransaction {
    when: CommandReplaced(view, token?, generation?, kind?)
    requires: view.active_transaction != null
    requires: token? = null
        or generation? = null
        or kind? = null
        or token? != view.active_transaction.token
        or generation? != view.active_transaction.generation
        or kind? != view.active_transaction.kind
    ensures: view.active_transaction = null
}

rule NewPositionRequestRequiresPriorReplacement {
    when: PositionRequested(view, token, generation, kind, _, _)
    requires: view.active_transaction != null
    requires: token != view.active_transaction.token
        or generation != view.active_transaction.generation
        or kind != view.active_transaction.kind
    ensures: view.active_transaction = view.active_transaction
}

rule MeasurementUpdatesAuthoritativeLayout {
    when: UnitMeasured(view, unit_key, extent)
    requires: view.ordered_keys.contains(unit_key)
    requires: extent > 0
    ensures: view.measured_keys.contains(unit_key)
}

rule AnchorGeometryAuthorizesAppliedResult {
    when: GeometryObserved(view, unit_key, viewport_start_offset)
    requires: view.active_transaction != null
    requires: view.active_transaction.target_key = unit_key
    requires: absolute(viewport_start_offset - view.active_transaction.anchor.viewport_start_offset)
        <= config.conformance_tolerance
    ensures: view.active_transaction = view.active_transaction
}

rule MatchingCommandFinishTerminatesOwnership {
    when: CommandFinished(view, token, generation, result)
    requires: view.active_transaction != null
    requires: token = view.active_transaction.token
    requires: generation = view.active_transaction.generation
    requires: result in { applied, target_missing, superseded }
    ensures: view.active_transaction = null
}

rule StaleCommandFinishCannotTerminateOwnership {
    when: CommandFinished(view, token, generation, _)
    requires: view.active_transaction = null
        or token != view.active_transaction.token
        or generation != view.active_transaction.generation
    ensures: view.active_transaction = view.active_transaction
}

rule StaleGeometryCannotCompleteTransaction {
    when: GeometryObserved(view, unit_key, _)
    requires: view.active_transaction = null
        or view.active_transaction.target_key != unit_key
        or view.active_transaction.generation != view.generation
    ensures: view.active_transaction = view.active_transaction
}

rule ExplicitSupersessionRequiresTerminalResult {
    when: TransactionSuperseded(view, token)
    requires: view.active_transaction != null
    requires: view.active_transaction.token = token
    ensures: view.active_transaction = view.active_transaction
}

invariant ActiveTransactionHasOneTerminalResult {
    -- A matching CommandFinished event is the only terminal transition that
    -- clears active_transaction, so each owner receives at most one terminal
    -- result.
    true
}

invariant OrderedKeysAreUnique {
    view.ordered_keys.to_set().count() = view.ordered_keys.count()
}

invariant RenderedWindowStartsWithinSequence {
    view.ordered_keys.count() = 0 or view.rendered_start < view.ordered_keys.count()
}

invariant RenderedWindowEndsWithinSequence {
    view.ordered_keys.count() = 0 or view.rendered_end < view.ordered_keys.count()
}

invariant RenderedWindowIsContiguous {
    view.rendered_start <= view.rendered_end
}

invariant ActiveTransactionBelongsToCurrentView {
    view.active_transaction != null implies view.active_transaction.generation = view.generation
}
