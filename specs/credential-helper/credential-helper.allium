-- Credential Helper Specification
--
-- Interactive LLM API key helper support.
-- When LLM_API_KEY_HELPER is configured, this spec governs the lifecycle
-- of the helper subprocess, credential caching, and UI surface.
--
-- Does NOT import bedrock; the credential helper is a global concern
-- orthogonal to any individual conversation. Cross-spec communication
-- uses explicit broadcast events (CredentialBecameAvailable,
-- CredentialHelperTerminatedWithoutCredential) consumed by bedrock's
-- active recovery rules (REQ-BED-030).

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- Shell command that emits the credential on its last stdout line.
    -- When null, this spec's rules do not apply (static/env credential path).
    helper_command: String?
    helper_configured: helper_command != null

    -- How long a cached credential remains valid (default 2 hours).
    ttl: Duration = 7_200_000.ms
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum HelperStatus { idle | running | valid | failed }

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- The credential helper. Exactly one instance exists when helper_configured.
-- Represents the subprocess lifecycle and cached credential state.
entity CredentialHelper {
    status: HelperStatus

    -- present only when running
    lines_emitted: List<String> when status = running

    -- present only when valid
    credential: String          when status = valid
    expires_at: Timestamp       when status = valid

    -- present only when failed
    exit_code: Integer?         when status = failed
    error_output: String        when status = failed
}

------------------------------------------------------------
-- Actors
------------------------------------------------------------

-- The Phoenix server process. Spawns and reaps the helper subprocess.
actor Server {}

-- A browser session that has opened the auth panel. Each AuthPanelClient
-- corresponds to one open SSE connection on POST
-- /api/credential-helper/run; identified by the connection itself rather
-- than by a stable user identity (anonymous browsers can subscribe).
actor AuthPanelClient {}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- Exposes credential status for the models API response and
-- the bedrock state machine's recovery decision.
surface CredentialStatusSurface {
    facing server: Server

    context helper: CredentialHelper

    exposes:
        helper.status
        helper.expires_at when helper.status = valid

    provides:
        LlmRequestNeedsCredential(helper)
            when helper.status != valid
        UserTriggersAuth(helper)
            when config.helper_configured
        LlmReturnedUnauthorized(helper)
            when helper.status = valid
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- LLM request needs a credential. get() returns immediately:
-- Valid -> credential, Running/Idle/Failed/Expired -> None
-- (+ auto-trigger if idle/failed/expired). Never blocks. The state machine
-- handles waiting via AwaitingRecovery.
--
-- Two sibling rules cover the two branches; v3 has no
-- `ensures: X if cond` form, so the conditional is split.

rule CredentialRequestedReturnsValid {
    when: LlmRequestNeedsCredential(helper)
    requires: config.helper_configured
    requires: helper.status = valid
    requires: now() < helper.expires_at

    ensures: CredentialReturned(helper.credential)
}

rule CredentialRequestedReturnsUnavailable {
    when: LlmRequestNeedsCredential(helper)
    requires: config.helper_configured
    requires: not (helper.status = valid and now() < helper.expires_at)

    ensures: CredentialUnavailable(helper, helper.status = running)

    @guidance
        -- recovery_in_progress = true iff status = running.
        -- CredentialSource::get() returns Option<String>.
        -- CredentialSource::is_recovering() returns true when running.
        -- LlmAuth::resolve() sets LlmError.recovery_in_progress from
        -- is_recovering(). The state machine uses recovery_in_progress
        -- to choose AwaitingRecovery vs Error (see bedrock REQ-BED-030).
        -- If status is idle/failed/expired, the AutoTrigger rule fires
        -- alongside this one to spawn the helper in the background.
}

-- Auto-trigger: get() spawns the helper when idle/failed/expired.
-- Fire-and-forget — get() returns None immediately, does not wait.
rule AutoTrigger {
    when: LlmRequestNeedsCredential(helper)
    requires: helper.status = idle
        or helper.status = failed
        or (helper.status = valid and now() >= helper.expires_at)

    ensures: helper.status = running
    ensures: HelperLinesReset(helper)

    @guidance
        -- Spawned inside get(). No timeout, no blocking. The helper runs
        -- in the background; HelperSucceeded/HelperFailed fire when it
        -- completes, which bedrock's RecoverySucceeded/RecoveryFailed
        -- rules consume.
        -- HelperLinesReset event clears lines_emitted to []; modelled as
        -- an event because v3 forbids bracket literals in ensures bodies.
}

-- User (or server on startup check) triggers auth from the UI panel.
-- Spawns the helper subprocess. Transitions idle/failed -> running.
rule HelperStarted {
    when: UserTriggersAuth(helper)
    requires: config.helper_configured
    requires: helper.status = idle
        or helper.status = failed
        or (helper.status = valid and now() >= helper.expires_at)

    ensures: helper.status = running
    ensures: HelperLinesReset(helper)

    @guidance
        -- POST /api/credential-helper/run handler:
        -- 1. Lock HelperState.
        -- 2. If already running: skip spawn, proceed to
        --    HelperOutputBroadcast (see ConcurrentClientJoined rule).
        -- 3. Transition to running { lines_so_far: [], subscribers:
        --    [this_tx] }.
        -- 4. Unlock.
        -- 5. Spawn helper task (see HelperSucceeded / HelperFailed rules).
}

-- A line arrives on the helper's stdout.
-- Appended to replay buffer and broadcast to all subscribers.
-- The last non-empty line will become the credential on exit.
rule OutputLineForwarded {
    when: HelperEmittedStdoutLine(helper, line)
    requires: helper.status = running

    ensures: HelperLineAppended(helper, line)
    ensures: HelperLineBroadcast(helper, line)

    @guidance
        -- Read stdout with tokio::io::BufReader::lines(). Each line:
        -- push to lines_so_far, fan-out via mpsc channels. New
        -- subscribers (joining mid-run) receive replay of lines_so_far
        -- before switching to live broadcast. The credential line (last
        -- non-empty) is identified only at exit; it is broadcast as an
        -- ordinary instruction line and then the HelperSucceeded rule
        -- supersedes it from the server side. The token is never
        -- re-broadcast as a "this is your token" SSE event.
}

-- Helper exits with status 0 AND has at least one non-empty stdout line.
-- Last non-empty stdout line is the credential; cached for TTL.
rule HelperSucceeded {
    when: HelperSubprocessExited(helper, exit_code)
    requires: helper.status = running
    requires: exit_code = 0
    requires: has_non_empty_line(helper.lines_emitted)

    ensures: helper.status = valid
    ensures: helper.credential = last_non_empty_line(helper.lines_emitted)
    ensures: helper.expires_at = now() + config.ttl
    ensures: AuthPanelCompleteBroadcast(helper)
    -- Cross-spec broadcast: bedrock's RecoverySucceeded rule consumes this
    -- to retry LLM requests that were waiting for credentials.
    ensures: CredentialBecameAvailable(helper)

    @guidance
        -- After BufReader EOF: collect last non-empty line as credential.
        -- Transition HelperInner to Valid { credential, expires_at }.
        -- Broadcast { type: "complete" } SSE event (no token in payload).
        -- Emit CredentialBecameAvailable (see bedrock REQ-BED-030).
        -- Clear subscriber list. has_non_empty_line and
        -- last_non_empty_line are black-box helpers over List<String>.
}

-- Helper exits non-zero, or exits 0 with no non-empty stdout.
-- Credential is NOT cached. Error surfaced to UI.
-- Two sibling rules cover the two failure conditions; v3 grammar does
-- not allow disjunctions in `when:` triggers.

rule HelperFailedNonZeroExit {
    when: HelperSubprocessExited(helper, exit_code)
    requires: helper.status = running
    requires: exit_code != 0

    ensures: helper.status = failed
    ensures: helper.exit_code = exit_code
    ensures: AuthPanelErrorBroadcast(helper)
    ensures: CredentialHelperTerminatedWithoutCredential(helper)
}

rule HelperFailedNoOutput {
    when: HelperSubprocessExited(helper, exit_code)
    requires: helper.status = running
    requires: exit_code = 0
    requires: not has_non_empty_line(helper.lines_emitted)

    ensures: helper.status = failed
    ensures: helper.exit_code = 0
    ensures: AuthPanelErrorBroadcast(helper)
    ensures: CredentialHelperTerminatedWithoutCredential(helper)

    @guidance
        -- Capture stderr alongside stdout (separate piped readers or
        -- interleaved). Broadcast { type: "error", exit_code: N,
        -- stderr: "..." } SSE event. Emit
        -- CredentialHelperTerminatedWithoutCredential (see bedrock
        -- REQ-BED-030). Clear subscriber list. Do NOT cache any partial
        -- stdout content.
}

-- TTL elapses on a valid credential.
-- Status transitions to idle (effectively "required") on next read.
rule CredentialExpired {
    when: CredentialStatusChecked(helper)
    requires: helper.status = valid
    requires: now() >= helper.expires_at

    ensures: helper.status = idle

    @guidance
        -- Not a scheduled event -- detected lazily on
        -- CredentialStatusSurface read (status check at runtime) and on
        -- CommandCredential::get(). No background timer needed; check
        -- TTL on every status read.
}

-- LLM provider returns 401 or 403.
-- Cached credential immediately invalidated regardless of TTL.
rule CredentialInvalidatedOn401 {
    when: LlmReturnedUnauthorized(helper)
    requires: helper.status = valid

    ensures: helper.status = idle

    @guidance
        -- HelperState::invalidate() is called by LlmAuth on 401.
        -- Transitions valid -> idle. Next /api/models poll returns
        -- "required". User must re-authenticate.
}

-- Second client connects while helper is already running.
-- Joins the existing run; no new subprocess spawned.
rule ConcurrentClientJoined {
    when: UserTriggersAuth(helper)
    requires: config.helper_configured
    requires: helper.status = running

    ensures: AuthPanelReplayedHistory(helper)
    ensures: AuthPanelSubscribedToLive(helper)

    @guidance
        -- POST /api/credential-helper/run handler finds status = running.
        -- Adds new subscriber channel to the subscriber list. Replays
        -- lines_so_far to the new channel before live events. Returns
        -- the SSE stream for the new subscriber. No new subprocess
        -- spawned -- the existing one's output is fanned out to the
        -- additional subscriber.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- At most one helper subprocess running at any time.
invariant SingleConcurrentHelper {
    count(h in CredentialHelpers where h.status = running) <= 1
}

-- A failed run never leaves a credential cached. Enforced structurally
-- by the `credential: String when status = valid` field annotation:
-- when status = failed, credential is absent.
invariant NoCredentialWhenFailed {
    for h in CredentialHelpers:
        h.status = failed implies h.credential = null
}

-- Implementation constraint: TokenNotInSSEPayload
-- The { type: "complete" } event carries no credential field.
-- OutputLineForwarded broadcasts all lines including the token line, but
-- the token line is indistinguishable from instruction lines at
-- broadcast time -- the server identifies it only after exit. This is
-- acceptable: the token line from most OIDC flows is a raw JWT which
-- the browser cannot use without the server intermediating the request.
-- If stricter isolation is needed, buffer the last line server-side and
-- only broadcast N-1 lines. Track as a future hardening task if
-- required. Not modelled as a structural invariant because the
-- distinction (instruction vs token line) is determined post-hoc.

