-- allium: 3
-- REQ-RET-003: one startup attempt, ordered reconciliation, truthful readiness.

enum AttemptStatus { pending | running | ready | failed }
enum AttemptPhase { discovery | locator_repair | messages | pruning }
enum FailureKind { database | other | interrupted }

entity Reconciliation {
    status: AttemptStatus
    phase: AttemptPhase
    processed_messages: Integer
    remaining_messages: Integer
    repair_required: Boolean
    failure_kind: FailureKind?
    database_code: Integer?
}

config {
    prune_page_limit: Integer = 128
}

rule StartAttempt {
    when: StartRequested(attempt)
    requires: attempt.status = pending
    ensures:
        attempt.status = running
        attempt.phase = discovery
        attempt.processed_messages = 0
}

rule DiscoveryNeedsRepair {
    when: DiscoveryCompleted(attempt, count)
    requires: attempt.status = running
    requires: attempt.phase = discovery
    requires: attempt.repair_required
    ensures:
        attempt.phase = locator_repair
        attempt.remaining_messages = count
}

rule DiscoveryNeedsNoRepair {
    when: DiscoveryCompleted(attempt, count)
    requires: attempt.status = running
    requires: attempt.phase = discovery
    requires: not attempt.repair_required
    ensures:
        attempt.phase = messages
        attempt.remaining_messages = count
}

rule RepairCompletes {
    when: LocatorRepairCommitted(attempt)
    requires: attempt.status = running
    requires: attempt.phase = locator_repair
    ensures: attempt.phase = messages
}

rule MessageCompletes {
    when: MessageReconciled(attempt)
    requires: attempt.status = running
    requires: attempt.phase = messages
    requires: attempt.remaining_messages > 0
    ensures:
        attempt.processed_messages = attempt.processed_messages + 1
        attempt.remaining_messages = attempt.remaining_messages - 1
}

rule BeginPruning {
    when: MessagePassCompleted(attempt)
    requires: attempt.status = running
    requires: attempt.phase = messages
    requires: attempt.remaining_messages = 0
    ensures: attempt.phase = pruning
}

rule PublishReady {
    when: PruningCompleted(attempt)
    requires: attempt.status = running
    requires: attempt.phase = pruning
    ensures: attempt.status = ready
}

rule AttemptFails {
    when: ReconciliationError(attempt, kind, code)
    requires: attempt.status = running
    ensures:
        attempt.status = failed
        attempt.failure_kind = kind
        attempt.database_code = code
}

rule AttemptInterrupted {
    when: WorkerDropped(attempt)
    requires: attempt.status = running
    ensures:
        attempt.status = failed
        attempt.failure_kind = interrupted
        attempt.database_code = null
}

surface StartupWorker {
    contracts:
        fulfils ReconciliationOperations
    context attempt: Reconciliation
    exposes:
        attempt.status
        attempt.phase
        attempt.processed_messages
        attempt.failure_kind
        attempt.database_code
    provides:
        StartRequested(attempt)
        DiscoveryCompleted(attempt, count)
        LocatorRepairCommitted(attempt)
        MessageReconciled(attempt)
        MessagePassCompleted(attempt)
        PruningCompleted(attempt)
        ReconciliationError(attempt, kind, code)
        WorkerDropped(attempt)
}

invariant ReadyRequiresCompletedMessagePass {
    for attempt in Reconciliation where attempt.status = ready:
        attempt.phase = pruning
        and attempt.remaining_messages = 0
}

invariant FailureHasTerminalReason {
    for attempt in Reconciliation where attempt.status = failed:
        attempt.failure_kind != null
}

invariant ProcessedCountsAreNonnegative {
    for attempt in Reconciliation:
        attempt.processed_messages >= 0
        and attempt.remaining_messages >= 0
}

contract ReconciliationOperations {
    observe: (attempt: Reconciliation) -> AttemptStatus

    @invariant OneAttemptPerRetriever
        -- Only pending may start. Ready and failed are terminal for this process's
        -- retriever; neither search requests nor diagnostics initiate another pass.

    @invariant CancellationBeforeFirstPoll
        -- The attempt owns its running lifetime before the worker can first poll.
        -- Cancellation or panic drops that lifetime and records interrupted failure.

    @invariant BoundedPruneTransactions
        -- Discover at most config.prune_page_limit locator rows per read-only keyset
        -- page, with a fixed upper locator boundary. Discovery holds no writer.
        -- Pages with candidates obtain write admission before reading current source
        -- existence. Revalidate each candidate's current locator and source under
        -- that admission; delete physical index and locator rows atomically per page.
        -- A failed page rolls back; already committed pages remain committed.
        -- Normal mutation hooks maintain changes behind the sweep's cursor.

    @invariant MutationAuthority
        -- The orchestration obtains and retains authority through each mutation
        -- unit: locator repair, one message, or pruning. Denial fails the attempt.

    @invariant TruthfulDiagnostic
        -- Authenticated diagnostics read only the in-memory status, phase and count.
        -- Database failures preserve available numeric codes, including wrapped
        -- hydration errors; raw errors and message content are never exposed.
        -- Pending/running may be called warming; failed is unavailable, never warming.
        -- Search is authoritative only after ready. Diagnostics perform no DB work.
}
