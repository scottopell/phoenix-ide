-- allium: 3
-- git-repository.allium
--
-- Phoenix Hidden Git Repository: Behavioural Specification
--
-- Scope: hidden Phoenix-local GitRepository identity, mutable locator and
--        default-branch observations, singular repository attachment to
--        WorkScope, immutable restart repair evidence, and repository-backed
--        worktree registry/reuse rules.
--
-- Excludes:
--   - SQL tables and migration shape.
--   - Creation worker claims and retry scheduling (conversation-creation).
--   - Close retirement orchestration (work-lifecycle).
--   - User-facing repository management UI.
--
-- Requirement traceability: REQ-GITREP-001 through REQ-GITREP-009,
-- REQ-PROJ-015, REQ-PROJ-020, REQ-PROJ-021, REQ-PROJ-024, REQ-PROJ-025.

use "../bedrock/bedrock.allium" as bedrock

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value WorkScopeRef {
    id: String
}

value WorktreeIdentity {
    id: String
    path: String
    fingerprint: String
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum LocatorKind {
    git_common_dir
    | management_root
}

enum LocatorStatus {
    present
    | missing
    | inaccessible
}

enum DefaultBranchProvenance {
    remote_head_cache
    | local_checked_out_branch
    | user_selected
}

enum RestartRepairObservationKind {
    missing
    | inaccessible
}

enum ProvisioningEvidenceKind {
    canonical_default_resolved
    | canonical_default_unresolved
}

enum RepositoryAuthorityGeneration {
    project_1
    | git_repository_2
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity GitRepository {
    opaque_id: String
}
external entity DatabaseStateFingerprint {
    digest: String
}

external entity ProductCapabilityContract {
    capability_id: String
}

external entity NormativeRequirementContract {
    requirement_id: String
}

external entity ProjectAuthorityBinaryArtifact {
    artifact_id: String
}

external entity GitRepositoryAuthorityBinaryArtifact {
    artifact_id: String
}

entity RepositoryAuthorityActivationMandate {
    consumer_capability: ProductCapabilityContract
    owning_requirement: NormativeRequirementContract
}

external entity PreActivationDatabaseSnapshot {
    source_database_fingerprint: DatabaseStateFingerprint
    project_authority_binary: ProjectAuthorityBinaryArtifact
}


entity RepositoryLocatorObservation {
    repository: GitRepository
    locator_kind: LocatorKind
    observed_path: String
    status: LocatorStatus
    observed_at: Timestamp
}

entity DefaultBranchObservation {
    repository: GitRepository
    observation_generation: Integer
}

variant ResolvedDefaultBranchObservation : DefaultBranchObservation {
    branch_name: String
    provenance: DefaultBranchProvenance
    observed_at: Timestamp
}

variant UnresolvedDefaultBranchObservation : DefaultBranchObservation {
    observed_at: Timestamp
}

external entity WorkScopeRepositoryAttachment {
    scope: WorkScopeRef
    repository: GitRepository
}

external entity ProductConversationScopeAttachment {
    product_conversation: bedrock/ProductConversation
    scope: WorkScopeRef
}

external entity RepositoryProvisioningEvidence {
    product_conversation: bedrock/ProductConversation
    transcript_conversation_id: String
    repository: GitRepository
    evidence_kind: ProvisioningEvidenceKind
}

entity RestartRepairEvidence {
    product_conversation: bedrock/ProductConversation
    scope: WorkScopeRef
    repository: GitRepository
    worktree: WorktreeIdentity
    observation_kind: RestartRepairObservationKind
    observation_generation: Integer
    observed_at: Timestamp
}

external entity ProductConversationDeletion {
    product_conversation: bedrock/ProductConversation
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule SeparateClonesRemainDistinctHiddenRepositories {
    when: SeparateCloneObserved(left_clone_evidence, right_clone_evidence)
    ensures: SeparateCloneRepositoriesResolved(left_clone_evidence, right_clone_evidence)
    ensures: resolved_hidden_repository(left_clone_evidence).opaque_id != resolved_hidden_repository(right_clone_evidence).opaque_id

    @guidance
        -- Matching remotes, slugs, or commit graphs do not collapse separate clones
        -- into one hidden identity.
}

rule LocatorObservationsUpdateWithoutReplacingRepositoryIdentity {
    when: RepositoryLocatorObserved(repository, locator_kind, observed_path, status, observed_at)
    requires: repository_locator_observation_is_not_stale(repository, locator_kind, observed_at)
    ensures: RepositoryLocatorObservation.updated(
        repository: repository,
        locator_kind: locator_kind,
        observed_path: observed_path,
        status: status,
        observed_at: observed_at
    )

    @guidance
        -- Locator paths are mutable observations. `missing` and `inaccessible`
        -- remain distinct states, and recording a new locator observation never
        -- implies minting a replacement hidden repository identity.
}

rule ResolvedDefaultBranchObservationIsAtomic {
    when: ResolvedDefaultBranchObserved(repository, branch_name, provenance, observed_at)
    requires: default_branch_observation_is_not_stale(repository, observed_at)
    let observation_generation = next_default_branch_observation_generation(repository)
    ensures: ResolvedDefaultBranchObservation.updated(
        repository: repository,
        observation_generation: observation_generation,
        branch_name: branch_name,
        provenance: provenance,
        observed_at: observed_at
    )

    @guidance
        -- A resolved observation carries branch identity, provenance, and time as
        -- one structural value. A checked-out-branch fallback uses provenance
        -- `local_checked_out_branch`; only `remote_head_cache` is canonical evidence
        -- without separate corroboration. Phoenix never fabricates `main`.
}

rule DefaultBranchObservationMayRemainUnresolved {
    when: DefaultBranchResolutionFailed(repository, observed_at)
    requires: default_branch_observation_is_not_stale(repository, observed_at)
    let observation_generation = next_default_branch_observation_generation(repository)
    ensures: UnresolvedDefaultBranchObservation.updated(
        repository: repository,
        observation_generation: observation_generation,
        observed_at: observed_at
    )
}

rule CanonicalDefaultConsumersRequireCanonicalEvidence {
    when: CanonicalDefaultBranchConsumerRequested(repository, consumer_kind)
    requires: canonical_default_evidence_admissible(repository)
    ensures: CanonicalDefaultBranchConsumerResolved(repository, consumer_kind)

    @guidance
        -- A consumer such as creation or provisioning that promises canonical-
        -- default behavior may proceed only from remote-head canonical evidence or
        -- separate corroboration that establishes the same canonical branch without
        -- rewriting the original observation's provenance.
}

rule ProductConversationDerivesRepositoryContextFromAttachedScope {
    when: ProductConversationRepositoryContextRequested(product_conversation)
    requires: exists ProductConversationScopeAttachment{product_conversation: product_conversation, scope: ProductConversationScopeAttachment.scope}
    ensures: ProductConversationRepositoryContextResolved(product_conversation)

    @guidance
        -- The ProductConversation reads repository context through its attached
        -- WorkScope. There is no second independent writable ProductConversation-
        -- to-repository authority.
}

rule DeterministicLegacyProjectBackfillSeedsHiddenRepositoryIdentity {
    when: LegacyProjectRepositoryBackfillRequested(legacy_project_id, repository)
    ensures: LegacyProjectRepositoryBackfillRecorded(legacy_project_id, repository)

    @guidance
        -- Backfill is deterministic and replay-stable: the same retained legacy
        -- Project identity resolves to the same hidden GitRepository identity every
        -- time. Seeding GitRepository identity from legacy Project identity is
        -- migration-only and never authorizes runtime substitution between domains.
}

rule ConflictingLegacyProjectAssignmentsFailRepositoryMigration {
    when: LegacyProjectAssignmentConflictObserved(scope)
    ensures: RepositoryAuthorityMigrationFailed(scope)

    @guidance
        -- If one WorkScope resolves to conflicting retained legacy Project
        -- assignments, migration fails rather than selecting one heuristically.
}

rule RepositoryAuthorityActivationIsConsumerTriggeredAndOffline {
    when: RepositoryAuthorityActivationRequested(consumer_capability, owning_requirement)
    let mandate = RepositoryAuthorityActivationMandate{
        consumer_capability: consumer_capability,
        owning_requirement: owning_requirement
    }
    requires: mandate.consumer_capability.capability_id != ""
    requires: mandate.owning_requirement.requirement_id != ""
    requires: mandate_identifies_exact_authorizing_contract(mandate)
    requires: phoenix_is_stopped()
    requires: exclusive_repository_database_access_held()
    let source_database_fingerprint = DatabaseStateFingerprint{
        digest: exact_pre_activation_database_fingerprint_digest()
    }
    let project_authority_binary = ProjectAuthorityBinaryArtifact{
        artifact_id: exact_project_authority_binary_artifact_id()
    }
    let pre_activation_snapshot = PreActivationDatabaseSnapshot{
        source_database_fingerprint: source_database_fingerprint,
        project_authority_binary: project_authority_binary
    }
    requires: exact_pre_activation_snapshot_verified(pre_activation_snapshot)
    requires: dormant_git_repository_foundation_is_valid()
    requires: every_repository_sensitive_reader_and_writer_migrated_or_quarantined()
    requires: persisted_repository_authority_generation() = project_1
    let activated_database_fingerprint = DatabaseStateFingerprint{
        digest: committed_activation_database_fingerprint_digest()
    }
    let git_repository_authority_binary = GitRepositoryAuthorityBinaryArtifact{
        artifact_id: exact_git_repository_authority_binary_artifact_id()
    }
    requires: activated_database_fingerprint.digest != ""
    requires: git_repository_authority_binary.artifact_id != ""
    requires: activated_database_fingerprint.digest != source_database_fingerprint.digest
    ensures: RepositoryAuthorityGenerationChanged(project_1, git_repository_2)
    ensures: RepositoryAuthorityActivationCompleted(
        mandate,
        pre_activation_snapshot,
        activated_database_fingerprint,
        git_repository_authority_binary,
        git_repository_2
    )
    ensures: ProjectSeededRepositoryIdentitiesPreserved()
    ensures: SurvivingProjectRepresentationsCannotFeedCorrectnessDecisions()

    @guidance
        -- With Phoenix stopped, acquire exclusive SQLite access before capturing
        -- and verifying the exact database snapshot that will be activated. Validate
        -- the dormant Foundation and preserve every deterministic Project-seeded
        -- GitRepository identity. Before the global generation flip, migrate or
        -- structurally quarantine every repository-sensitive reader and writer. In
        -- one transaction, update authority-bearing references and change generation
        -- 1 to generation 2. A pre-commit failure rolls back wholly. Activation
        -- performs no live Git observation, identity convergence, runtime drain
        -- protocol, or source-census authorization.
}

rule RepositoryAuthorityDatabaseOpenRejectsWrongGeneration {
    when: RepositoryAuthorityDatabaseOpenRequested(required_authority_generation)
    requires: required_authority_generation != persisted_repository_authority_generation()
    ensures: RepositoryAuthorityDatabaseOpenRejected(required_authority_generation)

    @guidance
        -- Normal operation starts only when the binary's required authority
        -- generation matches the database. After offline activation commits
        -- generation 2, a Project-authority binary requiring generation 1 fails
        -- closed rather than opening or modifying the database.
}

rule PreScopeProvisioningEvidenceMayReferenceRepositoryDirectly {
    when: RepositoryProvisioningRecorded(product_conversation, transcript_conversation_id, repository, evidence_kind)
    ensures: RepositoryProvisioningEvidence.created(
        product_conversation: product_conversation,
        transcript_conversation_id: transcript_conversation_id,
        repository: repository,
        evidence_kind: evidence_kind
    )

    @guidance
        -- Provisioning, unresolved canonical-default failure, or other pre-scope
        -- evidence may truthfully reference a hidden GitRepository before any
        -- WorkScope exists. Phoenix must not fabricate a scope just to carry
        -- repository identity.
}

rule RestartRepairEvidenceRecordsExactMissingOrInaccessibleObservation {
    when: RestartRepairObservationRecorded(product_conversation, scope, repository, worktree, observation_kind, observed_at)
    requires: restart_repair_observation_is_not_stale(product_conversation, scope, observed_at)
    let observation_generation = next_restart_repair_generation(product_conversation, scope)
    ensures: RestartRepairEvidence.created(
        product_conversation: product_conversation,
        scope: scope,
        repository: repository,
        worktree: worktree,
        observation_kind: observation_kind,
        observation_generation: observation_generation,
        observed_at: observed_at
    )

    @guidance
        -- Restart repair evidence is immutable source observation. It binds one
        -- ProductConversation, one WorkScope, one hidden GitRepository, and one
        -- retained worktree identity/fingerprint to an exact `missing` or
        -- `inaccessible` observation without guessing path continuity.
}

rule RestartRepairEvidenceSelectionIsDeterministicOrFailsClosed {
    when: RestartRepairEvidenceSelectionRequested(product_conversation, scope)
    requires: unique_complete_latest_restart_repair_evidence(product_conversation, scope)
    ensures: RestartRepairEvidenceSelectionResolved(product_conversation, scope)

    @guidance
        -- Later repair, Close, or retry consumers select independently for the
        -- exact ProductConversation and exact WorkScopeRef supplied by the request.
        -- Multiple attached scopes never collapse into one conversation-global
        -- latest row. A duplicate highest generation, conflicting identity,
        -- incomplete row, or scope ambiguity leaves selection unresolved.
}

rule RepositoryMayOutliveConversationDeletionWhenOtherRepositoryTruthRemains {
    when: ProductConversationDeleted(product_conversation)
    requires: exists ProductConversationDeletion{product_conversation: product_conversation}
    requires: hidden_repository_still_needed_after_deletion(product_conversation)
    ensures: HiddenRepositoryRetainedAfterConversationDeletion(product_conversation)

    @guidance
        -- Hidden repository identity survives deletion when Phoenix still needs it
        -- for orphan recovery, default-branch observation history, restart repair,
        -- or repository-scoped mutation locking.
}

------------------------------------------------------------
-- Helpers (pure predicates referenced by retention rules)
------------------------------------------------------------
--
-- Allium has no formal helper-function declaration; this block defines the
-- complete semantics of each bare helper used above.
--
--   resolved_hidden_repository(clone_evidence) -> GitRepository
--       The hidden identity resolved from retained local clone evidence. Separate
--       local clones resolve independently even when remote, slug, or commit graph
--       observations match.
--
--   default_branch_observation_is_not_stale(
--       repository: GitRepository,
--       observed_at: Timestamp
--   ) -> Boolean
--       True iff no current DefaultBranchObservation exists for repository or
--       observed_at is not earlier than its observed_at. A delayed older success or
--       failure is rejected before generation advances or current state changes.
--
--   next_default_branch_observation_generation(
--       repository: GitRepository
--   ) -> Integer
--       One greater than the current observation_generation for that exact
--       repository, or 1 when none exists. The caller cannot provide or override
--       this generation; the accepted update supersedes the older current row.
--
--   repository_locator_observation_is_not_stale(
--       repository: GitRepository,
--       locator_kind: LocatorKind,
--       observed_at: Timestamp
--   ) -> Boolean
--       True iff no retained observation exists for that exact repository and
--       locator kind, or observed_at is not earlier than its observed_at. Delayed
--       older observations are rejected before current path or status changes.
--
--   restart_repair_observation_is_not_stale(
--       product_conversation: bedrock/ProductConversation,
--       scope: WorkScopeRef,
--       observed_at: Timestamp
--   ) -> Boolean
--       True iff no current RestartRepairEvidence exists for that exact
--       ProductConversation and WorkScopeRef, or observed_at is not earlier than
--       its observed_at. A delayed older observation is rejected before generation
--       advances or current state changes. An equal timestamp is admissible and is
--       resolved by the exact evidence identity and generation constraints.
--
--   next_restart_repair_generation(
--       product_conversation: bedrock/ProductConversation,
--       scope: WorkScopeRef
--   ) -> Integer
--       One greater than the greatest persisted observation_generation for that
--       exact ProductConversation and WorkScopeRef, or 1 when none exists. The
--       caller cannot provide or override this generation.
--
--   canonical_default_evidence_admissible(
--       repository: GitRepository
--   ) -> Boolean
--       True iff exactly one complete DefaultBranchObservation exists at the
--       highest observation_generation for repository, that observation is
--       resolved, and its provenance is remote_head_cache; or separate canonical
--       evidence corroborates the same branch identity. No observation, an
--       unresolved or incomplete highest generation, or duplicate highest
--       generations makes this false. local_checked_out_branch or user_selected
--       alone is never admissible canonical evidence.
--
--   exact_pre_activation_database_fingerprint_digest() -> String
--       The stable digest of the exact database state captured while exclusive
--       access is held and before any activation mutation.
--
--   exact_project_authority_binary_artifact_id() -> String
--       The exact Project-authority Phoenix binary artifact verified to operate the
--       captured pre-activation snapshot.
--
--   committed_activation_database_fingerprint_digest() -> String
--       A stable digest of the exact committed generation-2 database state produced
--       by the authority transaction. It differs from the pre-activation digest.
--
--   exact_git_repository_authority_binary_artifact_id() -> String
--       The exact staged generation-2 Phoenix binary artifact whose complete
--       repository-sensitive readers and writers were validated for this activation.
--
--   mandate_identifies_exact_authorizing_contract(
--       mandate: RepositoryAuthorityActivationMandate
--   ) -> Boolean
--       True iff mandate names one exact ProductConversation or destructive Close
--       capability and the exact owning normative requirement that explicitly
--       requires GitRepository authority generation 2. A broad consumer category,
--       generic domain reference, Foundation availability, or task alone makes this
--       false.
--
--   phoenix_is_stopped() -> Boolean
--       True iff no Phoenix server, one-shot runtime, worker, or other Phoenix
--       process has the target database open or can admit work against it.
--
--   exact_pre_activation_snapshot_verified(
--       snapshot: PreActivationDatabaseSnapshot
--   ) -> Boolean
--       True iff snapshot is recoverable, matches the exact exclusively held source
--       database state before activation mutation, and is paired with a Project-
--       authority binary verified to operate that snapshot.
--
--   exclusive_repository_database_access_held() -> Boolean
--       True iff the offline maintenance operation exclusively owns the target
--       SQLite database for the full validation and authority transaction.
--
--   dormant_git_repository_foundation_is_valid() -> Boolean
--       True iff the additive Foundation schema, deterministic Project-seeded
--       GitRepository identities, and WorkScope attachments satisfy their complete
--       query-only readiness contract without promoting them to authority.
--
--   every_repository_sensitive_reader_and_writer_migrated_or_quarantined() -> Boolean
--       True iff every route, worker, one-shot runtime, creation/provisioning path,
--       branch or PR observer, prompt-grounding path, reconciler, repair path, lock,
--       and compatibility adapter that can make a repository-sensitive correctness
--       decision either consumes GitRepository authority or is structurally unable
--       to run or feed such a decision after generation 2. Merely freezing Project
--       writes or migrating only the triggering consumer makes this false.
--
--   persisted_repository_authority_generation() -> RepositoryAuthorityGeneration
--       The one persisted repository-authority generation. project_1 denotes
--       Project authority and git_repository_2 denotes GitRepository authority.
--
--   unique_complete_latest_restart_repair_evidence(
--       product_conversation: bedrock/ProductConversation,
--       scope: WorkScopeRef
--   ) -> Boolean
--       True iff exactly one RestartRepairEvidence row exists at the highest
--       observation_generation for product_conversation and that exact scope, and
--       that row has complete repository identity, worktree id/path/fingerprint,
--       observation kind, generation, and observation time. Evidence for another
--       WorkScopeRef never satisfies this predicate. Duplicate highest generations,
--       conflicting identities, incomplete rows, or scope ambiguity make it false.
--
--   hidden_repository_still_needed_after_deletion(
--       product_conversation: bedrock/ProductConversation
--   ) -> Boolean
--       True iff deleting product_conversation leaves at least one surviving
--       WorkScope attachment, pre-scope provisioning/repair evidence, orphan
--       resource, default-branch observation required by a consumer, or active
--       repository-scoped mutation lock that references the same GitRepository.
--
--   UserFacingRepositoryCatalogEntry(repository: GitRepository) -> Boolean
--       True iff a user-facing repository catalog, favorite, recent-location,
--       grouping, or equivalent product entry is keyed by repository.
--
--   UserFacingRepositoryLifecycleOwned(repository: GitRepository) -> Boolean
--       True iff repository owns a user-facing lifecycle, title, task inventory,
--       branch inventory, pull-request workflow, Close, or Delete behavior.
--
--   hidden_repository_needed_for_operational_truth(
--       repository: GitRepository
--   ) -> Boolean
--       True iff at least one surviving WorkScope attachment, provisioning or
--       repair evidence, orphan resource, required default-branch observation,
--       or active repository-scoped mutation lock references repository. A
--       recent-location suggestion, favorite, title, grouping, branch, PR, or
--       conversation list projection does not satisfy this predicate.
--
------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant WorkScopeHasAtMostOneRepositoryAttachment {
    for s in WorkScopeRepositoryAttachment.scope:
        count(WorkScopeRepositoryAttachment{scope: s}) <= 1
}

invariant ProductConversationRepositoryContextFlowsThroughScope {
    for a in ProductConversationScopeAttachment:
        count(WorkScopeRepositoryAttachment{scope: a.scope}) <= 1
}

invariant OneLocatorObservationPerKind {
    for r in GitRepository:
        for k in LocatorKind:
            count(RepositoryLocatorObservation{repository: r, locator_kind: k}) <= 1
}

invariant OneCurrentDefaultBranchObservation {
    for r in GitRepository:
        count(DefaultBranchObservation{repository: r}) <= 1
}

invariant RestartRepairEvidenceIsUniquePerScopeGeneration {
    for e in RestartRepairEvidence:
        count(RestartRepairEvidence{
            product_conversation: e.product_conversation,
            scope: e.scope,
            observation_generation: e.observation_generation
        }) <= 1
}

invariant UnneededHiddenRepositoryDoesNotFeedProductCatalog {
    for r in GitRepository:
        if not hidden_repository_needed_for_operational_truth(r):
            not UserFacingRepositoryCatalogEntry(r)
}

invariant HiddenRepositoryHasNoUserFacingLifecycleSurface {
    for r in GitRepository:
        not UserFacingRepositoryLifecycleOwned(r)
}
