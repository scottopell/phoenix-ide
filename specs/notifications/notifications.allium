-- Notifications Specification
--
-- Browser desktop notifications when conversations need user attention.
-- Driven by SSE state_change events, configured via server-side settings.

use "./specs/bedrock/bedrock.allium" as bedrock

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum NotificationEventType {
    task_approval_needed
    question_asked
    agent_error
    agent_finished
}

enum BrowserPermission {
    default         -- not yet asked
    granted
    denied
}

-- Load status of the server-side settings row. Delivery is gated until the
-- value is authoritative, so notifications never fire against defaults that
-- might contradict the user's saved preference.
enum SettingsStatus {
    unloaded        -- never fetched
    loading         -- fetch in flight
    loaded          -- server value is authoritative; delivery may proceed
    failed          -- fetch failed; delivery stays gated until a retry loads
}

-- Outcome of attempting to deliver one NotificationEvent.
enum DeliveryResult {
    delivered           -- a browser notification was shown
    suppressed_focus    -- intentionally withheld; the user is already looking
    not_delivered       -- gated out: unloaded, disabled, permission, or construction failure
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- Global notification preferences (single row, not per-conversation).
entity NotificationSettings {
    enabled: Boolean = true

    -- Per-event-type toggles
    notify_task_approval: Boolean = true
    notify_question: Boolean = true
    notify_error: Boolean = true
    notify_idle: Boolean = true
}

-- Runtime policy state, distinct from the persisted settings: load status
-- plus the monotonic save-ordering counter.
entity NotificationPolicy {
    settings_status: SettingsStatus = unloaded
    -- Monotonic id of the most recently *requested* settings save. A save
    -- response is authoritative only while it remains the latest.
    latest_save_id: Integer = 0
}

-- A recorded blocking-state dedupe key. Its presence means the unresolved
-- blocking state for `conversation_id` has already reached the user (or was
-- intentionally withheld because the user was focused) once, so neither live
-- delivery nor catch-up fires again until it is cleared. Completions
-- (agent_finished) are never recorded here — each is independently
-- notification-worthy.
entity AttentionSeen {
    conversation_id: String
    event_key: String     -- event_key_of(event.type) of the blocking event
}

------------------------------------------------------------
-- Helpers
------------------------------------------------------------
--
-- Allium has no formal helper-function declaration; the rules below call
-- these by bare identifier. This block is the single source of truth for
-- their signatures and semantics.
--
--   event_type_enabled(type: NotificationEventType,
--                      settings: NotificationSettings) -> Boolean
--       The per-event toggle selected by event type:
--         task_approval_needed -> settings.notify_task_approval
--         question_asked       -> settings.notify_question
--         agent_error          -> settings.notify_error
--         agent_finished       -> settings.notify_idle
--
--   is_blocking(type: NotificationEventType) -> Boolean
--       True for the unresolved-attention events (task_approval_needed,
--       question_asked, agent_error); false for agent_finished.
--
--   event_key_of(type: NotificationEventType) -> String
--       The dedupe key component for a blocking event — its event type.
--       Undefined for agent_finished (which is never deduped).
--
--   blocking_already_seen(type: NotificationEventType,
--                         conversation: bedrock/Conversation) -> Boolean
--       True iff is_blocking(type) and an AttentionSeen exists for
--       {conversation_id: conversation.id, event_key: event_key_of(type)}.
--
--   delivery_result(type: NotificationEventType,
--                   conversation: bedrock/Conversation) -> DeliveryResult
--       The outcome of attempting delivery under the current settings,
--       browser permission, and focus state. `delivered` when a browser
--       notification is shown; `suppressed_focus` when withheld because the
--       user is focused on the triggering conversation; `not_delivered`
--       otherwise (settings unloaded, type disabled, permission not granted,
--       or browser construction failure).
--
--   recorded_via_delivery(s: AttentionSeen) -> Boolean
--       True iff the dedupe key `s` was recorded by RecordAttentionOnDelivery
--       — i.e. its delivery_result was delivered or suppressed_focus, never a
--       merely gated-out attempt.
--
--   notification_tag(event: NotificationEvent) -> String
--       Blocking events: "{event.type}:{conversation.id}" — one tag per
--       conversation+event, so a re-observed blocking state replaces in
--       place. agent_finished: "agent_finished:{conversation.id}:{updated_at}"
--       — a completion-specific tag, so successive completions for the same
--       conversation are distinct browser notifications.

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- Default settings for new installations
    default_notifications_enabled: Boolean = true
    default_notify_task_approval: Boolean = true
    default_notify_question: Boolean = true
    default_notify_error: Boolean = true
    default_notify_idle: Boolean = true
}

------------------------------------------------------------
-- Rules: Event Detection
------------------------------------------------------------

-- Map conversation state transitions to notification events.
-- These rules fire in the frontend when SSE state_change arrives.

rule DetectTaskApprovalNeeded {
    when: conversation: bedrock/Conversation.status
        transitions_to awaiting_task_approval

    ensures: NotificationEvent(
        type: task_approval_needed,
        conversation: conversation,
        title: "Task approval needed",
        body: conversation.slug
    )
}

rule DetectQuestionAsked {
    when: conversation: bedrock/Conversation.status
        transitions_to awaiting_user_response

    ensures: NotificationEvent(
        type: question_asked,
        conversation: conversation,
        title: "Question asked",
        body: conversation.slug
    )
}

rule DetectAgentError {
    when: conversation: bedrock/Conversation.status
        transitions_to error

    ensures: NotificationEvent(
        type: agent_error,
        conversation: conversation,
        title: "Agent error",
        body: conversation.slug
    )

    @guidance
        -- Also fires for context_exhausted state, except when the
        -- conversation has continued elsewhere (continued_in_conv_id set) --
        -- that predecessor is no longer actionable.
        -- Implementation: check for both "error" and "context_exhausted"
        -- in the SSE state_change handler; skip context_exhausted with a
        -- continuation.
}

rule DetectAgentFinished {
    when: conversation: bedrock/Conversation.status
        transitions_to idle

    -- Only notify when transitioning FROM a busy state, not on page load
    -- when conversations are already idle.
    requires: conversation.previous_status in {
        llm_requesting, executing_tools, awaiting_sub_agents,
        cancelling_tool, cancelling_sub_agents
    }

    ensures: NotificationEvent(
        type: agent_finished,
        conversation: conversation,
        title: "Agent finished",
        body: conversation.slug
    )
}

------------------------------------------------------------
-- Rules: Catch-Up on SSE Reconnect
------------------------------------------------------------

-- When SSE reconnects (tab woke up, network restored, page refreshed),
-- check all conversations for states that need attention. Fire
-- notifications for any that were missed while the tab was suspended.

-- Three sibling rules cover the three notify-worthy states the catch-up
-- pass observes. v3 grammar does not allow `ensures: X if cond` so each
-- conversation-state branch is its own rule with `requires:` filtering.
-- Intentionally does NOT notify for idle conversations on reconnect:
-- idle is only notification-worthy on live busy -> idle transition; on
-- catch-up idle is ambiguous (may have been idle for hours).

rule CatchUpAwaitingTaskApproval {
    when: SseReconnected(snapshot)

    ensures:
        for c in Conversations where not c.is_sub_agent:
            CatchupCheckTaskApproval(c)
}

rule EmitTaskApprovalCatchupNotification {
    when: CatchupCheckTaskApproval(conversation)
    requires: conversation.status = awaiting_task_approval

    ensures: NotificationEvent(
        type: task_approval_needed,
        conversation: conversation,
        title: "Task approval needed",
        body: conversation.slug
    )
}

rule EmitQuestionCatchupNotification {
    when: CatchupCheckTaskApproval(conversation)
    requires: conversation.status = awaiting_user_response

    ensures: NotificationEvent(
        type: question_asked,
        conversation: conversation,
        title: "Question asked",
        body: conversation.slug
    )
}

rule EmitErrorCatchupNotification {
    when: CatchupCheckTaskApproval(conversation)
    requires: conversation.status = error
        or conversation.status = context_exhausted
    -- A context_exhausted conversation that already continued elsewhere is
    -- no longer actionable, so it is not notification-worthy.
    requires: not (conversation.status = context_exhausted
        and conversation.continued_in_conv_id != null)

    ensures: NotificationEvent(
        type: agent_error,
        conversation: conversation,
        title: "Agent error",
        body: conversation.slug
    )

    @guidance
        -- Implementation: catch-up is driven by successful conversation-list
        -- refreshes, not by per-conversation SSE init. The current frontend
        -- opens SSE per conversation; init contains that conversation snapshot
        -- plus pending events, not the full conversation list. After
        -- api.listConversations() refreshes the ConversationStore,
        -- DesktopLayout scans active top-level conversations and uses the
        -- same DeliverNotification pipeline (settings, permission, focus).
        --
        -- The intermediate event (CatchupCheckTaskApproval) lets the
        -- three branches fire as separate rules without a top-level
        -- conditional — Allium v3's preferred shape.
}

------------------------------------------------------------
-- Rules: Notification Delivery
------------------------------------------------------------

-- Delivery is gated on the master toggle, the per-event toggle, browser
-- permission, and tab-focus state. The per-event toggle is selected by
-- the event type; v3 grammar has no `match` expression, so the lookup
-- moves into a black-box predicate `event_type_enabled(type, settings)`
-- that the implementation already maps via a small switch (see
-- ui/src/notifications.ts).
rule DeliverNotification {
    when: NotificationEvent(type, conversation, title, body)

    -- Server settings must be authoritative before anything fires; until
    -- then delivery is gated so a default never contradicts a saved choice.
    requires: NotificationPolicy.settings_status = loaded
    requires: NotificationSettings.enabled
    requires: event_type_enabled(type, NotificationSettings)
    requires: BrowserPermission = granted
    requires: not tab_is_focused
    -- Live SSE delivery and list-refresh catch-up share this gate, so an
    -- unresolved blocking state already surfaced is never shown twice
    -- regardless of which path observes it next.
    requires: not blocking_already_seen(type, conversation)

    ensures: BrowserNotificationShown(title, body, conversation)

    @guidance
        -- Implementation: new Notification(title, { body, tag })
        -- where tag = notification_tag(event). Blocking events reuse one tag
        -- per conversation+event so a re-observed state replaces in place;
        -- agent_finished carries a completion-specific tag so successive
        -- completions for one conversation are distinct.
        -- If the tab IS focused on the triggering conversation, the user is
        -- already looking -- no notification (delivery_result =
        -- suppressed_focus). event_type_enabled maps:
        --   task_approval_needed -> settings.notify_task_approval
        --   question_asked       -> settings.notify_question
        --   agent_error          -> settings.notify_error
        --   agent_finished       -> settings.notify_idle
}

-- The dedupe key is recorded only when the event actually reached the user
-- or was intentionally withheld because the user was focused. An event that
-- was merely gated out (settings unloaded, type disabled, permission not
-- granted, or browser construction failure) records nothing, so a later
-- attempt for the same unresolved state can still notify.
rule RecordAttentionOnDelivery {
    when: NotificationEvent(type, conversation, title, body)

    requires: is_blocking(type)
    requires: delivery_result(type, conversation) in { delivered, suppressed_focus }

    ensures: AttentionSeen{
        conversation_id: conversation.id,
        event_key: event_key_of(type)
    }
}

-- Resolving a blocking state clears its dedupe key so the next blocking
-- state for that conversation can notify again.
rule ClearBlockingDedupeOnResolution {
    when: conversation: bedrock/Conversation.status
        transitions_to idle

    ensures: not exists AttentionSeen{conversation_id: conversation.id}

    @guidance
        -- Any settled non-blocking state clears the key — idle (the dominant
        -- resolution), terminal, handed_off, or a context_exhausted that has
        -- continued elsewhere. A transition back into a busy state
        -- intentionally preserves the key (a brief busy blip mid-attention
        -- must not re-arm a notification). Implementation: clearAttentionSeen
        -- runs on the idle-from-busy branch and on the settled-else branch of
        -- notifyConversationStateChange.
}

rule NotificationClicked {
    when: UserClicksNotification(notification)

    ensures: TabFocused
    ensures: NotificationAcknowledged(notification.conversation)
    ensures: NavigatedTo(notification.conversation)

    @guidance
        -- Implementation: notification.onclick focuses the window, closes live
        -- notifications for the triggering conversation, then dispatches
        -- React Router navigation to `/c/${conversation.slug}`.
}

rule OpenConversationAcknowledgesLiveNotifications {
    when: ConversationOpened(conversation)

    ensures: NotificationAcknowledged(conversation)
    ensures: LiveNotificationsClosedFor(conversation)

    @guidance
        -- Implementation: DesktopLayout observes the active `/c/:slug`
        -- conversation snapshot and closes live Notification instances retained
        -- by conversation id. Other conversations' notifications are left open.
        -- Browser notifications outside the current page's live ownership are
        -- outside the Web Notification API close contract.
}

------------------------------------------------------------
-- Rules: Settings Management
------------------------------------------------------------

-- A user edit applies optimistically and allocates a fresh, larger save id.
-- The edit also makes settings authoritative for delivery, so a save during
-- an in-flight initial load does not wait on that load.
rule UpdateNotificationSettings {
    when: UserUpdatesSettings(new_settings)

    ensures: NotificationSettings.enabled = new_settings.enabled
    ensures: NotificationSettings.notify_task_approval = new_settings.notify_task_approval
    ensures: NotificationSettings.notify_question = new_settings.notify_question
    ensures: NotificationSettings.notify_error = new_settings.notify_error
    ensures: NotificationSettings.notify_idle = new_settings.notify_idle
    ensures: NotificationPolicy.settings_status = loaded
    ensures: NotificationPolicy.latest_save_id = NotificationPolicy.latest_save_id + 1

    @guidance
        -- PUT /api/settings/notifications { enabled, notify_task_approval, ... }
        -- Settings are persisted server-side (notification_settings table).
        -- PUTs are issued in user-edit order (a serialized chain), each
        -- tagged with the allocated save id.
}

-- The server response for a save is authoritative only while it is still the
-- latest request. An older response cannot overwrite a newer user edit.
rule ApplyNotificationSettingsSaveResult {
    when: SettingsSaveResponded(request_id, saved_settings)

    requires: request_id = NotificationPolicy.latest_save_id

    ensures: NotificationSettings.enabled = saved_settings.enabled
    ensures: NotificationSettings.notify_task_approval = saved_settings.notify_task_approval
    ensures: NotificationSettings.notify_question = saved_settings.notify_question
    ensures: NotificationSettings.notify_error = saved_settings.notify_error
    ensures: NotificationSettings.notify_idle = saved_settings.notify_idle
}

rule RequestBrowserPermission {
    when: UserRequestsPermission(initiator)

    requires: BrowserPermission = default

    ensures: BrowserPermissionPrompted

    @guidance
        -- Notification.requestPermission().then(permission => { ... })
        -- Can only be called from a user gesture (click handler).
        -- If permission is "denied", cannot re-prompt -- show guidance
        -- to change it in browser settings.
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface NotificationSettingsPanel {
    facing user: bedrock/User

    context settings: NotificationSettings

    exposes:
        user
        settings.enabled
        settings.notify_task_approval
        settings.notify_question
        settings.notify_error
        settings.notify_idle
        BrowserPermission

    provides:
        UpdateNotificationSettings(new_settings)
        RequestBrowserPermission
            when BrowserPermission = default
}

surface ConversationRoute {
    context conversation: bedrock/Conversation

    exposes:
        conversation.slug

    provides:
        ConversationOpened(conversation)
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- When master toggle is off, no notifications fire regardless of per-event settings.
invariant MasterToggleOverrides {
    not NotificationSettings.enabled implies
        for event in NotificationEvents:
            not BrowserNotificationShown(event)
}

-- Notifications never fire when the tab is focused.
invariant NoNotificationWhenFocused {
    tab_is_focused implies
        for event in NotificationEvents:
            not BrowserNotificationShown(event)
}

-- Notifications collapse by browser tag, not merely by conversation.
-- Unresolved blocking states reuse one tag per conversation+event so they
-- replace in place; each agent_finished completion carries a
-- completion-specific tag (conversation + updated_at) so successive
-- completions for one conversation remain distinct. (Enforced by
-- notification_tag(event) as the Notification tag.)
invariant NotificationsCollapseByTag {
    for a in BrowserNotifications:
        for b in BrowserNotifications:
            a != b implies a.tag != b.tag
}

-- Delivery is gated until the server settings row is authoritative, so a
-- default preference never contradicts the user's saved choice.
invariant DeliveryRequiresLoadedSettings {
    NotificationPolicy.settings_status != loaded implies
        for event in NotificationEvents:
            not BrowserNotificationShown(event)
}

-- A blocking dedupe key exists only when the event reached the user or was
-- intentionally focus-suppressed; a merely gated-out attempt records
-- nothing, so a later attempt for the same unresolved state can still fire.
invariant NoDedupeWithoutDelivery {
    for s in AttentionSeen:
        recorded_via_delivery(s)
}

-- A context_exhausted conversation that has continued elsewhere is no longer
-- actionable and produces no notification event.
invariant ContinuedContextExhaustedNotNotifiable {
    for c in Conversations where c.status = context_exhausted
        and c.continued_in_conv_id != null:
        not exists NotificationEvent{conversation: c}
}

-- A settings save response is authoritative only while it is the latest
-- request; an older response cannot overwrite a newer user edit.
invariant NewerSettingsSaveWins {
    for r in SettingsSaveResponses:
        r.request_id != NotificationPolicy.latest_save_id implies
            not NotificationSettingsAppliedFrom(r)
}
