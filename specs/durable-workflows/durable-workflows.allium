-- allium: 3
-- Durable Workflow Engine: Behavioural Specification
--
-- Scope: profile-neutral durable execution for one Phoenix server process and
-- one SQLite-backed scheduler authority. Profiles own domain meaning, adapters,
-- and reducer mapping.
--
-- Requirement traceability: REQ-DWF-001 through REQ-DWF-018, REQ-DWF-029 through REQ-DWF-042.
-- Profile imports extend this core with REQ-DWF-CHAT-001 through REQ-DWF-CHAT-011,
-- REQ-DWF-WAKE-001 through REQ-DWF-WAKE-005, and
-- REQ-DWF-CREATE-001 through REQ-DWF-CREATE-005.

------------------------------------------------------------
-- Types
------------------------------------------------------------

enum DeliveryStatus { pending | accepted | suppressed }
enum SuppressionReason { cancelled | superseded | lifecycle_terminal | reducer_terminal }
enum ReceiptFamily { current_generation_effect | compensation_effect | schedule_occurrence }
enum ManualChoiceKind { retry | compensate | suppress | accept_as_terminal }
enum WorkflowStatus { active | cancelling | cancelled | deletion_pending | completed | deleted | failed | manual_resolution }
enum EffectRole { required | optional | compensation }
enum ExecutionCapabilityClass {
    ReclaimableObservation
    | IdempotentSubmission
    | ObservableSubmission
    | SafelyRepeatable
    | ManualOnAmbiguity
}
enum EffectStatus {
    blocked | eligible | executing | retry_wait | ambiguity_wait
    | receipted | invalidated
}
enum AttemptStatus { begun | evidence_recorded | receipt_accepted | authority_lost }
enum ReceiptOrigin {
    execution | adoption | reconciliation | manual | cancellation_arbitration | schedule_collapse
}
enum BarrierStatus { waiting | satisfied }
enum RuntimeAcceptanceStatus { owed | accepted | suppressed }
enum ResolutionStatus { required | resolved }
enum CommitOutcome { committed | version_conflict | unsupported_codec | invalid_plan }
enum ClaimOutcome { started | ineligible | authority_conflict | unsupported_codec }
enum AuthorityOutcome { authorized | stale_authority }
enum RecoveryDecision {
    perform | adopt | repair | compensate | durable_conflict
    | request_manual_resolution | retry_infrastructure | stop_authority_lost
}
enum SchedulerAuthorityTopology { one_scheduler_per_sqlite }
enum SchedulePolicy { CoalesceLatest }
enum ScheduleStatus { idle | due | active }

value ProfileRef {
    profile_kind: String
    profile_version: Integer
}

value CodecRef {
    family: String
    version: Integer
}

value AttemptAuthority {
    workflow_id: String
    declared_workflow_version: Integer
    generation: Integer
    effect_id: String
    attempt_id: String
    process_incarnation: String
}

value ReclaimableLease {
    attempt_id: String
    lease_until: Timestamp
}

value EffectDeclaration {
    effect_id: String
    family: String
    kind: String
    codec: CodecRef
    generation: Integer
    role: EffectRole
    capability_class: ExecutionCapabilityClass
    intent: String
    next_eligible_at: Timestamp?
    destructive_resource: String?
}

value DependencyDeclaration {
    effect_id: String
    depends_on_effect_id: String
}

value BarrierDeclaration {
    barrier_id: String
}

value BarrierMemberDeclaration {
    barrier_id: String
    effect_id: String
    receipt_family: ReceiptFamily
}

value DeliveryDeclaration {
    consumer_kind: String
    payload_codec: CodecRef
    payload: String
    requires_runtime_acceptance: Boolean
}

value ScheduleDeclaration {
    schedule_id: String
    policy: SchedulePolicy
    next_eligible_at: Timestamp
    key: String
}

value TransitionPlan {
    snapshot_codec: CodecRef
    snapshot_payload: String
    event_codec: CodecRef
    event_payload: String
    effects: List<EffectDeclaration>
    dependencies: List<DependencyDeclaration>
    barriers: List<BarrierDeclaration>
    barrier_members: List<BarrierMemberDeclaration>
    deliveries: List<DeliveryDeclaration>
    schedules: List<ScheduleDeclaration>
}

value ReducerDecision {
    expected_workflow_version: Integer
    plan: TransitionPlan
}

value ExternalAcceptanceRequest {
    profile: ProfileRef
    authority_scope: String
    idempotency_key: String
    intent_fingerprint: String
    handle_codec: CodecRef
    handle_payload: String
}

value ExternalAcceptanceReceipt {
    idempotency_key: String
    workflow_id: String
    handle_codec: CodecRef
    handle_payload: String
}

value DirectTurnAcceptance {
    client_message_id: String
    workflow_id: String
}

------------------------------------------------------------
-- Actors
------------------------------------------------------------

actor WorkflowClient {}
actor ProductReducer {}
actor Scheduler {}
actor EffectAdapter {}
actor RuntimeConsumer {}
actor ResolutionOperator {}
actor MigrationOperator {}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity SchedulerAuthority {
    topology: SchedulerAuthorityTopology
    database_identity: String
    process_incarnation: String
}

entity ExternalAcceptanceBinding {
    profile: ProfileRef
    authority_scope: String
    idempotency_key: String
    intent_fingerprint: String
    workflow_id: String
    receipt: ExternalAcceptanceReceipt
    accepted_at: Timestamp
}

entity DirectTurnBinding {
    client_message_id: String
    workflow_id: String
    accepted_at: Timestamp
}

entity Workflow {
    id: String
    profile: ProfileRef
    version: Integer
    generation: Integer
    status: WorkflowStatus
    snapshot_codec: CodecRef
    snapshot_payload: String
    accepted_at: Timestamp

    transitions status {
        active -> cancelling
        active -> completed
        active -> failed
        active -> deletion_pending
        active -> manual_resolution
        cancelling -> cancelled
        cancelling -> deletion_pending
        manual_resolution -> active
        manual_resolution -> cancelled
        manual_resolution -> deletion_pending
        cancelled -> deletion_pending
        failed -> deletion_pending
        deletion_pending -> deleted
        terminal: completed, cancelled, deleted, failed
    }
}

entity Transition {
    id: String
    workflow: Workflow
    from_version: Integer
    to_version: Integer
    generation: Integer
    event_codec: CodecRef
    event_payload: String
    committed_at: Timestamp
}

entity Effect {
    id: String
    workflow: Workflow
    declaring_transition: Transition
    declared_workflow_version: Integer
    generation: Integer
    family: String
    kind: String
    codec: CodecRef
    role: EffectRole
    capability_class: ExecutionCapabilityClass
    intent: String
    status: EffectStatus
    next_eligible_at: Timestamp?
    destructive_resource: String?

    transitions status {
        blocked -> eligible
        blocked -> invalidated
        eligible -> executing
        eligible -> invalidated
        executing -> retry_wait
        executing -> ambiguity_wait
        executing -> receipted
        executing -> eligible
        executing -> invalidated
        retry_wait -> eligible
        retry_wait -> invalidated
        ambiguity_wait -> receipted
        ambiguity_wait -> retry_wait
        ambiguity_wait -> invalidated
        terminal: receipted, invalidated
    }
}

entity EffectDependency {
    effect: Effect
    dependency: Effect
}

entity Attempt {
    id: String
    effect: Effect
    authority: AttemptAuthority
    status: AttemptStatus
    begun_at: Timestamp
}

entity Lease {
    attempt: Attempt
    lease: ReclaimableLease
    issued_at: Timestamp
    renewed_at: Timestamp?
}

entity Evidence {
    id: String
    effect: Effect
    attempt: Attempt?
    codec: CodecRef
    payload: String
    observed_at: Timestamp
    recorded_at: Timestamp
    authoritative: Boolean
}

entity Receipt {
    id: String
    effect: Effect
    attempt: Attempt?
    codec: CodecRef
    payload: String
    origin: ReceiptOrigin
    accepted_at: Timestamp
    generation: Integer
}

entity Barrier {
    id: String
    workflow: Workflow
    declaring_transition: Transition
    status: BarrierStatus
    satisfied_at: Timestamp?

    transitions status {
        waiting -> satisfied
        terminal: satisfied
    }
}

entity BarrierMember {
    barrier: Barrier
    effect: Effect
    receipt_family: ReceiptFamily
}

entity DeliveryItem {
    id: String
    workflow: Workflow
    source_receipt: Receipt?
    source_barrier: Barrier?
    consumer_kind: String
    payload_codec: CodecRef
    payload: String
    status: DeliveryStatus
    runtime_acceptance_status: RuntimeAcceptanceStatus?
    suppression_reason: SuppressionReason?
    accepted_transition: Transition?

    transitions status {
        pending -> accepted
        pending -> suppressed
        terminal: accepted, suppressed
    }
}

entity ConsumerCursor {
    delivery_item: DeliveryItem
    consumer_kind: String
    consumed_at: Timestamp
}

entity ManualResolution {
    id: String
    workflow: Workflow
    effect: Effect
    status: ResolutionStatus
    evidence_codec: CodecRef
    evidence_payload: String
    resolved_choice_kind: ManualChoiceKind? when status = resolved
    resolved_at: Timestamp? when status = resolved
}

entity Schedule {
    id: String
    workflow: Workflow
    policy: SchedulePolicy
    key: String
    status: ScheduleStatus
    next_eligible_at: Timestamp
    active_effect: Effect?

    transitions status {
        idle -> due
        due -> active
        active -> idle
    }
}

entity IncompatibleWorkflow {
    workflow_id: String
    stored_profile: ProfileRef
    detected_at: Timestamp
    disposition: String
}

------------------------------------------------------------
-- Helpers
------------------------------------------------------------

-- next_workflow_id(), next_transition_id(), next_attempt_id(), next_delivery_id()
-- next_schedule_id(), next_manual_resolution_id(), next_receipt_id(), next_evidence_id()
-- single_scheduler_authority(), profile_accepts_external_replay(profile)
-- profile_uses_runtime_acceptance(profile), plan_is_acyclic(plan), effect_is_initially_eligible(effect)
-- dependency_receipt_compatible(effect), attempt_authority_matches(attempt, workflow, effect)
-- lease_required(capability_class), reclaimable_phase(capability_class)
-- lease_live(attempt), stale_attempt_or_generation(result), record_non_authoritative_evidence(result)
-- receipt_family_for(receipt, effect), barrier_members_satisfied(barrier)
-- reducer_delivery_payload(receipt), runtime_acceptance_needed(delivery)
-- duplicate_delivery_reuses_existing_item(receipt), later_runtime_start_forbidden(delivery)
-- schedule_due(schedule), coalesced_latest_occurrence(schedule)
-- next_occurrence_from_current_state(schedule), no_missed_tick_backlog(schedule)
-- stable_command_id(effect), handle_receipt_available(effect), inspectable_by_command_id(effect)
-- ambiguous_submit_without_receipt(effect), migrate_losslessly(workflow), preserve_as_incompatible(workflow)
-- same_external_acceptance_intent(binding, request), same_direct_turn_intent(binding, workflow)
-- compensation_plan_committed_atomically(workflow), canonical_delivery_only(workflow)

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule OneSchedulerAuthorityOwnsTheDatabase {
    when: SchedulerBooted(scheduler, database_identity, process_incarnation)
    ensures: SchedulerAuthority.created(
        topology: one_scheduler_per_sqlite,
        database_identity: database_identity,
        process_incarnation: process_incarnation
    )

    @guidance
        -- The engine models one scheduler authority per SQLite database. Remote
        -- systems may return evidence or receipts, but they do not independently
        -- claim workflow rows.
}

rule TransitionPlanCommitsAtomically {
    when: ReducerProducedDecision(reducer, workflow, decision)
    requires: decision.expected_workflow_version = workflow.version
    requires: plan_is_acyclic(decision.plan)

    let next_version = workflow.version + 1
    let transition_id = next_transition_id()

    ensures: Transition.created(
        id: transition_id,
        workflow: workflow,
        from_version: workflow.version,
        to_version: next_version,
        generation: workflow.generation,
        event_codec: decision.plan.event_codec,
        event_payload: decision.plan.event_payload,
        committed_at: now()
    )
    ensures: Workflow{id: workflow.id}.version = next_version
    ensures: Workflow{id: workflow.id}.snapshot_codec = decision.plan.snapshot_codec
    ensures: Workflow{id: workflow.id}.snapshot_payload = decision.plan.snapshot_payload
    ensures: declared_effects_created_with_transition(workflow, transition_id, decision.plan.effects)
    ensures: declared_dependencies_created(workflow, transition_id, decision.plan.dependencies)
    ensures: declared_barriers_created(workflow, transition_id, decision.plan.barriers, decision.plan.barrier_members)
    ensures: declared_deliveries_created(workflow, transition_id, decision.plan.deliveries)
    ensures: declared_schedules_created(workflow, transition_id, decision.plan.schedules)

    @guidance
        -- Snapshot, transition, DAG, barriers, deliveries, and schedules are one
        -- CAS-guarded atomic fact set. A version corresponds to exactly one
        -- committed transition.
}

rule TransitionVersionConflictCommitsNothing {
    when: ReducerProducedDecision(reducer, workflow, decision)
    requires: decision.expected_workflow_version != workflow.version
    ensures: TransitionRejected(workflow.id, version_conflict)
}

rule EligibleEffectStartsWithUniversalAttemptAuthority {
    when: SchedulerStartsEligibleEffect(scheduler, effect)
    requires: single_scheduler_authority() != null
    requires: effect.status = eligible
    requires: dependency_receipt_compatible(effect)

    let attempt_id = next_attempt_id()
    let authority = AttemptAuthority{
        workflow_id: effect.workflow.id,
        declared_workflow_version: effect.declared_workflow_version,
        generation: effect.generation,
        effect_id: effect.id,
        attempt_id: attempt_id,
        process_incarnation: single_scheduler_authority().process_incarnation
    }

    ensures: Attempt.created(
        id: attempt_id,
        effect: effect,
        authority: authority,
        status: begun,
        begun_at: now()
    )
    ensures: Effect{id: effect.id}.status = executing
    ensures: lease_required(effect.capability_class) implies Lease.created(
        attempt: Attempt{id: attempt_id},
        lease: ReclaimableLease{attempt_id: attempt_id, lease_until: effect.next_eligible_at},
        issued_at: now()
    )

    @guidance
        -- Attempt authority is universal. A lease exists only for reclaimable
        -- phases such as observation or other explicitly reclaimable work.
}

rule StaleAttemptOrGenerationCannotAdvanceCurrentState {
    when: ExternalResultArrived(adapter, workflow, effect, result)
    requires: stale_attempt_or_generation(result)
    ensures: record_non_authoritative_evidence(result)
    ensures: not Receipt.created(effect: effect)

    @guidance
        -- Late work may be retained for diagnosis, but stale authority never
        -- mutates current execution or product state.
}

rule LeaseExpiryOnlyAuthorizesReclaimableProgress {
    when: LeaseExpired(scheduler, attempt)
    requires: Lease.exists(attempt: attempt)
    requires: reclaimable_phase(attempt.effect.capability_class)
    ensures: Attempt{id: attempt.id}.status = authority_lost
    ensures: Effect{id: attempt.effect.id}.status in {eligible, ambiguity_wait, retry_wait}

    @guidance
        -- Lease expiry ends local authority. It never proves an external action
        -- stopped, and it never upgrades a non-reclaimable mutation into a safe retry.
}

rule TerminalReceiptCreatesCanonicalDeliveryOnce {
    when: ReceiptAccepted(adapter, effect, receipt_payload, receipt_codec, origin)
    requires: effect.status = executing or effect.status = ambiguity_wait
    requires: not Receipt.created(effect: effect)

    let receipt_id = next_receipt_id()
    let delivery_id = next_delivery_id()

    ensures: Receipt.created(
        id: receipt_id,
        effect: effect,
        codec: receipt_codec,
        payload: receipt_payload,
        origin: origin,
        accepted_at: now(),
        generation: effect.generation
    )
    ensures: Effect{id: effect.id}.status = receipted
    ensures: DeliveryItem.created(
        id: delivery_id,
        workflow: effect.workflow,
        source_receipt: Receipt{id: receipt_id},
        consumer_kind: "reducer",
        payload_codec: reducer_delivery_payload(Receipt{id: receipt_id}).payload_codec,
        payload: reducer_delivery_payload(Receipt{id: receipt_id}).payload,
        status: pending,
        runtime_acceptance_status: runtime_acceptance_needed(DeliveryItem{id: delivery_id})
            ? owed
            : null
    )
    ensures: canonical_delivery_only(effect.workflow)

    @guidance
        -- One accepted terminal receipt can owe exactly one canonical delivery
        -- lifecycle. Profiles may hang typed payload data off that item, but they do
        -- not create a second inbox or outbox authority.
}

rule DuplicateTerminalReceiptReusesCanonicalDelivery {
    when: DuplicateReceiptDeliveryObserved(adapter, receipt)
    requires: duplicate_delivery_reuses_existing_item(receipt)
    ensures: CanonicalDeliveryReused(receipt.id)
}

rule RuntimeAcceptanceConsumesExactCanonicalItems {
    when: RuntimeAcceptsDelivery(runtime, workflow, items, reducer_decision)
    requires: every_item_is_pending_runtime_acceptance(items)
    requires: reducer_decision.expected_workflow_version = workflow.version

    ensures: Transition.created(workflow: workflow)
    ensures: accepted_delivery_items_marked_by_same_transition(items, workflow)
    ensures: no_later_runtime_start_for_items(items)

    @guidance
        -- The transaction that persists accepting product state also accepts or
        -- suppresses the exact canonical delivery items that caused the runtime start.
}

rule ExternalAcceptanceIsBoundBeforeAcknowledgement {
    when: ExternalAcceptanceRequested(client, request, workflow_id)
    requires: profile_accepts_external_replay(request.profile)
    requires: not ExternalAcceptanceBinding.exists(
        profile: request.profile,
        authority_scope: request.authority_scope,
        idempotency_key: request.idempotency_key
    )

    ensures: ExternalAcceptanceBinding.created(
        profile: request.profile,
        authority_scope: request.authority_scope,
        idempotency_key: request.idempotency_key,
        intent_fingerprint: request.intent_fingerprint,
        workflow_id: workflow_id,
        receipt: ExternalAcceptanceReceipt{
            idempotency_key: request.idempotency_key,
            workflow_id: workflow_id,
            handle_codec: request.handle_codec,
            handle_payload: request.handle_payload
        },
        accepted_at: now()
    )

    @guidance
        -- Externally replayable acceptance binds one stable client key to one
        -- durable workflow before Phoenix returns success.
}

rule ExternalAcceptanceReplayReturnsSameReceipt {
    when: ExternalAcceptanceRequested(client, request, workflow_id)
    let binding = ExternalAcceptanceBinding{
        profile: request.profile,
        authority_scope: request.authority_scope,
        idempotency_key: request.idempotency_key
    }
    requires: ExternalAcceptanceBinding.exists(
        profile: request.profile,
        authority_scope: request.authority_scope,
        idempotency_key: request.idempotency_key
    )
    requires: same_external_acceptance_intent(binding, request)
    ensures: ExternalAcceptanceReplayed(binding.receipt)
}

rule DirectTurnAcceptanceUsesStableClientMessageIdentity {
    when: DirectTurnAccepted(client, client_message_id, workflow_id)
    requires: not DirectTurnBinding.exists(client_message_id: client_message_id)
    ensures: DirectTurnBinding.created(
        client_message_id: client_message_id,
        workflow_id: workflow_id,
        accepted_at: now()
    )

    @guidance
        -- Direct turns that cross the durable acknowledgement boundary use the
        -- client message identity as the stable acceptance key.
}

rule DirectTurnReplayReturnsSameAcceptance {
    when: DirectTurnAccepted(client, client_message_id, workflow_id)
    requires: DirectTurnBinding.exists(client_message_id: client_message_id)
    ensures: DirectTurnReplayed(DirectTurnBinding{client_message_id: client_message_id}.workflow_id)
}

rule LongRunningRemoteWorkUsesSubmitThenObserve {
    when: SubmitRemoteEffectRequested(adapter, effect)
    requires: effect.capability_class in {IdempotentSubmission, ObservableSubmission}
    ensures: RemoteCommandAllocated(effect.id, stable_command_id(effect))
    ensures: handle_receipt_available(effect) implies Evidence.created(effect: effect)

    @guidance
        -- Remote work is durable submit, durable handle receipt when available,
        -- then reclaimable observation to a terminal receipt. Uncertain submission is
        -- resolved by inspect-before-retry or manual ambiguity, not blind replay.
}

rule AmbiguousRemoteSubmitWithInspectableCommandWaitsForInspection {
    when: SubmitRemoteEffectDisconnected(adapter, effect)
    requires: ambiguous_submit_without_receipt(effect)
    requires: inspectable_by_command_id(effect)
    ensures: Effect{id: effect.id}.status = ambiguity_wait
}

rule AmbiguousRemoteSubmitWithoutInspectableCommandRequiresManualResolution {
    when: SubmitRemoteEffectDisconnected(adapter, effect)
    requires: ambiguous_submit_without_receipt(effect)
    requires: not inspectable_by_command_id(effect)
    ensures: ManualResolution.created(
        id: next_manual_resolution_id(),
        workflow: effect.workflow,
        effect: effect,
        status: required,
        evidence_codec: effect.codec,
        evidence_payload: effect.intent
    )
}

rule CoalesceLatestScheduleCollapsesMissedOccurrences {
    when: ScheduleEvaluated(scheduler, schedule)
    requires: schedule.policy = CoalesceLatest
    requires: schedule_due(schedule)
    ensures: coalesced_latest_occurrence(schedule)
    ensures: no_missed_tick_backlog(schedule)

    @guidance
        -- Latest-state schedules owe at most one active occurrence. Downtime and
        -- repeated kicks coalesce into one due occurrence rather than a backlog.
}

rule CompletedCoalesceLatestScheduleComputesNextFromCurrentState {
    when: ScheduleOccurrenceCompleted(reducer, schedule)
    requires: schedule.policy = CoalesceLatest
    ensures: next_occurrence_from_current_state(schedule)
    ensures: Schedule{id: schedule.id}.status = idle
}

rule AdditionalDurableConsumersUseIndependentCursors {
    when: AdditionalConsumerConsumes(consumer, delivery_item, consumer_kind)
    requires: delivery_item.status in {pending, accepted}
    ensures: ConsumerCursor.created(
        delivery_item: delivery_item,
        consumer_kind: consumer_kind,
        consumed_at: now()
    )
    ensures: DeliveryItem{id: delivery_item.id}.status = delivery_item.status

    @guidance
        -- Extra durable consumers are independent views over the canonical item.
        -- They do not compete with reducer delivery or runtime acceptance state.
}

rule UpgradeEitherMigratesOrPreservesIncompatibleWorkExplicitly {
    when: WorkflowLoadedAfterUpgrade(operator, workflow)
    requires: workflow.profile.profile_version < current_profile_version(workflow.profile.profile_kind)
    ensures: migrate_losslessly(workflow) or preserve_as_incompatible(workflow)

    @guidance
        -- Active persisted work is never silently dropped. The system either
        -- migrates the typed row set or preserves an explicit incompatible state that
        -- still carries auditability and owed handling.
}
