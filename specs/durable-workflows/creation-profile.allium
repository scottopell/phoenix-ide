-- allium: 3
-- Engine-backed conversation-creation profile.
--
-- The durable-workflow core owns atomic plans, claims, generations, evidence,
-- receipts, barriers, deadlines, manual resolution, and shadow authority. This
-- profile owns creation intent types, the provisioning DAG, product adapters,
-- reconciliation policy, compensation meaning, readiness, and protocol projection.

use "./durable-workflows.allium" as dwf
use "../conversation-creation/conversation-creation.allium" as creation
use "../bedrock/bedrock.allium" as bedrock
use "../projects/projects.allium" as projects

------------------------------------------------------------
-- Types
------------------------------------------------------------

enum CreationProtocolAuthority { legacy_creation | engine_creation | shadow_creation }
enum CreationMode { direct | managed | branch }
enum RepositoryKind { non_git | git }
enum CreationEffectKind {
    resolve_repository | reserve_worktree | materialize_or_adopt_worktree
    | finalize_attachments | commit_metadata | expand_initial_message
    | bootstrap_runtime | dispatch_first_llm
    | remove_owned_worktree | release_worktree_reservation
    | remove_finalized_attachments | remove_conversation_metadata
}
enum CreationOutcome { provisioning | ready | cancelled | deleted | failed | manual_resolution }
enum ResourceOwnership { absent | owned | foreign | indeterminate }
enum ReconciliationResult { absent | matching | foreign | indeterminate }
enum CreationShadowComparisonKind {
    acceptance | intent_binding | effect_plan | observation | receipt | readiness | projection
}
enum CreationProtocolState { accepted | provisioning | ready | cancelling | cancelled | deletion_pending | deleted | failed | blocked }

value CreationIntent {
    conversation_id: String
    mode: CreationMode
    requested_directory: String
    requested_branch: String? when mode = branch
    desired_base_branch: String? when mode = managed
    initial_message: String
    attachments: List<String>
}

value CreationProfileBinding {
    profile: dwf/ProfileRef
    snapshot_codec: dwf/CodecRef
    event_codec: dwf/CodecRef
    effect_codec: dwf/CodecRef
    protocol_authority: CreationProtocolAuthority
}

value RepositoryResolution {
    kind: RepositoryKind
    requested_directory: String
    canonical_working_directory: String
    repository_root: String? when kind = git
    project_main_ref: String? when kind = git
}

value WorktreeReservationIntent {
    conversation_id: String
    repository_root: String
    path: projects/WorktreePath
    branch_name: String
    base_branch: String
}

value CreationProtocolProjection {
    conversation_id: String
    authority: CreationProtocolAuthority
    state: CreationProtocolState
    mode: CreationMode
    working_directory: String?
    repository_root: String?
    branch_name: String?
    base_branch: String?
    attachments_finalized: Boolean
    initial_message_expanded: Boolean
    runtime_bootstrapped: Boolean
    first_llm_dispatched: Boolean
    failure_code: String?
}

------------------------------------------------------------
-- Actors and profile entities
------------------------------------------------------------

actor CreationRequester {}
actor CreationReducer {}
actor CreationEffectAdapter {}
actor CreationRuntime {}
actor CreationLifecycleManager {}
actor CreationResolutionOperator {}
actor CreationProtocolMirror {}
actor CreationProfileRegistry {}

entity CreationWorkflowBinding {
    conversation_id: String
    workflow: dwf/Workflow
    intent: CreationIntent
    profile_binding: CreationProfileBinding
    authority: CreationProtocolAuthority
    outcome: CreationOutcome
    conversation: bedrock/Conversation?
    repository_resolution: RepositoryResolution?
    reservation_effect: dwf/Effect?
    worktree_effect: dwf/Effect?
    readiness_barrier: dwf/Barrier
    accepted_at: Timestamp

    transitions outcome {
        provisioning -> ready
        provisioning -> cancelled
        provisioning -> deleted
        provisioning -> failed
        provisioning -> manual_resolution
        manual_resolution -> provisioning
        manual_resolution -> cancelled
        manual_resolution -> deleted
        terminal: ready, cancelled, deleted, failed
    }
}

entity PhysicalRepositoryLock {
    repository_root: String
    holder_effect: dwf/Effect
    holder_authority: dwf/ClaimAuthority
    acquired_at: Timestamp
    released_at: Timestamp?
}

entity CreationShadowParity {
    binding: CreationWorkflowBinding
    authoritative_conversation_id: String
    kind: CreationShadowComparisonKind
    expected: CreationProtocolProjection
    actual: CreationProtocolProjection
    compared_at: Timestamp
    equal: Boolean
}

config {
    claim_lease: Duration = 30_000.ms
    retry_delay_2: Duration = 2_000.ms
    retry_delay_3: Duration = 10_000.ms
    retry_delay_4: Duration = 30_000.ms
    max_attempts: Integer = 4
    repository_resolution_deadline: Duration = 30.seconds
    filesystem_effect_deadline: Duration = 120.seconds
    database_effect_deadline: Duration = 30.seconds
    runtime_bootstrap_deadline: Duration = 30.seconds
    first_dispatch_deadline: Duration = 30.seconds
    cancellation_deadline: Duration = 120.seconds
    deletion_deadline: Duration = 120.seconds
}

------------------------------------------------------------
-- Helpers
------------------------------------------------------------

-- Helpers are pure predicates/projections unless an ensure names a durable fact.
-- next_conversation_id(), creation_profile_ref(), creation_snapshot_codec()
-- creation_event_codec(), creation_effect_codec(), creation_profile_registered()
-- structurally_valid_intent(intent), normalized_intent(intent)
-- shell_for(intent), profile_binding_for(authority), initial_creation_plan(binding)
-- shell_intent_and_workflow_committed_atomically(binding)
-- acceptance_returned_after_commit(binding), effect_of(binding, kind)
-- dependency_exists(binding, successor_kind, predecessor_kind)
-- no_other_creation_dependencies(binding), required_effect(binding, kind)
-- effect_deadline(binding, kind), attempt_count(effect), retry_deadline(effect)
-- transient_failure(evidence), permanent_failure(evidence)
-- reconciliation_result(effect, observation), matching_owned_resource(effect, observation)
-- foreign_resource_evidence(effect, observation), indeterminate_evidence(effect, observation)
-- receipt_adopts_observed_resource(effect, observation), receipt_records_absence(effect, observation)
-- no_external_mutation_during_reconciliation(effect)
-- physical_repository_identity(binding), lock_covers_effect(lock, effect)
-- worktree_materialization_owned_by_intent(binding, observation)
-- conversation_projection_ready(binding), readiness_members(binding)
-- metadata_receipt_materializes_conversation(binding, receipt)
-- runtime_acceptance_committed_atomically(binding), first_dispatch_after_runtime_commit(binding)
-- cancellation_plan(binding), deletion_plan(binding), compensation_dag_complete(binding, plan)
-- compensation_targets_only_owned_resources(binding, plan)
-- compensation_dependency_exists(binding, successor_kind, predecessor_kind)
-- all_compensations_terminal(binding), cancellation_deadline(binding), deletion_deadline(binding)
-- legacy_projection(conversation_id), engine_projection(binding)
-- shadow_projection_has_no_external_effects(binding), parity_compared_for_every_authoritative_fact(binding)
-- protocol_authority_for_new_creation(), authority_is_immutable(binding)
-- no_authoritative_creation_work(profile), no_creation_acceptance_owed(profile)

------------------------------------------------------------
-- Acceptance and required effect schedule
------------------------------------------------------------

rule ShellFirstDurableAcceptance {
    when: ConversationCreationRequested(requester, raw_intent)
    requires: structurally_valid_intent(raw_intent)
    requires: creation_profile_registered()
    requires: protocol_authority_for_new_creation() = engine_creation

    let intent = normalized_intent(raw_intent)
    let profile_binding = profile_binding_for(engine_creation)
    let binding = CreationWorkflowBinding{conversation_id: intent.conversation_id}

    ensures: CreationWorkflowBinding.created(
        conversation_id: intent.conversation_id,
        intent: intent,
        profile_binding: profile_binding,
        authority: engine_creation,
        outcome: provisioning,
        accepted_at: now()
    )
    ensures: shell_for(intent)
    ensures: initial_creation_plan(binding)
    ensures: shell_intent_and_workflow_committed_atomically(binding)
    ensures: acceptance_returned_after_commit(binding)
    ensures: ConversationCreationAccepted(intent.conversation_id)

    @guidance
        -- The shell, normalized intent, typed profile binding, workflow snapshot,
        -- complete initial DAG, and readiness barrier commit in one transaction.
        -- No filesystem, Git, attachment, expansion, runtime, or LLM work starts
        -- before that commit. The accepted response identifies the durable shell.
}

rule InvalidIntentRejectedBeforeShell {
    when: ConversationCreationRequested(requester, raw_intent)
    requires: not structurally_valid_intent(raw_intent)
    ensures: ConversationCreationRejected("invalid_creation_intent")
    ensures: not CreationWorkflowBinding.created(conversation_id: raw_intent.conversation_id)
}

rule RequiredCreationDagDeclared {
    when: InitialCreationPlanEvaluated(reducer, binding)
    requires: binding.outcome = provisioning

    ensures: required_effect(binding, resolve_repository)
    ensures: required_effect(binding, reserve_worktree)
    ensures: required_effect(binding, materialize_or_adopt_worktree)
    ensures: required_effect(binding, finalize_attachments)
    ensures: required_effect(binding, commit_metadata)
    ensures: required_effect(binding, expand_initial_message)
    ensures: required_effect(binding, bootstrap_runtime)
    ensures: required_effect(binding, dispatch_first_llm)

    ensures: dependency_exists(binding, reserve_worktree, resolve_repository)
    ensures: dependency_exists(binding, materialize_or_adopt_worktree, reserve_worktree)
    ensures: dependency_exists(binding, finalize_attachments, resolve_repository)
    ensures: dependency_exists(binding, commit_metadata, materialize_or_adopt_worktree)
    ensures: dependency_exists(binding, commit_metadata, finalize_attachments)
    ensures: dependency_exists(binding, expand_initial_message, commit_metadata)
    ensures: dependency_exists(binding, bootstrap_runtime, expand_initial_message)
    ensures: dependency_exists(binding, dispatch_first_llm, bootstrap_runtime)
    ensures: no_other_creation_dependencies(binding)
    ensures: readiness_members(binding) = {
        resolve_repository, reserve_worktree, materialize_or_adopt_worktree,
        finalize_attachments, commit_metadata, expand_initial_message,
        bootstrap_runtime, dispatch_first_llm
    }
}

rule DirectCreationSkipsWorktreeByTypedReceipt {
    when: RepositoryResolutionAccepted(reducer, binding, receipt)
    requires: binding.intent.mode = direct
    ensures: receipt_records_absence(effect_of(binding, reserve_worktree), receipt)
    ensures: receipt_records_absence(effect_of(binding, materialize_or_adopt_worktree), receipt)
    ensures: not PhysicalRepositoryLock.created(holder_effect: effect_of(binding, materialize_or_adopt_worktree))
}

rule RepositoryResolutionPreservesProjectSemantics {
    when: RepositoryResolutionAccepted(reducer, binding, receipt)
    requires: binding.intent.mode in {managed, branch}
    ensures: binding.repository_resolution.kind = git
    ensures: binding.repository_resolution.canonical_working_directory != "/"
    ensures: binding.repository_resolution.repository_root != null
    ensures: binding.intent.mode = branch implies binding.intent.requested_branch != null
    ensures: RepositoryResolutionUsesProjectMainRefAndRequestedBase(binding)
}

rule WorktreeMaterializeOrAdoptRequiresPhysicalRepositoryLock {
    when: WorktreeMaterializeOrAdoptBegins(adapter, binding, effect, authority)
    requires: effect = effect_of(binding, materialize_or_adopt_worktree)
    requires: binding.intent.mode in {managed, branch}
    requires: effect.status = claimed
    requires: effect.generation = binding.workflow.generation
    requires: PhysicalRepositoryLock{holder_effect: effect}.released_at = null
    requires: lock_covers_effect(PhysicalRepositoryLock{holder_effect: effect}, effect)
    ensures: WorktreeReservationInspected(binding)
    ensures: WorktreeMaterializeOrMatchingAdoptAttempted(binding, authority)
}

rule RepositoryLockSerializesReservationAndMaterialization {
    when: PhysicalRepositoryLockRequested(adapter, binding, effect, authority)
    requires: effect.kind in {"reserve_worktree", "materialize_or_adopt_worktree"}
    requires: effect.generation = binding.workflow.generation
    requires: not exists PhysicalRepositoryLock{
        repository_root: physical_repository_identity(binding), released_at: null
    }
    ensures: PhysicalRepositoryLock.created(
        repository_root: physical_repository_identity(binding),
        holder_effect: effect, holder_authority: authority, acquired_at: now()
    )
}

rule MatchingWorktreeIsAdopted {
    when: WorktreeReconciliationObserved(adapter, binding, effect, observation)
    requires: reconciliation_result(effect, observation) = matching
    requires: worktree_materialization_owned_by_intent(binding, observation)
    ensures: receipt_adopts_observed_resource(effect, observation)
    ensures: NoSecondWorktreeCreated(binding)
}

------------------------------------------------------------
-- Evidence, ambiguity, retries, and deadlines
------------------------------------------------------------

rule EffectPolicyIsConcrete {
    when: CreationEffectPolicyEvaluated(binding, effect)
    requires: effect.workflow = binding.workflow
    ensures:
        if effect.kind in {"resolve_repository", "reserve_worktree", "materialize_or_adopt_worktree", "finalize_attachments"}:
            effect.ambiguity_policy = observable_reconciliation
        else if effect.kind in {"commit_metadata", "expand_initial_message", "bootstrap_runtime", "dispatch_first_llm"}:
            effect.ambiguity_policy = external_idempotency
}

rule InterruptedEffectObservesBeforeReplay {
    when: CreationEffectAuthorityReplaced(adapter, binding, effect, authority)
    requires: effect.status in {claimed, ambiguity_wait}
    ensures: CreationExternalStateObservationRequested(binding, effect)
    ensures: no_external_mutation_during_reconciliation(effect)
}

rule ObservationAdoptsMatchingResult {
    when: CreationEffectObservationInterpreted(adapter, binding, effect, observation)
    requires: reconciliation_result(effect, observation) = matching
    ensures: receipt_adopts_observed_resource(effect, observation)
}

rule ObservationPermitsAbsentResourceExecution {
    when: CreationEffectObservationInterpreted(adapter, binding, effect, observation)
    requires: reconciliation_result(effect, observation) = absent
    requires: effect.ambiguity_policy in {observable_reconciliation, external_idempotency, safe_repeatability}
    ensures: CreationEffectExecutionPermitted(effect)
}

rule ForeignResourceRequiresManualResolution {
    when: CreationEffectObservationInterpreted(adapter, binding, effect, observation)
    requires: reconciliation_result(effect, observation) = foreign
    ensures: ForeignResourceConflictRecorded(binding, effect, foreign_resource_evidence(effect, observation))
    ensures: CreationManualResolutionRequested(binding, effect, "foreign_resource")
    ensures: binding.outcome = manual_resolution
    ensures: not CreationEffectExecutionPermitted(effect)
    ensures: not ForeignResourceMutated(effect)
}

rule IndeterminateResourceRequiresManualResolution {
    when: CreationEffectObservationInterpreted(adapter, binding, effect, observation)
    requires: reconciliation_result(effect, observation) = indeterminate
    ensures: CreationManualResolutionRequested(binding, effect, "indeterminate_external_state")
    ensures: binding.outcome = manual_resolution
    ensures: not CreationEffectExecutionPermitted(effect)
}

rule TransientFailureUsesBoundedDurableRetry {
    when: CreationEffectFailed(adapter, binding, effect, evidence)
    requires: transient_failure(evidence)
    requires: attempt_count(effect) < config.max_attempts
    requires: now() < effect_deadline(binding, creation_effect_kind(effect))
    ensures: CreationRetryScheduled(effect, retry_deadline(effect))
    ensures: retry_deadline(effect) <= effect_deadline(binding, creation_effect_kind(effect))
}

rule RetryBudgetOrDeadlineFailsProvisioning {
    when: CreationEffectFailed(adapter, binding, effect, evidence)
    requires: transient_failure(evidence)
    requires: attempt_count(effect) >= config.max_attempts
        or now() >= effect_deadline(binding, creation_effect_kind(effect))
    ensures: binding.outcome = failed
    ensures: CreationFailureProjected(binding, "creation_retry_exhausted")
}

rule PermanentFailureFailsWithoutRetry {
    when: CreationEffectFailed(adapter, binding, effect, evidence)
    requires: permanent_failure(evidence)
    ensures: binding.outcome = failed
    ensures: CreationFailureProjected(binding, "creation_permanent_failure")
    ensures: not CreationRetryScheduled(effect, retry_deadline(effect))
}

------------------------------------------------------------
-- Product receipts and readiness
------------------------------------------------------------

rule MetadataReceiptMaterializesConversationAtomically {
    when: CreationMetadataReceiptAccepted(reducer, binding, receipt)
    requires: receipt.effect = effect_of(binding, commit_metadata)
    ensures: metadata_receipt_materializes_conversation(binding, receipt)
    ensures: binding.conversation != null
    ensures: binding.conversation.mode = creation_mode_projection(binding.intent.mode)
    ensures: ConversationMetadataMatchesIntentAndReceipts(binding)
}

rule RuntimeBootstrapFollowsExpandedMessage {
    when: RuntimeBootstrapReceiptAccepted(reducer, binding, receipt)
    requires: receipt.effect = effect_of(binding, bootstrap_runtime)
    ensures: runtime_acceptance_committed_atomically(binding)
    ensures: binding.conversation.core_status = idle
    ensures: InitialMessageAvailableToRuntime(binding)
}

rule FirstDispatchFollowsCommittedRuntimeBootstrap {
    when: FirstLlmDispatchReceiptAccepted(reducer, binding, receipt)
    requires: receipt.effect = effect_of(binding, dispatch_first_llm)
    ensures: first_dispatch_after_runtime_commit(binding)
    ensures: binding.conversation.core_status = llm_requesting
    ensures: LlmRequestDispatched(binding.conversation)
}

rule ReadinessBarrierPublishesReady {
    when: CreationReadinessBarrierSatisfied(reducer, binding)
    requires: binding.readiness_barrier.status = satisfied
    requires: conversation_projection_ready(binding)
    ensures: binding.outcome = ready
    ensures: ConversationCreationReady(binding.conversation_id)
}

rule ReadinessCannotPrecedeFirstDispatchReceipt {
    when: CreationReadinessEvaluated(reducer, binding)
    requires: effect_of(binding, dispatch_first_llm).status != receipted
    ensures: binding.readiness_barrier.status = waiting
    ensures: not ConversationCreationReady(binding.conversation_id)
}

------------------------------------------------------------
-- Cancellation, deletion, and compensation
------------------------------------------------------------

rule CancellationBumpsGenerationAndDeclaresCompensationDag {
    when: CreationCancellationRequested(manager, binding)
    requires: binding.outcome in {provisioning, manual_resolution}
    let plan = cancellation_plan(binding)
    ensures: CreationCancellationGenerationTransitionRequested(binding, plan)
    ensures: compensation_dag_complete(binding, plan)
    ensures: compensation_targets_only_owned_resources(binding, plan)
    ensures: compensation_dependency_exists(binding, remove_owned_worktree, remove_finalized_attachments)
    ensures: compensation_dependency_exists(binding, release_worktree_reservation, remove_owned_worktree)
    ensures: binding.outcome = cancelled when all_compensations_terminal(binding)
}

rule DeletionBumpsGenerationHidesShellAndDeclaresCompensationDag {
    when: CreationDeletionRequested(manager, binding)
    requires: binding.outcome in {provisioning, manual_resolution, cancelled, failed}
    let plan = deletion_plan(binding)
    ensures: CreationHiddenFromNormalSurfaces(binding.conversation_id)
    ensures: CreationDeletionGenerationTransitionRequested(binding, plan)
    ensures: compensation_dag_complete(binding, plan)
    ensures: compensation_targets_only_owned_resources(binding, plan)
    ensures: compensation_dependency_exists(binding, remove_owned_worktree, remove_finalized_attachments)
    ensures: compensation_dependency_exists(binding, remove_conversation_metadata, remove_owned_worktree)
    ensures: compensation_dependency_exists(binding, release_worktree_reservation, remove_conversation_metadata)
    ensures: binding.outcome = deleted when all_compensations_terminal(binding)
}

rule CompensationNeverDeletesForeignResource {
    when: CreationCompensationObservationInterpreted(adapter, binding, effect, observation)
    requires: reconciliation_result(effect, observation) in {foreign, indeterminate}
    ensures: CreationManualResolutionRequested(binding, effect, "compensation_ownership_conflict")
    ensures: not ForeignResourceMutated(effect)
}

rule CompensationDeadlineEscalatesWithoutFalseCompletion {
    when: CreationCompensationDeadlineReached(manager, binding, lifecycle_kind)
    requires: lifecycle_kind = "cancel" and now() >= cancellation_deadline(binding)
        or lifecycle_kind = "delete" and now() >= deletion_deadline(binding)
    requires: not all_compensations_terminal(binding)
    ensures: CreationCleanupRequiresManualResolution(binding)
    ensures: binding.outcome = manual_resolution
    ensures: not CreationTombstoneRemoved(binding)
}

------------------------------------------------------------
-- Shadow, protocol boundary, and drain
------------------------------------------------------------

rule LegacyAuthorityRemainsExclusive {
    when: LegacyCreationFactCommitted(mirror, conversation_id)
    requires: legacy_projection(conversation_id).authority = legacy_creation
    ensures: LegacyCreationProtocolActsAuthoritatively(conversation_id)
    ensures: EngineCreationProtocolDoesNotActAuthoritatively(conversation_id)
    ensures: authority_is_immutable(conversation_id)
}

rule EngineAuthorityRemainsExclusive {
    when: EngineCreationFactCommitted(mirror, binding)
    requires: binding.authority = engine_creation
    ensures: EngineCreationProtocolActsAuthoritatively(binding.conversation_id)
    ensures: LegacyCreationProtocolDoesNotActAuthoritatively(binding.conversation_id)
    ensures: authority_is_immutable(binding)
}

rule ShadowCreationProjectsParityWithoutExternalEffects {
    when: CreationShadowComparisonRequested(mirror, binding, authoritative_conversation_id, kind)
    requires: binding.authority = shadow_creation
    let expected = legacy_projection(authoritative_conversation_id)
    let actual = engine_projection(binding)
    ensures: CreationShadowParity.created(
        binding: binding,
        authoritative_conversation_id: authoritative_conversation_id,
        kind: kind,
        expected: expected,
        actual: actual,
        compared_at: now(),
        equal: expected = actual
    )
    ensures: shadow_projection_has_no_external_effects(binding)
}

rule ProtocolDrainStopsNewAcceptanceButPreservesExecutors {
    when: CreationProfileDrainRequested(registry, profile)
    ensures: CreationProfileStopsAcceptingNewWork(profile)
    ensures: CreationProfileRetainsExecutorAndCodecs(profile)
    ensures: CreationProfileRetirementPermitted(profile)
        when no_authoritative_creation_work(profile) and no_creation_acceptance_owed(profile)
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface CreationAcceptanceSurface {
    facing requester: CreationRequester
    provides:
        ConversationCreationRequested(requester, raw_intent)
}

surface CreationReducerSurface {
    facing reducer: CreationReducer
    context binding: CreationWorkflowBinding
    provides:
        InitialCreationPlanEvaluated(reducer, binding)
        RepositoryResolutionAccepted(reducer, binding, receipt)
        CreationMetadataReceiptAccepted(reducer, binding, receipt)
        RuntimeBootstrapReceiptAccepted(reducer, binding, receipt)
        FirstLlmDispatchReceiptAccepted(reducer, binding, receipt)
        CreationReadinessBarrierSatisfied(reducer, binding)
        CreationReadinessEvaluated(reducer, binding)
}

surface CreationEffectSurface {
    facing adapter: CreationEffectAdapter
    context binding: CreationWorkflowBinding
    provides:
        PhysicalRepositoryLockRequested(adapter, binding, effect, authority)
        WorktreeMaterializeOrAdoptBegins(adapter, binding, effect, authority)
        WorktreeReconciliationObserved(adapter, binding, effect, observation)
        CreationEffectPolicyEvaluated(binding, effect)
        CreationEffectAuthorityReplaced(adapter, binding, effect, authority)
        CreationEffectObservationInterpreted(adapter, binding, effect, observation)
        CreationEffectFailed(adapter, binding, effect, evidence)
        CreationCompensationObservationInterpreted(adapter, binding, effect, observation)
}

surface CreationLifecycleSurface {
    facing manager: CreationLifecycleManager
    context binding: CreationWorkflowBinding
    provides:
        CreationCancellationRequested(manager, binding)
        CreationDeletionRequested(manager, binding)
        CreationCompensationDeadlineReached(manager, binding, lifecycle_kind)
}

surface CreationProtocolSurface {
    facing mirror: CreationProtocolMirror
    provides:
        LegacyCreationFactCommitted(mirror, conversation_id)
        EngineCreationFactCommitted(mirror, binding)
        CreationShadowComparisonRequested(mirror, binding, authoritative_conversation_id, kind)
}

surface CreationProfileRegistrationSurface {
    facing registry: CreationProfileRegistry
    provides:
        CreationProfileDrainRequested(registry, profile)
}

------------------------------------------------------------
-- Profile invariants
------------------------------------------------------------

invariant AcceptanceIsShellFirstAndDurable {
    every_successful_creation_acceptance_commits_shell_typed_intent_profile_workflow_and_complete_plan_before_return
}

invariant IntentAndProfileBindingAreImmutable {
    every_creation_workflow_retains_one_losslessly_decodable_intent_and_one_profile_binding
}

invariant CreationDagIsExactAndAcyclic {
    every_creation_workflow_has_exactly_the_required_effects_dependencies_and_readiness_members
}

invariant RepositoryMutationUsesPhysicalLock {
    every_reservation_materialization_adoption_and_compensation_that_mutates_a_repository_holds_its_physical_repository_lock
}

invariant ForeignResourcesAreNeverAdoptedOrDestroyedAutomatically {
    every_foreign_or_indeterminate_resource_stops_its_dependency_path_for_manual_resolution
}

invariant RetriesAndClaimsAreBounded {
    every_creation_effect_has_at_most_config_max_attempts_and_no_attempt_begins_after_its_durable_deadline
}

invariant ReadyMeansFirstDispatchDurablyAccepted {
    every_ready_creation_has_all_required_receipts_a_satisfied_readiness_barrier_and_one_first_llm_dispatch
}

invariant LifecycleRevokesOldAuthorityBeforeCompensation {
    every_creation_cancel_or_delete_bumps_generation_before_any_compensation_claim
}

invariant CompensationTouchesOnlyOwnedResources {
    every_creation_compensation_is_observation_guarded_and_targets_only_resources_owned_by_the_same_intent
}

invariant OneCreationProtocolAuthority {
    every_creation_is_forever_owned_by_exactly_one_of_legacy_creation_or_engine_creation
}

invariant ShadowCreationHasNoExternalAuthority {
    every_shadow_creation_can_reduce_and_project_but_cannot_claim_execute_publish_dispatch_or_compensate
}

invariant ShadowParityCoversAuthoritativeFacts {
    parity_compared_for_every_authoritative_fact
}

invariant DrainPreservesAcceptedWork {
    creation_profile_retirement_requires_no_authoritative_work_and_no_owed_acceptance
}
