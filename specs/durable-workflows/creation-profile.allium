-- allium: 3
-- Engine-backed conversation-creation profile.
--
-- The durable-workflow core owns atomic plans, attempts, optional reclaimable
-- leases, evidence, receipts, barriers, deadlines, manual resolution, canonical
-- delivery, and schedule policy. This profile owns creation intent types, the
-- provisioning DAG, product adapters, reconciliation policy, compensation
-- meaning, and readiness publication.

use "./durable-workflows.allium" as dwf
use "../conversation-creation/conversation-creation.allium" as creation
use "../bedrock/bedrock.allium" as bedrock
use "../git-repository/git-repository.allium" as gitrep

surface FreshWorkConversationProvisioningRequestImport {
    facing conversation: bedrock/Conversation

    provides:
        FreshWorkConversationProvisioningRequestImported(
            source_conversation,
            target_conversation,
            target_product_conversation,
            source_work_scope_id
        )
            when bedrock/FreshWorkConversationProvisioningRequested(
                source_conversation,
                target_conversation,
                target_product_conversation,
                source_work_scope_id
            )

    @guarantee TypedProvisioningRequestBridge
        -- The creation profile consumes the exact Bedrock Start-new boundary and
        -- derives repository context through the named source WorkScope. It never
        -- copies repository identity onto ProductConversation.
}

------------------------------------------------------------
-- Types
------------------------------------------------------------

enum CreationVariant { seeded_empty | initial_turn }
enum CreationOriginKind { ordinary | approved_task }
enum CreationRejectReason { invalid_creation_intent | profile_unavailable }
enum CreationFailureReason { retry_exhausted | permanent_effect_failure }
enum CreationManualReason {
    foreign_resource
    | indeterminate_external_state
    | compensation_ownership_conflict
    | cleanup_deadline_exceeded
}
enum CreationLifecycleKind { cancel | delete }
enum RepositoryKind { non_git | git_resolved | git_identity_unresolved }
enum CanonicalDefaultOutcomeKind { resolved | unresolved | not_applicable }
enum CanonicalDefaultFreshness { current | stale_cached }
enum CreationEffectKind {
    resolve_repository | resolve_canonical_default | reserve_worktree
    | materialize_or_adopt_worktree | attach_work_scope
    | materialize_approved_artifact | finalize_attachments | commit_metadata
    | expand_initial_message | bootstrap_runtime | dispatch_first_llm
    | remove_owned_worktree | release_worktree_reservation
    | remove_finalized_attachments | remove_conversation_metadata
}
enum CreationOutcome { provisioning | ready | cancelled | deletion_pending | deleted | failed | manual_resolution }
enum ReconciliationResult { absent | matching | foreign | indeterminate }

value CreationWorkspace {
    requested_directory: String
}

value CreationStart {
    variant: CreationVariant
    initial_turn_origin: CreationOriginKind when variant = initial_turn
    initial_message: String when variant = initial_turn
    approved_task: bedrock/ApprovedTaskObjective when variant = initial_turn and initial_turn_origin = approved_task
    source_work_scope_id: String when variant = initial_turn and initial_turn_origin = approved_task
    attachments: List<String>
}

value CreationIntent {
    product_conversation_id: String
    transcript_conversation_id: String
    workspace: CreationWorkspace
    start: CreationStart
}

value RepositoryResolution {
    kind: RepositoryKind
    requested_directory: String
    canonical_working_directory: String
    repository_root: String when kind in {git_resolved, git_identity_unresolved}
    hidden_repository: gitrep/GitRepository when kind = git_resolved
    unresolved_reason: String when kind = git_identity_unresolved
}

value CanonicalDefaultOutcome {
    kind: CanonicalDefaultOutcomeKind
    commit_id: String when kind = resolved
    branch_name: String when kind = resolved
    freshness: CanonicalDefaultFreshness when kind = resolved
    unresolved_reason: String when kind = unresolved
}

value CreationAcceptanceReceipt {
    product_conversation_id: String
    transcript_conversation_id: String
    workflow_id: String
    idempotency_key: String
}

------------------------------------------------------------
-- Actors and profile entities
------------------------------------------------------------

actor CreationRequester {}
actor CreationReducer {}
actor CreationEffectAdapter {}
actor CreationRuntime {}
actor CreationLifecycleManager {}
actor CreationResolutionOperator {}

entity CreationAcceptanceRecord {
    product_conversation_id: String
    transcript_conversation_id: String
    accepted: Boolean
    reject_reason: CreationRejectReason? when accepted = false
    committed_at: Timestamp
}

entity CreationWorkflowBinding {
    product_conversation_id: String
    transcript_conversation_id: String
    workflow: dwf/Workflow
    intent: CreationIntent
    outcome: CreationOutcome
    conversation: bedrock/Conversation?
    repository_resolution: RepositoryResolution?
    canonical_default_outcome: CanonicalDefaultOutcome?
    readiness_barrier: dwf/Barrier
    accepted_at: Timestamp

    transitions outcome {
        provisioning -> ready
        provisioning -> cancelled
        provisioning -> deletion_pending
        provisioning -> deleted
        provisioning -> failed
        provisioning -> manual_resolution
        manual_resolution -> provisioning
        manual_resolution -> cancelled
        manual_resolution -> deletion_pending
        manual_resolution -> deleted
        cancelled -> deletion_pending
        failed -> deletion_pending
        deletion_pending -> deleted
        terminal: ready, cancelled, deleted, failed
    }
}

entity PhysicalRepositoryLock {
    repository: gitrep/GitRepository
    holder_effect: dwf/Effect
    acquired_at: Timestamp
    released_at: Timestamp?
}

config {
    retry_delay_2: Duration = 2_000.ms
    retry_delay_3: Duration = 10_000.ms
    retry_delay_4: Duration = 30_000.ms
    max_attempts: Integer = 4
    repository_resolution_deadline: Duration = 30.seconds
    filesystem_effect_deadline: Duration = 120.seconds
    database_effect_deadline: Duration = 30.seconds
    runtime_bootstrap_deadline: Duration = 30.seconds
    first_dispatch_deadline: Duration = 30.seconds
    cancellation_deadline: Duration = 120.seconds
    deletion_deadline: Duration = 120.seconds
}

------------------------------------------------------------
-- Helpers
------------------------------------------------------------

-- next_product_conversation_id(), next_transcript_conversation_id(), creation_profile_ref(), creation_snapshot_codec(), creation_event_codec(), creation_effect_codec()
-- creation_acceptance_scope(raw_intent), creation_acceptance_key(raw_intent), creation_request_fingerprint(raw_intent)
-- structurally_valid_intent(intent), normalized_intent(intent), creation_profile_accepting()
-- approved_task_creation_request(source_conversation, target_conversation, target_product_conversation, source_work_scope_id)
-- exact_source_repository_from_work_scope(source_work_scope_id): gitrep/GitRepository?
-- resolved_repository_kind(observation): RepositoryKind
-- hidden_repository_for_effect(effect): gitrep/GitRepository
-- shell_for(intent), initial_creation_plan(binding), creation_effect_kind(effect): CreationEffectKind
-- effect_is_declared(binding, kind), dependency_exists(binding, successor_kind, predecessor_kind)
-- no_effect_other_than(binding, kind), no_post_resolution_effects_declared(binding)
-- no_other_post_resolution_creation_dependencies(binding)
-- no_other_seeded_empty_post_resolution_dependencies(binding)
-- readiness_members(binding), readiness_requires_dispatch(binding)
-- repository_resolution_observation(effect, observation): RepositoryResolution
-- canonical_default_outcome(effect, observation): CanonicalDefaultOutcome
-- hidden_repository_identity_proven(observation), transient_failure(evidence), permanent_failure(evidence)
-- retry_deadline(effect), attempt_count(effect), reconciliation_result(effect, observation)
-- matching_owned_resource(effect, observation), foreign_resource_evidence(effect, observation), indeterminate_evidence(effect, observation)
-- metadata_receipt_materializes_conversation(binding, receipt), conversation_projection_ready(binding)
-- work_scope_attachment_receipt_matches_materialized_worktree(binding, receipt)
-- approved_artifact_receipt_matches_reviewed_source(binding, receipt)
-- runtime_bootstrap_committed(binding), first_dispatch_after_runtime_commit(binding)
-- cancellation_plan(binding), deletion_plan(binding), compensation_dag_complete(binding, plan)
-- compensation_targets_only_owned_resources(binding, plan), all_compensations_terminal(binding)
-- lifecycle_publication_precedes_cleanup_completion(binding, lifecycle_kind)
-- stale_creation_result(effect), preserve_cancel_or_delete_outcome(binding)
--
--   no_post_resolution_effects_declared(binding: CreationWorkflowBinding) -> Boolean
--       True iff unresolved Git identity leaves no canonical-default, reservation,
--       worktree, WorkScope, metadata, artifact, runtime, or dispatch effect declared.
--
--   repository_resolution_observation(
--       effect: dwf/Effect,
--       observation
--   ) -> RepositoryResolution
--       The exact typed repository-resolution observation committed by
--       resolve_repository: kind, requested directory, canonical working directory,
--       repository root for Git, and hidden repository when local identity is
--       proven. The binding stores this value atomically rather than reconstructing
--       fields from intent, path heuristics, or later reads.
--
--   no_effect_other_than(binding: CreationWorkflowBinding, kind: CreationEffectKind) -> Boolean
--       True iff kind is the sole declared effect in binding's current plan.
--
--   no_other_post_resolution_creation_dependencies(
--       binding: CreationWorkflowBinding
--   ) -> Boolean
--       True iff the post-resolution DAG contains only the dependencies declared by
--       ResolvedInitialTurnCreationDagDeclared; the already-receipted repository
--       resolution effect remains the root predecessor rather than being redeclared.
--
--   no_other_seeded_empty_post_resolution_dependencies(
--       binding: CreationWorkflowBinding
--   ) -> Boolean
--       True iff the seeded-empty post-resolution DAG contains only the metadata,
--       attachment, optional Git provisioning, and bootstrap dependencies declared
--       by ResolvedSeededEmptyCreationDagDeclared.
--
--   resolved_repository_kind(observation) -> RepositoryKind
--       The typed repository kind proven by the resolve_repository observation.
--       It never derives Git status from requested mode, branch input, or path
--       naming.
--
--   hidden_repository_for_effect(effect: dwf/Effect) -> gitrep/GitRepository
--       The exact proven hidden GitRepository from effect's CreationWorkflowBinding
--       repository resolution. Repository mutation cannot begin while that identity
--       is absent or unresolved; mutable repository-root paths never key the lock.

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule ShellFirstDurableAcceptance {
    when: ConversationCreationRequested(requester, raw_intent)
    requires: structurally_valid_intent(raw_intent)
    requires: creation_profile_accepting()
    requires: not dwf/ExternalAcceptanceBinding.exists(
        profile: creation_profile_ref(),
        authority_scope: creation_acceptance_scope(raw_intent),
        idempotency_key: creation_acceptance_key(raw_intent)
    )

    let intent = normalized_intent(raw_intent)
    let workflow_id = next_workflow_id()

    ensures: CreationWorkflowBinding.created(
        product_conversation_id: intent.product_conversation_id,
        transcript_conversation_id: intent.transcript_conversation_id,
        workflow: dwf/Workflow{id: workflow_id},
        intent: intent,
        outcome: provisioning,
        readiness_barrier: creation_readiness_barrier(workflow_id),
        accepted_at: now()
    )
    ensures: CreationAcceptanceRecord.created(
        product_conversation_id: intent.product_conversation_id,
        transcript_conversation_id: intent.transcript_conversation_id,
        accepted: true,
        committed_at: now()
    )
    ensures: dwf/ExternalAcceptanceBinding.created(
        profile: creation_profile_ref(),
        authority_scope: creation_acceptance_scope(raw_intent),
        idempotency_key: creation_acceptance_key(raw_intent),
        intent_fingerprint: creation_request_fingerprint(raw_intent),
        workflow_id: workflow_id,
        receipt: dwf/ExternalAcceptanceReceipt{
            idempotency_key: creation_acceptance_key(raw_intent),
            workflow_id: workflow_id,
            handle_codec: creation_receipt_codec(),
            handle_payload: creation_receipt_payload(intent.product_conversation_id, intent.transcript_conversation_id, workflow_id, creation_acceptance_key(raw_intent))
        },
        accepted_at: now()
    )
    ensures: shell_for(intent)
    ensures: initial_creation_plan(CreationWorkflowBinding{product_conversation_id: intent.product_conversation_id, transcript_conversation_id: intent.transcript_conversation_id})

    @guidance
        -- The visible conversation shell, creation intent, workflow, initial DAG,
        -- barriers, and stable external acceptance binding commit before any Git,
        -- filesystem, runtime, or provider effects begin.
}

rule ReplayCreationAcceptanceFromStableBinding {
    when: ConversationCreationRequested(requester, raw_intent)
    let binding = dwf/ExternalAcceptanceBinding{
        profile: creation_profile_ref(),
        authority_scope: creation_acceptance_scope(raw_intent),
        idempotency_key: creation_acceptance_key(raw_intent)
    }
    requires: dwf/ExternalAcceptanceBinding.exists(
        profile: creation_profile_ref(),
        authority_scope: creation_acceptance_scope(raw_intent),
        idempotency_key: creation_acceptance_key(raw_intent)
    )
    requires: binding.intent_fingerprint = creation_request_fingerprint(raw_intent)
    ensures: CreationProfileAcceptanceReplay(binding.receipt)
}

rule RejectConflictingCreationAcceptanceKey {
    when: ConversationCreationRequested(requester, raw_intent)
    let binding = dwf/ExternalAcceptanceBinding{
        profile: creation_profile_ref(),
        authority_scope: creation_acceptance_scope(raw_intent),
        idempotency_key: creation_acceptance_key(raw_intent)
    }
    requires: dwf/ExternalAcceptanceBinding.exists(
        profile: creation_profile_ref(),
        authority_scope: creation_acceptance_scope(raw_intent),
        idempotency_key: creation_acceptance_key(raw_intent)
    )
    requires: binding.intent_fingerprint != creation_request_fingerprint(raw_intent)
    ensures: CreationProfileAcceptanceConflict(creation_acceptance_key(raw_intent))
}

rule InvalidIntentRejectedBeforeShell {
    when: ConversationCreationRequested(requester, raw_intent)
    requires: not structurally_valid_intent(raw_intent)
    ensures: CreationAcceptanceRecord.created(
        product_conversation_id: malformed_product_conversation_id(raw_intent),
        transcript_conversation_id: malformed_transcript_conversation_id(raw_intent),
        accepted: false,
        reject_reason: invalid_creation_intent,
        committed_at: now()
    )
    ensures: CreationProfileAcceptanceRejected(invalid_creation_intent)
}

rule UnavailableProfileRejectedBeforeShell {
    when: ConversationCreationRequested(requester, raw_intent)
    requires: structurally_valid_intent(raw_intent)
    requires: not creation_profile_accepting()
    ensures: CreationProfileAcceptanceRejected(profile_unavailable)
}

rule ApprovedStartNewUsesOrdinaryDurableCreation {
    when: FreshWorkConversationProvisioningRequestImported(source_conversation, target_conversation, target_product_conversation, source_work_scope_id)
    requires: exact_source_repository_from_work_scope(source_work_scope_id) != absent
    let raw_intent = approved_task_creation_request(source_conversation, target_conversation, target_product_conversation, source_work_scope_id)
    ensures: ConversationCreationRequested(CreationRequester, raw_intent)

    @guidance
        -- Start-new reuses shell-first durable creation with the target identities
        -- allocated by Bedrock. Repository context is resolved from the exact source
        -- WorkScope ID and remains pre-scope evidence until successful worktree
        -- materialization creates a fresh target WorkScope attachment.
}

rule InitialCreationPlanDeclaresRepositoryResolutionFirst {
    when: InitialCreationPlanEvaluated(reducer, binding)
    requires: binding.outcome = provisioning
    ensures: effect_is_declared(binding, resolve_repository)
    ensures: no_effect_other_than(binding, resolve_repository)

    @guidance
        -- Repository kind is not available at shell acceptance. The first durable
        -- plan contains only resolution; its committed typed observation drives the
        -- second plan without guessing Git behavior from request mode or path.
}

rule ApprovedTaskNonGitResolutionPublishesTypedFailure {
    when: RepositoryObservationRecorded(adapter, effect, observation)
    let binding = CreationWorkflowBinding{workflow: effect.workflow}
    requires: creation_effect_kind(effect) = resolve_repository
    requires: binding.outcome = provisioning
    requires: binding.intent.start.variant = initial_turn
    requires: binding.intent.start.initial_turn_origin = approved_task
    requires: resolved_repository_kind(observation) = non_git
    ensures: binding.repository_resolution = repository_resolution_observation(effect, observation)
    ensures: CreationFailurePublished(effect.workflow.id, permanent_effect_failure)
    ensures: not WorkScopeAttachmentCreated(binding)
    ensures: no_post_resolution_effects_declared(binding)
}

rule ResolvedInitialTurnCreationDagDeclared {
    when: RepositoryObservationRecorded(adapter, effect, observation)
    let binding = CreationWorkflowBinding{workflow: effect.workflow}
    requires: creation_effect_kind(effect) = resolve_repository
    requires: binding.outcome = provisioning
    requires: binding.intent.start.variant = initial_turn
    requires: resolved_repository_kind(observation) in {non_git, git_resolved}
    requires:
        binding.intent.start.initial_turn_origin = ordinary
        or resolved_repository_kind(observation) = git_resolved

    ensures: effect_is_declared(binding, finalize_attachments)
    ensures: effect_is_declared(binding, commit_metadata)
    ensures: effect_is_declared(binding, expand_initial_message)
    ensures: effect_is_declared(binding, bootstrap_runtime)
    ensures: effect_is_declared(binding, dispatch_first_llm)
    ensures: resolved_repository_kind(observation) = git_resolved implies effect_is_declared(binding, resolve_canonical_default)
    ensures: resolved_repository_kind(observation) = git_resolved implies effect_is_declared(binding, reserve_worktree)
    ensures: resolved_repository_kind(observation) = git_resolved implies effect_is_declared(binding, materialize_or_adopt_worktree)
    ensures: resolved_repository_kind(observation) = git_resolved implies effect_is_declared(binding, attach_work_scope)
    ensures: binding.intent.start.initial_turn_origin = approved_task implies effect_is_declared(binding, materialize_approved_artifact)
    ensures: dependency_exists(binding, finalize_attachments, resolve_repository)
    ensures: resolved_repository_kind(observation) = git_resolved implies dependency_exists(binding, resolve_canonical_default, resolve_repository)
    ensures: resolved_repository_kind(observation) = git_resolved implies dependency_exists(binding, reserve_worktree, resolve_canonical_default)
    ensures: resolved_repository_kind(observation) = git_resolved implies dependency_exists(binding, materialize_or_adopt_worktree, reserve_worktree)
    ensures: resolved_repository_kind(observation) = git_resolved implies dependency_exists(binding, attach_work_scope, materialize_or_adopt_worktree)
    ensures: resolved_repository_kind(observation) = git_resolved implies dependency_exists(binding, commit_metadata, attach_work_scope)
    ensures: resolved_repository_kind(observation) = non_git implies dependency_exists(binding, commit_metadata, resolve_repository)
    ensures: binding.intent.start.initial_turn_origin = approved_task implies dependency_exists(binding, materialize_approved_artifact, attach_work_scope)
    ensures: binding.intent.start.initial_turn_origin = approved_task implies dependency_exists(binding, materialize_approved_artifact, commit_metadata)
    ensures: binding.intent.start.initial_turn_origin = approved_task implies dependency_exists(binding, expand_initial_message, materialize_approved_artifact)
    ensures: binding.intent.start.initial_turn_origin = ordinary implies dependency_exists(binding, expand_initial_message, commit_metadata)
    ensures: dependency_exists(binding, commit_metadata, finalize_attachments)
    ensures: dependency_exists(binding, bootstrap_runtime, expand_initial_message)
    ensures: dependency_exists(binding, dispatch_first_llm, bootstrap_runtime)
    ensures: no_other_post_resolution_creation_dependencies(binding)
    ensures: readiness_members(binding) = workflow_effect_set(binding)
}

rule ResolvedSeededEmptyCreationDagDeclared {
    when: RepositoryObservationRecorded(adapter, effect, observation)
    let binding = CreationWorkflowBinding{workflow: effect.workflow}
    requires: creation_effect_kind(effect) = resolve_repository
    requires: binding.outcome = provisioning
    requires: binding.intent.start.variant = seeded_empty
    requires: resolved_repository_kind(observation) in {non_git, git_resolved}

    ensures: effect_is_declared(binding, finalize_attachments)
    ensures: effect_is_declared(binding, commit_metadata)
    ensures: effect_is_declared(binding, bootstrap_runtime)
    ensures: not effect_is_declared(binding, expand_initial_message)
    ensures: not effect_is_declared(binding, dispatch_first_llm)
    ensures: resolved_repository_kind(observation) = git_resolved implies effect_is_declared(binding, resolve_canonical_default)
    ensures: resolved_repository_kind(observation) = git_resolved implies effect_is_declared(binding, reserve_worktree)
    ensures: resolved_repository_kind(observation) = git_resolved implies effect_is_declared(binding, materialize_or_adopt_worktree)
    ensures: resolved_repository_kind(observation) = git_resolved implies effect_is_declared(binding, attach_work_scope)
    ensures: dependency_exists(binding, finalize_attachments, resolve_repository)
    ensures: resolved_repository_kind(observation) = git_resolved implies dependency_exists(binding, resolve_canonical_default, resolve_repository)
    ensures: resolved_repository_kind(observation) = git_resolved implies dependency_exists(binding, reserve_worktree, resolve_canonical_default)
    ensures: resolved_repository_kind(observation) = git_resolved implies dependency_exists(binding, materialize_or_adopt_worktree, reserve_worktree)
    ensures: resolved_repository_kind(observation) = git_resolved implies dependency_exists(binding, attach_work_scope, materialize_or_adopt_worktree)
    ensures: resolved_repository_kind(observation) = git_resolved implies dependency_exists(binding, commit_metadata, attach_work_scope)
    ensures: resolved_repository_kind(observation) = non_git implies dependency_exists(binding, commit_metadata, resolve_repository)
    ensures: dependency_exists(binding, commit_metadata, finalize_attachments)
    ensures: dependency_exists(binding, bootstrap_runtime, commit_metadata)
    ensures: no_other_seeded_empty_post_resolution_dependencies(binding)
    ensures: readiness_members(binding) = workflow_effect_set(binding)
    ensures: readiness_requires_dispatch(binding) = false
}

rule UnresolvedGitRepositoryIdentityPublishesTypedFailure {
    when: RepositoryObservationRecorded(adapter, effect, observation)
    let binding = CreationWorkflowBinding{workflow: effect.workflow}
    requires: creation_effect_kind(effect) = resolve_repository
    requires: resolved_repository_kind(observation) = git_identity_unresolved
    ensures: binding.repository_resolution = repository_resolution_observation(effect, observation)
    ensures: CreationFailurePublished(effect.workflow.id, permanent_effect_failure)
    ensures: not WorkScopeAttachmentCreated(binding)
    ensures: no_post_resolution_effects_declared(binding)
}

rule RepositoryResolutionPersistsTypedPreScopeOutcome {
    when: RepositoryObservationRecorded(adapter, effect, observation)
    let binding = CreationWorkflowBinding{workflow: effect.workflow}
    requires: creation_effect_kind(effect) = resolve_repository
    ensures: binding.repository_resolution = repository_resolution_observation(effect, observation)

    @guidance
        -- Git detection yields either git_resolved with an exact hidden identity or
        -- git_identity_unresolved with a typed reason before any WorkScope exists.
        -- Unresolved identity never fabricates a row or copies repository identity
        -- onto ProductConversation.
}

rule CanonicalDefaultResolutionIsTypedAndGatesWorktreeMaterialization {
    when: RepositoryObservationRecorded(adapter, effect, observation)
    let binding = CreationWorkflowBinding{workflow: effect.workflow}
    requires: creation_effect_kind(effect) = resolve_canonical_default
    ensures: binding.canonical_default_outcome = canonical_default_outcome(effect, observation)
    ensures: binding.canonical_default_outcome.kind = resolved implies WorktreeMaterializationEligible(binding)
    ensures: binding.canonical_default_outcome.kind = unresolved implies CreationFailurePublished(effect.workflow.id, permanent_effect_failure)
    ensures: binding.canonical_default_outcome.kind = unresolved implies not WorkScopeAttachmentCreated(binding)

    @guidance
        -- Canonical-default resolution yields resolved(commit, branch, freshness)
        -- or unresolved(error). Only resolved evidence may materialize a worktree;
        -- unresolved failure remains bound to the shell and creates no WorkScope.
}

rule SuccessfulWorktreeMaterializationPrecedesFreshScopeAttachment {
    when: MetadataEffectReceipted(adapter, binding, receipt)
    requires: creation_effect_kind(receipt.effect) = attach_work_scope
    requires: binding.repository_resolution.kind = git_resolved
    requires: binding.canonical_default_outcome.kind = resolved
    requires: work_scope_attachment_receipt_matches_materialized_worktree(binding, receipt)
    ensures: FreshWorkScopeAttached(binding.product_conversation_id, binding.transcript_conversation_id, binding.repository_resolution.hidden_repository)

    @guidance
        -- The target WorkScope is fresh and attached only after the disposable
        -- worktree's exact starting commit exists and local identity has proven the
        -- hidden GitRepository. Unresolved repository identity never fabricates a
        -- repository or scope attachment.
}

rule DirectCreationHasNoGitScopeOrCanonicalDefault {
    when: MetadataEffectReceipted(adapter, binding, receipt)
    requires: binding.repository_resolution.kind = non_git
    ensures: binding.canonical_default_outcome = CanonicalDefaultOutcome{kind: not_applicable}
    ensures: not WorkScopeAttachmentCreated(binding)
}

rule ApprovedArtifactMaterializesBeforeFirstDispatch {
    when: MetadataEffectReceipted(adapter, binding, receipt)
    requires: creation_effect_kind(receipt.effect) = materialize_approved_artifact
    requires: binding.intent.start.initial_turn_origin = approved_task
    requires: approved_artifact_receipt_matches_reviewed_source(binding, receipt)
    ensures: ApprovedArtifactMaterialized(binding.intent.start.approved_task, binding.transcript_conversation_id)
}

rule WorktreeReconciliationInspectsBeforeReplay {
    when: RepositoryObservationRecorded(adapter, effect, observation)
    requires: creation_effect_kind(effect) = materialize_or_adopt_worktree
    ensures: reconciliation_result(effect, observation) in {absent, matching, foreign, indeterminate}
    ensures: matching_owned_resource(effect, observation) implies dwf/Receipt.created(effect: effect)
    ensures: foreign_resource_evidence(effect, observation) or indeterminate_evidence(effect, observation)
        implies dwf/ManualResolution.created(effect: effect)

    @guidance
        -- Creation never blindly replays ambiguous worktree mutation. It inspects
        -- existing state and either adopts, repairs, compensates, or enters manual
        -- resolution.
}

rule RepositoryMutationUsesPhysicalLock {
    when: CreationEffectStarted(adapter, effect)
    requires: creation_effect_kind(effect) in {reserve_worktree, materialize_or_adopt_worktree, remove_owned_worktree}
    requires: no_active_physical_repository_lock(hidden_repository_for_effect(effect))
    ensures: PhysicalRepositoryLock.created(
        repository: hidden_repository_for_effect(effect),
        holder_effect: effect,
        acquired_at: now(),
        released_at: null
    )
}

rule RepositoryMutationWaitsForExistingPhysicalLock {
    when: CreationEffectStarted(adapter, effect)
    requires: creation_effect_kind(effect) in {reserve_worktree, materialize_or_adopt_worktree, remove_owned_worktree}
    requires: active_physical_repository_lock(hidden_repository_for_effect(effect))
    ensures: dwf/Effect{id: effect.id}.status = retry_wait
    ensures: not PhysicalRepositoryLock.created(holder_effect: effect)
}

rule RepositoryMutationReleasesPhysicalLock {
    when: CreationEvidenceRecorded(adapter, effect, evidence)
    requires: creation_effect_kind(effect) in {reserve_worktree, materialize_or_adopt_worktree, remove_owned_worktree}
    requires: PhysicalRepositoryLock{holder_effect: effect}.released_at = null
    requires: effect_attempt_finished(effect, evidence)
    ensures: PhysicalRepositoryLock{holder_effect: effect}.released_at = now()
}

rule RepositoryMutationCancellationReleasesPhysicalLock {
    when: CreationLifecycleRequested(manager, binding, request)
    requires: request in {cancel, delete}
    ensures: release_active_physical_repository_locks(binding.workflow)
}

invariant OneActivePhysicalLockPerRepository {
    -- Atomic acquisition permits at most one unreleased lock row for each hidden
    -- repository identity. Contending effects remain in retry_wait until release.
    true
}

rule TransientCreationFailureRetriesWithDurableDeadline {
    when: CreationEvidenceRecorded(adapter, effect, evidence)
    requires: transient_failure(evidence)
    requires: attempt_count(effect) < config.max_attempts
    ensures: dwf/Effect{id: effect.id}.status = retry_wait
    ensures: dwf/Effect{id: effect.id}.next_eligible_at = retry_deadline(effect)
}

rule PermanentCreationFailureProducesTypedReceipt {
    when: CreationEvidenceRecorded(adapter, effect, evidence)
    requires: permanent_failure(evidence)
    ensures: dwf/Receipt.created(effect: effect)
    ensures: CreationFailurePublished(effect.workflow.id, permanent_effect_failure)
}

rule MetadataReceiptMaterializesConversationShellState {
    when: MetadataEffectReceipted(adapter, binding, receipt)
    requires: metadata_receipt_materializes_conversation(binding, receipt)
    ensures: binding.conversation != null
}

rule InitialTurnReadinessRequiresDispatchReceipt {
    when: ReadinessBarrierEvaluated(reducer, binding)
    requires: binding.intent.start.variant = initial_turn
    requires: readiness_requires_dispatch(binding)
    ensures: conversation_projection_ready(binding) implies dispatch_receipt_present(binding)
}

rule InitialTurnReadinessPublishesReady {
    when: ReadinessBarrierEvaluated(reducer, binding)
    requires: binding.intent.start.variant = initial_turn
    requires: all_required_effects_receipted(binding)
    requires: conversation_projection_materialized(binding)
    requires: dispatch_receipt_present(binding)
    ensures: binding.outcome = ready
    ensures: conversation_projection_ready(binding)
}

rule SeededEmptyReadinessOmitsDispatchRequirement {
    when: ReadinessBarrierEvaluated(reducer, binding)
    requires: binding.intent.start.variant = seeded_empty
    ensures: conversation_projection_ready(binding) implies not readiness_requires_dispatch(binding)
}

rule SeededEmptyReadinessPublishesReady {
    when: ReadinessBarrierEvaluated(reducer, binding)
    requires: binding.intent.start.variant = seeded_empty
    requires: all_required_effects_receipted(binding)
    requires: conversation_projection_materialized(binding)
    ensures: binding.outcome = ready
    ensures: conversation_projection_ready(binding)
    ensures: not readiness_requires_dispatch(binding)
}

rule RuntimeBootstrapPrecedesFirstDispatch {
    when: DispatchFirstTurnRequested(runtime, binding)
    requires: binding.intent.start.variant = initial_turn
    ensures: runtime_bootstrap_committed(binding)
    ensures: first_dispatch_after_runtime_commit(binding)
}

rule CancellationPublishesBeforeCleanupCompletes {
    when: CreationLifecycleRequested(manager, binding, cancel)
    let plan = cancellation_plan(binding)
    ensures: lifecycle_publication_precedes_cleanup_completion(binding, cancel)
    ensures: compensation_dag_complete(binding, plan)
    ensures: compensation_targets_only_owned_resources(binding, plan)
}

rule DeletionPublishesTombstoneBeforeCleanupCompletes {
    when: CreationLifecycleRequested(manager, binding, delete)
    let plan = deletion_plan(binding)
    ensures: lifecycle_publication_precedes_cleanup_completion(binding, delete)
    ensures: compensation_dag_complete(binding, plan)
    ensures: compensation_targets_only_owned_resources(binding, plan)
}

rule StaleCreationResultsCannotOverwriteLaterLifecycleOutcome {
    when: StaleCreationResultArrived(adapter, effect)
    requires: stale_creation_result(effect)
    ensures: preserve_cancel_or_delete_outcome(effect.workflow)
}


-- PhysicalRepositoryLock acquisition is an atomic compare-and-create operation
-- keyed by the hidden repository identity. Release is terminal for that lock row;
-- retries acquire a new row only after no active lock remains.
-- release_active_physical_repository_locks(workflow)
-- all_required_effects_receipted(binding)
-- conversation_projection_materialized(binding)
