-- allium: 3
-- Engine-backed wake profile over the durable workflow core.
--
-- Core owns attempts, optional reclaimable leases, evidence, receipts,
-- canonical delivery, runtime-acceptance bookkeeping, and scheduling. This
-- profile owns wake-domain identities, reducer mapping, lifecycle fences,
-- continuation transfer, and terminal interpretation.

use "./durable-workflows.allium" as dwf
use "../wake-contracts/wake-contracts.allium" as wake
use "../bedrock/bedrock.allium" as bedrock
use "../bash/bash.allium" as bash
use "../tmux-integration/tmux-integration.allium" as tmux

------------------------------------------------------------
-- Types
------------------------------------------------------------

enum WakeHandleKind { bash | tmux_window | subagent }
enum WakeTerminalCause { fired | expired | cancelled | forgotten }
enum WakeCancellationReason { explicit_cancel }
enum WakeForgottenReason {
    phoenix_restart
    | cascade_destroyed_handle
    | subagent_handle_missing
    | tmux_handle_missing
}
enum BashTerminalStatus { exited | killed | kill_pending_kernel }
enum TmuxTerminalStatus { exit_marker_observed | window_killed }
enum SubagentTerminalStatus {
    submit_result
    | submit_error
    | wall_clock_timeout
    | independently_observed_cancellation
    | turn_limit_hard_stop
    | implicit_text_completion
    | runtime_failure
    | context_exhausted
}
enum WakeRegistrationFenceStatus { open | closed }
enum LifecycleFenceStatus { open | closed }

value WorkScopeIdentity {
    kind: bash/WorkScopeKind
    stable_key: String
}

value BashResourceIdentity {
    work_scope: WorkScopeIdentity
    handle_id: String
}

value TmuxResourceIdentity {
    work_scope: WorkScopeIdentity
    server_generation: String
    window_id: String
}

value SubagentResourceIdentity {
    child_conversation_id: String
}

value WakeResourceIdentity {
    kind: WakeHandleKind
    bash: BashResourceIdentity? when kind = bash
    tmux_window: TmuxResourceIdentity? when kind = tmux_window
    subagent: SubagentResourceIdentity? when kind = subagent
}

value WakeRegistrationIntent {
    contract_id: String
    conversation_id: String
    registration_scope: WorkScopeIdentity
    resource: WakeResourceIdentity
    registering_tool_use_id: String
    registered_at: Timestamp
    expires_at: Timestamp
}

value WakeRegistrationReceipt {
    contract_id: String
    resource: WakeResourceIdentity
    expires_at: Timestamp
    registering_tool_use_id: String
}

value BashTerminalEvidence {
    status: BashTerminalStatus
    occurred_at: Timestamp
    exit_code: Integer?
    duration_ms: Integer?
    signal_number: Integer?
    kill_signal_sent: bash/KillSignal?
    final_tail: List<bash/RingLine>
}

value TmuxTerminalEvidence {
    status: TmuxTerminalStatus
    occurred_at: Timestamp
    server_generation: String
    exit_code: Integer?
    duration_ms: Integer?
    final_tail: List<String>
}

value SubagentTerminalEvidence {
    occurred_at: Timestamp
    child_conversation_id: String
    status: SubagentTerminalStatus
    success_text: String? when status in {submit_result, implicit_text_completion}
    error_text: String? when status = submit_error
    error_kind: String? when status in {submit_error, runtime_failure}
    persisted_child_terminal_record: String
}

value WakeTerminalEvidence {
    kind: WakeHandleKind
    bash: BashTerminalEvidence? when kind = bash
    tmux_window: TmuxTerminalEvidence? when kind = tmux_window
    subagent: SubagentTerminalEvidence? when kind = subagent
}

value WakeTerminalPayload {
    contract_id: String
    cause: WakeTerminalCause
    evidence: WakeTerminalEvidence? when cause = fired
    cancellation_reason: WakeCancellationReason? when cause = cancelled
    forgotten_reason: WakeForgottenReason? when cause = forgotten
    resolved_at: Timestamp
}

value WakeBatchItem {
    delivery_item_id: String
    contract_id: String
    terminal: WakeTerminalPayload
    committed_at: Timestamp
}

value WakeAcceptancePayload {
    conversation_id: String
    snapshot_upper_bound: Integer
    items: List<WakeBatchItem>
}

------------------------------------------------------------
-- Actors and profile-owned entities
------------------------------------------------------------

actor WakeAgent { identified_by: bedrock/Conversation }
actor WakeEffectAdapter {}
actor WakeReducer {}
actor WakeRuntime { identified_by: bedrock/Conversation }
actor WakeContinuationManager {}
actor WakeLifecycleManager {}

entity WakeConversationRegistrationFence {
    conversation: bedrock/Conversation
    status: WakeRegistrationFenceStatus
    version: Integer

    transitions status {
        open -> closed
        closed -> open
    }
}

entity WakeWorkflowBinding {
    contract_id: String
    workflow: dwf/Workflow
    conversation: bedrock/Conversation
    registration_scope: WorkScopeIdentity
    resource: WakeResourceIdentity
    expires_at: Timestamp
    registration_fence_version: Integer
    observe_effect: dwf/Effect
    lifecycle_fence: LifecycleFenceStatus

    transitions lifecycle_fence {
        open -> closed
        terminal: closed
    }
}

entity WakeRuntimeBatch {
    conversation: bedrock/Conversation
    snapshot_upper_bound: Integer
    created_at: Timestamp
}

config {
    default_max_wait_seconds: Integer = 600
    max_max_wait_seconds: Integer = 1800
    max_acceptance_batch_items: Integer = 64
}

------------------------------------------------------------
-- Helpers
------------------------------------------------------------

-- next_contract_id(), wake_profile_ref(), wake_snapshot_codec(), wake_event_codec(), wake_effect_codec()
-- resolve_work_scope(conversation), stable_scope_identity(scope), resource_is_owned_in_scope(resource, scope)
-- resource_identity_is_stable(resource), active_registration_fence(conversation), registration_fence_version(conversation)
-- conversation_is_terminal_or_archived(conversation), invalid_wait_bound(seconds), invalid_wait_bound_reason(seconds)
-- observe_effect_for(intent), wake_registration_plan(intent, effect), workflow_and_effect_created_atomically(binding)
-- evidence_matches_resource(evidence, resource), evidence_occurrence_time(evidence), durable_terminal_evidence_at_or_before(binding, deadline)
-- fired_terminal_payload(binding, evidence), expired_terminal_payload(binding), forgotten_terminal_payload(binding)
-- startup_forget_payload(binding), exact_terminal_receipt(binding, payload), canonical_delivery_for(receipt)
-- runtime_acceptance_item(delivery_item), duplicate_delivery_reuses_existing_item(receipt)
-- idle_conversation(conversation), busy_conversation(conversation), committed_order_items(conversation, upper_bound)
-- bounded_prefix(items, maximum), later_items_preserved(conversation, upper_bound)
-- no_overlapping_llm_request(conversation), batch_payload(conversation, items, upper_bound)
-- cancellation_terminal_payload(binding), lifecycle_action_is_destructive(action)
-- transferable_bindings(predecessor), transferable_delivery_items(predecessor), transferable_runtime_batches(predecessor)
-- successor_safe_delivery_identity(item, successor), transfer_is_atomic(predecessor, successor)
-- predecessor_history_unchanged(predecessor), registering_conversation_owns_child(conversation, resource)
-- subagent_resource_matches_child_conversation(resource), terminal_receipt_already_exists(binding)

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule RegistrationCreatesDurableWakeWorkflowBeforeReceipt {
    when: WakeRegistrationRequested(agent, conversation, resource, requested_max_wait_seconds, tool_use_id)
    requires: not invalid_wait_bound(requested_max_wait_seconds)
    requires: resource.kind in {bash, tmux_window} implies resource_is_owned_in_scope(resource, resolve_work_scope(conversation))
    requires: resource.kind = subagent implies subagent_resource_matches_child_conversation(resource)
    requires: resource.kind = subagent implies registering_conversation_owns_child(conversation, resource)
    requires: resource_identity_is_stable(resource)
    requires: active_registration_fence(conversation)
    requires: not conversation_is_terminal_or_archived(conversation)

    let contract_id = next_contract_id()
    let scope = stable_scope_identity(resolve_work_scope(conversation))
    let fence_version = registration_fence_version(conversation)
    let expires_at = now() + requested_max_wait_seconds
    let intent = WakeRegistrationIntent{
        contract_id: contract_id,
        conversation_id: conversation.id,
        registration_scope: scope,
        resource: resource,
        registering_tool_use_id: tool_use_id,
        registered_at: now(),
        expires_at: expires_at
    }
    let effect = observe_effect_for(intent)

    ensures: effect.capability_class = ReclaimableObservation
    ensures: WakeWorkflowBinding.created(
        contract_id: contract_id,
        workflow: wake_workflow_for(conversation),
        conversation: conversation,
        registration_scope: scope,
        resource: resource,
        expires_at: expires_at,
        registration_fence_version: fence_version,
        observe_effect: effect,
        lifecycle_fence: open
    )
    ensures: wake_registration_plan(intent, effect)
    ensures: workflow_and_effect_created_atomically(WakeWorkflowBinding{contract_id: contract_id})
    ensures: WakeRegistrationSucceeded(WakeRegistrationReceipt{
        contract_id: contract_id,
        resource: resource,
        expires_at: expires_at,
        registering_tool_use_id: tool_use_id
    })

    @guidance
        -- Registration returns only after the wake workflow, its observation
        -- effect, and the contract binding are durable.
}

rule RegistrationUsesDefaultWaitBound {
    when: WakeRegistrationRequested(agent, conversation, resource, omitted, tool_use_id)
    ensures: WakeRegistrationRequested(agent, conversation, resource, config.default_max_wait_seconds, tool_use_id)
}

rule RegistrationRejectsUnavailableOrUnauthorizedResource {
    when: WakeRegistrationRequested(agent, conversation, resource, requested_max_wait_seconds, tool_use_id)
    requires: invalid_wait_bound(requested_max_wait_seconds)
        or not resource_identity_is_stable(resource)
        or resource.kind in {bash, tmux_window} and not resource_is_owned_in_scope(resource, resolve_work_scope(conversation))
        or resource.kind = subagent and (
            not subagent_resource_matches_child_conversation(resource)
            or not registering_conversation_owns_child(conversation, resource)
        )
        or not active_registration_fence(conversation)
        or conversation_is_terminal_or_archived(conversation)
    ensures: WakeRegistrationRejected("wake_unavailable")
}

rule RegistrationRejectsOutOfRangeWaitBound {
    when: WakeRegistrationRequested(agent, conversation, resource, requested_max_wait_seconds, tool_use_id)
    requires: invalid_wait_bound(requested_max_wait_seconds)
    ensures: WakeRegistrationRejected(invalid_wait_bound_reason(requested_max_wait_seconds))
}

rule TerminalEvidenceBeforeDeadlineWins {
    when: WakeTerminalEvidenceObserved(adapter, binding, evidence)
    requires: not terminal_receipt_already_exists(binding)
    requires: evidence_matches_resource(evidence, binding.resource)
    requires: durable_terminal_evidence_at_or_before(binding, binding.expires_at)

    let payload = fired_terminal_payload(binding, evidence)
    ensures: dwf/Evidence.created(effect: binding.observe_effect)
    ensures: dwf/Receipt.created(effect: binding.observe_effect, payload: exact_terminal_receipt(binding, payload).payload)
    ensures: canonical_delivery_for(exact_terminal_receipt(binding, payload)) != null

    @guidance
        -- Occurrence time, not observation delay, decides whether a wake fired
        -- before expiry.
}

rule DeadlineWithoutTerminalEvidenceExpiresOrForgets {
    when: WakeDeadlineReached(scheduler, binding)
    requires: not terminal_receipt_already_exists(binding)
    requires: resource_is_evaluable(binding.resource)
    let payload = expired_terminal_payload(binding)
    ensures: dwf/Receipt.created(effect: binding.observe_effect, payload: exact_terminal_receipt(binding, payload).payload)
}

rule DeadlineWithoutTerminalEvidenceForgetsUnevaluableResource {
    when: WakeDeadlineReached(scheduler, binding)
    requires: not terminal_receipt_already_exists(binding)
    requires: not resource_is_evaluable(binding.resource)
    let payload = forgotten_terminal_payload(binding)
    ensures: dwf/Receipt.created(effect: binding.observe_effect, payload: exact_terminal_receipt(binding, payload).payload)
}

rule StartupForgetsUnevaluableWakeBeforeServing {
    when: WakeStartupReconciliation(adapter, binding)
    requires: not terminal_receipt_already_exists(binding)
    requires: not resource_is_evaluable(binding.resource)
    let payload = startup_forget_payload(binding)
    ensures: dwf/Receipt.created(effect: binding.observe_effect, payload: exact_terminal_receipt(binding, payload).payload)
}

rule CanonicalWakeDeliveryIsReusedOnReplay {
    when: WakeReceiptReplayed(adapter, binding, receipt)
    requires: duplicate_delivery_reuses_existing_item(receipt)
    ensures: WakeCanonicalDeliveryReused(binding.contract_id)
}

rule IdleConversationCoalescesWakeItemsIntoOneRuntimeBatch {
    when: WakeRuntimeReady(runtime, conversation)
    requires: idle_conversation(conversation)
    let upper_bound = wake_snapshot_upper_bound(conversation)
    let items = bounded_prefix(committed_order_items(conversation, upper_bound), config.max_acceptance_batch_items)
    requires: items != {}

    ensures: WakeRuntimeBatch.created(
        conversation: conversation,
        snapshot_upper_bound: upper_bound,
        created_at: now()
    )
    ensures: WakeRuntimeAcceptanceRequested(batch_payload(conversation, items, upper_bound))
    ensures: no_overlapping_llm_request(conversation)

    @guidance
        -- Coalescing uses canonical delivery items in committed order. While the
        -- batch remains owed, duplicate kicks reuse the same owed runtime work.
}

rule BusyConversationPreservesOwedWakeItems {
    when: WakeReceiptMaterialized(adapter, conversation, receipt)
    requires: busy_conversation(conversation)
    ensures: wake_items_remain_owed(conversation)
}

rule RuntimeAcceptanceConsumesExactCanonicalWakeItems {
    when: WakeRuntimeAcceptsBatch(runtime, conversation, payload)
    ensures: accepting_llm_requesting_persisted_atomically(conversation, payload)
    ensures: exact_wake_delivery_items_accepted(payload)
    ensures: later_items_preserved(conversation, payload.snapshot_upper_bound)

    @guidance
        -- The transaction that persists LlmRequesting also accepts the exact
        -- canonical wake items in the batch, leaving later arrivals for a later turn.
}

rule WakeCancellationProducesCancelledReceiptWithoutResumeTurn {
    when: WakeCancellationRequested(manager, binding)
    let payload = cancellation_terminal_payload(binding)
    ensures: dwf/Receipt.created(effect: binding.observe_effect, payload: exact_terminal_receipt(binding, payload).payload)
    ensures: no_llm_resume_scheduled_only_for_wake_cancellation(binding)
}

rule PendingWakeBlocksDestructiveLifecycleWithoutBusyState {
    when: ConversationLifecycleActionRequested(manager, conversation, action)
    requires: lifecycle_action_is_destructive(action)
    requires: pending_wake_count(conversation) > 0
    ensures: LifecycleActionConflicted(conversation.id, action)

    @guidance
        -- Pending wake work blocks destructive lifecycle actions, but it does not
        -- fabricate runtime-busy state for an otherwise idle conversation.
}

rule ContinuationTransfersPendingWakeStateAtomically {
    when: ConversationContinued(manager, predecessor, successor)
    requires: transferable_bindings(predecessor) != {}
    ensures: transfer_is_atomic(predecessor, successor)
    ensures: transferred_bindings_preserve_identity(predecessor, successor)
    ensures: transferred_delivery_items_preserve_semantics(predecessor, successor)
    ensures: predecessor_history_unchanged(predecessor)

    @guidance
        -- Pending contracts, canonical delivery items, and owed runtime batches
        -- move to exactly one successor without duplicating semantic delivery.
}
