-- allium: 3
-- bedrock.allium
--
-- Phoenix Conversation Engine: Behavioural Specification
--
-- Scope: Core conversation lifecycle state machine
-- Includes: Conversation status transitions, mode system, tool execution,
--           cancellation, error recovery, sub-agent lifecycle, task approval,
--           user questions, context continuation, terminal states,
--           lifecycle event announcements for downstream spec consumption
-- Excludes:
--   - Git operations (see projects spec)
--   - Individual tool implementations (bash, patch, etc.)
--   - LLM provider specifics (Anthropic, OpenAI wire formats)
--   - Database persistence mechanics (SQLite, serde)
--   - SSE streaming / HTTP API design
--   - UI rendering / display state mapping
--   - Token streaming mechanics
--   - System prompt construction
--
-- Architecture: CoreState wrapper pattern.
--   Parent and sub-agent conversations share a core state space but have
--   structurally disjoint terminal/recovery states. The sum type (variants)
--   makes invalid states unrepresentable: parents cannot reach Completed/Failed,
--   sub-agents cannot reach AwaitingRecovery/TaskApproval/Terminal.
--
--   Events are similarly split: CoreEvent (shared), ParentOnlyEvent,
--   SubAgentOnlyEvent. The transition function dispatches by conversation kind.
--
--   ConvState (the union of all states) remains as the serialization format.
--
-- Requirement traceability: REQ-BED-001 through REQ-BED-030, plus REQ-BED-005a
-- (3 deprecated: REQ-BED-014, REQ-BED-015, REQ-BED-016)

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity LlmProvider {
    context_window: Integer
}

external entity ToolImplementation {
    name: String
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value ToolCall {
    tool_use_id: String
    name: String
    input: String
}

value ToolResult {
    tool_use_id: String
    outcome: ToolOutcome
}

value SubAgentResult {
    agent_id: String
    outcome: SubAgentOutcome
}

value UsageData {
    input_tokens: Integer
    output_tokens: Integer
}

value UserQuestion {
    question: String
}

value TaskProposalSnapshot {
    task_file: String
    title: String
    priority: String
    plan: String
    task_kind: taskmd | plain_markdown
    repo_relative_path: String
    content_digest: String
}

value ApprovedTaskObjective {
    source: projects/ApprovedTaskSource
}

value ApprovedTaskWriteAuthority {
    objective: ApprovedTaskObjective
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum ErrorClass { retryable | non_retryable }
enum ToolOutcome { success | error | cancelled }
enum SubAgentOutcome { success | failure | timed_out }
enum RecoveryKind { credential }
enum RecoveryResumeTarget { conversation_turn | continuation_summary }
enum TaskApprovalDecision {
    approved_continue_current
    | approved_start_fresh
    | request_changes
    | rejected
}
enum ModeKind { direct | managed | branch }
enum EnvironmentKind { git_backed | chat_only }
enum ClosePhase {
    awaiting_blocker_resolution
    | awaiting_stop_work_confirmation
    | settling_active_work
    | cancel_requested_during_settlement
    | awaiting_retirement_inspection
    | awaiting_loss_confirmation
    | retirement_requested
    | needs_repair
    | completed
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- Conversation uses a sum type to structurally separate parent and sub-agent
-- conversations. The kind discriminator determines which states are reachable.
entity ProductConversation {
    kind: ordinary | coordinator
    lifecycle: open | history when kind = ordinary

    -- Aggregate membership is singular by construction: each durable
    -- transcript row belongs to exactly one product conversation. Only
    -- ordinary product conversations own Open/History lifecycle; the
    -- Coordinator keeps the same durable transcript/runtime identity without
    -- entering that lifecycle.
    transcript_rows: Conversation with product_conversation = this
}

-- Navigation/list identity is the durable ProductConversation aggregate. Member
-- root/anchor/latest transcript rows are derived views within that aggregate: the
-- root row is the unique transcript row that is not the successor of another row
-- in the same aggregate, and latest-row authority remains derived from
-- continuation topology. Where rules/surfaces need root/latest identity, they
-- derive it from transcript_rows and continued_in_conv_id rather than storing
-- parallel fields.

entity CloseObligation {
    attempt_id: String
    product_conversation: ProductConversation
    phase: ClosePhase
    inspection_generation: String? when phase in { awaiting_retirement_inspection, awaiting_loss_confirmation, retirement_requested, needs_repair }
    inspection_fingerprint: String? when phase in { awaiting_retirement_inspection, awaiting_loss_confirmation, retirement_requested, needs_repair }

    transitions phase {
        awaiting_blocker_resolution -> awaiting_stop_work_confirmation
        awaiting_blocker_resolution -> settling_active_work
        awaiting_stop_work_confirmation -> settling_active_work
        settling_active_work -> cancel_requested_during_settlement
        settling_active_work -> awaiting_retirement_inspection
        cancel_requested_during_settlement -> completed
        awaiting_retirement_inspection -> awaiting_loss_confirmation
        awaiting_retirement_inspection -> retirement_requested
        awaiting_loss_confirmation -> awaiting_retirement_inspection
        awaiting_loss_confirmation -> retirement_requested
        retirement_requested -> needs_repair
        needs_repair -> retirement_requested
        retirement_requested -> completed
        needs_repair -> completed
        terminal: completed
    }
}

entity Conversation {
    kind: Parent | SubAgent

    -- Seed metadata (REQ-SEED-003, REQ-SEED-004)
    seed_parent: Conversation?
    seed_label:  String?

    -- Core status (shared by both variants)
    core_status: idle | llm_requesting | executing_tools
                | cancelling_tool | awaiting_sub_agents | cancelling_sub_agents
                | error | awaiting_continuation | recoverable_continuation_failure

    -- Mode (orthogonal to status)
    mode: explore | direct | work | branch
    execution_authority: read_only | write_capable | chat_only
    mode_kind: ModeKind
    environment_kind: EnvironmentKind
    desired_base_branch: String?

    -- Context tracking (REQ-BED-012)
    context_usage_ratio: Decimal
    model_context_window: Integer

    lifecycle: open | history

    -- Conversation rows linked by continued_in_conv_id form one product
    -- conversation rooted at the durable first row. Lifecycle belongs to that
    -- root-owned product conversation, not independently to each transcript row.
    -- Bedrock derives the live/latest row from topology: the latest row is the
    -- row with no continuation successor.
    seed_parent: Conversation?

    -- Core status transitions (shared)
    transitions core_status {
        idle -> llm_requesting
        error -> llm_requesting
        error -> idle
        llm_requesting -> idle
        llm_requesting -> executing_tools
        llm_requesting -> error
        executing_tools -> llm_requesting
        executing_tools -> awaiting_sub_agents
        executing_tools -> cancelling_tool
        cancelling_tool -> idle
        cancelling_tool -> cancelling_sub_agents
        awaiting_sub_agents -> llm_requesting
        awaiting_sub_agents -> cancelling_sub_agents
        cancelling_sub_agents -> idle
        idle -> awaiting_continuation
        awaiting_continuation -> recoverable_continuation_failure
        recoverable_continuation_failure -> awaiting_continuation
    }

    -- Mode transitions (REQ-BED-027)
    transitions mode {
        direct -> branch
        terminal: direct, work, branch
    }

    -- Core state-dependent fields
    retry_attempt: Integer when core_status = llm_requesting | awaiting_continuation | recoverable_continuation_failure
    tool_queue: List<ToolCall> when core_status = executing_tools
    tool_results: List<ToolResult> when core_status = executing_tools | cancelling_tool
    accumulated_sub_agents: Set<Conversation> when core_status = executing_tools
    skipped_tools: List<ToolCall> when core_status = cancelling_tool
    sub_agents_pending: Set<Conversation>
        when core_status = awaiting_sub_agents | cancelling_sub_agents
    sub_agents_completed: List<SubAgentResult>
        when core_status = awaiting_sub_agents | cancelling_sub_agents
    rejected_tool_calls: List<ToolCall> when core_status = awaiting_continuation | recoverable_continuation_failure
    continuation_operation_id: String when core_status = awaiting_continuation | recoverable_continuation_failure
    continuation_error_message: String when core_status = recoverable_continuation_failure
    continuation_error_class: ErrorClass when core_status = recoverable_continuation_failure
    error_message: String when core_status = error
    error_class: ErrorClass when core_status = error

    -- Worktree fields (shared across modes with worktrees)
    branch_name: String when mode in { explore, work, branch }
    worktree_path: String when mode in { explore, work, branch }
    base_branch: String when mode in { explore, work, branch }
    approved_task_objective: ApprovedTaskObjective?
    approved_task_write_authority: ApprovedTaskWriteAuthority?

    -- Filesystem cwd. For mode in { explore, work, branch } this equals
    -- worktree_path; for mode = direct it is the user-supplied directory.
    -- Persists with the conversation row (DB column `cwd`); referenced by
    -- spawn rules and by the projects/ spec when comparing parent and
    -- continuation environments.
    working_dir: String

    -- REQ-BED-030: continuation pointer. When set, this conversation has
    -- been continued and the live `WorkScope` ownership (and inherited
    -- worktree, if any) belongs to the continuation. This row remains as
    -- history/navigation only. Used by reconcile, abandon/mark-merged gates, and
    -- the FE "Continued in X" affordance. Single-valued by construction
    -- (see TerminalActionRequiresNoContinuation in projects).
    continued_in_conv_id: Conversation?

    -- True iff at least one SSE subscriber is currently listening.
    -- Pollers gate on this to avoid waking the runtime for nobody —
    -- behavioural, not just an optimisation: when no clients are
    -- connected, polling is suppressed (REQ-PROJ-023).
    has_connected_clients: Boolean

    -- Declared proposal eligibility boundary for `propose_task`. Eligibility is
    -- structural: the conversation must target a Git-backed product environment
    -- and the working directory must resolve to a repository. Whether a
    -- chat-only conversation may still carry a WorkScope is intentionally left
    -- unspecified here; attached WorkScope does not make chat-only eligible.
    task_proposal_eligible: Boolean

    -- Relationships
    sub_agents: Conversation with parent = this
    write_capable_sub_agents: sub_agents where execution_authority = write_capable

    -- Derived
    is_busy: core_status in { llm_requesting, executing_tools,
                              awaiting_sub_agents, cancelling_tool,
                              cancelling_sub_agents }
    task_proposal_eligible: environment_kind = git_backed
        and is_git_repository(working_dir)
    context_warning: context_usage_ratio >= config.context_warning_threshold
    context_at_threshold: context_usage_ratio >= config.context_continuation_threshold

    -- Entity-level invariants
    invariant OneWorkSubAgent {
        write_capable_sub_agents.count <= 1
    }
}

-- Parent conversations: user-facing. Can propose tasks, recover from auth
-- errors, reach terminal via task resolution or context exhaustion.
-- CANNOT reach Completed or Failed (sub-agent-only).
variant Parent : Conversation {
    parent_status: awaiting_recovery | awaiting_task_approval
                  | awaiting_user_response | context_exhausted | handed_off

    -- Legacy migration input only for pre-source-relation rows.
    -- Non-authoritative: current provenance, deleted-source truth, and visible
    -- breadcrumbs come only from the typed source relation owned by the target
    -- ProductConversation. This raw id may be read only to backfill or interpret
    -- legacy rows that predate typed source relations; current writers and current
    -- readers must not treat it as live provenance authority.
    spawned_from_conversation_id: String?

    proposal_snapshot: TaskProposalSnapshot when parent_status = awaiting_task_approval
    pending_questions: List<UserQuestion> when parent_status = awaiting_user_response
    recovery_kind: RecoveryKind when parent_status = awaiting_recovery
    recovery_resume_target: RecoveryResumeTarget when parent_status = awaiting_recovery
    recovery_message: String when parent_status = awaiting_recovery
    continuation_summary: String when parent_status = context_exhausted
    successor: Conversation when parent_status = handed_off
    continuation_boundary_summary: String when parent_status = handed_off

    open_row_condition: parent_status in { context_exhausted, handed_off }
    is_latest_row: continued_in_conv_id = absent
    predecessor: continuation_predecessor(product_conversation, this)
    root_conversation: continuation_root(product_conversation, this)
    product_lifecycle: open | history when product_conversation.kind = ordinary
    row_accepts_user_messages:
        if product_conversation.kind = coordinator:
            is_latest_row
            and parent_status != context_exhausted
            and parent_status != handed_off
        else:
            product_lifecycle = open
            and is_latest_row
            and parent_status != context_exhausted
            and parent_status != handed_off
    close_eligible:
        product_conversation.kind = ordinary
        and product_lifecycle = open
        and is_latest_row
        and parent_status != handed_off

    -- Parent-only status transitions.
    -- Recovery/approval/question states exit by resetting to a core_status
    -- (idle, llm_requesting, error). These are cross-field transitions:
    -- parent_status clears while core_status is set.
    --
    -- Transition graph (not expressible as a v3 `transitions` block because
    -- the Allium v3 grammar does not currently support transitions or
    -- invariants inside `variant` bodies — see the triage note below):
    --
    --   awaiting_task_approval -> idle            (approve here / request changes / reject)
    --   awaiting_task_approval -> idle            (approve into fresh conversation exits source)
    --   awaiting_user_response -> idle            (user question exits)
    --   awaiting_recovery      -> idle            (conversation-turn recovery exits)
    --   awaiting_recovery      -> awaiting_continuation (continuation recovery succeeds)
    --   awaiting_recovery      -> recoverable_continuation_failure (continuation recovery fails)
    --   awaiting_continuation  -> context_exhausted (continuation checkpoint)
    --   context_exhausted and handed_off are row conditions inside an Open
    --   product conversation, not product-lifecycle History.
    --
    -- The rules below (parent-only section) realise each transition.
}

-- Sub-agent conversations: spawned by a parent, report results back.
-- CANNOT reach AwaitingRecovery, TaskApproval, UserResponse, ContextExhausted,
-- or Terminal (parent-only).
variant SubAgent : Conversation {
    parent: Conversation
    sub_agent_status: completed | failed

    grace_turn_granted: Boolean = false
    completion_result: String when sub_agent_status = completed
    failure_error: String when sub_agent_status = failed
    failure_error_class: ErrorClass? when sub_agent_status = failed

    is_terminal: sub_agent_status in { completed, failed }

    -- Sub-agent status is set exactly once, at terminal transition. There are
    -- no intermediate sub_agent_status values. Terminal states: completed,
    -- failed. (Not expressed as a v3 `transitions` block: grammar does not
    -- support transitions inside `variant` bodies.)
    --
    -- Entity-level invariant (grammar does not support `invariant` inside
    -- `variant` bodies either): sub-agents cannot spawn further sub-agents —
    -- for any SubAgent c, c.sub_agents.count = 0. Tracked as cross-cutting
    -- invariant NoRecursiveSubAgents below.
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    max_retry_attempts: Integer = 3
    context_warning_threshold: Decimal = 0.80
    context_continuation_threshold: Decimal = 0.90
    max_sub_agents_per_spawn: Integer = 10
    -- Backstop deadline for forced cancellation teardown (REQ-BED-005a). The
    -- cooperative interrupt (REQ-BED-005, within 100ms) is the happy path; this
    -- deadline bounds the pathological case where a tool never observes its
    -- cancellation token or never returns. Short by design: cancellation must
    -- reach a terminal-direction state promptly regardless of tool cooperation.
    cancellation_deadline: Duration = 3.seconds
}

-- Automatic LLM-error retries use exponential backoff with a fixed schedule,
-- not a runtime-configurable base delay. The delay before dispatching the retry
-- for an already-failed attempt n is 2^n seconds. With max_retry_attempts = 3,
-- only attempts 1 and 2 are retried, so the realised schedule is 2 seconds then
-- 4 seconds. Exponential (rather than linear) backoff gives a transient provider
-- outage room to clear before the second retry without lengthening the first.
-- The schedule is a fixed design value: there is no per-deployment knob.
--
-- The RetryScheduled `delay` below is written as 2.seconds * attempt because the
-- Allium expression grammar has no exponentiation operator; over the realised
-- domain {1, 2} the exponential 2^n and this linear form coincide exactly
-- (2, 4). The exponential 2^n is the authoritative formula — see above.

------------------------------------------------------------
-- Rules: Core (shared by parent and sub-agent)
------------------------------------------------------------

-- ===========================================================
-- CORE 1. USER MESSAGE HANDLING (REQ-BED-002)
-- ===========================================================

rule UserSendsMessage {
    when: UserSendsMessage(conversation, text, images?)
    requires: conversation.core_status in { idle, error }
    requires: conversation.row_accepts_user_messages
    ensures: conversation.core_status = llm_requesting
    ensures: conversation.retry_attempt = 1
    ensures: LlmRequestDispatched(conversation)
}

rule RejectMessageWhileBusy {
    when: UserSendsMessage(conversation, text, images?)
    requires: conversation.is_busy
    ensures: MessageRejected(conversation, reason: agent_busy)
}

rule RejectMessageWhenRowDoesNotAcceptInput {
    when: UserSendsMessage(conversation, text, images?)
    requires: not conversation.is_busy
    requires: not conversation.row_accepts_user_messages
    ensures: MessageRejected(conversation, reason: conversation_read_only)
}

-- ===========================================================
-- CORE 2. LLM RESPONSE — TOOL DISPATCH (REQ-BED-003)
-- ===========================================================

rule LlmRespondsWithTools {
    when: LlmResponds(conversation, content, tool_calls, end_turn, usage)
    requires: conversation.core_status = llm_requesting
    requires: tool_calls.count > 0
    requires: not is_sole_intercepted_tool(tool_calls)
    requires: not conversation.context_at_threshold
    ensures: conversation.core_status = executing_tools
    ensures: conversation.tool_queue = tool_calls
    ensures: conversation.tool_results = {}
    ensures: conversation.accumulated_sub_agents = {}
    ensures: conversation.context_usage_ratio = usage_ratio(usage, conversation)
    ensures: ToolExecutionStarted(conversation, tool_calls.first)
}

-- Intercepted tool mixed with other tools -> error results fed back to LLM
rule InterceptedToolNotSole {
    when: LlmResponds(conversation, content, tool_calls, end_turn, usage)
    requires: conversation.core_status = llm_requesting
    requires: tool_calls.count > 1
    requires: tool_calls.any(t => is_intercepted_tool(t.name))
    let msg = intercepted_tool_name(tool_calls) + " must be the only tool in response"
    ensures: conversation.core_status = llm_requesting
    ensures: conversation.retry_attempt = 1
    ensures: ToolRoundCheckpointed(conversation)  -- all tool_calls get ToolResult::error(msg)
    ensures: LlmRequestDispatched(conversation)
}

-- ===========================================================
-- CORE 3. TOOL EXECUTION (REQ-BED-004)
-- ===========================================================

rule ToolCompletesWithMoreRemaining {
    when: ToolCompletes(conversation, result)
    requires: conversation.core_status = executing_tools
    requires: conversation.tool_queue.count > 0
    ensures: conversation.tool_results.add(result)
    ensures: ToolExecutionStarted(conversation, conversation.tool_queue.first)
}

rule LastToolCompletesNoSubAgents {
    when: ToolCompletes(conversation, result)
    requires: conversation.core_status = executing_tools
    requires: conversation.tool_queue.count = 0
    requires: conversation.accumulated_sub_agents.count = 0
    ensures: conversation.tool_results.add(result)
    ensures: conversation.core_status = llm_requesting
    ensures: conversation.retry_attempt = 1
    ensures: ToolRoundCheckpointed(conversation)
    ensures: LlmRequestDispatched(conversation)
}

rule LastToolCompletesWithSubAgents {
    when: ToolCompletes(conversation, result)
    requires: conversation.core_status = executing_tools
    requires: conversation.tool_queue.count = 0
    requires: conversation.accumulated_sub_agents.count > 0
    ensures: conversation.tool_results.add(result)
    ensures: conversation.core_status = awaiting_sub_agents
    ensures: conversation.sub_agents_pending = conversation.accumulated_sub_agents
    ensures: conversation.sub_agents_completed = {}
    ensures: ToolRoundCheckpointed(conversation)
}

rule SpawnAgentsCompletesWithMoreTools {
    when: SpawnAgentsCompletes(conversation, result, spawned_agents)
    requires: conversation.core_status = executing_tools
    requires: conversation.tool_queue.count > 0
    ensures: conversation.tool_results.add(result)
    ensures:
        for agent in spawned_agents:
            conversation.accumulated_sub_agents.add(agent)
    ensures: ToolExecutionStarted(conversation, conversation.tool_queue.first)
}

rule SpawnAgentsCompletesAsLastTool {
    when: SpawnAgentsCompletes(conversation, result, spawned_agents)
    requires: conversation.core_status = executing_tools
    requires: conversation.tool_queue.count = 0
    ensures: conversation.tool_results.add(result)
    ensures:
        for agent in spawned_agents:
            conversation.accumulated_sub_agents.add(agent)
    ensures: conversation.core_status = awaiting_sub_agents
    ensures: conversation.sub_agents_pending = conversation.accumulated_sub_agents
    ensures: conversation.sub_agents_completed = {}
    ensures: ToolRoundCheckpointed(conversation)
}

-- ===========================================================
-- CORE 4. CANCELLATION (REQ-BED-005)
-- ===========================================================

rule CancelDuringToolExecution {
    when: UserCancels(conversation)
    requires: conversation.core_status = executing_tools
    ensures: conversation.core_status = cancelling_tool
    ensures: conversation.skipped_tools = conversation.tool_queue
    ensures: ToolAbortRequested(conversation)
}

rule ToolAbortConfirmed {
    when: ToolAborted(conversation)
    requires: conversation.core_status = cancelling_tool
    ensures: CancellationCheckpointed(conversation)
    ensures:
        if conversation.sub_agents_pending?.count = 0:
            conversation.core_status = idle
            AgentDone(conversation)
        else:
            conversation.core_status = cancelling_sub_agents
            SubAgentsCancelRequested(conversation)
}

rule ToolCompletesDuringCancellation {
    when: ToolCompletes(conversation, result)
    requires: conversation.core_status = cancelling_tool
    ensures: CancellationCheckpointed(conversation)
    ensures:
        if conversation.sub_agents_pending?.count = 0:
            conversation.core_status = idle
            AgentDone(conversation)
        else:
            conversation.core_status = cancelling_sub_agents
            SubAgentsCancelRequested(conversation)
}

rule CancelDuringSubAgentWait {
    when: UserCancels(conversation)
    requires: conversation.core_status = awaiting_sub_agents
    ensures: conversation.core_status = cancelling_sub_agents
    ensures: SubAgentsCancelRequested(conversation)
}

rule LastSubAgentDuringCancellation {
    when: SubAgentReportsResult(conversation, result)
    requires: conversation.core_status = cancelling_sub_agents
    requires: conversation.sub_agents_pending.count = 1
    ensures: conversation.sub_agents_completed.add(result)
    ensures: conversation.core_status = idle
    ensures: AgentDone(conversation)
}

rule SubAgentResultDuringCancellation {
    when: SubAgentReportsResult(conversation, result)
    requires: conversation.core_status = cancelling_sub_agents
    requires: conversation.sub_agents_pending.count > 1
    ensures: conversation.sub_agents_completed.add(result)
}

-- REQ-BED-005a: Bounded cancellation liveness — forced teardown backstop.
--
-- cancelling_tool's only cooperative exits (ToolAbortConfirmed,
-- ToolCompletesDuringCancellation) both require the tool task to return. A tool
-- that never observes its cancellation token and never returns would otherwise
-- wedge the conversation here forever. The deadline backstop forces the
-- cancellation to completion without waiting for the task.
rule CancellingToolDeadlineFires {
    when: CancellationDeadlineExpires(conversation)
    requires: conversation.core_status = cancelling_tool
    ensures: CancellationCheckpointed(conversation)
    ensures: CancellationDeadlineExceeded(conversation)
    ensures: SystemMessageInjected(conversation,
        "Cancellation completed. Aborted work may still be reclaiming resources in the background.")
    -- Mirror the conditional next-state of the cooperative ToolAbortConfirmed:
    -- if sub-agents were spawned earlier in this tool round they must still be
    -- cancelled, so the backstop drains into cancelling_sub_agents (which has
    -- its own deadline backstop) rather than skipping straight to idle.
    ensures:
        if conversation.sub_agents_pending?.count = 0:
            conversation.core_status = idle
            AgentDone(conversation)
        else:
            conversation.core_status = cancelling_sub_agents
            SubAgentsCancelRequested(conversation)

    @guidance
        -- Sequence on deadline expiry: abort the tool's executing task (do not
        -- wait for it), reap any subprocesses it spawned (process-group kill),
        -- synthesize cancelled results for the current and remaining tools,
        -- checkpoint, then settle. Settling reaches idle (not error) — a cancel
        -- the user requested and that succeeded from their view must not be
        -- presented as a failure — except when the round had spawned sub-agents,
        -- where it drains through cancelling_sub_agents first (those agents'
        -- liveness is then bounded by CancellingSubAgentsDeadlineFires). The
        -- user-visible orientation message is sequenced AFTER the cancellation
        -- checkpoint so history replay never shows the notice before the tool
        -- call/results it describes. CancellationDeadlineExceeded is the
        -- executor's WARN-level liveness marker. The OS child process is reaped
        -- regardless of task cooperation (REQ-BED-005); this backstop covers the
        -- in-process "task never returns" case.
}

-- cancelling_sub_agents's cooperative exit (LastSubAgentDuringCancellation)
-- requires every pending sub-agent to report. A sub-agent that never reports
-- (the same wedge class as REQ-SA-006) would otherwise hold the parent here
-- forever. The deadline backstop forces completion without waiting.
rule CancellingSubAgentsDeadlineFires {
    when: CancellationDeadlineExpires(conversation)
    requires: conversation.core_status = cancelling_sub_agents
    ensures: conversation.core_status = idle
    ensures: AgentDone(conversation)
    ensures: CancellationDeadlineExceeded(conversation)
    ensures: SystemMessageInjected(conversation,
        "Cancellation completed. Aborted work may still be reclaiming resources in the background.")

    @guidance
        -- Mirror of CancellingToolDeadlineFires for the sub-agent fan-in:
        -- abort still-pending sub-agents without waiting for them to report,
        -- settle to idle, WARN via CancellationDeadlineExceeded, and inject the
        -- user-visible message. Same liveness family as specs/subagents/
        -- REQ-SA-006 (a wedged worker must not hold its supervisor indefinitely).
}

-- ===========================================================
-- CORE 5. ERROR RECOVERY (REQ-BED-006)
-- ===========================================================

rule RetryableLlmError {
    when: LlmErrors(conversation, message, error_class, attempt)
    requires: conversation.core_status = llm_requesting
    requires: error_class = retryable
    requires: attempt < config.max_retry_attempts
    ensures: conversation.retry_attempt = attempt + 1
    ensures: RetryScheduled(conversation, delay: 2.seconds * attempt)
}

rule RetryTimeoutFires {
    when: RetryTimeoutExpires(conversation, attempt)
    requires: conversation.core_status = llm_requesting
    requires: conversation.retry_attempt = attempt
    ensures: LlmRequestDispatched(conversation)
}

-- REQ-BED-006: User dismisses a persisted error, returning the conversation
-- to idle without resuming the turn. This is the "Dismiss" affordance on the
-- error banner, distinct from retry (error -> llm_requesting, realised by
-- UserSendsMessage in CORE 1, which resends and resumes).
--
-- Restricted to user-resumable errors. The user-resume policy is defined in
-- specs/llm/ (LlmError.user_resumable, derived from LlmErrorKind: auth,
-- network, rate_limit, server_error, server_overloaded,
-- usage_limit_reached). It is a distinct
-- axis from error_class (retryable | non_retryable), which governs automatic
-- runtime retry, not user resumption. error_kind is the persisted error's
-- LlmErrorKind discriminator, the same payload fact guarded by error_kind in
-- AuthErrorWithActiveRecovery and BackendRejectsContextExhausted.
--
-- A non-resumable error (invalid_request, content_filter,
-- context_window_exceeded) is a dead end: the resume policy says to abandon
-- it for a fresh conversation. Returning it to idle would reopen the normal
-- idle -> llm_requesting message path (UserSendsMessage) that the resume
-- policy explicitly denies, so dismissal to idle is forbidden for those
-- kinds and the error banner stays put.
rule UserDismissesError {
    when: UserDismissesError(conversation)
    requires: conversation.core_status = error
    requires: user_resumable(error_kind)
    ensures: conversation.core_status = idle
    ensures: ErrorDismissed(conversation)

    @guidance
        -- ErrorDismissed is a distinct lifecycle marker from AgentDone (turn
        -- completion). Dismissal is the user clearing a banner, not a turn
        -- ending, so it must NOT drain the steering queue: queued steers wait
        -- for an explicit retry/send. The steering drain (DrainOnIdleEntry in
        -- specs/steering-messages/) is scoped to exclude this edge — see its
        -- guard on the dismissal marker. Dismissal persists a hidden marker
        -- so a server restart does not auto-continue the dismissed turn: the
        -- restart recovery heuristic treats the marker as a settled idle, the
        -- same way it treats a dismissed user question. user_resumable(
        -- error_kind) mirrors the derived LlmError.user_resumable in
        -- specs/llm/; bedrock reads the persisted error's kind as a payload
        -- discriminator rather than importing the taxonomy, consistent with
        -- the existing error_kind guards.
}

-- ===========================================================
-- CORE 6. SUB-AGENT FAN-IN (REQ-BED-008)
-- ===========================================================

rule SubAgentReportsResultMorePending {
    when: SubAgentReportsResult(conversation, result)
    requires: conversation.core_status = awaiting_sub_agents
    requires: conversation.sub_agents_pending.count > 1
    ensures: conversation.sub_agents_completed.add(result)
}

rule LastSubAgentReportsResult {
    when: SubAgentReportsResult(conversation, result)
    requires: conversation.core_status = awaiting_sub_agents
    requires: conversation.sub_agents_pending.count = 1
    ensures: conversation.sub_agents_completed.add(result)
    ensures: conversation.core_status = llm_requesting
    ensures: conversation.retry_attempt = 1
    ensures: LlmRequestDispatched(conversation)
}

------------------------------------------------------------
-- Rules: Parent-only
------------------------------------------------------------

-- ===========================================================
-- PARENT 0. MESSAGE REJECTION IN PARENT-ONLY STATES
-- ===========================================================

rule RejectMessageDuringTaskApproval {
    when: UserSendsMessage(conversation, text, images?)
    requires: conversation.parent_status = awaiting_task_approval
    ensures: MessageRejected(conversation, reason: awaiting_approval)
}

rule RejectMessageDuringUserQuestion {
    when: UserSendsMessage(conversation, text, images?)
    requires: conversation.parent_status = awaiting_user_response
    ensures: MessageRejected(conversation, reason: awaiting_response)
}

rule RejectMessageContextExhausted {
    when: UserSendsMessage(conversation, text, images?)
    requires: conversation.parent_status = context_exhausted
    requires: conversation.product_conversation.kind = ordinary
    requires: conversation.product_lifecycle = open
    ensures: MessageRejected(conversation, reason: context_exhausted)
}

-- ===========================================================
-- PARENT 1. LLM RESPONSE — TEXT-ONLY AND INTERCEPTIONS
-- ===========================================================

rule ParentLlmRespondsTextOnly {
    when: LlmResponds(conversation, content, tool_calls, end_turn, usage)
    requires: conversation.core_status = llm_requesting
    requires: tool_calls.count = 0
    ensures: conversation.core_status = idle
    ensures: conversation.context_usage_ratio = usage_ratio(usage, conversation)
    ensures: AgentDone(conversation)
}

-- REQ-BED-028, REQ-PROJ-003/012: propose_task interception for every Git-backed
-- parent conversation whose declared proposal-eligibility boundary says approved work
-- can land into a Git-backed target. Review is always blocking: proposal authority does
-- not split by mode, and writing-capable parents do not get a parallel non-blocking path.
rule ProposeTaskIntercepted {
    when: LlmResponds(conversation, content, tool_calls, end_turn, usage)
    requires: conversation.core_status = llm_requesting
    requires: conversation.kind = Parent
    requires: tool_calls.count = 1
    requires: tool_calls.first.name = "propose_task"
    requires: conversation.task_proposal_eligible
    requires: not conversation.context_at_threshold
    let proposal_snapshot = snapshot_task_proposal(tool_calls.first)
    requires: task_proposal_valid(proposal_snapshot)
    ensures: conversation.parent_status = awaiting_task_approval
    ensures: conversation.proposal_snapshot = proposal_snapshot
    ensures: TaskApprovalRequested(conversation, proposal_snapshot)

    @guidance
        -- There is exactly one blocking proposal-review authority: a sole propose_task
        -- from a Git-backed parent that can land work through a managed worktree or an
        -- attached WorkScope always parks in AwaitingTaskApproval.
        -- At the continuation threshold ContextThresholdReachedParent still wins first,
        -- parking into awaiting_continuation with the propose_task call in
        -- rejected_tool_calls for replay after continuation.
}

rule ApprovalSnapshotMismatchRequiresRequestChanges {
    when: TaskApprovalDecided(conversation, decision)
    requires: conversation.parent_status = awaiting_task_approval
    requires: decision in { approved_continue_current, approved_start_fresh }
    requires: reread_task_repo_relative_path(conversation.proposal_snapshot.task_file) != conversation.proposal_snapshot.repo_relative_path
        or reread_task_kind(conversation.proposal_snapshot.task_file) != conversation.proposal_snapshot.task_kind
        or reread_task_digest(conversation.proposal_snapshot.task_file) != conversation.proposal_snapshot.content_digest
    ensures: ApprovalRejectedUntilRequestChanges(conversation)

    @guidance
        -- Approval is bound to the reviewed proposal snapshot identity. If the task
        -- file was swapped, moved, retyped, or edited after review, the user must
        -- request changes so the agent can present and the user can review a fresh
        -- snapshot before any approval path may proceed.
}

-- REQ-PROJ-003/012: an invalid propose_task is rejected before the blocking review
-- state is entered. The same validation boundary applies to every eligible Git-backed
-- parent, so there is no competing validity authority parallel to the declared
-- proposal-eligibility predicate.
rule ProposeTaskInvalid {
    when: LlmResponds(conversation, content, tool_calls, end_turn, usage)
    requires: conversation.core_status = llm_requesting
    requires: conversation.kind = Parent
    requires: tool_calls.count = 1
    requires: tool_calls.first.name = "propose_task"
    requires: conversation.task_proposal_eligible
    let proposal_snapshot = snapshot_task_proposal(tool_calls.first)
    requires: not task_proposal_valid(proposal_snapshot)
    ensures: conversation.core_status = llm_requesting
    ensures: conversation.retry_attempt = 1
    ensures: conversation.context_usage_ratio = usage_ratio(usage, conversation)
    ensures: ToolRoundCheckpointed(conversation)
    ensures: LlmRequestDispatched(conversation)
}


-- REQ-PROJ-008/012: task management is the parent conversation's job, so propose_task is
-- absent from a sub-agent's tool registry. If a malformed or stale sole `propose_task` call
-- nonetheless reaches the handler from a SubAgent, it must be REJECTED with an explanation —
-- not stalled. The Parent intercept arms (ProposeTaskIntercepted / ProposeTaskInvalid)
-- are both guarded `kind = Parent`, and LlmRespondsWithTools excludes a sole intercepted tool,
-- so without this arm a sub-agent's sole propose_task matches no rule.
rule SubAgentProposeTaskRejected {
    when: LlmResponds(conversation, content, tool_calls, end_turn, usage)
    requires: conversation.core_status = llm_requesting
    requires: conversation.kind = SubAgent
    requires: tool_calls.count = 1
    requires: tool_calls.first.name = "propose_task"
    -- At the threshold SubAgentContextExhausted wins (the sub-agent fails and reports to its
    -- parent), so an over-threshold sub-agent can't loop forever feeding itself rejected
    -- propose_task errors instead of completing — same exclusion the Parent arms use.
    requires: not conversation.context_at_threshold
    ensures: conversation.core_status = llm_requesting
    ensures: conversation.retry_attempt = 1
    ensures: conversation.context_usage_ratio = usage_ratio(usage, conversation)
    ensures: ToolRoundCheckpointed(conversation)  -- propose_task gets ToolResult::error
                                                  -- ("task management is the parent's job")
    ensures: LlmRequestDispatched(conversation)
}

rule AskUserQuestionIntercepted {
    when: LlmResponds(conversation, content, tool_calls, end_turn, usage)
    requires: conversation.core_status = llm_requesting
    requires: tool_calls.count = 1
    requires: tool_calls.first.name = "ask_user_question"
    let questions = parse_questions(tool_calls.first)
    ensures: conversation.parent_status = awaiting_user_response
    ensures: conversation.pending_questions = questions
}

-- REQ-BED-019: Context threshold reached (parent -> continuation)
rule ContextThresholdReachedParent {
    when: LlmResponds(conversation, content, tool_calls, end_turn, usage)
    requires: conversation.core_status = llm_requesting
    requires: conversation.context_at_threshold
    ensures: conversation.core_status = awaiting_continuation
    ensures: conversation.rejected_tool_calls = tool_calls
    ensures: conversation.retry_attempt = 1
    ensures: ContinuationRequested(conversation, tool_calls)
}

-- ===========================================================
-- PARENT 2. CANCELLATION (parent -> idle, not failed)
-- ===========================================================

rule ParentCancelDuringLlmRequest {
    when: UserCancels(conversation)
    requires: conversation.core_status = llm_requesting
    ensures: conversation.core_status = idle
    ensures: LlmAborted(conversation)
    ensures: AgentDone(conversation)
}

-- ===========================================================
-- PARENT 3. NON-RETRYABLE ERROR (parent -> error)
-- ===========================================================

rule BackendRejectsContextExhausted {
    when: LlmErrors(conversation, message, error_class, attempt)
    requires: conversation.core_status = llm_requesting
    requires: error_kind = context_exhausted
    ensures: conversation.parent_status = context_exhausted
    ensures: conversation.continuation_summary =
        "Context limit reached before the turn could complete. " +
        "Continue to compact and resume, or start a new conversation."

    @guidance
        -- Checked before ParentLlmErrorNonRecoverable, mirroring
        -- AuthErrorWithActiveRecovery. The backend can terminate a
        -- request with context_length_exceeded even when Phoenix's own
        -- usage tracking did not trip the continuation threshold
        -- (ContextThresholdReachedParent, REQ-BED-019) — wrong declared
        -- context window, a tightened backend cap, or a large attachment
        -- landing mid-turn. Both the internal-threshold and
        -- backend-rejection paths must converge on context_exhausted so
        -- the message-rejection / continuation-recovery precondition
        -- (RejectMessageContextExhausted) is satisfiable. Routing through
        -- `error` is unrecoverable: there is no transition out of the
        -- error state into continuation, so the conversation is stranded.
        -- Sub-agents are unaffected — they have no context_exhausted
        -- parent_status and keep SubAgentContextExhausted -> failed.
}

rule ParentLlmErrorNonRecoverable {
    when: LlmErrors(conversation, message, error_class, attempt)
    requires: conversation.core_status = llm_requesting
    requires: error_class = non_retryable or attempt >= config.max_retry_attempts
    ensures: conversation.core_status = error
    ensures: conversation.error_message = message
    ensures: conversation.error_class = error_class
}

-- ===========================================================
-- PARENT 4. ACTIVE RECOVERY (REQ-BED-030)
-- ===========================================================

rule AuthErrorWithActiveRecovery {
    when: LlmErrors(conversation, message, error_class, attempt)
    requires: conversation.core_status = llm_requesting
    requires: error_class = non_retryable
    requires: error_kind = auth
    requires: CredentialHelperIsRunning
    ensures: conversation.parent_status = awaiting_recovery
    ensures: conversation.recovery_kind = credential
    ensures: conversation.recovery_resume_target = conversation_turn
    ensures: conversation.recovery_message = message

    @guidance
        -- Checked before ParentLlmErrorNonRecoverable. The
        -- recovery_in_progress flag is enriched on the event by
        -- the executor (keeps transition function pure).
}

rule ContinuationAuthErrorWithActiveRecovery {
    when: ContinuationRequestFailed(conversation, operation_id, error, error_class)
    requires: conversation.core_status = awaiting_continuation
    requires: error_kind = auth
    requires: CredentialHelperIsRunning
    ensures: conversation.parent_status = awaiting_recovery
    ensures: conversation.recovery_kind = credential
    ensures: conversation.recovery_resume_target = continuation_summary
    ensures: conversation.recovery_message = error
    ensures: conversation.continuation_operation_id = operation_id
}

rule ConversationTurnRecoverySucceeded {
    when: CredentialBecameAvailable(conversation)
    requires: conversation.parent_status = awaiting_recovery
    requires: conversation.recovery_resume_target = conversation_turn
    ensures: conversation.core_status = llm_requesting
    ensures: conversation.retry_attempt = 1
    ensures: LlmRequestDispatched(conversation)
}

rule ContinuationRecoverySucceeded {
    when: CredentialBecameAvailable(conversation)
    requires: conversation.parent_status = awaiting_recovery
    requires: conversation.recovery_resume_target = continuation_summary
    ensures: conversation.core_status = awaiting_continuation
    ensures: ContinuationRequested(
        conversation,
        conversation.continuation_operation_id,
        conversation.rejected_tool_calls)
}

rule ConversationTurnRecoveryFailed {
    when: CredentialHelperFailed(conversation, message)
    requires: conversation.parent_status = awaiting_recovery
    requires: conversation.recovery_resume_target = conversation_turn
    ensures: conversation.core_status = error
    ensures: conversation.error_message = message
    ensures: conversation.error_class = non_retryable
}

rule ContinuationRecoveryFailed {
    when: CredentialHelperFailed(conversation, message)
    requires: conversation.parent_status = awaiting_recovery
    requires: conversation.recovery_resume_target = continuation_summary
    ensures: conversation.core_status = recoverable_continuation_failure
    ensures: conversation.continuation_error_message = message
    ensures: ContinuationRetryOffered(
        conversation,
        conversation.continuation_operation_id)
}

rule CancelDuringRecovery {
    when: UserCancels(conversation)
    requires: conversation.parent_status = awaiting_recovery
    ensures: conversation.core_status = idle
}

-- ===========================================================
-- PARENT 5. TASK APPROVAL (REQ-BED-028)
-- ===========================================================

rule UserApprovesTaskCurrentConversation {
    when: TaskApprovalDecided(conversation, decision)
    requires: conversation.parent_status = awaiting_task_approval
    requires: decision = approved_continue_current
    requires: reread_task_repo_relative_path(conversation.proposal_snapshot.task_file) = conversation.proposal_snapshot.repo_relative_path
    requires: reread_task_kind(conversation.proposal_snapshot.task_file) = conversation.proposal_snapshot.task_kind
    requires: reread_task_digest(conversation.proposal_snapshot.task_file) = conversation.proposal_snapshot.content_digest
    ensures: ApprovalRereadSnapshot(
        conversation,
        original_task_file: conversation.proposal_snapshot.task_file,
        original_repo_relative_path: conversation.proposal_snapshot.repo_relative_path,
        original_task_kind: conversation.proposal_snapshot.task_kind,
        original_content_digest: conversation.proposal_snapshot.content_digest
    )
    ensures: ApprovalMatchesReviewedSnapshot(
        conversation,
        original_task_file: conversation.proposal_snapshot.task_file,
        original_repo_relative_path: conversation.proposal_snapshot.repo_relative_path,
        original_task_kind: conversation.proposal_snapshot.task_kind,
        original_content_digest: conversation.proposal_snapshot.content_digest,
        approved_body: reread_task_body(conversation.proposal_snapshot.task_file)
    )
    ensures: ExactApprovedBodyPersisted(
        conversation,
        repo_relative_path: conversation.proposal_snapshot.repo_relative_path,
        task_kind: conversation.proposal_snapshot.task_kind,
        content_digest: conversation.proposal_snapshot.content_digest,
        approved_body: reread_task_body(conversation.proposal_snapshot.task_file)
    )
    ensures: conversation.approved_task_objective = ApprovedTaskObjective {
        source: projects/ApprovedTaskSource {
            task_path: conversation.proposal_snapshot.task_file,
            title: conversation.proposal_snapshot.title,
            priority: conversation.proposal_snapshot.priority,
            body: reread_task_body(conversation.proposal_snapshot.task_file),
            identity: projects/approved_task_identity(conversation.proposal_snapshot.task_file),
            reviewed_snapshot: projects/ReviewedProposalSnapshotIdentity {
                repo_relative_path: conversation.proposal_snapshot.repo_relative_path,
                task_kind: conversation.proposal_snapshot.task_kind,
                content_digest: conversation.proposal_snapshot.content_digest
            },
            kind: projects/approved_task_kind(conversation.proposal_snapshot.task_file)
        }
    }
    ensures: conversation.approved_task_write_authority = ApprovedTaskWriteAuthority {
        objective: conversation.approved_task_objective
    }
    ensures: WriteAuthorityPersistedBeforeResume(conversation)
    ensures: conversation.core_status = llm_requesting
    ensures: conversation.retry_attempt = 1
    ensures: LlmRequestDispatched(conversation)

    @guidance
        -- Continue here resolves the blocking approval inside the same
        -- conversation. It durably establishes typed approved-task objective and
        -- write authority on the existing Git-backed scope before resume, but does
        -- not transition product lifecycle, product mode, work-scope attachment,
        -- continuation topology, provenance, or branch/worktree state beyond the
        -- approval checkpoint itself.
        --
        -- ApprovalRereadSnapshot / ApprovalMatchesReviewedSnapshot bind approval to
        -- the reviewed repo-relative path, task kind, and content digest. The
        -- reread body may only be approved when all three still match the reviewed
        -- snapshot identity; otherwise ApprovalSnapshotMismatchRequiresRequestChanges
        -- wins and approval is blocked until a fresh review snapshot is captured.
}

rule UserApprovesTaskNewConversation {
    when: TaskApprovalDecided(conversation, decision)
    requires: conversation.parent_status = awaiting_task_approval
    requires: decision = approved_start_fresh
    requires: reread_task_repo_relative_path(conversation.proposal_snapshot.task_file) = conversation.proposal_snapshot.repo_relative_path
    requires: reread_task_kind(conversation.proposal_snapshot.task_file) = conversation.proposal_snapshot.task_kind
    requires: reread_task_digest(conversation.proposal_snapshot.task_file) = conversation.proposal_snapshot.content_digest
    ensures: ApprovalRereadSnapshot(
        conversation,
        original_task_file: conversation.proposal_snapshot.task_file,
        original_repo_relative_path: conversation.proposal_snapshot.repo_relative_path,
        original_task_kind: conversation.proposal_snapshot.task_kind,
        original_content_digest: conversation.proposal_snapshot.content_digest
    )
    ensures: ApprovalMatchesReviewedSnapshot(
        conversation,
        original_task_file: conversation.proposal_snapshot.task_file,
        original_repo_relative_path: conversation.proposal_snapshot.repo_relative_path,
        original_task_kind: conversation.proposal_snapshot.task_kind,
        original_content_digest: conversation.proposal_snapshot.content_digest,
        approved_body: reread_task_body(conversation.proposal_snapshot.task_file)
    )
    ensures: ExactApprovedBodyPersisted(
        conversation,
        repo_relative_path: conversation.proposal_snapshot.repo_relative_path,
        task_kind: conversation.proposal_snapshot.task_kind,
        content_digest: conversation.proposal_snapshot.content_digest,
        approved_body: reread_task_body(conversation.proposal_snapshot.task_file)
    )
    let fresh_work_conversation = created_fresh_work_conversation(conversation)
    let target_product_conversation = fresh_work_conversation.product_conversation
    ensures: FreshWorkConversationCreated(conversation, fresh_work_conversation)
    ensures: fresh_work_conversation.product_conversation != conversation.product_conversation
    ensures: fresh_work_conversation.continued_in_conv_id = absent
    ensures: FreshWorkConversationProvisioningRequested(
        source_conversation: conversation,
        target_conversation: fresh_work_conversation,
        target_product_conversation: target_product_conversation,
        repository_identity: conversation.project.repo
    )
    ensures: conversation.core_status = idle

    @guidance
        -- Starting fresh for approved task work creates a separate product
        -- conversation boundary. It is not a continuation: the source returns to
        -- ordinary Open/idle, no continuation edge is written, and no handed_off
        -- row condition is introduced.
        -- Typed provisioning owns when the spawned conversation becomes runnable:
        -- approval requests fresh provisioning, and only a later successful durable
        -- provisioning-completed event may dispatch the first LLM request. Failed
        -- provisioning never dispatches the fresh conversation.
        --
        -- Approval remains bound to the reviewed snapshot identity here too; Phoenix
        -- cannot seed a new conversation from arbitrary current file contents after a
        -- post-review swap or edit.
}

rule UserRequestsTaskChanges {
    when: TaskApprovalDecided(conversation, decision)
    requires: conversation.parent_status = awaiting_task_approval
    requires: decision = request_changes
    ensures: conversation.core_status = llm_requesting
    ensures: conversation.retry_attempt = 1
    ensures: LlmRequestDispatched(conversation)
}

rule UserRejectsTask {
    when: TaskApprovalDecided(conversation, decision)
    requires: conversation.parent_status = awaiting_task_approval
    requires: decision = rejected
    ensures: conversation.core_status = idle
    ensures: AgentDone(conversation)
}

rule CancelDuringTaskApproval {
    when: UserCancels(conversation)
    requires: conversation.parent_status = awaiting_task_approval
    ensures: conversation.core_status = idle
    ensures: AgentDone(conversation)
}

-- Approved-task placement never writes continuation topology. Start in new
-- conversation creates a separate top-level lineage while the source stays Open.
-- Continue here resumes the same ProductConversation, transcript context, attached
-- WorkScope, and mode with typed approved-task objective/write-authority state.
-- A fork proposal is resolved entirely in projects/ and leaves its origin untouched.

-- ===========================================================
-- PARENT 6. USER QUESTION RESPONSE
-- ===========================================================

rule UserAnswersQuestion {
    when: UserAnswersQuestion(conversation, answers, annotations?)
    requires: conversation.parent_status = awaiting_user_response
    ensures: conversation.core_status = llm_requesting
    ensures: conversation.retry_attempt = 1
    ensures: LlmRequestDispatched(conversation)
}

-- The user dismisses a pending question instead of answering it, settling the
-- conversation back to idle without resuming the turn. This is a settle, not a
-- resume: unlike UserAnswersQuestion (which feeds the answers back and returns
-- to llm_requesting), dismissal abandons the turn. It is the question-banner
-- analogue of UserDismissesError, and like that edge it persists a hidden
-- marker so a server restart treats the conversation as a settled idle rather
-- than auto-continuing the dismissed turn.
rule UserDismissesQuestion {
    when: UserDismissesQuestion(conversation)
    requires: conversation.parent_status = awaiting_user_response
    ensures: conversation.core_status = idle
    ensures: QuestionDismissed(conversation)
}

-- ===========================================================
-- PARENT 7. CONTEXT CONTINUATION (REQ-BED-019 through 024)
-- ===========================================================

-- Manual continuation is user-gated only by idle status. The UI warning
-- threshold changes indicator styling; it does not hide this action.
rule UserTriggersContinuation {
    when: UserTriggersContinuation(conversation, operation_id)
    requires: conversation.core_status = idle
    ensures: conversation.core_status = awaiting_continuation
    ensures: conversation.continuation_operation_id = operation_id
    ensures: conversation.rejected_tool_calls = {}
    ensures: conversation.retry_attempt = 1
    ensures: ContinuationOperationPersisted(conversation, operation_id)
    ensures: ContinuationRequested(conversation, operation_id, {})
}

rule ContinuationSummaryReceived {
    when: ContinuationSummaryReady(conversation, operation_id, summary)
    requires: conversation.core_status = awaiting_continuation
    requires: conversation.continuation_operation_id = operation_id
    ensures: conversation.parent_status = context_exhausted
    ensures: conversation.continuation_summary = summary
    ensures: ContinuationCommitted(conversation, operation_id)
    @guidance
        -- Persist the summary message and context-exhausted state atomically.
        -- Derive the summary message identity from operation_id so replay cannot
        -- create a second committed summary.
}

rule ContinuationFailureBecomesRecoverable {
    when: ContinuationRequestFailed(conversation, operation_id, error, error_class)
    requires: conversation.core_status = awaiting_continuation
    requires: conversation.continuation_operation_id = operation_id
    ensures: conversation.core_status = recoverable_continuation_failure
    ensures: conversation.continuation_operation_id = operation_id
    ensures: conversation.continuation_error_message = error
    ensures: conversation.continuation_error_class = error_class
    ensures: ContinuationRetryOffered(conversation, operation_id)
}

rule UserRetriesContinuation {
    when: UserTriggersContinuation(conversation, operation_id)
    requires: conversation.core_status = recoverable_continuation_failure
    requires: conversation.continuation_operation_id = operation_id
    ensures: conversation.core_status = awaiting_continuation
    ensures: conversation.continuation_operation_id = operation_id
    ensures: conversation.retry_attempt = previous(conversation.retry_attempt) + 1
    ensures: ContinuationRequested(conversation, operation_id, conversation.rejected_tool_calls)
}

-- Continuation summary generation is not user-cancellable. The UserConversation
-- surface does not expose UserCancels while awaiting_continuation, so this event
-- never arrives from the UI. Should one reach the reducer anyway, it is an
-- invalid transition: the conversation stays in awaiting_continuation and the
-- in-flight continuation request is not aborted. There is no graceful absorb and
-- no distinct cancellation signal — the defensive arm exists only to keep the
-- in-flight request alive rather than tear it down.
rule RejectCancelDuringContinuation {
    when: UserCancels(conversation)
    requires: conversation.core_status = awaiting_continuation
    ensures: TransitionRejected(conversation)
    ensures: conversation.core_status = awaiting_continuation
    ensures: not LlmAborted(conversation)
}

rule ContinuationRetryableError {
    when: LlmErrors(conversation, message, error_class, attempt)
    requires: conversation.core_status = awaiting_continuation
    requires: error_class = retryable
    requires: attempt < config.max_retry_attempts
    ensures: conversation.retry_attempt = attempt + 1
    ensures: conversation.continuation_operation_id = previous(conversation.continuation_operation_id)
    ensures: RetryScheduled(conversation, delay: 2.seconds * attempt)
}

rule ContinuationNonRecoverableError {
    when: LlmErrors(conversation, message, error_class, attempt)
    requires: conversation.core_status = awaiting_continuation
    requires: error_class = non_retryable or attempt >= config.max_retry_attempts
    ensures: conversation.core_status = recoverable_continuation_failure
    ensures: conversation.continuation_operation_id = previous(conversation.continuation_operation_id)
    ensures: conversation.continuation_error_message = message
    ensures: conversation.continuation_error_class = error_class
    ensures: ContinuationRetryOffered(conversation, conversation.continuation_operation_id)
}

rule ResumeInterruptedContinuation {
    when: RuntimeStarts(conversation)
    requires: conversation.core_status = awaiting_continuation
    ensures: ContinuationRequested(
        conversation,
        conversation.continuation_operation_id,
        conversation.rejected_tool_calls
    )
}

rule IgnoreStaleOrDuplicateContinuationResult {
    when: ContinuationSummaryReady(conversation, operation_id, summary)
    requires: conversation.core_status != awaiting_continuation
        or conversation.continuation_operation_id != operation_id
    ensures: conversation.core_status = previous(conversation.core_status)
    ensures: ContinuationResultIgnored(conversation, operation_id)
}

rule UserStartsContinuationConversation {
    when: UserStartsContinuationConversation(conversation, new_conv, handoff_text, first_message_id)
    requires: conversation.parent_status = context_exhausted
    requires: conversation.continued_in_conv_id = absent
    requires:
        conversation.product_conversation.kind = coordinator
        or conversation.product_lifecycle = open
    ensures: conversation.continued_in_conv_id = new_conv
    ensures: new_conv.product_conversation = conversation.product_conversation
    ensures: new_conv.mode = conversation.mode
    ensures: new_conv.working_dir = conversation.working_dir
    ensures: SuccessorFirstUserMessageAccepted(new_conv, handoff_text, first_message_id)
}

rule ContinuationHandoffBecomesBoundary {
    when: UserStartsContinuationConversation(conversation, new_conv, handoff_text, first_message_id)
    requires: conversation.parent_status = context_exhausted
    requires: conversation.continued_in_conv_id = absent
    requires:
        conversation.product_conversation.kind = coordinator
        or conversation.product_lifecycle = open
    ensures: conversation.parent_status = handed_off
    ensures: conversation.continuation_boundary_summary = conversation.continuation_summary

    @guidance
        -- The exact persisted continuation summary becomes the one visible
        -- boundary at the predecessor/successor join. The user-selected handoff
        -- text is accepted atomically as the successor's first user message via
        -- the client-generated first_message_id, and the boundary summary is not
        -- duplicated as an ordinary transcript message on either side.
}

rule ContinuationBoundaryPersistenceSignature {
    when: UserStartsContinuationConversation(conversation, new_conv, handoff_text, first_message_id)
    requires: conversation.parent_status = context_exhausted
    requires: conversation.continued_in_conv_id = absent
    requires: conversation.product_conversation.kind = ordinary
    requires: conversation.product_lifecycle = open
    ensures: ContinuationBoundaryPersisted(
        root_conversation_id: conversation.product_conversation,
        predecessor_conversation_id: conversation,
        successor_conversation_id: new_conv,
        summary: conversation.continuation_summary
    )

    @guidance
        -- Persistence owns only the durable continuation boundary fact: root identity,
        -- predecessor/successor join, and exact stored summary. It does not mint a
        -- root-stream sequence id itself. Live SSE projection must bridge this
        -- persisted boundary through the RootStreamLedger before broadcast so the
        -- producer signature stays identical for bedrock, replay projection, and
        -- connected root subscribers.
}

rule ProductConversationRouteResolvesLegacyMemberLinks {
    when: ProductConversationRouteRequested(target_row)
    let root_row = sole_conversation_without_predecessor(target_row.product_conversation)
    let latest_row = sole_conversation_without_successor(target_row.product_conversation)

    ensures: ProductConversationRouteResolved(
        product_conversation: target_row.product_conversation,
        route_target: target_row.product_conversation,
        anchor_row: target_row,
        root_row: root_row,
        live_target: latest_row
    )

    @guidance
        -- Open, History, search, provenance, and legacy member links all resolve to
        -- the same stable ProductConversation route keyed by the aggregate durable id.
        -- Root/member/latest transcript-row identities remain derived views inside
        -- that route: explicit links keep member anchoring, while the latest row is
        -- the default live target derived from topology.
}

rule ProductConversationTranscriptProjectsChronologically {
    when: ProductConversationProjectionRequested(product_conversation)
    ensures: TranscriptRowsProjectedChronologically(product_conversation)
    ensures: ContinuationBoundariesProjectedBetweenAdjacentRows(product_conversation)
    ensures: PersistedMessagesRemainTranscriptAuthority(product_conversation)

    @guidance
        -- Projection walks transcript_rows from transcript_root through
        -- continued_in_conv_id to the latest row, preserving message chronology and
        -- row/message identity across reload, reconnect, pagination, and
        -- virtualization. Boundaries render exactly once between adjacent rows using
        -- the predecessor continuation_boundary_summary plus the continued_in_conv_id
        -- edge to its successor; earlier full transcripts are not injected into the
        -- successor and boundary summaries are not duplicated as ordinary messages.
}

rule ProductConversationHistoryProjectionIsReadOnly {
    when: ProductConversationProjectionRequested(product_conversation)
    requires: product_conversation.kind = ordinary
    requires: product_conversation.lifecycle = history
    ensures: TranscriptProjectionReadOnly(product_conversation)
    ensures: OrdinaryInputHidden(product_conversation)

    @guidance
        -- History is the same unified transcript surface projected from the same
        -- ordinary aggregate; it is read-only and exposes no ordinary message input.
}

rule ProductConversationOpenProjectionKeepsHandedOffRowsInsideOpen {
    when: ProductConversationProjectionRequested(product_conversation)
    requires: product_conversation.kind = ordinary
    requires: product_conversation.lifecycle = open
    requires: exists Parent{product_conversation: product_conversation, parent_status: handed_off}
    ensures: HandedOffRowsProjectedInsideOpenAggregate(product_conversation)

    @guidance
        -- A handed_off predecessor is a read-only transcript segment within the live
        -- Open aggregate while the latest successor remains Open. It is not projected
        -- as a History conversation.
}

rule CoordinatorProjectionStaysChatOnly {
    when: ProductConversationProjectionRequested(product_conversation)
    requires: product_conversation.kind = coordinator
    ensures: TranscriptProjectionWritable(product_conversation)
    ensures: CloseControlHidden(product_conversation)
    ensures: DeleteControlHidden(product_conversation)

    @guidance
        -- The Coordinator keeps the normal transcript/composer/runtime surface but
        -- is structurally outside the ordinary ProductConversation Open/History
        -- lifecycle and its close/delete controls.
}

rule ProductConversationListProjectsOncePerRoot {
    when: ProductConversationListProjectionRequested(product_conversation)
    ensures: ProductConversationListedOnce(product_conversation)
    ensures: ProductConversationListUsesRootTitle(product_conversation)
    ensures: ProductConversationListOrdersByLatestActivity(product_conversation)

    @guidance
        -- Ordinary and Coordinator product conversations both list once per durable
        -- root, but only ordinary rows participate in the Open/History lifecycle
        -- facets and actions.
}

-- ===========================================================
-- PARENT 8. TERMINAL (REQ-BED-029)
-- ===========================================================


rule UserRequestsCloseConversation {
    when: UserRequestsCloseConversation(conversation, attempt_id)
    requires: conversation.close_eligible
    requires: not exists Parent{product_conversation: conversation.product_conversation, parent_status: awaiting_task_approval}
    requires: not exists Parent{product_conversation: conversation.product_conversation, core_status: awaiting_continuation}
    requires:
        not exists CloseObligation{product_conversation: conversation.product_conversation}
            where phase in {
                awaiting_blocker_resolution,
                awaiting_stop_work_confirmation,
                settling_active_work,
                cancel_requested_during_settlement,
                awaiting_retirement_inspection,
                awaiting_loss_confirmation,
                retirement_requested,
                needs_repair
            }
    ensures: CloseObligation.created(
        attempt_id: attempt_id,
        product_conversation: conversation.product_conversation,
        phase: awaiting_blocker_resolution
    )
    ensures: CloseEvaluationRequested(conversation.product_conversation, attempt_id)

    @guidance
        -- Close is a durable root-owned obligation separate from the row-local
        -- message-admission state. Each request carries one durable attempt_id,
        -- and at most one non-completed attempt may exist per ProductConversation.
        -- Creation of the durable obligation and emission of the aggregate-scoped
        -- CloseEvaluationRequested(product_conversation, attempt_id) event are one
        -- atomic decision boundary so busy and idle branches advance from the same
        -- committed attempt without an emit-vs-persist race.
        -- Admission uses close_eligible rather than row_accepts_user_messages so the
        -- latest context_exhausted row with no continuation may still close, while
        -- handed-off predecessors, nonlatest rows, task-approval blockers, and
        -- continuation-in-progress blockers remain ineligible per the action table.
}

rule CloseObligationRequiresExplicitStopWorkConfirmation {
    when: CloseEvaluationRequested(product_conversation, attempt_id)
    requires: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = awaiting_blocker_resolution
    requires: exists Parent{product_conversation: product_conversation, is_latest_row: true, is_busy: true}
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = awaiting_stop_work_confirmation
    ensures: StopWorkAndContinueClosingConfirmationRequired(product_conversation)
}

rule CloseObligationUserConfirmsStopWork {
    when: UserConfirmsStopWorkAndContinueClosing(product_conversation, attempt_id)
    requires: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = awaiting_stop_work_confirmation
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = settling_active_work
    ensures: CloseSettlementRequested(product_conversation, attempt_id)
}

rule CloseObligationCanBeCancelledBeforeSettlementStarts {
    when: UserCancelsClose(product_conversation, attempt_id)
    requires: CloseObligation.exists(product_conversation: product_conversation, attempt_id: attempt_id)
    requires: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        awaiting_blocker_resolution,
        awaiting_stop_work_confirmation,
        awaiting_retirement_inspection,
        awaiting_loss_confirmation
    }
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = completed
    ensures: CloseObligationCancelled(product_conversation, attempt_id)
}

rule CloseObligationQueuesCancellationDuringSettlement {
    when: UserCancelsClose(product_conversation, attempt_id)
    requires: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = settling_active_work
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = cancel_requested_during_settlement
    ensures: CloseSettlementCancellationQueued(product_conversation, attempt_id)
}

rule RepeatedCloseCancellationDuringSettlementIsIdempotent {
    when: UserCancelsClose(product_conversation, attempt_id)
    requires: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = cancel_requested_during_settlement
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = cancel_requested_during_settlement
    ensures: CloseCancellationAlreadyPending(product_conversation, attempt_id)
    ensures: not AdditionalCloseSettlementCancellationQueued(product_conversation, attempt_id)
}

rule CloseObligationBeginsSettlementWithoutBusyWork {
    when: CloseEvaluationRequested(product_conversation, attempt_id)
    requires: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = awaiting_blocker_resolution
    requires: not exists Parent{product_conversation: product_conversation, is_latest_row: true, is_busy: true}
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = settling_active_work
    ensures: CloseSettlementRequested(product_conversation, attempt_id)
    ensures: CloseSettlementProgressed(product_conversation, attempt_id)

    @guidance
        -- Entering settlement without ordinary busy ownership still emits one
        -- exact-attempt progress pass so downstream settlement consumers can
        -- reevaluate whether any typed close-owned authorities remain.
}

rule CloseObligationWaitsForSettlement {
    when: CloseSettlementProgressed(product_conversation, attempt_id)
    requires: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in { settling_active_work, cancel_requested_during_settlement }
    requires: not all_close_owned_authorities_released(product_conversation)
    ensures: CloseSettlementStillOwed(product_conversation)

    @guidance
        -- Settlement stays owed until every close-owned authority for the latest
        -- row has released: ordinary bedrock busy ownership plus any typed direct-
        -- turn, wake, tool, sub-agent, or background authorities rooted in that
        -- same product conversation.
}

rule CloseObligationRequestsRetirementInspectionAfterSettlement {
    when: CloseSettlementProgressed(product_conversation, attempt_id)
    requires: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = settling_active_work
    requires: all_close_owned_authorities_released(product_conversation)
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = awaiting_retirement_inspection
    ensures: RetirementInspectionRequested(product_conversation, attempt_id)
}

rule CloseSettlementCancellationCompletesAfterBusyOwnershipReleased {
    when: CloseSettlementProgressed(product_conversation, attempt_id)
    requires: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = cancel_requested_during_settlement
    requires: all_close_owned_authorities_released(product_conversation)
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = completed
    ensures: CloseObligationCancelled(product_conversation, attempt_id)

    @guidance
        -- A cancellation request during settlement does not interrupt the same
        -- settlement pass that releases latest-row ownership. Phoenix first waits
        -- for every close-owned authority to clear through settlement, then marks
        -- the Close obligation completed and emits CloseObligationCancelled. It
        -- does not request retirement inspection, enter retirement_requested, or
        -- continue into destructive Close after the user has cancelled. The user
        -- may later start a fresh Close from the still-open ProductConversation.
}

rule RetirementInspectionShowsNoConfirmationRequired {
    when: RetirementInspectionCompletedWithoutConfirmation(product_conversation, attempt_id, inspection_generation, inspection_fingerprint)
    requires: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = awaiting_retirement_inspection
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = retirement_requested
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.inspection_generation = inspection_generation
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.inspection_fingerprint = inspection_fingerprint
    ensures: ResourceRetirementRequested(product_conversation, attempt_id)
}

rule RetirementInspectionRequiresLossConfirmation {
    when: RetirementInspectionRequiresConfirmation(product_conversation, attempt_id, inspection_generation, inspection_fingerprint)
    requires: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = awaiting_retirement_inspection
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = awaiting_loss_confirmation
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.inspection_generation = inspection_generation
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.inspection_fingerprint = inspection_fingerprint
}

rule BoundLossConfirmationRequestsRetirement {
    when: ResourceRetirementRequested(product_conversation, attempt_id)
    requires: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = awaiting_loss_confirmation
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = retirement_requested

    @guidance
        -- Crossing into retirement_requested commits Close past the user-cancellable
        -- phase boundary. Work-lifecycle owns the atomic re-inspection decision at the
        -- confirmation click and emits ResourceRetirementRequested only when the freshly
        -- recomputed inspection still matches the stored evidence for this exact attempt.
}

rule ChangedInspectionInvalidatesOutstandingConfirmation {
    when: RetirementInspectionChanged(product_conversation, attempt_id)
    requires: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = awaiting_loss_confirmation
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = awaiting_retirement_inspection
    ensures: RetirementInspectionRequested(product_conversation, attempt_id)
}

rule CloseRetirementCompletionFinalizesAggregateHistory {
    when: ResourceRetirementCompleted(product_conversation, attempt_id)
    requires: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in { retirement_requested, needs_repair }
    requires: product_conversation.lifecycle = open
    ensures: CloseOutcomeSystemMessagePersisted(product_conversation)
    ensures: product_conversation.lifecycle = history
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = completed
    ensures: ProductConversationEnteredHistory(product_conversation, attempt_id)

    @guidance
        -- Close finalization is one transaction boundary: first persist the durable
        -- synthetic Close-outcome message on the aggregate transcript, then commit the
        -- aggregate lifecycle transition to History, then complete the Close obligation,
        -- and only then expose the aggregate-entered-History event for downstream
        -- announcement and SSE projection.
}

rule CloseRetirementFailureLeavesOpenNeedsRepair {
    when: ResourceRetirementFailed(product_conversation, attempt_id)
    requires: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in { retirement_requested, needs_repair }
    requires: product_conversation.lifecycle = open
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = needs_repair
    ensures: CloseNeedsRepairVisible(product_conversation, attempt_id)
}

rule CloseNeedsRepairCanRetryRetirement {
    when: CloseRetirementRetryRequested(product_conversation, attempt_id)
    requires: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = needs_repair
    requires: CloseNeedsRepairVisible(product_conversation, attempt_id)
    ensures: CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = retirement_requested
    ensures: ResourceRetirementRequested(product_conversation, attempt_id)

    @guidance
        -- Retry is exposed on the same visible needs-repair attempt the user sees.
        -- It carries the exact attempt_id and requests retirement again without any
        -- local project-surface lifecycle mutation. Automatic operator repair may also
        -- complete by driving the same exact-attempt retirement request path, but no
        -- hidden synthetic attempt or phase change bypasses this authority.
}

------------------------------------------------------------
-- Rules: Sub-agent-only
------------------------------------------------------------

-- ===========================================================
-- SUB-AGENT 1. IMPLICIT COMPLETION
-- ===========================================================

rule SubAgentImplicitCompletion {
    when: LlmResponds(conversation, content, tool_calls, end_turn, usage)
    requires: conversation.core_status = llm_requesting
    requires: tool_calls.count = 0
    requires: content = null
    ensures: conversation.sub_agent_status = completed
    ensures: conversation.completion_result = ""
    ensures: SubAgentCompleted(conversation)
}

-- Sub-agent text-only with content -> also implicit completion
rule SubAgentTextOnlyCompletion {
    when: LlmResponds(conversation, content, tool_calls, end_turn, usage)
    requires: conversation.core_status = llm_requesting
    requires: tool_calls.count = 0
    requires: content != null
    ensures: conversation.sub_agent_status = completed
    ensures: conversation.completion_result = extract_text(content)
    ensures: SubAgentCompleted(conversation)
}

-- ===========================================================
-- SUB-AGENT 2. SUBMIT RESULT / ERROR
-- ===========================================================

rule SubAgentSubmitsResult {
    when: LlmResponds(conversation, content, tool_calls, end_turn, usage)
    requires: conversation.core_status = llm_requesting
    requires: tool_calls.count = 1
    requires: tool_calls.first.name = "submit_result"
    ensures: conversation.sub_agent_status = completed
    ensures: conversation.completion_result = parse_result(tool_calls.first)
    ensures: SubAgentCompleted(conversation)
}

rule SubAgentSubmitsError {
    when: LlmResponds(conversation, content, tool_calls, end_turn, usage)
    requires: conversation.core_status = llm_requesting
    requires: tool_calls.count = 1
    requires: tool_calls.first.name = "submit_error"
    ensures: conversation.sub_agent_status = failed
    ensures: conversation.failure_error = parse_error(tool_calls.first)
    ensures: SubAgentCompleted(conversation)
}

-- ===========================================================
-- SUB-AGENT 3. CANCEL -> FAILED (not idle)
-- ===========================================================

rule SubAgentCancelled {
    when: UserCancels(conversation)
    requires: not conversation.is_terminal
    ensures: conversation.sub_agent_status = failed
    ensures: conversation.failure_error = UserCancels.reason or "Cancelled"
    ensures: SubAgentCompleted(conversation)
}

-- ===========================================================
-- SUB-AGENT 4. NON-RETRYABLE ERROR -> FAILED
-- ===========================================================

rule SubAgentLlmError {
    when: LlmErrors(conversation, message, error_class, attempt)
    requires: conversation.core_status = llm_requesting
    requires: error_class = non_retryable or attempt >= config.max_retry_attempts
    ensures: conversation.sub_agent_status = failed
    ensures: conversation.failure_error = message
    ensures: conversation.failure_error_class = error_class
    ensures: SubAgentCompleted(conversation)
}

-- ===========================================================
-- SUB-AGENT 5. CONTEXT EXHAUSTION -> FAILED
-- ===========================================================

rule SubAgentContextExhausted {
    when: LlmResponds(conversation, content, tool_calls, end_turn, usage)
    requires: conversation.core_status = llm_requesting
    requires: conversation.context_at_threshold
    ensures: conversation.sub_agent_status = failed
    ensures: conversation.failure_error = "Context exhausted before result submission"
    ensures: SubAgentCompleted(conversation)
}

-- ===========================================================
-- SUB-AGENT 6. GRACE TURN (REQ-BED-026)
-- ===========================================================

rule SubAgentTurnLimitGraceTurn {
    when: TurnLimitReached(conversation)
    requires: not conversation.grace_turn_granted
    ensures: conversation.grace_turn_granted = true
    ensures: MetaUserMessageInjected(conversation, content: GraceTurnTerminalGuidance(conversation.mode))
    ensures: GraceTurnGuidanceNamesUsefulTerminalTools(conversation, tools: {"submit_result", "submit_error"})
    ensures: LlmRequestDispatched(conversation)

    @guidance
        -- Grace turn is an executor-level concern: the executor injects a
        -- user-role meta message so the guidance is visible to the LLM, then
        -- allows one more LLM request. Status stays at llm_requesting (no
        -- transition). Explore guidance asks for findings via submit_result;
        -- Work guidance says submit_result is useful only for completed work and
        -- routes unfinished required edits through submit_error. Text-only
        -- implicit completion remains a bedrock terminal path when admitted by the
        -- reducer; wake delivery preserves that cause separately from explicit
        -- submit_result. Other tool calls are not modeled as forbidden by the
        -- runtime; they simply do not produce the terminal outcome needed to avoid
        -- GraceTurnExhausted.
}

rule SubAgentTurnLimitHardStop {
    when: GraceTurnExhausted(conversation, partial_result)
    requires: conversation.grace_turn_granted = true
    ensures:
        if partial_result != null:
            conversation.sub_agent_status = completed
            conversation.completion_result = partial_result
            SubAgentCompleted(conversation) with outcome = success
        else:
            conversation.sub_agent_status = failed
            conversation.failure_error = "Turn limit exceeded, no output"
            SubAgentCompleted(conversation) with outcome = failure
}

------------------------------------------------------------
-- Rules: Lifecycle and cross-cutting
------------------------------------------------------------

-- Lifecycle announcement: fires once from the singular root-owned product lifecycle.
rule ConversationLifecycleEnteredHistory {
    when: ProductConversationEnteredHistory(product_conversation, attempt_id)
    ensures: ConversationBecameHistory(product_conversation, attempt_id)

    @guidance
        -- Downstream specs consume one aggregate lifecycle transition from the
        -- ProductConversation itself rather than inferring History from row-local
        -- conditions such as handed_off or context_exhausted. The producer and every
        -- consumer use the same (product_conversation, attempt_id) signature so the
        -- single aggregate announcement preserves which durable Close attempt entered
        -- History.
}

rule UserStartsFollowUpFromHistory {
    when: UserStartsFollowUpConversation(source_product_conversation, follow_up_objective)
    requires: source_product_conversation.kind = ordinary
    requires: source_product_conversation.lifecycle = history

    let target = ProductConversation{kind: ordinary, lifecycle: open}
    let target_conversation = Conversation{kind: Parent, product_conversation: target}

    ensures: FollowUpProvisioningRequested(source_product_conversation, target, target_conversation, follow_up_objective)
    ensures: ConversationSourceRelationCreated(target, source_product_conversation, follow_up)
    ensures: NoSourceTranscriptInjected(target_conversation)

    @guidance
        -- Follow-up is a typed command from History. It creates a separate Open
        -- aggregate with fresh environment intent and visible follow_up provenance;
        -- the source transcript is not injected.
}

-- REQ-BED-032: User hard-deletes a conversation when the conversation is
-- not busy. Cascade cleanup runs as direct function calls in the handler;
-- the SSE wire event ConversationHardDeleted is emitted last for UI
-- consumers. There is no event-bus / subscriber-registration pattern.
rule UserHardDeletesConversationRule {
    when: UserHardDeletesConversation(conversation)
    let aggregate = conversation.product_conversation

    requires: aggregate.kind = ordinary
    requires: not conversation.is_busy
    requires: aggregate.lifecycle = history
    requires: DestructiveLifecycleMayProceed(conversation, hard_delete)

    ensures: BashHandlesCleanedUp(aggregate)
        -- Direct call: cascade_bash_on_delete (REQ-BASH-006).
    ensures: TmuxServerCleanedUp(aggregate)
        -- Direct call: cascade_tmux_on_delete (REQ-TMUX-007).
    ensures: BrowserSessionsCleanedUp(aggregate)
        -- Direct call: aggregate-scoped browser lifecycle cascade.
    ensures: ProjectWorktreeCleanedUp(aggregate)
        -- Direct call: cascade_projects_on_delete
        -- (specs/projects/ subscriber rule).
    ensures: AggregateTranscriptRowsRemoved(aggregate)
    ensures: SolelyOwnedConversationMessagesRemoved(aggregate)
    ensures: SolelyOwnedConversationToolCallRowsRemoved(aggregate)
    ensures: SolelyOwnedConversationApprovalRowsRemoved(aggregate)
    ensures: SolelyOwnedConversationAttachmentRowsRemoved(aggregate)
    ensures: SolelyOwnedConversationRetrievalChunkRowsRemoved(aggregate)
    ensures: SolelyOwnedConversationRetrievalLocatorRowsRemoved(aggregate)
    ensures: SolelyOwnedConversationFtsRowsRemoved(aggregate)
    ensures: RepeatedDeleteRemainsIdempotent(aggregate)
    ensures: NonCascadeProvenanceRelationsPreservedAsTypedTombstones(aggregate)
    ensures: NonCascadeBranchAndPullRequestRelationsRemain(aggregate)
    ensures: ProductConversationRemoved(aggregate)
    ensures: ConversationHardDeleted(aggregate)
        -- SSE wire event for UI consumers (sidebar refresh, etc.).
        -- Emitted AFTER aggregate removal; not a cleanup-dispatch hook.

    @guidance
        -- Handler sequence (in src/api/handlers.rs::delete_conversation):
        --   1. Cancellation pre-step: if conversation is busy, either
        --      reject with "cancel first" (RejectHardDeleteWhileBusy
        --      governs) or issue cancellation and wait for idle. The
        --      requires: not conversation.is_busy above is the post-
        --      cancel contract that this rule's effects are predicated
        --      on.
        --   2. cascade_bash_on_delete — kill live handles, drop tombstones.
        --   3. cascade_tmux_on_delete — kill-server, unlink socket, drop
        --      registry entry.
        --   4. cascade_projects_on_delete — aggregate-scoped worktree cleanup if
        --      applicable.
        --   5. cascade_browser_on_delete — drop aggregate-scoped browser sessions
        --      unless another live owner retains the same WorkScope.
        --   6. db.delete_product_conversation(product_conversation_id) — remove
        --      every transcript row and solely-owned child row in the History
        --      aggregate, including message rows, tool-call rows, approval rows,
        --      attachment rows, retrieval chunk rows, retrieval locator rows,
        --      and FTS rows, while retaining typed tombstones for surviving
        --      provenance links and leaving separately-owned branch /
        --      pull-request relations untouched.
        --      Re-running the same delete after rows are already gone still
        --      returns the same idempotent success post-state.
        --   7. Broadcast ConversationHardDeleted SSE wire event.
        --   8. Return success to the user.
        --
        -- Each cascade step (2-4) logs failures at WARN with structured
        -- fields sufficient for manual cleanup (pids, socket paths,
        -- worktree paths) and continues. Phoenix does NOT attempt
        -- automatic recovery on subsequent startup; orphans created by
        -- failed cleanup are the operator's problem (deliberate v1 scope
        -- decision — see REQ-BED-032 rationale).
        --
        -- Allium ensures clauses are concurrent assertions about the
        -- post-state, not a temporal sequence. The handler implementation
        -- in @guidance specifies the actual order. Allium's role here is
        -- to assert "after the handler returns, all of these effects
        -- have happened." A property test that runs the handler and
        -- checks the post-state suffices.
        --
        -- Close conversation / History and hard-delete are distinct flows.
        -- This hard-delete cascade does not model Close orchestration or
        -- ordinary WorkScope retirement authority; the Open -> History
        -- transition is owned by ProductConversationTransitionsToHistory, and
        -- WorkScope-owned worktree/terminal retirement remains owned by the
        -- Close retirement path. Branches remain observed repository facts.
        -- History itself owns no resources.
        -- UI-only state changes (close-tab, blur) do NOT trigger this rule
        -- — tmux servers and browser sessions deliberately survive them
        -- (specs/tmux-integration/ REQ-TMUX-008; specs/browser-tool/
        -- REQ-BROWSER-WS-003).
}

-- REQ-BED-032: Reject the hard-delete request when the conversation is
-- busy. Mirrors RejectMessageWhileBusy at REQ-BED-002; the API layer can
-- choose between this rejection branch or a cancel-and-retry branch
-- (which feeds back into UserHardDeletesConversationRule above once the
-- conversation reaches idle).
rule RejectHardDeleteWhileBusy {
    when: UserHardDeletesConversation(conversation)

    requires: conversation.is_busy

    ensures: HardDeleteRejected(conversation, reason: cancel_first)
}

rule RepeatedHardDeleteOfAbsentAggregateIsIdempotent {
    when: UserHardDeletesProductConversation(product_conversation_id)
    requires: not exists ProductConversation{id: product_conversation_id}
    ensures: HardDeleteSucceeded(product_conversation_id)
    ensures: ProductConversationRemainsAbsent(product_conversation_id)

    @guidance
        -- Retry reaches the same success post-state even after the aggregate row is
        -- gone; idempotence does not require reloading a deleted row first.
}

-- REQ-BED-017: Mode change injects synthetic message
rule ModeChangeNotification {
    when: ModeTransitioned(conversation, from, to)
    ensures: SyntheticMessageInjected(conversation, about: mode_changed)
}

-- REQ-BED-007: Persist state before effects (cross-cutting)
-- Every rule that changes status implicitly requires state persistence
-- before side effects execute.

-- REQ-BED-007: ordinary interrupted turns restart from idle. Durable
-- continuation operations retain their operation identity and recovery state.
rule ServerRestartOrdinaryConversation {
    when: ServerRestarted(conversation)
    requires: conversation.is_busy
    requires: not committed_steering_turn_awaiting_first_response(conversation)
    requires: conversation.core_status not in {
        awaiting_continuation,
        recoverable_continuation_failure
    }
    requires: conversation.parent_status != awaiting_recovery
        or conversation.recovery_resume_target = conversation_turn
    ensures: conversation.core_status = idle
}

rule ServerRestartCommittedSteeringTurn {
    when: ServerRestarted(conversation)
    requires: conversation.core_status = llm_requesting
    requires: committed_steering_turn_awaiting_first_response(conversation)
    ensures: conversation.core_status = previous(conversation.core_status)
    ensures: LlmRequestDispatched(conversation)

    @guidance
        -- The bounded owner is true only when the latest transcript row is a
        -- user message with an immutable accepted-steering identity and that
        -- exact message is absent from the pending queue. The first provider
        -- response changes the transcript tail and ends this exception. No
        -- steering lifecycle or second queue authority is introduced.
}

rule ServerRestartPendingContinuation {
    when: ServerRestarted(conversation)
    requires: conversation.core_status in {
        awaiting_continuation,
        recoverable_continuation_failure
    }
        or (conversation.parent_status = awaiting_recovery
            and conversation.recovery_resume_target = continuation_summary)
    ensures: conversation.core_status = previous(conversation.core_status)
    ensures: conversation.parent_status = previous(conversation.parent_status)
    ensures: ContinuationOperationMaterialized(conversation)
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Sub-agents cannot spawn further sub-agents (was a variant-level invariant,
-- moved here because Allium v3 grammar does not support invariants inside
-- `variant` bodies).
invariant NoRecursiveSubAgents {
    for c in SubAgent:
        c.sub_agents.count = 0
}

-- Sub-agent notifies parent exactly once
invariant SubAgentNotifiesParentOnce {
    for c in SubAgent:
        count(SubAgentCompleted(c)) <= 1
}

-- Grace turn resolves to terminal
invariant GraceTurnOutcome {
    for c in SubAgent:
        c.grace_turn_granted and c.is_terminal
            implies (c.sub_agent_status = completed or c.sub_agent_status = failed)
}

-- REQ-BED-001: Pure state transitions
-- Enforced by construction: transitions are pure functions.

-- REQ-BED-004: Tool round atomicity
-- tool_use count = tool_result count at checkpoint time.

-- REQ-BED-008: Sub-agent fan-in conservation
-- pending + completed = total spawned (constant).
-- Enforced by construction: each SubAgentReportsResult moves one.

invariant ThresholdOrdering {
    config.context_continuation_threshold > config.context_warning_threshold
}

invariant SpawnLimit {
    for c in Conversations:
        c.core_status = executing_tools
            implies c.accumulated_sub_agents.count <= config.max_sub_agents_per_spawn
}

invariant RootLifecycleAuthority {
    for c in Parent:
        c.product_conversation.kind = ordinary implies c.product_lifecycle = c.product_conversation.lifecycle
}

invariant LatestRowDerivedFromTopology {
    for c in Parent:
        c.is_latest_row = (c.continued_in_conv_id = absent)
}

invariant ProductConversationHasSingleRootRow {
    for pc in ProductConversation:
        count(Parent{product_conversation: pc} where not exists Parent{product_conversation: pc, continued_in_conv_id: this}) = 1
}

invariant ProductConversationHasSingleTopologyLatestRow {
    for pc in ProductConversation:
        count(Parent{product_conversation: pc, continued_in_conv_id: absent}) = 1
}

invariant ProductConversationHasAtMostOneActiveCloseAttempt {
    for pc in ProductConversation:
        count(CloseObligation where product_conversation = pc and phase in {
            awaiting_blocker_resolution,
            awaiting_stop_work_confirmation,
            settling_active_work,
            cancel_requested_during_settlement,
            awaiting_retirement_inspection,
            awaiting_loss_confirmation,
            retirement_requested,
            needs_repair
        }) <= 1
}

invariant ContinuationBoundarySummaryLivesOnHandedOffPredecessor {
    for conversation in Parent:
        conversation.continuation_boundary_summary when conversation.parent_status = handed_off
}

-- REQ-BED-005a: Bounded cancellation liveness.
-- cancelling_tool and cancelling_sub_agents are never livelocks: each has a
-- deadline-driven exit to idle (CancellingToolDeadlineFires,
-- CancellingSubAgentsDeadlineFires) that does not depend on the running task or
-- a pending sub-agent ever returning. The time from a cancellation request to a
-- terminal-direction state is bounded by config.cancellation_deadline regardless
-- of tool cooperation. Enforced by construction: the deadline rules' `when:`
-- (CancellationDeadlineExpires) fires unconditionally on every conversation in a
-- cancellation status, so neither status can persist past the deadline.

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor User {
    identified_by: Parent
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface UserConversation {
    facing user: User

    context conversation: Parent

    exposes:
        conversation.core_status
        conversation.parent_status
        conversation.mode
        conversation.context_usage_ratio
        conversation.context_warning
        conversation.proposal_snapshot when conversation.parent_status = awaiting_task_approval
        conversation.pending_questions when conversation.parent_status = awaiting_user_response
        conversation.error_message when conversation.core_status = error
        conversation.recovery_message when conversation.parent_status = awaiting_recovery
        conversation.recovery_kind when conversation.parent_status = awaiting_recovery
        conversation.recovery_resume_target when conversation.parent_status = awaiting_recovery
        conversation.continuation_summary when conversation.parent_status = context_exhausted
        conversation.continuation_boundary_summary when conversation.parent_status = handed_off
        conversation.product_conversation.transcript_rows when not exists Conversation{product_conversation: conversation.product_conversation, continued_in_conv_id: conversation}
        conversation.product_conversation.transcript_rows when conversation.continued_in_conv_id = absent

    provides:
        UserSendsMessage(conversation, text, images?)
            when conversation.core_status in { idle, error }
        UserDismissesError(conversation)
            when conversation.core_status = error
        UserCancels(conversation)
            when conversation.is_busy
                 or conversation.parent_status in {
                    awaiting_task_approval,
                    awaiting_recovery
                 }
        TaskApprovalDecided(conversation, decision)
            when conversation.parent_status = awaiting_task_approval
        UserAnswersQuestion(conversation, answers, annotations?)
            when conversation.parent_status = awaiting_user_response
        UserDismissesQuestion(conversation)
            when conversation.parent_status = awaiting_user_response
        UserTriggersContinuation(conversation, operation_id)
            when conversation.core_status in { idle, recoverable_continuation_failure }
        UserStartsContinuationConversation(conversation, new_conv, handoff_text, first_message_id)
            when conversation.parent_status = context_exhausted
                 and conversation.continued_in_conv_id = absent
                 and (
                    conversation.product_conversation.kind = coordinator
                    or conversation.product_lifecycle = open
                 )
        UserRequestsCloseConversation(
            conversation,
            next_close_attempt_id(conversation.product_conversation)
        )
            when conversation.close_eligible
                 and conversation.parent_status != awaiting_task_approval
                 and conversation.core_status != awaiting_continuation
                 and not exists CloseObligation{product_conversation: conversation.product_conversation}
                     where phase in {
                        awaiting_blocker_resolution,
                        awaiting_stop_work_confirmation,
                        settling_active_work,
                        cancel_requested_during_settlement,
                        awaiting_retirement_inspection,
                        awaiting_loss_confirmation,
                        retirement_requested,
                        needs_repair
                     }

        UserCancelsClose(conversation.product_conversation, close.attempt_id)
            when exists close in CloseObligation{product_conversation: conversation.product_conversation}
                 and close.phase in {
                    awaiting_blocker_resolution,
                    awaiting_stop_work_confirmation,
                    awaiting_retirement_inspection,
                    awaiting_loss_confirmation,
                    settling_active_work,
                    cancel_requested_during_settlement
                 }
        UserConfirmsStopWorkAndContinueClosing(conversation.product_conversation, close.attempt_id)
            when exists close in CloseObligation{product_conversation: conversation.product_conversation}
                 and close.phase = awaiting_stop_work_confirmation
        UserConfirmsCloseAfterRetirementInspection(
            conversation.product_conversation,
            close.attempt_id,
            close.inspection_generation,
            close.inspection_fingerprint
        )
            when exists close in CloseObligation{product_conversation: conversation.product_conversation}
                 and close.phase = awaiting_loss_confirmation
                 and close.inspection_generation != absent
                 and close.inspection_fingerprint != absent

    @guarantee IdempotentMessages
        -- Duplicate message submissions (same message_id) are
        -- silently accepted without creating duplicate messages.

    @guarantee ImmediateCancel
        -- Cancellation is processed with higher priority than
        -- operation completion. Never queued behind current work.
}

-- No open questions remain.
