-- allium: 3
-- projects.allium
--
-- Phoenix Projects: Git-backed provisioning, branch observation, and
-- approved-task placement around bedrock conversations.
--
-- Scope: project detection, git-backed conversation provisioning, branch
-- observation/picker operations, approved-task placement, worktree ownership,
-- write scoping, sub-agent same-scope attachment, and restart reconciliation.
--
-- Excludes:
--   - Conversation lifecycle/state-machine behaviour (bedrock)
--   - Resource retirement/teardown orchestration (work-lifecycle)
--   - PR freshness/association semantics (pr-association)
--   - UI layout details, .gitignore management, and build-cache prewarm

use "../bedrock/bedrock.allium" as bedrock

surface TaskApprovalDecisionImport {
    facing conversation: bedrock/Conversation

    provides:
        TaskApprovalDecisionImported(conversation, decision)
            when bedrock/TaskApprovalDecided(conversation, decision)

    @guarantee TypedImportBridge
        -- Projects consumes the exact bedrock task-approval decision boundary through
        -- one local typed import surface instead of inventing an unrelated trigger.
}

surface ProvisioningCompletedImport {
    facing conversation: bedrock/Conversation

    provides:
        FreshGitWorktreeProvisioningCompleted(target, provisioned)
            when bedrock/FreshGitWorktreeProvisioningCompleted(target, provisioned)

    @guarantee TypedProvisioningCompletionBridge
        -- Projects consumes one durable typed provisioning-completed event carrying
        -- the target ProductConversation plus the attached WorkScope/worktree tuple
        -- that successful provisioning established.
}

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity GitRepository {
    root_path: String
    current_branch: String
    remote_default_branch: String?
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value WorktreePath {
    absolute_path: String
}

value BranchEntry {
    name: String
    local: Boolean
    remote: Boolean
    behind_remote: Integer?
}

value RemoteRef {
    name: String
    kind: RefKind
    sha: String
}

value LsRemoteCache {
    repo_path: String
    refs: List<RemoteRef>
    fetched_at: Timestamp
    ttl_seconds: Integer = 300
}

value ApprovedTaskIdentity {
    task_kind: taskmd | plain_brief
    task_id: String?
    priority: String?
    slug: String?
    plain_title: String?
}

value ReviewedProposalSnapshotIdentity {
    repo_relative_path: String
    task_kind: taskmd | plain_markdown
    content_digest: String
}

value ApprovedTaskSource {
    task_path: String
    title: String
    priority: String
    body: String
    identity: ApprovedTaskIdentity
    reviewed_snapshot: ReviewedProposalSnapshotIdentity
    kind: taskmd | plain_markdown
}

value ProvisionedWorkScope {
    scope: bedrock/WorkScope
    worktree_path: String
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum RefKind { branch | tag }
enum TaskFileStatus { in_progress | done | wont_do }

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity Project {
    repo: GitRepository
    canonical_default_branch: String
    ls_remote_cache: LsRemoteCache?
    branch_picker_entries: List<BranchEntry>

    conversations: bedrock/Conversation with project = this
    task_files: TaskFile with project = this

    active_task_files: task_files where status = in_progress
}

entity TaskFile {
    project: Project
    task_id: String
    title: String
    priority: String
    slug: String
    status: TaskFileStatus

    filename: derive_filename(task_id, priority, status, slug)

    transitions status {
        in_progress -> done
        in_progress -> wont_do
        terminal: done, wont_do
    }

    invariant FilenameEncodesMetadata {
        filename = derive_filename(task_id, priority, status, slug)
    }
}

entity Worktree {
    product_conversation: bedrock/ProductConversation
    project: Project
    attached_scope: WorkScope
    path: WorktreePath
    starting_branch_name: String
    starting_commit: String
    approved_task: ApprovedTaskSource?

    is_clean: git_status_clean(path)
}

value DefaultIdentityProvenance {
    branch_name: String
    source: configured_remote_default | fetched_remote_tracking | cached_remote_tracking
}

value DetachedStartFreshness {
    freshness: fresh | stale_cached
}

value ResolvedDetachedStart {
    starting_commit: String
    default_identity: DefaultIdentityProvenance
    freshness: DetachedStartFreshness
}

value UnresolvedDetachedStart {
    error: missing_canonical_default_identity | missing_canonical_default_commit
}

value DetachedStartResolution {
    outcome: resolved | unresolved
    resolved: ResolvedDetachedStart when outcome = resolved
    unresolved: UnresolvedDetachedStart when outcome = unresolved
}

entity ProvisioningFailure {
    conversation: bedrock/Conversation
    project: Project
    resolution: DetachedStartResolution
}

entity WorkScope {
    product_conversation: bedrock/ProductConversation
    project: Project
    worktree_path: WorktreePath
    canonical_default_branch: String
    detached_start_commit: String
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule ConversationRootCwdRejected {
    when: ConversationCreated(conversation, directory)

    requires: directory_resolves_to_filesystem_root(directory)
        or not directory_resolves_to_existing_directory(directory)

    ensures: ConversationCreationRejected(conversation,
        reason: "Conversation cwd must be an existing non-root directory")
}

rule GitDirectoryDetected {
    when: ConversationCreated(conversation, directory)

    requires: is_git_repository(directory)

    let repo = git_repo_at(directory)
    let default_resolution = authoritative_default_resolution(repo)

    ensures:
        if default_resolution.outcome = resolved:
            ConfiguredOrCachedDefaultIdentityResolved(repo, default_resolution.resolved.default_identity)
            and Project.created(
                repo: repo,
                canonical_default_branch: default_resolution.resolved.default_identity.branch_name
            )
        else:
            ProvisioningFailure.created(
                conversation: conversation,
                project: Project{repo: repo},
                resolution: default_resolution
            )

    @guidance
        -- Project association is keyed to the repository root, not the leaf
        -- directory the user supplied.
        -- Canonical default identity comes only from authoritative configured
        -- remote-default identity or cached local/remote-tracking evidence for
        -- that same branch. The repository's current branch is observational and
        -- never establishes canonical default ownership.
}

rule GitBackedConversationProvisioned {
    when: ConversationCreated(conversation, directory)

    requires: is_git_repository(directory)
    requires: conversation.environment_kind = git_backed

    let repo = git_repo_at(directory)
    let project = Project{repo: repo}
    let target = bedrock/ProductConversation{id: conversation.product_conversation.id}
    let resolution = detached_default_resolution(project)

    ensures:
        if resolution.outcome = resolved:
            CanonicalDefaultBranchResolved(project, resolution.resolved.default_identity.branch_name)
            and SingleBranchFetchAttempted(project, resolution.resolved.default_identity.branch_name)
            and CanonicalDefaultCommitSelected(project, resolution.resolved.default_identity.branch_name)
            and DetachedDefaultStartSelected(project, resolution.resolved)
            and (
                resolution.resolved.freshness = stale_cached
                implies CachedDefaultStartMayBeStale(project, resolution.resolved.default_identity.branch_name)
            )
            and WorkScope.created(
                product_conversation: target,
                project: project,
                worktree_path: WorktreePath { absolute_path: worktree_path(target) },
                canonical_default_branch: resolution.resolved.default_identity.branch_name,
                detached_start_commit: resolution.resolved.starting_commit
            )
            and Worktree.created(
                product_conversation: target,
                project: project,
                attached_scope: WorkScope{product_conversation: target},
                path: WorktreePath { absolute_path: worktree_path(target) },
                starting_branch_name: resolution.resolved.default_identity.branch_name,
                starting_commit: resolution.resolved.starting_commit
            )
            and conversation.working_dir = worktree_path(target)
            and conversation.worktree_path = worktree_path(target)
        else:
            ProvisioningFailure.created(
                conversation: conversation,
                project: project,
                resolution: resolution
            )

    @guidance
        -- Provisioning starts from the repository's canonical default branch and
        -- checks out the resulting commit at detached HEAD inside the disposable
        -- Phoenix-owned worktree.
        --
        -- The typed resolution boundary is disjoint:
        --   1. Resolve either ResolvedDetachedStart(starting_commit,
        --      default_identity, freshness) or UnresolvedDetachedStart(error).
        --   2. Only the resolved branch may create the detached WorkScope/worktree
        --      attachment and assign the conversation's worktree cwd.
        --   3. The unresolved branch persists a typed ProvisioningFailure while the
        --      conversation remains open without any fabricated WorkScope, worktree,
        --      branch/base ownership fields, or detached label.
        --
        -- The fetch boundary is single-branch and truthful:
        --   1. Try a bounded fetch for exactly the canonical default branch.
        --   2. Prefer the fetched remote-tracking tip when that fetch succeeds.
        --   3. If refresh fails but a cached local/remote-tracking ref for that
        --      same canonical branch still resolves, surface a stale-warning event
        --      and record freshness = stale_cached before using the cached ref.
        --   4. If no commit resolves from either path, persist unresolved(error)
        --      rather than synthesizing ownership.
        --
        -- No fallback to an arbitrary current branch is allowed.
}

rule DirectConversationHasNoProjectLifecycle {
    when: ConversationCreated(conversation, directory)

    requires: not is_git_repository(directory)

    ensures: conversation.environment_kind = chat_only
}

rule ListLocalBranches {
    when: UserOpensBranchPicker(project)

    ensures: LocalBranchListingEmitted(project)

    @guidance
        -- Lists local branches only; no network.
        -- behind_remote is derived only from local remote-tracking refs.
}

rule SearchRemoteBranches {
    when: UserSearchesBranches(project, query)

    requires: query != ""

    ensures: LsRemoteCacheRefreshedIfExpired(project)
    ensures: RemoteBranchSearchEmitted(project, query)

    @guidance
        -- Uses cached `git ls-remote` results when fresh; otherwise refreshes
        -- the cache and filters the result set. This is observational branch
        -- discovery, not conversation creation or lifecycle selection.
}

rule TaskApprovalExecuted {
    when: TaskApprovalDecisionImported(conversation, decision)
    requires: decision = approved_continue_current
    requires: exists Worktree{product_conversation: conversation.product_conversation}

    let worktree = Worktree{product_conversation: conversation.product_conversation}
    let approved_source = ApprovedTaskSource {
        task_path: conversation.proposal_snapshot.task_file,
        title: conversation.proposal_snapshot.title,
        priority: conversation.proposal_snapshot.priority,
        body: reread_task_body(conversation.proposal_snapshot.task_file),
        identity: approved_task_identity(conversation.proposal_snapshot.task_file),
        reviewed_snapshot: ReviewedProposalSnapshotIdentity {
            repo_relative_path: conversation.proposal_snapshot.repo_relative_path,
            task_kind: conversation.proposal_snapshot.task_kind,
            content_digest: conversation.proposal_snapshot.content_digest
        },
        kind: approved_task_kind(conversation.proposal_snapshot.task_file)
    }

    ensures: WriteAuthorityPersistedBeforeResume(conversation)
    ensures: ApprovedTaskSnapshotted(conversation, approved_source)
    ensures: ApprovedTaskRevalidated(conversation, approved_source)
    ensures: ApprovedTaskRereadBoundToReviewedSnapshot(
        conversation,
        approved_source.reviewed_snapshot,
        approved_path: approved_source.task_path,
        approved_kind: approved_source.kind,
        approved_body: approved_source.body
    )
    ensures: worktree.approved_task = approved_source
    ensures:
        if approved_source.kind = taskmd:
            worktree.approved_task = approved_source
            and TaskFileCommittedInWorkspace(worktree, approval_task_id(approved_source.task_path))
        else:
            BriefCommittedInWorkspace(worktree, approved_source.task_path, approved_source.body)
    ensures: conversation.task_id = approval_task_id(approved_source.task_path)
    ensures: conversation.task_title = approved_source.title
    ensures: ApprovedTaskContinuedHere(conversation, approved_source)

    @guidance
        -- Continue here reuses the existing attached WorkScope/worktree. Approval
        -- persists typed write authority on that existing Git-backed attachment
        -- before resume; it does not create or swap scopes, change lifecycle, or
        -- mutate branch/worktree provenance beyond the approved artifact commit.
}

rule TaskApprovalNewConversationExecuted {
    when: FreshWorkConversationProvisioningRequested(source_conversation, target_conversation, target_product_conversation, repository_identity)
    requires: repository_identity = source_conversation.project.repo

    let approved_source = ApprovedTaskSource {
        task_path: source_conversation.proposal_snapshot.task_file,
        title: source_conversation.proposal_snapshot.title,
        priority: source_conversation.proposal_snapshot.priority,
        body: reread_task_body(source_conversation.proposal_snapshot.task_file),
        identity: approved_task_identity(source_conversation.proposal_snapshot.task_file),
        reviewed_snapshot: ReviewedProposalSnapshotIdentity {
            repo_relative_path: source_conversation.proposal_snapshot.repo_relative_path,
            task_kind: source_conversation.proposal_snapshot.task_kind,
            content_digest: source_conversation.proposal_snapshot.content_digest
        },
        kind: approved_task_kind(source_conversation.proposal_snapshot.task_file)
    }
    let target = target_product_conversation

    ensures: target_conversation.product_conversation = target
    ensures: ApprovedTaskSnapshotted(source_conversation, approved_source)
    ensures: ApprovedTaskRevalidated(source_conversation, approved_source)
    ensures: ApprovedTaskRereadBoundToReviewedSnapshot(
        source_conversation,
        approved_source.reviewed_snapshot,
        approved_path: approved_source.task_path,
        approved_kind: approved_source.kind,
        approved_body: approved_source.body
    )
    ensures: ApprovedTaskSourceRecorded(target, approved_source)
    ensures: ApprovedTaskDerivedFromRecorded(source_conversation.product_conversation, target, approved_source)
    ensures: CreatedFromApprovedTask(target, approved_source)
    ensures: FreshGitWorktreeProvisioningRequested(target, repository_identity)

    @guidance
        -- Start in new conversation is owned by one typed provisioning request emitted
        -- from bedrock approval. That request carries the source transcript row, the
        -- fresh target conversation/product aggregate, and repository identity so
        -- projects records approved-task provenance and requests provisioning exactly
        -- once for that exact target.
}

rule StartInNewConversationDispatchesOnlyAfterSuccessfulProvisioning {
    when: FreshGitWorktreeProvisioningCompleted(target, provisioned)
    requires: exists CreatedFromApprovedTask(target, approved_source)
    requires: exists ApprovedTaskSourceRecorded(target, approved_source)
    ensures: ProvisionedWorkScopeAttached(target, provisioned)
    ensures: LlmRequestDispatched(target)

    @guidance
        -- The durable provisioning-completed event is the only success boundary that
        -- may dispatch the spawned conversation. It carries the target ProductConversation
        -- plus the attached WorkScope/worktree path established by provisioning, so
        -- downstream resume uses typed provisioning output rather than timing or emit
        -- order. Failed provisioning emits no completion event and therefore cannot
        -- dispatch the target conversation.
}

rule WorktreeTransferredOnContinuation {
    when: UserStartsContinuationConversation(parent, new_conv, handoff_text, first_message_id)

    requires: parent.parent_status = context_exhausted
    requires: exists Worktree{product_conversation: parent.product_conversation}
    requires: parent.continued_in_conv_id = absent

    let worktree = Worktree{product_conversation: parent.product_conversation}
    let scope = worktree.attached_scope

    ensures: new_conv.product_conversation = parent.product_conversation
    ensures: new_conv.working_dir = parent.working_dir
    ensures: new_conv.worktree_path = parent.worktree_path
    ensures: parent.continued_in_conv_id = new_conv.id
    ensures: worktree.product_conversation = new_conv.product_conversation
    ensures: worktree.attached_scope = scope
    ensures: HandedOffPredecessorReadOnly(parent)

    @guidance
        -- Continuation stays inside the same ProductConversation and the same
        -- WorkScope/worktree attachment. The predecessor row becomes a read-only
        -- handed-off segment, not a separate history aggregate and not a new owner.
        -- Branch/base ownership is not duplicated onto the continuation row.
}

rule DirectContinuationInheritsCwd {
    when: UserStartsContinuationConversation(parent, new_conv, handoff_text, first_message_id)

    requires: parent.parent_status = context_exhausted
    requires: not exists Worktree{product_conversation: parent.product_conversation}
    requires: parent.continued_in_conv_id = absent

    ensures: new_conv.product_conversation = parent.product_conversation
    ensures: new_conv.working_dir = parent.working_dir
    ensures: parent.continued_in_conv_id = new_conv.id
    ensures: HandedOffPredecessorReadOnly(parent)
}

rule WriteBlockedOutsideWorktree {
    when: WriteAttempted(conversation, target_path)

    requires: exists Worktree{product_conversation: conversation.product_conversation}
    requires: conversation.continued_in_conv_id = absent
    requires: not is_within(target_path, conversation.worktree_path)

    ensures: WriteRejected(conversation, target_path,
        reason: "Write target is outside the worktree")
}

rule WorkSubAgentInheritsWorktree {
    when: SubAgentSpawned(parent, sub_agent, mode)

    requires: exists Worktree{product_conversation: parent.product_conversation}
    requires: parent.continued_in_conv_id = absent
    requires: mode = work

    ensures: sub_agent.working_dir = parent.worktree_path
    ensures: SubAgentAttachedToSharedWorkScope(parent, sub_agent)

    @guidance
        -- Sub-agents may attach to the same scope as their parent. They do not
        -- acquire cleanup authority and do not cause separate teardown behaviour.
}

rule ExploreSubAgentDirectory {
    when: SubAgentSpawned(parent, sub_agent, mode)

    requires: mode = explore

    ensures:
        if exists Worktree{product_conversation: parent.product_conversation}:
            sub_agent.working_dir = parent.worktree_path
            and SubAgentAttachedToSharedWorkScope(parent, sub_agent)
        else:
            sub_agent.working_dir = parent.working_dir
}

rule ServerRestartWorktreeReconciliation {
    when: ServerRestarted(conversation)

    requires: exists Worktree{product_conversation: conversation.product_conversation}
    requires: conversation.continued_in_conv_id = absent
    requires: conversation.parent_status != context_exhausted
    requires: conversation.state != terminal
    requires: conversation.worktree_path = ""
        or not exists_on_disk(conversation.worktree_path)

    ensures: conversation.state = terminal
    ensures: GitWorktreePruned(conversation.project)

    @guidance
        -- Startup reconciliation reasons from persisted ownership plus on-disk
        -- state. Missing worktrees terminate the active owner row but never delete,
        -- rewrite, or mutate branches/refs as part of this classification.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant WorktreePathDerivedFromProductConversation {
    for w in Worktrees:
        w.path.absolute_path = w.project.repo.root_path
            + "/.phoenix/worktrees/" + w.product_conversation.id
}

invariant WorktreePathsUnique {
    for a in Worktrees:
        for b in Worktrees:
            a != b implies a.path != b.path
}

invariant OneWorktreePerProductConversation {
    for a in Worktrees:
        for b in Worktrees:
            a != b implies a.product_conversation != b.product_conversation
}

invariant WorktreeTargetsTopologyLatestRow {
    for w in Worktrees:
        exists bedrock/Parent{product_conversation: w.product_conversation, continued_in_conv_id: absent}
}

invariant WorkScopeSharedAcrossContinuation {
    for w in Worktrees:
        w.product_conversation = w.attached_scope.product_conversation
        and w.path = w.attached_scope.worktree_path
}

invariant ApprovedTaskPlacementsAreMutuallyExclusive {
    for c in bedrock/Conversations:
        not (exists ApprovedTaskContinuedHere(c, source) and exists ApprovedTaskDerivedFromRecorded(c.product_conversation, target, source))
}

invariant ApprovedTaskFreshPlacementCarriesNoContinuationEdge {
    for source_conv in bedrock/Conversations:
        for target in bedrock/ProductConversations:
            exists ApprovedTaskDerivedFromRecorded(source_conv.product_conversation, target, approved_source) implies
                source_conv.continued_in_conv_id = absent
                and source_conv.product_conversation.lifecycle = open
}

invariant BranchEntryBehindRemoteNonNegative {
    for e in BranchEntries:
        e.behind_remote != absent implies e.behind_remote >= 0
}

invariant LsRemoteCacheTtlNonNegative {
    for c in LsRemoteCaches:
        c.ttl_seconds >= 0
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface ProjectManagement {
    facing: bedrock/User

    context conversation: bedrock/Conversation
        where exists Worktree{product_conversation: conversation.product_conversation}
          and conversation.continued_in_conv_id = absent
          and core_status in { idle, error }

    let worktree = Worktree{product_conversation: conversation.product_conversation}

    exposes:
        worktree.starting_branch_name
        worktree.starting_commit
        worktree.attached_scope.canonical_default_branch
        worktree.is_clean
        worktree.approved_task

    provides:
        UserClicksClose(conversation)
}

rule ProjectManagementCloseClickDispatchesTypedBedrockCommand {
    when: UserClicksClose(conversation)
    ensures: bedrock/UserRequestsCloseConversation(
        conversation,
        next_close_attempt_id(conversation.product_conversation)
    )

    @guidance
        -- Projects emits the exact bedrock close command with a fresh attempt_id and
        -- leaves lifecycle state to bedrock; this surface does not mutate any local
        -- project lifecycle on its own.
}

surface BranchPicker {
    facing: bedrock/User

    context project: Project

    exposes:
        ListLocalBranches(project)
        SearchRemoteBranches(project, query)
        project.repo.remote_default_branch

    provides:
        UserOpensBranchPicker(project)
        UserSearchesBranches(project, query)

    @guarantee ListingIsInstant
        -- The no-query listing path never touches the network.

    @guarantee SearchIsCached
        -- Remote search uses cached ls-remote results when fresh.

    @guarantee ObservationOnly
        -- Branch picker behaviour is repository observation only. It does not select
        -- a conversation mode, start a conversation, or trigger lifecycle transitions.
}
