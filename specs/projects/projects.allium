-- allium: 3
-- projects.allium
--
-- Phoenix Projects: Git-backed provisioning, branch observation, and
-- approved-task placement around bedrock conversations.
--
-- Scope: project detection, git-backed conversation provisioning, branch
-- observation/picker operations, approved-task placement, worktree ownership,
-- write scoping, sub-agent same-scope attachment, and restart reconciliation.
--
-- Excludes:
--   - Conversation lifecycle/state-machine behaviour (bedrock)
--   - Resource retirement/teardown orchestration (work-lifecycle)
--   - PR freshness/association semantics (pr-association)
--   - UI layout details, .gitignore management, and build-cache prewarm

use "../bedrock/bedrock.allium" as bedrock

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity GitRepository {
    root_path: String
    current_branch: String
    remote_default_branch: String?
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value WorktreePath {
    absolute_path: String
}

value BranchEntry {
    name: String
    local: Boolean
    remote: Boolean
    behind_remote: Integer?
}

value RemoteRef {
    name: String
    kind: RefKind
    sha: String
}

value LsRemoteCache {
    repo_path: String
    refs: List<RemoteRef>
    fetched_at: Timestamp
    ttl_seconds: Integer = 300
}

value ApprovedTaskIdentity {
    task_kind: taskmd | plain_brief
    task_id: String?
    priority: String?
    slug: String?
    plain_title: String?
}

value ApprovedTaskSource {
    task_path: String
    title: String
    priority: String
    body: String
    identity: ApprovedTaskIdentity
    kind: taskmd | plain_markdown
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum RefKind { branch | tag }
enum TaskFileStatus { in_progress | done | wont_do }

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity Project {
    repo: GitRepository
    canonical_default_branch: String
    ls_remote_cache: LsRemoteCache?
    branch_picker_entries: List<BranchEntry>

    conversations: bedrock/Conversation with project = this
    task_files: TaskFile with project = this

    active_task_files: task_files where status = in_progress
}

entity TaskFile {
    project: Project
    task_id: String
    title: String
    priority: String
    slug: String
    status: TaskFileStatus

    filename: derive_filename(task_id, priority, status, slug)

    transitions status {
        in_progress -> done
        in_progress -> wont_do
        terminal: done, wont_do
    }

    invariant FilenameEncodesMetadata {
        filename = derive_filename(task_id, priority, status, slug)
    }
}

entity Worktree {
    conversation: bedrock/Conversation
    product_conversation: bedrock/ProductConversation
    project: Project
    attached_scope: WorkScope
    path: WorktreePath
    starting_branch_name: String
    starting_commit: String
    approved_task: ApprovedTaskSource?

    is_clean: git_status_clean(path)
}

value DefaultIdentityProvenance {
    branch_name: String
    source: configured_remote_default | fetched_remote_tracking | cached_remote_tracking
}

value DetachedStartProvenance {
    starting_commit: String
    default_identity: DefaultIdentityProvenance
}

entity WorkScope {
    product_conversation: bedrock/ProductConversation
    project: Project
    worktree_path: WorktreePath
    canonical_default_branch: String
    detached_start_commit: String
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule ConversationRootCwdRejected {
    when: ConversationCreated(conversation, directory)

    requires: directory_resolves_to_filesystem_root(directory)
        or not directory_resolves_to_existing_directory(directory)

    ensures: ConversationCreationRejected(conversation,
        reason: "Conversation cwd must be an existing non-root directory")
}

rule GitDirectoryDetected {
    when: ConversationCreated(conversation, directory)

    requires: is_git_repository(directory)

    let repo = git_repo_at(directory)
    let default_identity = authoritative_default_identity(repo)

    ensures: ConfiguredOrCachedDefaultIdentityResolved(repo, default_identity)
    ensures: Project.created(
        repo: repo,
        canonical_default_branch: default_identity.branch_name
    )

    @guidance
        -- Project association is keyed to the repository root, not the leaf
        -- directory the user supplied.
        -- Canonical default identity comes only from authoritative configured
        -- remote-default identity or cached local/remote-tracking evidence for
        -- that same branch. The repository's current branch is observational and
        -- never establishes canonical default ownership.
}

rule GitBackedConversationProvisioned {
    when: ConversationCreated(conversation, directory)

    requires: is_git_repository(directory)
    requires: conversation.environment_kind = git_backed

    let repo = git_repo_at(directory)
    let project = Project{repo: repo}
    let default_branch = project.canonical_default_branch
    let target = bedrock/ProductConversation{id: conversation.product_conversation.id}
    let default_identity = DefaultIdentityProvenance {
        branch_name: default_branch,
        source: canonical_default_identity_source(project, default_branch)
    }
    let detached_start = DetachedStartProvenance {
        starting_commit: detached_default_commit(project, default_branch),
        default_identity: default_identity
    }

    ensures: CanonicalDefaultBranchResolved(project, default_branch)
    ensures: SingleBranchFetchAttempted(project, default_branch)
    ensures: CanonicalDefaultCommitSelected(project, default_branch)
    ensures: DetachedDefaultStartSelected(project, detached_start)
    ensures: WorkScope.created(
        product_conversation: target,
        project: project,
        worktree_path: WorktreePath { absolute_path: worktree_path(conversation) },
        canonical_default_branch: default_branch,
        detached_start_commit: detached_start.starting_commit
    )
    ensures: Worktree.created(
        conversation: conversation,
        product_conversation: target,
        project: project,
        attached_scope: WorkScope{product_conversation: target},
        path: WorktreePath { absolute_path: worktree_path(conversation) },
        starting_branch_name: detached_start.default_identity.branch_name,
        starting_commit: detached_start.starting_commit
    )
    ensures: conversation.working_dir = worktree_path(conversation)
    ensures: conversation.worktree_path = worktree_path(conversation)

    @guidance
        -- Provisioning starts from the repository's canonical default branch and
        -- checks out the resulting commit at detached HEAD inside the disposable
        -- Phoenix-owned worktree.
        --
        -- The fetch boundary is single-branch and truthful:
        --   1. Try a bounded fetch for exactly the canonical default branch.
        --   2. Prefer the fetched remote-tracking tip when that fetch succeeds.
        --   3. If refresh fails but a cached local/remote-tracking ref for that
        --      same canonical branch still resolves, surface a stale-warning event
        --      and use the cached ref truthfully.
        --   4. If no commit resolves from either path, fail with a typed
        --      provisioning error rather than synthesizing ownership.
        --
        -- Detached starts record starting_commit plus default-identity provenance
        -- on the Phoenix-owned worktree, but do not stamp conversation branch/base
        -- ownership fields or fabricate a detached branch label.
        --
        -- No fallback to an arbitrary current branch is allowed.
}
}

rule DirectConversationHasNoProjectLifecycle {
    when: ConversationCreated(conversation, directory)

    requires: not is_git_repository(directory)

    ensures: conversation.environment_kind = chat_only
}

rule ListLocalBranches {
    when: UserOpensBranchPicker(project)

    ensures: LocalBranchListingEmitted(project)

    @guidance
        -- Lists local branches only; no network.
        -- behind_remote is derived only from local remote-tracking refs.
}

rule SearchRemoteBranches {
    when: UserSearchesBranches(project, query)

    requires: query != ""

    ensures: LsRemoteCacheRefreshedIfExpired(project)
    ensures: RemoteBranchSearchEmitted(project, query)

    @guidance
        -- Uses cached `git ls-remote` results when fresh; otherwise refreshes
        -- the cache and filters the result set. This is observational branch
        -- discovery, not conversation creation or lifecycle selection.
}

rule TaskApprovalExecuted {
    when: UserApprovesTask(conversation, decision)
    requires: decision = approved_continue_current
    requires: exists Worktree{conversation: conversation}

    let worktree = Worktree{conversation: conversation}
    let approved_source = ApprovedTaskSource {
        task_path: conversation.proposal.task_file,
        title: conversation.proposal.title,
        priority: conversation.proposal.priority,
        body: reread_task_body(conversation.proposal.task_file),
        identity: approved_task_identity(conversation.proposal.task_file),
        kind: approved_task_kind(conversation.proposal.task_file)
    }

    ensures: ApprovedTaskSnapshotted(conversation, approved_source)
    ensures: ApprovedTaskRevalidated(conversation, approved_source)
    ensures: worktree.approved_task = approved_source
    ensures:
        if approved_source.kind = taskmd:
            worktree.approved_task = approved_source
            and TaskFileCommittedInWorkspace(worktree, approval_task_id(approved_source.task_path))
        else:
            BriefCommittedInWorkspace(worktree, approved_source.task_path, approved_source.body)
    ensures: conversation.task_id = approval_task_id(approved_source.task_path)
    ensures: conversation.task_title = approved_source.title
    ensures: ApprovedTaskContinuedHere(conversation, approved_source)
}

rule TaskApprovalNewConversationExecuted {
    when: UserApprovesTask(conversation, decision)
    requires: decision = approved_start_fresh

    let approved_source = ApprovedTaskSource {
        task_path: conversation.proposal.task_file,
        title: conversation.proposal.title,
        priority: conversation.proposal.priority,
        body: reread_task_body(conversation.proposal.task_file),
        identity: approved_task_identity(conversation.proposal.task_file),
        kind: approved_task_kind(conversation.proposal.task_file)
    }
    let target = bedrock/ProductConversation{id: approved_task_child_id(conversation)}

    ensures: ApprovedTaskSnapshotted(conversation, approved_source)
    ensures: ApprovedTaskRevalidated(conversation, approved_source)
    ensures: ApprovedTaskSourceRecorded(target, approved_source)
    ensures: ApprovedTaskDerivedFromRecorded(conversation.product_conversation, target, approved_source)
    ensures: CreatedFromApprovedTask(target, approved_source)
    ensures: FreshGitWorktreeProvisioningRequested(target, conversation.project.repo)

    @guidance
        -- Start in new conversation creates a separate ProductConversation with a
        -- fresh WorkScope and detached-default worktree. It is not a continuation
        -- of the source conversation and does not copy the source scope.
}

rule WorktreeTransferredOnContinuation {
    when: UserStartsContinuationConversation(parent, new_conv)

    requires: parent.parent_status = context_exhausted
    requires: exists Worktree{conversation: parent}
    requires: parent.continued_in_conv_id = absent

    let worktree = Worktree{conversation: parent}
    let scope = worktree.attached_scope

    ensures: new_conv.product_conversation = parent.product_conversation
    ensures: new_conv.working_dir = parent.working_dir
    ensures: new_conv.worktree_path = parent.worktree_path
    ensures: parent.continued_in_conv_id = new_conv.id
    ensures: worktree.conversation = new_conv
    ensures: worktree.product_conversation = new_conv.product_conversation
    ensures: worktree.attached_scope = scope
    ensures: HandedOffPredecessorReadOnly(parent)

    @guidance
        -- Continuation stays inside the same ProductConversation and the same
        -- WorkScope/worktree attachment. The predecessor row becomes a read-only
        -- handed-off segment, not a separate history aggregate and not a new owner.
        -- Branch/base ownership is not duplicated onto the continuation row.
}

rule DirectContinuationInheritsCwd {
    when: UserStartsContinuationConversation(parent, new_conv)

    requires: parent.parent_status = context_exhausted
    requires: not exists Worktree{conversation: parent}
    requires: parent.continued_in_conv_id = absent

    ensures: new_conv.product_conversation = parent.product_conversation
    ensures: new_conv.working_dir = parent.working_dir
    ensures: parent.continued_in_conv_id = new_conv.id
    ensures: HandedOffPredecessorReadOnly(parent)
}

rule WriteBlockedOutsideWorktree {
    when: WriteAttempted(conversation, target_path)

    requires: exists Worktree{conversation: conversation}
    requires: not is_within(target_path, conversation.worktree_path)

    ensures: WriteRejected(conversation, target_path,
        reason: "Write target is outside the worktree")
}

rule WorkSubAgentInheritsWorktree {
    when: SubAgentSpawned(parent, sub_agent, mode)

    requires: exists Worktree{conversation: parent}
    requires: mode = work

    ensures: sub_agent.working_dir = parent.worktree_path
    ensures: SubAgentAttachedToSharedWorkScope(parent, sub_agent)

    @guidance
        -- Sub-agents may attach to the same scope as their parent. They do not
        -- acquire cleanup authority and do not cause separate teardown behaviour.
}

rule ExploreSubAgentDirectory {
    when: SubAgentSpawned(parent, sub_agent, mode)

    requires: mode = explore

    ensures:
        if exists Worktree{conversation: parent}:
            sub_agent.working_dir = parent.worktree_path
            and SubAgentAttachedToSharedWorkScope(parent, sub_agent)
        else:
            sub_agent.working_dir = parent.working_dir
}

rule ServerRestartWorktreeReconciliation {
    when: ServerRestarted(conversation)

    requires: exists Worktree{conversation: conversation}
    requires: conversation.continued_in_conv_id = absent
    requires: conversation.parent_status != context_exhausted
    requires: conversation.state != terminal
    requires: conversation.worktree_path = ""
        or not exists_on_disk(conversation.worktree_path)

    ensures: conversation.state = terminal
    ensures: GitWorktreePruned(conversation.project)

    @guidance
        -- Startup reconciliation reasons from persisted ownership plus on-disk
        -- state. Missing worktrees terminate the active owner row but never delete,
        -- rewrite, or mutate branches/refs as part of this classification.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant WorktreePathDerivedFromConversation {
    for w in Worktrees:
        w.path.absolute_path = w.project.repo.root_path
            + "/.phoenix/worktrees/" + w.conversation.id
}

invariant WorktreePathsUnique {
    for a in Worktrees:
        for b in Worktrees:
            a != b implies a.path != b.path
}

invariant OneWorktreePerConversation {
    for a in Worktrees:
        for b in Worktrees:
            a != b implies a.conversation != b.conversation
}

invariant WorktreeOwnershipFollowsContinuationPointer {
    for w in Worktrees:
        w.conversation.continued_in_conv_id = absent
}

invariant WorkScopeSharedAcrossContinuation {
    for w in Worktrees:
        w.product_conversation = w.attached_scope.product_conversation
        and w.path = w.attached_scope.worktree_path
}

invariant ApprovedTaskPlacementsAreMutuallyExclusive {
    for c in bedrock/Conversations:
        not (exists ApprovedTaskContinuedHere(c, source) and exists ApprovedTaskDerivedFromRecorded(c.product_conversation, target, source))
}

invariant ApprovedTaskFreshPlacementCarriesNoContinuationEdge {
    for source_conv in bedrock/Conversations:
        for target in bedrock/ProductConversations:
            exists ApprovedTaskDerivedFromRecorded(source_conv.product_conversation, target, approved_source) implies
                source_conv.continued_in_conv_id = absent
                and source_conv.product_conversation.lifecycle = open
}

invariant BranchEntryBehindRemoteNonNegative {
    for e in BranchEntries:
        e.behind_remote != absent implies e.behind_remote >= 0
}

invariant LsRemoteCacheTtlNonNegative {
    for c in LsRemoteCaches:
        c.ttl_seconds >= 0
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface ProjectManagement {
    facing: bedrock/User

    context conversation: bedrock/Conversation
        where exists Worktree{conversation: conversation} and core_status in { idle, error }

    let worktree = Worktree{conversation: conversation}

    exposes:
        worktree.starting_branch_name
        worktree.starting_commit
        worktree.attached_scope.canonical_default_branch
        worktree.is_clean
        worktree.approved_task

    provides:
        UserRequestsCloseConversation(conversation)
}

surface BranchPicker {
    facing: bedrock/User

    context project: Project

    exposes:
        ListLocalBranches(project)
        SearchRemoteBranches(project, query)
        project.repo.remote_default_branch

    provides:
        UserOpensBranchPicker(project)
        UserSearchesBranches(project, query)

    @guarantee ListingIsInstant
        -- The no-query listing path never touches the network.

    @guarantee SearchIsCached
        -- Remote search uses cached ls-remote results when fresh.

    @guarantee ObservationOnly
        -- Branch picker behaviour is repository observation only. It does not select
        -- a conversation mode, start a conversation, or trigger lifecycle transitions.
}
