-- allium: 3
-- wake-contracts.allium
--
-- Wake contracts for bash and tmux terminal waits.
--
-- Includes:
--   - receipt-then-observation registration
--   - normalized durable contract/inbox model
--   - exactly-once terminal resolution
--   - durable inbox with coalesced resume scheduling
--   - continuation transfer for all pending contracts and unconsumed observations
--   - explicit cancel without automatic resume scheduling
--   - lifecycle_blocked distinct from is_busy
--   - startup reconciliation before live observation
-- Excludes:
--   - sub-agent wake
--   - general actor messaging
--   - non-handle condition kinds

use "../bedrock/bedrock.allium" as bedrock
use "../bash/bash.allium" as bash
use "../tmux-integration/tmux-integration.allium" as tmux

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor LlmAgent {
    identified_by: bedrock/Conversation
}

actor User {
    identified_by: bedrock/Parent
}

actor WakeObserver {}

actor WakeStartupReconciler {}

actor ConversationRuntime {
    identified_by: bedrock/Conversation
}

actor LifecycleManager {
    identified_by: bedrock/Conversation
}

actor ContinuationManager {
    identified_by: bedrock/Conversation
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value BashHandleRef {
    handle: String
}

value TmuxWindowHandleRef {
    window_id: String
}

enum WaitHandleKind {
    bash
    | tmux_window
}

value WaitHandle {
    kind: WaitHandleKind
    bash: BashHandleRef? when kind = bash
    tmux_window: TmuxWindowHandleRef? when kind = tmux_window
}

enum ContractStatus {
    pending
    | terminal
}

enum TerminalCause {
    fired
    | expired
    | cancelled
    | forgotten
}

enum CancellationReason {
    explicit_cancel
}

enum ForgottenReason {
    handle_missing
    | runtime_unrecoverable_after_restart
}

enum BashObservedStatus {
    exited
    | killed
    | kill_pending_kernel
}

enum TmuxObservedStatus {
    exit_marker_observed
    | window_killed
}

value BashObservedPayload {
    status: BashObservedStatus
    exit_code: Integer?
    duration_ms: Integer?
    signal_number: Integer?
    kill_signal_sent: bash/KillSignal?
}

value TmuxObservedPayload {
    status: TmuxObservedStatus
    exit_code: Integer?
    duration_ms: Integer?
}

enum FiredPayloadKind {
    bash
    | tmux_window
}

value FiredPayload {
    kind: FiredPayloadKind
    bash: BashObservedPayload? when kind = bash
    tmux_window: TmuxObservedPayload? when kind = tmux_window
}

value TerminalPayload {
    cause: TerminalCause
    fired: FiredPayload? when cause = fired
    cancellation_reason: CancellationReason? when cause = cancelled
    forgotten_reason: ForgottenReason? when cause = forgotten
}

value WakeRegistrationReceipt {
    contract_id: String
    handle: WaitHandle
    expires_at: Timestamp
    registering_tool_use_id: String?
}

value WakeRuntimeObservation {
    contract_id: String
    receipt: WakeRegistrationReceipt
    terminal_payload: TerminalPayload
}

entity WakeTrackedConversation {
    conversation: bedrock/Conversation
    pending_contract_count: Integer
    registration_open: Boolean
    lifecycle_blocked: pending_contract_count > 0
    runtime_busy: conversation.is_busy
}

entity Contract {
    id: String
    owning_conversation: bedrock/Conversation
    handle: WaitHandle
    registering_tool_use_id: String
    registered_at: Timestamp
    expires_at: Timestamp
    status: ContractStatus

    transitions status {
        pending -> terminal
        terminal: terminal
    }

    terminal_cause: TerminalCause when status = terminal
    terminal_payload: TerminalPayload when status = terminal
    resolved_at: Timestamp when status = terminal
}

entity BashWakeTailLine {
    contract: Contract
    ordinal: Integer
    line: bash/RingLine
}

entity TmuxWakeTailLine {
    contract: Contract
    ordinal: Integer
    line: String
}

entity WakeInboxItem {
    id: String
    conversation: bedrock/Conversation
    contract: Contract
    observation: WakeRuntimeObservation
    enqueued_at: Timestamp
    delivered_at: Timestamp?
}

enum ResumeRequestStatus {
    pending
    | accepted
}

entity ResumeRequest {
    conversation: bedrock/Conversation
    reason: resume_wake_inbox
    snapshot_message_id: String
    status: ResumeRequestStatus
}

config {
    default_max_wait_seconds: Integer = 600
    max_max_wait_seconds: Integer = 1800
}

------------------------------------------------------------
-- Helpers
------------------------------------------------------------

-- Helper declarations used by rules and invariants in this file.
-- They are pure unless the referenced ensure names an effect.
--
-- next_contract_id()
-- next_wake_inbox_id()
-- handle_owned_by_conversation(handle, conversation)
-- evidence_at_or_before_deadline(contract, evidence_at)
-- durable_terminal_evidence_before_deadline(contract)
-- handle_still_observable(contract)
-- tmux_evidence_generation_matches_current_server(contract)
-- runtime_currently_consuming_wake_inbox(conversation)
-- idle_runtime_available(conversation)
-- at_most_one_pending_resume_request(conversation, reason)
-- undelivered_wake_inbox_items_in_deterministic_order(conversation)
-- wake_inbox_snapshot_for_resume(conversation)
-- all_pending_contracts_owned_by(conversation)
-- all_undelivered_wake_items_owned_by(conversation)
-- no_duplicate_wake_inbox_items_per_contract
-- no_wake_inbox_item_for_pending_contract
-- lifecycle_blocked_tracks_pending_contract_count
-- lifecycle_blocked_can_hold_while_runtime_busy_is_false
-- registration_requires_open_non_archived_non_terminal_conversation
-- lifecycle_fence_closes_iff_no_pending_contract
-- lifecycle_fence_is_durable_and_idempotent
-- AllChainMemberRegistrationClosed(members)
-- AllChainMemberRegistrationOpen(members)
-- ChainCleanupMayBegin(members)
-- NoChainCleanupBegins(members)
-- continuation_closes_predecessor_and_opens_successor
-- resume_requests_require_undelivered_wake_inbox_items
-- wake_inbox_items_target_current_contract_owner
-- one_llm_execution_per_conversation
-- later_committed_items_remain_pending_after_snapshot
-- pending_resume_has_message_in_owning_conversation_history
-- accepting_resume_atomically_persists_llm_requesting
-- duplicate_or_stale_resume_does_not_start_llm_turn
-- transfer_copies_exact_resume_message_once
-- startup_retries_pending_resume_requests

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface AgentWakeAccess {
    facing user: LlmAgent

    context conversation: bedrock/Conversation

    provides:
        AgentCallsWaitUntil(conversation, handle, requested_max_wait_seconds?, tool_use_id)
            when conversation.core_status in { idle, busy }
        AgentConsumesWakeResume(conversation, request)
            when request.conversation = conversation
}

surface WakeCancellationSurface {
    facing user: User

    context conversation: bedrock/Conversation

    provides:
        CancelWakeRequested(conversation, contract)
            when contract.owning_conversation = conversation
                 and contract.status = pending
}

surface WakeObservationSurface {
    facing user: WakeObserver

    provides:
        WakeObservationTick(contract)
            when contract.status = pending
        BashTerminalEvidenceObserved(contract, payload, tail_lines, evidence_at)
            when contract.status = pending
                 and contract.handle.kind = bash
        TmuxTerminalEvidenceObserved(contract, payload, tail_lines, evidence_at)
            when contract.status = pending
                 and contract.handle.kind = tmux_window
                 and tmux_evidence_generation_matches_current_server(contract)
}

surface WakeStartupSurface {
    facing user: WakeStartupReconciler

    provides:
        StartupPassBegins(wake_contract_reconciliation)
}

surface ContinuationWakeTransferSurface {
    facing user: ContinuationManager

    provides:
        ContinuationCreatesSuccessor(predecessor, successor)
}

surface WakeLifecycleSurface {
    facing user: LifecycleManager

    context conversation: bedrock/Conversation

    provides:
        LifecycleArchiveRequested(conversation)
        LifecycleAbandonRequested(conversation)
        LifecycleMarkMergedRequested(conversation)
        LifecycleHardDeleteRequested(conversation)
}

surface WakeResumeSchedulerSurface {
    facing user: ConversationRuntime

    context conversation: bedrock/Conversation

    exposes:
        conversation.is_busy

    provides:
        ResumeRequestConsumed(conversation, request)
            when request.conversation = conversation
                 and request.reason = resume_wake_inbox
}

surface WakeSchedulerEvents {
    facing user: WakeObserver

    provides:
        WakeInboxItemCreatedForConversation(conversation)
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule RegisterWakeContract {
    when: AgentCallsWaitUntil(conversation, handle, requested_max_wait_seconds, tool_use_id)

    requires: handle.kind in {bash, tmux_window}
    requires: handle_owned_by_conversation(handle, conversation)
    requires: requested_max_wait_seconds >= 1
    requires: WakeTrackedConversation{conversation: conversation}.registration_open
    requires: not conversation.archived
    requires: conversation.state != terminal
    requires: requested_max_wait_seconds <= config.max_max_wait_seconds

    let contract_id = next_contract_id()
    let expires_at = now() + requested_max_wait_seconds
    let receipt = WakeRegistrationReceipt{
        contract_id: contract_id,
        handle: handle,
        expires_at: expires_at,
        registering_tool_use_id: tool_use_id
    }

    ensures: Contract.created(
        id: contract_id,
        owning_conversation: conversation,
        handle: handle,
        registering_tool_use_id: tool_use_id,
        registered_at: now(),
        expires_at: expires_at,
        status: pending
    )
    ensures: AgentReceivesWakeReceipt(receipt)
    ensures: SseEmitted(WakeContractRegistered, contract_id)
}

rule RegisterWakeContractWithDefaultTimeout {
    when: AgentCallsWaitUntil(conversation, handle, omitted, tool_use_id)

    requires: handle.kind in {bash, tmux_window}
    requires: handle_owned_by_conversation(handle, conversation)
    requires: WakeTrackedConversation{conversation: conversation}.registration_open
    requires: not conversation.archived
    requires: conversation.state != terminal

    let contract_id = next_contract_id()
    let expires_at = now() + config.default_max_wait_seconds
    let receipt = WakeRegistrationReceipt{
        contract_id: contract_id,
        handle: handle,
        expires_at: expires_at,
        registering_tool_use_id: tool_use_id
    }

    ensures: Contract.created(
        id: contract_id,
        owning_conversation: conversation,
        handle: handle,
        registering_tool_use_id: tool_use_id,
        registered_at: now(),
        expires_at: expires_at,
        status: pending
    )
    ensures: AgentReceivesWakeReceipt(receipt)
    ensures: SseEmitted(WakeContractRegistered, contract_id)
}

rule RejectWakeUnsupportedHandleKind {
    when: AgentCallsWaitUntil(conversation, handle, requested_max_wait_seconds?, tool_use_id)

    requires: handle.kind not in {bash, tmux_window}

    ensures: AgentReceivesError(error: "wake_unsupported_handle_kind")
}

rule RejectWakeUnauthorizedHandle {
    when: AgentCallsWaitUntil(conversation, handle, requested_max_wait_seconds?, tool_use_id)

    requires: handle.kind in {bash, tmux_window}
    requires: not handle_owned_by_conversation(handle, conversation)

    ensures: AgentReceivesError(error: "wake_unauthorized_handle")
}

rule RejectWakeOutOfRangeTimeout {
    when: AgentCallsWaitUntil(conversation, handle, requested_max_wait_seconds, tool_use_id)

    requires: requested_max_wait_seconds < 1
              or requested_max_wait_seconds > config.max_max_wait_seconds

    ensures: AgentReceivesError(error: "wake_max_wait_seconds_out_of_range")
}

rule ResolveBashContractFired {
    when: BashTerminalEvidenceObserved(contract, payload, tail_lines, evidence_at)

    requires: contract.status = pending
    requires: contract.handle.kind = bash
    requires: evidence_at_or_before_deadline(contract, evidence_at)

    let observation = WakeRuntimeObservation{
        contract_id: contract.id,
        receipt: WakeRegistrationReceipt{
            contract_id: contract.id,
            handle: contract.handle,
            expires_at: contract.expires_at,
            registering_tool_use_id: contract.registering_tool_use_id
        },
        terminal_payload: TerminalPayload{
            cause: fired,
            fired: FiredPayload{kind: bash, bash: payload}
        }
    }

    ensures: contract.status = terminal
    ensures: contract.terminal_cause = fired
    ensures: contract.terminal_payload = observation.terminal_payload
    ensures: contract.resolved_at = now()
    ensures: WakeInboxItem.created(
        id: next_wake_inbox_id(),
        conversation: contract.owning_conversation,
        contract: contract,
        observation: observation,
        enqueued_at: now()
    )
    ensures: BashWakeTailLine.replaced_for(contract, tail_lines)
}

rule ResolveTmuxContractFired {
    when: TmuxTerminalEvidenceObserved(contract, payload, tail_lines, evidence_at)

    requires: contract.status = pending
    requires: contract.handle.kind = tmux_window
    requires: evidence_at_or_before_deadline(contract, evidence_at)

    let observation = WakeRuntimeObservation{
        contract_id: contract.id,
        receipt: WakeRegistrationReceipt{
            contract_id: contract.id,
            handle: contract.handle,
            expires_at: contract.expires_at,
            registering_tool_use_id: contract.registering_tool_use_id
        },
        terminal_payload: TerminalPayload{
            cause: fired,
            fired: FiredPayload{kind: tmux_window, tmux_window: payload}
        }
    }

    ensures: contract.status = terminal
    ensures: contract.terminal_cause = fired
    ensures: contract.terminal_payload = observation.terminal_payload
    ensures: contract.resolved_at = now()
    ensures: WakeInboxItem.created(
        id: next_wake_inbox_id(),
        conversation: contract.owning_conversation,
        contract: contract,
        observation: observation,
        enqueued_at: now()
    )
    ensures: TmuxWakeTailLine.replaced_for(contract, tail_lines)
}

rule ResolveContractExpired {
    when: WakeObservationTick(contract)

    requires: contract.status = pending
    requires: now() >= contract.expires_at
    requires: not durable_terminal_evidence_before_deadline(contract)
    requires: handle_still_observable(contract)

    let observation = WakeRuntimeObservation{
        contract_id: contract.id,
        receipt: WakeRegistrationReceipt{
            contract_id: contract.id,
            handle: contract.handle,
            expires_at: contract.expires_at,
            registering_tool_use_id: contract.registering_tool_use_id
        },
        terminal_payload: TerminalPayload{cause: expired}
    }

    ensures: contract.status = terminal
    ensures: contract.terminal_cause = expired
    ensures: contract.terminal_payload = observation.terminal_payload
    ensures: contract.resolved_at = now()
    ensures: WakeInboxItem.created(
        id: next_wake_inbox_id(),
        conversation: contract.owning_conversation,
        contract: contract,
        observation: observation,
        enqueued_at: now()
    )
}

rule ResolveContractForgotten {
    when: WakeObservationTick(contract)

    requires: contract.status = pending
    requires: not handle_still_observable(contract)
    requires: not durable_terminal_evidence_before_deadline(contract)

    let observation = WakeRuntimeObservation{
        contract_id: contract.id,
        receipt: WakeRegistrationReceipt{
            contract_id: contract.id,
            handle: contract.handle,
            expires_at: contract.expires_at,
            registering_tool_use_id: contract.registering_tool_use_id
        },
        terminal_payload: TerminalPayload{
            cause: forgotten,
            forgotten_reason: handle_missing
        }
    }

    ensures: contract.status = terminal
    ensures: contract.terminal_cause = forgotten
    ensures: contract.terminal_payload = observation.terminal_payload
    ensures: contract.resolved_at = now()
    ensures: WakeInboxItem.created(
        id: next_wake_inbox_id(),
        conversation: contract.owning_conversation,
        contract: contract,
        observation: observation,
        enqueued_at: now()
    )
}

rule CancelWakeContract {
    when: CancelWakeRequested(conversation, contract)

    requires: contract.status = pending
    requires: contract.owning_conversation = conversation

    let observation = WakeRuntimeObservation{
        contract_id: contract.id,
        receipt: WakeRegistrationReceipt{
            contract_id: contract.id,
            handle: contract.handle,
            expires_at: contract.expires_at,
            registering_tool_use_id: contract.registering_tool_use_id
        },
        terminal_payload: TerminalPayload{
            cause: cancelled,
            cancellation_reason: explicit_cancel
        }
    }

    ensures: contract.status = terminal
    ensures: contract.terminal_cause = cancelled
    ensures: contract.terminal_payload = observation.terminal_payload
    ensures: contract.resolved_at = now()
    ensures: WakeInboxItem.created(
        id: next_wake_inbox_id(),
        conversation: contract.owning_conversation,
        contract: contract,
        observation: observation,
        enqueued_at: now()
    )
    ensures: ExplicitCancelDoesNotScheduleResume(conversation, contract)
    ensures: not ReplacementWakeContractCreatedFor(contract)
}

rule TransferPendingContractsToContinuation {
    when: ContinuationCreatesSuccessor(predecessor, successor)

    ensures: Contract.reassign_all(
        from: predecessor,
        to: successor,
        rows: all_pending_contracts_owned_by(predecessor)
            + contracts_referenced_by_unconsumed_wake_items_owned_by(predecessor)
    )
    ensures: WakeInboxItem.reassign_all(
        from: predecessor,
        to: successor,
        rows: all_unconsumed_wake_items_owned_by(predecessor)
    )
    ensures: ResumeRequest.reassign_all_pending(
        from: predecessor,
        to: successor,
        copy_message_into_successor_history: true
    )
    ensures: transfer_copies_exact_resume_message_once
    ensures: consumed_terminal_contracts_without_unconsumed_items_remain_owned_by(predecessor)
    ensures: transferred_items_and_their_contracts_have_same_owner(successor)
    ensures: WakeTrackedConversation{conversation: predecessor}.registration_open = false
    ensures: WakeTrackedConversation{conversation: successor}.registration_open = true
    ensures: continuation_closes_predecessor_and_opens_successor
}

rule CoalesceResumeSchedulingWhenIdle {
    when: WakeInboxItemCreatedForConversation(conversation)

    requires: exists WakeInboxItem{conversation: conversation, delivered_at: null}
    requires: not runtime_currently_consuming_wake_inbox(conversation)
    requires: idle_runtime_available(conversation)

    ensures: exists ResumeRequest{
        conversation: conversation,
        reason: resume_wake_inbox,
        status: pending
    }
    ensures: at_most_one_pending_resume_request(conversation, resume_wake_inbox)
}

rule BusyConversationDefersWakeResumeScheduling {
    when: WakeInboxItemCreatedForConversation(conversation)

    requires: exists WakeInboxItem{conversation: conversation, delivered_at: null}
    requires: conversation.is_busy

    ensures: not ResumeRequest.created(conversation: conversation, reason: resume_wake_inbox)
    ensures: not WakeInboxItem.consumed(conversation: conversation)
    ensures: not runtime_observation_message_created(conversation)
}

rule DeliverWakeInboxBatch {
    when: ResumeRequestConsumed(conversation, request)

    requires: exists WakeInboxItem{conversation: conversation, delivered_at: null}
    requires: not conversation.is_busy

    ensures: ConversationReceivesWakeBatch(
        conversation: conversation,
        items: wake_inbox_snapshot_for_resume(conversation)
    )
    ensures: MarkWakeInboxItemsDelivered(conversation, wake_inbox_snapshot_for_resume(conversation))
    ensures: request.status = accepted
    ensures: accepting_resume_atomically_persists_llm_requesting
}

rule ArchivedConversationSuppressesWakeResume {
    when: LifecycleArchiveRequested(conversation)

    ensures: not runtime_observation_message_created_after_archive(conversation)
    ensures: not WakeResumeAcceptedAfterArchive(conversation)
    ensures: ResumeRequest.suppress_all_pending(
        conversation: conversation,
        reason: conversation_archived
    )
}

rule LaterCommittedInboxItemsRemainPending {
    when: ResumeRequestConsumed(conversation, request)

    requires: exists WakeInboxItem{conversation: conversation, delivered_at: null}

    ensures: later_committed_items_remain_pending_after_snapshot
}

rule StartupPassReconcilesPendingContracts {
    when: StartupPassBegins(wake_contract_reconciliation)

    ensures: StartupReconcilesPendingContracts
    ensures: startup_retries_pending_resume_requests
}

rule ArchiveAcquiresDurableWakeFence {
    when: LifecycleArchiveRequested(conversation)
    requires: not exists Contract{owning_conversation: conversation, status: pending}
    ensures: WakeTrackedConversation{conversation: conversation}.registration_open = false
    ensures: lifecycle_fence_is_durable_and_idempotent
}

rule AbandonAcquiresDurableWakeFence {
    when: LifecycleAbandonRequested(conversation)
    requires: not exists Contract{owning_conversation: conversation, status: pending}
    ensures: WakeTrackedConversation{conversation: conversation}.registration_open = false
    ensures: lifecycle_fence_is_durable_and_idempotent
}

rule MarkMergedAcquiresDurableWakeFence {
    when: LifecycleMarkMergedRequested(conversation)
    requires: not exists Contract{owning_conversation: conversation, status: pending}
    ensures: WakeTrackedConversation{conversation: conversation}.registration_open = false
    ensures: lifecycle_fence_is_durable_and_idempotent
}

rule HardDeleteAcquiresDurableWakeFence {
    when: LifecycleHardDeleteRequested(conversation)
    requires: not exists Contract{owning_conversation: conversation, status: pending}
    ensures: WakeTrackedConversation{conversation: conversation}.registration_open = false
    ensures: lifecycle_fence_is_durable_and_idempotent
}

rule ChainLifecycleAcquiresAllMemberWakeFences {
    when: ChainLifecycleRequested(members)
    requires: not exists Contract{owning_conversation: members, status: pending}
    ensures: AllChainMemberRegistrationClosed(members)
    ensures: ChainCleanupMayBegin(members)
}

rule RejectChainLifecycleWhileAnyWakePending {
    when: ChainLifecycleRequested(members)
    requires: exists Contract{owning_conversation: members, status: pending}
    ensures: LifecycleRequestRejected(error: "wake_contract_pending")
    ensures: AllChainMemberRegistrationOpen(members)
    ensures: NoChainCleanupBegins(members)
}

rule RejectRegistrationAfterLifecycleFence {
    when: AgentCallsWaitUntil(conversation, handle, requested_max_wait_seconds?, tool_use_id)

    requires: not WakeTrackedConversation{conversation: conversation}.registration_open

    ensures: AgentReceivesError(error: "wake_registration_closed")
}

rule RejectArchiveWhileWakePending {
    when: LifecycleArchiveRequested(conversation)

    requires: exists Contract{owning_conversation: conversation, status: pending}

    ensures: LifecycleRequestRejected(error: "wake_contract_pending")
}

rule RejectAbandonWhileWakePending {
    when: LifecycleAbandonRequested(conversation)

    requires: exists Contract{owning_conversation: conversation, status: pending}

    ensures: LifecycleRequestRejected(error: "wake_contract_pending")
}

rule RejectMarkMergedWhileWakePending {
    when: LifecycleMarkMergedRequested(conversation)

    requires: exists Contract{owning_conversation: conversation, status: pending}

    ensures: LifecycleRequestRejected(error: "wake_contract_pending")
}

rule RejectHardDeleteWhileWakePending {
    when: LifecycleHardDeleteRequested(conversation)

    requires: exists Contract{owning_conversation: conversation, status: pending}

    ensures: LifecycleRequestRejected(error: "wake_contract_pending")
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant WakeRegistrationAndLifecycleFenceSerialize {
    registration_requires_open_non_archived_non_terminal_conversation
    lifecycle_fence_closes_iff_no_pending_contract
}

invariant TerminalContractHasOneInboxItem {
    no_duplicate_wake_inbox_items_per_contract
}

invariant PendingContractHasNoInboxItem {
    no_wake_inbox_item_for_pending_contract
}

invariant LifecycleBlockedTracksPendingContracts {
    lifecycle_blocked_tracks_pending_contract_count
}

invariant LifecycleBlockedIndependentOfRuntimeBusy {
    lifecycle_blocked_can_hold_while_runtime_busy_is_false
}

invariant ResumeRequestNeedsUndeliveredInboxItem {
    resume_requests_require_undelivered_wake_inbox_items
}

invariant InboxItemConversationMatchesContractOwner {
    wake_inbox_items_target_current_contract_owner
}

invariant PendingResumeVisibleInOwningHistory {
    pending_resume_has_message_in_owning_conversation_history
}

invariant DuplicateResumeDoesNotStartTurn {
    duplicate_or_stale_resume_does_not_start_llm_turn
}

invariant OneLlmExecutionPerConversation {
    one_llm_execution_per_conversation
}
