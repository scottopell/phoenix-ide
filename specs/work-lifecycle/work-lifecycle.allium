-- allium: 3
-- work-lifecycle.allium
--
-- Phoenix WorkScope Retirement: Behavioural Specification
--
-- Scope: Git-backed Close inspection, exact content and operational blockers,
--        WorkScope-owned resource retirement, and PR-state advisory guidance.
--
-- Includes:
--   - one authoritative exact blocker decision and its user-facing projection;
--   - ignored/build content as blockers, never inferred discard permission;
--   - one stop-on-first-failure retirement run, observation-only startup,
--     and explicit fresh safe retry under original Close authority;
--   - PR-state guidance that may encourage Close but never blocks it;
--   - one source-bound, idempotent `close_conversation` request, with no
--     automatic successor, in-Close discard, salvage, repair, or classifier.
-- Owner cleanup requires separate authority and fresh Close inspection.
--
-- Excludes:
--   - root lifecycle legality, close-obligation orchestration, and ProductConversation
--     Open/History transitions (bedrock owns those authorities);
--   - PR identity selection, feedback freshness, and remediation context
--     (pr-association owns those authorities);
--   - UI layout and copy.
--
-- Requirement traceability: REQ-WL-001 through REQ-WL-004,
-- REQ-PROJ-028a, REQ-PROJ-WS-001

use "../bedrock/bedrock.allium" as bedrock
use "../git-repository/git-repository.allium" as gitrep

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value WorkScope {
    kind: WorkScopeKind
    inner: String
}

value WorktreeIdentity {
    id: String
    path: String
    fingerprint: String
}

value RetirementInspection {
    generation: String
    fingerprint: String
}

value RetirementResidual {
    resource_kind: RetiredResourceKind
    resource_identity: String
    reason: RetirementFailureReason
    detail: String?
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum WorkScopeKind {
    worktree
    | conversation
}

enum BlockerCategory {
    staged_tracked_paths
    | unstaged_tracked_paths
    | untracked_non_ignored_paths
    | ignored_paths
    | initialized_submodule_state
    | detached_unreachable_commits
    | external_writer
    | permission_denied
    | unsupported_layout
    | inspection_error
    | deadline_exceeded
    | identity_uncertain
    | ownership_conflict
}

enum RetiredResourceKind {
    work_scope
    | worktree
    | bash_process_group
    | tmux_server
    | pty_session
    | browser_session
    | equivalent_live_resource
}

enum RetirementFailureReason {
    removal_failed
    | still_shared_by_live_owner
    | residual_process_alive
    | identity_not_proven
    | manual_repair_required
}

enum PrDisplayState {
    open
    | draft
    | merged
    | closed
}

enum PrCheckState {
    passing
    | pending
    | failing
    | unknown
}

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity AttachedWorkScope {
    product_conversation: bedrock/ProductConversation
    scope: WorkScope
    owns_git_worktree: Boolean
}

external entity CloseRetirementAuthority {
    product_conversation: bedrock/ProductConversation
    scope: WorkScope
}

external entity RetirementAttempt {
    attempt_id: String
    run_ordinal: Integer
    product_conversation: bedrock/ProductConversation
    scope: WorkScope
    inspection: RetirementInspection?
}

external entity Worktree {
    product_conversation: bedrock/ProductConversation
    scope: WorkScope
    identity: WorktreeIdentity
}

external entity RetirementBlockerRow {
    attempt: RetirementAttempt
    inspection: RetirementInspection
    category: BlockerCategory
    item_identity: String
    reason: String
}

external entity RetirementBlockerDecision {
    product_conversation: bedrock/ProductConversation
    attempt_id: String
    run_ordinal: Integer
    inspection: RetirementInspection
}

external entity RetirementDecisionScopeInspection {
    decision: RetirementBlockerDecision
    attempt: RetirementAttempt
    inspection: RetirementInspection
}

-- RetirementDecisionScopeInspection is the immutable complete membership relation
-- from one aggregate decision to its exact per-scope snapshots, including scopes
-- with no blocker rows. Decision, membership, inspections and rows are captured
-- atomically; later inspection creates a new decision and never rewrites members.
-- This is an evidence binding, not a replacement blocker persistence subsystem.

external entity RetiredResource {
    attempt: RetirementAttempt
    product_conversation: bedrock/ProductConversation
    scope: WorkScope
    kind: RetiredResourceKind
    resource_identity: String
}

external entity RetirementResidualResource {
    attempt: RetirementAttempt
    product_conversation: bedrock/ProductConversation
    scope: WorkScope
    residual: RetirementResidual
}

external entity RetirementAbsenceEvidence {
    attempt: RetirementAttempt
    product_conversation: bedrock/ProductConversation
    scope: WorkScope
    resource_kind: RetiredResourceKind
    resource_identity: String
}

external entity RestartRepairEvidenceAdoption {
    attempt: RetirementAttempt
    restart_repair_evidence: gitrep/RestartRepairEvidence
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- REQ-WL-002f: Bedrock owns native source verification, exact request/attempt/run
-- receipts and idempotent replay. Observation never admits another run. Every
-- successor requires explicit Retry, fresh safety evidence and original authority,
-- even when only final metadata remains. Stop/pause/cancellation fence effects;
-- startup, elapsed time, source replacement and changed preconditions cannot
-- authorize work. All-success interruption is still unsuccessful, with mandatory
-- delivery and no invented resource failure. History never reopens on retry.
-- Explicit admission atomically retains an immutable typed remaining-effect plan
-- or positive verified-completion provenance, successor and native receipt. Only
-- that run-bound plan dispatches; no generic initial settlement/inspection fallback
-- is an effect authority. Zero-effect completion needs positive persisted proof of
-- all original resource AND independent WorkScope successes and owned shutdown;
-- an empty plan, interruption label or unknown outcome proves nothing. Each scope
-- is an independent ordered outcome after its pending resources, including in a
-- scope-only plan. Process-epoch stop effects are not retry-plan vocabulary.
-- Stop/pause/cancellation/source-fence admission directly and atomically settles
-- unfinished explicit retries: exact terminal failure, residual/resource evidence,
-- cancelled outcome when applicable, shutdown-based lifecycle/attention and the
-- once-per-run outbox. Exact cancellation of a stopped retained explicit retry
-- settles the same lifecycle/attention and cancelled operation outcome atomically,
-- preserving immutable stopped-run evidence and delivery identity. No optional
-- notification or later callback repairs this.
-- Prior History and positive shutdown evidence survive uncertainty; prior Open
-- enters History only with stable positive owned shutdown, otherwise remains
-- Open/CloseIncomplete. Publish History only on an actual Open-to-History commit.
-- Losing callbacks read that terminal disposition and cannot bypass suppression.
-- Unavailable terminal storage closes process authority and reports failure; it
-- never leaves authority to execute a Running successor or guesses completion.

rule ChatOnlyCloseSkipsWorktreeInspection {
    when: RetirementInspectionRequested(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires:
        not exists AttachedWorkScope{product_conversation: product_conversation, owns_git_worktree: true}
    ensures: RetirementInspectionCompletedWithoutConfirmation(
        product_conversation,
        attempt_id,
        run_ordinal,
        inspection_generation: "no-worktree",
        inspection_fingerprint: "no-worktree"
    )

    @guidance
        -- Skip inspection only when NO attached scope owns a Git-backed worktree.
        -- The presence of other attached non-worktree scopes does not bypass
        -- inspection for a mixed-attachment aggregate that still owns a worktree.
}

rule RetirementInspectionRequestCreatesAttemptBoundEvidence {
    when: RetirementInspectionRequested(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: exists AttachedWorkScope{product_conversation: product_conversation, owns_git_worktree: true}
    ensures:
        for scope_binding in attached_worktree_scopes(product_conversation):
            RetirementAttempt.created(
                attempt_id: attempt_id, run_ordinal: run_ordinal,
                product_conversation: product_conversation,
                scope: scope_binding.scope,
                inspection: RetirementInspection {
                    generation: current_retirement_inspection_generation(product_conversation, scope_binding.scope),
                    fingerprint: current_retirement_inspection_fingerprint(product_conversation, scope_binding.scope)
                }
            )
            and for category in current_retirement_blocker_categories(product_conversation, scope_binding.scope):
                for item_identity in current_retirement_blocker_item_identities(product_conversation, scope_binding.scope, category):
                    RetirementBlockerRow.created(
                        attempt: RetirementAttempt{
                            attempt_id: attempt_id, run_ordinal: run_ordinal,
                            product_conversation: product_conversation,
                            scope: scope_binding.scope,
                            inspection: RetirementInspection {
                                generation: current_retirement_inspection_generation(product_conversation, scope_binding.scope),
                                fingerprint: current_retirement_inspection_fingerprint(product_conversation, scope_binding.scope)
                            }
                        },
                        inspection: RetirementInspection {
                            generation: current_retirement_inspection_generation(product_conversation, scope_binding.scope),
                            fingerprint: current_retirement_inspection_fingerprint(product_conversation, scope_binding.scope)
                        },
                        category: category,
                        item_identity: item_identity,
                        reason: current_retirement_blocker_reason(product_conversation, scope_binding.scope, category, item_identity)
                    )

    ensures: RetirementInspectionEvidenceCaptured(product_conversation, attempt_id, run_ordinal)

    @guidance
        -- Before selecting the blocked or clear inspection outcome, Phoenix
        -- materializes one exact RetirementAttempt plus its exact RetirementInspection
        -- and categorized blocker inventory for every attached Git-backed scope bound
        -- to this Close attempt_id. Each RetirementBlockerRow is one exact
        -- (scope, category, item_identity) row, so every at-risk path or detached commit
        -- becomes distinct evidence rather than collapsing multiple items into one
        -- category summary. Operational impediments name the exact affected expected
        -- resource or scope when a path cannot be inspected, without inventing files
        -- or writer identities. Incomplete inspection always creates a blocker.
        -- Evidence capture and decision creation share one atomic snapshot; neither
        -- outcome selection nor projection recomputes through a separate side channel.
}

rule CloseWithoutAttachedWorkScopeCompletesRetirementIdempotently {
    when: ResourceRetirementRequested(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        retirement_requested
    }
    requires: not exists AttachedWorkScope{product_conversation: product_conversation}
    ensures: ResourceRetirementCompleted(product_conversation, attempt_id, run_ordinal)

    @guidance
        -- A Close on a chat-only or otherwise no-scope aggregate has no owned
        -- retirement resources. Emit completion idempotently so Close can progress
        -- without inventing residual work or requiring a synthetic WorkScope.
}

rule GitBackedInspectionWithoutBlockersRequestsRetirement {
    when: RetirementBlockerDecisionCaptured(decision)
    let product_conversation = decision.product_conversation
    let attempt_id = decision.attempt_id
    let run_ordinal = decision.run_ordinal
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: exists AttachedWorkScope{product_conversation: product_conversation, owns_git_worktree: true}
    requires:
        for scope_binding in attached_worktree_scopes(product_conversation):
            exists RetirementAttempt{attempt_id: attempt_id, run_ordinal: run_ordinal, product_conversation: product_conversation, scope: scope_binding.scope, inspection: RetirementInspection}
    requires: exact_retirement_blocker_decision(product_conversation, attempt_id, run_ordinal) = decision
    requires: not inspection_has_blockers(decision)
    ensures: RetirementBlockerProjectionAvailable(decision)
    ensures: RetirementInspectionCompletedWithoutConfirmation(
        product_conversation,
        attempt_id,
        run_ordinal,
        inspection_generation: decision.inspection.generation,
        inspection_fingerprint: decision.inspection.fingerprint
    )

    @guidance
        -- The decision covers the union of all exact attached-scope inventories.
        -- Staged, unstaged/conflicted/unmerged, untracked, ignored/build paths,
        -- dirty/untracked initialized-submodule state and unreachable detached
        -- commits block when preservation cannot be proven. No repository metadata
        -- grants discard permission. Nested repositories are inspected only as
        -- declared submodules. LFS edits are tracked changes; branches, remote refs,
        -- tags and stash are durable refs, but reflog-only detached commits are not.
        -- Writers, permission/layout errors, inspection gaps and deadlines also
        -- block. A clear content inventory is not proof that mutation will succeed.
}

rule GitBackedInspectionWithBlockersStopsRun {
    when: RetirementBlockerDecisionCaptured(decision)
    let product_conversation = decision.product_conversation
    let attempt_id = decision.attempt_id
    let run_ordinal = decision.run_ordinal
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: exact_retirement_blocker_decision(product_conversation, attempt_id, run_ordinal) = decision
    requires: inspection_has_blockers(decision)
    ensures: RetirementBlockerProjectionAvailable(decision)
    ensures: CloseRetirementStepFailed(product_conversation, attempt_id, run_ordinal,
        authority_kind: resource_failure,
        resource_failures: exact_retirement_failure_evidence(product_conversation, attempt_id, run_ordinal))

    @guidance
        -- The same decision supplies the actual stop decision, exact failure children
        -- and projection. Retry and Stop are the choices, not discard/salvage/repair.
        -- Owner cleanup occurs under separate authority outside Close, followed by
        -- fresh inspection and explicit safe-retry admission. A file's ignored or
        -- build status never makes it disposable. A blocker is not deletion consent.
}

rule InspectionEvidenceProducesOneBlockerDecision {
    when: RetirementInspectionEvidenceCaptured(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: exists AttachedWorkScope{product_conversation: product_conversation, owns_git_worktree: true}
    requires: all_targeted_scope_inspection_evidence_captured(product_conversation, attempt_id, run_ordinal)
    ensures:
        let decision = RetirementBlockerDecision.created(
            product_conversation: product_conversation,
            attempt_id: attempt_id,
            run_ordinal: run_ordinal,
            inspection: RetirementInspection {
                generation: aggregate_inspection_generation(attempt_bound_scope_inspections(product_conversation, attempt_id, run_ordinal)),
                fingerprint: aggregate_inspection_fingerprint(attempt_bound_scope_inspections(product_conversation, attempt_id, run_ordinal))
            }
        )
        for scope_binding in captured_worktree_scope_bindings(product_conversation, attempt_id):
            RetirementDecisionScopeInspection.created(
                decision: decision,
                attempt: RetirementAttempt{attempt_id: attempt_id, run_ordinal: run_ordinal, product_conversation: product_conversation, scope: scope_binding.scope},
                inspection: exact_captured_scope_inspection(product_conversation, attempt_id, run_ordinal, scope_binding.scope)
            )
        RetirementBlockerDecisionCaptured(decision)

    @guidance
        -- One decision per exact aggregate inspection snapshot; replay reads it.
        -- The projection references its normalized blocker rows, never a second
        -- independently computed inventory or classifier. A missing target inventory
        -- is a concrete inspection-error blocker, not an empty/clear inspection.
}

rule RetirementRequestedRetiresOwnedResources {
    when: ResourceRetirementRequested(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        retirement_requested
    }
    requires: exists AttachedWorkScope{product_conversation: product_conversation}
    requires:
        for scope_binding in attached_owned_scopes(product_conversation):
            exists CloseRetirementAuthority{product_conversation: product_conversation, scope: scope_binding.scope}
            and not blocked_by_distinct_open_product_or_identity_conflict(product_conversation, scope_binding.scope)
            and all_owned_resources_retired(product_conversation, scope_binding.scope)
    ensures: ResourceRetirementCompleted(product_conversation, attempt_id, run_ordinal)

    @guidance
        -- Retirement completion is the final aggregate gate only after per-resource
        -- retirement has already produced exact-attempt, exact-scope evidence for
        -- every owned resource of every attached owned scope, or exact-attempt
        -- absence evidence where applicable.
}

rule RetirementRequestedCreatesPerResourceEvidence {
    when: ResourceRetirementRequested(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        retirement_requested
    }
    requires: exists AttachedWorkScope{product_conversation: product_conversation}
    ensures:
        for scope_binding in selected_next_retirement_scope(product_conversation, attempt_id, run_ordinal):
            if exists CloseRetirementAuthority{product_conversation: product_conversation, scope: scope_binding.scope}
               and not blocked_by_distinct_open_product_or_identity_conflict(product_conversation, scope_binding.scope)
               and retirement_step_succeeds_for_pending_resource(product_conversation, scope_binding.scope)
               and fresh_exact_retirement_authority_without_blockers(product_conversation, attempt_id, run_ordinal):
                RetiredResource.created(
                    attempt: RetirementAttempt{attempt_id: attempt_id, run_ordinal: run_ordinal, product_conversation: product_conversation, scope: scope_binding.scope},
                    product_conversation: product_conversation,
                    scope: scope_binding.scope,
                    kind: retired_resource_kind_for_pending_step(product_conversation, scope_binding.scope),
                    resource_identity: retired_resource_identity_for_pending_step(product_conversation, scope_binding.scope)
                )
                and ResourceRetirementProgressRecorded(product_conversation, attempt_id, run_ordinal)

    @guidance
        -- Resource retirement is stepwise and idempotent. Each successful step creates
        -- typed RetiredResource evidence for the exact RetirementAttempt before the
        -- all-owned-resources completion gate can fire.
}

rule DistinctOpenAggregateOrIdentityConflictPreventsDestructiveRetirement {
    when: ResourceRetirementRequested(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        retirement_requested
    }
    requires: exists AttachedWorkScope{product_conversation: product_conversation}
    requires: exists CloseRetirementAuthority{product_conversation: product_conversation, scope: AttachedWorkScope.scope}
    requires: blocked_by_distinct_open_product_or_identity_conflict(product_conversation)
    ensures: CloseRetirementStepFailed(product_conversation, attempt_id, run_ordinal,
        authority_kind: resource_failure,
        resource_failures: exact_retirement_failure_evidence(product_conversation, attempt_id, run_ordinal))

    @guidance
        -- Continuation rows and subordinate execution conversations inside the same
        -- ProductConversation do not block retirement of that aggregate's attached
        -- WorkScope. Destructive teardown stops only when Phoenix sees a genuinely
        -- distinct open ProductConversation sharing the scope, or cannot resolve
        -- whether such a distinct aggregate exists because identity evidence conflicts.
}

rule AmbiguousPrivateDirectoryIdentityPreservesSafeLeftover {
    when: ResourceRetirementRequested(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: exists CloseRetirementAuthority{product_conversation: product_conversation, scope: AttachedWorkScope.scope}
    requires: phoenix_private_retirement_directory_identity_is_ambiguous(product_conversation, attempt_id, run_ordinal)
    ensures: safe_retirement_leftover_is_preserved(product_conversation, attempt_id, run_ordinal)
    ensures: CloseRetirementStepFailed(product_conversation, attempt_id, run_ordinal,
        authority_kind: resource_failure,
        resource_failures: exact_retirement_failure_evidence(product_conversation, attempt_id, run_ordinal))

    @guidance
        -- Normal Close authority comes from the sealed WorkScope gate plus a random,
        -- Phoenix-owned owner-only directory. Final removal validates both the opened
        -- directory and object identities. Post-crash or external ambiguity preserves
        -- a safe leftover for repair. Concurrent malicious mutation inside that private
        -- namespace and mutation outside Phoenix ownership are unsupported.
        --
        -- Immediately before moving the inspected worktree into quarantine,
        -- Phoenix stops every Git fsmonitor daemon bound to that worktree or to
        -- an initialized submodule beneath it, and waits a bounded time for each
        -- to exit. The open-descriptor scan after quarantine therefore sees only
        -- processes that are not Git's own filesystem watcher. A worktree with no
        -- running daemon treats the stop as a silent no-op. A stop that misses its
        -- deadline ends the run immediately with typed failure; Phoenix does not
        -- continue into quarantine or the descriptor scan after that failed stop.
        -- Phoenix never changes the user's fsmonitor configuration or index state.
        -- External-writer scans classify directory descriptors and cwd as
        -- path-relative authority, writable regular-file descriptors as direct
        -- authority, and writable shared mappings independently of descriptors.
        -- Process incarnation and descriptor identity must remain stable;
        -- incomplete attributable inspection blocks deletion. Under admitted-run
        -- authority, a positive writer or inspection gap is persisted as an
        -- immutable child observation of the exact run, scope, inspection snapshot
        -- and resource before returning the blocker. Failed evidence persistence
        -- preserves the target (REQ-WL-002e). Pre-admission retry probes cannot
        -- write observations under a hypothetical ordinal.
}

rule RetirementStepSuccessRecordsTypedEvidence {
    when: ResourceRetirementRequested(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        retirement_requested
    }
    let scope_binding = AttachedWorkScope{product_conversation: product_conversation}
    requires: exists AttachedWorkScope{product_conversation: product_conversation}
    requires: exists RetiredResource{
        attempt: RetirementAttempt{attempt_id: attempt_id, run_ordinal: run_ordinal, product_conversation: product_conversation, scope: scope_binding.scope},
        product_conversation: product_conversation,
        scope: scope_binding.scope,
        kind: retired_resource_kind_for_completed_step(product_conversation, scope_binding.scope),
        resource_identity: retired_resource_identity_for_completed_step(product_conversation, scope_binding.scope)
    }
    ensures: ResourceRetirementProgressRecorded(product_conversation, attempt_id, run_ordinal)

    @guidance
        -- Progress reporting consumes already-created exact-attempt RetiredResource
        -- evidence for the bound attached scope; it does not stand in for creating
        -- that evidence.
}

rule FreshRunAdoptsCompletedResourceWithoutRepeatingEffect {
    when: ResourceRetirementRequested(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = retirement_requested
    let scope_binding = AttachedWorkScope{product_conversation: product_conversation}
    let prior = exact_prior_completed_resource(product_conversation, attempt_id, run_ordinal, scope_binding.scope)
    requires: exists prior
    requires: prior.attempt.run_ordinal < run_ordinal
    requires: fresh_run_adopts_completed_resource(product_conversation, scope_binding.scope, prior.resource_identity)
    ensures: RetiredResource.created(
        attempt: RetirementAttempt{attempt_id: attempt_id, run_ordinal: run_ordinal, product_conversation: product_conversation, scope: scope_binding.scope},
        product_conversation: product_conversation,
        scope: scope_binding.scope,
        kind: prior.kind,
        resource_identity: prior.resource_identity
    )
    ensures: ResourceRetirementProgressRecorded(product_conversation, attempt_id, run_ordinal)
    ensures: not CompletedRetirementEffectRepeated(prior)

    @guidance
        -- Fresh exact identity observations adopt immutable completion evidence into
        -- this run; no process signal or filesystem deletion repeats the prior effect.
}

rule RetirementProgressTriggersNextExactAttemptStep {
    when: ResourceRetirementProgressRecorded(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        retirement_requested
    }
    requires: exists AttachedWorkScope{product_conversation: product_conversation}
    requires: exists CloseRetirementAuthority{product_conversation: product_conversation, scope: AttachedWorkScope.scope}
    requires: owned_resource_pending_retirement(product_conversation, AttachedWorkScope.scope)
    ensures: ResourceRetirementRequested(product_conversation, attempt_id, run_ordinal)

    @guidance
        -- Progress advances only a still-running run; failure revokes all further
        -- dispatch even when a delayed success/progress event arrives.
}

rule RetirementProgressReevaluatesCompletionForExactAttempt {
    when: ResourceRetirementProgressRecorded(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        retirement_requested
    }
    requires: exists AttachedWorkScope{product_conversation: product_conversation}
    requires: exists CloseRetirementAuthority{product_conversation: product_conversation, scope: AttachedWorkScope.scope}
    requires: all_owned_resources_retired(product_conversation)
    ensures: ResourceRetirementRequested(product_conversation, attempt_id, run_ordinal)

    @guidance
        -- Progress also reissues the exact attempt request when the last owned
        -- resource retires so the aggregate completion gate can fire from the same
        -- attempt-bound path.
}

rule ResourceRetirementFailureProducesResidualRepairState {
    when: ResourceRetirementRequested(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        retirement_requested
    }
    let scope_binding = failing_retirement_scope(product_conversation, attempt_id, run_ordinal)
    let resource_identity = residual_resource_identity_for_attempt(product_conversation, scope_binding.scope)
    requires: retirement_step_failed(product_conversation, attempt_id, run_ordinal)
    ensures: RetirementResidualResource.created(
        attempt: RetirementAttempt{attempt_id: attempt_id, run_ordinal: run_ordinal, product_conversation: product_conversation, scope: scope_binding.scope},
        product_conversation: product_conversation,
        scope: scope_binding.scope,
        residual: RetirementResidual{
            resource_kind: residual_resource_kind_for_attempt(product_conversation, scope_binding.scope),
            resource_identity: resource_identity,
            reason: residual_reason_for_attempt(product_conversation, scope_binding.scope),
            detail: residual_repair_detail_for_attempt(product_conversation, scope_binding.scope)
        }
    )
    ensures: CloseRetirementStepFailed(product_conversation, attempt_id, run_ordinal,
        authority_kind: resource_failure,
        resource_failures: exact_retirement_failure_evidence(product_conversation, attempt_id, run_ordinal))

    @guidance
        -- Failure is typed and residual: report the exact remaining resource and
        -- repair information rather than silently succeeding. Residual rows are bound
        -- to the same exact RetirementAttempt as any earlier RetiredResource evidence,
        -- so partial completion remains visible across retries.
}

rule ExplicitRunLeavesUnprovenProcessEpochResourcesUntouched {
    when: ResourceRetirementRequested(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        retirement_requested
    }
    requires: process_epoch_resource_has_no_live_retirement_permit(product_conversation, attempt_id, run_ordinal)
    ensures: CloseRetirementStepFailed(product_conversation, attempt_id, run_ordinal,
        authority_kind: source_authority_lost,
        resource_failures: exact_retirement_failure_evidence(product_conversation, attempt_id, run_ordinal))

    @guidance
        -- Bash, PTY, browser, and equivalent ordinary execution resources are owned
        -- by the live Phoenix process epoch. A fresh explicit retry neither discovers
        -- nor signals a former epoch's resource; missing proof is a failure, not progress.
}

rule ExplicitRunRequiresExactTmuxIdentity {
    when: ResourceRetirementRequested(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: pending_tmux_identity_is_ambiguous(product_conversation, attempt_id, run_ordinal)
    ensures: CloseRetirementStepFailed(product_conversation, attempt_id, run_ordinal,
        authority_kind: resource_failure,
        resource_failures: exact_retirement_failure_evidence(product_conversation, attempt_id, run_ordinal))

    @guidance
        -- Tmux is the intentionally persistent runtime resource. Its sealed socket
        -- path and Phoenix server token must jointly identify the live server; a
        -- socket path alone is never destructive authority.
}

rule ExactAttemptAdoptsRestartRepairAbsenceEvidence {
    when: ResourceRetirementRequested(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    let scope_binding = pending_worktree_retirement_scope(product_conversation, attempt_id, run_ordinal)
    let repair_evidence = exact_restart_repair_evidence(product_conversation, attempt_id, run_ordinal, scope_binding.scope)
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        retirement_requested
    }
    requires: exists scope_binding
    requires: exists CloseRetirementAuthority{product_conversation: product_conversation, scope: scope_binding.scope}
    requires: worktree_already_absent(product_conversation, scope_binding.scope)
    requires: exists repair_evidence
    requires: repair_evidence.observation_kind = missing
    requires: complete_restart_repair_identity_available(repair_evidence, product_conversation, scope_binding.scope)
    requires: same_repository_and_worktree_identity(repair_evidence, product_conversation, attempt_id, run_ordinal, scope_binding.scope)
    requires: no_replacement_worktree_appeared_since_restart_observation(repair_evidence, scope_binding.scope)
    requires: exact_active_retirement_attempt(product_conversation, attempt_id, run_ordinal, scope_binding.scope)
    requires: not exists RestartRepairEvidenceAdoption{attempt: RetirementAttempt{attempt_id: attempt_id, run_ordinal: run_ordinal, product_conversation: product_conversation, scope: scope_binding.scope}}
    ensures: RestartRepairEvidenceAdoption.created(
        attempt: RetirementAttempt{attempt_id: attempt_id, run_ordinal: run_ordinal, product_conversation: product_conversation, scope: scope_binding.scope},
        restart_repair_evidence: repair_evidence
    )
    ensures: RetirementAbsenceEvidence.created(
        attempt: RetirementAttempt{attempt_id: attempt_id, run_ordinal: run_ordinal, product_conversation: product_conversation, scope: scope_binding.scope},
        product_conversation: product_conversation,
        scope: scope_binding.scope,
        resource_kind: worktree,
        resource_identity: repair_evidence.worktree.id
    )
    ensures: ResourceRetirementProgressRecorded(product_conversation, attempt_id, run_ordinal)

    @guidance
        -- Adoption is fail-closed and exact-attempt-bound. Phoenix may adopt
        -- retained restart repair evidence only when the active Close attempt,
        -- ProductConversation, WorkScope, hidden repository identity, and
        -- worktree identity/fingerprint all match; no replacement worktree has
        -- appeared; and the source observation remains immutable. Adoption creates
        -- new exact-attempt absence evidence plus a typed adoption relation without
        -- rewriting the restart observation.
}

rule RestartRepairConflictRoutesTypedRepair {
    when: ResourceRetirementRequested(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    let scope_binding = pending_worktree_retirement_scope(product_conversation, attempt_id, run_ordinal)
    let repair_evidence = latest_restart_repair_evidence(product_conversation, scope_binding.scope)
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        retirement_requested
    }
    requires: exists scope_binding
    requires: exists CloseRetirementAuthority{product_conversation: product_conversation, scope: scope_binding.scope}
    requires: worktree_already_absent(product_conversation, scope_binding.scope)
    requires: exists repair_evidence
    requires:
        repair_evidence.observation_kind = inaccessible
        or not complete_restart_repair_identity_available(repair_evidence, product_conversation, scope_binding.scope)
        or not same_repository_and_worktree_identity(repair_evidence, product_conversation, attempt_id, run_ordinal, scope_binding.scope)
        or replacement_worktree_appeared_since_restart_observation(repair_evidence, scope_binding.scope)
        or not exact_active_retirement_attempt(product_conversation, attempt_id, run_ordinal, scope_binding.scope)
    ensures: CloseRetirementStepFailed(product_conversation, attempt_id, run_ordinal,
        authority_kind: resource_failure,
        resource_failures: exact_retirement_failure_evidence(product_conversation, attempt_id, run_ordinal))

    @guidance
        -- A later Close attempt may bind fresh retained restart evidence for the
        -- same repository, but only from a new exact attempt. When identity is
        -- inaccessible, identity is incomplete, a replacement appears, or the active
        -- attempt does not match, Phoenix reports a concrete blocker for separate
        -- owner investigation instead of guessing continuity from the
        -- path or silently adopting a stale absence observation.
}

rule AlreadyAbsentWorktreeNeedsIdentityEvidence {
    when: ResourceRetirementRequested(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        retirement_requested
    }
    let scope_binding = pending_worktree_retirement_scope(product_conversation, attempt_id, run_ordinal)
    requires: exists scope_binding
    requires: exists CloseRetirementAuthority{product_conversation: product_conversation, scope: scope_binding.scope}
    requires: worktree_already_absent(product_conversation, scope_binding.scope)
    requires: not exists RetirementAbsenceEvidence{attempt: RetirementAttempt{attempt_id: attempt_id, run_ordinal: run_ordinal, product_conversation: product_conversation, scope: scope_binding.scope}, product_conversation: product_conversation, scope: scope_binding.scope, resource_kind: worktree, resource_identity: absent_worktree_identity(product_conversation, scope_binding.scope)}
    requires: not exists RestartRepairEvidenceAdoption{attempt: RetirementAttempt{attempt_id: attempt_id, run_ordinal: run_ordinal, product_conversation: product_conversation, scope: scope_binding.scope}}
    ensures: CloseRetirementStepFailed(product_conversation, attempt_id, run_ordinal,
        authority_kind: resource_failure,
        resource_failures: exact_retirement_failure_evidence(product_conversation, attempt_id, run_ordinal))

    @guidance
        -- An already-absent worktree is accepted only when retained identity and
        -- evidence show this retirement is adopting that exact absence rather than
        -- guessing over a missing path. Without exact-attempt absence evidence or
        -- an exact-attempt adoption of immutable restart repair evidence, report
        -- typed residual state instead of silently treating absence as success.
        -- Duplicate or conflicting highest-generation evidence for this exact
        -- WorkScope also follows this typed-repair path.
}

rule AlreadyAbsentWorktreeWithExactAttemptEvidenceIsAccepted {
    when: ResourceRetirementRequested(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        retirement_requested
    }
    let scope_binding = pending_worktree_retirement_scope(product_conversation, attempt_id, run_ordinal)
    requires: exists scope_binding
    requires: exists CloseRetirementAuthority{product_conversation: product_conversation, scope: scope_binding.scope}
    requires: worktree_already_absent(product_conversation, scope_binding.scope)
    requires: exists RetirementAbsenceEvidence{attempt: RetirementAttempt{attempt_id: attempt_id, run_ordinal: run_ordinal, product_conversation: product_conversation, scope: scope_binding.scope}, product_conversation: product_conversation, scope: scope_binding.scope, resource_kind: worktree, resource_identity: absent_worktree_identity(product_conversation, scope_binding.scope)}
    ensures: ResourceRetirementProgressRecorded(product_conversation, attempt_id, run_ordinal)

    @guidance
        -- Exact-attempt absence evidence lets retirement accept an already-absent
        -- worktree idempotently after the active attempt has either created that
        -- absence evidence directly or adopted immutable restart repair evidence
        -- for that same exact attempt.
}


-- exact_retirement_failure_evidence returns Set<bedrock/CloseResourceFailureEvidence>
-- from the owning step's structured failure decision, not from residual strings:
-- failed scope/resource retirement, identity/ownership validation, missing exact
-- absence/reconstructibility evidence, or missing live process-epoch permission.
-- Each row names the sealed expected resource identity and exact scope plus the
-- failed precondition/outcome; ambiguity never guesses the live object's identity.
-- Every resource_failure producer in this spec supplies its nonempty exact affected set.
-- A missing process permit is source_authority_lost and still retains the exact
-- affected resource rows. Pure observation/interruption with no failed resource
-- decision is handled by bedrock with an intentional empty set, not by this bridge.
-- Step outcome, normalized children, stopped primary and mandatory outbox are one
-- owning failure transaction; these events cannot defer child insertion to a worker.
-- Native INITIAL resource failure and exact stopped replay both require the
-- original live/durable source and retained initial receipt. The primary must
-- be unresolved in the exact sealed original inventory; already successful
-- resources stay excluded, and the ordered remaining tail is Failed for the
-- primary and Unattempted for the rest. Failure, residual proof, stopped run,
-- outcome and mandatory delivery commit together; replay is read-only. Generic
-- legacy failure ingress cannot replace source authority. Source-owned inspection
-- and interruption paths retain their own proof boundary; an all-success tail
-- cannot be fabricated into resource failure when source authority is lost.
-- REQ-WL-002b / REQ-WL-004: every retirement failure enters the same
-- run-stopping and mandatory-Global-delivery boundary owned by bedrock.
rule RetirementFailureStopsBeforeAnyFurtherStep {
    when: CloseRetirementStepFailed(product_conversation, attempt_id, run_ordinal, authority_kind, resource_failures)
    let run = bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}
    requires: run.status = running
    ensures: CloseRunFailed(product_conversation, attempt_id, run_ordinal,
        failed_step: failed_retirement_step(run), reason: failed_retirement_reason(run), authority_kind: authority_kind,
        shutdown: observed_retirement_shutdown(run), residual_evidence: exact_retirement_residuals(run), resource_failures: resource_failures)

    @guidance
        -- Stop/failure persistence is the step's commit boundary, not a delayed
        -- background callback. No other scope's step can execute after this failure.
        -- The failure's exact blocker rows and user projection come from this
        -- owning decision, including newly observed operational impediments.
        -- Confirmed conversation-and-owned-process shutdown permits History only
        -- with conspicuous incomplete/disk-retained cleanup attention, exact
        -- blockers and explicit Retry/Stop. Uncertain shutdown before any positive
        -- History commit stays visible Open/CloseIncomplete. Later uncertainty
        -- preserves committed History and prior positive evidence, never reopening
        -- execution or implying that retained resources were retired.
        -- Stop preserves unresolved targets/evidence and ends further Close effects;
        -- it is not discard, successful cleanup, or permission to open the gate.
}

rule MutationBoundaryBlockersPreserveWorktree {
    when: ResourceRetirementRequested(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: pending_step_deletes_worktree(product_conversation, attempt_id, run_ordinal)
    let decision = mutation_boundary_blocker_decision(product_conversation, attempt_id, run_ordinal)
    requires: exists decision
    requires: inspection_has_blockers(decision)
    ensures: RetirementBlockerProjectionAvailable(decision)
    ensures: WorktreePreserved(product_conversation, attempt_id, run_ordinal)
    ensures: CloseRetirementStepFailed(product_conversation, attempt_id, run_ordinal,
        authority_kind: resource_failure,
        resource_failures: exact_retirement_failure_evidence(product_conversation, attempt_id, run_ordinal))

    @guidance
        -- Close preserves the target and stops. It neither proposes nor executes
        -- repair/discard/salvage as a Close phase. Separate owner-authorized cleanup
        -- cannot be inferred from Retry; retry requires fresh blocker inspection.
}

rule MutationBoundaryInspectionFailureCannotLeaveAuthorizedRunningRun {
    when: ResourceRetirementRequested(product_conversation, attempt_id, run_ordinal)
    requires: bedrock/CloseRun{obligation: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}, ordinal: run_ordinal}.status = running
    requires: pending_step_deletes_worktree(product_conversation, attempt_id, run_ordinal)
    let decision = mutation_boundary_blocker_decision(product_conversation, attempt_id, run_ordinal)
    requires: not exists decision
    ensures: WorktreePreserved(product_conversation, attempt_id, run_ordinal)
    ensures:
        if terminal_failure_storage_available(product_conversation, attempt_id, run_ordinal):
            CloseRetirementStepFailed(product_conversation, attempt_id, run_ordinal,
                authority_kind: resource_failure,
                resource_failures: exact_retirement_failure_evidence(product_conversation, attempt_id, run_ordinal))
        else:
            CloseProcessAuthorityClosedAndStorageFailureReported(product_conversation, attempt_id, run_ordinal)

    @guidance
        -- An inspection/storage error is not a clear decision or a silently
        -- dropped request. Stop further effects immediately. If terminal storage
        -- works, the shared exact-run failure/outbox boundary commits the error;
        -- otherwise revoke process authority and report the persistence failure.
        -- Neither branch retries effects or claims successful terminalization.
}

rule PrStatusObservedAsAdvisoryCloseGuidance {
    when: PrStatusQueried(product_conversation)
    ensures: PrStatusResultDelivered(product_conversation, found: Boolean, display_state: PrDisplayState?, check_state: PrCheckState?, number: Integer?, unavailable_reason: String?)

    @guidance
        -- PR observation may guide the user toward Close, especially when a PR is
        -- merged, but it never blocks Close, retirement inspection, or retirement,
        -- and never closes, mutates, or retargets a PR.
}

------------------------------------------------------------
-- Helpers
------------------------------------------------------------
--
-- Allium has no formal helper-function declaration; this block defines the
-- complete semantics of each bare helper used above.
--
--   current_retirement_blocker_categories(product_conversation, scope)
--       -> Set<BlockerCategory>
--   current_retirement_blocker_item_identities(product_conversation, scope, category)
--       -> Set<String>
--   current_retirement_blocker_reason(product_conversation, scope, category, item)
--       -> String
--       Read one coherent exact inspection snapshot, materializing one row per
--       (scope, category, item). Content includes ignored/build files; operational
--       blockers retain concrete writer/permission/layout/error/deadline reasons.
--       An uninspectable target names its expected scope/resource as a gap, never
--       disappears from the inventory. No disposable-state classifier is consulted.
--
--   captured_worktree_scope_bindings(product_conversation, attempt_id)
--       -> List<AttachedWorkScope>
--       Exactly the immutable original captured worktree-owning scope set for the
--       attempt, not current attachments; ordered by opaque scope identity bytes.
--       No new attachment expands a decision and no detached scope disappears.
--
--   decision_captured_worktree_scope(decision: RetirementBlockerDecision,
--       scope: WorkScope) -> Boolean
--       True iff scope is in captured_worktree_scope_bindings for the decision's
--       exact conversation and attempt. Never inferred from blocker-row presence.
--
--   exact_captured_scope_inspection(product_conversation, attempt_id, run_ordinal,
--       scope: WorkScope) -> RetirementInspection
--       Returns that captured scope's exact immutable inspection, including an
--       inspection-gap snapshot where applicable. It never observes live state.
--
--   terminal_failure_storage_available(product_conversation, attempt_id,
--       run_ordinal) -> Boolean
--       True only if the owning exact-run failure transaction can commit its
--       terminal state, typed evidence and mandatory outbox together. Otherwise
--       CloseProcessAuthorityClosedAndStorageFailureReported revokes process
--       effect authority and surfaces the storage failure without claiming a
--       durable terminal state. No subsequent effect is authorized in either case.
--
--   all_targeted_scope_inspection_evidence_captured(product_conversation,
--       attempt_id, run_ordinal) -> Boolean
--       True only after each captured worktree scope has an exact inspection and
--       all of its normalized blocker rows, including any inspection-gap row.
--       Missing/conflicting target identity is materialized as an exact blocker,
--       not silently omitted. Evidence and decision are one atomic capture.
--
--   exact_retirement_blocker_decision(product_conversation, attempt_id, run_ordinal)
--       -> RetirementBlockerDecision?
--       Returns the unique decision for the active exact aggregate inspection.
--       Its generation/fingerprint bind the ordered complete per-scope snapshots
--       named by RetirementDecisionScopeInspection, including clear scopes. Every
--       member names the exact run/scope attempt; no later active inspection can
--       change this decision's membership or the blocker rows it consumes.
--       Absence/ambiguity cannot authorize retirement. Replays return the retained
--       decision. Fresh mutation-boundary observations create a new bound snapshot,
--       retaining earlier decisions and rows without replacing original authority.
--
--   mutation_boundary_blocker_decision(product_conversation, attempt_id, run_ordinal)
--       -> RetirementBlockerDecision?
--       Freshly inspects exact original remaining targets and relevant ownership,
--       identity, permissions and writer state immediately before mutation. It
--       captures new normalized rows, the complete immutable per-scope inspection
--       membership relation and their aggregate decision atomically.
--       Missing/incomplete inspection is a gap blocker; inability to persist it
--       preserves the target and fails the step. It never grants live source or
--       process permission, expands targets, or authorizes independent owner cleanup.
--       This same decision is consumed by the effect gate, failure and projection.
--       All consumers share the result of one owned boundary observation, not
--       independent calls that inspect or persist competing snapshots. Absence
--       selects MutationBoundaryInspectionFailureCannotLeaveAuthorizedRunningRun.
--
--   explicit_user_retry_admission_for_run(run: bedrock/CloseRun) -> Boolean
--       True only for fresh bounded admission from an explicit user Retry of the
--       exact stopped predecessor, under original authority and fresh safe evidence.
--       Native admission retains exact request/target/source binding. An exact
--       previously admitted non-native run may finish across native adoption;
--       adoption never creates a generic fallback or automatic successor.
--
--   inspection_has_blockers(decision: RetirementBlockerDecision) -> Boolean
--       True iff any RetirementBlockerRow matches a member's exact attempt and
--       inspection in RetirementDecisionScopeInspection{decision: decision}.
--       No row from another snapshot or decision is included, and no category is
--       filtered out. Projection
--       reads exactly these rows, including reason, without recomputing a classifier.
--       Both admission and failure consumers use this same authoritative decision.
--
--   selected_next_retirement_scope(product_conversation, attempt_id, run_ordinal)
--       -> List<AttachedWorkScope>
--       Selects at most one exact remaining step across the original-authority
--       target set, in deterministic order, only while the matching run is running.
--       The next step cannot dispatch until the prior step's outcome commits.
--       WorkScope retirement is an independent final step for each exact original
--       scope, after its pending resource effects and fresh no-live-owner/resource
--       proof under the sealed gate. Worktree retirement never implies scope success.
--       Native retry uses bedrock's immutable retire_work_scope planned row and
--       exact outcome, not this generic selector as an alternative dispatch path.
--       A scope-only native plan must not repeat tmux/worktree successes; missing
--       process-epoch permits remain fail-closed and never reconstructed by retry.
--
--   retirement_step_failed(product_conversation, attempt_id, run_ordinal) -> Boolean
--       True only for the exact selected step's failed outcome in this running run.
--
--   pending_step_deletes_worktree(product_conversation, attempt_id, run_ordinal)
--       -> Boolean
--       True when the selected next step would remove a worktree or retained leftover.
--
--   fresh_exact_retirement_authority_without_blockers(
--       product_conversation, attempt_id, run_ordinal) -> Boolean
--       Requires fresh exact ownership, identity, live effect permission and
--       resolved failure preconditions for the selected original-authority target.
--       Deletion additionally requires a complete fresh blocker decision with no
--       unresolved content or operational blocker, including ignored/build paths.
--       There is no discard override, disposable classifier or inherited consent.
--       Identity and permission are rechecked at every relevant mutation boundary;
--       an earlier snapshot never guarantees a later mutation. Newly observed
--       blockers are retained with exact rows and projected from that same decision.
--       Missing live permits remain failure, not a reason to reconstruct authority.
--
--   exact_prior_completed_resource(product_conversation, attempt_id, run_ordinal,
--       scope: WorkScope) -> RetiredResource?
--       Selects an immutable successful resource record from a lower ordinal of
--       the same original Close authority and exact scope. Ambiguity returns absent.
--
--   fresh_run_adopts_completed_resource(product_conversation, scope, resource_id)
--       -> Boolean
--       True only when immutable evidence under the original Close authority proves
--       that exact resource retired and fresh observations rule out replacement.
--       Adoption creates fresh run-bound evidence, never repeats a completed effect.
--
--   failed_retirement_step(run: bedrock/CloseRun) -> String
--   failed_retirement_reason(run: bedrock/CloseRun) -> String
--   exact_retirement_residuals(run: bedrock/CloseRun) -> String
--       Read the exact selected step's typed failure and residual records, including
--       scope and resource identities. They never broaden the target/effect set.
--
--   observed_retirement_shutdown(run: bedrock/CloseRun) -> confirmed | uncertain
--       Confirmed only with positive evidence of both conversation-execution and
--       owned-process shutdown, including intentionally persistent tmux processes.
--       Missing permits, PID/path absence alone, and inaccessible probes are uncertain.
--
--   attempt_bound_scope_inspections(
--       product_conversation: bedrock/ProductConversation,
--       attempt_id: String,
--       run_ordinal: Integer
--   ) -> List<(WorkScope, RetirementInspection)>
--       Returns the complete active per-scope inspection snapshot for this exact
--       run, ordered by the opaque WorkScope identity's canonical bytes. Older
--       retained snapshots are excluded, not overwritten. Inspection values and
--       blocker rows share one atomic capture; this helper never observes live state.
--
--   aggregate_inspection_generation(
--       inspections: List<(WorkScope, RetirementInspection)>
--   ) -> String
--       A deterministic digest of the canonical length-prefixed sequence of each
--       ordered scope identity and inspection generation. Any target-set, order, or
--       per-scope generation change produces a different aggregate generation.
--
--   aggregate_inspection_fingerprint(
--       inspections: List<(WorkScope, RetirementInspection)>
--   ) -> String
--       A deterministic digest of the canonical length-prefixed sequence of each
--       ordered scope identity and inspection fingerprint. Any target-set, order, or
--       per-scope fingerprint change produces a different aggregate fingerprint.
--
--   pending_worktree_retirement_scope(
--       product_conversation: bedrock/ProductConversation,
--       attempt_id: String,
--       run_ordinal: Integer
--   ) -> AttachedWorkScope?
--       The exact attached WorkScope selected for the current worktree-retirement
--       step of attempt_id. This is step-local: one ProductConversation may have
--       multiple attached scopes overall. Ambiguity returns absent so adoption
--       fails closed rather than selecting an arbitrary scope.
--
--   same_work_scope_identity(
--       scope_ref: gitrep/WorkScopeRef,
--       scope: WorkScope
--   ) -> Boolean
--       True iff scope_ref names the same opaque persisted WorkScope as scope.
--       ProductConversation attachment, repository identity, or path equality alone
--       never proves this cross-spec identity seam.
--
--   latest_restart_repair_evidence(
--       product_conversation: bedrock/ProductConversation,
--       scope: WorkScope
--   ) -> gitrep/RestartRepairEvidence?
--       The unique complete retained observation at the highest integer generation
--       for product_conversation whose WorkScopeRef satisfies
--       same_work_scope_identity(evidence.scope, scope). Evidence for another scope
--       is ignored. No row, a duplicate highest generation, conflicting identity,
--       incomplete row, or scope ambiguity returns absent so adoption fails closed.
--
--   exact_restart_repair_evidence(
--       product_conversation: bedrock/ProductConversation,
--       attempt_id: String,
--       run_ordinal: Integer,
--       scope: WorkScope
--   ) -> gitrep/RestartRepairEvidence?
--       The latest_restart_repair_evidence row for product_conversation and scope
--       when attempt_id/run_ordinal names the sole running Close execution for
--       that exact scope and that run has not already adopted a restart observation; otherwise
--       absent. A cancelled attempt never mutates or consumes the source row; a
--       later attempt creates its own adoption after rechecking every guard.
--
--   complete_restart_repair_identity_available(
--       evidence: gitrep/RestartRepairEvidence,
--       product_conversation: bedrock/ProductConversation,
--       scope: WorkScope
--   ) -> Boolean
--       True iff evidence names product_conversation and a WorkScopeRef satisfying
--       same_work_scope_identity(evidence.scope, scope), and has non-empty
--       repository identity, worktree id, retained path, worktree fingerprint,
--       observation generation, and observation time.
--
--   same_repository_and_worktree_identity(
--       evidence: gitrep/RestartRepairEvidence,
--       product_conversation: bedrock/ProductConversation,
--       attempt_id: String,
--       run_ordinal: Integer,
--       scope: WorkScope
--   ) -> Boolean
--       True iff the active Close authority names product_conversation and scope,
--       same_work_scope_identity(evidence.scope, scope) holds, scope's retained
--       repository attachment equals evidence.repository, and scope's worktree id
--       and fingerprint equal evidence.worktree.id and evidence.worktree.fingerprint.
--       Path equality alone is insufficient.
--
--   no_replacement_worktree_appeared_since_restart_observation(
--       evidence: gitrep/RestartRepairEvidence,
--       scope: WorkScope
--   ) -> Boolean
--       True iff no filesystem observation after evidence.observed_at proves a
--       present worktree for scope. A path reappearing without matching identity
--       evidence makes this false rather than proving continuity.
--
--   replacement_worktree_appeared_since_restart_observation(
--       evidence: gitrep/RestartRepairEvidence,
--       scope: WorkScope
--   ) -> Boolean
--       The logical negation of
--       no_replacement_worktree_appeared_since_restart_observation for the same
--       evidence and scope.
--
--   exact_active_retirement_attempt(
--       product_conversation: bedrock/ProductConversation,
--       attempt_id: String,
--       run_ordinal: Integer,
--       scope: WorkScope
--   ) -> Boolean
--       True iff attempt_id/run_ordinal names the original Close authority
--       and its sole running execution bound to that exact scope.
--
--   worktree_already_absent(
--       product_conversation: bedrock/ProductConversation,
--       scope: WorkScope
--   ) -> Boolean
--       True iff that exact scope's retained worktree is observed missing and no
--       later observation proves a present replacement. `inaccessible` is not
--       absence authority and remains typed repair state.
--
--   absent_worktree_identity(
--       product_conversation: bedrock/ProductConversation,
--       scope: WorkScope
--   ) -> String
--       The retained opaque worktree id for scope; never a path-derived value.
--
------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant EverySuccessorRequiresExplicitRetry {
    for run in bedrock/CloseRun:
        run.ordinal > 1 implies explicit_user_retry_admission_for_run(run)
}

invariant ExactInspectionHasOneBlockerDecision {
    for left in RetirementBlockerDecision:
        for right in RetirementBlockerDecision:
            left.product_conversation = right.product_conversation
            and left.attempt_id = right.attempt_id
            and left.run_ordinal = right.run_ordinal
            and left.inspection = right.inspection
            implies left = right
}

invariant BlockerDecisionHasCompleteExactScopeMembership {
    for decision in RetirementBlockerDecision:
        for scope_binding in captured_worktree_scope_bindings(decision.product_conversation, decision.attempt_id):
            exists RetirementDecisionScopeInspection{
                decision: decision,
                attempt: RetirementAttempt{product_conversation: decision.product_conversation, attempt_id: decision.attempt_id, run_ordinal: decision.run_ordinal, scope: scope_binding.scope}
            }
}

invariant BlockerDecisionScopeMembershipIsExact {
    for member in RetirementDecisionScopeInspection:
        member.attempt.product_conversation = member.decision.product_conversation
        and member.attempt.attempt_id = member.decision.attempt_id
        and member.attempt.run_ordinal = member.decision.run_ordinal
        and decision_captured_worktree_scope(member.decision, member.attempt.scope)
}

invariant BlockerDecisionScopeMembershipIsUnique {
    for member in RetirementDecisionScopeInspection:
        for other in RetirementDecisionScopeInspection:
            other.decision = member.decision and other.attempt.scope = member.attempt.scope
            implies other = member
}

invariant ExactBlockerRowsAreUnique {
    for left in RetirementBlockerRow:
        for right in RetirementBlockerRow:
            left.attempt = right.attempt
            and left.inspection = right.inspection
            and left.category = right.category
            and left.item_identity = right.item_identity
            implies left = right
}

invariant CleanupAuthorityComesFromCommittedCloseOperation {
    for a in AttachedWorkScope:
        exists CloseRetirementAuthority{product_conversation: a.product_conversation, scope: a.scope}
        implies a.owns_git_worktree or a.scope.kind = conversation
}

invariant WorkScopeHasOneOrdinaryProductConversationOwner {
    for attachment in AttachedWorkScope:
        product_conversation_owner_for_scope(attachment.scope) = attachment.product_conversation
}

invariant NoAutomaticRecoveryArtifactFromRetirement {
    for a in AttachedWorkScope:
        exists CloseRetirementAuthority{product_conversation: a.product_conversation, scope: a.scope}
        implies not AutomaticRetirementSnapshotCreated(a.product_conversation)
}
