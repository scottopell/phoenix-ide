-- allium: 3
-- work-lifecycle.allium
--
-- Phoenix WorkScope Retirement: Behavioural Specification
--
-- Scope: Git-backed Close retirement inspection, exact loss classification,
--        WorkScope-owned resource retirement, and PR-state advisory guidance.
--
-- Includes:
--   - classification of exact worktree-loss categories for an attached
--     Git-backed WorkScope;
--   - generation/fingerprint-bound discard confirmation;
--   - stepwise idempotent retirement of owned worktree and WorkScope resources;
--   - PR-state guidance that may encourage Close but never blocks it.
--
-- Excludes:
--   - root lifecycle legality, close-obligation orchestration, and ProductConversation
--     Open/History transitions (bedrock owns those authorities);
--   - PR identity selection, feedback freshness, and remediation context
--     (pr-association owns those authorities);
--   - UI layout and copy.
--
-- Requirement traceability: REQ-WL-001 through REQ-WL-003,
-- REQ-PROJ-028a, REQ-PROJ-WS-001

use "../bedrock/bedrock.allium" as bedrock
use "../git-repository/git-repository.allium" as gitrep

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value WorkScope {
    kind: WorkScopeKind
    inner: String
}

value WorktreeIdentity {
    id: String
    path: String
    fingerprint: String
}

value RetirementInspection {
    generation: String
    fingerprint: String
}

value RetirementResidual {
    resource_kind: RetiredResourceKind
    resource_identity: String
    reason: RetirementFailureReason
    detail: String?
}

value AmbientWriterEvidence {
    detector: AmbientWriterDetector
    process_id: Integer
    process_incarnation: String
    executable: String
    matched_path: String
    match_kind: AmbientPathMatchKind
    access_mode: DescriptorAccessMode
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum WorkScopeKind {
    worktree
    | conversation
}

enum LossCategory {
    staged_tracked_paths
    | unstaged_tracked_paths
    | untracked_non_ignored_paths
    | initialized_submodule_state
    | detached_unreachable_commits
}

enum RetiredResourceKind {
    worktree
    | bash_process_group
    | tmux_server
    | pty_session
    | browser_session
    | equivalent_live_resource
}

enum RetirementFailureReason {
    removal_failed
    | still_shared_by_live_owner
    | residual_process_alive
    | identity_not_proven
    | manual_repair_required
}

enum AmbientWriterDetector {
    macos_proc_pidinfo
    | linux_procfs
}

enum AmbientPathMatchKind {
    descriptor
    | mapping
    | current_working_directory
    | process_root
    | executable_text
}

enum DescriptorAccessMode {
    read_only
    | write_only
    | read_write
    | writable_shared_mapping
}

enum AmbientReferenceClassification {
    no_write_authority
    | positive_writer
    | detector_indeterminate
}

enum PrDisplayState {
    open
    | draft
    | merged
    | closed
}

enum PrCheckState {
    passing
    | pending
    | failing
    | unknown
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    ambient_writer_max_observations: Integer = 3
    ambient_writer_observation_spacing: Duration = 100.milliseconds
    ambient_writer_required_consecutive_clean_observations: Integer = 2
}

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity AttachedWorkScope {
    product_conversation: bedrock/ProductConversation
    scope: WorkScope
    owns_git_worktree: Boolean
}

external entity CloseRetirementAuthority {
    product_conversation: bedrock/ProductConversation
    scope: WorkScope
}

external entity RetirementAttempt {
    attempt_id: String
    product_conversation: bedrock/ProductConversation
    scope: WorkScope
    inspection: RetirementInspection?
}

external entity Worktree {
    product_conversation: bedrock/ProductConversation
    scope: WorkScope
    identity: WorktreeIdentity
}

external entity RetirementLossCategoryRow {
    attempt: RetirementAttempt
    inspection: RetirementInspection
    category: LossCategory
    item_identity: String
}

external entity RetiredResource {
    attempt: RetirementAttempt
    product_conversation: bedrock/ProductConversation
    scope: WorkScope
    kind: RetiredResourceKind
    resource_identity: String
}

external entity RetirementResidualResource {
    attempt: RetirementAttempt
    product_conversation: bedrock/ProductConversation
    scope: WorkScope
    residual: RetirementResidual
}

external entity RetirementAbsenceEvidence {
    attempt: RetirementAttempt
    product_conversation: bedrock/ProductConversation
    scope: WorkScope
    resource_kind: RetiredResourceKind
    resource_identity: String
}

external entity RestartRepairEvidenceAdoption {
    attempt: RetirementAttempt
    restart_repair_evidence: gitrep/RestartRepairEvidence
}

external entity AmbientWriterEvidenceRow {
    attempt: RetirementAttempt
    inspection: RetirementInspection
    resource_identity: String
    evidence: AmbientWriterEvidence
}

external entity RetainedCleanupEvidenceAdoption {
    attempt: RetirementAttempt
    source_inspection: RetirementInspection
    target_inspection: RetirementInspection
    resource_identity: String
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule ChatOnlyCloseSkipsWorktreeInspection {
    when: RetirementInspectionRequested(product_conversation, attempt_id)
    requires:
        not exists AttachedWorkScope{product_conversation: product_conversation, owns_git_worktree: true}
    ensures: RetirementInspectionCompletedWithoutConfirmation(
        product_conversation,
        attempt_id,
        inspection_generation: "no-worktree",
        inspection_fingerprint: "no-worktree"
    )

    @guidance
        -- Skip inspection only when NO attached scope owns a Git-backed worktree.
        -- The presence of other attached non-worktree scopes does not bypass
        -- inspection for a mixed-attachment aggregate that still owns a worktree.
}

rule RetirementInspectionRequestCreatesAttemptBoundEvidence {
    when: RetirementInspectionRequested(product_conversation, attempt_id)
    requires: exists AttachedWorkScope{product_conversation: product_conversation, owns_git_worktree: true}
    ensures:
        for scope_binding in attached_worktree_scopes(product_conversation):
            RetirementAttempt.created(
                attempt_id: attempt_id,
                product_conversation: product_conversation,
                scope: scope_binding.scope,
                inspection: RetirementInspection {
                    generation: current_retirement_inspection_generation(product_conversation, scope_binding.scope),
                    fingerprint: current_retirement_inspection_fingerprint(product_conversation, scope_binding.scope)
                }
            )
            and for category in current_retirement_loss_categories(product_conversation, scope_binding.scope):
                for item_identity in current_retirement_loss_item_identities(product_conversation, scope_binding.scope, category):
                    RetirementLossCategoryRow.created(
                        attempt: RetirementAttempt{
                            attempt_id: attempt_id,
                            product_conversation: product_conversation,
                            scope: scope_binding.scope,
                            inspection: RetirementInspection {
                                generation: current_retirement_inspection_generation(product_conversation, scope_binding.scope),
                                fingerprint: current_retirement_inspection_fingerprint(product_conversation, scope_binding.scope)
                            }
                        },
                        inspection: RetirementInspection {
                            generation: current_retirement_inspection_generation(product_conversation, scope_binding.scope),
                            fingerprint: current_retirement_inspection_fingerprint(product_conversation, scope_binding.scope)
                        },
                        category: category,
                        item_identity: item_identity
                    )

    @guidance
        -- Before selecting the with-loss or without-loss inspection outcome, Phoenix
        -- materializes one exact RetirementAttempt plus its exact RetirementInspection
        -- and categorized loss inventory for every attached Git-backed scope bound
        -- to this Close attempt_id. Each RetirementLossCategoryRow is one exact
        -- (scope, category, item_identity) row, so every at-risk path or detached commit
        -- becomes distinct evidence rather than collapsing multiple items into one
        -- category summary. Outcome selection then reads this attempt-bound evidence
        -- rather than recomputing from an untyped side channel.
}

rule CloseWithoutAttachedWorkScopeCompletesRetirementIdempotently {
    when: ResourceRetirementRequested(product_conversation, attempt_id)
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        awaiting_retirement_inspection,
        awaiting_loss_confirmation,
        retirement_requested,
        needs_repair
    }
    requires: not exists AttachedWorkScope{product_conversation: product_conversation}
    ensures: ResourceRetirementCompleted(product_conversation, attempt_id)

    @guidance
        -- A Close on a chat-only or otherwise no-scope aggregate has no owned
        -- retirement resources. Emit completion idempotently so Close can progress
        -- without inventing residual work or requiring a synthetic WorkScope.
}

rule GitBackedInspectionWithoutLossRequestsRetirement {
    when: RetirementInspectionRequested(product_conversation, attempt_id)
    requires: exists AttachedWorkScope{product_conversation: product_conversation, owns_git_worktree: true}
    requires:
        for scope_binding in attached_worktree_scopes(product_conversation):
            exists RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: scope_binding.scope, inspection: RetirementInspection}
    requires: not exists RetirementLossCategoryRow{attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: AttachedWorkScope.scope, inspection: RetirementInspection}, inspection: RetirementInspection, category: staged_tracked_paths}
    requires: not exists RetirementLossCategoryRow{attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: AttachedWorkScope.scope, inspection: RetirementInspection}, inspection: RetirementInspection, category: unstaged_tracked_paths}
    requires: not exists RetirementLossCategoryRow{attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: AttachedWorkScope.scope, inspection: RetirementInspection}, inspection: RetirementInspection, category: untracked_non_ignored_paths}
    requires: not exists RetirementLossCategoryRow{attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: AttachedWorkScope.scope, inspection: RetirementInspection}, inspection: RetirementInspection, category: initialized_submodule_state}
    requires: not exists RetirementLossCategoryRow{attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: AttachedWorkScope.scope, inspection: RetirementInspection}, inspection: RetirementInspection, category: detached_unreachable_commits}
    ensures: RetirementInspectionCompletedWithoutConfirmation(
        product_conversation,
        attempt_id,
        inspection_generation: aggregate_inspection_generation(attempt_bound_scope_inspections(product_conversation, attempt_id)),
        inspection_fingerprint: aggregate_inspection_fingerprint(attempt_bound_scope_inspections(product_conversation, attempt_id))
    )

    @guidance
        -- The inspection must classify exactly five independent loss categories:
        -- staged tracked paths; unstaged tracked/conflicted/unmerged paths;
        -- untracked non-ignored paths; dirty or untracked state inside
        -- initialized submodules; and detached commits unreachable from
        -- refs/heads/*, refs/remotes/*, refs/tags/*, or refs/stash.
        -- Ignored paths are excluded. LFS-tracked edits are ordinary tracked
        -- changes. Local branches, tags, remotes, and stash are durable refs.
        -- Reflog-only detached commits are at-risk detached commits.
}

rule GitBackedInspectionWithLossRequiresConfirmation {
    when: RetirementInspectionRequested(product_conversation, attempt_id)
    requires: exists AttachedWorkScope{product_conversation: product_conversation, owns_git_worktree: true}
    requires:
        for scope_binding in attached_worktree_scopes(product_conversation):
            exists RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: scope_binding.scope, inspection: RetirementInspection}
    requires:
        exists RetirementLossCategoryRow{attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: AttachedWorkScope.scope, inspection: RetirementInspection}, inspection: RetirementInspection, category: staged_tracked_paths}
        or exists RetirementLossCategoryRow{attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: AttachedWorkScope.scope, inspection: RetirementInspection}, inspection: RetirementInspection, category: unstaged_tracked_paths}
        or exists RetirementLossCategoryRow{attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: AttachedWorkScope.scope, inspection: RetirementInspection}, inspection: RetirementInspection, category: untracked_non_ignored_paths}
        or exists RetirementLossCategoryRow{attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: AttachedWorkScope.scope, inspection: RetirementInspection}, inspection: RetirementInspection, category: initialized_submodule_state}
        or exists RetirementLossCategoryRow{attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: AttachedWorkScope.scope, inspection: RetirementInspection}, inspection: RetirementInspection, category: detached_unreachable_commits}
    ensures: RetirementInspectionRequiresConfirmation(
        product_conversation,
        attempt_id,
        inspection_generation: aggregate_inspection_generation(attempt_bound_scope_inspections(product_conversation, attempt_id)),
        inspection_fingerprint: aggregate_inspection_fingerprint(attempt_bound_scope_inspections(product_conversation, attempt_id))
    )

    @guidance
        -- Each RetirementLossCategoryRow is one exact (category, item_identity) row
        -- in the inventory, bound both to one exact RetirementInspection and to the
        -- RetirementAttempt for the product conversation plus attached WorkScope being
        -- retired.
        -- Categories coexist independently. Paths and detached-commit identities
        -- are surfaced without synthesizing a branch, tag, stash, patch, or diff
        -- snapshot as a recovery artifact.
}

rule LossConfirmationRecomputesInspectionBeforeRetirement {
    when: UserConfirmsCloseAfterRetirementInspection(product_conversation, attempt_id, inspection_generation, inspection_fingerprint)
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = awaiting_loss_confirmation
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.inspection_generation = inspection_generation
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.inspection_fingerprint = inspection_fingerprint
    let fresh_scope_inspections = recompute_all_targeted_scope_inspections(product_conversation, attempt_id)
    let fresh_generation = aggregate_inspection_generation(fresh_scope_inspections)
    let fresh_fingerprint = aggregate_inspection_fingerprint(fresh_scope_inspections)
    requires: fresh_generation = inspection_generation
    requires: fresh_fingerprint = inspection_fingerprint
    ensures: RetirementInspectionRecomputed(product_conversation, attempt_id, fresh_generation, fresh_fingerprint)
    ensures: ResourceRetirementRequested(product_conversation, attempt_id)

    @guidance
        -- The only user-facing discard-confirmation control is bound to the exact
        -- active Close obligation plus its stored inspection generation/fingerprint.
        -- The click re-runs the authoritative retirement inspection for every targeted
        -- attached WorkScope and derives one fresh aggregate pair inside the same atomic decision boundary that decides whether Close may enter
        -- retirement_requested. Phoenix compares the freshly recomputed generation and
        -- fingerprint against the stored inspection evidence from the outstanding Close
        -- obligation before requesting destructive retirement, so an async watcher
        -- notification cannot race ahead or lag behind the decision.
}

rule LossConfirmationDetectsChangedInspection {
    when: UserConfirmsCloseAfterRetirementInspection(product_conversation, attempt_id, inspection_generation, inspection_fingerprint)
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = awaiting_loss_confirmation
    requires:
        bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.inspection_generation != inspection_generation
        or bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.inspection_fingerprint != inspection_fingerprint
        or aggregate_inspection_generation(recompute_all_targeted_scope_inspections(product_conversation, attempt_id)) != inspection_generation
        or aggregate_inspection_fingerprint(recompute_all_targeted_scope_inspections(product_conversation, attempt_id)) != inspection_fingerprint
    ensures: RetirementInspectionChanged(product_conversation, attempt_id)

    @guidance
        -- If the confirmation payload no longer matches either the active Close
        -- obligation's stored inspection evidence or the just-in-time recomputation,
        -- Close does not cross into retirement_requested. The typed mismatch event
        -- sends the flow back through inspection so the user sees the new loss set.
}

rule RetirementRequestedRetiresOwnedResources {
    when: ResourceRetirementRequested(product_conversation, attempt_id)
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        awaiting_retirement_inspection,
        awaiting_loss_confirmation,
        retirement_requested,
        needs_repair
    }
    requires: exists AttachedWorkScope{product_conversation: product_conversation}
    requires:
        for scope_binding in attached_owned_scopes(product_conversation):
            exists CloseRetirementAuthority{product_conversation: product_conversation, scope: scope_binding.scope}
            and not blocked_by_distinct_open_product_or_identity_conflict(product_conversation, scope_binding.scope)
            and all_owned_resources_retired(product_conversation, scope_binding.scope)
    ensures: ResourceRetirementCompleted(product_conversation, attempt_id)

    @guidance
        -- Retirement completion is the final aggregate gate only after per-resource
        -- retirement has already produced exact-attempt, exact-scope evidence for
        -- every owned resource of every attached owned scope, or exact-attempt
        -- absence evidence where applicable.
}

rule RetirementRequestedCreatesPerResourceEvidence {
    when: ResourceRetirementRequested(product_conversation, attempt_id)
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        awaiting_retirement_inspection,
        awaiting_loss_confirmation,
        retirement_requested,
        needs_repair
    }
    requires: exists AttachedWorkScope{product_conversation: product_conversation}
    ensures:
        for scope_binding in attached_owned_scopes_with_pending_resources(product_conversation):
            if exists CloseRetirementAuthority{product_conversation: product_conversation, scope: scope_binding.scope}
               and not blocked_by_distinct_open_product_or_identity_conflict(product_conversation, scope_binding.scope)
               and retirement_step_succeeds_for_pending_resource(product_conversation, scope_binding.scope):
                RetiredResource.created(
                    attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: scope_binding.scope},
                    product_conversation: product_conversation,
                    scope: scope_binding.scope,
                    kind: retired_resource_kind_for_pending_step(product_conversation, scope_binding.scope),
                    resource_identity: retired_resource_identity_for_pending_step(product_conversation, scope_binding.scope)
                )
                and ResourceRetirementProgressRecorded(product_conversation, attempt_id, scope_binding.scope)

    @guidance
        -- Resource retirement is stepwise and idempotent. Each successful step creates
        -- typed RetiredResource evidence for the exact RetirementAttempt before the
        -- all-owned-resources completion gate can fire.
}

rule DistinctOpenAggregateOrIdentityConflictPreventsDestructiveRetirement {
    when: ResourceRetirementRequested(product_conversation, attempt_id)
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        awaiting_retirement_inspection,
        awaiting_loss_confirmation,
        retirement_requested,
        needs_repair
    }
    requires: exists AttachedWorkScope{product_conversation: product_conversation}
    requires: exists CloseRetirementAuthority{product_conversation: product_conversation, scope: AttachedWorkScope.scope}
    requires: blocked_by_distinct_open_product_or_identity_conflict(product_conversation)
    ensures: ResourceRetirementFailed(product_conversation, attempt_id)

    @guidance
        -- Continuation rows and subordinate execution conversations inside the same
        -- ProductConversation do not block retirement of that aggregate's attached
        -- WorkScope. Destructive teardown stops only when Phoenix sees a genuinely
        -- distinct open ProductConversation sharing the scope, or cannot resolve
        -- whether such a distinct aggregate exists because identity evidence conflicts.
}

rule AmbiguousPrivateDirectoryIdentityPreservesSafeLeftover {
    when: ResourceRetirementRequested(product_conversation, attempt_id)
    requires: exists CloseRetirementAuthority{product_conversation: product_conversation, scope: AttachedWorkScope.scope}
    requires: phoenix_private_retirement_directory_identity_is_ambiguous(product_conversation, attempt_id)
    ensures: safe_retirement_leftover_is_preserved(product_conversation, attempt_id)
    ensures: ResourceRetirementFailed(product_conversation, attempt_id)

    @guidance
        -- Normal Close authority comes from the sealed WorkScope gate plus a random,
        -- Phoenix-owned owner-only directory. Final removal validates both the opened
        -- directory and object identities. Post-crash or external ambiguity preserves
        -- a safe leftover for repair. Concurrent malicious mutation inside that private
        -- namespace and mutation outside Phoenix ownership are unsupported.
}

rule RetirementStepSuccessRecordsTypedEvidence {
    when: ResourceRetirementRequested(product_conversation, attempt_id)
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        awaiting_retirement_inspection,
        awaiting_loss_confirmation,
        retirement_requested,
        needs_repair
    }
    let scope_binding = AttachedWorkScope{product_conversation: product_conversation}
    requires: exists AttachedWorkScope{product_conversation: product_conversation}
    requires: exists RetiredResource{
        attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: scope_binding.scope},
        product_conversation: product_conversation,
        scope: scope_binding.scope,
        kind: retired_resource_kind_for_completed_step(product_conversation, scope_binding.scope),
        resource_identity: retired_resource_identity_for_completed_step(product_conversation, scope_binding.scope)
    }
    ensures: ResourceRetirementProgressRecorded(product_conversation, attempt_id)

    @guidance
        -- Progress reporting consumes already-created exact-attempt RetiredResource
        -- evidence for the bound attached scope; it does not stand in for creating
        -- that evidence.
}

rule RetirementAlreadyRetiredIsIdempotentNoOp {
    when: ResourceRetirementRequested(product_conversation, attempt_id)
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        awaiting_retirement_inspection,
        awaiting_loss_confirmation,
        retirement_requested,
        needs_repair
    }
    let scope_binding = AttachedWorkScope{product_conversation: product_conversation}
    requires: exists AttachedWorkScope{product_conversation: product_conversation}
    requires: exists RetiredResource{
        attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: scope_binding.scope},
        product_conversation: product_conversation,
        scope: scope_binding.scope,
        kind: retired_resource_kind_for_retried_step(product_conversation, scope_binding.scope),
        resource_identity: retired_resource_identity_for_retried_step(product_conversation, scope_binding.scope)
    }
    requires: exact_attempt_retries_same_resource(product_conversation, scope_binding.scope, retired_resource_identity_for_retried_step(product_conversation, scope_binding.scope))
    ensures: ResourceRetirementProgressRecorded(product_conversation, attempt_id)

    @guidance
        -- A retry that encounters the same exact attempt/resource already retired is
        -- a no-op adoption of prior evidence, not a second completion and not a failure.
}

rule RetirementProgressTriggersNextExactAttemptStep {
    when: ResourceRetirementProgressRecorded(product_conversation, attempt_id)
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        retirement_requested,
        needs_repair
    }
    requires: exists AttachedWorkScope{product_conversation: product_conversation}
    requires: exists CloseRetirementAuthority{product_conversation: product_conversation, scope: AttachedWorkScope.scope}
    requires: owned_resource_pending_retirement(product_conversation, AttachedWorkScope.scope)
    ensures: ResourceRetirementRequested(product_conversation, attempt_id)

    @guidance
        -- Every exact-attempt progress record immediately drives the next retirement
        -- pass for that same attempt while owned resources remain.
}

rule RetirementProgressReevaluatesCompletionForExactAttempt {
    when: ResourceRetirementProgressRecorded(product_conversation, attempt_id)
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        retirement_requested,
        needs_repair
    }
    requires: exists AttachedWorkScope{product_conversation: product_conversation}
    requires: exists CloseRetirementAuthority{product_conversation: product_conversation, scope: AttachedWorkScope.scope}
    requires: all_owned_resources_retired(product_conversation)
    ensures: ResourceRetirementRequested(product_conversation, attempt_id)

    @guidance
        -- Progress also reissues the exact attempt request when the last owned
        -- resource retires so the aggregate completion gate can fire from the same
        -- attempt-bound path.
}

rule ResourceRetirementFailureProducesResidualRepairState {
    when: ResourceRetirementRequested(product_conversation, attempt_id)
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        awaiting_retirement_inspection,
        awaiting_loss_confirmation,
        retirement_requested,
        needs_repair
    }
    let scope_binding = failing_retirement_scope(product_conversation, attempt_id)
    let resource_identity = residual_resource_identity_for_attempt(product_conversation, scope_binding.scope)
    ensures: RetirementResidualResource.created(
        attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: scope_binding.scope},
        product_conversation: product_conversation,
        scope: scope_binding.scope,
        residual: RetirementResidual{
            resource_kind: residual_resource_kind_for_attempt(product_conversation, scope_binding.scope),
            resource_identity: resource_identity,
            reason: residual_reason_for_attempt(product_conversation, scope_binding.scope),
            detail: residual_repair_detail_for_attempt(product_conversation, scope_binding.scope)
        }
    )
    ensures: ResourceRetirementFailed(product_conversation, attempt_id)

    @guidance
        -- Failure is typed and residual: report the exact remaining resource and
        -- repair information rather than silently succeeding. Residual rows are bound
        -- to the same exact RetirementAttempt as any earlier RetiredResource evidence,
        -- so partial completion remains visible across retries.
}

rule RestartRetirementLeavesProcessEpochResourcesUntouched {
    when: ResourceRetirementRequested(product_conversation, attempt_id)
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        retirement_requested,
        needs_repair
    }
    requires: process_epoch_resource_has_no_live_retirement_permit(product_conversation, attempt_id)
    ensures: ResourceRetirementProgressRecorded(product_conversation, attempt_id)

    @guidance
        -- Bash, PTY, browser, and equivalent ordinary execution resources are owned
        -- by the live Phoenix process epoch. A restarted runtime neither discovers
        -- nor signals a former epoch's resource.
}

rule RestartRetirementRequiresExactTmuxIdentity {
    when: ResourceRetirementRequested(product_conversation, attempt_id)
    requires: pending_tmux_identity_is_ambiguous(product_conversation, attempt_id)
    ensures: ResourceRetirementFailed(product_conversation, attempt_id)

    @guidance
        -- Tmux is the intentionally persistent runtime resource. Its sealed socket
        -- path and Phoenix server token must jointly identify the live server; a
        -- socket path alone is never destructive authority.
}

rule ReadOnlyAmbientReferenceNeverAuthorizesWriter {
    when: AmbientPathReferenceObserved(product_conversation, attempt_id, scope, detector, process_id, process_incarnation, executable, matched_path, match_kind, access_mode)
    requires: access_mode = read_only
    ensures: AmbientReferenceClassified(product_conversation, attempt_id, scope, classification: no_write_authority)

    @guidance
        -- A pathname relationship is not write authority. Process root,
        -- executable text, mappings, and read-only non-directory descriptors remain
        -- non-authorizing observations even when their path lies below quarantine.
}

rule NamespaceAmbientReferenceAuthorizesWriter {
    when: AmbientPathReferenceObserved(product_conversation, attempt_id, scope, detector, process_id, process_incarnation, executable, matched_path, match_kind, access_mode)
    let attempt = RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: scope}
    requires: access_mode = namespace_write
    requires: match_kind = namespace_directory
    requires: complete_ambient_writer_identity(detector, process_id, process_incarnation, executable, matched_path, match_kind, access_mode)
    ensures: AmbientWriterEvidenceRow.created(
        attempt: attempt,
        inspection: attempt.inspection,
        resource_identity: ambient_worktree_identity(product_conversation, scope),
        evidence: AmbientWriterEvidence {
            detector: detector,
            process_id: process_id,
            process_incarnation: process_incarnation,
            executable: executable,
            matched_path: matched_path,
            match_kind: match_kind,
            access_mode: access_mode
        }
    )
    ensures: AmbientReferenceClassified(product_conversation, attempt_id, scope, classification: positive_writer)

    @guidance
        -- A retained current working directory or read-only directory descriptor
        -- authorizes namespace mutation through relative path operations.
}

rule WritableAmbientDescriptorRecordsAuditableEvidence {
    when: AmbientPathReferenceObserved(product_conversation, attempt_id, scope, detector, process_id, process_incarnation, executable, matched_path, match_kind, access_mode)
    let attempt = RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: scope}
    requires: access_mode in { write_only, read_write, writable_shared_mapping }
    requires: complete_ambient_writer_identity(detector, process_id, process_incarnation, executable, matched_path, match_kind, access_mode)
    ensures: AmbientWriterEvidenceRow.created(
        attempt: attempt,
        inspection: attempt.inspection,
        resource_identity: ambient_worktree_identity(product_conversation, scope),
        evidence: AmbientWriterEvidence {
            detector: detector,
            process_id: process_id,
            process_incarnation: process_incarnation,
            executable: executable,
            matched_path: matched_path,
            match_kind: match_kind,
            access_mode: access_mode
        }
    )
    ensures: AmbientReferenceClassified(product_conversation, attempt_id, scope, classification: positive_writer)
}

rule IncompleteAmbientWriterIdentityIsIndeterminate {
    when: AmbientPathReferenceObserved(product_conversation, attempt_id, scope, detector, process_id, process_incarnation, executable, matched_path, match_kind, access_mode)
    requires: access_mode in { write_only, read_write, writable_shared_mapping, namespace_write }
    requires: not complete_ambient_writer_identity(detector, process_id, process_incarnation, executable, matched_path, match_kind, access_mode)
    ensures: AmbientReferenceClassified(product_conversation, attempt_id, scope, classification: detector_indeterminate)
}

rule ConsecutiveCleanAmbientObservationsPermitRemoval {
    when: OwnedRetirementResourcesStopped(product_conversation, attempt_id, scope)
    requires: authoritative_ambient_observation_count(product_conversation, attempt_id, scope) <= config.ambient_writer_max_observations
    requires: consecutive_clean_ambient_observation_count(product_conversation, attempt_id, scope) = config.ambient_writer_required_consecutive_clean_observations
    ensures: WorktreeFinalRemovalPermitted(product_conversation, attempt_id, scope)

    @guidance
        -- Observations use a monotonic schedule separated by
        -- config.ambient_writer_observation_spacing. A writable process incarnation
        -- may disappear, but retirement proceeds only after the required consecutive
        -- authoritative no-writer observations. Observation count, spacing, and the
        -- clock are injectable so tests advance deterministically without sleeping.
}

rule StableOrUnresolvedAmbientWriterPreservesQuarantine {
    when: AmbientWriterObservationBudgetCompleted(product_conversation, attempt_id, scope)
    requires:
        stable_writable_process_incarnation_observed(product_conversation, attempt_id, scope)
        or final_ambient_observation_reports_writer(product_conversation, attempt_id, scope)
        or consecutive_clean_ambient_observation_count(product_conversation, attempt_id, scope) < config.ambient_writer_required_consecutive_clean_observations
        or ambient_detector_became_indeterminate(product_conversation, attempt_id, scope)
    ensures: quarantined_worktree_preserved(product_conversation, attempt_id, scope)
    ensures: ResourceRetirementFailed(product_conversation, attempt_id)
}

rule ExactAttemptRetryAtomicallyAdoptsRetainedCleanupEvidence {
    when: ResourceRetirementRequested(product_conversation, attempt_id)
    let attempt = RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: pending_worktree_retirement_scope(product_conversation, attempt_id).scope}
    let source_inspection = uniquely_newest_compatible_prior_cleanup_inspection(product_conversation, attempt_id, attempt.scope)
    let target_inspection = attempt.inspection
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase = needs_repair
    requires: exists source_inspection
    requires: source_inspection != target_inspection
    requires: retained_dispatch_and_cleanup_identity_matches(attempt, source_inspection, target_inspection)
    ensures: RetainedCleanupEvidenceAdoption.created(
        attempt: attempt,
        source_inspection: source_inspection,
        target_inspection: target_inspection,
        resource_identity: ambient_worktree_identity(product_conversation, attempt.scope)
    )
    ensures: RetainedCleanupDispatchAndPlanCommitted(product_conversation, attempt_id, attempt.scope, target_inspection)

    @guidance
        -- One transaction validates exact attempt, scope, worktree identity and
        -- fingerprint, typed locator, administrative-directory identity, sealed target
        -- inventory, and expected target resource. It inserts or idempotently adopts
        -- the target-generation dispatch parent before its cleanup-plan child. Any
        -- conflict rolls back both; source-generation rows remain immutable. When
        -- multiple compatible prior generations exist, captured-at chronology and
        -- insertion order select the uniquely newest persisted generation.
}

rule RetainedCleanupAdoptionConflictNamesInvariant {
    when: RetainedCleanupEvidenceAdoptionRejected(product_conversation, attempt_id, scope, invariant, relation)
    ensures: TypedCloseEvidenceInvariantFailure(product_conversation, attempt_id, scope, invariant, relation)
    ensures: ResourceRetirementFailed(product_conversation, attempt_id)

    @guidance
        -- Repair output names the violated evidence invariant and persistence relation;
        -- storage-engine error numbers are diagnostic internals, not user guidance.
}

rule ExactAttemptAdoptsRestartRepairAbsenceEvidence {
    when: ResourceRetirementRequested(product_conversation, attempt_id)
    let scope_binding = pending_worktree_retirement_scope(product_conversation, attempt_id)
    let repair_evidence = exact_restart_repair_evidence(product_conversation, attempt_id, scope_binding.scope)
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        awaiting_retirement_inspection,
        awaiting_loss_confirmation,
        retirement_requested,
        needs_repair
    }
    requires: exists scope_binding
    requires: exists CloseRetirementAuthority{product_conversation: product_conversation, scope: scope_binding.scope}
    requires: worktree_already_absent(product_conversation, scope_binding.scope)
    requires: exists repair_evidence
    requires: repair_evidence.observation_kind = missing
    requires: complete_restart_repair_identity_available(repair_evidence, product_conversation, scope_binding.scope)
    requires: same_repository_and_worktree_identity(repair_evidence, product_conversation, attempt_id, scope_binding.scope)
    requires: no_replacement_worktree_appeared_since_restart_observation(repair_evidence, scope_binding.scope)
    requires: exact_active_retirement_attempt(product_conversation, attempt_id, scope_binding.scope)
    requires: not exists RestartRepairEvidenceAdoption{attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: scope_binding.scope}}
    ensures: RestartRepairEvidenceAdoption.created(
        attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: scope_binding.scope},
        restart_repair_evidence: repair_evidence
    )
    ensures: RetirementAbsenceEvidence.created(
        attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: scope_binding.scope},
        product_conversation: product_conversation,
        scope: scope_binding.scope,
        resource_kind: worktree,
        resource_identity: repair_evidence.worktree.id
    )
    ensures: ResourceRetirementProgressRecorded(product_conversation, attempt_id)

    @guidance
        -- Adoption is fail-closed and exact-attempt-bound. Phoenix may adopt
        -- retained restart repair evidence only when the active Close attempt,
        -- ProductConversation, WorkScope, hidden repository identity, and
        -- worktree identity/fingerprint all match; no replacement worktree has
        -- appeared; and the source observation remains immutable. Adoption creates
        -- new exact-attempt absence evidence plus a typed adoption relation without
        -- rewriting the restart observation.
}

rule RestartRepairConflictRoutesTypedRepair {
    when: ResourceRetirementRequested(product_conversation, attempt_id)
    let scope_binding = pending_worktree_retirement_scope(product_conversation, attempt_id)
    let repair_evidence = latest_restart_repair_evidence(product_conversation, scope_binding.scope)
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        awaiting_retirement_inspection,
        awaiting_loss_confirmation,
        retirement_requested,
        needs_repair
    }
    requires: exists scope_binding
    requires: exists CloseRetirementAuthority{product_conversation: product_conversation, scope: scope_binding.scope}
    requires: worktree_already_absent(product_conversation, scope_binding.scope)
    requires: exists repair_evidence
    requires:
        repair_evidence.observation_kind = inaccessible
        or not complete_restart_repair_identity_available(repair_evidence, product_conversation, scope_binding.scope)
        or not same_repository_and_worktree_identity(repair_evidence, product_conversation, attempt_id, scope_binding.scope)
        or replacement_worktree_appeared_since_restart_observation(repair_evidence, scope_binding.scope)
        or not exact_active_retirement_attempt(product_conversation, attempt_id, scope_binding.scope)
    ensures: ResourceRetirementFailed(product_conversation, attempt_id)

    @guidance
        -- A later Close attempt may bind fresh retained restart evidence for the
        -- same repository, but only from a new exact attempt. When identity is
        -- inaccessible, identity is incomplete, a replacement appears, or the active
        -- attempt does not match, Phoenix routes to typed repair instead of guessing continuity from the
        -- path or silently adopting a stale absence observation.
}

rule AlreadyAbsentWorktreeNeedsIdentityEvidence {
    when: ResourceRetirementRequested(product_conversation, attempt_id)
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        awaiting_retirement_inspection,
        awaiting_loss_confirmation,
        retirement_requested,
        needs_repair
    }
    let scope_binding = pending_worktree_retirement_scope(product_conversation, attempt_id)
    requires: exists scope_binding
    requires: exists CloseRetirementAuthority{product_conversation: product_conversation, scope: scope_binding.scope}
    requires: worktree_already_absent(product_conversation, scope_binding.scope)
    requires: not exists RetirementAbsenceEvidence{attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: scope_binding.scope}, product_conversation: product_conversation, scope: scope_binding.scope, resource_kind: worktree, resource_identity: absent_worktree_identity(product_conversation, scope_binding.scope)}
    requires: not exists RestartRepairEvidenceAdoption{attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: scope_binding.scope}}
    ensures: ResourceRetirementFailed(product_conversation, attempt_id)

    @guidance
        -- An already-absent worktree is accepted only when retained identity and
        -- evidence show this retirement is adopting that exact absence rather than
        -- guessing over a missing path. Without exact-attempt absence evidence or
        -- an exact-attempt adoption of immutable restart repair evidence, report
        -- typed residual state instead of silently treating absence as success.
        -- Duplicate or conflicting highest-generation evidence for this exact
        -- WorkScope also follows this typed-repair path.
}

rule AlreadyAbsentWorktreeWithExactAttemptEvidenceIsAccepted {
    when: ResourceRetirementRequested(product_conversation, attempt_id)
    requires: bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}.phase in {
        awaiting_retirement_inspection,
        awaiting_loss_confirmation,
        retirement_requested,
        needs_repair
    }
    let scope_binding = pending_worktree_retirement_scope(product_conversation, attempt_id)
    requires: exists scope_binding
    requires: exists CloseRetirementAuthority{product_conversation: product_conversation, scope: scope_binding.scope}
    requires: worktree_already_absent(product_conversation, scope_binding.scope)
    requires: exists RetirementAbsenceEvidence{attempt: RetirementAttempt{attempt_id: attempt_id, product_conversation: product_conversation, scope: scope_binding.scope}, product_conversation: product_conversation, scope: scope_binding.scope, resource_kind: worktree, resource_identity: absent_worktree_identity(product_conversation, scope_binding.scope)}
    ensures: ResourceRetirementProgressRecorded(product_conversation, attempt_id)

    @guidance
        -- Exact-attempt absence evidence lets retirement accept an already-absent
        -- worktree idempotently after the active attempt has either created that
        -- absence evidence directly or adopted immutable restart repair evidence
        -- for that same exact attempt.
}


rule LegacyFk787PartialRetryCanResumeFromPriorCleanupAuthority {
    when: ResourceRetirementRequested(product_conversation, attempt_id)
    let obligation = bedrock/CloseObligation{product_conversation: product_conversation, attempt_id: attempt_id}
    requires: obligation.phase = awaiting_retirement_inspection
    requires: exists obligation.active_retirement_snapshot
    requires: active_generation_is_legacy_fk787_partial_retry(product_conversation, attempt_id)
    requires: every_captured_worktree_has_prior_same_attempt_dispatch_and_cleanup_plan(product_conversation, attempt_id)
    ensures: ResourceRetirementProgressRecorded(product_conversation, attempt_id)

    @guidance
        -- Preserve historical evidence and resume through the ordinary retirement
        -- executor. It freshly validates each retained worktree identity and
        -- adopts exact prior cleanup authority before
        -- destructive cleanup. Every other shape remains in repair/reinspection.
}

rule PrStatusObservedAsAdvisoryCloseGuidance {
    when: PrStatusQueried(product_conversation)
    ensures: PrStatusResultDelivered(product_conversation, found: Boolean, display_state: PrDisplayState?, check_state: PrCheckState?, number: Integer?, unavailable_reason: String?)

    @guidance
        -- PR observation may guide the user toward Close, especially when a PR is
        -- merged, but it never blocks Close, retirement inspection, or retirement,
        -- and never closes, mutates, or retargets a PR.
}

------------------------------------------------------------
-- Helpers (pure predicates referenced by restart-repair rules)
------------------------------------------------------------
--
-- Allium has no formal helper-function declaration; this block defines the
-- complete semantics of each bare helper used above.
--
--   attempt_bound_scope_inspections(
--       product_conversation: bedrock/ProductConversation,
--       attempt_id: String
--   ) -> List<(WorkScope, RetirementInspection)>
--       Returns exactly the persisted inspections bound to the attempt that
--       produced its RetirementLossCategoryRow set, ordered by the opaque
--       WorkScope identity's canonical bytes. Inspection values and category rows
--       are one atomic evidence snapshot; this helper never observes live state.
--
--   recompute_all_targeted_scope_inspections(
--       product_conversation: bedrock/ProductConversation,
--       attempt_id: String
--   ) -> List<(WorkScope, RetirementInspection)>
--       Recomputes one exact RetirementInspection for every distinct attached
--       worktree-owning scope captured by attempt_id, and no other scope. The list
--       is ordered by the opaque WorkScope identity's canonical bytes. A missing,
--       duplicate, ambiguous, or uninspectable captured target fails closed rather
--       than returning a partial list.
--
--   aggregate_inspection_generation(
--       inspections: List<(WorkScope, RetirementInspection)>
--   ) -> String
--       A deterministic digest of the canonical length-prefixed sequence of each
--       ordered scope identity and inspection generation. Any target-set, order, or
--       per-scope generation change produces a different aggregate generation.
--
--   aggregate_inspection_fingerprint(
--       inspections: List<(WorkScope, RetirementInspection)>
--   ) -> String
--       A deterministic digest of the canonical length-prefixed sequence of each
--       ordered scope identity and inspection fingerprint. Any target-set, order, or
--       per-scope fingerprint change produces a different aggregate fingerprint.
--
--   active_generation_is_legacy_fk787_partial_retry(
--       product_conversation: bedrock/ProductConversation,
--       attempt_id: String
--   ) -> Boolean
--       True iff every captured WorkScope has an active retry inspection and sealed
--       inventory, the active generation has no dispatch or cleanup plan, and each exact
--       captured worktree has an active manual-repair residual whose detail identifies
--       SQLite foreign-key code 787 from the cleanup-plan persistence defect.
--
--   every_captured_worktree_has_prior_same_attempt_dispatch_and_cleanup_plan(
--       product_conversation: bedrock/ProductConversation,
--       attempt_id: String
--   ) -> Boolean
--       True iff every exact captured worktree identity has a dispatch and cleanup
--       plan under a different snapshot generation of the same attempt. Another
--       attempt never supplies authority.
--
--   pending_worktree_retirement_scope(
--       product_conversation: bedrock/ProductConversation,
--       attempt_id: String
--   ) -> AttachedWorkScope?
--       The exact attached WorkScope selected for the current worktree-retirement
--       step of attempt_id. This is step-local: one ProductConversation may have
--       multiple attached scopes overall. Ambiguity returns absent so adoption
--       fails closed rather than selecting an arbitrary scope.
--
--   same_work_scope_identity(
--       scope_ref: gitrep/WorkScopeRef,
--       scope: WorkScope
--   ) -> Boolean
--       True iff scope_ref names the same opaque persisted WorkScope as scope.
--       ProductConversation attachment, repository identity, or path equality alone
--       never proves this cross-spec identity seam.
--
--   latest_restart_repair_evidence(
--       product_conversation: bedrock/ProductConversation,
--       scope: WorkScope
--   ) -> gitrep/RestartRepairEvidence?
--       The unique complete retained observation at the highest integer generation
--       for product_conversation whose WorkScopeRef satisfies
--       same_work_scope_identity(evidence.scope, scope). Evidence for another scope
--       is ignored. No row, a duplicate highest generation, conflicting identity,
--       incomplete row, or scope ambiguity returns absent so adoption fails closed.
--
--   exact_restart_repair_evidence(
--       product_conversation: bedrock/ProductConversation,
--       attempt_id: String,
--       scope: WorkScope
--   ) -> gitrep/RestartRepairEvidence?
--       The latest_restart_repair_evidence row for product_conversation and scope
--       when attempt_id is the sole active Close attempt for that exact scope and
--       that attempt has not already adopted a restart observation; otherwise
--       absent. A cancelled attempt never mutates or consumes the source row; a
--       later attempt creates its own adoption after rechecking every guard.
--
--   complete_restart_repair_identity_available(
--       evidence: gitrep/RestartRepairEvidence,
--       product_conversation: bedrock/ProductConversation,
--       scope: WorkScope
--   ) -> Boolean
--       True iff evidence names product_conversation and a WorkScopeRef satisfying
--       same_work_scope_identity(evidence.scope, scope), and has non-empty
--       repository identity, worktree id, retained path, worktree fingerprint,
--       observation generation, and observation time.
--
--   same_repository_and_worktree_identity(
--       evidence: gitrep/RestartRepairEvidence,
--       product_conversation: bedrock/ProductConversation,
--       attempt_id: String,
--       scope: WorkScope
--   ) -> Boolean
--       True iff the active Close authority names product_conversation and scope,
--       same_work_scope_identity(evidence.scope, scope) holds, scope's retained
--       repository attachment equals evidence.repository, and scope's worktree id
--       and fingerprint equal evidence.worktree.id and evidence.worktree.fingerprint.
--       Path equality alone is insufficient.
--
--   no_replacement_worktree_appeared_since_restart_observation(
--       evidence: gitrep/RestartRepairEvidence,
--       scope: WorkScope
--   ) -> Boolean
--       True iff no filesystem observation after evidence.observed_at proves a
--       present worktree for scope. A path reappearing without matching identity
--       evidence makes this false rather than proving continuity.
--
--   replacement_worktree_appeared_since_restart_observation(
--       evidence: gitrep/RestartRepairEvidence,
--       scope: WorkScope
--   ) -> Boolean
--       The logical negation of
--       no_replacement_worktree_appeared_since_restart_observation for the same
--       evidence and scope.
--
--   exact_active_retirement_attempt(
--       product_conversation: bedrock/ProductConversation,
--       attempt_id: String,
--       scope: WorkScope
--   ) -> Boolean
--       True iff attempt_id is the ProductConversation's sole non-completed Close
--       attempt and its RetirementAttempt is bound to that exact scope.
--
--   worktree_already_absent(
--       product_conversation: bedrock/ProductConversation,
--       scope: WorkScope
--   ) -> Boolean
--       True iff that exact scope's retained worktree is observed missing and no
--       later observation proves a present replacement. `inaccessible` is not
--       absence authority and remains typed repair state.
--
--   absent_worktree_identity(
--       product_conversation: bedrock/ProductConversation,
--       scope: WorkScope
--   ) -> String
--       The retained opaque worktree id for scope; never a path-derived value.
--
------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant CleanupAuthorityComesFromCommittedCloseOperation {
    for a in AttachedWorkScope:
        exists CloseRetirementAuthority{product_conversation: a.product_conversation, scope: a.scope}
        implies a.owns_git_worktree or a.scope.kind = conversation
}

invariant WorkScopeHasOneOrdinaryProductConversationOwner {
    for attachment in AttachedWorkScope:
        product_conversation_owner_for_scope(attachment.scope) = attachment.product_conversation
}

invariant NoAutomaticRecoveryArtifactFromRetirement {
    for a in AttachedWorkScope:
        exists CloseRetirementAuthority{product_conversation: a.product_conversation, scope: a.scope}
        implies not AutomaticRetirementSnapshotCreated(a.product_conversation)
}
