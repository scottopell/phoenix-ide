-- allium: 3
-- work-lifecycle.allium
--
-- Phoenix WorkScope Retirement: Behavioural Specification
--
-- Scope: Git-backed Close retirement inspection, exact loss classification,
--        WorkScope-owned resource retirement, and PR-state advisory guidance.
--
-- Includes:
--   - classification of exact worktree-loss categories for an attached
--     Git-backed WorkScope;
--   - generation/fingerprint-bound discard confirmation;
--   - stepwise idempotent retirement of owned worktree and WorkScope resources;
--   - PR-state guidance that may encourage Close but never blocks it.
--
-- Excludes:
--   - root lifecycle legality, close-obligation orchestration, and ProductConversation
--     Open/History transitions (bedrock owns those authorities);
--   - PR identity selection, feedback freshness, and remediation context
--     (pr-association owns those authorities);
--   - UI layout and copy.
--
-- Requirement traceability: REQ-WL-001 through REQ-WL-003

use "../bedrock/bedrock.allium" as bedrock

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value WorkScope {
    kind: WorkScopeKind
    inner: String
}

value WorktreeIdentity {
    path: String
}

value RetirementInspection {
    generation: String
    fingerprint: String
}

value RetirementResidual {
    resource_kind: RetiredResourceKind
    reason: RetirementFailureReason
    detail: String?
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum WorkScopeKind {
    worktree
    | conversation
}

enum LossCategory {
    staged_tracked_paths
    | unstaged_tracked_paths
    | untracked_non_ignored_paths
    | initialized_submodule_state
    | detached_unreachable_commits
}

enum RetiredResourceKind {
    worktree
    | bash_process_group
    | tmux_server
    | pty_session
    | browser_session
    | equivalent_live_resource
}

enum RetirementFailureReason {
    removal_failed
    | still_shared_by_live_owner
    | residual_process_alive
    | identity_not_proven
    | manual_repair_required
}

enum PrDisplayState {
    open
    | draft
    | merged
    | closed
}

enum PrCheckState {
    passing
    | pending
    | failing
    | unknown
}

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity AttachedWorkScope {
    product_conversation: bedrock/ProductConversation
    scope: WorkScope
    owns_git_worktree: Boolean
    has_cleanup_authority: Boolean
}

external entity Worktree {
    product_conversation: bedrock/ProductConversation
    scope: WorkScope
    identity: WorktreeIdentity
}

external entity RetirementLossItem {
    inspection: RetirementInspection
    category: LossCategory
    item_identity: String
}

external entity RetiredResource {
    product_conversation: bedrock/ProductConversation
    scope: WorkScope
    kind: RetiredResourceKind
}

external entity RetirementResidualResource {
    product_conversation: bedrock/ProductConversation
    scope: WorkScope
    residual: RetirementResidual
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule ChatOnlyCloseSkipsWorktreeInspection {
    when: RetirementInspectionRequested(product_conversation)
    requires: exists AttachedWorkScope{product_conversation: product_conversation, owns_git_worktree: false}
    ensures: RetirementInspectionCompletedWithoutConfirmation(
        product_conversation,
        inspection_generation: "no-worktree",
        inspection_fingerprint: "no-worktree"
    )

    @guidance
        -- Chat-only and other non-Git-backed scopes own no disposable worktree,
        -- so there is no worktree-loss inventory and no discard confirmation.
}

rule GitBackedInspectionWithoutLossRequestsRetirement {
    when: RetirementInspectionRequested(product_conversation)
    requires: exists AttachedWorkScope{product_conversation: product_conversation, owns_git_worktree: true, has_cleanup_authority: true}
    requires: not exists RetirementLossItem{inspection: RetirementInspection, category: staged_tracked_paths}
    requires: not exists RetirementLossItem{inspection: RetirementInspection, category: unstaged_tracked_paths}
    requires: not exists RetirementLossItem{inspection: RetirementInspection, category: untracked_non_ignored_paths}
    requires: not exists RetirementLossItem{inspection: RetirementInspection, category: initialized_submodule_state}
    requires: not exists RetirementLossItem{inspection: RetirementInspection, category: detached_unreachable_commits}
    ensures: RetirementInspectionCompletedWithoutConfirmation(
        product_conversation,
        inspection_generation: RetirementInspection.generation,
        inspection_fingerprint: RetirementInspection.fingerprint
    )

    @guidance
        -- The inspection must classify exactly five independent loss categories:
        -- staged tracked paths; unstaged tracked/conflicted/unmerged paths;
        -- untracked non-ignored paths; dirty or untracked state inside
        -- initialized submodules; and detached commits unreachable from
        -- refs/heads/*, refs/remotes/*, refs/tags/*, or refs/stash.
        -- Ignored paths are excluded. LFS-tracked edits are ordinary tracked
        -- changes. Local branches, tags, remotes, and stash are durable refs.
        -- Reflog-only detached commits are at-risk detached commits.
}

rule GitBackedInspectionWithLossRequiresConfirmation {
    when: RetirementInspectionRequested(product_conversation)
    requires: exists AttachedWorkScope{product_conversation: product_conversation, owns_git_worktree: true, has_cleanup_authority: true}
    requires:
        exists RetirementLossItem{inspection: RetirementInspection, category: staged_tracked_paths}
        or exists RetirementLossItem{inspection: RetirementInspection, category: unstaged_tracked_paths}
        or exists RetirementLossItem{inspection: RetirementInspection, category: untracked_non_ignored_paths}
        or exists RetirementLossItem{inspection: RetirementInspection, category: initialized_submodule_state}
        or exists RetirementLossItem{inspection: RetirementInspection, category: detached_unreachable_commits}
    ensures: RetirementInspectionRequiresConfirmation(
        product_conversation,
        inspection_generation: RetirementInspection.generation,
        inspection_fingerprint: RetirementInspection.fingerprint
    )

    @guidance
        -- Each RetirementLossItem is one categorized row in the exact inventory.
        -- Categories coexist independently. Paths and detached-commit identities
        -- are surfaced without synthesizing a branch, tag, stash, patch, or diff
        -- snapshot as a recovery artifact.
}

rule ChangedWorkspaceInvalidatesOutstandingConfirmation {
    when: WorkspaceFingerprintChanged(product_conversation)
    requires: bedrock/CloseObligation{product_conversation: product_conversation}.phase = awaiting_loss_confirmation
    ensures: RetirementInspectionChanged(product_conversation)
}

rule RetirementRequestedRetiresOwnedResources {
    when: ResourceRetirementRequested(product_conversation)
    requires: exists AttachedWorkScope{product_conversation: product_conversation, has_cleanup_authority: true}
    requires: not live_conversation_shares_scope(product_conversation)
    requires: all_owned_resources_retired(product_conversation)
    ensures: ResourceRetirementCompleted(product_conversation)

    @guidance
        -- Retirement is stepwise and idempotent. It retires the worktree and
        -- WorkScope-owned bash/process-group, tmux, PTY/terminal, browser, and
        -- equivalent live resources. Success is emitted only after every owned
        -- resource has been retired.
}

rule SharedContinuationPreventsDestructiveRetirement {
    when: ResourceRetirementRequested(product_conversation)
    requires: exists AttachedWorkScope{product_conversation: product_conversation, has_cleanup_authority: true}
    requires: live_conversation_shares_scope(product_conversation)
    ensures: ResourceRetirementFailed(product_conversation)

    @guidance
        -- Continuations share one live WorkScope. Retirement cannot remove the
        -- shared worktree while another non-History live conversation still
        -- resolves to that same scope.
}

rule ResourceRetirementFailureProducesResidualRepairState {
    when: ResourceRetirementRequested(product_conversation)
    requires: exists RetirementResidualResource{product_conversation: product_conversation}
    ensures: ResourceRetirementFailed(product_conversation)

    @guidance
        -- Failure is typed and residual: report the exact remaining resource and
        -- repair information rather than silently succeeding.
}

rule AlreadyAbsentWorktreeNeedsIdentityEvidence {
    when: ResourceRetirementRequested(product_conversation)
    requires: exists AttachedWorkScope{product_conversation: product_conversation, has_cleanup_authority: true}
    requires: worktree_already_absent(product_conversation)
    requires: not absence_identity_proven(product_conversation)
    ensures: ResourceRetirementFailed(product_conversation)

    @guidance
        -- An already-absent worktree is accepted only when retained identity and
        -- evidence show this retirement is adopting that exact absence rather than
        -- guessing over a missing path.
}

rule PrStatusObservedAsAdvisoryCloseGuidance {
    when: PrStatusQueried(product_conversation)
    ensures: PrStatusResultDelivered(product_conversation, found: Boolean, display_state: PrDisplayState?, check_state: PrCheckState?, number: Integer?, unavailable_reason: String?)

    @guidance
        -- PR observation may guide the user toward Close, especially when a PR is
        -- merged, but it never blocks Close, retirement inspection, or retirement,
        -- and never closes, mutates, or retargets a PR.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant SubAgentsDoNotOwnCleanupAuthority {
    for a in AttachedWorkScope:
        a.has_cleanup_authority implies a.owns_git_worktree or a.scope.kind = conversation
}

invariant NoAutomaticRecoveryArtifactFromRetirement {
    for a in AttachedWorkScope:
        a.has_cleanup_authority implies
            not AutomaticRetirementSnapshotCreated(a.product_conversation)
}
