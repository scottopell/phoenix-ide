-- allium: 3
-- Durable Conversation Creation: Behavioural Specification
--
-- Scope: request-bound durable acceptance, exclusive provisioning authority,
-- immutable starting-pin selection, hidden staging, durable objective delivery,
-- atomic user-visible publication, retry and
-- reconciliation, cancellation, and deletion cleanup.
--
-- Creation has no unresolved success outcome, no visible shell before publication,
-- no stale/local canonical fallback, and no creation-time file or skill expansion.
-- Excludes: Git command details, database representation, HTTP and UI layout.
--
-- Requirement traceability: REQ-CCR-001 through REQ-CCR-015.

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    claim_lease: Duration = 30_000.ms
    retry_delay_2: Duration = 2_000.ms
    retry_delay_3: Duration = 10_000.ms
    retry_delay_4: Duration = 30_000.ms
    max_attempts: Integer = 4
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum CreationStatus {
    accepted | claimed | retry_scheduled | cancelling | cancelled
    | deletion_pending | delivery_pending | delivery_failed | ready | failed | cleanup_ambiguous
}

enum CreationStage {
    validate_intent | resolve_repository | resolve_starting_pin
    | materialize_worktree | finalize_attachments
    | commit_metadata | bootstrap_initial_turn | finalize_publication
}

enum StartingPinSource { authoritative_origin_default | local_main_without_origin }

------------------------------------------------------------
-- Actors
------------------------------------------------------------

actor CreationUser {}
actor CreationWorker {}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity CreationJob {
    request_id: String
    conversation_id: String
    status: CreationStatus
    stage: CreationStage
    attempt: Integer
    generation: Integer
    creation_intent: String
    accepted_handle: String

    claim_owner: CreationWorker?
    claim_token: String?
    lease_until: Timestamp?
    stage_updated_at: Timestamp
    delivery_attempt: Integer
    delivery_retry_at: Timestamp? when status = delivery_pending
    next_attempt_at: Timestamp when status = retry_scheduled
    error_message: String when status in { failed, delivery_failed }

    transitions status {
        accepted -> claimed
        accepted -> cancelling
        accepted -> deletion_pending
        claimed -> claimed
        claimed -> retry_scheduled
        claimed -> delivery_pending
        claimed -> failed
        claimed -> cancelling
        claimed -> deletion_pending
        retry_scheduled -> claimed
        retry_scheduled -> failed
        retry_scheduled -> cancelling
        retry_scheduled -> deletion_pending
        delivery_pending -> delivery_pending
        delivery_pending -> delivery_failed
        delivery_pending -> ready
        delivery_pending -> cancelling
        delivery_failed -> delivery_pending
        cancelling -> cancelled
        cancelling -> deletion_pending
        cancelling -> cleanup_ambiguous
        cancelled -> deletion_pending
        failed -> deletion_pending
        deletion_pending -> cleanup_ambiguous
        terminal: ready, cleanup_ambiguous
    }

    invariant AttemptBudgetBounded {
        attempt >= 0 and attempt <= config.max_attempts
    }

    invariant ClaimedGenerationCurrent {
        status in { claimed, delivery_pending } implies generation > 0
    }

    invariant ClaimFieldsWhole {
        (claim_owner = null and claim_token = null and lease_until = null)
        or (claim_owner != null and claim_token != null and lease_until != null)
    }

    invariant ClaimRequiredForProvisioning {
        status = claimed implies claim_owner != null
    }

    invariant ClaimOnlyForActiveWork {
        claim_owner != null implies status in { claimed, delivery_pending }
    }

    invariant DeliveryAttemptBudgetBounded {
        delivery_attempt >= 1 and delivery_attempt <= config.max_attempts
    }
}

entity StagedAggregate {
    job: CreationJob

    invariant HiddenUntilReady {
        job.status != ready implies hidden_from_normal_surfaces(job.conversation_id)
    }
}

entity ObjectiveAcceptance {
    job: CreationJob
    fingerprint: String
}

entity StartingPin {
    job: CreationJob
    commit_id: String
    branch_name: String
    source: StartingPinSource
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule CreationAcceptedDurably {
    when: StructurallyValidCreationRequested(request_id, conversation_id, creation_intent, accepted_handle)
    requires: not CreationJob.exists(request_id: request_id)

    ensures: CreationJob.created(
        request_id: request_id,
        conversation_id: conversation_id,
        status: accepted,
        stage: validate_intent,
        attempt: 0,
        generation: 0,
        claim_owner: null,
        claim_token: null,
        lease_until: null,
        stage_updated_at: now(),
        delivery_attempt: 1,
        creation_intent: creation_intent,
        accepted_handle: accepted_handle
    )
    ensures: CreationAcceptedReplayHandle(request_id, accepted_handle)

    @guidance
        -- Persist the request-bound durable job identity, replay handle, and
        -- creation intent atomically before any filesystem, Git, runtime, or
        -- publication work begins.
}

rule DuplicateRequestReplaysAcceptance {
    when: StructurallyValidCreationRequested(request_id, conversation_id, creation_intent, accepted_handle)

    requires: CreationJob.exists(request_id: request_id)
    requires: CreationJob{request_id: request_id}.creation_intent = creation_intent

    ensures: CreationAcceptedReplayHandle(request_id, CreationJob{request_id: request_id}.accepted_handle)
}

rule MissingOriginalPublicationPreservesHistoricalAcceptance {
    when: PublishedCreationReconciled(job)

    requires: job.status in { delivery_pending, delivery_failed, ready }
    requires: not original_publication_live(job)

    ensures: HistoricalCreationAcceptanceReturned(job.request_id, job.conversation_id, job.creation_intent)
    ensures: NoLiveNavigationOrDeliveryRecovery(job.request_id)
    ensures: ExactTerminalEvidenceOrUnavailableReturned(job.request_id)
}

rule ReusedRequestIdWithDifferentIntentConflicts {
    when: StructurallyValidCreationRequested(request_id, conversation_id, creation_intent, accepted_handle)

    requires: CreationJob.exists(request_id: request_id)
    requires: CreationJob{request_id: request_id}.creation_intent != creation_intent

    ensures: CreationRequestConflict(request_id)
}

rule EligibleCreationClaimed {
    when: WorkerClaimsEligibleJob(worker, job, token, lease_until)

    requires: job.status = accepted
        or (job.status = retry_scheduled and job.next_attempt_at <= now())
        or (job.status = claimed and job.lease_until <= now())

    ensures: job.status = claimed
    ensures: job.claim_owner = worker
    ensures: job.claim_token = token
    ensures: job.lease_until = lease_until
    ensures: job.generation = job.generation + 1
}

rule ExpiredClaimReconciledBeforeResume {
    when: WorkerReplacesExpiredClaim(worker, job)

    requires: job.status = claimed
    requires: job.lease_until != null
    requires: job.lease_until <= now()

    ensures: ExternalStateInspectionRequested(worker, job, job.stage)

    @guidance
        -- Replacement observes external state before deciding whether to adopt,
        -- conflict, preserve ambiguity, clean, or resume the interrupted stage.
}

rule CurrentClaimAdvancesStage {
    when: ProvisioningStageSucceeded(job, worker, token, generation)

    requires: job.status = claimed
    requires: job.claim_owner = worker
    requires: job.claim_token = token
    requires: job.generation = generation
    requires: job.lease_until != null
    requires: job.lease_until > now()
    requires: job.stage in { validate_intent, resolve_repository, resolve_starting_pin, materialize_worktree, finalize_attachments }
    requires: job.stage_updated_at <= now()

    ensures: job.stage = next_creation_stage(job.stage)
    ensures: job.stage_updated_at = now()
}

rule OriginDefaultStartingPinSelected {
    when: StartingPinResolvedFromAuthoritativeOrigin(job, branch_name, commit_id)

    requires: job.status = claimed
    requires: job.stage = resolve_starting_pin
    requires: not StartingPin.exists(job: job)

    ensures: StartingPin.created(
        job: job,
        commit_id: commit_id,
        branch_name: branch_name,
        source: authoritative_origin_default
    )
}

rule LocalMainStartingPinSelectedWithoutOrigin {
    when: StartingPinResolvedFromLocalMain(job, commit_id)

    requires: job.status = claimed
    requires: job.stage = resolve_starting_pin
    requires: not repository_has_remote_named_origin(job)
    requires: not StartingPin.exists(job: job)

    ensures: StartingPin.created(
        job: job,
        commit_id: commit_id,
        branch_name: "main",
        source: local_main_without_origin
    )
}

rule StartingPinResolutionFailureIsRetryableAndNeverFallsBack {
    when: StartingPinResolutionFailed(job, reason)

    requires: job.status = claimed
    requires: job.stage = resolve_starting_pin
    requires: not StartingPin.exists(job: job)

    ensures: job.status = retry_scheduled
    ensures: job.claim_owner = null
    ensures: job.claim_token = null
    ensures: job.lease_until = null
    ensures: job.next_attempt_at = retry_deadline(job.attempt + 1)
    ensures: CreationSchedulerWakeRequested(job.next_attempt_at)
    ensures: NoFallbackBranchGuessed(job)
}

-- REQ-CCR-002, REQ-CCR-006, REQ-CCR-006A
rule CurrentClaimStagesWholeAggregate {
    when: ProvisioningStageSucceeded(job, worker, token, generation)

    requires: job.status = claimed
    requires: job.claim_owner = worker
    requires: job.claim_token = token
    requires: job.generation = generation
    requires: job.lease_until != null
    requires: job.lease_until > now()
    requires: job.stage = commit_metadata
    requires: job.stage_updated_at <= now()
    requires: WholePublicationFactsAvailable(job)
    requires: not StagedAggregate.exists(job: job)

    ensures: StagedAggregate.created(job: job)
    ensures: job.status = delivery_pending
    ensures: job.stage = bootstrap_initial_turn
    ensures: job.stage_updated_at = now()
    ensures: job.delivery_retry_at = now() + config.retry_delay_2
    ensures: AggregateStagedAtomicallyButHidden(job.conversation_id)

    @guidance
        -- Keep the current claim for immediate delivery. Metadata, transcript,
        -- usable WorkScope, and pin commit together, but normal conversation
        -- surfaces and canonical navigation remain hidden until ready.
}

-- REQ-CCR-002, REQ-CCR-003, REQ-CCR-009
rule EligibleDeliveryClaimed {
    when: WorkerClaimsDelivery(worker, job, token, lease_until)

    requires: job.status = delivery_pending
    requires: job.delivery_retry_at = null or job.delivery_retry_at <= now()
    requires: job.lease_until = null or job.lease_until <= now()

    ensures: job.claim_owner = worker
    ensures: job.claim_token = token
    ensures: job.lease_until = lease_until
    ensures: job.generation = job.generation + 1
}

rule LiveClaimHeartbeatRenewsLease {
    when: ClaimHeartbeat(job, worker, token, generation)

    requires: job.status in { claimed, delivery_pending }
    requires: current_claim_matches(job, worker, token, generation)

    ensures: job.lease_until = now() + config.claim_lease

    @guidance
        -- The worker renews while awaiting delivery work, including objective
        -- expansion and enqueue. Renewal retains owner, token, and generation.
        -- An expired lease cannot be revived by a heartbeat.
}

rule LostClaimHeartbeatStopsWork {
    when: ClaimHeartbeat(job, worker, token, generation)

    requires: job.status not in { claimed, delivery_pending }
        or not current_claim_matches(job, worker, token, generation)

    ensures: InFlightWorkDroppedWithoutLateEnqueue(job, generation)
}

-- REQ-CCR-006, REQ-CCR-007
rule CurrentDeliveryClaimAcceptsObjectiveAtomically {
    when: ObjectiveEnqueueRequested(job, worker, token, generation, fingerprint)

    requires: job.status = delivery_pending
    requires: job.stage = bootstrap_initial_turn
    requires: current_claim_matches(job, worker, token, generation)
    requires: StagedAggregate.exists(job: job)
    requires: not ObjectiveAcceptance.exists(job: job)

    ensures: ObjectiveAcceptance.created(job: job, fingerprint: fingerprint)
    ensures: ObjectiveQueuedDurably(job.conversation_id, job.request_id)

    @guidance
        -- Validate the claim and exact accepted product/transcript identity,
        -- persist the acceptance receipt, and enqueue under one write authority
        -- shared with cancellation. Cancellation-first makes this rule
        -- ineligible; enqueue-first makes cancellation ineligible. The receipt
        -- survives queue drain and runtime consumption.
}

rule DuplicateObjectiveAcceptanceReplaysWithoutEnqueue {
    when: ObjectiveEnqueueRequested(job, worker, token, generation, fingerprint)

    requires: job.status = delivery_pending
    requires: current_claim_matches(job, worker, token, generation)
    requires: ObjectiveAcceptance.exists(job: job)
    requires: ObjectiveAcceptance{job: job}.fingerprint = fingerprint

    ensures: ObjectiveAcceptanceReplayedWithoutDuplicate(job.request_id)
}

rule StaleDeliveryEnqueueRejected {
    when: ObjectiveEnqueueRequested(job, worker, token, generation, fingerprint)

    requires: job.status != delivery_pending
        or not current_claim_matches(job, worker, token, generation)

    ensures: ObjectiveEnqueueRejectedWithoutReceiptOrQueueMutation(job.request_id)
}

-- REQ-CCR-002, REQ-CCR-006A
rule CurrentDeliveryClaimCompletesCreation {
    when: DeliveryCompletionRequested(job, worker, token, generation, fingerprint)

    requires: job.status = delivery_pending
    requires: job.stage = bootstrap_initial_turn
    requires: job.stage_updated_at <= now()
    requires: current_claim_matches(job, worker, token, generation)
    requires: ObjectiveAcceptance.exists(job: job)
    requires: ObjectiveAcceptance{job: job}.fingerprint = fingerprint
    requires: delivery_target_open_and_admissible(job)

    ensures: job.status = ready
    ensures: job.stage = finalize_publication
    ensures: job.stage_updated_at = now()
    ensures: job.claim_owner = null
    ensures: job.claim_token = null
    ensures: job.lease_until = null
    ensures: ConversationCreationPublishedAtomically(job.conversation_id)
    ensures: CanonicalNavigationAvailable(job.conversation_id)

    @guidance
        -- An exact durable receipt permits completion after takeover without
        -- re-expansion or re-enqueue. Ready corresponds to persisted published
        -- status; only this boundary exposes the staged aggregate normally.
}

-- REQ-CCR-004, REQ-CCR-009
rule DeliveryFailureSchedulesRetry {
    when: ObjectiveDeliveryFailed(job, worker, token, generation, error_message)

    requires: job.status = delivery_pending
    requires: current_claim_matches(job, worker, token, generation)
    requires: job.delivery_attempt < config.max_attempts

    ensures: job.delivery_attempt = job.delivery_attempt + 1
    ensures: job.delivery_retry_at = retry_deadline(job.delivery_attempt + 1)
    ensures: job.claim_owner = null
    ensures: job.claim_token = null
    ensures: job.lease_until = null
    ensures: DeliveryErrorPreserved(job.request_id, error_message)
    ensures: CreationSchedulerWakeRequested(job.delivery_retry_at)
}

rule DeliveryRetryBudgetExhausted {
    when: ObjectiveDeliveryFailed(job, worker, token, generation, error_message)

    requires: job.status = delivery_pending
    requires: current_claim_matches(job, worker, token, generation)
    requires: job.delivery_attempt >= config.max_attempts

    ensures: job.status = delivery_failed
    ensures: job.error_message = error_message
    ensures: job.claim_owner = null
    ensures: job.claim_token = null
    ensures: job.lease_until = null
    ensures: StagedAggregateRetainedForDeliveryRetry(job.conversation_id)
}

rule UserRetriesFailedDelivery {
    when: UserRetriesDelivery(user, job)

    requires: job.status = delivery_failed
    requires: delivery_target_open_and_admissible(job)

    ensures: job.status = delivery_pending
    ensures: job.delivery_attempt = 1
    ensures: job.delivery_retry_at = now()
    ensures: CreationSchedulerWakeRequested(job.delivery_retry_at)
    ensures: ExistingAggregateAndObjectiveIdentityReused(job.conversation_id, job.request_id)
}

rule IneligibleDeliveryRetryRejected {
    when: UserRetriesDelivery(user, job)

    requires: job.status != delivery_failed or not delivery_target_open_and_admissible(job)

    ensures: DeliveryRetryRejectedWithoutMutation(job.request_id)
}

rule PartialPublicationForbidden {
    when: PublicationAttempted(job)

    requires: not WholePublicationFactsAvailable(job)

    ensures: PartialPublicationRejected(job)
}

rule StaleClaimResultRejected {
    when: ProvisioningResultReported(job, worker, token, generation)

    requires: job.status != claimed
        or job.claim_owner != worker
        or job.claim_token != token
        or job.generation != generation
        or job.lease_until = null
        or job.lease_until <= now()

    ensures: ProvisioningResultRejectedAsStale(job, generation)
    ensures: StartingPinImmutable(job)
    ensures: PublishedConversationUnchanged(job.conversation_id)
}

rule TransientFailureSchedulesRetry {
    when: ProvisioningStageFailed(job, worker, token, generation, transient, error_message)

    requires: job.status = claimed
    requires: job.claim_owner = worker
    requires: job.claim_token = token
    requires: job.generation = generation
    requires: job.lease_until != null
    requires: job.lease_until > now()
    requires: job.attempt < config.max_attempts

    ensures: job.status = retry_scheduled
    ensures: job.claim_owner = null
    ensures: job.claim_token = null
    ensures: job.lease_until = null
    ensures: job.next_attempt_at = retry_deadline(job.attempt + 1)
    ensures: CreationSchedulerWakeRequested(job.next_attempt_at)
}

rule RetryBudgetExhaustedFailsCreation {
    when: ProvisioningStageFailed(job, worker, token, generation, transient, error_message)

    requires: job.status = claimed
    requires: job.claim_owner = worker
    requires: job.claim_token = token
    requires: job.generation = generation
    requires: job.attempt >= config.max_attempts

    ensures: job.status = failed
    ensures: job.claim_owner = null
    ensures: job.claim_token = null
    ensures: job.lease_until = null
    ensures: job.error_message = error_message
}

rule PermanentFailureFailsCreation {
    when: ProvisioningStageFailed(job, worker, token, generation, permanent, error_message)

    requires: job.status = claimed
    requires: job.claim_owner = worker
    requires: job.claim_token = token
    requires: job.generation = generation

    ensures: job.status = failed
    ensures: job.claim_owner = null
    ensures: job.claim_token = null
    ensures: job.lease_until = null
    ensures: job.error_message = error_message
}

rule CreationCancellationRevokesAuthority {
    when: UserCancelsCreation(user, job)

    requires: job.status in { accepted, claimed, retry_scheduled }
        or (job.status = delivery_pending and cancellable_hidden_aggregate(job))
    requires: not ObjectiveAcceptance.exists(job: job)

    ensures: job.generation = job.generation + 1
    ensures: job.status = cancelling
    ensures: job.claim_owner = null
    ensures: job.claim_token = null
    ensures: job.lease_until = null
    ensures: ResourceReconciliationRequested(job)

    @guidance
        -- REQ-CCR-007: Recheck durable acceptance under the same write authority
        -- as objective enqueue, then revoke claims and transfer owned resource
        -- reservations to the cleanup generation in that transaction.
}

rule AcceptedObjectiveExcludesCreationCancellation {
    when: UserCancelsCreation(user, job)

    requires: ObjectiveAcceptance.exists(job: job)

    ensures: CreationCancellationRejectedWithoutMutation(job.request_id)
}

rule CancelledHiddenAggregateRemoved {
    when: HiddenAggregateCleanupRequested(job)

    requires: job.status in { cancelling, deletion_pending }
    requires: StagedAggregate.exists(job: job)
    requires: safely_owned_hidden_aggregate(job)
    requires: not ObjectiveAcceptance.exists(job: job)

    ensures: not StagedAggregate.exists(job: job)
    ensures: HiddenProductTranscriptAndWorkScopeRemovedAtomically(job.conversation_id)
    ensures: SelectedUnownedWorkingDirectoryPreserved(job.request_id)
}

rule CancelledCreationPreserved {
    when: ResourceReconciliationCompleted(job)

    requires: job.status = cancelling
    requires: not StagedAggregate.exists(job: job)

    ensures: job.status = cancelled
    ensures: CancelledCreationVisible(job.request_id, job.creation_intent)
}

rule CreationDeletionHidesImmediately {
    when: UserDeletesCreation(user, job)

    requires: job.status in { accepted, claimed, retry_scheduled, cancelling, cancelled, failed, cleanup_ambiguous }

    ensures: job.generation = job.generation + 1
    ensures: job.status = deletion_pending
    ensures: job.claim_owner = null
    ensures: job.claim_token = null
    ensures: job.lease_until = null
    ensures: CreationHiddenFromNormalSurfaces(job.request_id)
    ensures: ResourceReconciliationRequested(job)
}

rule DeletionCompletesAfterReconciliation {
    when: ResourceReconciliationCompleted(job)

    requires: job.status = deletion_pending
    requires: not StagedAggregate.exists(job: job)

    ensures: CreationTombstoneDeletionRequested(job)
}

rule AmbiguousCleanupPreservesRecord {
    when: CleanupAmbiguityObserved(job, generation)

    requires: job.generation = generation
    requires: job.status in { cancelling, deletion_pending }

    ensures: job.status = cleanup_ambiguous
    ensures: CleanupLeftForManualResolution(job.request_id)
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

contract CreationReceiptRetention {
    @invariant InitialTerminalReceiptIndependentOfWatch
        -- Native initial execution is status-tagged; a failed result includes its
        -- exact retained objective reason, distinct from provisioning failure.
        -- The same selected row supplies kind and reason before and after deletion.
        -- The first completed, failed or cancelled outcome of the exact accepted
        -- initial objective is retained atomically before its execution occurrence
        -- is consumed. This holds for normal and captured direct-turn settlement,
        -- with or without an active watch. The receipt belongs to the accepted
        -- request and its exact original transcript, preserves an actual failure
        -- reason, and survives restart and target deletion. Later turns cannot
        -- overwrite it. Erased pre-receipt evidence is not fabricated. Missing
        -- operation-specific evidence is unavailable, never inferred from current
        -- transcript state, publication or a successor. A receipt grants no
        -- execution, recovery or retargeting authority.

    @invariant CreationImagePayloadLifetime
        -- Accepted delivery bytes remain unchanged while any transcript of the
        -- published product exists. Deleting the last transcript atomically
        -- retires creation-request delivery payloads; deleting only the original
        -- with a surviving successor does not. Historical identity/provenance and
        -- ordered image replay identity remain: ordinal, media type and SHA-256
        -- of the exact accepted UTF-8 data string, not the payload. Identical
        -- retries reconcile without enqueue, bootstrap, resource reservation or
        -- retargeting; changed bytes, media type, order or count conflict.
        -- Retirement is distinct from an originally empty image list and from
        -- missing/partial live payload corruption, which is a hard error.
        -- Upgrade derives replay identity before retiring orphan product payloads
        -- in the same transaction. Independent transcript attachments are outside
        -- this creation-request delivery lifetime.

}

surface CreationControls {
    facing user: CreationUser
    context job: CreationJob
    contracts:
        fulfils CreationReceiptRetention

    exposes:
        job.status
        job.creation_intent when job.status in { accepted, claimed, retry_scheduled, delivery_pending, delivery_failed, cancelling, cancelled, failed, cleanup_ambiguous }
        job.error_message when job.status in { failed, delivery_failed }

    provides:
        StructurallyValidCreationRequested(request_id, conversation_id, creation_intent, accepted_handle)
        UserCancelsCreation(user, job)
            when job.status in { accepted, claimed, retry_scheduled, delivery_pending }
        UserRetriesDelivery(user, job)
            when job.status = delivery_failed and delivery_target_open_and_admissible(job)
        UserDeletesCreation(user, job)
            when job.status in { accepted, claimed, retry_scheduled, cancelling, cancelled, failed, cleanup_ambiguous }
}

surface ReadyConversationNavigation {
    facing user: CreationUser
    context job: CreationJob

    exposes:
        job.conversation_id when job.status = ready and original_publication_live(job)
}

------------------------------------------------------------
-- Helpers
------------------------------------------------------------

-- next_creation_stage(stage) returns the next value in CreationStage order.
-- retry_deadline(attempt) uses config.retry_delay_2, retry_delay_3, or
-- config.retry_delay_4 for attempts two, three, and four respectively.
-- WholePublicationFactsAvailable(job) is true iff the accepted job has every
-- user-visible fact required for one atomic publication outcome.
-- StartingPinImmutable(job) asserts that an already-created StartingPin row is
-- never rewritten by retries, replacement claims, or stale results.
-- current_claim_matches(job, worker, token, generation) requires non-null
-- claim fields matching that worker/token/generation and a lease strictly later
-- than the persistence clock sampled under write authority. It is false for a
-- cancelled, replaced, released, or expired claim. For delivery_pending it also
-- requires original_publication_live(job), including at already-held claim sinks.
-- original_publication_live(job) requires the exact original transcript and its
-- ordinary product to exist; a successor transcript never substitutes for it.
-- Missing originals retain accepted identity, intent identity and provenance, but are
-- excluded from delivery claim scans, retry/recovery and deadline scheduling.
-- hidden_from_normal_surfaces(conversation_id) excludes normal list, route,
-- transcript, and navigation exposure; exact-request recovery remains visible.
-- cancellable_hidden_aggregate(job) requires the reserved ProductConversation
-- and staged transcript identities to agree, one archived user root with no
-- parent or sibling transcript, ordinary Open lifecycle, and no durable input
-- acceptance receipt for that transcript. It never treats an empty queue as
-- absence of acceptance.
-- safely_owned_hidden_aggregate(job) additionally proves the exact WorkScope
-- attachment, no other owners/transcripts/children sharing the scope, and no
-- other scope attachments. Cleanup rechecks this under write authority after
-- all owned resource reservations are released; mismatch is non-destructive.
-- delivery_target_open_and_admissible(job) requires the existing ordinary Open
-- product, original_publication_live(job), and no unfinished or close-incomplete
-- Close obligation. A failed
-- delivery exposes only retry_delivery when this holds, otherwise no action;
-- it never exposes creation Delete or Start over. Pending delivery exposes
-- only Cancel; the cancellation transaction rechecks receipt and ownership
-- eligibility, so advertised Cancel is not authority after acceptance.
