-- allium: 3
-- Durable Conversation Creation: Behavioural Specification
--
-- Scope: request-bound durable acceptance, exclusive provisioning authority,
-- immutable starting-pin selection, atomic publication, retry and
-- reconciliation, cancellation, and deletion cleanup.
--
-- Creation has no unresolved success outcome, no visible shell before publication,
-- no stale/local canonical fallback, and no creation-time file or skill expansion.
-- Excludes: Git command details, database representation, HTTP and UI layout.
--
-- Requirement traceability: REQ-CCR-001 through REQ-CCR-010.

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    claim_lease: Duration = 30_000.ms
    retry_delay_2: Duration = 2_000.ms
    retry_delay_3: Duration = 10_000.ms
    retry_delay_4: Duration = 30_000.ms
    max_attempts: Integer = 4
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum CreationStatus {
    accepted | claimed | retry_scheduled | cancelling | cancelled
    | deletion_pending | ready | failed | cleanup_ambiguous
}

enum CreationStage {
    validate_intent | resolve_repository | resolve_starting_pin
    | materialize_worktree | finalize_attachments
    | commit_metadata | bootstrap_initial_turn | finalize_publication
}

enum StartingPinSource { authoritative_origin_default | local_main_without_origin }

------------------------------------------------------------
-- Actors
------------------------------------------------------------

actor CreationUser {}
actor CreationWorker {}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity CreationJob {
    request_id: String
    conversation_id: String
    status: CreationStatus
    stage: CreationStage
    attempt: Integer
    generation: Integer
    creation_intent: String
    accepted_handle: String

    claim_owner: CreationWorker when status = claimed
    claim_token: String when status = claimed
    lease_until: Timestamp when status = claimed
    next_attempt_at: Timestamp when status = retry_scheduled
    error_message: String when status = failed

    transitions status {
        accepted -> claimed
        accepted -> cancelling
        accepted -> deletion_pending
        claimed -> claimed
        claimed -> retry_scheduled
        claimed -> ready
        claimed -> failed
        claimed -> cancelling
        claimed -> deletion_pending
        retry_scheduled -> claimed
        retry_scheduled -> failed
        retry_scheduled -> cancelling
        retry_scheduled -> deletion_pending
        cancelling -> cancelled
        cancelling -> deletion_pending
        cancelling -> cleanup_ambiguous
        cancelled -> deletion_pending
        failed -> deletion_pending
        deletion_pending -> cleanup_ambiguous
        terminal: ready, cleanup_ambiguous
    }

    invariant AttemptBudgetBounded {
        attempt >= 0 and attempt <= config.max_attempts
    }

    invariant ClaimedGenerationCurrent {
        status = claimed implies generation > 0
    }
}

entity StartingPin {
    job: CreationJob
    commit_id: String
    branch_name: String
    source: StartingPinSource
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule CreationAcceptedDurably {
    when: StructurallyValidCreationRequested(request_id, conversation_id, creation_intent, accepted_handle)
    requires: not CreationJob.exists(request_id: request_id)

    ensures: CreationJob.created(
        request_id: request_id,
        conversation_id: conversation_id,
        status: accepted,
        stage: validate_intent,
        attempt: 0,
        generation: 0,
        creation_intent: creation_intent,
        accepted_handle: accepted_handle
    )
    ensures: CreationAcceptedReplayHandle(request_id, accepted_handle)

    @guidance
        -- Persist the request-bound durable job identity, replay handle, and
        -- creation intent atomically before any filesystem, Git, runtime, or
        -- publication work begins.
}

rule DuplicateRequestReplaysAcceptance {
    when: StructurallyValidCreationRequested(request_id, conversation_id, creation_intent, accepted_handle)

    requires: CreationJob.exists(request_id: request_id)
    requires: CreationJob{request_id: request_id}.creation_intent = creation_intent

    ensures: CreationAcceptedReplayHandle(request_id, CreationJob{request_id: request_id}.accepted_handle)
}

rule ReusedRequestIdWithDifferentIntentConflicts {
    when: StructurallyValidCreationRequested(request_id, conversation_id, creation_intent, accepted_handle)

    requires: CreationJob.exists(request_id: request_id)
    requires: CreationJob{request_id: request_id}.creation_intent != creation_intent

    ensures: CreationRequestConflict(request_id)
}

rule EligibleCreationClaimed {
    when: WorkerClaimsEligibleJob(worker, job, token, lease_until)

    requires: job.status = accepted
        or (job.status = retry_scheduled and job.next_attempt_at <= now())
        or (job.status = claimed and job.lease_until <= now())

    ensures: job.status = claimed
    ensures: job.claim_owner = worker
    ensures: job.claim_token = token
    ensures: job.lease_until = lease_until
    ensures: job.generation = job.generation + 1
}

rule ExpiredClaimReconciledBeforeResume {
    when: WorkerReplacesExpiredClaim(worker, job)

    requires: job.status = claimed
    requires: job.lease_until <= now()

    ensures: ExternalStateInspectionRequested(worker, job, job.stage)

    @guidance
        -- Replacement observes external state before deciding whether to adopt,
        -- conflict, preserve ambiguity, clean, or resume the interrupted stage.
}

rule CurrentClaimAdvancesStage {
    when: ProvisioningStageSucceeded(job, worker, token, generation)

    requires: job.status = claimed
    requires: job.claim_owner = worker
    requires: job.claim_token = token
    requires: job.generation = generation
    requires: job.lease_until > now()
    requires: job.stage != finalize_publication

    ensures: job.stage = next_creation_stage(job.stage)
}

rule OriginDefaultStartingPinSelected {
    when: StartingPinResolvedFromAuthoritativeOrigin(job, branch_name, commit_id)

    requires: job.status = claimed
    requires: job.stage = resolve_starting_pin
    requires: not StartingPin.exists(job: job)

    ensures: StartingPin.created(
        job: job,
        commit_id: commit_id,
        branch_name: branch_name,
        source: authoritative_origin_default
    )
}

rule LocalMainStartingPinSelectedWithoutOrigin {
    when: StartingPinResolvedFromLocalMain(job, commit_id)

    requires: job.status = claimed
    requires: job.stage = resolve_starting_pin
    requires: not repository_has_remote_named_origin(job)
    requires: not StartingPin.exists(job: job)

    ensures: StartingPin.created(
        job: job,
        commit_id: commit_id,
        branch_name: "main",
        source: local_main_without_origin
    )
}

rule StartingPinResolutionFailureIsRetryableAndNeverFallsBack {
    when: StartingPinResolutionFailed(job, reason)

    requires: job.status = claimed
    requires: job.stage = resolve_starting_pin
    requires: not StartingPin.exists(job: job)

    ensures: job.status = retry_scheduled
    ensures: job.next_attempt_at = retry_deadline(job.attempt + 1)
    ensures: CreationSchedulerWakeRequested(job.next_attempt_at)
    ensures: NoFallbackBranchGuessed(job)
}

rule CurrentClaimCompletesCreation {
    when: ProvisioningStageSucceeded(job, worker, token, generation)

    requires: job.status = claimed
    requires: job.claim_owner = worker
    requires: job.claim_token = token
    requires: job.generation = generation
    requires: job.lease_until > now()
    requires: job.stage = finalize_publication
    requires: WholePublicationFactsAvailable(job)

    ensures: job.status = ready
    ensures: ConversationCreationPublishedAtomically(job.conversation_id)
    ensures: ObjectiveOrNavigationQueuedAfterPublication(job.conversation_id)
}

rule PartialPublicationForbidden {
    when: PublicationAttempted(job)

    requires: not WholePublicationFactsAvailable(job)

    ensures: PartialPublicationRejected(job)
}

rule StaleClaimResultRejected {
    when: ProvisioningResultReported(job, worker, token, generation)

    requires: job.status != claimed
        or job.claim_owner != worker
        or job.claim_token != token
        or job.generation != generation
        or job.lease_until <= now()

    ensures: ProvisioningResultRejectedAsStale(job, generation)
    ensures: StartingPinImmutable(job)
    ensures: PublishedConversationUnchanged(job.conversation_id)
}

rule TransientFailureSchedulesRetry {
    when: ProvisioningStageFailed(job, worker, token, generation, transient, error_message)

    requires: job.status = claimed
    requires: job.claim_owner = worker
    requires: job.claim_token = token
    requires: job.generation = generation
    requires: job.lease_until > now()
    requires: job.attempt < config.max_attempts

    ensures: job.status = retry_scheduled
    ensures: job.next_attempt_at = retry_deadline(job.attempt + 1)
    ensures: CreationSchedulerWakeRequested(job.next_attempt_at)
}

rule RetryBudgetExhaustedFailsCreation {
    when: ProvisioningStageFailed(job, worker, token, generation, transient, error_message)

    requires: job.status = claimed
    requires: job.claim_owner = worker
    requires: job.claim_token = token
    requires: job.generation = generation
    requires: job.attempt >= config.max_attempts

    ensures: job.status = failed
    ensures: job.error_message = error_message
}

rule PermanentFailureFailsCreation {
    when: ProvisioningStageFailed(job, worker, token, generation, permanent, error_message)

    requires: job.status = claimed
    requires: job.claim_owner = worker
    requires: job.claim_token = token
    requires: job.generation = generation

    ensures: job.status = failed
    ensures: job.error_message = error_message
}

rule CreationCancellationRevokesAuthority {
    when: UserCancelsCreation(user, job)

    requires: job.status in { accepted, claimed, retry_scheduled }

    ensures: job.generation = job.generation + 1
    ensures: job.status = cancelling
    ensures: ResourceReconciliationRequested(job)
}

rule CancelledCreationPreserved {
    when: ResourceReconciliationCompleted(job)

    requires: job.status = cancelling

    ensures: job.status = cancelled
    ensures: CancelledCreationVisible(job.request_id, job.creation_intent)
}

rule CreationDeletionHidesImmediately {
    when: UserDeletesCreation(user, job)

    requires: job.status in { accepted, claimed, retry_scheduled, cancelling, cancelled, failed, cleanup_ambiguous }

    ensures: job.generation = job.generation + 1
    ensures: job.status = deletion_pending
    ensures: CreationHiddenFromNormalSurfaces(job.request_id)
    ensures: ResourceReconciliationRequested(job)
}

rule DeletionCompletesAfterReconciliation {
    when: ResourceReconciliationCompleted(job)

    requires: job.status = deletion_pending

    ensures: CreationTombstoneDeletionRequested(job)
}

rule AmbiguousCleanupPreservesRecord {
    when: CleanupAmbiguityObserved(job, generation)

    requires: job.generation = generation
    requires: job.status in { cancelling, deletion_pending }

    ensures: job.status = cleanup_ambiguous
    ensures: CleanupLeftForManualResolution(job.request_id)
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface CreationControls {
    facing user: CreationUser
    context job: CreationJob

    exposes:
        job.status
        job.creation_intent when job.status in { accepted, claimed, retry_scheduled, cancelling, cancelled, failed, cleanup_ambiguous }

    provides:
        StructurallyValidCreationRequested(request_id, conversation_id, creation_intent, accepted_handle)
        UserCancelsCreation(user, job)
            when job.status in { accepted, claimed, retry_scheduled }
        UserDeletesCreation(user, job)
            when job.status in { accepted, claimed, retry_scheduled, cancelling, cancelled, failed, cleanup_ambiguous }
}

------------------------------------------------------------
-- Helpers
------------------------------------------------------------

-- next_creation_stage(stage) returns the next value in CreationStage order.
-- retry_deadline(attempt) uses config.retry_delay_2, retry_delay_3, or
-- config.retry_delay_4 for attempts two, three, and four respectively.
-- WholePublicationFactsAvailable(job) is true iff the accepted job has every
-- user-visible fact required for one atomic publication outcome.
-- StartingPinImmutable(job) asserts that an already-created StartingPin row is
-- never rewritten by retries, replacement claims, or stale results.
