-- allium: 3
-- Cross-platform production deployment lifecycle
--
-- Scope: shared preparation and transaction semantics for launchd, systemd,
-- and bare Linux, with backend-specific activation ownership.
-- This module owns shared guarantees. Platform-specific launchd mechanics
-- are cumulative refinements in specs/launchd-deployment/launchd-deployment.allium.
-- Requirement traceability: REQ-PD-001 through REQ-PD-029. Runtime lifecycle
-- rules model REQ-PD-002 through REQ-PD-014; backend selection, operator
-- syntax, bare-Linux reboot integration, disposable test isolation, and
-- release asset publication are interface/build obligations in requirements.md.

config {
    stale_after: Duration = 120_000.ms
    current_schema_growth_margin_divisor: Integer = 10
    current_schema_growth_margin_min_bytes: Integer = 1_073_741_824
    current_schema_growth_margin_max_bytes: Integer = 8_589_934_592
    current_schema_evidence_budget_bytes: Integer = 2_097_152
    current_schema_max_proof_bytes: Integer = 1_048_576
}

enum BackendKind { launchd | systemd | bare_linux }
enum TransactionState {
    preparing | prepared | handed_off | precondition_cleanup_pending | activating | committed
    | precondition_failed | activation_failed_rolled_back
    | activation_failed_rollback_failed | ordinary_activation_failed_rollback_failed | current_forward_failed | rejected_concurrent
}

value RuntimeIdentity {
    version: String
    git_sha: String
}

value RuntimeEndpoint {
    version_url: String
}

value PreparedArtifactProof {
    controller_source_commit: String
    controller_helper_hash: String
    shared_database_path: String
    migration_ledger_version: Integer
}

entity PreparedArtifactLifecycleObservation {
    kind: PreparedArtifactAwaitingPreparation | PreparedArtifactPreflight | PreparedArtifactOfflineOwned
        | PreparedArtifactSnapshotVerified
}

variant PreparedArtifactAwaitingPreparation : PreparedArtifactLifecycleObservation {}

variant PreparedArtifactPreflight : PreparedArtifactLifecycleObservation {
    prepared_artifact_proof: PreparedArtifactProof
}

variant PreparedArtifactOfflineOwned : PreparedArtifactLifecycleObservation {
    prepared_artifact_proof: PreparedArtifactProof
    offline_ownership_proof: String
}

variant PreparedArtifactSnapshotVerified : PreparedArtifactLifecycleObservation {
    prepared_artifact_proof: PreparedArtifactProof
    offline_ownership_proof: String
    snapshot_integrity_proof: String
}


enum PairedRecoveryMode { snapshot_restored | unchanged_predecessor }

enum FinalizationOutcome { not_committed | pending | complete }

entity DeployTransaction {
    id: String
    backend: BackendKind
    kind: LocalHeadDeployment | PublishedReleaseDeployment | PreparedArtifactDeployment
        | ProtectedSystemdReleaseDeployment | ProtectedSystemdPreparedDeployment
    source_commit: String
    expected: RuntimeIdentity
    previous: RuntimeIdentity?
    expected_endpoint: RuntimeEndpoint
    previous_endpoint: RuntimeEndpoint?
    state: TransactionState
    claim_generation: Integer
    created_at: Timestamp
    updated_at: Timestamp
    failure: String?
    rollback_failure: String?

    transitions state {
        preparing -> prepared
        preparing -> precondition_failed
        preparing -> rejected_concurrent
        prepared -> handed_off
        prepared -> precondition_failed
        prepared -> activation_failed_rolled_back
        prepared -> activation_failed_rollback_failed
        handed_off -> precondition_cleanup_pending
        activating -> precondition_cleanup_pending
        precondition_cleanup_pending -> precondition_failed
        handed_off -> precondition_failed
        activating -> precondition_failed
        handed_off -> activating
        handed_off -> activation_failed_rolled_back
        handed_off -> activation_failed_rollback_failed
        activating -> committed
        activating -> activation_failed_rolled_back
        activating -> activation_failed_rollback_failed
        activating -> current_forward_failed
        current_forward_failed -> activating
        current_forward_failed -> current_forward_failed
        activating -> ordinary_activation_failed_rollback_failed
        activation_failed_rollback_failed -> activation_failed_rolled_back
        activation_failed_rollback_failed -> activation_failed_rollback_failed
        terminal: committed, precondition_failed,
                  activation_failed_rolled_back, ordinary_activation_failed_rollback_failed, rejected_concurrent
    }
}

variant LocalHeadDeployment : DeployTransaction {}

variant PublishedReleaseDeployment : DeployTransaction {
    release_tag: String
}

-- REQ-PD-023–025 / REQ-COMP-014: a separate published-release mode, not prepared.
variant ProtectedSystemdReleaseDeployment : DeployTransaction {
    release_tag: String
    controller_source_commit: String
    controller_helper_hash: String
    database_path: String
}

-- REQ-PD-029 / REQ-COMP-016: exact prepared Linux source, not a release or paired launchd source.
variant ProtectedSystemdPreparedDeployment : DeployTransaction {
    preparation_receipt_hash: String
    preparation_run_id: Integer
    preparation_run_attempt: Integer
    controller_source_commit: String
    controller_helper_hash: String
    database_path: String
}

variant PreparedArtifactDeployment : DeployTransaction {
    paired_lifecycle_observation: PreparedArtifactLifecycleObservation
    finalization: FinalizationOutcome
    recovery_mode: PairedRecoveryMode?
}


entity DeploymentClaim {
    transaction: DeployTransaction
    generation: Integer
    active: Boolean
}

entity DeploymentHandoff {
    transaction: DeployTransaction
    manifest_hash: String
    immutable: Boolean
    secret_free: Boolean
}

variant LaunchdHandoff : DeploymentHandoff {
    helper_label: String
}

variant SystemdHandoff : DeploymentHandoff {
    transient_unit: String
    root_transaction_id: String
}

variant BareLinuxHandoff : DeploymentHandoff {
    supervisor_socket_identity: String
}

-- Helpers
--
-- selected_source_is_valid(transaction) -> Boolean
--   Local source is exact checked HEAD after required checks and compilation,
--   release source is one resolved tag and commit with a host-target asset
--   matching its checksum and package version, or prepared_artifact is a
--   protected host-target artifact whose exact full candidate identity is
--   independently verified. A latest selection resolves to stable tag and
--   metadata; an exact RC selection has matching tag, prerelease metadata, full
--   embedded version, and commit. For every source, expected.git_sha is exactly
--   source_commit, both are 40 lowercase hexadecimal characters, and no prefix
--   match establishes candidate identity.
-- prepared_artifact_source_is_valid(transaction) -> Boolean
--   True for local and published sources. For a launchd prepared source, its signed
--   standalone identity and receipt are valid. For ProtectedSystemdPreparedDeployment,
--   the closed exact Linux receipt, sole payload/hash, candidate identity, target,
--   registry digest, workflow run/attempt and verified checks satisfy REQ-PD-029.
--   The operator establishes protected run/source/artifact association independently
--   of local JSON validation. This does not assert database lifecycle observations.
-- paired_database_preflight_is_valid(transaction) -> Boolean
--   True unless transaction.kind = PreparedArtifactDeployment. For that launchd
--   paired variant, the immutable proof has Candidate and captured predecessor
--   configure the same canonical path; the single shared_database_path is that
--   value. The proof includes legacy-schema eligibility, one canonical database
--   path shared by installed predecessor and candidate, ledger at most 69, and
--   ProductConversation upgrade mode. It does not assert quiesce, offline ownership,
--   or a snapshot. Protected systemd variants use protected_systemd_preflight_valid.
-- paired_database_proof_is_valid(transaction) -> Boolean
--   True unless transaction.kind = PreparedArtifactDeployment. For that launchd
--   paired variant, after quiesce the lifecycle observation is
--   PreparedArtifactSnapshotVerified: exclusive offline ownership and verified
--   SQLite snapshot integrity bound to the immutable controller, predecessor and
--   shared path. Protected systemd variants use their backup/rehearsal predicates.
-- controller_identity_is_independently_bound(transaction) -> Boolean
--   True for ordinary sources. For prepared sources, the controller helper hash is
--   bound to the recorded clean controller source and protocol. A launchd prepared
--   contract governs whether controller and candidate commits may be equal. The
--   exact systemd prepared contract requires different commits and requires the
--   receipt controller commit to equal the independently selected controller source.
-- PairedRecoveryVerified(transaction, mode)
--   Separately requested retained-helper recovery verified matched database,
--   runtime/configuration and predecessor identity before releasing ownership.
-- CandidateStartupReady(transaction)
--   Emitted after quiesce and paired snapshot proof verification, before
--   candidate install/start; ordinary sources use their prepared inputs.
-- candidate_startup_proof_is_valid(transaction) -> Boolean
--   True for unprotected ordinary sources. For PreparedArtifactDeployment,
--   paired_database_proof_is_valid holds and the verified predecessor snapshot
--   follows exclusive offline proof before candidate startup. Protected systemd
--   variants instead require a durable
--   live marker, protected_systemd_target_valid, intact backup/rehearsal evidence
--   and preserved configuration; inhibit removal immediately precedes exact
--   candidate start, only after exclusive stopped target/candidate verification.
-- paired_predecessor_start_order_is_valid(transaction) -> Boolean
--   True for ordinary sources. For prepared_artifact, the matching database is
--   restored and integrity-checked before predecessor startup, or no snapshot
--   exists and exclusive legacy DB plus captured binary/config hashes prove
--   an unchanged predecessor. The latter path claims no database restoration.
-- predecessor_start_authorized(transaction) -> Boolean
--   Startup requires matched snapshot restoration or verified unchanged legacy
--   database/runtime/configuration with exclusive offline ownership. Protected
--   systemd never replays its backup: only pre-marker unchanged-source recovery
--   can authorize predecessor startup.
-- candidate_teardown_attempted(transaction) -> Boolean
--   Failed activation or recovery records an attempt to tear down the candidate;
--   this does not claim an operating-system failure made teardown complete.
-- recovery_verification_unconfirmed(transaction) -> Boolean
--   Durable status reports that recovery or teardown could not be confirmed,
--   when predecessor identity/start proof failed; a verified running predecessor
--   with publication-only failure is preserved behind its retained claim.
-- paired_transaction_retained(transaction) -> Boolean
--   The private paired transaction directory, verified snapshot, proof files,
--   and durable recovery status remain available for supported recovery.
-- active_claim_retained(transaction) -> Boolean
--   The matching deployment claim remains active until supported recovery is
--   verified; a blind manual action cannot clear it.
-- supported_recovery_verified(transaction) -> Boolean
--   A supported recovery procedure has verified restored artifacts, matching
--   database, service health, and claim generation before claim release.
-- previous_rollback_identity_is_valid(transaction) -> Boolean
--   No previous runtime exists, or previous is the identity captured from the
--   already-installed rollback artifact and its git_sha is exactly 12 or 40
--   lowercase hexadecimal characters. The 12-character form is valid only for
--   this predecessor rollback role, not for a candidate or controller.
-- selected_supervisor_artifact_matches_running(transaction) -> Boolean
--   No bare supervisor is running, or the startup-bound source digest reported
--   by the running supervisor equals the supervisor artifact selected by this
--   transaction. Protocol equality and on-disk file equality alone do not
--   satisfy this predicate.
-- preparation_complete(transaction) -> Boolean
--   Candidate, backend configuration, one source-specific environment snapshot, rollback
--   inputs, identities, endpoints, destination reservations, hashes,
--   activation program, immutable handoff, and initial status are valid and
--   host-resident before disruption. Ordinary helper comes from selected source;
--   paired helper comes from the separately verified clean controller commit.
--   Protected systemd uses its separately explicit different controller commit;
--   all immutable evidence and the exact source ledger pass REQ-PD-023 before stop.
--   The launchd current-schema refinement under REQ-PD-021 additionally qualifies
--   prepared source114 only for receipt/source/expected/embedded candidate
--   23badb8be4bc8d05a7e1c49c5367ceb14ebccd92. It automatically emits required integer
--   prepared_source_baseline = 114 plus candidate_registry_expected_sha256 =
--   a4eb047e59b21997ea068f1bd5e97c9c943f74a4c5670cdd8ff8ac10ffd5eee6 inside current_schema_upgrade.
--   Actual registry digest must match, parsed target must be exact128, and source
--   must be complete prefix114 or target128. Generic prepared123/target128 and
--   published-release114 remain distinct. Registry bytes come from git show of
--   the full locally present receipt-bound candidate commit, never controller
--   working-tree bytes; helper comes from a different clean retained controller.
--   Partial/extra/wrong evidence rejects before stop; snapshot proof binds it for
--   recovery/finalization. No other candidate/baseline/source kind gains admission.
--   RC4 registry semantics and protected lifecycle/invocation boundary are unchanged.
-- claim_available(transaction) -> Boolean
--   No active or unresolved transaction owns the host deployment claim. A
--   markerless status is resolved only when it positively names a nonempty
--   transaction, an exact supported source kind, a recognized terminal state,
--   finalization_pending absent or literally false, and rollback_failure absent or
--   literally null; every other markerless status is unresolved. Active-owner
--   terminal proof also requires a regular non-symlink status with explicit literal
--   lifecycle fields and an exact source kind coherent with retained mode evidence.
--   Unreadable/non-regular active
--   markers remain visible unresolved fences. Active-owner status is rendered even
--   when the shared last-status record is absent, unreadable, or belongs to another
--   owner.
-- current_claim_matches(transaction) -> Boolean
--   The active claim names transaction.id and transaction.claim_generation.
-- claim_release_matches(transaction) -> Boolean
--   The released claim named transaction.id and transaction.claim_generation
--   at the serialized release edge, before its active flag was cleared.
-- backend_owner_independent(transaction, handoff) -> Boolean
--   launchd owns a one-shot LaunchAgent, systemd owns a root transient unit,
--   or the persistent bare-Linux supervisor owns activation and its child.
-- helper_capacity_reserved(transaction) -> Boolean
--   After handoff and before production stop, the launchd paired helper holds
--   private capacity. Current-schema capacity uses observed live DB plus WAL and
--   a 10 percent growth margin clamped to 1–8 GiB, capped by each capacity pool's
--   safe ceiling without crediting live DB/WAL logical bytes against copy-on-write
--   peak demand, while retaining at least 20 GiB free after prepared install overhead.
--   APFS volumes in one container share a pool; every evidence check uses the
--   minimum reported free value among affected paths in that pool. The complete
--   allocation-unit-rounded atomic evidence lifecycle, including old and replacement
--   proofs plus capacity evidence, fits 2 MiB; each proof generation is at most 1 MiB.
--   Both bounds are projected before disruption, and the floor plus pending atomic
--   evidence peak is proved before initial or replacement evidence publication.
--   The stopped, exclusively owned size recheck retains the floor plus the
--   not-yet-resident evidence allowance
--   and is authoritative. After migration, actual DB+WAL remains within the held
--   target and every affected capacity pool retains the floor plus its remaining
--   evidence allowance. True for ordinary sources/backends with prepared capacity.
-- pre_stop_cleanup_uncertain(transaction) -> Boolean
--   Reservation/evidence cleanup durability is uncertain before service stop;
--   no snapshot exists and no runtime or database mutation was authorized.
-- pre_stop_capacity_cleanup_durable(transaction) -> Boolean
--   Transaction-owned unsnapshotted reservation/evidence files are absent and
--   their parent directories were fsynced; true for failures with no such files.
-- pre_stop_cleanup_retry_context_is_valid(transaction) -> Boolean
--   Exact retained transaction and matching claim under the operation fence;
--   uses recorded pre-stop evidence, not runtime inspection.
-- PreStopCleanupUncertain(transaction, failure)
--   Capacity reservation failed before stop without durable cleanup proof.
-- PreStopCleanupRetryRequested(transaction)
--   Operator requests cleanup-only disposition of the retained transaction.
-- PreStopCleanupRetryFailed(transaction, failure)
--   Cleanup or terminal status durability failed; ownership remains retained.
-- PreStopCleanupFilesRemovedAndParentsSynced(transaction)
--   Only this transaction's unsnapshotted reservation/evidence files were
--   removed and all affected parent directories fsynced.
-- HelperCapacityVerified(transaction)
--   Independent helper confirmed its pre-stop capacity reservation.
-- handoff_valid_for_backend(transaction, handoff) -> Boolean
--   The typed handoff variant corresponds to transaction.backend and all
--   host-resident inputs match their declared hashes and allowed locations.
-- atomic_install_complete(transaction) -> Boolean
--   Fsynced destination-filesystem artifacts replace the candidate binary by
--   rename. Ordinary plist publication is complete; paired bootstrap remains
--   private with its atomic publication link prepared until durable commit.
-- exact_candidate_running(transaction) -> Boolean
--   A new backend-owned process serves the exact expected version and complete
--   40-character git SHA, expected.git_sha equals source_commit, and bare Linux
--   also matches the supervisor child PID and proc start.
-- exact_previous_restored(transaction) -> Boolean
--   Previous runtime artifacts, environment, service state, deployed SHA,
--   endpoint, and captured runtime identity have been restored and verified;
--   the identity may use the rollback-only 12-character legacy form admitted by
--   previous_rollback_identity_is_valid(transaction). Database restoration is
--   feature-scoped and is represented by paired_predecessor_start_order_is_valid.
-- paired_recovery_succeeded(transaction) -> Boolean
--   True for ordinary sources when exact_previous_restored holds. For
--   prepared_artifact, exact_previous_restored and
--   paired_predecessor_start_order_is_valid hold, including unchanged legacy resume.
-- paired_transaction_retained(transaction) -> Boolean
--   The private paired transaction directory, verified snapshot, proof files,
--   and durable recovery status remain available for manual recovery.
-- active_claim_retained(transaction) -> Boolean
--   The matching deployment claim remains active after incomplete paired recovery;
--   later ordinary deploy and restart requests cannot release it.
-- durable_terminal_status_exists(transaction) -> Boolean
--   Redacted status durably records transaction's terminal state.
-- DeploymentRequestRejectedBeforeTransaction(transaction)
--   The request returns an actionable refusal before a deployment claim or
--   durable transaction exists.
-- installed_environment_is_snapshot(transaction) -> Boolean
--   The installed environment is the single snapshot used by preflight and
--   endpoint selection, not a competing override layer. Prepared source uses
--   captured installed plist/PATH; protected systemd preserves installed env,
--   service/socket and canonical DB path; other ordinary sources use the source
--   env snapshot.

-- paired_snapshot_restored(transaction) -> Boolean
--   A context-bound snapshot was restored and integrity-checked offline.
-- paired_unchanged_predecessor_verified(transaction) -> Boolean
--   No snapshot proof or candidate mutation exists; stopped service, exclusive
--   legacy DB, and captured binary/configuration hashes authorize private resume.
-- paired_publication_is_verified(transaction) -> Boolean
--   Paired plists remain private during identity verification. Candidate autoload
--   publication follows durable commit; predecessor publication follows matched
--   DB authorization and identity verification. Publication preserves the private
--   bootstrap inode so strict loaded-path restart verification remains valid.
--   True for ordinary sources.
-- pre_manifest_abandonment_verified(transaction) -> Boolean
--   Matching preparing status preceded owned claim publication, manifest
--   is absent or exists; preparation PID is dead and no helper was admitted,
--   or a prepared/helper-handoff attempt ended with confirmed helper absence.
--   Retained source kind and requested paired/current-schema recovery mode match
--   exactly; initial status carries the mode before manifest publication. All
--   transaction-owned unsnapshotted capacity/evidence files, atomic temporaries, and
--   SQLite sidecars are removed on reservation abort and cleanup, with parents fsynced
--   before terminal status. Terminal-status or claim-release durability failure
--   restores a visible exact-owner fence and cleanup-pending where possible; matching
--   claim removal is parent-directory-fsynced before success. Manifest presence does
--   not imply handoff.
-- PreparedAbandonmentVerified(transaction)
--   Operator requested recovery and pre_manifest_abandonment_verified holds.

-- snapshot_proof_durable(transaction) -> Boolean
--   Matching context-bound snapshot proof is persisted and verified before bootstrap.
-- CandidatePreparationCompleted(transaction)
--   Fallible staging completed under the already acquired preparation claim.
-- PairedPreflightVerified(transaction, proof)
--   Legacy path/schema and independent source/controller preflight was verified.
-- PairedOfflineOwnershipVerified(transaction, ownership)
--   Service teardown and bounded exclusive offline ownership were verified.
-- PairedSnapshotVerified(transaction, snapshot)
--   Context-bound SQLite snapshot integrity was verified after offline ownership.
-- HelperCapacityFailed(transaction, failure)
--   Initial physical allocation failed after handoff but before target stop.
-- PairedFinalizationFinished(transaction, outcome)
--   Both publication and cleanup succeeded durably; failures use separate
--   PairedFinalizationFailed and retain pending.
-- DurablePreparingStatusWritten(transaction)
--   Matching preparation identity/PID is durable before ownership publication.
--   Systemd persists exact staging status with migration_started = false before
--   publishing its claim, under the global operation lock (REQ-PD-027).

-- paired_precommit_autoload_safe(transaction) -> Boolean
--   While preparing, only captured predecessor may be auto-loaded. After helper
--   teardown/quarantine and before candidate commit, no candidate auto-loaded
--   plist exists; verified candidate bootstrap remains private.
-- paired_finalization_diagnostic_is_durable(transaction) -> Boolean
--   A pending finalization records publication/cleanup uncertainty
--   without asserting successful publication or authorizing DB rollback.

rule AcquirePreparationClaim {
    when: DeploymentRequested(transaction)
    requires: transaction.state = preparing
    requires: claim_available(transaction)
    requires: selected_supervisor_artifact_matches_running(transaction)
    requires: transaction.kind != PreparedArtifactDeployment or transaction.backend = launchd
    requires: systemd_operation_lock_held(transaction)
    ensures: DurablePreparingStatusWritten(transaction)
    ensures: DeploymentClaim.created(
        transaction: transaction,
        generation: transaction.claim_generation,
        active: true
    )

    @guidance
        -- Persist preparation owner PID/status before publishing the claim.
}

rule PrepareCandidate {
    when: CandidatePreparationCompleted(transaction)
    requires: transaction.state = preparing
    requires: current_claim_matches(transaction)
    requires: selected_source_is_valid(transaction)
    requires: prepared_artifact_source_is_valid(transaction)
    requires: paired_database_preflight_is_valid(transaction)
    requires: transaction.kind != PreparedArtifactDeployment
        or transaction.paired_lifecycle_observation.kind = PreparedArtifactPreflight
    requires: controller_identity_is_independently_bound(transaction)
    requires: previous_rollback_identity_is_valid(transaction)
    requires: transaction.kind != PreparedArtifactDeployment or transaction.previous != null
    requires: protected_systemd_preflight_valid(transaction)
    requires: systemd_database_admission_valid(transaction)
    requires: selected_supervisor_artifact_matches_running(transaction)
    ensures: transaction.state = prepared
    ensures: preparation_complete(transaction)
    ensures: installed_environment_is_snapshot(transaction)
}

rule RejectConcurrentDeployment {
    when: DeploymentRequested(transaction)
    requires: transaction.state = preparing
    requires: not claim_available(transaction)
    ensures: transaction.state = rejected_concurrent
    ensures: ProductionStateUnchanged(transaction)
    ensures: DurableStatusWritten(transaction)
}

rule PreparationFailureDoesNotDisruptRuntime {
    when: PreparationFailed(transaction, failure)
    requires: transaction.state = preparing
    ensures: transaction.state = precondition_failed
    ensures: transaction.failure = failure
    ensures: ProductionStateUnchanged(transaction)
    ensures: DurableStatusWritten(transaction)
}

rule LaunchdActivationHandedOff {
    when: transaction: DeployTransaction.state transitions_to prepared
    requires: transaction.backend = launchd
    requires: preparation_complete(transaction)
    ensures: LaunchdHandoff.created(
        transaction: transaction,
        manifest_hash: PreparedManifestHash(transaction),
        immutable: true,
        secret_free: true,
        helper_label: PreparedLaunchdHelperLabel(transaction)
    )
    ensures: transaction.state = handed_off
}

rule SystemdActivationHandedOff {
    when: transaction: DeployTransaction.state transitions_to prepared
    requires: transaction.backend = systemd
    requires: preparation_complete(transaction)
    requires: PrivilegedHandoffValidated(transaction)
    requires: systemd_database_admission_valid(transaction)
    ensures: SystemdHandoff.created(
        transaction: transaction,
        manifest_hash: PreparedManifestHash(transaction),
        immutable: true,
        secret_free: true,
        transient_unit: PreparedTransientUnit(transaction),
        root_transaction_id: transaction.id
    )
    ensures: transaction.state = handed_off
}

rule RejectChangedRunningBareSupervisor {
    when: DeploymentRequested(transaction)
    requires: transaction.state = preparing
    requires: transaction.backend = bare_linux
    requires: BareSupervisorRunning(transaction)
    requires: not selected_supervisor_artifact_matches_running(transaction)
    ensures: ProductionStateUnchanged(transaction)
    ensures: BareSupervisorRemainsRunning(transaction)
    ensures: DeploymentRequestRejectedBeforeTransaction(transaction)
}

rule BareLinuxActivationHandedOff {
    when: transaction: DeployTransaction.state transitions_to prepared
    requires: transaction.backend = bare_linux
    requires: preparation_complete(transaction)
    requires: selected_supervisor_artifact_matches_running(transaction)
    requires: SupervisorPeerUidMatchesOwner(transaction)
    ensures: BareLinuxHandoff.created(
        transaction: transaction,
        manifest_hash: PreparedManifestHash(transaction),
        immutable: true,
        secret_free: true,
        supervisor_socket_identity: PreparedSupervisorSocket(transaction)
    )
    ensures: transaction.state = handed_off
}

rule ObservePreparedPreflight {
    when: PairedPreflightVerified(transaction, proof)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state = preparing
    requires: transaction.paired_lifecycle_observation.kind = PreparedArtifactAwaitingPreparation
    ensures: transaction.paired_lifecycle_observation = PreparedArtifactPreflight.created(
        prepared_artifact_proof: proof
    )
}

rule ObserveOfflineOwnership {
    when: PairedOfflineOwnershipVerified(transaction, ownership)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state = activating
    requires: transaction.paired_lifecycle_observation.kind = PreparedArtifactPreflight
    ensures: transaction.paired_lifecycle_observation = PreparedArtifactOfflineOwned.created(
        prepared_artifact_proof: transaction.paired_lifecycle_observation.prepared_artifact_proof,
        offline_ownership_proof: ownership
    )
}

rule ObserveSnapshotProof {
    when: PairedSnapshotVerified(transaction, snapshot)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state = activating
    requires: transaction.paired_lifecycle_observation.kind = PreparedArtifactOfflineOwned
    ensures: transaction.paired_lifecycle_observation = PreparedArtifactSnapshotVerified.created(
        prepared_artifact_proof: transaction.paired_lifecycle_observation.prepared_artifact_proof,
        offline_ownership_proof: transaction.paired_lifecycle_observation.offline_ownership_proof,
        snapshot_integrity_proof: snapshot
    )
    ensures: PairedSnapshotProofPersisted(transaction)
}

rule ReserveHelperCapacity {
    when: HelperCapacityVerified(transaction)
    requires: transaction.state = handed_off
    requires: current_claim_matches(transaction)
    ensures: helper_capacity_reserved(transaction)
    ensures: HelperCapacityReserved(transaction)
}

rule HelperCapacityFailureBeforeStop {
    when: HelperCapacityFailed(transaction, failure)
    requires: transaction.state in { handed_off, activating }
    requires: pre_stop_capacity_cleanup_durable(transaction)
    ensures: transaction.state = precondition_failed
    ensures: transaction.failure = failure
    ensures: ProductionStateUnchanged(transaction)
    ensures: DurableStatusWritten(transaction)
}

-- admitted_handoff_is_valid(transaction) -> Boolean
--   Stored immutable handoff is valid for backend and independent owner;
--   capacity observation is earned only by that admitted transaction/owner.

rule IndependentOwnerBeginsActivation {
    when: HelperCapacityReserved(transaction)
    requires: helper_capacity_reserved(transaction)
    requires: transaction.state = handed_off
    requires: current_claim_matches(transaction)
    requires: admitted_handoff_is_valid(transaction)
    requires: preparation_complete(transaction)
    ensures: transaction.state = activating
}

-- PairedSnapshotProofPersisted(transaction)
--   The verified context-bound snapshot proof was atomically written and fsynced.

rule PreservePreStopCleanupUncertainty {
    when: PreStopCleanupUncertain(transaction, failure)
    requires: transaction.state in { handed_off, activating }
    requires: current_claim_matches(transaction)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.backend = launchd
    requires: pre_stop_cleanup_uncertain(transaction)
    ensures: transaction.state = precondition_cleanup_pending
    ensures: transaction.failure = failure
    ensures: active_claim_retained(transaction)
    ensures: ProductionStateUnchanged(transaction)
    ensures: DurableStatusWritten(transaction)
}

rule RetryPreStopCleanupOnly {
    when: PreStopCleanupRetryRequested(transaction)
    requires: transaction.state = precondition_cleanup_pending
    requires: pre_stop_cleanup_retry_context_is_valid(transaction)
    requires: current_claim_matches(transaction)
    ensures: PreStopCleanupFilesRemovedAndParentsSynced(transaction)
    ensures: pre_stop_capacity_cleanup_durable(transaction)
    ensures: transaction.state = precondition_failed
    ensures: DurableStatusWritten(transaction)

    @guidance
        -- Remove only transaction-owned unsnapshotted reservation/evidence files
        -- and fsync their parents. Persist terminal status before releasing only
        -- the matching claim. Never stop/start/inspect runtime, touch DB contents,
        -- production plist/binary, perform snapshot recovery, or use
        -- recover-current/paired.
        -- Those recovery commands refuse this state without rewriting it.
        -- Markerless pending status fences deploy/restart/stop. Invalid helper
        -- identity cannot request bootout; only the exact transaction-derived
        -- deployment-helper label may be booted out.
}

rule PreserveFailedPreStopCleanupRetry {
    when: PreStopCleanupRetryFailed(transaction, failure)
    requires: transaction.state = precondition_cleanup_pending
    requires: current_claim_matches(transaction)
    ensures: transaction.state = precondition_cleanup_pending
    ensures: transaction.failure = failure
    ensures: active_claim_retained(transaction)
}

rule CandidateStartupPrepared {
    when: CandidateStartupReady(transaction)
    requires: transaction.state = activating
    requires: current_claim_matches(transaction)
    requires: candidate_startup_proof_is_valid(transaction)
    requires: transaction.kind != PreparedArtifactDeployment
        or transaction.paired_lifecycle_observation.kind = PreparedArtifactSnapshotVerified
    requires: transaction.kind != PreparedArtifactDeployment or snapshot_proof_durable(transaction)
    ensures: atomic_install_complete(transaction)
}

rule VerifyOrdinaryAbandonedPreparation {
    when: OperatorVerifiedOrdinaryPreparationAbandoned(transaction)
    requires: transaction.kind != PreparedArtifactDeployment
    requires: transaction.state = preparing
    requires: ordinary_preparation_abandonment_verified(transaction)
    requires: transaction.backend != systemd
    ensures: transaction.state = precondition_failed
    ensures: DurableStatusWritten(transaction)

    @guidance
        -- Existing operator/manual stale-claim disposition only: confirm recorded
        -- preparer dead, exact claim and no admitted helper; no automated DB recovery
        -- or new ordinary recovery command. Terminal matching release follows.
}

-- ordinary_preparation_abandonment_verified(transaction) -> Boolean
--   Operator verified matching ordinary preparation claim, dead preparer, no
--   activation handoff/helper, and unchanged runtime; unknown remains fenced.

rule AbandonInterruptedPreparation {
    when: PreparedAbandonmentVerified(transaction)
    requires: transaction.state in { preparing, prepared, handed_off }
    requires: transaction.kind = PreparedArtifactDeployment
    requires: pre_manifest_abandonment_verified(transaction)
    ensures: transaction.state = precondition_failed
    ensures: DurableStatusWritten(transaction)

    @guidance
        -- Release only the matching claim after terminal status; runtime/database
        -- remain untouched. Missing evidence or a live/reused PID refuses recovery.
}

rule CommitVerifiedCandidate {
    when: CandidateRuntimeObserved(transaction)
    requires: transaction.state = activating
    requires: current_claim_matches(transaction)
    requires: exact_candidate_running(transaction)
    requires: candidate_startup_proof_is_valid(transaction)
    requires: atomic_install_complete(transaction)
    ensures: transaction.state = committed
    ensures: transaction.kind = PreparedArtifactDeployment implies transaction.finalization = pending
    ensures: protected_systemd_deployment(transaction) implies ProtectedSystemdRetained(transaction)
    ensures: DeployedShaWritten(transaction.source_commit)
    ensures: DurableStatusWritten(transaction)

    @guidance
        -- Persist pending publication/cleanup diagnostic with durable commit.
        -- For paired launchd, after durable commit release only the temporary
        -- restore reservation and fsync its parent; retain audit snapshot/proof.
        -- Publish the prepared candidate plist last. Publication/cleanup errors
        -- remain committed diagnostics, do not authorize rollback, and do not
        -- establish login/reboot persistence when publication is unconfirmed.
}

rule ResumeCommittedPairedFinalization {
    when: PairedFinalizationRequested(transaction)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state = committed
    requires: transaction.finalization = pending
    requires: committed_finalization_context_is_valid(transaction)
    ensures: PairedFinalizationAttemptsResumed(transaction)

    @guidance
        -- Explicit finalize-paired verifies retained byte-bound helper, matching
        -- claim, helper absence, running exact candidate/binary/private loaded
        -- configuration and mutual exclusion. Retry only plist publication and
        -- temporary restore reservation cleanup; no stop/bootstrap/restart/DB IO.
        -- Pending survives interruption; durable completion releases owned claim.
}

-- committed_finalization_context_is_valid(transaction) -> Boolean
--   Exact retained transaction/helper/claim, absent prior helper, matching running
--   committed binary/config/identity and exclusive operation lock; unknown rejects.
-- PairedFinalizationRequested(transaction)
--   Operator invoked prod finalize-paired for a retained committed transaction.
-- PairedFinalizationAttemptsResumed(transaction)
--   Publication/cleanup attempts resumed without any runtime/database mutation.

rule PreserveFailedPairedFinalization {
    when: PairedFinalizationFailed(transaction, diagnostic)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state = committed
    requires: transaction.finalization = pending
    ensures: transaction.finalization = pending
    ensures: CommittedFinalizationDiagnosticWritten(transaction, diagnostic)
    ensures: DurableStatusWritten(transaction)
}

rule VerifyCompletedPairedFinalization {
    when: PairedFinalizationRequested(transaction)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state = committed
    requires: transaction.finalization = complete
    requires: completed_finalization_context_is_valid(transaction)
    ensures: transaction.finalization = complete
    ensures: IdempotentFinalizationConfirmed(transaction)

    @guidance
        -- Verify same retained candidate/binary/private configuration and published
        -- inode with absent prior helper, no competing claim. No mutation on rerun.
}

-- completed_finalization_context_is_valid(transaction) -> Boolean
--   Exact candidate/configuration and completed published inode, helper absent,
--   no competing claim; does not require an already released active claim.

rule RecordPairedFinalizationOutcome {
    when: PairedFinalizationFinished(transaction, outcome)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state = committed
    requires: transaction.finalization = pending
    requires: outcome = complete
    ensures: transaction.finalization = outcome
    ensures: DurableStatusWritten(transaction)

    @guidance
        -- Clear pending only after both publication and cleanup succeed durably.
        -- Errors remain committed diagnostics; interruption retains pending and claim.
}

rule RollBackFailedOrdinaryActivation {
    when: ActivationFailed(transaction, failure)
    requires: transaction.state = activating
    requires: transaction.kind != PreparedArtifactDeployment
    requires: not protected_systemd_deployment(transaction)
    requires: current_claim_matches(transaction)
    requires: exact_previous_restored(transaction)
    ensures: transaction.state = activation_failed_rolled_back
    ensures: transaction.failure = failure
    ensures: DurableStatusWritten(transaction)
    ensures: RuntimeArtifactRollbackRecorded(transaction)
    ensures: not DatabaseRollbackClaimed(transaction)
    ensures: not DeployedShaWritten(transaction.source_commit)
}

-- predecessor_publication_durable(transaction) -> Boolean
--   Captured predecessor plist publication and deployed identity writes are
--   durable after verified startup; failure retains running verified predecessor
--   and retryable claim without teardown or database replay.

rule CheckpointAuthorizedPredecessorStartup {
    when: PredecessorRecoveryPrepared(transaction, mode)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state in { activating, activation_failed_rollback_failed }
    requires: transaction.recovery_mode = null
    requires: predecessor_start_authorized(transaction)
    requires: mode = snapshot_restored implies paired_snapshot_restored(transaction)
    requires: mode = unchanged_predecessor implies paired_unchanged_predecessor_verified(transaction)
    ensures: transaction.recovery_mode = mode
    ensures: DurableStatusWritten(transaction)

    @guidance
        -- Persist typed snapshot-restored or unchanged-predecessor checkpoint
        -- BEFORE bootstrap. Once set, any retry must not restore snapshot again.
        -- Private predecessor startup is authorized only after durable checkpoint.
}

rule VerifyCheckpointedPredecessor {
    when: CheckpointRecoveryRequested(transaction)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state in { activating, activation_failed_rollback_failed, activation_failed_rolled_back }
    requires: current_claim_matches(transaction)
    requires: transaction.recovery_mode != null
    requires: checkpointed_predecessor_running_verified(transaction)
    ensures: PairedRecoveryVerified(transaction, transaction.recovery_mode)

    @guidance
        -- Verify running predecessor/private loaded configuration and identity,
        -- finalize publication/status only. Never stop or replay database snapshot.
        -- Unknown/stopped predecessor remains fenced for operator investigation.
}

-- checkpointed_predecessor_running_verified(transaction) -> Boolean
--   Exact captured predecessor binary/private loaded plist and runtime identity
--   are verified after the durable startup checkpoint without database replay.

rule RollBackFailedPreparedPairedActivation {
    when: ActivationFailed(transaction, failure)
    requires: transaction.state = activating
    requires: transaction.kind = PreparedArtifactDeployment
    requires: current_claim_matches(transaction)
    requires: paired_recovery_succeeded(transaction)
    requires: paired_predecessor_start_order_is_valid(transaction)
    requires: supported_recovery_verified(transaction)
    requires: predecessor_publication_durable(transaction)
    requires: transaction.recovery_mode != null
    ensures: transaction.state = activation_failed_rolled_back
    ensures: transaction.failure = failure
    ensures: DurableStatusWritten(transaction)
    ensures: RuntimeArtifactRollbackRecorded(transaction)
    requires: paired_snapshot_restored(transaction) implies transaction.recovery_mode = snapshot_restored
    requires: paired_unchanged_predecessor_verified(transaction) implies transaction.recovery_mode = unchanged_predecessor
    ensures: paired_snapshot_restored(transaction) implies DatabaseRollbackCompleted(transaction)
    ensures: paired_unchanged_predecessor_verified(transaction) implies not DatabaseRollbackClaimed(transaction)
    ensures: not DeployedShaWritten(transaction.source_commit)

    @guidance
        -- After verified unchanged no-snapshot resume and durable terminal status,
        -- release only temporary backup seed and DB-adjacent restore allocation.
        -- Never remove a verified snapshot/proof. Cleanup failure is diagnostic
        -- and does not tear down an already verified predecessor.
}

rule PreserveRollbackFailure {
    when: RollbackFailed(transaction, failure, rollback_failure)
    requires: transaction.state = activating
    requires: not protected_systemd_deployment(transaction)
    requires: current_claim_matches(transaction)
    ensures: transaction.kind = PreparedArtifactDeployment implies transaction.state = activation_failed_rollback_failed
    ensures: transaction.kind != PreparedArtifactDeployment implies transaction.state = ordinary_activation_failed_rollback_failed
    ensures: transaction.failure = failure
    ensures: transaction.rollback_failure = rollback_failure
    ensures: DurableStatusWritten(transaction)
    ensures: not DeployedShaWritten(transaction.source_commit)
}

rule RecoverRetainedPairedTransaction {
    when: PairedRecoveryVerified(transaction, mode)
    requires: transaction.state in { prepared, activating, activation_failed_rollback_failed, activation_failed_rolled_back }
    requires: transaction.kind = PreparedArtifactDeployment
    requires: current_claim_matches(transaction)
    requires: supported_recovery_verified(transaction)
    requires: predecessor_publication_durable(transaction)
    ensures: transaction.state = activation_failed_rolled_back
    requires: mode = snapshot_restored implies paired_snapshot_restored(transaction)
    requires: mode = unchanged_predecessor implies paired_unchanged_predecessor_verified(transaction)
    requires: mode = transaction.recovery_mode
    ensures: transaction.recovery_mode = mode
    ensures: mode = snapshot_restored implies DatabaseRollbackCompleted(transaction)
    ensures: mode = unchanged_predecessor implies not DatabaseRollbackClaimed(transaction)
    ensures: DurableStatusWritten(transaction)
}

rule PreservePreparedRecoveryFailure {
    when: RollbackFailed(transaction, failure, rollback_failure)
    requires: transaction.state in { prepared, activating, activation_failed_rollback_failed }
    requires: transaction.kind = PreparedArtifactDeployment
    requires: current_claim_matches(transaction)
    ensures: transaction.state = activation_failed_rollback_failed
    ensures: candidate_teardown_attempted(transaction)
    ensures: paired_transaction_retained(transaction)
    ensures: recovery_verification_unconfirmed(transaction)
    ensures: active_claim_retained(transaction)
}

-- Protected systemd helpers (REQ-PD-023–029 / REQ-COMP-014, REQ-COMP-016)
-- protected_systemd_deployment(transaction) -> Boolean
--   True only for ProtectedSystemdReleaseDeployment or
--   ProtectedSystemdPreparedDeployment.
-- protected_systemd_preflight_valid(transaction) -> Boolean
--   True for other kinds. ProtectedSystemdReleaseDeployment requires systemd on
--   Linux x86_64 and the exact published tag/version/full commit/asset/hash/registry
--   bytes in REQ-PD-023. ProtectedSystemdPreparedDeployment instead requires the
--   exact candidate, Linux target, closed receipt/payload hashes and registry bytes
--   in REQ-PD-029, with receipt controller identity equal to the independently
--   selected different controller commit/helper hash and no release evidence.
--   Both require complete ordered registry prefix through65, existing predecessor,
--   preserved installed env/service/socket/canonical DB path and absent live marker.
--   Root staging binds both retained health URLs to exactly one preserved TCP
--   ListenStream: bare port (IPv6), IPv4/bracketed IPv6 wildcard, or explicit
--   loopback. It maps wildcard to same-family loopback, preserves explicit
--   loopback, brackets IPv6 URL hosts, and requires port1..65535 plus equality
--   with PHOENIX_PORT if present. Unix/hostname/non-loopback/multiple/other
--   listeners, ranges and unsupported syntax reject before inhibit/stop/marker.
--   Only exact Unit/Socket/Install sections are admitted, without repeats;
--   Socket keys are exactly ListenStream/NoDelay/Backlog/BindIPv6Only.
--   Accept/BindToDevice and all other Socket options reject.
--   Scheme follows pinned ConfigSource::from_env: both cert/key paths select
--   manual HTTPS regardless of mode; one path rejects; no paths admit trimmed
--   case-insensitive empty/0/false/off/none as HTTP and 1/true/on/auto as auto
--   HTTPS only. Manual-without-paths and unknown modes reject. Manual paths
--   must be absolute regular files with no symlink or parent-directory traversal
--   at root staging. Resolve service uid plus primary/supplementary groups;
--   require mode-based execute on every ancestor and read on both files,
--   admitting root permission bypass; unresolved identities or denied modes reject.
--   CA_CERT_PATH has meaning only with the manual pair. If present, its path
--   must meet the same file/traversal/service-readability rules. load_cert_chain
--   proves cert/key parsing and matching; load_verify_locations parses the CA;
--   CA is exactly one PEM certificate within 32 KiB, with CA Basic Constraints
--   and certificate-signing Key Usage if present. Resolved/probed openssl x509
--   inspects capabilities; verify -trusted CA -partial_chain -untrusted CERT
--   -purpose sslserver CERT admits supplied intermediates, never ambient roots.
--   Missing/unreadable/invalid/unrelated CA or unavailable openssl rejects before
--   staging completes or inhibit/stop/marker. No alternate CA authority is stored.
--   Resolve/probe exact executable lsof before inhibit/stop; exclusivity uses
--   that path, not another PATH lookup. Dependency failure is precondition_failed
--   without inhibit/stop/claim leak. Persist captured predecessor unit state,
--   bound to the transaction, before durable activating. A crash before this
--   publication leaves prepared ownership without inhibit/stop/marker: only
--   validated prepared abandonment, never guessed restoration, may release it.
-- systemd_database_admission_valid(transaction) -> Boolean
--   True for other backends. Protected mode requires its exact source proof;
--   ordinary mode derives the target by running the exact candidate --migrate-only
--   on an isolated empty DB with isolated HOME/DB path, not by parsing source.
--   Successful exit, integrity/FK, nonempty sorted unique full ledger and unchanged
--   candidate hash are required. Existing production DB must pass integrity/FK
--   and match that complete target; failure/pending/divergence rejects before
--   handoff. Missing configured DB plus any installed predecessor binary/env/
--   service/socket/deployed identity artifact or runtime identity rejects before
--   handoff, including unavailable mounts and unlinked open DBs. The helper
--   mirrors this for captured predecessor/rollback artifacts. Only a true first
--   install with no predecessor evidence may omit DB/target derivation.
--   This controller-side gate leaves the protocol-v1 ordinary helper manifest
--   unchanged; REQ-PD-026 does not qualify historical controllers lacking it.
-- systemd_operation_lock_held(transaction) -> Boolean
--   True for other backends. Systemd holds the global operation lock across
--   staging, activation or recovery; a competing operation cannot mutate state.
-- protected_systemd_start_inhibit_valid(transaction) -> Boolean
--   Transaction-bound persistent service AND socket drop-ins are fsynced,
--   systemd reloaded, file ownership/mode/content/paths and effective loaded
--   configuration verified before either unit is stopped. Manual, dependency,
--   socket and reboot activation remain inhibited through disrupted pre-marker
--   and unresolved post-marker states. Tamper/foreign/unsafe evidence fails closed.
-- protected_systemd_inhibit_disposition_valid(transaction) -> Boolean
--   Before disruption, no inhibit is required; once disruption begins, the
--   inhibit remains intact, or its verified transaction-owned drop-ins were
--   durably removed with reload/config verification only after authorized
--   pre-marker unchanged-predecessor artifact restoration and before restart,
--   or immediately before exclusively verified exact-target candidate start.
--   Unsafe/missing/foreign inhibit evidence never authorizes removal/start;
--   unresolved failure retains the claim and attempts inhibit retention/
--   reinstallation and both-unit stop rather than claiming confirmed safety.
-- protected_systemd_marker_present(transaction) -> Boolean
--   Transaction live migration_started marker exists, including unsafe/symlink
--   evidence or uncertain marker durability; presence selects the forward path,
--   not permission to trust its contents. No separate migration_started state.
-- protected_systemd_backup_valid(transaction) -> Boolean
--   Persistent fsynced pristine SQLite backup has verified integrity/FK, hash and
--   transaction-bound proof of the exclusive stopped source ledger/logical contents
--   after both units were inactive and no DB/WAL/SHM users remained.
-- protected_systemd_rehearsal_valid(transaction) -> Boolean
--   Exact candidate --migrate-only succeeded against an isolated backup copy;
--   exact complete target ledger, integrity/FK, and unchanged pristine backup
--   verified with durable transaction/candidate/registry/backup-bound proof.
-- protected_systemd_live_ready(transaction) -> Boolean
--   No live marker; backup/rehearsal proofs, start inhibit and immutable evidence
--   re-verified, installed exact candidate and preserved config verified,
--   both units inactive and stopped exclusive source unchanged.
-- protected_systemd_target_valid(transaction) -> Boolean
--   Live ledger equals the entire exact registry; integrity/FK checks pass;
--   pristine backup and evidence remain intact, installed configuration preserved.
-- protected_systemd_unchanged_predecessor_valid(transaction) -> Boolean
--   No irreversible marker; exact active protected transaction with durable
--   activating or activation_failed_rollback_failed, migration_started=false,
--   intact matching inhibits and transaction-bound captured predecessor unit
--   state. Retained manifest/controller/helper/rollback hashes and predecessor
--   identity/config valid. Stop both units; resolve/probe lsof after stop;
--   unavailable dependency stays stopped/fenced. Exclusive live DB integrity/FK
--   and exact source-prefix65 are required. Before a stopped snapshot exists,
--   normal pre-stop data writes are allowed; no stale preflight digest equality.
--   Any present snapshot evidence must be complete/valid and its logical digest
--   must equal live data. No snapshot replay. Prepared/no-disruption refuses;
--   ambiguous/malformed evidence stays fenced. Failed restore retains fence.
-- protected_systemd_recovery_valid(transaction) -> Boolean
--   Explicit recover-systemd-current request; exact retained candidate/controller/
--   helper, matching claim and valid durable marker, intact inhibit and
--   backup/rehearsal proofs, preserved configuration, exclusive inactive
--   service/socket with no DB/WAL/SHM users, complete ledger
--   exactly a same-registry prefix through65..128. No substitutions or restore.
-- systemd_staging_retirement_valid(transaction) -> Boolean
--   Global lock excludes a live stager/activator; exact staging status shape has
--   migration_started=false, exact owner/claim or no claim, absent irreversible
--   marker, no prepared handoff. Ambiguous/prepared/post-marker stays fenced.
-- ProtectedSystemdBackupVerified(transaction), ProtectedSystemdRehearsalVerified(transaction)
--   Corresponding offline proof has been durably verified by the independent owner.
-- ProtectedSystemdLiveMigrationRequested(transaction)
--   Independent owner is ready to cross the live migration boundary.
-- ProtectedSystemdTargetVerified(transaction)
--   Exact live target ledger and integrity/FK verified before candidate startup.
-- ProtectedSystemdRecoveryRequested(transaction)
--   Operator explicitly requests recover-systemd-current (helper recover-current).
--   Marker presence selects this path. Both units must be stopped/proven inactive
--   before detailed manifest/inhibit/marker/evidence/DB validation; then exclusive
--   ownership and protected_systemd_recovery_valid are required. Required lsof
--   is preflighted only after both-unit stop; missing/unusable stays stopped.
--   Marker absence selects validated pre-marker predecessor recovery under
--   protected_systemd_unchanged_predecessor_valid, never forward migration.
-- ProtectedSystemdUnchangedPredecessorObserved(transaction)
--   Authorized pre-marker unchanged predecessor was restored and verified.
-- ProtectedSystemdRetained(transaction)
--   Exact candidate, backup and proofs retained; no backup or predecessor replay.
-- ProtectedSystemdMarkerPersisted(transaction)
--   Transaction-bound migration_started file fsynced before live invocation;
--   durable status remains activating with migration_started boolean true.
-- ProtectedSystemdCandidateMigrationInvoked(transaction)
--   Only the exact installed candidate runs --migrate-only against the live DB.
-- SystemdPartialStagingRetirementRequested(transaction)
--   Stale partial staging disposition requested under the global operation lock.
-- SystemdPartialStagingRetired(transaction)
--   Only matching partial inputs/ownership removed, affected directories fsynced;
--   no production mutation. This is not prepared or post-marker abandonment.

rule ProtectedSystemdBackup {
    when: ProtectedSystemdBackupVerified(transaction)
    requires: protected_systemd_deployment(transaction)
    requires: transaction.state = activating
    requires: not protected_systemd_marker_present(transaction)
    requires: protected_systemd_start_inhibit_valid(transaction)
    requires: current_claim_matches(transaction)
    requires: systemd_operation_lock_held(transaction)
    ensures: protected_systemd_backup_valid(transaction)

    @guidance
        -- Install/fsync/reload/verify both persistent unit inhibits before stop;
        -- prove service/socket inactivity and exclusive DB ownership before backup.
        -- Bind exact stopped-source evidence including writes since preflight;
        -- without a snapshot only exact ledger/integrity/FK governs admission;
        -- a completed stopped snapshot adds logical equality as recovery authority.
}

rule ProtectedSystemdRehearsal {
    when: ProtectedSystemdRehearsalVerified(transaction)
    requires: protected_systemd_deployment(transaction)
    requires: transaction.state = activating
    requires: not protected_systemd_marker_present(transaction)
    requires: protected_systemd_start_inhibit_valid(transaction)
    requires: protected_systemd_backup_valid(transaction)
    requires: current_claim_matches(transaction)
    requires: systemd_operation_lock_held(transaction)
    ensures: protected_systemd_rehearsal_valid(transaction)
}

rule ProtectedSystemdCrossLiveBoundary {
    when: ProtectedSystemdLiveMigrationRequested(transaction)
    requires: protected_systemd_deployment(transaction)
    requires: transaction.state = activating
    requires: not protected_systemd_marker_present(transaction)
    requires: protected_systemd_start_inhibit_valid(transaction)
    requires: protected_systemd_backup_valid(transaction)
    requires: protected_systemd_rehearsal_valid(transaction)
    requires: current_claim_matches(transaction)
    requires: systemd_operation_lock_held(transaction)
    requires: protected_systemd_live_ready(transaction)
    ensures: transaction.state = activating
    ensures: protected_systemd_marker_present(transaction)
    ensures: ProtectedSystemdMarkerPersisted(transaction)
    ensures: ProtectedSystemdCandidateMigrationInvoked(transaction)

    @guidance
        -- Persist/fsync migration_started immediately before first LIVE candidate
        -- invocation. Rehearsal never crosses this boundary. Marker durability
        -- uncertainty cannot authorize predecessor recovery or backup replay.
}

rule ProtectedSystemdVerifyTarget {
    when: ProtectedSystemdTargetVerified(transaction)
    requires: protected_systemd_deployment(transaction)
    requires: transaction.state = activating
    requires: protected_systemd_marker_present(transaction)
    requires: protected_systemd_start_inhibit_valid(transaction)
    ensures: protected_systemd_target_valid(transaction)
}

rule ProtectedSystemdInterruptedPreMarkerRecovery {
    when: ProtectedSystemdRecoveryRequested(transaction)
    requires: protected_systemd_deployment(transaction)
    requires: transaction.state in { activating, activation_failed_rollback_failed }
    requires: not protected_systemd_marker_present(transaction)
    requires: current_claim_matches(transaction)
    requires: systemd_operation_lock_held(transaction)
    requires: protected_systemd_unchanged_predecessor_valid(transaction)
    ensures: exact_previous_restored(transaction)
    ensures: transaction.state = activation_failed_rolled_back
    ensures: not DatabaseRollbackClaimed(transaction)
    ensures: DurableStatusWritten(transaction)
    ensures: ClaimReleasedFor(transaction)

    @guidance
        -- Restore and verify captured predecessor binary/config while inhibited.
        -- Remove only exact matching inhibits and reload/verify preserved config;
        -- restore/verify captured active/enabled state and applicable identity.
        -- Write durable terminal rollback status before releasing exact claim.
        -- Backup and isolated rehearsal remain evidence, never replay sources.
}

rule ProtectedSystemdPreMarkerRecovery {
    when: ProtectedSystemdUnchangedPredecessorObserved(transaction)
    requires: protected_systemd_deployment(transaction)
    requires: transaction.state = activating
    requires: not protected_systemd_marker_present(transaction)
    requires: current_claim_matches(transaction)
    requires: systemd_operation_lock_held(transaction)
    requires: protected_systemd_unchanged_predecessor_valid(transaction)
    requires: exact_previous_restored(transaction)
    ensures: transaction.state = activation_failed_rolled_back
    ensures: not DatabaseRollbackClaimed(transaction)
    ensures: DurableStatusWritten(transaction)

    @guidance
        -- Backup/rehearsal capacity or verification failures stay pre-marker;
        -- restore runtime artifacts only after unchanged-source proof. Never
        -- replay backup to obtain that proof. Verify/remove only the matching
        -- persistent inhibits after artifact restoration and before predecessor
        -- restart; reload systemd and verify preserved configuration. Inhibit
        -- tamper fails closed. No launchd 20 GiB floor applies.
}

rule ProtectedSystemdUnprovenPreMarkerRecovery {
    when: RollbackFailed(transaction, failure, rollback_failure)
    requires: protected_systemd_deployment(transaction)
    requires: transaction.state = activating
    requires: not protected_systemd_marker_present(transaction)
    requires: current_claim_matches(transaction)
    ensures: transaction.state = activation_failed_rollback_failed
    ensures: transaction.failure = failure
    ensures: transaction.rollback_failure = rollback_failure
    ensures: candidate_teardown_attempted(transaction)
    ensures: protected_systemd_inhibit_disposition_valid(transaction)
    ensures: active_claim_retained(transaction)
    ensures: DurableStatusWritten(transaction)
}

rule ProtectedSystemdPostMarkerFailure {
    when: ActivationFailed(transaction, failure)
    requires: protected_systemd_deployment(transaction)
    requires: transaction.state = activating
    requires: protected_systemd_marker_present(transaction)
    requires: current_claim_matches(transaction)
    ensures: transaction.state = current_forward_failed
    ensures: transaction.failure = failure
    ensures: candidate_teardown_attempted(transaction)
    ensures: ProtectedSystemdRetained(transaction)
    ensures: active_claim_retained(transaction)
    ensures: DurableStatusWritten(transaction)
}

rule ProtectedSystemdForwardRecovery {
    when: ProtectedSystemdRecoveryRequested(transaction)
    requires: protected_systemd_deployment(transaction)
    requires: transaction.state in { activating, current_forward_failed }
    requires: protected_systemd_marker_present(transaction)
    requires: current_claim_matches(transaction)
    requires: systemd_operation_lock_held(transaction)
    requires: protected_systemd_recovery_valid(transaction)
    ensures: transaction.state = activating
    ensures: protected_systemd_marker_present(transaction)
    ensures: DurableStatusWritten(transaction)
    ensures: ProtectedSystemdRetained(transaction)

    @guidance
        -- Select by marker presence; stop BOTH units and prove inactivity before
        -- detailed post-marker validation, even if retained evidence is invalid.
        -- Then verify inhibit/evidence and exclusive DB ownership. Validation
        -- failure attempts persistent inhibit retention/reinstallation and stop.
        -- After detailed retained-evidence and stopped-ledger admission, durably
        -- write activating with migration_started=true before either migration
        -- rerun or exact-target candidate startup authorization.
        -- Rerun only the exact retained candidate on a same-registry prefix
        -- through65..128; at exact target, skip rerun and verify target. Then
        -- Remove matching persistent inhibits only immediately before exclusively
        -- verified exact-target candidate startup; reload and verify config.
        -- Then candidate-only startup, exact identity, durable publication/commit.
        -- Any unresolved failure keeps claim/evidence/backup and attempts stop
        -- of BOTH service and socket. Never restore or start predecessor.
}

rule RetireSystemdPartialStaging {
    when: SystemdPartialStagingRetirementRequested(transaction)
    requires: transaction.backend = systemd
    requires: transaction.state = preparing
    requires: systemd_operation_lock_held(transaction)
    requires: systemd_staging_retirement_valid(transaction)
    ensures: SystemdPartialStagingRetired(transaction)
    ensures: ProductionStateUnchanged(transaction)
}

invariant ProtectedSystemdIsOneExactTransition {
    for transaction in DeployTransactions:
        protected_systemd_deployment(transaction)
        and transaction.state not in { preparing, precondition_failed, rejected_concurrent } implies
            transaction.backend = systemd and transaction.previous != null
}

invariant ProtectedSystemdMarkerForbidsRollback {
    for transaction in DeployTransactions:
        protected_systemd_deployment(transaction)
        and protected_systemd_marker_present(transaction) implies
            not DatabaseRollbackCompleted(transaction)
            and not RuntimeArtifactRollbackRecorded(transaction)
            and not transaction.state = activation_failed_rolled_back
}

invariant ProtectedSystemdPersistentInhibit {
    for transaction in DeployTransactions:
        protected_systemd_deployment(transaction) implies
            protected_systemd_inhibit_disposition_valid(transaction)
}

invariant ProtectedSystemdCommitRetainsPristineBackup {
    for transaction in DeployTransactions:
        protected_systemd_deployment(transaction)
        and transaction.state = committed implies
            protected_systemd_marker_present(transaction)
            and protected_systemd_target_valid(transaction)
            and ProtectedSystemdRetained(transaction)
}

rule MatchingTerminalClaimReleased {
    when: TerminalStatusPersisted(transaction, claim)
    requires: claim.active
    requires: claim.transaction = transaction
    requires: claim.generation = transaction.claim_generation
    requires: durable_terminal_status_exists(transaction)
    requires: transaction.state in { committed, precondition_failed, activation_failed_rolled_back, ordinary_activation_failed_rollback_failed }
    requires: transaction.state != ordinary_activation_failed_rollback_failed
        or transaction.backend = launchd
    requires: transaction.kind != PreparedArtifactDeployment
        or transaction.state != activation_failed_rolled_back
        or supported_recovery_verified(transaction)
    requires: transaction.kind != PreparedArtifactDeployment
        or transaction.state != committed
        or transaction.finalization = complete
    ensures: claim.active = false
}

rule StaleClaimReleaseRejected {
    when: ClaimReleaseRequested(transaction, claim)
    requires: claim.transaction != transaction
        or claim.generation != transaction.claim_generation
        or not durable_terminal_status_exists(transaction)
    ensures: claim.active = true
}

rule InterruptedTransactionRemainsActionable {
    when: DeploymentStatusRequested(transaction)
    requires: transaction.state in { preparing, prepared, handed_off, precondition_cleanup_pending, activating, current_forward_failed }
    requires: now() - transaction.updated_at > config.stale_after
    ensures: RecoveryGuidanceShown(transaction)
    ensures: not transaction.state = committed
}

rule BareSupervisorReconcilesInterruptedActivation {
    when: BareSupervisorStarted(transaction)
    requires: transaction.backend = bare_linux
    requires: transaction.state in { handed_off, activating }
    ensures: InstalledStateInspected(transaction)
    ensures: ReconciliationRequiredBeforeTerminalStatus(transaction)
}

rule BareStopPreservesSupervisor {
    when: ProductionStopRequested(transaction)
    requires: transaction.backend = bare_linux
    ensures: ManagedPhoenixChildStopped(transaction)
    ensures: BareSupervisorRemainsRunning(transaction)
}

invariant CandidateIdentityIsFullAndExact {
    for transaction in DeployTransactions:
        transaction.state in { prepared, handed_off, activating, committed } implies
            selected_source_is_valid(transaction)
}

invariant LegacyIdentityIsRollbackOnly {
    for transaction in DeployTransactions:
        transaction.previous != null implies
            previous_rollback_identity_is_valid(transaction)
}

invariant OrdinaryRollbackIsRuntimeOnly {
    for transaction in DeployTransactions:
        transaction.kind != PreparedArtifactDeployment
        and transaction.state = activation_failed_rolled_back implies
            RuntimeArtifactRollbackRecorded(transaction)
            and not DatabaseRollbackClaimed(transaction)
}

invariant PairedUnresolvedFailureAutoloadFence {
    for transaction in DeployTransactions:
        transaction.kind = PreparedArtifactDeployment
        and transaction.state = activation_failed_rollback_failed implies
            paired_unresolved_autoload_quarantined(transaction)
}

-- paired_unresolved_autoload_quarantined(transaction) -> Boolean
--   Unresolved target plist remains outside LaunchAgents; quarantine failures
--   are explicit diagnostics and retain claim, never a successful fence assertion.

invariant PairedPrecommitAutoloadSafety {
    for transaction in DeployTransactions:
        transaction.kind = PreparedArtifactDeployment
        and transaction.state in { preparing, prepared, precondition_cleanup_pending, activating } implies
            paired_precommit_autoload_safe(transaction)
}

invariant PairedFinalizationUncertaintyIsExplicit {
    for transaction in DeployTransactions:
        transaction.kind = PreparedArtifactDeployment
        and transaction.state = committed
        and transaction.finalization = pending implies
            paired_finalization_diagnostic_is_durable(transaction)
}

invariant PairedPredecessorIsRequired {
    for transaction in DeployTransactions:
        transaction.kind = PreparedArtifactDeployment
        and transaction.state not in { preparing, rejected_concurrent, precondition_failed } implies
            transaction.previous != null
}

invariant PairedPublicationRequiresVerification {
    for transaction in DeployTransactions:
        transaction.kind = PreparedArtifactDeployment
        and transaction.state = committed
        and transaction.finalization = complete implies
            paired_publication_is_verified(transaction)
}

invariant PreparedArtifactIsLaunchdScoped {
    for transaction in DeployTransactions:
        transaction.kind = PreparedArtifactDeployment
        and transaction.state not in { preparing, rejected_concurrent, precondition_failed } implies
            transaction.backend = launchd
            and prepared_artifact_source_is_valid(transaction)
            and paired_database_preflight_is_valid(transaction)
            and controller_identity_is_independently_bound(transaction)
}

invariant FailedPreparedRecoveryRetainsManualRecovery {
    for transaction in DeployTransactions:
        transaction.kind = PreparedArtifactDeployment
        and transaction.state = activation_failed_rollback_failed implies
            candidate_teardown_attempted(transaction)
            and paired_transaction_retained(transaction)
            and recovery_verification_unconfirmed(transaction)
            and active_claim_retained(transaction)
}

invariant BareSupervisorChangeFailsBeforeDisruption {
    for transaction in DeployTransactions:
        transaction.backend = bare_linux
        and not selected_supervisor_artifact_matches_running(transaction) implies
            not RuntimeDisruptionStarted(transaction)
}

invariant PreStopCleanupPendingKeepsRuntimeAndClaim {
    for transaction in DeployTransactions:
        transaction.state = precondition_cleanup_pending implies
            pre_stop_cleanup_uncertain(transaction)
            and active_claim_retained(transaction)
            and not RuntimeDisruptionStarted(transaction)
            and not DatabaseRollbackCompleted(transaction)
}

invariant ActiveClaimMatchesTransactionGeneration {
    for claim in DeploymentClaims:
        claim.active implies claim.generation = claim.transaction.claim_generation
}

invariant HandoffsAreImmutableAndSecretFree {
    for handoff in DeploymentHandoffs:
        handoff.immutable and handoff.secret_free
}

invariant CommitRequiresExactIdentity {
    for transaction in DeployTransactions:
        transaction.state = committed implies exact_candidate_running(transaction)
}

invariant DisruptionRequiresPreparedIndependentOwner {
    for transaction in DeployTransactions:
        RuntimeDisruptionStarted(transaction) implies
            preparation_complete(transaction)
            and transaction.state in { handed_off, activating, committed,
                activation_failed_rolled_back, activation_failed_rollback_failed, current_forward_failed }
}

invariant ClaimReleaseRequiresMatchingDurableTerminalStatus {
    for transaction in DeployTransactions:
        ClaimReleasedFor(transaction) implies
            claim_release_matches(transaction)
            and durable_terminal_status_exists(transaction)
}
