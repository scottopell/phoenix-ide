-- allium: 3
-- conversation_atom.allium
--
-- Phoenix Client Conversation Reducer: Behavioural Specification
--
-- Scope: The pure-function reducer in `ui/src/conversation/atom.ts` that
--        folds dispatched actions (wire-originated SSE events + local
--        optimistic updates) into the `ConversationAtom` state used to
--        render the conversation view.
--
-- Includes: State shape; applyIfNewer guard; per-action transitions;
--           sequence_id total ordering; sse_message atomic triple
--           (append + clear buffer + advance seq); streaming buffer
--           phase coupling; wire vs local dispatch distinction;
--           init merge-by-id semantics for reconnect resync;
--           init pending-events replay (server's ReplayRing contents
--           applied through the reducer rules after the snapshot lands,
--           so reconnect during an in-flight turn resumes streaming /
--           in-flight tool state rather than blanking out);
--           connection-epoch monotonic guard (wire-side cross-conv
--           contamination); expectedConversationId guard on
--           client-originated actions (post-navigation stale-dispatch
--           contamination).
--
-- Excludes: HTTP/SSE transport (see sse_wire spec, if written).
--           ConnectionMachine (see connection_machine spec, if written).
--           Message rendering (how atom.messages projects to DOM).
--           Server-side state machine (see bedrock).
--           The queued-message derivation in useMessageQueue (see
--           user_message_queue spec, if written).
--
-- Rationale: this reducer is the nexus of SSE-state fragility. Past bugs
-- (02673, 02675, 02676, ongoing "streaming-finalizes-then-disappears")
-- were all invariant violations of the atomic-triple or phase-coupling
-- rules below. Naming them here makes the next violation diagnosable by
-- construction instead of by refresh-and-hope.
--
-- Self-contained: this spec does not `use` any other spec. External
-- types (Phase, Message content, Conversation metadata) are declared
-- opaque. The reducer treats them opaquely; the server-side specs
-- govern their internals.

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- A persisted conversation message. The reducer treats `content` opaquely;
-- view code pattern-matches on `message_type`. `message_id` is the
-- client-authored localId (API POST uses it as the canonical id); this
-- makes identity-based dedup work across client-server boundaries.
value Message {
    message_id: String
    sequence_id: Integer
    message_type: String
    -- content, display_data, usage_data, created_at elided; the reducer
    -- does not inspect them.
}

-- Opaque conversation phase. The reducer only tests `phase.type` as a
-- string and otherwise passes the value through. Full semantics live in
-- bedrock's ConvState.
value Phase {
    type: String
}

-- The in-flight streaming text for an assistant turn. Populated only
-- while phase.type = "llm_requesting". Cleared atomically on sse_message
-- or sse_agent_done. `lastSequence` is the highest sequence_id this
-- buffer has ingested — a replay guard against late tokens with stale
-- ids.
value StreamingBuffer {
    text: String
    lastSequence: Integer
    startedAt: Timestamp
}

-- UI-facing error surfaced via a toast. Either a wire-originated backend
-- error (carrying its own sequence_id) or a client-synthesized schema
-- violation (no sequence_id).
value UIError {
    type: String
    message: String
}

-- Breadcrumb displayed in the phase trail. Kind-discriminated; the
-- reducer threads sequence_ids through for dedup on reconnect.
value Breadcrumb {
    kind: String
    label: String
    sequence_id: Integer?
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- The reducer's state. Updated via pure transitions from dispatched
-- actions.
entity ConversationAtom {
    conversationId: String?
    phase: Phase
    messages: List<Message>
    breadcrumbs: List<Breadcrumb>
    lastSequenceId: Integer
    streamingBuffer: StreamingBuffer?
    uiError: UIError?
    connectionState: String
    -- The connection generation that produced wire events this atom is
    -- accepting. Null until the first `connection_opened` lands; lifted
    -- monotonically thereafter. Wire-originated actions stamped with a
    -- non-matching epoch are dropped at the reducer boundary — the
    -- cross-conversation contamination guard. Reset to null only via
    -- explicit ConnectionReset (legitimate hook remount), which is what
    -- separates "fresh generation" from "stale OPEN_SSE closure".
    connectionEpoch: Integer?
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

-- The React reducer function itself, operating on a single
-- ConversationAtom per mounted ConversationPage. Rules below describe
-- what the reducer does on each dispatched action. The actor exists
-- here primarily to anchor the ConversationAtom entity to a concrete
-- runtime consumer; rules do not reference it by name.
actor ClientReducer {
    identified_by: ConversationAtom
}

------------------------------------------------------------
-- Rules — wire-originated transitions
------------------------------------------------------------
-- Every wire rule routes through TWO guards in order:
--
--   1. isStaleEpoch (cross-conversation contamination guard): the
--      action's epoch must equal atom.connectionEpoch. A mismatch
--      means the action came from a stale EventSource (a different
--      slug's connection that hadn't fully closed when this atom's
--      generation took over). Captured by the WireActionStaleEpochDropped
--      rule below; per-action rules implicitly assume this guard has
--      already run.
--
--   2. applyIfNewer (replay guard): the action's sequence_id must
--      strictly exceed atom.lastSequenceId, or the event is dropped
--      as a replay. On apply, lastSequenceId advances to the action's
--      sequence_id. Sse_init is the exception (see its rule below).

-- Cross-conversation contamination drop. Any wire-originated action
-- (those carrying an `epoch` field) whose epoch does not match the
-- atom's `connectionEpoch` is dropped before any per-action rule
-- fires. Bootstrap exception: when atom.connectionEpoch is null (the
-- atom hasn't accepted any connection_opened yet), the first stamped
-- action is allowed through so the connection can come online.
rule WireActionStaleEpochDropped {
    when: WireActionDispatched(atom, action)

    requires: atom.connectionEpoch != null
    requires: action.epoch != atom.connectionEpoch

    ensures: atom = atom

    @guidance
        -- atom.ts:256-280 (isStaleEpoch). Applies to:
        -- sse_init, sse_message, sse_message_updated, sse_state_change,
        -- sse_agent_done, sse_token, sse_conversation_update,
        -- sse_browser_session_state, sse_error, connection_state.
        -- Bypassed for: connection_opened (which carries the epoch as
        -- DATA, not as a stamp — the rule's monotonic check is the
        -- guard there), connection_reset (no epoch, mount-only),
        -- and all client-originated actions (gated by
        -- expectedConversationId instead).
}

-- `init` on fresh connect: full state snapshot replaces atom, then
-- pending events from the server's ReplayRing are applied through
-- their normal per-event reducer rules in seq order. After the
-- pending replay completes, lastSequenceId is finalised to the max
-- of whatever the replay reached and payload.last_sequence_id.
--
-- The two-phase structure (snapshot then replay) is what lets a
-- reconnect mid-LLM-turn or mid-tool-execution resume the in-flight
-- view: snapshot supplies durable state (DB-backed messages, phase
-- as of last persisted Message), pending replay supplies the
-- transit-only deltas (streaming tokens, current_tool state_change,
-- eager assistant Message).
rule SseInitFreshConnect {
    when: SseInitDispatched(atom, payload)

    requires: atom.lastSequenceId = 0

    -- Phase 1: snapshot. Note lastSequenceId is set to
    -- payload.pending_anchor_sequence_id (NOT payload.last_sequence_id)
    -- so the per-event rules below can apply each pending entry via
    -- their normal applyIfNewer guard.
    ensures: atom.messages = payload.messages
    ensures: atom.phase = payload.phase
    ensures: atom.breadcrumbs = payload.breadcrumbs
    ensures: atom.lastSequenceId = payload.pending_anchor_sequence_id
    ensures: atom.streamingBuffer = null
    ensures: atom.uiError = null

    -- Phase 2: apply pending events. For each entry in
    -- payload.pending_events (in seq order), dispatch through the
    -- corresponding per-event rule below. The applyIfNewer guard
    -- naturally advances atom.lastSequenceId entry-by-entry.
    ensures: atom = apply_pending_in_order(atom, payload.pending_events)

    -- Phase 3: safety belt. If the replay didn't cover everything
    -- the server believes happened (e.g., ring truncated, or pending
    -- list empty because server has no ring contents to replay),
    -- advance lastSequenceId to the server's witnessed tip so future
    -- live events with lower seqs are correctly dropped.
    ensures: atom.lastSequenceId = max_int(atom.lastSequenceId, payload.last_sequence_id)

    @guidance
        -- apply_pending_in_order: fold over payload.pending_events,
        -- dispatching each through the reducer:
        --   for entry in payload.pending_events:
        --     dispatch({ type: entry.event_type, ...entry.payload,
        --                sequenceId: entry.sequence_id })
        -- Each dispatch routes through this spec's per-event rule
        -- (SseTokenAccumulated, SseStateChangeApplied,
        -- SseMessageAppended / SseMessageDedupReplay, etc.) which
        -- already gates on applyIfNewer. Replayed entries with seq
        -- <= atom.lastSequenceId are dropped as replays (the floor
        -- starts at pending_anchor_sequence_id and rises as each
        -- accepted entry advances it).
        --
        -- The phase 1 lastSequenceId = pending_anchor_sequence_id
        -- is the key change from the prior version of this rule:
        -- previously it was payload.last_sequence_id, which would
        -- cause every pending entry to be dropped as a replay.
}

-- `init` on reconnect: merge by message_id, then apply pending
-- events the same way SseInitFreshConnect does. The merge captures
-- mutations that happened while disconnected; pending replay restores
-- the in-flight UI state for the active turn (if any).
--
-- Unlike fresh-connect, the atom's pre-existing lastSequenceId may
-- already be above the snapshot's pending_anchor. In that case the
-- per-event rules' applyIfNewer guard drops any pending entry whose
-- seq is below the current floor — exactly correct, because the atom
-- has already observed those events live.
rule SseInitReconnectMerge {
    when: SseInitDispatched(atom, payload)

    requires: atom.lastSequenceId > 0

    -- Phase 1: snapshot merge. Note we do NOT reset lastSequenceId
    -- yet — keep the atom's current floor so pending entries the
    -- atom has already seen live are dropped as replays.
    --
    -- streamingBuffer is preserved when payload.phase is
    -- llm_requesting (the turn is still in flight; pending tokens
    -- with seq > floor will extend the existing buffer, and tokens
    -- at or below the floor are correctly dropped as replays — the
    -- alternative of clearing the buffer creates a blank window
    -- because the cleared buffer cannot be rebuilt from already-
    -- observed tokens). Cleared when payload.phase is anything
    -- else, because the turn ended while disconnected.
    ensures: atom.messages = merge_by_id(atom.messages, payload.messages)
    ensures: atom.phase = payload.phase
    ensures: atom.breadcrumbs = payload.breadcrumbs
    ensures: atom.streamingBuffer = preserve_buffer_when_streaming(atom.streamingBuffer, payload.phase)
    ensures: atom.uiError = null

    -- Phase 2: apply pending events. Per-event applyIfNewer naturally
    -- filters entries with seq <= atom.lastSequenceId. Each accepted
    -- entry advances the floor.
    ensures: atom = apply_pending_in_order(atom, payload.pending_events)

    -- Phase 3: safety belt — never regress lastSequenceId, but also
    -- never let it stay below the server's witnessed tip if the
    -- replay couldn't bring it there.
    ensures: atom.lastSequenceId = max_int(atom.lastSequenceId, payload.last_sequence_id)

    @guidance
        -- preserve_buffer_when_streaming(buf, phase):
        --   if phase.type = llm_requesting then buf else null
        -- Rationale: on reconnect the atom may already hold a live
        -- streamingBuffer from tokens this connection has accepted.
        -- Clearing it unconditionally creates a blank-UI window because
        -- the pending tokens that would otherwise rebuild it have seq
        -- at-or-below the existing floor and are dropped by applyIfNewer
        -- as replays. Preserving when phase=llm_requesting closes that
        -- window; clearing for other phases reflects "turn ended while
        -- disconnected." Pending agent_done in phase 2 still clears the
        -- buffer through its own per-event rule, so the final state is
        -- correct even when the snapshot phase is stale.
        --
        -- merge_by_id (ui/src/conversation/atom.ts:sse_init case):
        --   1. Build a Map<message_id, Message> from payload.messages.
        --   2. For each existing m in atom.messages: replace with the
        --      incoming version if present, else keep as-is.
        --   3. Filter payload.messages for entries whose message_id is
        --      not already in atom.messages (genuinely new messages).
        --   4. Concatenate (replaced ++ appended).
        -- The merge is what lets a reconnect after a broadcast-lag close
        -- resurrect messages that were lost to the silent-drop window.
        --
        -- payload.pending_events: the ReplayRing contents at subscribe
        -- time. Carries events the server emitted since the last
        -- persisted Message. Replaying them through the reducer
        -- restores streaming buffers, in-flight phase, and any eager
        -- (non-persisted) assistant Message — the mid-turn UI state
        -- that would otherwise vanish until the next checkpoint.
        --
        -- payload.pending_truncated indicates the server-side ring
        -- overflowed since the last anchor. The reducer treats this
        -- as a soft hint: the snapshot + remaining pending events
        -- still produce a valid (if partial) view. Surfacing the
        -- truncation to the user via the UI is a conversation-ui
        -- decision, not a reducer concern.
}

-- `message` — a newly-persisted message appended to the conversation.
-- THE LOAD-BEARING RULE: this transition is atomic and must mutate all
-- three of messages / streamingBuffer / lastSequenceId simultaneously.
-- The "streaming-finalizes-then-disappears" bug class is every shape of
-- this triple being applied partially.
rule SseMessageAppended {
    when: SseMessageDispatched(atom, message, seq)

    requires: seq > atom.lastSequenceId
    requires: not message_in_list(atom.messages, message.message_id)

    ensures: atom.messages = append(atom.messages, message)
    ensures: atom.streamingBuffer = null
    ensures: atom.lastSequenceId = seq

    @guidance
        -- Each of the three ensures clauses above MUST hold jointly. A
        -- partial apply (e.g. streamingBuffer cleared but the message
        -- not appended) is exactly the "streaming-finalizes-then-
        -- disappears" shape we see in production. The React reducer's
        -- single return statement gives us atomicity by construction as
        -- long as all three fields are set in that return.
        --
        -- User/skill messages additionally reset breadcrumbs to a fresh
        -- agent turn. Tool-result messages update the matching tool
        -- breadcrumb with a result summary derived from content. These
        -- are local to breadcrumbs; they do not relax the triple.
}

-- `message` when the message_id is already present (defense-in-depth
-- dedup against a server replay with a fresh sequence_id). The
-- sequence_id still advances — we have observed the event — but
-- messages and streamingBuffer are left intact.
rule SseMessageDedupReplay {
    when: SseMessageDispatched(atom, message, seq)

    requires: seq > atom.lastSequenceId
    requires: message_in_list(atom.messages, message.message_id)

    ensures: atom.messages = atom.messages
    ensures: atom.streamingBuffer = atom.streamingBuffer
    ensures: atom.lastSequenceId = seq

    @guidance
        -- A replay implies the original apply already ran and cleared
        -- the buffer at the time. If buffer is non-null now, it is
        -- from a later turn, not the replayed message's turn — so
        -- leaving it untouched is correct.
}

-- Replays below the current watermark are dropped entirely.
rule SseMessageReplayDropped {
    when: SseMessageDispatched(atom, message, seq)

    requires: seq <= atom.lastSequenceId

    ensures: atom = atom
}

-- `message_updated` — in-place mutation of existing message fields
-- (display_data, content). Target must exist; a missing target is a
-- silent no-op (the update cannot land before its message, but a
-- reconnect race could reorder — tolerating the no-op is safer than
-- erroring).
rule SseMessageUpdatedApplied {
    when: SseMessageUpdatedDispatched(atom, messageId, seq)

    requires: seq > atom.lastSequenceId
    requires: message_in_list(atom.messages, messageId)

    ensures: atom.messages = replace_message(atom.messages, messageId)
    ensures: atom.lastSequenceId = seq
    ensures: atom.streamingBuffer = atom.streamingBuffer
}

rule SseMessageUpdatedUnknownTarget {
    when: SseMessageUpdatedDispatched(atom, messageId, seq)

    requires: seq > atom.lastSequenceId
    requires: not message_in_list(atom.messages, messageId)

    ensures: atom.messages = atom.messages
    ensures: atom.lastSequenceId = seq
}

-- `state_change` — phase transition from the server.
rule SseStateChangeApplied {
    when: SseStateChangeDispatched(atom, newPhase, seq)

    requires: seq > atom.lastSequenceId

    ensures: atom.phase = newPhase
    ensures: atom.lastSequenceId = seq

    @guidance
        -- Also threads the breadcrumb for the new phase (llm_requesting,
        -- tool_executing, etc.) through applyBreadcrumb, which dedups
        -- by sequence_id. Elided here to keep the rule focused.
}

-- `agent_done` — turn complete. Phase collapses to idle and the
-- streaming buffer clears (whether or not a sse_message preceded it).
-- If the preceding sse_message was lost (e.g. to the pre-736b37d
-- broadcast-lag silent-drop path), this rule leaves the atom with no
-- visible final message — the bug shape we spent much of April 23
-- investigating.
rule SseAgentDoneApplied {
    when: SseAgentDoneDispatched(atom, seq)

    requires: seq > atom.lastSequenceId

    ensures: atom.phase.type = "idle"
    ensures: atom.streamingBuffer = null
    ensures: atom.lastSequenceId = seq

    @guidance
        -- After this rule, streamingBuffer is null regardless of
        -- whether the turn's sse_message ever arrived. A gap in the
        -- expected event order (agent_done without preceding message)
        -- is NOT recoverable at the reducer; the client must reconnect
        -- to resync via sse_init. The broadcast-lag close fix in
        -- src/api/sse.rs (commit 736b37d) forces this resync by ending
        -- the stream on Lagged instead of silently skipping events.
}

-- `token` — streaming delta. Phase-guarded: only accumulates while the
-- conversation is in llm_requesting. Tokens that arrive outside that
-- phase (scheduler race, reconnect replay) are silently dropped. This
-- is the client-side half of the "ghost streaming message" defense
-- (task 24683). The applyIfNewer guard handles sequence-id replays.
rule SseTokenAccumulated {
    when: SseTokenDispatched(atom, delta, seq)

    requires: atom.phase.type = "llm_requesting"
    requires: seq > atom.lastSequenceId

    ensures: atom.streamingBuffer = accumulate_token(atom.streamingBuffer, delta, seq)
    ensures: atom.lastSequenceId = seq

    @guidance
        -- accumulate_token: if streamingBuffer is null, start a new one
        -- with text = delta, lastSequence = seq, startedAt = now. If
        -- non-null, append delta to text, advance lastSequence to seq.
        -- startedAt is preserved from the first token.
}

rule SseTokenDroppedOutOfPhase {
    when: SseTokenDispatched(atom, delta, seq)

    requires: atom.phase.type != "llm_requesting"

    ensures: atom = atom

    @guidance
        -- lastSequenceId does NOT advance here: a token dropped for
        -- phase reasons is not an observed event in the total-order
        -- sense. It was emitted, but we refuse it.
}

-- `conversation_update` — partial metadata merge.
rule SseConversationUpdateApplied {
    when: SseConversationUpdateDispatched(atom, updates, seq)

    requires: seq > atom.lastSequenceId

    ensures: atom.lastSequenceId = seq

    @guidance
        -- Shallow merge into atom.conversation. If atom.conversation is
        -- null (init hasn't landed), the rule applies lastSequenceId
        -- but leaves the merge as a no-op.
}

-- `sse_error` with a sequence_id (wire-originated) routes through
-- applyIfNewer. A replayed error after the user dismissed it does NOT
-- re-pop the toast (because applyIfNewer drops it as a replay).
rule SseErrorWireOriginated {
    when: SseErrorDispatched(atom, error, seq)

    requires: seq > 0
    requires: seq > atom.lastSequenceId

    ensures: atom.uiError = error
    ensures: atom.lastSequenceId = seq
}

-- `sse_error` WITHOUT a sequence_id (client-synthesized, e.g. schema
-- violation from parseEvent's prod failure path) applies
-- unconditionally. These are not on the server's total order, so
-- applyIfNewer cannot gate them.
rule SseErrorClientSynthesized {
    when: SseErrorDispatched(atom, error, seq)

    requires: seq = 0

    ensures: atom.uiError = error
    ensures: atom.lastSequenceId = atom.lastSequenceId
}

------------------------------------------------------------
-- Rules — local (optimistic) transitions
------------------------------------------------------------

-- `local_phase_change` — used by sendMessage() to flip phase to
-- awaiting_llm the moment the POST returns, without waiting for the
-- server's sse_state_change. Does NOT touch lastSequenceId; a
-- subsequent wire event will overwrite phase authoritatively.
--
-- `expectedConversationId` is captured at dispatch time. The reducer
-- drops the action when the atom is no longer that conversation —
-- closes the leak where `await api.foo(...)` resolves into a slug-bound
-- dispatch after navigation.
rule LocalPhaseChangeApplied {
    when: LocalPhaseChangeDispatched(atom, newPhase, expectedConversationId)

    requires: atom.conversationId = expectedConversationId

    ensures: atom.phase = newPhase
    ensures: atom.lastSequenceId = atom.lastSequenceId
    ensures: atom.streamingBuffer = atom.streamingBuffer
}

rule LocalPhaseChangeStaleConversation {
    when: LocalPhaseChangeDispatched(atom, newPhase, expectedConversationId)

    requires: atom.conversationId != expectedConversationId

    ensures: atom = atom

    @guidance
        -- Drop. The dispatch was bound to a conversation that is no
        -- longer the atom's. Typical trigger: an in-flight
        -- `await api.sendMessage(...)` resolved after the user
        -- navigated away.
}

rule LocalConversationUpdateApplied {
    when: LocalConversationUpdateDispatched(atom, updates, expectedConversationId)

    requires: atom.conversationId = expectedConversationId

    ensures: atom.lastSequenceId = atom.lastSequenceId

    @guidance
        -- Shallow merge into atom.conversation. No-op if
        -- atom.conversation is null.
}

rule LocalConversationUpdateStaleConversation {
    when: LocalConversationUpdateDispatched(atom, updates, expectedConversationId)

    requires: atom.conversationId != expectedConversationId

    ensures: atom = atom
}

rule ClearError {
    when: ClearErrorDispatched(atom)

    ensures: atom.uiError = null
    ensures: atom.lastSequenceId = atom.lastSequenceId
}

rule ConnectionStateChanged {
    when: ConnectionStateDispatched(atom, newState)

    ensures: atom.connectionState = newState
    ensures: atom.lastSequenceId = atom.lastSequenceId

    @guidance
        -- The action carries an `epoch` field stamped by useConnection.
        -- Like all wire-stamped actions, it's gated by isStaleEpoch
        -- before reaching this case: a connection_state from a stale
        -- generation is dropped at the reducer boundary rather than
        -- overwriting the live generation's value. The case itself
        -- is unconditional only because the staleness check has
        -- already run.
}

------------------------------------------------------------
-- Rules — connection epoch lifecycle
------------------------------------------------------------
-- The wire-side cross-conversation contamination guard. Every
-- wire-originated action carries an `epoch` matching the OPEN_SSE
-- generation that produced it. The reducer's `isStaleEpoch` check
-- (applied before per-action transitions) drops actions whose epoch
-- doesn't match `atom.connectionEpoch`. The two rules below maintain
-- `connectionEpoch` itself.

-- `connection_opened` — dispatched from useConnection's OPEN_SSE
-- effect handler with the freshly-minted epoch. Strictly monotonic:
-- a stale OPEN_SSE executor closure firing after a newer one cannot
-- regress the value (which would re-accept events the new generation
-- has already superseded).
rule ConnectionOpenedMonotonic {
    when: ConnectionOpenedDispatched(atom, epoch)

    requires: atom.connectionEpoch = null or epoch > atom.connectionEpoch

    ensures: atom.connectionEpoch = epoch
    ensures: atom.lastSequenceId = atom.lastSequenceId
}

rule ConnectionOpenedRegressionDropped {
    when: ConnectionOpenedDispatched(atom, epoch)

    requires: atom.connectionEpoch != null
    requires: epoch <= atom.connectionEpoch

    ensures: atom = atom

    @guidance
        -- Within a single useConnection mount lifetime the machine
        -- epoch counter is monotonic. An OPEN_SSE effect closure that
        -- fires `connection_opened` with a lower epoch than the atom
        -- already accepted is, by construction, stale — drop it.
        --
        -- Hook remount is the legitimate "lower epoch is correct"
        -- scenario, but the hook handles that explicitly via
        -- ConnectionReset (below) before any `connection_opened`
        -- arrives. By the time this rule runs, the only way to
        -- observe a regression is a stale closure, which must be
        -- rejected.
}

-- `connection_reset` — dispatched from useConnection's mount effect
-- before CONNECT. Nulls `connectionEpoch` so the freshly-mounted
-- machine's first `connection_opened` (which may have a lower epoch
-- than what the atom retains from a prior visit) is accepted by
-- ConnectionOpenedMonotonic.
rule ConnectionReset {
    when: ConnectionResetDispatched(atom)

    ensures: atom.connectionEpoch = null
    ensures: atom.connectionState = "connecting"
    ensures: atom.lastSequenceId = atom.lastSequenceId

    @guidance
        -- This is the structural separation between "legitimate
        -- remount" and "stale OPEN_SSE closure": only mount-time
        -- code dispatches connection_reset. A stale executor cannot
        -- forge it (no parallel path produces this action), so the
        -- monotonic guard on connection_opened is preserved as a
        -- correctness barrier.
}

-- Seeds initial data from localStorage cache or an initial REST fetch.
-- No-op if SSE has already provided authoritative data.
rule SetInitialData {
    when: SetInitialDataDispatched(atom, snapshot)

    requires: atom.lastSequenceId = 0

    ensures: atom.conversationId = snapshot.conversationId
    ensures: atom.messages = snapshot.messages
    ensures: atom.phase = snapshot.phase
}

rule SetInitialDataNoOp {
    when: SetInitialDataDispatched(atom, snapshot)

    requires: atom.lastSequenceId > 0

    ensures: atom = atom
}

-- `set_system_prompt` — fired from the page's getSystemPrompt fetch.
-- Same expectedConversationId guard as the other client-originated
-- mutations: a stale promise resolving after navigation lands on the
-- old slug's bound dispatch and would otherwise write the prompt into
-- whatever atom that dispatch points at.
rule SetSystemPromptApplied {
    when: SetSystemPromptDispatched(atom, systemPrompt, expectedConversationId)

    requires: atom.conversationId = expectedConversationId

    ensures: atom.lastSequenceId = atom.lastSequenceId

    @guidance
        -- atom.systemPrompt = systemPrompt. The field is elided from
        -- the entity schema above (along with conversation, etc.) to
        -- keep the spec focused on the dynamics rather than the full
        -- shape; the rule pins the cross-conv guard.
}

rule SetSystemPromptStaleConversation {
    when: SetSystemPromptDispatched(atom, systemPrompt, expectedConversationId)

    requires: atom.conversationId != expectedConversationId

    ensures: atom = atom
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Messages are uniquely identified by message_id. The defense-in-depth
-- dedup in SseMessageDedupReplay enforces this at the reducer level.
invariant MessagesUniqueById {
    for a in ConversationAtoms:
        for i in a.messages:
            for j in a.messages:
                i != j implies i.message_id != j.message_id
}

-- The streaming buffer is valid only while the conversation is in the
-- llm_requesting phase. Any transition that moves phase out of
-- llm_requesting must clear the buffer.
invariant StreamingBufferPhaseCoupled {
    for a in ConversationAtoms:
        a.streamingBuffer != null implies a.phase.type = "llm_requesting"
}

-- Sequence ids are non-negative.
invariant LastSequenceIdNonNegative {
    for a in ConversationAtoms:
        a.lastSequenceId >= 0
}

-- Streaming buffer's internal lastSequence cannot exceed the atom's
-- lastSequenceId. Tokens feed both; a buffer lastSequence ahead of the
-- atom would mean a token was accumulated without its sequence_id
-- being observed by applyIfNewer, which is impossible by construction
-- (SseTokenAccumulated updates both).
invariant BufferSequenceWithinAtomSequence {
    for a in ConversationAtoms:
        a.streamingBuffer != null
            implies a.streamingBuffer.lastSequence <= a.lastSequenceId
}

-- The connection epoch is non-negative when set. The reducer rules
-- (ConnectionOpenedMonotonic and ConnectionReset) maintain
-- monotonicity-between-resets at the per-dispatch level — a stronger
-- claim than this static invariant captures, but expressing it
-- requires temporal quantification over event histories rather than
-- the entity-snapshot quantification this dialect supports.
invariant ConnectionEpochNonNegative {
    for a in ConversationAtoms:
        a.connectionEpoch != null implies a.connectionEpoch >= 0
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------
-- Kept as prose rather than `open question` declarations so the file
-- remains parseable. Both are design-intent clarifications rather than
-- blocking ambiguities; they live here for the next reader.
--
-- Q1. SseErrorWireOriginated uses applyIfNewer, so a server replay of
--     the same error on reconnect is dropped. But ClearError (user
--     dismissed) sets uiError = null without touching lastSequenceId.
--     A fresh error on a later sequence_id would therefore land and
--     re-pop. Is that desired? Today it is — a new error is new
--     information — but this is the kind of detail that wants
--     explicit confirmation.
--
-- Q2. SseInitReconnectMerge uses max(atom.lastSequenceId,
--     payload.last_sequence_id) to prevent regression when live
--     events raced ahead of the init payload. Consider the reverse:
--     if the client's atom.lastSequenceId was advanced by a
--     dropped-but-seq-observed event (SseMessageDedupReplay), it
--     could be ahead of events the payload actually reflects.
--     Payload's per-message sequence_ids are the ground truth for
--     what happened; the envelope last_sequence_id is the server's
--     witness. Today this is fine; flag if the dedup behavior ever
--     changes.
--
-- Q3. apply_pending_in_order is described as a fold over per-event
--     reducer dispatches. The semantics depend on whether dispatch
--     observes atom mutations in real time (it does in the real
--     reducer — each dispatch produces the next atom state, which
--     the next dispatch sees). The spec rule's `ensures: atom =
--     apply_pending_in_order(...)` is meant to denote that
--     sequential-fold behaviour. If a future implementation tried to
--     batch pending dispatches into a single atomic mutation (e.g.,
--     to avoid React re-renders per token), the per-event preconditions
--     (applyIfNewer comparing to atom.lastSequenceId) would still need
--     to see entry-by-entry floor advancement. Worth re-checking the
--     implementation matches this denotation.
--
-- Q4. Token replay and streamingBuffer reconstruction. After a
--     reconnect, snapshot phase 1 sets streamingBuffer = null, then
--     phase 2's pending replay re-accumulates tokens. If the client
--     had already seen tokens 1..N before disconnect, replay re-emits
--     them, producing exactly the same buffer text. Idempotent in
--     terms of final state, but the user briefly sees the buffer
--     re-build from empty. Acceptable today; revisit if the visible
--     reset becomes confusing in practice.
