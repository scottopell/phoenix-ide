-- allium: 3
-- Phoenix macOS direct-distribution release lifecycle
--
-- Scope: exact-tag gating, paired architecture-specific helper/app builds,
-- Developer ID signing, notarization, and private publication preparation.
-- Requirement traceability: REQ-DESKTOP-REL-001 through REQ-DESKTOP-REL-008.

enum TagGateState { unresolved | exact_tag_match | new_tag_created | refused }
enum ArtifactState { pending | built | verified | failed }
enum NotaryState { pending | submitted | stapled | validated | failed }
enum PublicationState { idle | inaccessible | uploading | verified | public | failed }
enum FailureDomain { none | tag_gate | build | signing | notarization | publication | configuration }

value ReleaseIdentity {
    tag: String
    full_commit: String
}

entity ReleaseGate {
    identity: ReleaseIdentity
    state: TagGateState

    transitions state {
        unresolved -> exact_tag_match
        unresolved -> new_tag_created
        unresolved -> refused
        exact_tag_match -> exact_tag_match
        new_tag_created -> new_tag_created
        refused -> refused
    }
}

entity ArchitecturePair {
    target: String
    identity: ReleaseIdentity
    standalone: ArtifactState
    desktop: ArtifactState
    notarization: NotaryState

    transitions standalone {
        pending -> built
        pending -> failed
        built -> verified
        built -> failed
        verified -> failed
        failed -> failed
    }

    transitions desktop {
        pending -> built
        pending -> failed
        built -> verified
        built -> failed
        verified -> failed
        failed -> failed
    }

    transitions notarization {
        pending -> submitted
        pending -> failed
        submitted -> stapled
        submitted -> failed
        stapled -> validated
        stapled -> failed
        validated -> failed
        failed -> failed
    }
}

entity ReleasePublication {
    identity: ReleaseIdentity
    apple_silicon_pair: ArchitecturePair
    intel_pair: ArchitecturePair
    state: PublicationState
    failure_domain: FailureDomain

    transitions state {
        idle -> inaccessible
        idle -> public
        idle -> failed
        inaccessible -> uploading
        inaccessible -> failed
        uploading -> inaccessible
        uploading -> verified
        uploading -> failed
        verified -> public
        verified -> failed
        public -> public
        failed -> inaccessible
        failed -> failed
    }
}

surface DesktopReleaseWorkflow {
}

-- Helpers
--
-- valid_release_identity(identity) -> Boolean
--   identity has a stable v-prefixed semantic tag and a forty-character
--   lowercase hexadecimal commit.
-- bundle_version_representable(identity) -> Boolean
--   identity.tag can be represented by the required bounded app bundle version.
-- tag_absent(gate) -> Boolean
--   no tag named gate.identity.tag exists.
-- tag_exists_at_different_commit(gate) -> Boolean
--   gate.identity.tag exists and does not resolve to gate.identity.full_commit.
-- tag_points_at_exact_commit(gate) -> Boolean
--   gate.identity.tag resolves to gate.identity.full_commit.
-- protected_release_configuration_available(pair) -> Boolean
--   the protected signing and notarization configuration is available.
-- standalone_signature_valid(pair) -> Boolean
--   the standalone helper has a hardened-runtime Developer ID signature from the
--   configured release authority and passes strict verification.
-- helper_identity_resolves_to_release(pair) -> Boolean
--   the helper's clean embedded identity resolves to pair.identity.full_commit.
-- helper_bytes_are_paired(pair) -> Boolean
--   the helper embedded in the desktop app is byte-identical to the separately
--   published signed helper before and after outer-app signing.
-- desktop_signature_valid(pair) -> Boolean
--   the outer app has the required hardened-runtime signature and passes strict
--   complete-bundle verification.
-- notarization_ticket_and_gatekeeper_valid(pair) -> Boolean
--   the stapled ticket validates and Gatekeeper accepts the app.
-- exact_inaccessible_assets_and_digests(publication) -> Boolean
--   consumer-inaccessible publication work contains exactly the eight required
--   non-manifest assets and SHA256SUMS, whose entries and reported digests match.
-- required_architecture_pairs_validated(publication) -> Boolean
--   the publication has distinct Apple Silicon and Intel pairs with matching
--   release identities, verified helper/app artifacts, and validated notarization.
-- public_release_is_exact(publication) -> Boolean
--   the public release contains exactly the required names and matching digests.
-- public_release_differs(publication) -> Boolean
--   a public release exists but is not the exact required release.

rule GateCreatesOnlyRepresentableStableTag {
    when: ReleaseTagCreated(gate)
    requires: gate.state = unresolved
    requires: valid_release_identity(gate.identity)
    requires: bundle_version_representable(gate.identity)
    requires: tag_absent(gate)
    ensures: gate.state = new_tag_created
    ensures: tag_points_at_exact_commit(gate)
}

rule GateAcceptsOnlyExistingExactTag {
    when: ExactReleaseTagFound(gate)
    requires: gate.state = unresolved
    requires: valid_release_identity(gate.identity)
    requires: bundle_version_representable(gate.identity)
    requires: tag_points_at_exact_commit(gate)
    ensures: gate.state = exact_tag_match
}

rule GateRefusesDifferentCommitOrInvalidVersion {
    when: ReleaseGateRejected(gate)
    requires: gate.state = unresolved
    requires: not valid_release_identity(gate.identity) or not bundle_version_representable(gate.identity) or tag_exists_at_different_commit(gate)
    ensures: gate.state = refused
}

rule StandaloneHelperMustVerifyBeforeAppPackaging {
    when: StandaloneHelperVerified(pair)
    requires: pair.standalone = built
    requires: protected_release_configuration_available(pair)
    requires: standalone_signature_valid(pair)
    requires: helper_identity_resolves_to_release(pair)
    ensures: pair.standalone = verified
}

rule DesktopAppPreservesThePublishedHelper {
    when: DesktopAppVerified(pair)
    requires: pair.standalone = verified
    requires: pair.desktop = built
    requires: helper_bytes_are_paired(pair)
    requires: desktop_signature_valid(pair)
    ensures: pair.desktop = verified
}

rule NotarizationRequiresVerifiedApp {
    when: NotarizationSubmitted(pair)
    requires: pair.desktop = verified
    requires: protected_release_configuration_available(pair)
    ensures: pair.notarization = submitted
}

rule StaplingRequiresAcceptedNotarization {
    when: NotarizationStapled(pair)
    requires: pair.notarization = submitted
    ensures: pair.notarization = stapled
}

rule GatekeeperValidationRequiresStapledTicket {
    when: NotarizationValidated(pair)
    requires: pair.notarization = stapled
    requires: notarization_ticket_and_gatekeeper_valid(pair)
    ensures: pair.notarization = validated
}

rule PublicationCreatesOrReusesInaccessiblePreparation {
    when: InaccessiblePublicationPrepared(gate, publication)
    requires: gate.state = new_tag_created or gate.state = exact_tag_match
    requires: gate.identity = publication.identity
    requires: publication.state = idle or publication.state = failed
    ensures: publication.state = inaccessible
    ensures: publication.failure_domain = none
}

rule InaccessibleUploadStartsFromPreparedState {
    when: InaccessibleUploadStarted(publication)
    requires: publication.state = inaccessible
    ensures: publication.state = uploading
}

rule InterruptedUploadRemainsInaccessible {
    when: InaccessibleUploadInterrupted(release)
    requires: release.state = uploading
    ensures: release.state = inaccessible
    ensures: release.failure_domain = publication
}

rule CompleteInaccessiblePublicationBecomesVerified {
    when: InaccessiblePublicationVerified(release)
    requires: release.state = uploading
    requires: exact_inaccessible_assets_and_digests(release)
    requires: required_architecture_pairs_validated(release)
    ensures: release.state = verified
    ensures: release.failure_domain = none
}

rule VerifiedInaccessiblePublicationBecomesPublic {
    when: InaccessiblePublicationPublished(gate, publication)
    requires: publication.state = verified
    requires: gate.state = new_tag_created or gate.state = exact_tag_match
    requires: gate.identity = publication.identity
    requires: tag_points_at_exact_commit(gate)
    requires: exact_inaccessible_assets_and_digests(publication)
    requires: required_architecture_pairs_validated(publication)
    ensures: publication.state = public
    ensures: publication.failure_domain = none
}

rule ExactPublicRetryIsIdempotent {
    when: PublishedReleaseRetried(gate, publication)
    requires: publication.state = idle
    requires: gate.state = exact_tag_match
    requires: gate.identity = publication.identity
    requires: public_release_is_exact(publication)
    requires: required_architecture_pairs_validated(publication)
    ensures: publication.state = public
    ensures: publication.failure_domain = none
}

rule DifferentPublicReleaseFailsWithoutReplacement {
    when: PublishedReleaseMismatchFound(release)
    requires: release.state = idle
    requires: public_release_differs(release)
    ensures: release.state = failed
    ensures: release.failure_domain = publication
}

invariant CompletedArchitecturePairHasOneIdentity {
    ArchitecturePair.notarization = validated implies (
        ArchitecturePair.standalone = verified and
        ArchitecturePair.desktop = verified and
        helper_identity_resolves_to_release(ArchitecturePair) and
        helper_bytes_are_paired(ArchitecturePair)
    )
}

invariant PublicReleaseIsExact {
    ReleasePublication.state = public implies (
        public_release_is_exact(ReleasePublication) and
        required_architecture_pairs_validated(ReleasePublication)
    )
}
