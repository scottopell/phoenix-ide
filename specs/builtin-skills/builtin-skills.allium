-- allium: 3
-- specs/builtin-skills/builtin-skills.allium
--
-- Scope: Built-in skills — embedding, startup extraction, discovery
--        integration, override precedence
-- Imports: skills (extends Skill discovery and invocation)
-- Excludes: Filesystem skill discovery (already in skills.allium)
--           Frontmatter parsing (already in skills.allium)
--           Argument substitution (already in skills.allium)

use "../skills/skills.allium" as skills

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- A built-in skill is content compiled into the phoenix binary as part of
-- an embedded directory tree. At server startup the tree is materialized
-- to a real on-disk directory. Ordinary invocation uses that extracted tree;
-- privileged Coordinator invocation authenticates and reads embedded bytes.
external entity BuiltinSkillAsset {
    relative_path: String   -- path within the embedded tree, e.g. "spears/SKILL.md"
    content: String         -- file content; underlying type is &'static [u8] in Rust
}

external entity TrustedBuiltinSkillResult {
    audience: String
    content: String
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- Subdirectory under the phoenix data dir where built-ins are extracted.
    -- Implementation: src/skills/builtin.rs EXTRACT_SUBDIR constant.
    builtin_extract_subdir: String = "builtin-skills"

    -- The embedded asset tree compiled into the binary.
    -- Implementation: src/skills/builtin/ directory with rust_embed::RustEmbed.
    builtin_assets: List<BuiltinSkillAsset>
}

------------------------------------------------------------
-- Rules: Startup Extraction
------------------------------------------------------------

rule ExtractBuiltinAssets {
    when: ServerStartup(home_dir)

    let target = home_dir + "/.phoenix-ide/" + builtin_extract_subdir

    ensures: for asset in builtin_assets:
        FileWritten(
            path: target + "/" + asset.relative_path,
            content: asset.content
        )

    @guidance
        -- Idempotent: writes are skipped when the existing file's bytes
        -- already match the embedded asset.
        -- Failure is non-fatal: extraction errors are logged at warn! and
        -- the server continues. Built-ins simply won't appear in the catalog.
        -- Implementation: extract_to() in src/skills/builtin.rs, called from
        -- main() before the database opens.
}

------------------------------------------------------------
-- Rules: Discovery Integration
------------------------------------------------------------

-- Built-in skills are discovered AFTER the user filesystem walk completes,
-- by scanning the extraction directory. The existing name-dedup rule (first
-- seen wins, defined in skills.allium DiscoverSkillCatalog) means a
-- filesystem skill of the same name is already collected and the built-in
-- is skipped.

rule ScanBuiltinExtractDir {
    when: FilesystemDiscoveryComplete(catalog, builtin_dir)

    requires: directory_exists(builtin_dir)
    -- directory_exists: black box

    ensures: for child_dir in immediate_subdirectories(builtin_dir)
             where has_skill_md(child_dir)
               and is_readable(child_dir + "/SKILL.md")
               and current_builtin_name(directory_name(child_dir))
               and extracted_bytes(child_dir + "/SKILL.md") = embedded_bytes(directory_name(child_dir))
               and frontmatter_name(child_dir) = directory_name(child_dir)
               and not name_taken(catalog, frontmatter_name(child_dir)):
        SkillRegistered(
            name: frontmatter_name(child_dir),
            description: frontmatter_description(child_dir),
            argument_hint: frontmatter_argument_hint(child_dir),
            audience: frontmatter_audience(child_dir, default: "conversation"),
            source: Builtin(path: child_dir + "/SKILL.md")
        )
    -- immediate_subdirectories / has_skill_md / is_readable /
    -- current_builtin_name / extracted_bytes / embedded_bytes /
    -- directory_name / frontmatter_*: black box helpers

    @guidance
        -- Sequencing matters: the filesystem walk runs first, then this
        -- rule fires once over the extract directory, then the catalog is
        -- sorted by name. Reordering would invert the precedence rule.
        -- The current_builtin_name guard prevents stale extracted
        -- directories from keeping removed built-ins visible after an
        -- upgrade.
        -- Implementation: collect_builtin_skills_from_dir() in
        -- src/system_prompt.rs, called from discover_skills_with_options
        -- after the walk-up + children + $HOME scans.
}

rule DiscoverCoordinatorBuiltin {
    when: CoordinatorBuiltinCatalogRequested(builtin_dir)

    ensures: for skill in builtins(builtin_dir)
             where skill.audience = "global-coordinator"
             and extracted_bytes(skill) = embedded_bytes(skill):
        skill in coordinator_catalog
    ensures: for skill in builtins(builtin_dir)
             where skill.audience != "global-coordinator"
             or extracted_bytes(skill) != embedded_bytes(skill):
        skill not in coordinator_catalog

    @guidance
        -- Coordinator discovery scans only Phoenix's extracted built-ins. It
        -- does not scan repository or user filesystem skill directories.
}

rule InvokeCoordinatorBuiltin {
    when: CoordinatorBuiltinInvocation(skill, args)

    requires: skill.audience = "global-coordinator"
    requires: skill.name in current_builtin_name
    requires: args = ""

    ensures: TrustedBuiltinSkillResult.created(
        audience: "global-coordinator",
        content: expand_embedded_skill(embedded_bytes(skill))
    )
    ensures: TrustedBuiltinSkillResult.delivered_to_current_request_only()
    ensures: persisted_tool_result(skill).is_ordinary_untrusted_data()

    @guidance
        -- Invocation reads the immutable asset embedded in the binary, not the
        -- mutable extraction cache. Embedded companion references are included
        -- in the authenticated result.
}

------------------------------------------------------------
-- Rules: Catalog Rendering
------------------------------------------------------------

rule RenderBuiltinInCatalog {
    when: CatalogEntryFormatted(skill)

    requires: skill.source = "Builtin"

    ensures: entry_text = "- **" + skill.name + "** — " + skill.description + " (built-in)"

    @guidance
        -- Filesystem skills render with the path in backticks (existing
        -- skills.allium InjectSkillCatalog rule). Built-ins render with
        -- the literal "(built-in)" annotation so the catalog stays terse
        -- and so the LLM can distinguish phoenix-bundled skills from
        -- user-installed ones at a glance. The real extract path is still
        -- available to the LLM via the `Base directory` line emitted when
        -- the skill is invoked.
        --
        -- Note: this rule treats Skill.source as a String discriminator
        -- ("Builtin" vs other locations). skills.allium models source as
        -- `source: String` so the equality is direct. The
        -- ScanBuiltinExtractDir rule above writes `Builtin(path: ...)` as
        -- shorthand for "source = 'Builtin', path = ..." -- the model
        -- treats source as opaque.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Both source variants imply a readable file on disk after extraction.
-- For Filesystem this is the user's authored SKILL.md; for Builtin it is
-- the file written by ExtractBuiltinAssets at server startup.
invariant SourceImpliesReadableFile {
    for skill in Skills:
        file_exists(skill.path) and is_readable(skill.path)
}

-- Filesystem skills always shadow built-ins of the same name. The catalog
-- never contains both a filesystem and a built-in entry with the same name.
-- Enforced by construction: the discovery sequence runs the filesystem
-- walk first, registers each filesystem skill by name, then scans the
-- builtin extract dir with a name-dedup guard (see ScanBuiltinExtractDir
-- rule above: `not name_taken(catalog, ...)`). A structural invariant
-- here would be redundant with the rule's precondition.

-- The existing SkillNamesUnique invariant from skills.allium remains in
-- force and is reinforced here: built-ins do not break name uniqueness
-- because they are filtered by the same name-dedup as filesystem skills.

rule IgnoreRemovedBuiltinDirectories {
    when: DiscoverBuiltins(builtin_dir)

    ensures: for child_dir in immediate_subdirectories(builtin_dir)
             where basename(child_dir) not in current_builtin_name:
        no Skill.discovered(path: child_dir + "/SKILL.md")

    @guidance
        -- Extraction prunes files only inside names that remain embedded.
        -- A directory for a removed or renamed built-in may remain on disk,
        -- but the immutable embedded-name allowlist keeps it undiscoverable.
}

rule BuiltinAvailabilityHasNoDisableConfiguration {
    when: DiscoverSkills(working_dir)

    ensures: for name in current_builtin_name
             where not name_taken(filesystem_catalog, name)
               and is_readable(builtin_dir + "/" + name + "/SKILL.md")
               and extracted_bytes(builtin_dir + "/" + name + "/SKILL.md") = embedded_bytes(name):
        exists Skill.discovered(name: name, source: "Builtin")

    @guidance
        -- Phoenix has no built-in disable configuration. A valid filesystem
        -- skill with the same name replaces the built-in by the normal
        -- filesystem-wins precedence rule; an invalid or empty SKILL.md is
        -- ignored and therefore does not disable the built-in.
}
