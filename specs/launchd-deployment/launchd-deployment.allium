-- allium: 3
-- Native macOS deployment: REQ-LDD-001–007,009–016,029–032.
-- Withdrawn IDs grant no alternate deployment or recovery route.

config {
    migration_timeout_seconds: Integer = 600
}

enum SourceKind { local_head | published_release }
enum TransactionState {
    preparing | prepared | stopping | migration_started | starting | verifying
    | publishing | committed | precondition_failed | failed | rejected_concurrent
}
enum RestartState {
    preparing | prepared | restarting | committed
    | precondition_failed | restart_failed | rejected_concurrent
}

value RuntimeIdentity {
    version: String
    git_sha: String
}

entity DeployTransaction {
    id: String
    source_kind: SourceKind
    source_commit: String
    expected: RuntimeIdentity
    state: TransactionState
    failure: String?

    transitions state {
        preparing -> prepared
        preparing -> precondition_failed
        preparing -> rejected_concurrent
        prepared -> stopping
        prepared -> precondition_failed
        stopping -> migration_started
        migration_started -> starting
        starting -> verifying
        verifying -> publishing
        publishing -> committed
        stopping -> failed
        migration_started -> failed
        starting -> failed
        verifying -> failed
        publishing -> failed
        terminal: committed, precondition_failed, failed, rejected_concurrent
    }
}

entity RestartTransaction {
    id: String
    expected: RuntimeIdentity?
    previous_pid: Integer?
    running_pid: Integer?
    state: RestartState
    created_at: Timestamp
    updated_at: Timestamp
    failure: String?

    transitions state {
        preparing -> prepared
        preparing -> precondition_failed
        preparing -> rejected_concurrent
        prepared -> restarting
        prepared -> precondition_failed
        prepared -> rejected_concurrent
        restarting -> committed
        restarting -> restart_failed
        terminal: committed, precondition_failed, restart_failed,
                  rejected_concurrent
    }
}

-- TargetService is a read-only observation of the host launchd job.
value TargetService {
    label: String
    loaded: Boolean
    running_pid: Integer?
    identity: RuntimeIdentity?
}

-- Helpers
-- activation_claim_available() -> Boolean
--   No deploy/restart marker exists. A terminal status never reclaims a marker.
-- preparation_complete(transaction) -> Boolean
--   Protocol 2, exact local/published source, SHA-256 and --build-identity,
--   full candidate SHA, complete plist/environment/path binding and atomic
--   installation preparations verify without production database access.
-- helper_is_launchd_owned(transaction) -> Boolean
--   Independent one-shot helper owns activation and the matching operation lock.
-- exact_candidate_running(transaction, service) -> Boolean
--   A new stable job PID serves exactly the candidate version and full source SHA.
-- owned_claim_retained(transaction) -> Boolean
--   Unresolved deployment retains its matching marker; terminal status does not
--   grant reclamation. Completed release is not undone by later interruption.
-- transaction_evidence_retained(transaction) -> Boolean
--   Manifest, helper, log, private plist and failed candidate evidence remain.
-- deployment_without_database_controller(transaction) -> Boolean
--   No deployment-side database scans, registry parsing, snapshots or rehearsals.
-- NoPredecessorStartupOrDatabaseRestore(transaction) -> Boolean
--   Deployment never restores a database or starts a previous runtime.
-- FailureText(phase, error, stop_error) -> String
--   One human-readable failed phase/error plus any failed teardown observation.
-- restart_preparation_complete(restart) -> Boolean
--   The loaded target job reports the installed plist and binary program,
--   KeepAlive, and the sole listener service used by its health endpoint; the
--   running process reports that it adopted the listener, its running and
--   installed binary identities contain the same complete 40-character SHA and
--   match the deployed source identity, and the secret-free handoff contains
--   hashes of the installed binary, plist, and deployed SHA without environment
--   values. A rollback-only 12-character predecessor is not restartable.
-- restart_helper_is_launchd_owned(restart) -> Boolean
--   A distinct one-shot LaunchAgent owns signaling and verification
--   independently of Phoenix and the initiating shell.
-- exact_restarted_identity_running(restart, service) -> Boolean
--   The target job has a PID distinct from restart.previous_pid and
--   /api/version equals restart.expected and reports socket activation.
-- installed_state_unchanged(restart) -> Boolean
--   Binary, plist, environment, listener definition, and deployed SHA match
--   their preparation hashes and no installation path was replaced.


rule AcquirePreparationClaim {
    when: DeploymentRequested(transaction)
    requires: transaction.state = preparing
    requires: activation_claim_available()
    ensures: DeploymentOwnsActivationClaim(transaction)
    ensures: DurablePreparingStatusWritten(transaction)
}

rule RejectConcurrentDeployment {
    when: DeploymentRequested(transaction)
    requires: transaction.state = preparing
    requires: not activation_claim_available()
    ensures: transaction.state = rejected_concurrent
    ensures: ProductionStateUnchanged(transaction)
}

rule PrepareCandidate {
    when: CandidatePreparationCompleted(transaction)
    requires: transaction.state = preparing
    requires: preparation_complete(transaction)
    ensures: transaction.state = prepared
    ensures: ActivationHandedToLaunchd(transaction)
}

rule FailBeforeDisruption {
    when: PreparationFailed(transaction, error)
    requires: transaction.state in { preparing, prepared }
    ensures: transaction.state = precondition_failed
    ensures: transaction.failure = error
    ensures: ProductionStateUnchanged(transaction)
    ensures: DurableStatusWritten(transaction)
    ensures: OnlyOwnedClaimReleased(transaction)
}

rule ActivateCandidate {
    when: ActivationHelperStarted(transaction)
    requires: transaction.state = prepared
    requires: preparation_complete(transaction)
    requires: helper_is_launchd_owned(transaction)
    requires: DeploymentOwnsActivationClaim(transaction)
    ensures: transaction.state = stopping
    ensures: CanonicalPlistQuarantined(transaction)
    ensures: PredecessorStopRequested(transaction)

    @guidance
        -- Stage atomic binary install and the private-plist publication hard link
        -- before disruption. Persist stopping; quarantine/fsync the canonical
        -- plist into previous.plist before observed bootout. Never replay activation.
}

rule BeginCandidateMigration {
    when: PredecessorStopped(transaction)
    requires: transaction.state = stopping
    ensures: CandidateBinaryInstalledAtomically(transaction)
    ensures: transaction.state = migration_started
    ensures: DurableStatusWritten(transaction)
    ensures: CandidateMigrationInvokedOnce(transaction, config.migration_timeout_seconds)

    @guidance
        -- The durable marker precedes exact candidate --migrate-only. Use the
        -- staged environment and inherited log output. The helper never opens DB.
}

rule BeginCandidateStartup {
    when: CandidateMigrationSucceeded(transaction)
    requires: transaction.state = migration_started
    ensures: transaction.state = starting
    ensures: PrivateCandidatePlistBootstrapped(transaction)
}

rule VerifyCandidate {
    when: CandidateProcessStarted(transaction)
    requires: transaction.state = starting
    ensures: transaction.state = verifying
    ensures: ExactIdentityAndStablePidCheckRequested(transaction)
}

rule PublishVerifiedCandidate {
    when: CandidateRuntimeObserved(transaction, service)
    requires: transaction.state = verifying
    requires: exact_candidate_running(transaction, service)
    ensures: transaction.state = publishing
    ensures: SameInodePlistPublicationRequested(transaction)
}

rule CommitVerifiedCandidate {
    when: CandidatePublicationCompleted(transaction)
    requires: transaction.state = publishing
    ensures: DeployedShaWritten(transaction)
    ensures: transaction.state = committed
    ensures: DurableStatusWritten(transaction)
    ensures: OnlyOwnedClaimReleaseRequested(transaction)

    @guidance
        -- Durable committed is terminal for runtime behavior. Claim release and
        -- reporting are best effort; errors preserve committed and the healthy
        -- job. Retain binary copies if release does not complete, leave any
        -- surviving claim for operator inspection, and never recreate a claim.
}

rule CleanCommittedCopies {
    when: OwnedClaimReleased(transaction)
    requires: transaction.state = committed
    ensures: TemporaryCandidateAndPreviousBinaryCleanupAttempted(transaction)

    @guidance
        -- Cleanup errors attempt a warning and preserve committed and the job.
        -- Warning or success-report output failure cannot fail activation.
        -- Retain the private plist/helper/manifest/log as transaction evidence.
}

rule StopAndRetainFailedDeployment {
    when: ActivationFailed(transaction, phase, error, stop_error)
    requires: transaction.state in { stopping, migration_started, starting, verifying, publishing }
    ensures: TargetStopAttempted(transaction)
    ensures: PublishedCandidatePlistRemovalAttempted(transaction)
    ensures: transaction.state = failed
    ensures: transaction.failure = FailureText(phase, error, stop_error)
    ensures: DurableStatusWritten(transaction)
    ensures: owned_claim_retained(transaction)
    ensures: transaction_evidence_retained(transaction)
    ensures: ManualOperatorRecoveryRequired(transaction)

    @guidance
        -- Publication failure before durable committed stops and retains ownership.
        -- Inspect actual target/helper state; stop failure remains explicit.
        -- No predecessor start, database restore, replay, resume or finalization.
}

rule PrepareInstalledRestart {
    when: RestartRequested(restart)
    requires: activation_claim_available()
    ensures: restart.state = prepared
    ensures: restart_preparation_complete(restart)
}

rule RejectConcurrentRestart {
    when: RestartRequested(restart)
    requires: not activation_claim_available()
    ensures: restart.state = rejected_concurrent
    ensures: installed_state_unchanged(restart)
    ensures: TargetServiceUnchanged(restart)
}

rule HandoffRestart {
    when: restart: RestartTransaction.state transitions_to prepared
    requires: restart_preparation_complete(restart)
    ensures: restart_helper_is_launchd_owned(restart)
    ensures: RestartHandedOff(restart)
}

rule RestartInstalledRuntime {
    when: RestartHelperStarted(restart)
    requires: restart.state = prepared
    requires: restart_helper_is_launchd_owned(restart)
    requires: restart_preparation_complete(restart)
    ensures: RestartSignalSentWithoutTargetUnload(restart)
    ensures: restart.state = restarting
}

rule CommitVerifiedRestart {
    when: RestartRuntimeObserved(restart, service)
    requires: restart.state = restarting
    requires: exact_restarted_identity_running(restart, service)
    requires: installed_state_unchanged(restart)
    ensures: restart.running_pid = service.running_pid
    ensures: restart.state = committed
    ensures: DurableRestartStatusWritten(restart)
}

rule PreserveRestartFailure {
    when: RestartVerificationFailed(restart, failure)
    requires: restart.state = restarting
    ensures: restart.failure = failure
    ensures: restart.state = restart_failed
    ensures: DurableRestartStatusWritten(restart)
    ensures: not RollbackClaimed(restart)
}


invariant ExactCandidateSource {
    for transaction in DeployTransactions:
        transaction.expected.git_sha = transaction.source_commit
}

invariant FailedDeploymentRetainsOwnership {
    for transaction in DeployTransactions:
        transaction.state = failed implies
            owned_claim_retained(transaction) and transaction_evidence_retained(transaction)
}

invariant CandidateOwnsDatabase {
    for transaction in DeployTransactions:
        deployment_without_database_controller(transaction)
        and NoPredecessorStartupOrDatabaseRestore(transaction)
}

invariant CommittedRestartPreservesInstalledState {
    for restart in RestartTransactions:
        restart.state = committed implies installed_state_unchanged(restart)
}

surface DeploymentOperator {
    context transaction: DeployTransaction
    provides:
        DeploymentRequested(transaction)
    exposes:
        transaction.state
        transaction.failure

    @guarantee ManualRecovery
        -- Inspect logs/evidence and actual service/helper state. Preserve failed
        -- transaction; confirm helper absence before explicit operator marker
        -- clearance and a new chosen forward deployment. Older binary requires
        -- offline matching database restore. No automatic retained-helper replay.
}

surface ActivationObservations {
    context transaction: DeployTransaction
    provides:
        CandidatePreparationCompleted(transaction)
        PreparationFailed(transaction, error: String)
        ActivationHelperStarted(transaction)
        PredecessorStopped(transaction)
        CandidateMigrationSucceeded(transaction)
        CandidateProcessStarted(transaction)
        CandidateRuntimeObserved(transaction, service: TargetService)
        CandidatePublicationCompleted(transaction)
        OwnedClaimReleased(transaction)
        ActivationFailed(transaction, phase: String, error: String, stop_error: String?)
}

surface RestartObservations {
    context restart: RestartTransaction
    provides:
        RestartRequested(restart)
        RestartHelperStarted(restart)
        RestartRuntimeObserved(restart, service: TargetService)
        RestartVerificationFailed(restart, failure: String)
}
