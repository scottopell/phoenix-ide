-- allium: 3
-- Native macOS launchd deployment lifecycle
-- Requirement traceability: REQ-LDD-001 through REQ-LDD-023
-- REQ-LDD-023 ordinary forward boundary applies only to an exact 123 -> 127 qualification.

config {
    transition_timeout_seconds: Integer = 30
    health_timeout_seconds: Integer = 120
    stale_after_seconds: Integer = 390
}

enum TransactionState {
    preparing | prepared | activating | committed |
    precondition_failed | activation_failed_rolled_back |
    activation_failed_rollback_failed | ordinary_activation_failed_rollback_failed |
    ordinary_forward_only_failed | rejected_concurrent
}
enum RestartState {
    preparing | prepared | restarting | committed |
    precondition_failed | restart_failed | rejected_concurrent
}

value RuntimeIdentity {
    version: String
    git_sha: String
}

value PreparedArtifactProof {
    controller_source_commit: String
    controller_helper_hash: String
    shared_database_path: String
    migration_ledger_version: Integer
}

entity PreparedArtifactLifecycleObservation {
    kind: PreparedArtifactAwaitingPreparation | PreparedArtifactPreflight | PreparedArtifactOfflineOwned
        | PreparedArtifactSnapshotVerified
}

variant PreparedArtifactAwaitingPreparation : PreparedArtifactLifecycleObservation {}

variant PreparedArtifactPreflight : PreparedArtifactLifecycleObservation {
    prepared_artifact_proof: PreparedArtifactProof
}

variant PreparedArtifactOfflineOwned : PreparedArtifactLifecycleObservation {
    prepared_artifact_proof: PreparedArtifactProof
    offline_ownership_proof: String
}

variant PreparedArtifactSnapshotVerified : PreparedArtifactLifecycleObservation {
    prepared_artifact_proof: PreparedArtifactProof
    offline_ownership_proof: String
    snapshot_integrity_proof: String
}


value CurrentSchemaPreflightProof {
    shared_database_path: String
    controller_source_commit: String
    controller_helper_path: String
    controller_helper_sha256: String
    candidate_migration_registry_path: String
    candidate_migration_registry_sha256: String
    source_ledger: String
}

value CurrentSchemaSnapshotProof {
    preflight: CurrentSchemaPreflightProof
    snapshot_sha256: String
    source_logical_contents: String
    target_ledger: String
    transaction_id: String
    candidate_identity: RuntimeIdentity
    predecessor_identity: RuntimeIdentity
}

entity CurrentSchemaLifecycleObservation {
    kind: CurrentSchemaAwaitingPreparation | CurrentSchemaPreflight
        | CurrentSchemaOfflineOwned | CurrentSchemaSnapshotVerified
}

variant CurrentSchemaAwaitingPreparation : CurrentSchemaLifecycleObservation {}
variant CurrentSchemaPreflight : CurrentSchemaLifecycleObservation {
    proof: CurrentSchemaPreflightProof
}
variant CurrentSchemaOfflineOwned : CurrentSchemaLifecycleObservation {
    proof: CurrentSchemaPreflightProof
    offline_ownership_proof: String
}
variant CurrentSchemaSnapshotVerified : CurrentSchemaLifecycleObservation {
    proof: CurrentSchemaSnapshotProof
    offline_ownership_proof: String
}

enum CurrentSchemaDatabaseState {
    unknown | source_unchanged | writes_committed | target_verified
}

-- A migration_started checkpoint is irreversible even if the subprocess exits
-- without an observed write.
enum CurrentSchemaMigrationInvocation {
    unknown | not_invoked | migration_started
}

enum PairedRecoveryMode { snapshot_restored | unchanged_predecessor }

enum FinalizationOutcome { not_committed | pending | complete }

entity DeployTransaction {
    id: String
    kind: LocalHeadDeployment | PublishedReleaseDeployment | PreparedArtifactDeployment | CurrentSchemaDeployment
    source_commit: String
    expected: RuntimeIdentity
    previous: RuntimeIdentity?
    state: TransactionState
    created_at: Timestamp
    updated_at: Timestamp
    failure: String?
    rollback_failure: String?

    transitions state {
        preparing -> prepared
        preparing -> precondition_failed
        preparing -> rejected_concurrent
        prepared -> activating
        prepared -> precondition_failed
        prepared -> activation_failed_rolled_back
        prepared -> activation_failed_rollback_failed
        activating -> committed
        activating -> activation_failed_rolled_back
        activating -> activation_failed_rollback_failed
        activating -> ordinary_activation_failed_rollback_failed
        activating -> ordinary_forward_only_failed
        ordinary_forward_only_failed -> activating
        activation_failed_rollback_failed -> activation_failed_rolled_back
        activation_failed_rollback_failed -> activation_failed_rollback_failed
        terminal: committed, precondition_failed, activation_failed_rolled_back,
                  ordinary_activation_failed_rollback_failed, rejected_concurrent
    }
}

variant LocalHeadDeployment : DeployTransaction {}

variant PublishedReleaseDeployment : DeployTransaction {
    release_tag: String
}

variant PreparedArtifactDeployment : DeployTransaction {
    paired_lifecycle_observation: PreparedArtifactLifecycleObservation
    finalization: FinalizationOutcome
    recovery_mode: PairedRecoveryMode?
}

variant CurrentSchemaDeployment : DeployTransaction {
    current_lifecycle_observation: CurrentSchemaLifecycleObservation
    database_state: CurrentSchemaDatabaseState
    migration_invocation: CurrentSchemaMigrationInvocation
    finalization: FinalizationOutcome
}


entity RestartTransaction {
    id: String
    expected: RuntimeIdentity?
    previous_pid: Integer?
    running_pid: Integer?
    state: RestartState
    created_at: Timestamp
    updated_at: Timestamp
    failure: String?

    transitions state {
        preparing -> prepared
        preparing -> precondition_failed
        preparing -> rejected_concurrent
        prepared -> restarting
        prepared -> precondition_failed
        prepared -> rejected_concurrent
        restarting -> committed
        restarting -> restart_failed
        terminal: committed, precondition_failed, restart_failed,
                  rejected_concurrent
    }
}

external entity TargetService {
    label: String
    loaded: Boolean
    running_pid: Integer?
    identity: RuntimeIdentity?
}

-- Helpers
--
-- preparation_complete(transaction) -> Boolean
--   Candidate binary, plist, rollback inputs, hashes, signature, manifest and
--   embedded identity are valid and host-resident; persisted metadata contains
--   no plist environment values.
-- helper_capacity_reserved(transaction) -> Boolean
--   After handoff, the helper physically reserves private snapshot and restore
--   capacity for DB plus WAL and margin before production stop. True for
--   ordinary sources, whose prepared runtime capacity is already held. Current
--   schema reserves both backup and restore space after install overhead, with
--   at least 20 GiB free remaining on every affected filesystem.
-- HelperCapacityVerified(transaction)
--   Emitted by the independent helper after successful capacity reservation.
-- activation_claim_available() -> Boolean
--   No active or unresolved deployment or restart owns the host-level claim.
-- helper_is_launchd_owned(transaction) -> Boolean
--   A distinct one-shot LaunchAgent owns activation independently of Phoenix.
-- atomic_candidate_install(transaction) -> Boolean
--   Fsynced destination-filesystem artifacts replace the binary by rename.
--   Ordinary plist publication is complete; both prepared-artifact modes retain
--   a private bootstrap and atomic publication link until verified candidate commit.
-- exact_identity_running(service, identity) -> Boolean
--   The job has a PID, /api/version equals both identity fields, and the
--   candidate git_sha is the complete 40-character source commit rather than a
--   matching prefix.
-- exact_previous_restored(transaction, service) -> Boolean
--   Previous runtime artifacts are atomically restored and the captured
--   previous identity runs. Its git_sha may be exactly 12 or 40 lowercase
--   hexadecimal characters only because it identifies the already-installed
--   rollback predecessor. Database restoration is feature-scoped and is
--   represented by paired_predecessor_start_order_is_valid.
-- selected_source_is_valid(transaction) -> Boolean
--   Local source is exact checked HEAD, or release source is one resolved tag
--   and commit with a host-architecture asset matching its checksum and version.
--   A latest selection resolves to stable tag and metadata; an exact RC selection
--   has matching tag, prerelease metadata, full embedded version, and commit. In
--   either case the candidate's 40-character lowercase embedded git_sha equals
--   source_commit. Both prepared-artifact modes independently verify the receipt,
--   signing, notarization and exact identity; neither accepts release or runtime-only source.
-- prepared_artifact_source_is_valid(transaction) -> Boolean
--   True for ordinary sources. For both prepared-artifact modes, the protected host-target
--   candidate identity and receipt contents are valid; the operator establishes
--   protected run/source association independently of JSON validation. Clean
--   controller source/helper hash is independently verified, not receipt-derived.
--   Source-only evidence does not assert database lifecycle observations.
-- paired_database_preflight_is_valid(transaction) -> Boolean
--   True for ordinary and current-schema sources. For paired legacy, the immutable proof has
--   Candidate and captured predecessor configure the same canonical path; the
--   single shared_database_path is that value. The proof includes
--   legacy-schema eligibility, one canonical database path shared by the
--   installed predecessor and candidate, migration ledger at most 69, and the ProductConversation
--   upgrade mode. It does not assert that quiesce, offline ownership, or a
--   snapshot has happened.
-- current_schema_preflight_is_valid(transaction) -> Boolean
--   True for ordinary and paired legacy. CurrentSchemaDeployment is an explicit
--   prepared_artifact mode with exact canonical DB path shared by predecessor
--   and candidate, retained controller helper path/SHA-256 and candidate migration
--   registry path/SHA-256 bound to the immutable transaction. The source ledger
--   equals the complete qualified ordered ledger through 123, not merely MAX=123;
--   absent, unknown, mismatched, gapped or newer entries reject. Required
--   ProductConversation tables, SQLite integrity and foreign keys pass before
--   disruption. No release or runtime-only source can select this mode.
-- current_schema_snapshot_is_valid(transaction, proof) -> Boolean
--   Proof matches the retained preflight and transaction. Offline exclusive
--   DB/WAL/SHM ownership follows service stop; SQLite backup
--   API snapshot in a private directory has verified hash, logical source contents
--   and durable proof bound to source 123 and target 127 ledgers, path, exact
--   controller/helper/candidate/predecessor identities and transaction ID.
--   No candidate migration or startup precedes this proof.
-- current_schema_source_unchanged(transaction) -> Boolean
--   After confirmed target stop and renewed exclusive DB/WAL/SHM ownership,
--   immediately before replay, re-read the exact source 123 ledger and logical
--   contents and compare them to the bound snapshot proof. Stale preflight or
--   snapshot observations and ambiguous contents do not satisfy this check.
-- current_schema_recovery_verified(transaction) -> Boolean
--   Matching snapshot and source ledger/logical contents, predecessor binary,
--   private loaded configuration and running identity were checked after restore;
--   durable status precedes release of only the owned claim.
-- current_schema_target_verified(transaction) -> Boolean
--   The exact full target ledger through 127, SQLite integrity and foreign keys
--   were durably checked after the candidate's bounded offline --migrate-only;
--   exclusive database ownership remains proven before runtime traffic.
-- current_schema_migration_failure_is_fenced(transaction) -> Boolean
--   After offline migration is invoked, even if its failed process appears to
--   leave the source ledger and contents unchanged, predecessor startup and
--   snapshot replay are forbidden. Retain the claim and exact compatible
--   candidate artifacts. Persist candidate start/publication pending when the
--   target is verified, otherwise migration repair required.
-- current_schema_finalization_context_is_valid(transaction) -> Boolean
--   Retained immutable transaction, matching owned claim, absent activation
--   helper, byte-bound controller helper/candidate/private plist, durable exact
--   target ledger commit proof and exclusive operation lock all re-verify
--   before any candidate startup. It does not repeat offline migration.
-- ordinary_forward_boundary_qualified(transaction) -> Boolean
--   Only ordinary local HEAD or published release deployment with an exact
--   complete migration-123 source ledger and exact migration-127 candidate
--   registry. The exact registry, candidate identity/configuration and helper
--   are retained with the transaction; no standalone database backup is required.
-- ordinary_forward_no_start_proven(transaction) -> Boolean
--   Affirmative durable proof that the candidate has never had a start attempt.
--   Missing or ambiguous start evidence is not proof; once attempted, this
--   predicate cannot become true again even after a failed resume.
-- ordinary_forward_start_attempt_recorded(transaction) -> Boolean
--   Durable first-attempt checkpoint precedes candidate bootstrap and remains
--   retained across interruption and all resume attempts.
-- ordinary_forward_resume_context_is_valid(transaction) -> Boolean
--   Explicit operator authorization, matching ownership claim and retained
--   transaction/helper, exact candidate binary/configuration and registry,
--   stopped target and exclusive operation lock all re-verify before startup.
-- ordinary_forward_failure_fenced(transaction) -> Boolean
--   Candidate teardown is attempted and the target remains stopped when possible;
--   failure to confirm stop is reported explicitly, never treated as safe to
--   restart. Candidate binary/configuration, helper, registry and transaction
--   evidence remain retained with the ownership fence; no predecessor launch or
--   database rollback is authorized.
-- current_schema_predecessor_recovery_is_valid(transaction) -> Boolean
--   The retained durable invocation history proves --migrate-only was never
--   invoked; missing or ambiguous history refuses recovery. After confirmed
--   target teardown and renewed exclusive ownership, the exact source ledger
--   and logical contents must be rechecked against the matching snapshot proof
--   immediately before replay. Only then may the matching snapshot and captured
--   predecessor binary/configuration be restored and verified.

-- paired_database_proof_is_valid(transaction) -> Boolean
--   True for ordinary and current-schema sources. For paired legacy, after quiesce the lifecycle
--   observation is PreparedArtifactSnapshotVerified: exclusive offline ownership
--   and verified SQLite snapshot integrity bound to the immutable controller,
--   predecessor and shared path. No future rollback result is required.
-- controller_identity_is_independently_bound(transaction) -> Boolean
--   True for ordinary sources. For both prepared-artifact modes, the controller helper hash
--   is bound to the recorded clean controller source and protocol. The controller
--   and candidate commits may be equal when that independently bound helper is
--   valid.
-- PairedRecoveryVerified(transaction, service, mode)
--   Separately requested retained-helper recovery verified matched database,
--   runtime/configuration and predecessor identity before releasing ownership.
-- CandidateStartupReady(transaction)
--   Emitted after quiesce and paired snapshot proof, or after current-schema
--   migration reached durably verified target 127; ordinary sources use preparation.
-- candidate_startup_proof_is_valid(transaction) -> Boolean
--   True for ordinary sources. Paired legacy requires paired_database_proof_is_valid.
--   Current schema requires a durable matching snapshot proof, exact target 127
--   ledger and integrity/FK verification after offline migration. In both modes
--   exclusive offline ownership precedes snapshot and candidate startup.
-- paired_predecessor_start_order_is_valid(transaction) -> Boolean
--   True for ordinary sources. For prepared_artifact, the matching database is
--   restored and integrity-checked before predecessor startup, or no snapshot
--   exists and exclusive legacy DB plus captured binary/config hashes prove
--   an unchanged predecessor. The latter path claims no database restoration.
-- predecessor_start_authorized(transaction) -> Boolean
--   Startup requires matched snapshot restoration or verified unchanged legacy
--   database/runtime/configuration with exclusive offline ownership.
-- candidate_teardown_attempted(transaction) -> Boolean
--   Failed activation or recovery records an attempt to tear down the candidate;
--   this does not claim that an operating-system failure made teardown complete.
-- recovery_verification_unconfirmed(transaction) -> Boolean
--   Durable status reports that recovery or teardown could not be confirmed,
--   including when a predecessor health check failed after an attempted start.
-- paired_transaction_retained(transaction) -> Boolean
--   The private paired transaction directory, verified snapshot, proof files,
--   and durable recovery status remain available for supported recovery.
-- active_claim_retained(transaction) -> Boolean
--   The matching deployment claim remains active until supported recovery is
--   verified; a blind manual action cannot clear it.
-- supported_recovery_verified(transaction) -> Boolean
--   A supported recovery procedure has verified the restored artifacts, matching
--   database, service health, and claim generation before claim release.
-- previous_rollback_identity_is_valid(transaction) -> Boolean
--   No previous runtime exists, or previous is the captured already-installed
--   predecessor and its git_sha is exactly 12 or 40 lowercase hexadecimal
--   characters. The 12-character form is not valid for any candidate or helper.
-- restart_preparation_complete(restart) -> Boolean
--   The loaded target job reports the installed plist and binary program,
--   KeepAlive, and the sole listener service used by its health endpoint; the
--   running process reports that it adopted the listener, its running and
--   installed binary identities contain the same complete 40-character SHA and
--   match the deployed source identity, and the secret-free handoff contains
--   hashes of the installed binary, plist, and deployed SHA without environment
--   values. A rollback-only 12-character predecessor is not restartable.
-- restart_helper_is_launchd_owned(restart) -> Boolean
--   A distinct one-shot LaunchAgent owns signaling and verification
--   independently of Phoenix and the initiating shell.
-- exact_restarted_identity_running(restart, service) -> Boolean
--   The target job has a PID distinct from restart.previous_pid and
--   /api/version equals restart.expected and reports socket activation.
-- installed_state_unchanged(restart) -> Boolean
--   Binary, plist, environment, listener definition, and deployed SHA match
--   their preparation hashes and no installation path was replaced.

-- paired_snapshot_restored(transaction) -> Boolean
--   A context-bound snapshot was restored and integrity-checked offline.
-- paired_unchanged_predecessor_verified(transaction) -> Boolean
--   No snapshot proof or candidate mutation exists; stopped service, exclusive
--   legacy DB, and captured binary/configuration hashes authorize private resume.
-- paired_publication_is_verified(transaction) -> Boolean
--   Paired plists remain private during identity verification. Candidate autoload
--   publication follows durable commit; predecessor publication follows matched
--   DB authorization and identity verification. Publication preserves the private
--   bootstrap inode so strict loaded-path restart verification remains valid.
--   True for ordinary sources.
-- pre_manifest_abandonment_verified(transaction) -> Boolean
--   Matching preparing status preceded owned claim publication, manifest
--   is absent or exists; preparation PID is dead and no helper was admitted,
--   or a prepared/helper-handoff attempt ended with confirmed helper absence and
--   helper absence is confirmed. Manifest presence does not imply handoff.
-- PreparedAbandonmentVerified(transaction)
--   Operator requested recovery and pre_manifest_abandonment_verified holds.

-- snapshot_proof_durable(transaction) -> Boolean
--   Matching context-bound snapshot proof is persisted and verified before bootstrap.
-- DeploymentOwnsActivationClaim(transaction) -> Boolean
--   This exact transaction owns the shared deploy/restart operation mutex.
-- CandidatePreparationCompleted(transaction)
--   Fallible staging completed under the already acquired preparation claim.
-- PairedPreflightVerified(transaction, proof)
--   Legacy path/schema and independent source/controller preflight was verified.
-- PairedOfflineOwnershipVerified(transaction, ownership)
--   Service teardown and bounded exclusive offline ownership were verified.
-- PairedSnapshotVerified(transaction, snapshot)
--   Context-bound SQLite snapshot integrity was verified after offline ownership.
-- HelperCapacityFailed(transaction, failure)
--   Initial physical allocation failed after handoff but before target stop.
-- PairedFinalizationFinished(transaction, outcome)
--   Both publication and cleanup succeeded durably; failures use separate
--   PairedFinalizationFailed and retain pending.
-- DurablePreparingStatusWritten(transaction)
--   Matching preparation identity/PID is durable before ownership publication.

-- paired_precommit_autoload_safe(transaction) -> Boolean
--   While preparing, only captured predecessor may be auto-loaded. After helper
--   teardown/quarantine and before candidate commit, no candidate auto-loaded
--   plist exists; verified candidate bootstrap remains private.
-- paired_finalization_diagnostic_is_durable(transaction) -> Boolean
--   A pending finalization records publication/cleanup uncertainty
--   without asserting successful publication or authorizing DB rollback.

rule AcquirePreparationClaim {
    when: DeploymentRequested(transaction)
    requires: transaction.state = preparing
    requires: activation_claim_available()
    ensures: DurablePreparingStatusWritten(transaction)
    ensures: DeploymentOwnsActivationClaim(transaction)

    @guidance
        -- Persist preparation owner PID/status before publishing the claim.
}

rule PrepareCandidate {
    when: CandidatePreparationCompleted(transaction)
    requires: DeploymentOwnsActivationClaim(transaction)
    requires: selected_source_is_valid(transaction)
    requires: prepared_artifact_source_is_valid(transaction)
    requires: paired_database_preflight_is_valid(transaction)
    requires: current_schema_preflight_is_valid(transaction)
    requires: transaction.kind != PreparedArtifactDeployment
        or transaction.paired_lifecycle_observation.kind = PreparedArtifactPreflight
    requires: transaction.kind != CurrentSchemaDeployment
        or transaction.current_lifecycle_observation.kind = CurrentSchemaPreflight
    requires: controller_identity_is_independently_bound(transaction)
    requires: previous_rollback_identity_is_valid(transaction)
    requires: transaction.kind not in { PreparedArtifactDeployment, CurrentSchemaDeployment }
        or transaction.previous != null
    ensures: transaction.state = prepared
    ensures: preparation_complete(transaction)
}

rule RejectConcurrentDeployment {
    when: DeploymentRequested(transaction)
    requires: not activation_claim_available()
    ensures: transaction.state = rejected_concurrent
    ensures: ProductionArtifactsUnchanged(transaction)
    ensures: TargetServiceUnchanged(transaction)
}

rule HandoffActivation {
    when: transaction: DeployTransaction.state transitions_to prepared
    requires: preparation_complete(transaction)
    ensures: helper_is_launchd_owned(transaction)
    ensures: ActivationHandedOff(transaction)

    @guidance
        -- Bootstrap the distinct one-shot helper and report handoff before the
        -- target LaunchAgent is stopped. The initiating process may then end.
}

rule ObservePreparedPreflight {
    when: PairedPreflightVerified(transaction, proof)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state = preparing
    requires: transaction.paired_lifecycle_observation.kind = PreparedArtifactAwaitingPreparation
    ensures: transaction.paired_lifecycle_observation = PreparedArtifactPreflight.created(
        prepared_artifact_proof: proof
    )
}

rule ObserveOfflineOwnership {
    when: PairedOfflineOwnershipVerified(transaction, ownership)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state = activating
    requires: transaction.paired_lifecycle_observation.kind = PreparedArtifactPreflight
    ensures: transaction.paired_lifecycle_observation = PreparedArtifactOfflineOwned.created(
        prepared_artifact_proof: transaction.paired_lifecycle_observation.prepared_artifact_proof,
        offline_ownership_proof: ownership
    )
}

rule ObserveSnapshotProof {
    when: PairedSnapshotVerified(transaction, snapshot)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state = activating
    requires: transaction.paired_lifecycle_observation.kind = PreparedArtifactOfflineOwned
    ensures: transaction.paired_lifecycle_observation = PreparedArtifactSnapshotVerified.created(
        prepared_artifact_proof: transaction.paired_lifecycle_observation.prepared_artifact_proof,
        offline_ownership_proof: transaction.paired_lifecycle_observation.offline_ownership_proof,
        snapshot_integrity_proof: snapshot
    )
    ensures: PairedSnapshotProofPersisted(transaction)
}

rule ObserveCurrentSchemaPreflight {
    when: CurrentSchemaPreflightVerified(transaction, proof)
    requires: transaction.kind = CurrentSchemaDeployment
    requires: transaction.state = preparing
    requires: transaction.current_lifecycle_observation.kind = CurrentSchemaAwaitingPreparation
    requires: current_schema_preflight_is_valid(transaction)
    ensures: transaction.current_lifecycle_observation = CurrentSchemaPreflight.created(proof: proof)
}

rule ObserveCurrentSchemaOfflineOwnership {
    when: CurrentSchemaOfflineOwnershipVerified(transaction, ownership)
    requires: transaction.kind = CurrentSchemaDeployment
    requires: transaction.state = activating
    requires: helper_capacity_reserved(transaction)
    requires: transaction.current_lifecycle_observation.kind = CurrentSchemaPreflight
    ensures: transaction.current_lifecycle_observation = CurrentSchemaOfflineOwned.created(
        proof: transaction.current_lifecycle_observation.proof,
        offline_ownership_proof: ownership
    )

    @guidance
        -- Stop the service only after exact ledger/table/integrity/FK checks and
        -- physical backup/restore reservation leave 20 GiB free per filesystem.
        -- Prove exclusive ownership of DB, WAL and SHM before snapshot.
}

rule ObserveCurrentSchemaSnapshot {
    when: CurrentSchemaSnapshotVerifiedEvent(transaction, proof)
    requires: transaction.kind = CurrentSchemaDeployment
    requires: transaction.state = activating
    requires: transaction.current_lifecycle_observation.kind = CurrentSchemaOfflineOwned
    requires: current_schema_snapshot_is_valid(transaction, proof)
    ensures: transaction.current_lifecycle_observation = CurrentSchemaSnapshotVerified.created(
        proof: proof,
        offline_ownership_proof: transaction.current_lifecycle_observation.offline_ownership_proof
    )
    ensures: transaction.database_state = source_unchanged
    ensures: transaction.migration_invocation = not_invoked
    ensures: CurrentSchemaSnapshotProofPersisted(transaction)
}

rule BeginCurrentSchemaMigration {
    when: CurrentSchemaMigrationRequested(transaction)
    requires: transaction.kind = CurrentSchemaDeployment
    requires: transaction.state = activating
    requires: transaction.current_lifecycle_observation.kind = CurrentSchemaSnapshotVerified
    requires: transaction.database_state = source_unchanged
    requires: transaction.migration_invocation = not_invoked
    requires: snapshot_proof_durable(transaction)
    ensures: atomic_candidate_install(transaction)
    ensures: transaction.migration_invocation = migration_started
    ensures: transaction.database_state = unknown
    ensures: DurableStatusWritten(transaction)

    @guidance
        -- Persist migration_started durably before invoking the exact installed
        -- candidate's bounded --migrate-only on the manifest-bound database.
        -- Maintain exclusive ownership until target verification; no runtime traffic.
}

rule ObserveCurrentSchemaTarget {
    when: CurrentSchemaTargetLedgerVerified(transaction)
    requires: transaction.kind = CurrentSchemaDeployment
    requires: transaction.state = activating
    requires: transaction.current_lifecycle_observation.kind = CurrentSchemaSnapshotVerified
    requires: transaction.migration_invocation = migration_started
    requires: current_schema_target_verified(transaction)
    ensures: transaction.database_state = target_verified
    ensures: DurableStatusWritten(transaction)
}

rule FenceCurrentSchemaCommittedWrites {
    when: CurrentSchemaWritesCommitted(transaction)
    requires: transaction.kind = CurrentSchemaDeployment
    requires: transaction.state = activating
    requires: transaction.current_lifecycle_observation.kind = CurrentSchemaSnapshotVerified
    requires: transaction.migration_invocation = migration_started
    requires: transaction.database_state = unknown
    ensures: transaction.database_state = writes_committed
    ensures: current_schema_migration_failure_is_fenced(transaction)
    ensures: active_claim_retained(transaction)
    ensures: DurableStatusWritten(transaction)
}

rule FenceUncertainCurrentSchemaMigration {
    when: CurrentSchemaMigrationUncertain(transaction)
    requires: transaction.kind = CurrentSchemaDeployment
    requires: transaction.state = activating
    requires: transaction.migration_invocation = migration_started
    requires: transaction.database_state = unknown
    ensures: current_schema_migration_failure_is_fenced(transaction)
    ensures: active_claim_retained(transaction)
    ensures: DurableStatusWritten(transaction)
}

rule PreserveCurrentSchemaPendingCandidate {
    when: CurrentSchemaActivationInterrupted(transaction)
    requires: transaction.kind = CurrentSchemaDeployment
    requires: transaction.state in { activating, committed }
    requires: transaction.database_state = target_verified
    ensures: transaction.finalization = pending
    ensures: current_schema_migration_failure_is_fenced(transaction)
    ensures: active_claim_retained(transaction)
    ensures: DurableStatusWritten(transaction)
}

-- CurrentSchemaPreflightVerified(transaction, proof)
--   Carries the independently verified exact source ledger and immutable bindings.
-- CurrentSchemaOfflineOwnershipVerified(transaction, ownership)
--   Carries stopped-service and exclusive DB/WAL/SHM proof.
-- CurrentSchemaSnapshotVerifiedEvent(transaction, proof)
--   Carries private durable SQLite backup proof bound to the preflight and identities.
-- CurrentSchemaSnapshotProofPersisted(transaction)
--   Matching verified proof was fsynced before any migration.
-- CurrentSchemaMigrationRequested(transaction)
--   Durably records migration_started before invoking bounded --migrate-only
--   on the exact installed candidate. No later no-write exit clears this fence.
-- CurrentSchemaTargetLedgerVerified(transaction)
--   Exact target 127 ledger/integrity/FK proof is durable.
-- CurrentSchemaWritesCommitted(transaction)
--   A complete or partial DB write crossed the irreversible boundary.
-- CurrentSchemaMigrationUncertain(transaction)
--   After migration_started, an unproven write boundary fences predecessor
--   and snapshot replay, including an apparent unchanged-ledger exit.
-- CurrentSchemaActivationInterrupted(transaction)
--   Exact target ledger was verified, but start or publication remains pending.

rule ReserveHelperCapacity {
    when: HelperCapacityVerified(transaction)
    requires: transaction.state = prepared
    requires: helper_is_launchd_owned(transaction)
    ensures: helper_capacity_reserved(transaction)
    ensures: HelperCapacityReserved(transaction)
}

rule ActivateCandidate {
    when: HelperCapacityReserved(transaction)
    requires: transaction.state = prepared
    requires: helper_capacity_reserved(transaction)
    requires: helper_is_launchd_owned(transaction)
    requires: preparation_complete(transaction)
    ensures: transaction.state = activating

    @guidance
        -- Revalidate hashes and acquire the host lock. Stop/quiesce the predecessor
        -- and poll teardown; do not install/bootstrap the candidate here. Offline
        -- ownership/snapshot observations must precede CandidateStartupPrepared;
        -- current-schema migration and target verification also precede startup.
}

rule HelperCapacityFailureBeforeStop {
    when: HelperCapacityFailed(transaction, failure)
    requires: transaction.state = prepared
    requires: helper_is_launchd_owned(transaction)
    ensures: transaction.state = precondition_failed
    ensures: transaction.failure = failure
    ensures: ProductionArtifactsUnchanged(transaction)
    ensures: TargetServiceUnchanged(transaction)
    ensures: DurableStatusWritten(transaction)
}

-- PairedSnapshotProofPersisted(transaction)
--   The verified context-bound snapshot proof was atomically written and fsynced.

rule MarkOrdinaryForwardStartAttempt {
    when: OrdinaryForwardCandidateStartupRequested(transaction)
    requires: transaction.state = activating
    requires: ordinary_forward_boundary_qualified(transaction)
    requires: candidate_startup_proof_is_valid(transaction)
    ensures: ordinary_forward_start_attempt_recorded(transaction)
    ensures: DurableStatusWritten(transaction)

    @guidance
        -- Persist the first-attempt checkpoint before bootstrap. A missing or
        -- uncertain checkpoint cannot authorize predecessor rollback.
}

rule CandidateStartupPrepared {
    when: CandidateStartupReady(transaction)
    requires: transaction.state = activating
    requires: candidate_startup_proof_is_valid(transaction)
    requires: transaction.kind != PreparedArtifactDeployment
        or transaction.paired_lifecycle_observation.kind = PreparedArtifactSnapshotVerified
    requires: transaction.kind != CurrentSchemaDeployment
        or transaction.current_lifecycle_observation.kind = CurrentSchemaSnapshotVerified
    requires: transaction.kind not in { PreparedArtifactDeployment, CurrentSchemaDeployment }
        or snapshot_proof_durable(transaction)
    requires: transaction.kind != CurrentSchemaDeployment
        or transaction.database_state = target_verified
    requires: not ordinary_forward_boundary_qualified(transaction)
        or ordinary_forward_start_attempt_recorded(transaction)
    ensures: atomic_candidate_install(transaction)

    @guidance
        -- Only after snapshot proof (and, for current schema, offline migration
        -- plus exact target verification): bootstrap the private candidate plist,
        -- check result and poll PID to bounded deadline. Current schema already
        -- installed the candidate binary before --migrate-only.
}

rule CommitVerifiedCandidate {
    when: CandidateRuntimeObserved(transaction, service)
    requires: transaction.state = activating
    requires: exact_identity_running(service, transaction.expected)
    requires: candidate_startup_proof_is_valid(transaction)
    requires: transaction.kind != CurrentSchemaDeployment
        or transaction.database_state = target_verified
    requires: atomic_candidate_install(transaction)
    ensures: transaction.state = committed
    ensures: transaction.kind in { PreparedArtifactDeployment, CurrentSchemaDeployment }
        implies transaction.finalization = pending
    ensures: DeployedShaWritten(transaction.source_commit)
    ensures: DurableStatusWritten(transaction)

    @guidance
        -- Persist pending publication/cleanup diagnostic with durable commit.
        -- For paired legacy, after durable commit release only the temporary
        -- restore reservation and fsync its parent; retain audit snapshot/proof.
        -- Publish the prepared candidate plist last. Publication/cleanup errors
        -- remain committed diagnostics, do not authorize rollback, and do not
        -- establish login/reboot persistence when publication is unconfirmed.
}

rule ResumeCommittedPairedFinalization {
    when: PairedFinalizationRequested(transaction)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state = committed
    requires: transaction.finalization = pending
    requires: committed_finalization_context_is_valid(transaction)
    ensures: PairedFinalizationAttemptsResumed(transaction)

    @guidance
        -- Explicit finalize-paired verifies retained byte-bound helper, matching
        -- claim, helper absence, running exact candidate/binary/private loaded
        -- configuration and mutual exclusion. Retry only plist publication and
        -- temporary restore reservation cleanup; no stop/bootstrap/restart/DB IO.
        -- Pending survives interruption; durable completion releases owned claim.
}

-- committed_finalization_context_is_valid(transaction) -> Boolean
--   Exact retained transaction/helper/claim, absent prior helper, matching running
--   committed binary/config/identity and exclusive operation lock; unknown rejects.
-- PairedFinalizationRequested(transaction)
--   Operator invoked prod finalize-paired for a retained committed transaction.
-- PairedFinalizationAttemptsResumed(transaction)
--   Publication/cleanup attempts resumed without any runtime/database mutation.

rule PreserveFailedPairedFinalization {
    when: PairedFinalizationFailed(transaction, diagnostic)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state = committed
    requires: transaction.finalization = pending
    ensures: transaction.finalization = pending
    ensures: CommittedFinalizationDiagnosticWritten(transaction, diagnostic)
    ensures: DurableStatusWritten(transaction)
}

rule VerifyCompletedPairedFinalization {
    when: PairedFinalizationRequested(transaction)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state = committed
    requires: transaction.finalization = complete
    requires: completed_finalization_context_is_valid(transaction)
    ensures: transaction.finalization = complete
    ensures: IdempotentFinalizationConfirmed(transaction)

    @guidance
        -- Verify same retained candidate/binary/private configuration and published
        -- inode with absent prior helper, no competing claim. No mutation on rerun.
}

-- completed_finalization_context_is_valid(transaction) -> Boolean
--   Exact candidate/configuration and completed published inode, helper absent,
--   no competing claim; does not require an already released active claim.

rule RecordPairedFinalizationOutcome {
    when: PairedFinalizationFinished(transaction, outcome)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state = committed
    requires: transaction.finalization = pending
    requires: outcome = complete
    ensures: transaction.finalization = outcome
    ensures: DurableStatusWritten(transaction)

    @guidance
        -- Clear pending only after both publication and cleanup succeed durably.
        -- Errors remain committed diagnostics; interruption retains pending and claim.
}

rule ResumeCurrentSchemaFinalization {
    when: CurrentSchemaFinalizationRequested(transaction)
    requires: transaction.kind = CurrentSchemaDeployment
    requires: transaction.state in { activating, committed }
    requires: transaction.database_state = target_verified
    requires: transaction.finalization != complete
    requires: current_schema_finalization_context_is_valid(transaction)
    ensures: CurrentSchemaCompatibleCandidateOnly(transaction)
    ensures: CurrentSchemaOfflineMigrationNotRepeated(transaction)
    ensures: CurrentSchemaSnapshotNotReplayed(transaction)
    ensures: transaction.finalization = pending

    @guidance
        -- Finalize-current may bootstrap only the retained compatible candidate
        -- if not already running. Verify its exact identity before publishing the
        -- captured private plist and removing temporary restore capacity.
        -- Re-verify the retained helper, candidate, private plist, database
        -- commit proof and claim before startup. Do not invoke offline migration
        -- again or replay the snapshot. Normal startup of this exact candidate
        -- may perform its own idempotent initialization and reconciliation.
        -- Keep the claim and pending status on interruption or failure.
}

rule CompleteCurrentSchemaFinalization {
    when: CurrentSchemaFinalizationFinished(transaction, service)
    requires: transaction.kind = CurrentSchemaDeployment
    requires: transaction.state = committed
    requires: transaction.database_state = target_verified
    requires: transaction.finalization = pending
    requires: exact_identity_running(service, transaction.expected)
    requires: current_schema_finalization_context_is_valid(transaction)
    requires: current_schema_publication_and_cleanup_durable(transaction)
    ensures: transaction.finalization = complete
    ensures: DurableStatusWritten(transaction)
    ensures: CurrentSchemaOfflineMigrationNotRepeated(transaction)
    ensures: CurrentSchemaSnapshotNotReplayed(transaction)
}

rule RecoverUnchangedCurrentSchemaSource {
    when: CurrentSchemaRecoveryRequested(transaction, service)
    requires: transaction.kind = CurrentSchemaDeployment
    requires: transaction.state = activating
    requires: transaction.current_lifecycle_observation.kind = CurrentSchemaSnapshotVerified
    requires: snapshot_proof_durable(transaction)
    requires: transaction.database_state = source_unchanged
    requires: transaction.migration_invocation = not_invoked
    requires: current_schema_predecessor_recovery_is_valid(transaction)
    requires: current_schema_source_unchanged(transaction)
    requires: active_claim_retained(transaction)
    requires: exact_previous_restored(transaction, service)
    ensures: transaction.state = activation_failed_rolled_back
    ensures: DatabaseRollbackCompleted(transaction)
    ensures: current_schema_recovery_verified(transaction)
    ensures: DurableStatusWritten(transaction)

    @guidance
        -- Recover-current confirms target stop and re-proves exclusive DB/WAL/SHM
        -- ownership, then rechecks exact source ledger and logical contents against
        -- the bound proof immediately before replay. Restore only the matching
        -- snapshot and captured predecessor binary/configuration; verify integrity
        -- and predecessor identity before claim release. Once migration_started was
        -- persisted, even a no-write exit is forward-only with no predecessor.
}

-- CurrentSchemaFinalizationRequested(transaction)
--   Operator invoked prod finalize-current for retained exact-target transaction.
-- CurrentSchemaFinalizationFinished(transaction, service)
--   Candidate identity, persistent publication and cleanup were verified.
-- CurrentSchemaRecoveryRequested(transaction, service)
--   Operator invoked prod recover-current for a proven never-invoked migration
--   and exact unchanged source.
-- current_schema_publication_and_cleanup_durable(transaction) -> Boolean
--   Candidate plist publication and temporary restore capacity cleanup/fsync
--   completed; audit snapshot and proof remain retained.
-- CurrentSchemaCompatibleCandidateOnly(transaction)
--   Only captured target-compatible candidate may start; no predecessor starts.
-- CurrentSchemaOfflineMigrationNotRepeated(transaction)
--   Finalization never invokes offline --migrate-only again; candidate startup
--   may perform its normal idempotent initialization and reconciliation.
-- CurrentSchemaSnapshotNotReplayed(transaction)
--   Finalization does not restore or replay the audit snapshot.
-- OrdinaryForwardCandidateStartupRequested(transaction)
--   Exact 123 -> 127 ordinary activation is about to attempt candidate startup.
-- OrdinaryForwardActivationFailed(transaction, failure)
--   Candidate startup or health failed, or absence of a start attempt is unproven.
-- OrdinaryForwardResumeRequested(transaction)
--   Operator explicitly invoked prod resume-forward for the retained transaction.

rule FenceFailedOrdinaryForwardActivation {
    when: OrdinaryForwardActivationFailed(transaction, failure)
    requires: transaction.state = activating
    requires: ordinary_forward_boundary_qualified(transaction)
    requires: not ordinary_forward_no_start_proven(transaction)
    ensures: transaction.state = ordinary_forward_only_failed
    ensures: transaction.failure = failure
    ensures: ordinary_forward_failure_fenced(transaction)
    ensures: active_claim_retained(transaction)
    ensures: DurableStatusWritten(transaction)

    @guidance
        -- A failed or unknown start may have committed migrations 126/127 or
        -- coordinator-home initialization. Stop the candidate where possible;
        -- never bootstrap the predecessor or clear the claim on uncertainty.
}

rule ResumeFailedOrdinaryForwardActivation {
    when: OrdinaryForwardResumeRequested(transaction)
    requires: transaction.state = ordinary_forward_only_failed
    requires: ordinary_forward_boundary_qualified(transaction)
    requires: ordinary_forward_resume_context_is_valid(transaction)
    requires: active_claim_retained(transaction)
    ensures: transaction.state = activating
    ensures: ordinary_forward_start_attempt_recorded(transaction)
    ensures: OrdinaryExactRetainedCandidateOnly(transaction)
    ensures: DurableStatusWritten(transaction)

    @guidance
        -- Start only the re-verified retained candidate. Another start/health
        -- failure returns to ordinary_forward_only_failed with its claim and
        -- evidence intact; predecessor rollback never becomes eligible again.
}

-- OrdinaryExactRetainedCandidateOnly(transaction)
--   Resume authorizes only the transaction's exact retained candidate binary,
--   configuration and registry, not a replacement or predecessor.

rule RollBackFailedOrdinaryActivation {
    when: ActivationFailed(transaction, service, failure)
    requires: transaction.state = activating
    requires: transaction.kind not in { PreparedArtifactDeployment, CurrentSchemaDeployment }
    requires: not ordinary_forward_boundary_qualified(transaction)
        or ordinary_forward_no_start_proven(transaction)
    requires: exact_previous_restored(transaction, service)
    ensures: transaction.state = activation_failed_rolled_back
    ensures: transaction.failure = failure
    ensures: DurableStatusWritten(transaction)
    ensures: RuntimeArtifactRollbackRecorded(transaction)
    ensures: not DatabaseRollbackClaimed(transaction)
    ensures: not DeployedShaWritten(transaction.source_commit)
}

-- predecessor_publication_durable(transaction) -> Boolean
--   Captured predecessor plist publication and deployed identity writes are
--   durable after verified startup; failure retains running verified predecessor
--   and retryable claim without teardown or database replay.

rule CheckpointAuthorizedPredecessorStartup {
    when: PredecessorRecoveryPrepared(transaction, mode)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state in { activating, activation_failed_rollback_failed }
    requires: transaction.recovery_mode = null
    requires: predecessor_start_authorized(transaction)
    requires: mode = snapshot_restored implies paired_snapshot_restored(transaction)
    requires: mode = unchanged_predecessor implies paired_unchanged_predecessor_verified(transaction)
    ensures: transaction.recovery_mode = mode
    ensures: DurableStatusWritten(transaction)

    @guidance
        -- Persist typed snapshot-restored or unchanged-predecessor checkpoint
        -- BEFORE bootstrap. Once set, any retry must not restore snapshot again.
        -- Private predecessor startup is authorized only after durable checkpoint.
}

rule VerifyCheckpointedPredecessor {
    when: CheckpointRecoveryRequested(transaction, service)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state in { activating, activation_failed_rollback_failed, activation_failed_rolled_back }
    requires: active_claim_retained(transaction)
    requires: transaction.recovery_mode != null
    requires: checkpointed_predecessor_running_verified(transaction)
    ensures: PairedRecoveryVerified(transaction, service, transaction.recovery_mode)

    @guidance
        -- Verify running predecessor/private loaded configuration and identity,
        -- finalize publication/status only. Never stop or replay database snapshot.
        -- Unknown/stopped predecessor remains fenced for operator investigation.
}

-- checkpointed_predecessor_running_verified(transaction) -> Boolean
--   Exact captured predecessor binary/private loaded plist and runtime identity
--   are verified after the durable startup checkpoint without database replay.

rule RollBackFailedPreparedPairedActivation {
    when: ActivationFailed(transaction, service, failure)
    requires: transaction.state = activating
    requires: transaction.kind = PreparedArtifactDeployment
    requires: paired_predecessor_start_order_is_valid(transaction)
    requires: supported_recovery_verified(transaction)
    requires: predecessor_publication_durable(transaction)
    requires: exact_previous_restored(transaction, service)
    requires: transaction.recovery_mode != null
    ensures: transaction.state = activation_failed_rolled_back
    ensures: transaction.failure = failure
    ensures: DurableStatusWritten(transaction)
    ensures: RuntimeArtifactRollbackRecorded(transaction)
    requires: paired_snapshot_restored(transaction) implies transaction.recovery_mode = snapshot_restored
    requires: paired_unchanged_predecessor_verified(transaction) implies transaction.recovery_mode = unchanged_predecessor
    ensures: paired_snapshot_restored(transaction) implies DatabaseRollbackCompleted(transaction)
    ensures: paired_unchanged_predecessor_verified(transaction) implies not DatabaseRollbackClaimed(transaction)
    ensures: not DeployedShaWritten(transaction.source_commit)

    @guidance
        -- After verified unchanged no-snapshot resume, remove only the temporary
        -- backup seed and DB-adjacent restore allocation and fsync their parents
        -- before durable terminal status and claim release. Apply this sequence
        -- to activation rollback, fresh recovery, and checkpoint finalization.
        -- Never remove a verified snapshot/proof. Cleanup failure retains the
        -- verified running predecessor, checkpoint, diagnostic and unresolved
        -- claim for finalization-only retry without stop/start or snapshot replay.
}

rule PreserveRollbackFailure {
    when: RollbackFailed(transaction, failure, rollback_failure)
    requires: transaction.state = activating
    requires: transaction.kind != CurrentSchemaDeployment
    requires: not ordinary_forward_boundary_qualified(transaction)
        or ordinary_forward_no_start_proven(transaction)
    ensures: transaction.kind = PreparedArtifactDeployment implies transaction.state = activation_failed_rollback_failed
    ensures: transaction.kind not in { PreparedArtifactDeployment, CurrentSchemaDeployment }
        implies transaction.state = ordinary_activation_failed_rollback_failed
    ensures: transaction.failure = failure
    ensures: transaction.rollback_failure = rollback_failure
    ensures: DurableStatusWritten(transaction)
    ensures: not DeployedShaWritten(transaction.source_commit)
}

rule RecoverRetainedPairedTransaction {
    when: PairedRecoveryVerified(transaction, service, mode)
    requires: transaction.state in { prepared, activating, activation_failed_rollback_failed, activation_failed_rolled_back }
    requires: transaction.kind = PreparedArtifactDeployment
    requires: active_claim_retained(transaction)
    requires: paired_predecessor_start_order_is_valid(transaction)
    requires: exact_previous_restored(transaction, service)
    requires: supported_recovery_verified(transaction)
    requires: predecessor_publication_durable(transaction)
    ensures: transaction.state = activation_failed_rolled_back
    requires: mode = snapshot_restored implies paired_snapshot_restored(transaction)
    requires: mode = unchanged_predecessor implies paired_unchanged_predecessor_verified(transaction)
    requires: mode = transaction.recovery_mode
    ensures: transaction.recovery_mode = mode
    ensures: mode = snapshot_restored implies DatabaseRollbackCompleted(transaction)
    ensures: mode = unchanged_predecessor implies not DatabaseRollbackClaimed(transaction)
    ensures: DurableStatusWritten(transaction)
}

rule PreservePreparedRecoveryFailure {
    when: RollbackFailed(transaction, failure, rollback_failure)
    requires: transaction.state in { prepared, activating, activation_failed_rollback_failed }
    requires: transaction.kind = PreparedArtifactDeployment
    ensures: transaction.state = activation_failed_rollback_failed
    ensures: candidate_teardown_attempted(transaction)
    ensures: paired_transaction_retained(transaction)
    ensures: recovery_verification_unconfirmed(transaction)
    ensures: active_claim_retained(transaction)
}

rule VerifyOrdinaryAbandonedPreparation {
    when: OperatorVerifiedOrdinaryPreparationAbandoned(transaction)
    requires: transaction.kind not in { PreparedArtifactDeployment, CurrentSchemaDeployment }
    requires: transaction.state = preparing
    requires: ordinary_preparation_abandonment_verified(transaction)
    ensures: transaction.state = precondition_failed
    ensures: DurableStatusWritten(transaction)

    @guidance
        -- Existing operator/manual stale-claim disposition only: confirm recorded
        -- preparer dead, exact claim and no admitted helper; no automated DB recovery
        -- or new ordinary recovery command. Terminal matching release follows.
}

-- ordinary_preparation_abandonment_verified(transaction) -> Boolean
--   Operator verified matching ordinary preparation claim, dead preparer, no
--   activation handoff/helper, and unchanged runtime; unknown remains fenced.

rule AbandonInterruptedPreparation {
    when: PreparedAbandonmentVerified(transaction)
    requires: transaction.state in { preparing, prepared }
    requires: transaction.kind = PreparedArtifactDeployment
    requires: pre_manifest_abandonment_verified(transaction)
    ensures: transaction.state = precondition_failed
    ensures: DurableStatusWritten(transaction)

    @guidance
        -- Release only the matching claim after terminal status; runtime/database
        -- remain untouched. Missing evidence or a live/reused PID refuses recovery.
}

rule ReleaseMatchingTerminalClaim {
    when: TerminalStatusPersisted(transaction)
    requires: transaction.state in { committed, precondition_failed, activation_failed_rolled_back, ordinary_activation_failed_rollback_failed, rejected_concurrent }
    requires: transaction.kind not in { PreparedArtifactDeployment, CurrentSchemaDeployment }
        or transaction.state != committed
        or transaction.finalization = complete
    requires: transaction.kind != CurrentSchemaDeployment
        or transaction.state != activation_failed_rolled_back
        or current_schema_recovery_verified(transaction)
    requires: transaction.kind != PreparedArtifactDeployment
        or transaction.state != activation_failed_rolled_back
        or supported_recovery_verified(transaction)
    ensures: not DeploymentOwnsActivationClaim(transaction)
}

rule ShowUnresolvedPairedStatus {
    when: DeploymentStatusRequested(transaction)
    requires: transaction.kind = PreparedArtifactDeployment
    requires: transaction.state = activation_failed_rollback_failed
    ensures: PairedRecoveryGuidanceShown(transaction)
}

rule ReportStaleTransaction {
    when: DeploymentStatusRequested(transaction)
    requires: transaction.state in { preparing, prepared, activating }
    requires: TransactionAgeSeconds(transaction) > stale_after_seconds
    ensures: StaleRecoveryGuidanceShown(transaction)
    ensures: not transaction.state = committed
}

rule PrepareInstalledRestart {
    when: RestartRequested(restart)
    requires: activation_claim_available()
    ensures: restart.state = prepared
    ensures: restart_preparation_complete(restart)
}

rule RejectConcurrentRestart {
    when: RestartRequested(restart)
    requires: not activation_claim_available()
    ensures: restart.state = rejected_concurrent
    ensures: installed_state_unchanged(restart)
    ensures: TargetServiceUnchanged(restart)
}

rule HandoffRestart {
    when: restart: RestartTransaction.state transitions_to prepared
    requires: restart_preparation_complete(restart)
    ensures: restart_helper_is_launchd_owned(restart)
    ensures: RestartHandedOff(restart)
}

rule RestartInstalledRuntime {
    when: RestartHelperStarted(restart)
    requires: restart.state = prepared
    requires: restart_helper_is_launchd_owned(restart)
    requires: restart_preparation_complete(restart)
    ensures: RestartSignalSentWithoutTargetUnload(restart)
    ensures: restart.state = restarting
}

rule CommitVerifiedRestart {
    when: RestartRuntimeObserved(restart, service)
    requires: restart.state = restarting
    requires: exact_restarted_identity_running(restart, service)
    requires: installed_state_unchanged(restart)
    ensures: restart.running_pid = service.running_pid
    ensures: restart.state = committed
    ensures: DurableRestartStatusWritten(restart)
}

rule PreserveRestartFailure {
    when: RestartVerificationFailed(restart, failure)
    requires: restart.state = restarting
    ensures: restart.failure = failure
    ensures: restart.state = restart_failed
    ensures: DurableRestartStatusWritten(restart)
    ensures: not RollbackClaimed(restart)
}

invariant CandidateIdentityIsFullAndExact {
    for transaction in DeployTransactions:
        transaction.state in { prepared, activating, committed } implies
            selected_source_is_valid(transaction)
}

invariant LegacyIdentityIsRollbackOnly {
    for transaction in DeployTransactions:
        transaction.previous != null implies
            previous_rollback_identity_is_valid(transaction)
}

invariant OrdinaryRollbackIsRuntimeOnly {
    for transaction in DeployTransactions:
        transaction.kind not in { PreparedArtifactDeployment, CurrentSchemaDeployment }
        and transaction.state = activation_failed_rolled_back implies
            RuntimeArtifactRollbackRecorded(transaction)
            and not DatabaseRollbackClaimed(transaction)
}

invariant OrdinaryForwardStartupHasDurableBoundary {
    for transaction in DeployTransactions:
        ordinary_forward_boundary_qualified(transaction)
        and CandidateStartupReady(transaction) implies
            ordinary_forward_start_attempt_recorded(transaction)
}

invariant OrdinaryForwardRollbackOnlyBeforeFirstStart {
    for transaction in DeployTransactions:
        ordinary_forward_boundary_qualified(transaction)
        and transaction.state = activation_failed_rolled_back implies
            ordinary_forward_no_start_proven(transaction)
            and not DatabaseRollbackClaimed(transaction)
}

invariant OrdinaryForwardFailureRetainsFence {
    for transaction in DeployTransactions:
        transaction.state = ordinary_forward_only_failed implies
            ordinary_forward_boundary_qualified(transaction)
            and ordinary_forward_failure_fenced(transaction)
            and active_claim_retained(transaction)
            and not PredecessorStartAuthorized(transaction)
            and not DatabaseRollbackCompleted(transaction)
}

invariant OrdinaryForwardAttemptNeverReauthorizesPredecessor {
    for transaction in DeployTransactions:
        ordinary_forward_boundary_qualified(transaction)
        and ordinary_forward_start_attempt_recorded(transaction)
        and transaction.state in { activating, ordinary_forward_only_failed } implies
            not PredecessorStartAuthorized(transaction)
            and active_claim_retained(transaction)
}

invariant CurrentSchemaPreparedModeIsDistinct {
    for transaction in DeployTransactions:
        transaction.kind = CurrentSchemaDeployment
        and transaction.state not in { preparing, rejected_concurrent, precondition_failed } implies
            prepared_artifact_source_is_valid(transaction)
            and current_schema_preflight_is_valid(transaction)
            and controller_identity_is_independently_bound(transaction)
            and transaction.previous != null
}

invariant CurrentSchemaInvocationForbidsPredecessor {
    for transaction in DeployTransactions:
        transaction.kind = CurrentSchemaDeployment
        and transaction.state in { activating, committed }
        and (transaction.migration_invocation != not_invoked
            or transaction.database_state in { unknown, writes_committed, target_verified }) implies
            not DatabaseRollbackCompleted(transaction)
            and not PredecessorStartAuthorized(transaction)
            and (transaction.finalization = complete or active_claim_retained(transaction))
}

invariant CurrentSchemaRecoveryRequiresNeverInvokedMigration {
    for transaction in DeployTransactions:
        transaction.kind = CurrentSchemaDeployment
        and transaction.state = activation_failed_rolled_back implies
            transaction.migration_invocation = not_invoked
            and current_schema_recovery_verified(transaction)
}

invariant CurrentSchemaCandidateStartupRequiresTarget {
    for transaction in DeployTransactions:
        transaction.kind = CurrentSchemaDeployment
        and CandidateStartupReady(transaction) implies
            transaction.database_state = target_verified
            and current_schema_target_verified(transaction)
            and snapshot_proof_durable(transaction)
}

invariant PreparedArtifactIsPairedLaunchdOnly {
    for transaction in DeployTransactions:
        transaction.kind = PreparedArtifactDeployment
        and transaction.state not in { preparing, rejected_concurrent, precondition_failed } implies
            prepared_artifact_source_is_valid(transaction)
            and paired_database_preflight_is_valid(transaction)
            and controller_identity_is_independently_bound(transaction)
}

invariant FailedPreparedRecoveryRetainsManualRecovery {
    for transaction in DeployTransactions:
        transaction.kind = PreparedArtifactDeployment
        and transaction.state = activation_failed_rollback_failed implies
            candidate_teardown_attempted(transaction)
            and paired_transaction_retained(transaction)
            and recovery_verification_unconfirmed(transaction)
            and active_claim_retained(transaction)
}

invariant PairedUnresolvedFailureAutoloadFence {
    for transaction in DeployTransactions:
        transaction.kind = PreparedArtifactDeployment
        and transaction.state = activation_failed_rollback_failed implies
            paired_unresolved_autoload_quarantined(transaction)
}

-- paired_unresolved_autoload_quarantined(transaction) -> Boolean
--   Unresolved target plist remains outside LaunchAgents; quarantine failures
--   are explicit diagnostics and retain claim, never a successful fence assertion.

invariant PairedPrecommitAutoloadSafety {
    for transaction in DeployTransactions:
        transaction.kind = PreparedArtifactDeployment
        and transaction.state in { preparing, prepared, activating } implies
            paired_precommit_autoload_safe(transaction)
}

invariant PairedFinalizationUncertaintyIsExplicit {
    for transaction in DeployTransactions:
        transaction.kind = PreparedArtifactDeployment
        and transaction.state = committed
        and transaction.finalization = pending implies
            paired_finalization_diagnostic_is_durable(transaction)
}

invariant PairedPredecessorIsRequired {
    for transaction in DeployTransactions:
        transaction.kind = PreparedArtifactDeployment
        and transaction.state not in { preparing, rejected_concurrent, precondition_failed } implies
            transaction.previous != null
}

invariant PairedPublicationRequiresVerification {
    for transaction in DeployTransactions:
        transaction.kind = PreparedArtifactDeployment
        and transaction.state = committed
        and transaction.finalization = complete implies
            paired_publication_is_verified(transaction)
}

invariant CommitRequiresExactIdentity {
    for transaction in DeployTransactions:
        transaction.state = committed implies CandidateIdentityVerified(transaction)
}

invariant DisruptionRequiresPreparedHandoff {
    for transaction in DeployTransactions:
        TargetStopRequested(transaction) implies
            preparation_complete(transaction) and helper_is_launchd_owned(transaction)
}

invariant CommittedRestartPreservesInstalledState {
    for restart in RestartTransactions:
        restart.state = committed implies installed_state_unchanged(restart)
}

invariant ProductionOperationsAreMutuallyExclusive {
    for restart in RestartTransactions:
        RestartOwnsActivationClaim(restart) implies not DeployTransactions.any(t => DeploymentOwnsActivationClaim(t))
}

invariant RestartClaimsAreMutuallyExclusive {
    for a in RestartTransactions:
        for b in RestartTransactions:
            a != b implies not (
                RestartOwnsActivationClaim(a) and RestartOwnsActivationClaim(b)
            )
}
