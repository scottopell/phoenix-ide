-- allium: 3
-- Patch Tool Behavioural Specification
--
-- Captures the planner's pure domain logic: operations, matching cascade,
-- clipboard lifecycle, multi-edit application, and reindentation.
-- The executor (filesystem IO) and tool wrapper (JSON schema, path resolution)
-- are out of scope -- they are thin adapters over this core.

-- ============================================================================
-- Value types
-- ============================================================================

value EditSpec {
    offset: Integer       -- byte offset in content
    length: Integer       -- byte length of matched region
}

value Edit {
    offset: Integer
    length: Integer
    replacement: String
}

value Reindent {
    strip: String?        -- prefix to remove from each non-empty line
    add: String?          -- prefix to add to each non-empty line
}

-- ============================================================================
-- Entities
-- ============================================================================

entity PatchPlanner {
    clipboards: Map<String, String>

    -- Projections
    clipboard_names: clipboards.keys
}

entity PatchRequest {
    operation: replace | insert_before | insert_after | append_eof | prepend_bof | overwrite
    old_text: String?           -- the anchor for replace, insert_before, insert_after
    new_text: String?
    replace_all: Boolean        -- replace: substitute every exact occurrence (default false)
    to_clipboard: String?       -- clipboard name to store old_text into
    from_clipboard: String?     -- clipboard name to read new_text from
    reindent: Reindent?
}

entity PatchPlan {
    resulting_content: String
    diff: String
    autogenerated_warning: Boolean
    effects: List<PatchEffect>
}

entity PatchEffect {
    kind: String                -- always "WriteFile" in v1
    path: String                -- absolute filesystem path
    content: String
}

-- ============================================================================
-- Matching cascade
-- ============================================================================
--
-- find_unique_match(content, old_text) tries four strategies in order.
-- The first strategy to return a unique match wins. Strategies that see
-- multiple candidate matches record duplicate diagnostics, but later unique
-- strategies may still win. If no strategy returns a unique match, the result
-- is NotUnique when any strategy saw multiple candidates, otherwise NotFound.

entity MatchAttempt {
    content: String
    old_text: String
    result: matched | not_found | not_unique

    -- Derived (evaluated lazily in cascade order)
    exact_result: find_exact_unique(content, old_text)
    exact_duplicate: find_exact_duplicate(content, old_text)
    dedent_result: find_dedent_match(content, old_text)
    dedent_duplicate: find_dedent_duplicate(content, old_text)
    trimmed_result: find_trimmed_match(content, old_text)
    trimmed_duplicate: find_trimmed_duplicate(content, old_text)
    normalised_result: find_skeleton_match(content, old_text)
    normalised_duplicate: find_skeleton_duplicate(content, old_text)
}

rule ExactMatchSucceeds {
    when: attempt: MatchAttempt.created
    requires: attempt.exact_result != null
    ensures: attempt.result = matched
    ensures: attempt.spec = attempt.exact_result
}

rule DedentFallback {
    when: attempt: MatchAttempt.created
    requires: attempt.exact_result = null
    requires: attempt.dedent_result != null
    ensures: attempt.result = matched
    ensures: attempt.spec = attempt.dedent_result
    @guidance
        -- Iterates over distinct indentation levels found in content.
        -- For each level, reindents old_text from its common leading
        -- whitespace to the candidate level and checks for exact unique match.
        -- Stops at first hit.
}

rule TrimmedFallback {
    when: attempt: MatchAttempt.created
    requires: attempt.exact_result = null
    requires: attempt.dedent_result = null
    requires: attempt.trimmed_result != null
    ensures: attempt.result = matched
    ensures: attempt.spec = attempt.trimmed_result
    @guidance
        -- Requires old_text to have >2 lines.
        -- Tries without first line: if found and the preceding text ends
        -- with the first line + newline, extends the spec backward.
        -- Tries without last line: accepts as-is.
}

rule SkeletonFallback {
    when: attempt: MatchAttempt.created
    requires: attempt.exact_result = null
    requires: attempt.dedent_result = null
    requires: attempt.trimmed_result = null
    requires: attempt.normalised_result != null
    ensures: attempt.result = matched
    ensures: attempt.spec = attempt.normalised_result
    @guidance
        -- Uses Unicode TR39 confusable skeleton mapping (not NFKC).
        -- skeleton() maps visually similar characters to a common form:
        -- curly quotes -> straight quotes, em dash -> hyphen, fullwidth -> ASCII.
        -- Both content and old_text are skeletonised, then find_exact_unique
        -- runs on the skeleton strings. The skeleton byte offset is mapped
        -- back to the original content via a per-character offset table.
        -- The replacement targets the file's actual bytes at that position
        -- (not the skeleton form), so the edit is byte-correct.
        -- Only runs when the first three strategies all fail -- zero cost
        -- on the happy path.
}

rule MatchNotFound {
    when: attempt: MatchAttempt.created
    requires: attempt.exact_result = null
    requires: attempt.dedent_result = null
    requires: attempt.trimmed_result = null
    requires: attempt.normalised_result = null
    requires: attempt.exact_duplicate = null
    requires: attempt.dedent_duplicate = null
    requires: attempt.trimmed_duplicate = null
    requires: attempt.normalised_duplicate = null
    ensures: attempt.result = not_found
}

rule MatchNotUnique {
    when: attempt: MatchAttempt.created
    requires: attempt.exact_result = null
    requires: attempt.dedent_result = null
    requires: attempt.trimmed_result = null
    requires: attempt.normalised_result = null
    requires:
        attempt.exact_duplicate != null or
        attempt.dedent_duplicate != null or
        attempt.trimmed_duplicate != null or
        attempt.normalised_duplicate != null
    ensures: attempt.result = not_unique
    ensures: attempt.diagnostics = first_non_null(
        attempt.exact_duplicate,
        attempt.dedent_duplicate,
        attempt.trimmed_duplicate,
        attempt.normalised_duplicate
    )
    @guidance
        -- Duplicate diagnostics include total candidate count, bounded matching
        -- locations, 1-based start lines, concise snippets, and omitted-match
        -- count when more candidates exist than are reported.
}

-- ============================================================================
-- Planning: plan(path, current_content, patches)
-- ============================================================================

rule PlanValidation {
    when: PlanRequested(planner, path, current_content, patches)
    requires: patches.count > 0
    requires:
        for patch in patches where patch.operation in {replace, insert_before, insert_after}:
            current_content != null
    @guidance
        -- Empty patches -> NoPatches error.
        -- Anchor-based operations (replace, insert_before, insert_after) on a
        -- non-existent file -> ReplaceOnNonexistent error: no content means no
        -- anchor can match. Both checked before any edits are built.
}

-- ============================================================================
-- Edit building: per-patch -> Edit
-- ============================================================================

-- new_text resolution has two branches: from a stored clipboard, or from
-- the patch's inline new_text field. v3 grammar does not allow `if/else`
-- with separate `requires`/`ensures` per branch -- the equivalent shape is
-- two sibling rules.

rule ResolveNewTextFromClipboard {
    when: BuildEdit(planner, patch, original)
    requires: patch.from_clipboard != null
    requires: patch.from_clipboard != ""
    requires: patch.from_clipboard in planner.clipboard_names

    ensures: NewTextResolved(patch, lookup_clipboard(planner, patch.from_clipboard))

    @guidance
        -- Empty string clipboard names ("") are treated as absent.
        -- LLMs sometimes pass "" instead of omitting the field.
}

rule ResolveNewTextInline {
    when: BuildEdit(planner, patch, original)
    requires: patch.from_clipboard = null or patch.from_clipboard = ""

    ensures: NewTextResolved(patch, coalesce(patch.new_text, ""))
}

rule ApplyReindent {
    when: BuildEdit(planner, patch, original)
    requires: patch.reindent != null

    ensures: ReindentApplied(patch, reindent_lines(new_text, patch.reindent))

    @guidance
        -- Strip runs first, then add. Empty lines pass through unchanged.
        -- If strip prefix is absent on a non-empty line ->
        -- ReindentPrefixMismatch error. The per-line check (strip prefix
        -- present, then strip + prepend add) lives in
        -- `reindent_lines(new_text, reindent)` -- a black-box helper that
        -- iterates non-empty lines and returns the reindented string. The
        -- spec describes the contract; the per-line algorithm is
        -- implementation. Splitting the loop into the rule body is not
        -- expressible in v3 grammar (`if cond:` clauses inside an
        -- `ensures: for ... in ...:` block are not allowed).
}

-- Two sibling rules cover the two store-source branches: replace stores
-- the actual matched text (handles fuzzy match divergence); other
-- operations store the requested old_text. v3 grammar does not allow
-- `if/else` with separate requires/ensures inside a single rule.

rule StoreToClipboardFromMatch {
    when: BuildEdit(planner, patch, original)
    requires: patch.to_clipboard != null
    requires: patch.to_clipboard != ""
    requires: patch.operation = replace
    requires: patch.replace_all = false

    ensures: ClipboardWrite(planner, patch.to_clipboard, matched_text_from_content)

    @guidance
        -- For replace, store the *actual matched text* from content
        -- (not the requested old_text). matched_text_from_content =
        -- original[spec.offset..spec.offset+spec.length] where spec
        -- comes from find_unique_match. Important when dedent or
        -- trimmed matching finds a differently-indented version of
        -- old_text.
}

rule StoreToClipboardFromOldText {
    when: BuildEdit(planner, patch, original)
    requires: patch.to_clipboard != null
    requires: patch.to_clipboard != ""
    requires: patch.operation != replace
    requires: patch.old_text != null

    ensures: ClipboardWrite(planner, patch.to_clipboard, patch.old_text)

    @guidance
        -- Clipboard write happens during edit building, before edit
        -- application.
}

rule BuildReplaceEdit {
    when: BuildEdit(planner, patch, original)
    requires: patch.operation = replace
    requires: patch.replace_all = false
    requires: patch.old_text != null
    let spec = find_unique_match(original, patch.old_text)
    ensures: edit = Edit(offset: spec.offset, length: spec.length, replacement: new_text)
}

rule BuildReplaceAllEdits {
    when: BuildEdit(planner, patch, original)
    requires: patch.operation = replace
    requires: patch.replace_all = true
    requires: patch.old_text != null
    requires: find_all_exact(original, patch.old_text).count > 0
    ensures:
        for spec in find_all_exact(original, patch.old_text):
            edit = Edit(offset: spec.offset, length: spec.length, replacement: new_text)
    @guidance
        -- Exact occurrences only: the fuzzy cascade (dedent, trimmed, skeleton)
        -- is not consulted, because "best single candidate" has no meaning across
        -- many sites. Zero exact occurrences -> OldTextNotFound. One edit is emitted
        -- per occurrence; match_indices yields non-overlapping occurrences, so the
        -- emitted edits never overlap each other. replace_all does not write a
        -- to_clipboard (there is no single matched text to store).
}

-- insert_before / insert_after locate a unique anchor exactly as replace does
-- (full matching cascade, same duplicate diagnostics), then emit a zero-length
-- edit at the anchor's start (before) or end (after). The anchor's bytes are
-- never part of the edit's range, so they are preserved verbatim. These are the
-- matched-anchor counterparts of prepend_bof and append_eof.

rule BuildInsertBeforeEdit {
    when: BuildEdit(planner, patch, original)
    requires: patch.operation = insert_before
    requires: patch.old_text != null
    let spec = find_unique_match(original, patch.old_text)
    ensures: edit = Edit(offset: spec.offset, length: 0, replacement: new_text)
}

rule BuildInsertAfterEdit {
    when: BuildEdit(planner, patch, original)
    requires: patch.operation = insert_after
    requires: patch.old_text != null
    let spec = find_unique_match(original, patch.old_text)
    ensures: edit = Edit(offset: spec.offset + spec.length, length: 0, replacement: new_text)
}

rule BuildPrependEdit {
    when: BuildEdit(planner, patch, original)
    requires: patch.operation = prepend_bof
    ensures: edit = Edit(offset: 0, length: 0, replacement: new_text)
}

rule BuildAppendEdit {
    when: BuildEdit(planner, patch, original)
    requires: patch.operation = append_eof
    ensures: edit = Edit(offset: original.length, length: 0, replacement: new_text)
}

rule BuildOverwriteEdit {
    when: BuildEdit(planner, patch, original)
    requires: patch.operation = overwrite
    ensures: edit = Edit(offset: 0, length: original.length, replacement: new_text)
}

-- ============================================================================
-- Edit application
-- ============================================================================

rule ApplyEditsReverseOrder {
    when: ApplyEdits(original, edits)
    requires: no_overlapping_ranges(edits)
    ensures: result = apply_in_reverse_offset_order(original, edits)
    @guidance
        -- Edits are sorted by offset descending before application.
        -- This preserves byte offsets: applying edit[0] (highest offset)
        -- does not shift the positions of edit[1..n] (lower offsets).
        -- Each edit replaces original[offset..offset+length] with replacement.
        -- If offset+length > content.length -> EditOutOfBounds error.
        -- If two edits' byte ranges overlap -> OverlappingEdits error, raised
        -- before any write so the file is left unchanged. A zero-length insert
        -- whose offset equals another edit's boundary does not overlap.
}

-- ============================================================================
-- Invariants
-- ============================================================================

invariant ClipboardPersistence {
    -- Clipboard entries persist across plan() calls on the same
    -- PatchPlanner. A clipboard written in call N is readable in call
    -- N+1. Stated as: every name in clipboard_names resolves to a
    -- non-null value via lookup_clipboard. The map indexing form
    -- (planner.clipboards[name]) is not v3 grammar; lookup_clipboard
    -- is the equivalent helper.
    for p in PatchPlanner:
        for name in p.clipboard_names:
            lookup_clipboard(p, name) != null
}

invariant EmptyClipboardNameIgnored {
    -- Empty string ("") is never a valid clipboard name.
    -- It is not stored as a key, and referencing it does not trigger lookup.
    "" not in planner.clipboard_names
}

invariant ReplaceRequiresExistingFile {
    -- Replace on a file with current_content = null always fails.
    -- Other operations (Overwrite, Append, Prepend) work on null content
    -- (treating it as empty string).
}

invariant MatchUniqueness {
    -- find_unique_match returns a result only when exactly one occurrence
    -- exists (at the strategy level that matched). If zero -> NotFound.
    -- If >1 -> NotUnique.
    -- This applies per-strategy: exact match checks raw occurrences,
    -- dedent match checks after reindentation, trimmed match checks
    -- after line removal.
}

invariant EditApplicationOrder {
    -- Edits are applied in descending offset order. No edit's offset
    -- is adjusted based on prior edits. This is correct because each
    -- edit's offset was computed against the original content, and
    -- descending application means only bytes after the edit point change.
}

invariant NonOverlappingEdits {
    -- No two edits applied in a single call may target overlapping byte
    -- ranges of the original content. A replace/insert range is
    -- [offset, offset+length); a zero-length insert is the empty range at
    -- offset. Two ranges overlap when they share at least one byte; sharing
    -- only an endpoint (a zero-length insert at another edit's boundary)
    -- does not overlap. Overlap is rejected (OverlappingEdits) before any
    -- write, so the combined result is never order-dependent corruption.
}

invariant OverwriteIdempotent {
    -- Overwriting a file with content X, then overwriting again with X,
    -- produces the same result.
}

invariant ReindentRoundtrip {
    -- strip(X) then add(X) is identity for uniform indentation.
    -- strip("  ") + add("  ") on "  line1\n  line2" = "  line1\n  line2".
}
