-- allium: 3
-- Auth & Share Specification
--
-- Single-user password authentication and read-only share mode.
-- Imports bedrock for the Conversation entity and UserConversation surface.

use "../bedrock/bedrock.allium" as bedrock

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- When set, all endpoints require authentication.
    -- When empty/unset, auth is disabled (open access).
    password: String?
    auth_enabled: password != null

    -- Consecutive Bearer-password failures from one peer before lockout.
    max_login_failures: Integer
    -- How long a peer stays locked out once the threshold is reached.
    lockout_window: Duration
    -- Lifetime of a minted session token; also the phoenix-auth cookie Max-Age.
    session_ttl: Duration
}

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- An inbound HTTP request. Carries the credentials the auth layer
-- inspects: a session-token cookie and/or a Bearer-password header.
-- Its peer is the connection's real address, used to key the throttle.
external entity Request {
    peer: Peer
    session_cookie: String?     -- value of the phoenix-auth cookie, if present
    bearer_password: String?    -- value of an Authorization: Bearer credential, if present
}

-- The remote end of a connection, identified by its real peer address.
-- This is the throttle key; it cannot be spoofed on a direct connection.
external entity Peer {
    address: String
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- A session token minted at login and persisted server-side (auth_sessions
-- table) until its expiry, so it survives a server restart. A request bearing
-- this token in its cookie is the Owner.
-- The password never travels in the cookie; only this opaque token does.
-- password_fingerprint binds the token to the password it was minted under
-- (a non-reversible hash); rotating config.password invalidates the token.
entity SessionToken {
    token: String               -- random, opaque, unguessable
    password_fingerprint: String
    created_at: Timestamp
    expires_at: Timestamp

    -- A persisted token authenticates only while unexpired and only under the
    -- password it was minted with. Expiry and password-rotation both revoke it.
    is_valid: expires_at > now and password_fingerprint = fingerprint(config.password)
}

-- A per-peer throttle bucket for Bearer-password verification. Counts
-- consecutive failed password checks from one peer and locks the peer
-- out for a back-off window once the threshold is reached. Session-token
-- checks never touch this bucket.
entity ThrottleBucket {
    peer: Peer
    consecutive_failures: Integer
    locked_until: Timestamp?

    -- The bucket is locked while a back-off window is in force.
    is_locked: locked_until != null and locked_until > now
}

-- A share token grants read-only access to a single conversation.
-- Created on demand when the owner navigates to /share/c/{slug}.
entity ShareToken {
    conversation: bedrock/Conversation
    token: String               -- random, unguessable
    created_at: Timestamp
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

-- The authenticated owner. A request is the Owner when auth is disabled,
-- or when it carries a valid session-token cookie, or when it carries a
-- matching Bearer password AND its peer is not currently locked out by the
-- login throttle. The password never identifies the Owner via a cookie --
-- only the minted session token does. Session-token ownership is never gated
-- by the throttle (token checks are not rate-limited); only the Bearer-password
-- branch is, so a peer that has tripped the lockout cannot regain access by
-- presenting even a correct Bearer until the window elapses.
--
-- Identity predicates (black-box, pure over the request and current state):
--   session_token_valid(request)    => the request's session_cookie names a
--                                       SessionToken that exists in the store
--                                       and is_valid (unexpired, minted under
--                                       the current config.password).
--   bearer_password_matches(request) => the request's bearer_password equals
--                                        config.password under constant-time
--                                        comparison (see ConstantTimePasswordCheck).
--   throttle_locked(peer)            => the peer's ThrottleBucket is locked
--                                        (see LoginFails / ThrottleScopedToPasswordChecks).
actor Owner {
    identified_by: Request where
        not config.auth_enabled
        or session_token_valid(request)
        or (bearer_password_matches(request) and not throttle_locked(request.peer))
}

-- An unauthenticated viewer holding a valid share token.
actor Viewer {
    identified_by: ShareToken
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The owner's full-access surface. Wraps bedrock/UserConversation
-- with an auth precondition. When auth is disabled, this is
-- equivalent to the base UserConversation (no additional constraints).
surface OwnerConversation {
    facing owner: Owner

    context conversation: bedrock/Conversation where not is_sub_agent

    -- Exposes everything the base UserConversation exposes
    exposes:
        conversation.status
        conversation.mode
        conversation.context_usage_ratio
        conversation.context_warning
        conversation.proposal when conversation.status = awaiting_task_approval
        conversation.pending_questions when conversation.status = awaiting_user_response
        conversation.error_message when conversation.status = error
        conversation.continuation_summary when conversation.status = context_exhausted
        conversation.share_token?

    -- Provides everything the base UserConversation provides, plus share management
    provides:
        UserSendsMessage(conversation, text, images?)
            when conversation.status in { idle, error }
        UserCancels(conversation)
            when conversation.is_busy
                 or conversation.status in {
                    awaiting_task_approval,
                    awaiting_user_response,
                    awaiting_continuation
                 }
        TaskApprovalDecided(conversation, decision)
            when conversation.status = awaiting_task_approval
        UserAnswersQuestion(conversation, answers, annotations?)
            when conversation.status = awaiting_user_response
        UserTriggersContinuation(conversation)
            when conversation.status = idle and conversation.context_warning
        CreateShareToken(conversation)
        RevokeShareToken(conversation)
            when conversation.share_token != null
}

-- Read-only surface for viewers with a valid share token.
-- Full conversation history + live SSE stream, no mutations.
surface SharedConversation {
    facing viewer: Viewer

    context token: ShareToken
    context conversation: token.conversation

    exposes:
        conversation.status
        conversation.mode
        conversation.messages
        conversation.context_usage_ratio

    -- No provides block: viewers cannot trigger any actions.

    @guarantee LiveUpdates
        -- When the conversation has a running runtime, the viewer attaches
        -- to its broadcast channel and receives real-time SSE events for new
        -- messages and state changes -- the same stream as the owner, filtered
        -- to exclude sensitive metadata. An idle conversation has no live
        -- activity to stream; the viewer still receives full history (see
        -- FullHistory). Attaching never starts a runtime (see
        -- ReadOnlyViewingHasNoSideEffects).

    @guarantee FullHistory
        -- Viewer sees all messages from conversation creation,
        -- not just messages arriving after they connect.
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- A login attempt presents the password at POST /api/auth/login. The
-- attempt is keyed to the connection's real peer so failures throttle the
-- peer, not the credential. Predicates (black-box, constant-time compare):
--   password_matches(request) => the submitted password equals config.password
--                                under constant-time comparison (the same
--                                check used for a Bearer password).
--   throttle_locked(peer)      => the peer's ThrottleBucket is_locked.

-- Successful login: the password matches and the peer is not locked out.
-- A fresh session token is minted and stored; the response sets it in the
-- phoenix-auth cookie. Any prior failure count for the peer is cleared.
rule LoginSucceeds {
    when: AttemptLogin(request)

    requires: config.auth_enabled
    requires: not throttle_locked(request.peer)
    requires: password_matches(request)

    let bucket = ThrottleBucket{peer: request.peer}

    ensures: SessionToken.created(
        token: random_token(),
        password_fingerprint: fingerprint(config.password),
        created_at: now,
        expires_at: now + session_ttl
    )
    ensures:
        if exists bucket:
            bucket.consecutive_failures = 0
            bucket.locked_until = null

    @guidance
        -- POST /api/auth/login compares the submitted password against
        -- config.password with a constant-time check. On success the minted
        -- token is persisted to the auth_sessions table (with an expiry
        -- matching the cookie Max-Age) and returned in the
        -- Set-Cookie: phoenix-auth=<token> header. Tokens survive a restart,
        -- so a redeploy does not log browsers out.
}

-- Failed login: the password does not match. The peer's failure counter is
-- incremented; once it reaches max_login_failures the peer is locked out for
-- lockout_window. Throttling is keyed on the real peer address only.
rule LoginFails {
    when: AttemptLogin(request)

    requires: config.auth_enabled
    requires: not throttle_locked(request.peer)
    requires: not password_matches(request)

    let bucket = ThrottleBucket{peer: request.peer}
    let prior = if exists bucket: bucket.consecutive_failures else: 0
    let next_failures = prior + 1

    ensures:
        if exists bucket:
            bucket.consecutive_failures = next_failures
        else:
            ThrottleBucket.created(
                peer: request.peer,
                consecutive_failures: next_failures,
                locked_until: null
            )
    ensures:
        if next_failures >= config.max_login_failures:
            let locked = ThrottleBucket{peer: request.peer}
            locked.locked_until = now + config.lockout_window
}

-- Owner navigates to /share/c/{slug} to create a share token.
-- If a token already exists for the conversation, redirect to it.
-- If not, create one and redirect.
rule CreateShareToken {
    when: CreateShareToken(conversation)

    requires: config.auth_enabled
    requires: conversation.share_token = null

    ensures: ShareToken.created(
        conversation: conversation,
        token: random_token(),
        created_at: now
    )

    @guidance
        -- The /share/c/{slug} route is the creation trigger.
        -- GET /share/c/{slug} (authenticated):
        --   1. Look up conversation by slug
        --   2. If share_token exists, redirect to /s/{token}
        --   3. If not, create token, persist, redirect to /s/{token}
        -- The redirect makes /s/{token} the canonical share URL.
}

-- Owner revokes a share token, invalidating all viewer access.
rule RevokeShareToken {
    when: RevokeShareToken(conversation)

    requires: conversation.share_token != null

    ensures: not exists conversation.share_token

    @guidance
        -- DELETE /api/conversations/{id}/share-token
        -- After revocation, /s/{old-token} returns 404.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Share tokens are unique across all conversations
invariant UniqueShareTokens {
    for a in ShareTokens:
        for b in ShareTokens:
            a != b implies a.token != b.token
}

-- When auth is disabled, no share tokens should exist
-- (sharing is meaningless when everything is already public)
invariant NoTokensWithoutAuth {
    not config.auth_enabled implies ShareTokens.count = 0
}

-- Throttling applies to password verification only. A request authenticated
-- by a valid session-token cookie is never subject to the per-peer lockout:
-- session_token_valid(request) consults the session store and touches no
-- ThrottleBucket. Only password_matches(request) -- at login and on Bearer
-- requests -- feeds the throttle.
invariant ThrottleScopedToPasswordChecks {
    for bucket in ThrottleBuckets:
        bucket.consecutive_failures >= 0
}

-- Implementation constraint: ReadOnlyViewingHasNoSideEffects
-- The SharedConversation surface is reachable by an unauthenticated Viewer
-- holding only a share token, so serving it must never cause a server-side
-- side effect. In particular, opening the share SSE stream attaches to an
-- already-running runtime if one exists and otherwise serves the persisted
-- transcript from a fresh broadcaster -- it never starts (get-or-creates) a
-- runtime, which would let a token-only caller spawn an executor and allocate
-- resources for an otherwise-idle conversation. The model expresses this as
-- the surface's absent provides block (viewers trigger no actions); the
-- no-runtime-start refinement is enforced at the call site.
-- Implementation: see crates/phoenix-ide/src/api/handlers.rs
-- (`shared_sse_stream` uses `try_get_handle`, not `get_or_create`).

-- Implementation constraint: ConstantTimePasswordCheck
-- The server compares the submitted password against config.password
-- using constant-time comparison, both at POST /api/auth/login and for an
-- Authorization: Bearer password. No early-exit on first differing byte.
-- Enforced at the call site, not as a structural invariant the model can
-- verify -- the model has no notion of compare timing.
-- Implementation: see crates/phoenix-ide/src/api/auth.rs (`constant_time_eq`).

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- RESOLVED: Share tokens are persisted to DB (share_tokens table).
-- They represent a user decision and should survive restarts.
-- Migration: CREATE TABLE share_tokens (conversation_id TEXT, token TEXT, created_at TEXT).
