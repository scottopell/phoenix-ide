-- allium: 3
-- subagents.allium
--
-- Phoenix Sub-Agents: Behavioural Specification
--
-- Scope: Spawn-time validation, per-authority configuration resolution, the
--        cross-domain seam between bedrock's sub-agent state space and
--        WorkScope-owned worktree authority.
-- Includes:
--   - SubAgentExecutionAuthority (read_only/write_capable) and parent-mode rules
--   - Fail-closed parent-model qualification and atomic Work admission
--   - Durable cancellation, joined materialization, and result delivery
--   - cwd-scoping invariant for Work sub-agents (incl. task.cwd overrides)
--   - system-root cwd rejection for every sub-agent mode
--   - Explore-sub-agent working_dir derivation
--   - Per-authority tool-registry selection (fresh spawn + resume path)
--   - Model and max-turns defaulting & validation (config in @guidance)
--   - Sub-agent timeout (REQ-SA-006) at the spawn layer
-- Excludes:
--   - Core conversation state machine (see bedrock.allium):
--       awaiting_sub_agents, cancelling_sub_agents, completed, failed,
--       fan-in, cancellation propagation, settlement conservation,
--       sub-agent terminal-tool semantics
--       (submit_result/submit_error must be sole tool in response),
--       SpawnLimit, NoRecursiveSubAgents.
--   - Worktree creation / repository lifecycle (see git-repository.allium).
--   - Tool implementations (bash, patch, etc.).
--
-- Requirement traceability: REQ-SA-001 .. REQ-SA-008, REQ-SA-011,
-- REQ-PROJ-008. REQ-SA-007 is superseded by REQ-PROJ-008; REQ-SA-008
-- read_first injection is outside this spawn-resolution model.

use "../bedrock/bedrock.allium" as bedrock

-- Full native database result, whose classification and diagnostics are owned
-- by the existing unactivated-batch operation; this module observes its outcome.
external entity NativeSpawnClosureResult {}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- One selected spawn call, correlated across admission and return. Provider
-- tool IDs can repeat in another assistant round, so parent plus tool ID alone
-- does not identify this invocation.
value SpawnInvocation {
    parent: bedrock/Conversation
    assistant_message_id: String
    tool_use_id: String
    batch_id: String
}

-- Per-task input from the `spawn_agents` tool. All fields except `task`
-- are optional in the JSON wire form; this record captures the
-- LLM-supplied shape *before* defaulting.
value SubAgentTask {
    task: String                  -- task description, required, non-empty
    cwd: String?                  -- working-directory override
    execution_authority: SubAgentExecutionAuthority? -- absent => read_only
    execution: ExecutionSelector? -- one tier or exact model/connection choice
    max_turns: Integer?           -- override per-mode default
    agent_type: String?           -- named agent persona (see specs/agents/);
                                  -- must match an eligible configured worker
}

-- Execution is one choice; named-worker instructions remain orthogonal.
entity ExecutionSelector {
    kind: TierExecution | ModelExecution
}

variant TierExecution : ExecutionSelector {
    name: String
}

variant ModelExecution : ExecutionSelector {
    model: String
    connection: String
    reasoning_effort: String?
}

-- The resolved spec the runtime spawns the sub-agent from.
-- Every field is concrete: defaults applied, model validated, cwd
-- resolved.
value SubAgentSpec {
    agent_id: String              -- fresh UUID generated at spawn time
    task: String
    cwd: String                   -- absolute path on disk
    timeout: Duration             -- mandatory (REQ-SA-006)
    execution_authority: SubAgentExecutionAuthority
    model_id: String              -- available through selected connection
    connection: String            -- logical configured backend slot
    reasoning_effort: String?     -- absent means model-native default
    max_turns: Integer            -- > 0
    agent_name: String?           -- named agent that produced this spec (see specs/agents/)
    persona: String?              -- resolved agent body; replaces the base preamble
    parent_conversation_id: String -- durable delivery destination
    parent_work_scope_kind: ParentWorkScopeKind
    parent_work_scope_id: String when parent_work_scope_kind = attached
}

-- One durable row exists for every child admitted by a spawn call. These fields
-- model durable facts and disjoint delivery dispositions, not construction phases.
entity SubAgentAdmission {
    child: bedrock.Conversation
    parent: bedrock.Conversation
    batch_id: String
    execution_authority: SubAgentExecutionAuthority
    cancellation_requested: Boolean = false
    initial_work_dispatched: Boolean = false
    terminal_evidence_persisted: Boolean = false
    parent_terminal_disposition: ParentTerminalDisposition = owed
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract SpawnParentAdoption {
    UnactivatedSpawnBatchClosureRequested: (invocation: SpawnInvocation) -> NativeSpawnClosureResult

    @invariant AdmissionDoesNotActivateChildren
        -- Atomic admission reserves exact batch/child identities. Initial child
        -- work additionally requires the activation receiver released only after
        -- committed parent membership contains every exact admitted child.
        -- An admitted response by itself is not an activation capability.

    @invariant CancellationKeepsTheOriginalBatchOwned
        -- Withhold activation as soon as cancellation is accepted. Retain the
        -- exact originating response/activation owner until its native admission
        -- command is classified. Already-admitted unadopted children are cancelled
        -- and terminalized through that same batch owner, never silently dropped.
        -- A cancelled parent cannot report settlement from a missing receipt or
        -- from a query that races an outstanding admission command.

    @invariant ClosureReceiptsAreEstablishedNativeFacts
        -- UnactivatedSpawnBatchClosureRequested invokes the existing native
        -- unactivated-batch terminalization boundary after admission resolves.
        -- It returns one exact classified closed, known-failed, or unclassified
        -- observation. Closed includes a classified rejection/no-admission fact;
        -- it never means merely that a receiver or in-memory entry is absent.
        -- Unknown local write authority selects REQ-BED-033, not false success,
        -- speculative cleanup, or replay of an unknown-effect command.

    @invariant ClosedUnadoptedChildrenHaveADistinctDisposition
        -- The exact unadopted batch's cancellation receipt consumes its children
        -- as closed_without_parent_adoption. They never enter the parent's fan-in
        -- membership and never acquire a fabricated normal completed result.
        -- Already-adopted children remain owned by the parent's existing fan-in
        -- and cancellation rules; a stale response cannot abandon that membership.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum SubAgentExecutionAuthority { read_only | write_capable }
enum ParentWorkScopeKind { unattached | attached }
enum ParentTerminalDisposition { owed | fan_in_accepted | closed_without_parent_adoption }

-- Tool registries selectable for a sub-agent. The registry shape itself
-- lives in code (crates/phoenix-ide/src/tools.rs); the spec only names
-- the two variants and which mode picks which.
enum SubAgentToolRegistry { subagent_read_only | subagent_write_capable }

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- REQ-SA-006: per-spawn time limit (`DEFAULT_SUBAGENT_TIMEOUT`).
    default_subagent_timeout: Duration = 20.minutes

    -- REQ-PROJ-008: per-mode max-turns defaults applied when the
    -- per-task `max_turns` is absent.
    default_max_turns_explore: Integer = 20
    default_max_turns_work: Integer = 50

    -- Hard cap on a single `spawn_agents` call. Matches
    -- bedrock.allium config.max_sub_agents_per_spawn; the
    -- JSON-schema `maxItems` is the wire-level enforcement.
    max_sub_agents_per_spawn: Integer = 10
}

------------------------------------------------------------
-- Rules: Spawn-time validation
------------------------------------------------------------

-- ===========================================================
-- 1. CALL-LEVEL VALIDATION (REQ-SA-001)
-- ===========================================================

rule SpawnRejectedEmptyTasks {
    when: SpawnAgentsToolInvoked(invocation, tasks)
    let parent = invocation.parent
    requires: tasks.count = 0
    ensures: SpawnAgentsRejected(invocation,
        reason: "At least one task is required")
}

rule SpawnRejectedTooManyTasks {
    when: SpawnAgentsToolInvoked(invocation, tasks)
    let parent = invocation.parent
    requires: tasks.count > config.max_sub_agents_per_spawn
    ensures: SpawnAgentsRejected(invocation,
        reason: "Too many tasks in a single spawn_agents call")

    @guidance
        -- The wire-level cap is the JSON schema `maxItems: 10` on the
        -- tool input; this rule is the spec-level statement of the same
        -- bound.
}

-- ===========================================================
-- 2. MODE VALIDATION (REQ-PROJ-008, REQ-BED-018)
-- ===========================================================

rule WorkSubAgentRequiresWriteableParent {
    when: SpawnAgentsToolInvoked(invocation, tasks)
    let parent = invocation.parent
    requires: any_task_mode_is_work(tasks)
    requires: parent.execution_authority != write_capable
    ensures: SpawnAgentsRejected(invocation,
        reason: "Work sub-agents require parent Work authority")
}

-- REQ-PROJ-008: qualification is an exact allowlist over the parent's resolved
-- model. No Opus 5+ identifier exists in the supported catalog represented by
-- this specification, so no Anthropic identifier is qualified.
rule UnqualifiedParentRejectsMultipleWorkInBatch {
    when: SpawnAgentsToolInvoked(invocation, tasks)
    let parent = invocation.parent
    requires: not parallel_work_qualified(parent.resolved_model_id)
    requires: work_task_count(tasks) > 1
    ensures: SpawnAgentsRejected(invocation,
        reason: "This parent model admits Work sub-agents sequentially")
}

rule UnqualifiedParentRejectsConcurrentWork {
    when: SpawnAgentsToolInvoked(invocation, tasks)
    let parent = invocation.parent
    requires: not parallel_work_qualified(parent.resolved_model_id)
    requires: work_task_count(tasks) > 0
    requires: pending_work_admissions(parent) > 0
    ensures: SpawnAgentsRejected(invocation,
        reason: "A Work sub-agent is already pending for this parent")
}

rule QualifiedParentAllowsParallelWork {
    when: SpawnAgentsToolInvoked(invocation, tasks)
    let parent = invocation.parent
    requires: parent.mode = direct
    requires: parallel_work_qualified(parent.resolved_model_id)
    requires: work_task_count(tasks) > 1 or pending_work_admissions(parent) > 0
    requires: batch_is_otherwise_valid(parent, tasks)
    ensures: WorkAdmissionPermitted(parent, tasks)
}

rule QualificationIgnoresChildChoices {
    when: WorkAdmissionEvaluated(parent, tasks)
    ensures: ParallelWorkQualificationUsed(parent,
        parallel_work_qualified(parent.resolved_model_id))
}

-- ===========================================================
-- 3. MODEL VALIDATION (REQ-PROJ-008, REQ-SA-007)
-- ===========================================================

-- REQ-SA-007, REQ-SA-011: selection is admitted against the request catalog.
-- any_task_has_invalid_execution(tasks, parent): true if a selector is malformed,
-- names an unavailable tier/model/connection, requests unsupported explicit
-- effort, or its default cannot resolve in the parent's request snapshot.
rule SpawnRejectedInvalidExecution {
    when: SpawnAgentsToolInvoked(invocation, tasks)
    let parent = invocation.parent
    requires: any_task_has_invalid_execution(tasks, parent)
    ensures: SpawnAgentsRejected(invocation,
        reason: "Execution selection is unavailable or invalid")

    @guidance
        -- Errors identify the invalid selection and usable alternatives from
        -- the request catalog. No child is created for an invalid batch.
        -- Exact model selections never silently fall back; missing explicit
        -- effort uses that model's native default. Named and tier selections
        -- carry their already-resolved model/connection/effort choice.
}

-- An `agent_type` on a task must match an eligible configured worker (see
-- specs/agents/). Defaulting never invents an agent_type, so this only
-- checks the LLM-supplied value. Mirrors SpawnRejectedInvalidExecution.
-- (REQ-AG-007)
rule SpawnRejectedUnknownAgentType {
    when: SpawnAgentsToolInvoked(invocation, tasks)
    let parent = invocation.parent
    requires: any_task_has_unknown_agent_type(tasks, parent)
    ensures: SpawnAgentsRejected(invocation,
        reason: "Unknown agent_type in task spec")

    @guidance
        -- any_task_has_unknown_agent_type(tasks, parent): true iff a named
        -- worker is absent from the resolved catalog for the parent's request.
        -- The same snapshot renders the spawn schema and resolves the response;
        -- configuration is not reread during admission. Errors name the invalid
        -- worker and list eligible alternatives (REQ-AG-007, REQ-AG-008).
}

-- ===========================================================
-- 4. CWD VALIDATION AND SCOPING (REQ-PROJ-000, REQ-PROJ-008)
-- ===========================================================

-- Every sub-agent's effective cwd must be an existing non-root directory
-- after symlink and parent-directory traversal resolution. This rule is
-- mode-independent: read-only tools can still consume unbounded resources
-- when rooted at the filesystem root.
rule SpawnRejectedSystemRootCwd {
    when: SpawnAgentsToolInvoked(invocation, tasks)
    let parent = invocation.parent
    requires: any_task_effective_cwd_resolves_to_system_root(
        tasks, parent.working_dir)
    ensures: SpawnAgentsRejected(invocation,
        reason: "Sub-agent cwd must not resolve to the filesystem root")

    @guidance
        -- effective cwd resolution is `t.cwd` when present, otherwise
        -- `parent.working_dir`. Validation canonicalises the effective cwd;
        -- failure to canonicalise to an existing directory is rejected before
        -- creating a SubAgentSpec. This rule applies to Explore and Work
        -- sub-agents and to Direct parents as well as managed parents.
}

-- Starting-directory scoping assigns work; it does not confine filesystem writes.
rule SpawnRejectedWorkCwdOutsideWorktree {
    when: SpawnAgentsToolInvoked(invocation, tasks)
    let parent = invocation.parent
    requires: parent.worktree_path != absent
    requires: any_work_task_has_cwd_outside_worktree(tasks, parent.worktree_path)
    ensures: SpawnAgentsRejected(invocation,
        reason: "Work sub-agent cwd must be inside the parent's worktree")

    @guidance
        -- `is_within(path, root)`: path is `root` itself or a descendant
        -- of root, after canonicalisation. The implementation in
        -- `handle_spawn_agents_tool` compares canonicalised paths so a
        -- symlink that escapes the worktree is rejected.
        --
        -- When the task omits `cwd`, the effective cwd is the parent's
        -- working_dir, which for parent.mode in { work, branch } equals
        -- worktree_path by REQ-PROJ-008's inherited-workspace contract — that
        -- case satisfies the invariant trivially.
}

-- A successful spawn assigns the resolved cwd to the sub-agent.
-- For Work sub-agents this is co-located with the parent's worktree;
-- for Explore sub-agents the cwd is the parent's working_dir (which is
-- the worktree path when the parent has one, else the parent's cwd).
rule SpawnedSubAgentCwdAssignment {
    when: SubAgentSpawnSucceeded(parent, sub_agent, execution_authority, cwd_override)
    ensures:
        if cwd_override != absent:
            sub_agent.working_dir = cwd_override
        else:
            sub_agent.working_dir = parent.working_dir
    ensures: parent.attached_work_scope_id != absent implies sub_agent.spec.parent_work_scope_kind = attached
    ensures: parent.attached_work_scope_id != absent implies sub_agent.spec.parent_work_scope_id = parent.attached_work_scope_id
    ensures: parent.attached_work_scope_id != absent implies sub_agent.attached_work_scope_id = sub_agent.spec.parent_work_scope_id
    ensures: parent.attached_work_scope_id = absent implies sub_agent.spec.parent_work_scope_kind = unattached
    ensures: parent.attached_work_scope_id = absent implies sub_agent.attached_work_scope_id = absent

    @guidance
        -- The Explore-sub-agent ConvMode is `Explore { worktree_path:
        -- None }` — Explore sub-agents do not own a worktree of their
        -- own; they read from the parent's worktree (when present) or
        -- the parent's cwd. See REQ-PROJ-008's inherited-workspace contract
        -- for the cross-spec restatement.
        --
        -- For Work sub-agents the resolved cwd has already been verified
        -- by SpawnRejectedWorkCwdOutsideWorktree to lie inside the
        -- parent's worktree.
}

------------------------------------------------------------
-- Rules: Successful spawn -> SubAgentSpec
------------------------------------------------------------

-- All per-task validations passed: build a SubAgentSpec for each task
-- (defaults applied, model validated, cwd resolved) and hand it to
-- `RuntimeManager::handle_spawn_request`. The bedrock-level
-- `SpawnAgentsCompletes*` rule then drives the parent state transition.
rule InvalidBatchAdmitsNoChildren {
    when: SpawnAgentsToolInvoked(invocation, tasks)
    let parent = invocation.parent
    requires: not batch_is_admissible(parent, tasks)
    ensures: SpawnAgentsRejected(invocation,
        reason: "The complete sub-agent batch is not admissible")
    ensures: AdmittedChildCountForInvocation(parent, tasks)
        = previous(AdmittedChildCountForInvocation(parent, tasks))
}

rule SubAgentSpecsResolved {
    when: SpawnAgentsToolInvoked(invocation, tasks)
    let parent = invocation.parent
    requires: tasks.count >= 1
    requires: tasks.count <= config.max_sub_agents_per_spawn
    requires: parent.execution_authority = write_capable
        or not any_task_mode_is_work(tasks)
    requires: parallel_work_qualified(parent.resolved_model_id)
        or work_task_count(tasks) <= 1
    requires: parallel_work_qualified(parent.resolved_model_id)
        or work_task_count(tasks) = 0
        or pending_work_admissions(parent) = 0
    requires: not any_task_has_invalid_execution(tasks, parent)
    requires: not any_task_has_unknown_agent_type(tasks, parent)
    requires: not any_task_effective_cwd_resolves_to_system_root(
        tasks, parent.working_dir)
    requires: parent.worktree_path = absent
        or not any_work_task_has_cwd_outside_worktree(
            tasks, parent.worktree_path)
    ensures: SubAgentSpecsCreated(parent, tasks)
    ensures: AtomicSubAgentBatchAdmitted(parent, pending_sub_agents_from(tasks))
    ensures:
        for child in pending_sub_agents_from(tasks):
            SubAgentAdmission{child: child}.parent = parent
            SubAgentAdmission{child: child}.batch_id = invocation.batch_id
            SubAgentAdmission{child: child}.parent_terminal_disposition = owed
            child.spec.parent_conversation_id = parent.id
    ensures: SpawnAgentsCompletes(invocation,
        spawned_agents: pending_sub_agents_from(tasks))
    ensures: parallel_work_qualified(parent.resolved_model_id)
        and work_task_count(tasks) > 1
        implies TrustedSharedWorkScopeInstructionsComposed(parent, tasks)

    @guidance
        -- Per-task resolution uses the same resolved request catalog that
        -- rendered the tool schema (REQ-AG-008). Config is loaded once per
        -- parent runtime; usable routes refresh at parent request boundaries.
        -- Helpers:
        --   resolve_agent(t): selected eligible worker, or absent.
        --   resolve_execution_authority(t): explicit authority, else read_only.
        --     Worker and tier definitions never supply authority.
        --   resolve_execution(t, parent): explicit selector wins; omitted selector
        --     uses named candidates if present, else parent's entire execution.
        --     Tier/named candidates are ordered atomic model+connection+effort
        --     choices. Unavailable routes are skipped; a reached usable route
        --     with known incompatible effort invalidates the selection. Missing
        --     candidate effort uses that model's native default. Explicit model
        --     selection never falls back and never inherits effort.
        --   resolve_persona(t): selected worker's inline instructions or absent.
        --   resolve_agent_name(t): selected worker's name or absent.
        -- Resolved model, connection, effort, and persona are persisted before
        -- child execution, and restored on runtime recreation. A missing route
        -- fails without silent substitution. This does not change server-restart
        -- survival or terminal repair contracts.
        --
        --   resolve_max_turns(t):
        --     t.max_turns.present => t.max_turns
        --     resolve_execution_authority(t)=read_only =>
        --         config.default_max_turns_explore (20)
        --     resolve_execution_authority(t)=write_capable =>
        --         config.default_max_turns_work (50)
        --
        --   resolve_cwd(t, parent):
        --     t.cwd.blank_or_absent => parent.working_dir
        --     t.cwd.absolute        => t.cwd
        --     t.cwd.relative        => parent.working_dir / t.cwd
        --
        --   resolve_parent_work_scope(parent):
        --     attached(id) with the parent's exact opaque WorkScope identity when
        --     present; otherwise unattached. Every child mirrors that typed state.
        --     cwd or worktree-path equality never infers attachment.
        --
        --   validate_cwd(resolve_cwd(t, parent)) must prove the path is an
        --   existing directory after canonicalisation and that the canonical
        --   directory is not the filesystem root. Failure rejects the entire
        --   spawn call before any child conversation is persisted.
        --
        -- After this rule fires, bedrock's `SpawnAgentsCompletesAsLastTool`
        -- (or `SpawnAgentsCompletesWithMoreTools`) drives the parent into
        -- `awaiting_sub_agents` and REQ-PROJ-008's inherited-workspace contract covers
        -- the worktree-side seam.
}

------------------------------------------------------------
-- Rules: Durable child lifecycle
------------------------------------------------------------

rule CancelAdmittedChildBeforeInitialWork {
    when: SubAgentCancellationRequested(child)
    requires: SubAgentAdmission{child: child}.initial_work_dispatched = false
    ensures: SubAgentAdmission{child: child}.cancellation_requested = true
    ensures: SubAgentAdmission{child: child}.initial_work_dispatched = false
    ensures: CancelledTerminalEvidencePersisted(child)
}

rule CancelSpawnBeforeParentAdoption {
    when: SpawnBatchCancellationRequested(invocation)
    ensures: SpawnActivationWithheld(invocation)
    ensures: UnactivatedSpawnBatchClosureRequested(invocation)
}

rule ClassifyUnactivatedBatchClosure {
    when: UnactivatedSpawnBatchClosed(invocation)
    let members = SubAgentAdmissions where batch_id = invocation.batch_id
    ensures:
        for admission in members:
            admission.cancellation_requested = true
            admission.initial_work_dispatched = false
            admission.terminal_evidence_persisted = true
            admission.parent_terminal_disposition = closed_without_parent_adoption

    @guidance
        -- This is the classified native administrative closure of an unadopted
        -- batch. Its delivery suppression is not a fabricated normal parent
        -- fan-in result or a normal fan_in_accepted acknowledgement.
}

rule InitialWorkStartsIfNotCancelled {
    when: SubAgentInitialWorkRequested(child)
    requires: SubAgentAdmission{child: child}.cancellation_requested = false
    requires: SubAgentAdmission{child: child}.initial_work_dispatched = false
    requires: not SubAgentAdmission{child: child}.terminal_evidence_persisted
    requires: activation_released_after_exact_parent_membership(child)
    ensures: SubAgentAdmission{child: child}.initial_work_dispatched = true
    ensures: InitialWorkDispatched(child)
}

rule ConcurrentMaterializationJoinsByChildIdentity {
    when: SubAgentRuntimeRequested(child)
    ensures: JoinedSubAgentMaterialization(child)
    ensures: LiveRuntimeCount(child) <= 1
}

rule TerminalEvidencePrecedesParentDelivery {
    when: SubAgentReachesTerminal(child, result)
    requires: not closed_before_parent_adoption(child)
    ensures: SubAgentAdmission{child: child}.terminal_evidence_persisted = true
    ensures: ParentDeliveryOwed(
        SubAgentAdmission{child: child}.parent.id, child.id, result)
}

rule DurableParentIdentityDeliversTerminal {
    when: ParentDeliveryAttempted(child, result)
    requires: SubAgentAdmission{child: child}.terminal_evidence_persisted
    requires: SubAgentAdmission{child: child}.parent_terminal_disposition = owed
    requires: not closed_before_parent_adoption(child)
    ensures: CurrentParentRuntimeResolved(SubAgentAdmission{child: child}.parent.id)
    ensures: bedrock/ParentTerminalTransportArrived(
        SubAgentAdmission{child: child}.parent, parent_terminal_result(child, result))
}

rule ActualParentAcceptanceAcknowledgesTerminal {
    when: bedrock/SubAgentParentAcceptanceCommitted(parent, result)
    let admission = admission_for_parent_result(parent, result)
    requires: admission.terminal_evidence_persisted
    requires: not closed_before_parent_adoption(admission.child)
    ensures: admission.parent_terminal_disposition = fan_in_accepted

    @guidance
        -- This observes the same established SQLite transaction as Bedrock's
        -- exact pending -> completed adoption, not a second acknowledgement write.
        -- Transport dispatch, buffering, and a pure reducer proposal cannot set it.
}

rule ClosedUnadoptedBatchConsumesItsDelivery {
    when: ParentDeliveryAttempted(child, result)
    requires: closed_before_parent_adoption(child)
    ensures: DeliveryConsumedByBatchClosure(child)
}

rule DuplicateParentDeliveryIsIdempotent {
    when: ParentDeliveryAttempted(child, result)
    requires: SubAgentAdmission{child: child}.parent_terminal_disposition = fan_in_accepted
    ensures: ParentDeliveryAcceptedAsDuplicate(child)
    ensures: ParentResultCount(child) = previous(ParentResultCount(child))
    ensures: ParentResumeCountForChild(child) = previous(ParentResumeCountForChild(child))
}

------------------------------------------------------------
-- Rules: Tool registry selection
------------------------------------------------------------

-- ===========================================================
-- 5. PER-MODE TOOL REGISTRIES (REQ-PROJ-008)
-- ===========================================================

-- Fresh spawn: the registry is determined by the sub-agent's mode.
-- Explore => `subagent_read_only` (read-only information tools + browser +
-- sandboxed bash when the platform capability is available +
-- submit_result/submit_error). Work => `subagent_write_capable`
-- (Explore set + Work bash + patch). Both modes get the parent's MCP tool set.
--
-- Top-level Explore delegation is independent of sandbox support: the parent may
-- call `spawn_agents` even when platform capability omits bash. The spawned
-- Explore sub-agent then receives this same `subagent_read_only` registry shape
-- without bash.
-- The Explore registry never grants write-capable `patch`, and its bash entry
-- is the same OS-sandboxed, network-blocked, scratch-only bash available to a
-- top-level Explore conversation. If the platform cannot enforce that sandbox,
-- the Explore registry omits bash.
rule SubAgentRegistryOnFreshSpawn {
    when: SubAgentSpawnSucceeded(parent, sub_agent, execution_authority, cwd_override)
    ensures:
        if execution_authority = write_capable:
            sub_agent.tool_registry = subagent_write_capable
        else:
            sub_agent.tool_registry = subagent_read_only
    ensures: sub_agent.mcp_enabled = true
    ensures: sub_agent.execution_authority = write_capable implies sub_agent.bash_sandboxed = false
}

-- Resume path (`RuntimeManager::get_or_create` for a sub-agent
-- conversation): the registry is recovered from the persisted `conv_mode`
-- so the sub-agent does not lose its write capability across a restart or
-- model-upgrade eviction. Sub-agents do not normally survive server
-- restart, so this path is exercised only for in-process re-creation
-- (e.g. model upgrade).
rule SubAgentRegistryOnResume {
    when: SubAgentRuntimeResumed(sub_agent)
    ensures:
        if sub_agent.execution_authority = read_only:
            sub_agent.tool_registry = subagent_read_only
        else:
            sub_agent.tool_registry = subagent_write_capable
    ensures: sub_agent.mcp_enabled = true
    ensures: sub_agent.execution_authority = write_capable implies sub_agent.bash_sandboxed = false
    -- A named agent's persona is likewise restored on this path: it is
    -- persisted with the sub-agent conversation at spawn and re-read into the
    -- rebuilt ConvContext here, so a runtime recreated mid-run keeps it (see
    -- specs/agents/ ComposeSubAgentPersona, REQ-AG-006). Registry and persona
    -- are the two pieces of sub-agent identity that a from-DB context rebuild
    -- must recover.

    @guidance
        -- Explore children persist Explore with no owned worktree.
        -- Git-backed Work children persist the AttachedWorkChild marker; their worktree
        -- root comes from the inherited WorkScope environment, independently
        -- of a child cwd override. This mode carries no branch/task ownership.
        -- Direct Work children persist Direct. Both Work variants select
        -- ordinary unsandboxed Bash, patch, and configured MCP tools.

}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant UnqualifiedParentsHaveSequentialWorkAdmission {
    for p in bedrock.Conversation where not parallel_work_qualified(p.resolved_model_id):
        pending_work_admissions(p) <= 1
}

invariant QualificationIsExplicitAndFailClosed {
    for p in bedrock.Conversation:
        parallel_work_qualified(p.resolved_model_id)
            = (p.resolved_model_id in {
                "gpt-5.6-sol", "gpt-5.6-terra", "gpt-6-astra", "gpt-6-sol" })
}

invariant AdmittedChildStartsAtMostOnce {
    for admission in SubAgentAdmission:
        InitialWorkDispatchCount(admission.child) <= 1
}

invariant ParentAcceptsChildTerminalAtMostOnce {
    for admission in SubAgentAdmission:
        ParentResultCount(admission.child) <= 1
        and ParentResumeCountForChild(admission.child) <= 1
}

invariant ClosedBeforeAdoptionNeverStartsChildWork {
    for admission in SubAgentAdmissions where parent_terminal_disposition = closed_without_parent_adoption:
        admission.cancellation_requested
        and admission.terminal_evidence_persisted
        and not admission.initial_work_dispatched
        and ParentResultCount(admission.child) = 0
}

-- Work children start within the parent's worktree when it has one.
-- They are trusted writers; this is not a filesystem security boundary.
invariant WorkSubAgentCwdInsideWorktree {
    for sa in SubAgents where sa.execution_authority = write_capable and sa.parent.worktree_path != absent:
        is_within(sa.working_dir, sa.parent.worktree_path)
}

-- Child execution authority selects tools independently of parent provenance.
invariant ToolRegistryMatchesMode {
    for sa in SubAgents:
        (sa.execution_authority = read_only
            implies sa.tool_registry = subagent_read_only)
        and
        (sa.execution_authority = write_capable
            implies sa.tool_registry = subagent_write_capable)
}

------------------------------------------------------------
-- Actors and Surfaces
------------------------------------------------------------

actor SpawnAdmissionOwner {
    identified_by: String
}

surface NativeSpawnAdoptionBoundary {
    facing owner: SpawnAdmissionOwner
    context invocation: SpawnInvocation

    contracts:
        fulfils SpawnParentAdoption

    provides:
        UnactivatedSpawnBatchClosed(invocation)
            when owner_controls_batch(owner, invocation)
                 and unactivated_batch_closure_established(invocation)
        SpawnBatchClosureFailed(invocation, reason)
            when owner_controls_batch(owner, invocation)
        SpawnBatchAuthorityUnclassified(invocation)
            when owner_controls_batch(owner, invocation)

    @guarantee OneClassifiedResponseForTheOwnedOperation
        -- Observations come from the exact native response/activation owner and
        -- its classified database operation. Cancellation cannot mint Closed;
        -- it suppresses activation while retaining reconciliation ownership.
        -- No request retry, second durable store, or new restart policy is implied.
        -- A call of UnactivatedSpawnBatchClosureRequested is consumed by this
        -- fulfilled native operation and returns exactly one Closed, Failed, or
        -- Unclassified observation above, preserving any error diagnostics.

    @guidance
        -- The request invokes the owning native unactivated-batch operation;
        -- these observations are its actual classified return, not a free-standing
        -- trigger queue or another workflow. Native admission must finish before
        -- absence or complete terminalization can be established for that batch.
}

------------------------------------------------------------
-- Helpers
------------------------------------------------------------
-- owner_controls_batch(owner, invocation) -> Boolean: the native response and
--   activation owner is bound to invocation.batch_id and its exact parent/call.
-- unactivated_batch_closure_established(invocation) -> Boolean: the native owner
--   established rejection/no admission, or complete terminalization of the exact
--   expected unadopted membership with no initial dispatch or activation release.
--   An operation result detached from that membership/activation proof is not
--   this receipt, and an already-adopted batch cannot select this disposition.
-- activation_released_after_exact_parent_membership(child) -> Boolean: the native
--   activation receiver was released only after the parent state committed the
--   complete exact admitted batch membership. Admission alone is false; an
--   unadopted cancelled batch never receives this activation release.
-- closed_before_parent_adoption(child) -> Boolean: this admission's disjoint
--   parent_terminal_disposition is closed_without_parent_adoption. The exact
--   unactivated-batch receipt consumed its undelivered admission before
--   adoption. Its administrative delivery suppression is distinct from a normal
--   parent fan-in acceptance, even if the implementation uses the same timestamp
--   column for both dispositions. Do not infer this from initial-work absence.
-- parent_terminal_result(child, result) -> bedrock/SubAgentResult: preserve the
--   exact child identity and complete terminal payload for parent transport.
-- admission_for_parent_result(parent, result) -> SubAgentAdmission: the admission
--   whose exact child identity is result.agent_id and durable parent is parent.
-- parallel_work_qualified(model_id: String) -> Boolean
--   True exactly for gpt-5.6-sol, gpt-5.6-terra, gpt-6-astra, and gpt-6-sol.
--   False for gpt-5.6-luna, gpt-6-luna, every Anthropic identifier in the supported catalog, custom
--   routes, unknown identifiers, and newly introduced identifiers.
-- pending_work_admissions(parent: Conversation) -> Integer
--   Counts durable write-capable admissions whose parent_terminal_disposition is owed.
-- batch_is_otherwise_valid(parent: Conversation, tasks: List<SubAgentTask>) -> Boolean
--   True exactly when every non-qualification validation in this specification
--   succeeds for the complete batch.
-- batch_is_admissible(parent: Conversation, tasks: List<SubAgentTask>) -> Boolean
--   True exactly when the complete batch satisfies every validation and the
--   applicable qualified or sequential Work admission rule.
-- TrustedSharedWorkScopeInstructionsComposed(parent, tasks) -> Boolean
--   True exactly when parent instructions assign partitioning and integration,
--   and each Work child is told that trusted collaborators share the exact
--   WorkScope, to preserve unrelated edits, and to report overlap or conflict.
