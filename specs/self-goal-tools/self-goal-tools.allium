-- allium: 3
-- REQ-SGT-001 through REQ-SGT-008; shared effects use the existing Goal writer
-- and canonical tool checkpoint, not a separate scheduler.

entity Owner {
    enabled: Boolean
    disable_epoch: Integer
    goal_exists: Boolean
}

entity Admission {
    owner: Owner
    disable_epoch: Integer
    live_current_ordinary_execution: Boolean
    generation_matches: Boolean
    controls_allow: Boolean
    open_current_transcript: Boolean
    executing_tools: Boolean
}

entity CheckpointRound {
    operations: Operation with round = this
    mixed_operations: operations.any(operation => operation.kind = enable)
        and operations.any(operation => operation.kind = create)

    @invariant CanonicalSource
        -- Membership is the complete own-management operation set from one canonical
        -- assistant tool round. Source and integrity failures abort the transaction.
        -- Classification applies only on first application, after retained replay.
}

entity Operation {
    admission: Admission
    round: CheckpointRound
    kind: enable | create
    state: pending | accepted | refused
    source_matches: Boolean
    canonical_result_retained: Boolean
    @invariant AtomicCheckpoint
        -- Effect or semantic refusal, retained tool result, selected state and carried
        -- provider replay, task proposal or terminal obligation commit atomically.
        -- Source and storage integrity failures abort the checkpoint, not a tool refusal.

    @invariant ImmutableReplay
        -- A retained accepted or refused result is historical and immutable. Exact replay
        -- does not reapply the effect, refresh admission, or overwrite a later disable.
        -- Changed source, arguments, authority or canonical evidence rejects replay.

    @invariant NoExecutionAuthority
        -- These operations cannot dispatch work, release Stop or pause, rearm exhaustion,
        -- reactivate a Goal, change current-turn Goal binding, expand scope, or target
        -- another conversation. Create never enables automation; enable never creates.
}

rule ExplicitDisable {
    when: DisableRequested(owner)
    ensures:
        owner.enabled = false
        owner.disable_epoch = owner.disable_epoch + 1
}

rule AdmitTurn {
    when: TurnAdmitted(admission)
    ensures:
        admission.disable_epoch = admission.owner.disable_epoch
}

rule AcceptEnable {
    when: Checkpoint(operation)
    requires:
        operation.state = pending
        operation.kind = enable
        not operation.round.mixed_operations
        operation.source_matches
        operation.admission.live_current_ordinary_execution
        operation.admission.generation_matches
        operation.admission.controls_allow
        operation.admission.open_current_transcript
        operation.admission.executing_tools
        operation.admission.disable_epoch = operation.admission.owner.disable_epoch
    ensures:
        operation.admission.owner.enabled = true
        operation.state = accepted
        operation.canonical_result_retained = true
}

rule AcceptCreate {
    when: Checkpoint(operation)
    requires:
        operation.state = pending
        operation.kind = create
        not operation.round.mixed_operations
        operation.source_matches
        operation.admission.live_current_ordinary_execution
        operation.admission.generation_matches
        operation.admission.controls_allow
        operation.admission.open_current_transcript
        operation.admission.executing_tools
        operation.admission.disable_epoch = operation.admission.owner.disable_epoch
        operation.admission.owner.enabled
        not operation.admission.owner.goal_exists
    ensures:
        operation.admission.owner.goal_exists = true
        operation.state = accepted
        operation.canonical_result_retained = true
}

rule RefuseMixedOperations {
    when: Checkpoint(operation)
    requires:
        operation.state = pending
        not operation.canonical_result_retained
        operation.round.mixed_operations
        operation.source_matches
        operation.admission.live_current_ordinary_execution
        operation.admission.generation_matches
        operation.admission.controls_allow
        operation.admission.open_current_transcript
        operation.admission.executing_tools
        operation.admission.disable_epoch = operation.admission.owner.disable_epoch
    ensures:
        operation.state = refused
        operation.canonical_result_retained = true

    @guidance
        -- Every own-management intent in the mixed round receives the refusal
        -- mixed_self_goal_operations without Goal or preference mutation, regardless
        -- of initial preference or order. Admission and human-control refusals retain
        -- precedence. Other tool results remain in the same atomic checkpoint.
        -- Exact retained evidence replays before first-application classification;
        -- integrity failures still abort rather than becoming semantic refusals.
}
