-- allium: 3
-- steering-messages.allium
--
-- Phoenix Steering Message Queue: Behavioural Specification
--
-- Scope: User-directed message queue for conversations that are busy
-- Includes: Enqueuing messages when conversation is_busy,
--           FIFO drain-all delivery at idle entry and at mid-turn
--             LlmRequesting entry from a tool round,
--           user cancellation of queued entries,
--           persistence and crash recovery,
--           SSE notification of queue mutations and reconnect snapshots
-- Excludes:
--   - Conversation state machine transitions other than the
--     SteerDrainedUserMessages arms (see bedrock.allium)
--   - LLM delivery after drained entries become UserMessages (see bedrock.allium)
--   - @file / message expansion mechanics (the expand() call that produces
--     llm_text and skill_invocation from the raw request text; governed
--     by the inline-references spec and shared with the normal send path)
--   - UI rendering of queued messages (steering bubble, cancel affordance)
--   - Sub-agent conversations (steering only applies to Parent conversations)
--
-- Architecture: Executor-owned queue + typed bedrock delivery event.
--   Event::SteerMessage and Event::CancelSteerMessage are intercepted by
--   the executor before the transition function — bedrock has no awareness
--   of the queue's existence. Drained entries, however, are delivered to
--   bedrock via Event::SteerDrainedUserMessages { entries }, which bedrock
--   handles with explicit transition arms from Idle and from LlmRequesting.
--
--   The queue's existence stays orthogonal to bedrock, while the delivery
--   contract is typed in bedrock. The reducer selects the exact FIFO batch,
--   next state, and post-commit LLM action in one CommitSteeringDrain effect.
--
--   The queue is persisted in the steering_messages table (one row per entry,
--   ordered by ordinal; each entry's attachments live in the grandchild
--   steering_message_files / steering_message_images tables) and loaded into
--   executor memory on startup. Startup drains use the same reducer and atomic
--   transaction as live drains.
--
--   Accepted client identities also have an immutable durable fingerprint.
--   This identity record is not queue state: the pending queue determines
--   whether a request is queued, and the transcript determines whether it was
--   delivered. An identity found in neither is terminal and cannot be admitted
--   again. Legacy pending identities with no recoverable fingerprint are
--   represented explicitly and validated against their durable queue payload.
--
-- Requirement traceability: REQ-STEER-001 through REQ-STEER-005

use "../bedrock/bedrock.allium" as bedrock

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- A pending steering entry, structurally identical to a UserMessage payload.
-- Persisted as a steering_messages row (with attachments in the grandchild
-- tables) and held in the executor's in-memory queue.
value SteerEntry {
    -- Human-readable display text. Always present.
    text: String
    -- Text sent to the LLM, with @file references expanded inline.
    -- Absent when expansion produced no change. Both llm_text and
    -- skill_invocation below are outputs of the same expansion step.
    llm_text: String?
    -- Image attachments (mirrors the normal send path). Persisted as
    -- steering_message_images rows keyed by message_id.
    images: List<ImageData>
    -- Non-image file attachments (mirrors the normal send path). Persisted as
    -- steering_message_files rows keyed by message_id.
    files: List<FileAttachment>
    -- Client-generated UUID. Used as the cancellation key.
    message_id: String
    -- HTTP User-Agent of the originating client, for tracing.
    user_agent: String?
    -- Skill invocation context extracted by the message expander from the
    -- request text. Absent when the message did not trigger a skill.
    -- Populated by the same expand() call that fills llm_text.
    skill_invocation: SkillInvocation?
}

value ImageData {
    media_type: String
    -- Base64-encoded image bytes.
    data: String
}

value FileAttachment {
    original_name: String
    media_type: String
    size_bytes: Integer
    -- Server-side path where the uploaded bytes are stored.
    stored_path: String
}

value SkillInvocation {
    skill_name: String
    args: String?
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- SteeringQueue is a per-conversation ordered buffer of pending messages.
-- It is orthogonal to the conversation core_status: entries accumulate
-- while the conversation is busy and are delivered as a batch at the next
-- drain hook point (turn-end idle entry, or mid-turn LlmRequesting entry
-- from a tool round).
--
-- One SteeringQueue exists per Conversation (one-to-one, by construction).
entity SteeringQueue {
    conversation: bedrock.Conversation

    -- Ordered list of pending entries; front = next to be delivered.
    entries: List<SteerEntry>

    -- Derived: number of entries currently pending.
    depth: entries.count

    invariant DepthNonNegative {
        depth >= 0
    }

    invariant UniqueMessageIds {
        -- Each message_id appears at most once in the queue.
        for e in entries:
            entries.count(f => f.message_id = e.message_id) = 1
    }
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- REQ-STEER-001
-- A message sent while the conversation is busy is accepted as a steering
-- entry rather than rejected. It is appended to the queue and persisted
-- before the SSE acknowledgement is emitted.
rule EnqueueSteeringMessage {
    when: UserSendsMessage(conversation, text, llm_text?, images,
                           message_id, user_agent?, skill_invocation?)
    requires: conversation.is_busy
    requires: not conversation.is_terminal
    for q in SteeringQueue where q.conversation = conversation:
        -- Entry appended at the tail; all prior entries are undisturbed.
        ensures: q.entries.last = SteerEntry {
                     text: text,
                     llm_text: llm_text,
                     images: images,
                     message_id: message_id,
                     user_agent: user_agent,
                     skill_invocation: skill_invocation
                 }
        -- The client receives a zero-based position indicating its place in line.
        ensures: SteerMessageQueuedEmitted(conversation, q.entries.last,
                     queue_position = q.depth)
        -- HTTP response confirms the message was accepted as a steering entry.
        ensures: ChatResponseSent(conversation, message_id, steering = true)

    @guidance
        -- queue_position is zero-based at the time of enqueue. The first message
        -- queued receives position 0, the second position 1, and so on. Position
        -- is not adjusted when earlier entries are cancelled; it reflects the
        -- snapshot at enqueue time.
        --
        -- @file references in text are expanded before constructing the SteerEntry;
        -- the expanded content is stored in llm_text. If expansion fails, the
        -- message is still enqueued with llm_text absent.
        --
        -- Persistence order: Database::append_steering_entry inserts only the
        -- new queue row and its immutable acceptance identity in one transaction,
        -- then returns the committed zero-based FIFO position. Existing rows are
        -- never rewritten, so a concurrent drain cannot be resurrected from a
        -- stale queue snapshot. Only after commit does the runtime publish
        -- SteerMessageQueued and deliver Event::SteerMessage to the executor.
        -- A failed append persists neither row and publishes no success event or
        -- HTTP success.
        -- Runtime ownership is revalidated after acquiring the queue projection
        -- fence and held through channel admission. If the previously observed
        -- executor was retired, enqueue retries against the current executor
        -- before committing, so no accepted row is sent to a retired channel.
}

-- REQ-STEER-002
-- When a conversation transitions into idle and its queue is non-empty,
-- ALL queued entries are drained as a batch and delivered as UserMessages
-- in FIFO order. The conversation re-enters llm_requesting to respond.
rule DrainOnIdleEntry {
    when: conversation: bedrock.Conversation.core_status transitions_to idle
    -- Turn-end only: error dismissal (error -> idle) is the user clearing a
    -- banner, not a turn completing, so it must not drain the queue. The
    -- dismissal edge emits bedrock.ErrorDismissed; this guard excludes it so
    -- queued steers wait for an explicit retry/send. See bedrock's
    -- UserDismissesError.
    requires: not bedrock.ErrorDismissed(conversation)
    for q in SteeringQueue where q.conversation = conversation and q.depth > 0:
        -- The entire queue is taken; nothing remains.
        ensures: q.depth = 0
        -- Every drained entry becomes a UserMessage; FIFO order is preserved
        -- by the implementation (Vec iteration order = enqueue order).
        ensures: q.entries.all(e =>
                     bedrock.UserSendsMessage(conversation,
                         e.text, e.llm_text, e.images,
                         e.message_id, e.user_agent, e.skill_invocation))
        -- A single RequestLlm is issued after all persists, so the LLM call
        -- sees every freshly-persisted message.
        ensures: bedrock.RequestLlmIssued(conversation)

    @guidance
        -- Triggers on transitions whose destination state is idle and that
        -- represent turn completion (e.g., cancelling_tool -> idle,
        -- cancelling_sub_agents -> idle, llm_requesting -> idle). The one
        -- excluded source is error dismissal (error -> idle, bedrock's
        -- UserDismissesError): the requires guard above drops it because the
        -- user is clearing a banner, not completing a turn, so queued steers
        -- must wait for an explicit retry/send.
        --
        -- Drain-all (not one-at-a-time): the executor takes the complete durable
        -- FIFO snapshot under the queue projection fence. The bedrock arm emits
        -- one CommitSteeringDrain effect carrying that exact ordered batch and
        -- StartLlmAndNotifyState. The executor supplies the reducer's next state.
        --
        -- Single RequestLlm: only one is emitted regardless of how many entries
        -- were drained. The next LLM call sees all N messages as freshly-persisted
        -- transcript context.
        --
        -- Inline processing: the drain event is processed inside the same
        -- apply_transition_result call that triggered the hook, not via the
        -- outer event loop. This is what makes ordering deterministic.
        --
        -- Database::commit_steering_drain inserts every supplied transcript
        -- message, persists the supplied state, and deletes only the supplied
        -- queue ids in one transaction. Failure rolls back all three. Messages,
        -- state, and RequestLlm are published only after commit. A concurrent
        -- enqueue has a different id and survives the exact deletes.
        -- If the transaction commits but the LLM task cannot start, the
        -- synchronous failure is reduced from LlmRequesting into a persisted
        -- typed Error. The committed messages remain and the deleted queue rows
        -- are neither recreated nor redrained.
        -- Starting this drained batch as a new user turn resets the parent
        -- tool-cycle budget before RequestLlm; a mid-turn drain does not reset
        -- the existing turn's budget.
        --
        -- Startup routes the durable queue through this same reducer arm. A
        -- matching pre-transaction message is a typed legacy partial and is
        -- consumed without duplication. A mismatched identity or stale batch
        -- fails once, leaves the durable queue intact, and stops that runtime so
        -- a later reconstruction retries from database truth.
        -- Once the transaction has committed LlmRequesting and removed the
        -- exact queue row, the immutable acceptance identity plus the latest
        -- transcript user message form bounded restart ownership until the
        -- first provider response changes the transcript tail. Recovery resumes
        -- one request without adding a steering lifecycle or queue authority.
        --
        -- FIFO is preserved: entries are stored in a Vec with append-at-tail
        -- enqueue. std::mem::take preserves Vec order; iteration in the bedrock
        -- arm emits persist effects in the same order.
}

-- A steer may be accepted while the durable state is busy but arrive on the
-- executor channel after that executor has already reached idle. Treat the
-- late arrival as the missed idle drain hook rather than waiting for another
-- unrelated transition.
rule DrainWhenSteerArrivesAfterIdle {
    when: SteerMessageReceivedByExecutor(conversation)
    requires: conversation.core_status = idle
    for q in SteeringQueue where q.conversation = conversation and q.depth > 0:
        ensures: q.depth = 0
        ensures: q.entries.all(e =>
                     bedrock.UserSendsMessage(conversation,
                         e.text, e.llm_text, e.images,
                         e.message_id, e.user_agent, e.skill_invocation))
        ensures: bedrock.RequestLlmIssued(conversation)

    @guidance
        -- The executor appends the received entry, atomically takes the full
        -- queue, and routes SteerDrainedUserMessages through the normal Idle
        -- bedrock arm. That arm owns transcript persistence, durable queue
        -- removal, state notification, and the single RequestLlm effect.
}

-- REQ-STEER-005
-- When a conversation transitions into llm_requesting from a tool round
-- (executing_tools or awaiting_sub_agents) and the queue is non-empty,
-- ALL queued entries are drained and persisted as UserMessages in FIFO order
-- BEFORE the prior transition's RequestLlm spawns the LLM task. The
-- in-flight LLM call sees the steered messages deterministically.
rule DrainOnEnteringLlmRoundFromToolRound {
    when: conversation: bedrock.Conversation.core_status
        transitions_to llm_requesting
    requires: conversation.previous_core_status in {
        executing_tools, awaiting_sub_agents
    }
    for q in SteeringQueue where q.conversation = conversation and q.depth > 0:
        -- Drained ids removed from queue; concurrently-enqueued ids preserved.
        ensures: q.entries.all(e =>
                     bedrock.UserSendsMessage(conversation,
                         e.text, e.llm_text, e.images,
                         e.message_id, e.user_agent, e.skill_invocation))
        -- The bedrock arm itself does NOT emit a new RequestLlm. The executor's
        -- deferred-RequestLlm machinery (see @guidance) runs the original
        -- transition's RequestLlm AFTER drain persists, so the in-flight call
        -- sees the steered messages.
        ensures: not bedrock.NewRequestLlmIssuedByDrainArm(conversation)

    @guidance
        -- The bedrock state-machine transition that goes
        --   executing_tools -> llm_requesting  (or)
        --   awaiting_sub_agents -> llm_requesting
        -- emits Effect::RequestLlm as part of its effects (the conversation
        -- is going to ask the LLM to interpret the tool results).
        --
        -- The executor's `run_effects_with_inline_drain` handles this:
        --   1. Defers any Effect::RequestLlm from the original effects.
        --   2. Runs the remaining original effects.
        --   3. Synchronously transitions (LlmRequesting, SteerDrainedUserMessages)
        --      and runs its single CommitSteeringDrain effect.
        --   4. Runs the deferred RequestLlm. The spawned LLM task's
        --      build_llm_messages_static reads a DB that already contains the
        --      steered messages — deterministic, no race.
        --
        -- This eliminates the race that would otherwise occur if RequestLlm
        -- spawned the LLM task before the drain's persist effects ran. It also
        -- closes the failure mode where a no-tool LLM response would settle
        -- the conversation to Idle with steers persisted but unanswered.
        --
        -- CommitSteeringDrain atomically inserts the exact FIFO batch, persists
        -- the reducer's LlmRequesting state, and deletes only those queue ids.
        -- The deferred RequestLlm runs only after commit. A failed transaction
        -- performs no publication or dispatch and is not retried while holding
        -- the projection fence. The runtime exits; its successor reconstructs
        -- the untouched batch from database truth.
        -- If the transaction commits but the deferred RequestLlm cannot start,
        -- that synchronous failure is reduced through the same persisted typed
        -- Error path as a turn-end steering drain. The committed messages remain
        -- and the exact drained queue rows remain absent.
}

-- REQ-STEER-003
-- A queued steering entry can be cancelled before it is drained.
-- Cancellation of an existing entry commits before its live projection.
rule CancelExistingSteeringMessage {
    when: UserCancelsSteeringMessage(conversation, message_id)
    for q in SteeringQueue where q.conversation = conversation:
        requires: q.entries.any(e => e.message_id = message_id)
        ensures: not q.entries.any(e => e.message_id = message_id)
        ensures: SteerMessageCancelledEmitted(conversation, message_id)

    @guidance
        -- Database::remove_steering_entry returns true only when its committed
        -- DELETE removed a row. That true result is the publication fence:
        -- SteerMessageCancelled is sent live to every authorized client only
        -- after commit, then the executor removes its in-memory projection.
        -- If no executor is running, the DB mutation is sufficient: the next
        -- executor loads the already-corrected queue from durable state.
        -- Runtime startup and queue mutations share a per-conversation fence.
        -- Startup reloads the durable queue while holding that fence immediately
        -- before publishing and spawning the executor. Before draining, the
        -- executor reloads the durable queue under the same fence and holds it
        -- until persistence and removal commit. Cancellation and delivery thus
        -- have one durable winner: a committed cancellation is filtered before
        -- use, while a completed drain makes the later delete report no removal.
        -- Earlier queue_position values are not rewritten after cancellation;
        -- clients treat them as enqueue-time ordering witnesses.
}

-- Cancellation is idempotent when the entry is already gone.
rule CancelAbsentSteeringMessage {
    when: UserCancelsSteeringMessage(conversation, message_id)
    for q in SteeringQueue where q.conversation = conversation:
        requires: not q.entries.any(e => e.message_id = message_id)
        ensures: not q.entries.any(e => e.message_id = message_id)
        ensures: not SteerMessageCancelledEmitted(conversation, message_id)

    @guidance
        -- HTTP returns 200 because the requested postcondition already holds.
        -- No false cancellation event is published for an absent row.
        -- The idempotent in-memory executor removal is still delivered, repairing
        -- an earlier cancellation interrupted after its durable delete.
}

-- REQ-STEER-004
-- A terminal conversation cannot accept new steering entries.
rule TerminalConversationRejectsSteer {
    when: UserSendsMessage(conversation, _, _, _, message_id, _, _)
    requires: conversation.is_terminal

    ensures: SteerRejected(conversation, message_id)

    @guidance
        -- The same API endpoint handles both idle sends and steering sends.
        -- When the conversation is terminal (context_exhausted or terminal
        -- parent_status), the request is rejected before any queue logic runs.
        -- The HTTP response carries an error indicating the conversation cannot
        -- accept messages.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Each conversation has at most one SteeringQueue (one-to-one by construction).
invariant OneQueuePerConversation {
    for c in bedrock.Conversation:
        count(SteeringQueue where conversation = c) <= 1
}

-- The queue depth is always non-negative (also enforced at entity level).
invariant AllQueuesNonNegative {
    for q in SteeringQueue:
        q.depth >= 0
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor User {
    identified_by: bedrock.Parent
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface SteeringQueueApi {
    facing user: User

    context conversation: bedrock.Parent

    exposes:
        conversation.core_status
        conversation.is_busy

    provides:
        -- Enqueue or send (behaviour depends on conversation.is_busy at call time)
        UserSendsMessage(conversation, text, llm_text?, images,
                         message_id, user_agent?, skill_invocation?)
            when not conversation.is_terminal
        -- Cancel a specific queued message by its client-generated ID
        UserCancelsSteeringMessage(conversation, message_id)

    @guarantee IdempotentCancel
        -- Cancelling a message_id that is absent from the queue returns HTTP 200.
        -- No error is raised and no state change occurs.

    @guarantee SteerMessageQueuedAck
        -- When a message is accepted as a steering entry (conversation was busy
        -- at call time), the HTTP response body contains { steering: true } and
        -- an SSE event carrying the renderable SteerEntry and its queue position
        -- is emitted live to all connected authorized clients before the response
        -- is flushed. It is not replayed; init reconstructs the durable queue.

    @guarantee AuthoritativeQueueProjection
        -- A newly-subscribed client receives the complete persisted queue in
        -- FIFO order. Live enqueue and cancellation events mutate that same
        -- projection, so browser-local send state is never required to render
        -- a server-accepted steering message.

    @guarantee SteerMessageCancelledAck
        -- After cancellation is durable, all connected clients receive the
        -- cancelled message_id and remove that queued entry if present. An
        -- idempotent retry of an already-absent id emits no second event.

    @guarantee DirectSendTransparency
        -- When a message is sent while the conversation is idle, { steering: false }
        -- is returned and the message enters the normal bedrock delivery path.
        -- No SteerMessageQueued event is emitted.

    @guarantee PersistenceBeforeResponse
        -- In all cases that mutate the queue (enqueue, cancel), the DB reflects
        -- the new state before the HTTP response is returned to the caller.

    @guarantee DurableSteeringIdempotency
        -- A retry whose accepted identity is still queued returns the queued
        -- outcome; an identity present in the transcript returns the delivered
        -- outcome; an accepted identity present in neither returns a stable
        -- terminal outcome. An exact fingerprint mismatch is rejected. A
        -- legacy pending identity without a recoverable fingerprint is checked
        -- against its durable queue payload. Cancellation and drain never erase
        -- the immutable acceptance identity.

    @guarantee PendingQueueFencesDirectAcceptance
        -- Message admission is serialized per conversation from before state
        -- observation through validation and durable acceptance. A busy send
        -- therefore reserves its place before slow payload work, and a non-empty
        -- durable steering queue prevents a later idle observation from routing
        -- into direct-turn acceptance. A durable direct-turn owner also fences an
        -- idle observation until the accepted turn becomes visible as busy. The
        -- later request joins the steering queue,
        -- covering the window where a steer was accepted while busy but reaches
        -- the executor after it became idle. The state is checked again before
        -- acceptance; terminal and interaction-blocked states reject rather than
        -- parking an undeliverable message. Error recovery remains a direct turn
        -- so it cannot be stranded behind a queue that error dismissal does not
        -- drain. Admission for unrelated conversations remains independent.

    @guarantee AcceptedDirectTurnPrecedesStartupDrain
        -- When an accepted direct turn has not yet materialized its authoritative
        -- user message, startup recovery and live idle notifications leave the
        -- durable steering queue untouched. The direct-turn worker materializes
        -- that accepted turn first; the ordinary turn-end hook then drains the
        -- queued steering batch in durable FIFO order.

    @guarantee CancelledDirectTurnReleasesDeferredSteering
        -- Cancelling an unmaterialized direct turn while its conversation is
        -- idle attempts an executor wake after durable cancellation. The wake
        -- settles as Applied, NothingToDrain, Conflict, or DispatchFailed.
        -- NothingToDrain starts no LLM request and leaves no idle runtime behind.
        -- Applied reloads queue authority and submits the exact durable batch to
        -- the ordinary reducer-owned drain transaction. Conflict reports that
        -- durable queue work could not be reconciled with the current state.
        -- The wake holds the conversation admission gate through the executor
        -- acknowledgement that carries this settlement. A surviving durable row
        -- yields Conflict even when an unrelated turn has entered Error, so
        -- aggregate runtime state cannot impersonate a steering result.
        -- DispatchFailed reports that the batch committed but the LLM could not
        -- start; the reducer-owned Error state is durable and visible, and the
        -- exact drained rows are absent from the queue.

    @guarantee MidTurnDrainSemantics
        -- Steers queued while the conversation is busy may be delivered at one
        -- of two points: turn-end (entering idle) or mid-turn (entering
        -- llm_requesting from executing_tools or awaiting_sub_agents) —
        -- whichever comes first. At each hook ALL queued entries drain together
        -- as a batch; the queue is never partially drained. The drained
        -- entries are persisted to the transcript BEFORE the LLM task is
        -- spawned (inline drain + deferred RequestLlm in the executor), so the
        -- in-flight LLM call deterministically observes the steered messages.
        -- The drain preserves the existing turn's tool-cycle budget. A
        -- synchronous failure to start the deferred request settles as a
        -- durable typed Error after the atomic drain commit.

    @guarantee CommittedTurnRestartRecovery
        -- A committed drain awaiting its first provider response resumes one
        -- LLM request after reconstruction. The immutable acceptance identity,
        -- latest transcript user message, and absence of that exact pending
        -- queue row are the bounded evidence. The first provider response ends
        -- this exception; no second queue authority or steering lifecycle exists.

    @guarantee EnqueueDuringDrainPreserved
        -- A steering message enqueued while a drain is in progress is not lost.
        -- Database::commit_steering_drain deletes only the reducer-supplied
        -- message_ids, while Database::append_steering_entry inserts only the
        -- new row. Neither path rewrites rows owned by the other mutation.
}
