-- allium: 3
-- steering-messages.allium
--
-- Phoenix Steering Message Queue: Behavioural Specification
--
-- Scope: User-directed message queue for conversations that are busy
-- Includes: Enqueuing messages when conversation is_busy,
--           FIFO drain-all delivery at idle entry and at mid-turn
--             LlmRequesting entry from a tool round,
--           user cancellation of queued entries,
--           persistence and crash recovery,
--           SSE notification of queuing
-- Excludes:
--   - Conversation state machine transitions other than the
--     SteerDrainedUserMessages arms (see bedrock.allium)
--   - LLM delivery after drained entries become UserMessages (see bedrock.allium)
--   - @file / message expansion mechanics (the expand() call that produces
--     llm_text and skill_invocation from the raw request text; governed
--     by the inline-references spec and shared with the normal send path)
--   - UI rendering of queued messages (steering bubble, cancel affordance)
--   - Sub-agent conversations (steering only applies to Parent conversations)
--
-- Architecture: Executor-owned queue + typed bedrock delivery event.
--   Event::SteerMessage and Event::CancelSteerMessage are intercepted by
--   the executor before the transition function — bedrock has no awareness
--   of the queue's existence. Drained entries, however, are delivered to
--   bedrock via Event::SteerDrainedUserMessages { entries }, which bedrock
--   handles with explicit transition arms from Idle and from LlmRequesting.
--
--   Trade-off: the queue's existence stays orthogonal to bedrock (state
--   machine purity preserved), but the delivery contract — "drained steers
--   become UserMessages in the transcript" — is typed in bedrock. This
--   preserves the single-writer transcript-persistence invariant: all user
--   messages, including drained steers, flow through Effect::persist_user_message.
--
--   The queue is persisted in the DB steering_queue column (JSON) and loaded
--   into executor memory on startup, enabling crash recovery without
--   re-delivery (PRIMARY KEY on message_id prevents double-insert).
--
-- Requirement traceability: REQ-STEER-001 through REQ-STEER-005

use "./bedrock.allium" as bedrock

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- A pending steering entry, structurally identical to a UserMessage payload.
-- Stored in the DB as JSON and held in the executor's in-memory queue.
value SteerEntry {
    -- Human-readable display text. Always present.
    text: String
    -- Text sent to the LLM, with @file references expanded inline.
    -- Absent when expansion produced no change. Both llm_text and
    -- skill_invocation below are outputs of the same expansion step.
    llm_text: String?
    -- Image attachments (mirrors the normal send path).
    images: List<ImageData>
    -- Client-generated UUID. Used as the cancellation key.
    message_id: String
    -- HTTP User-Agent of the originating client, for tracing.
    user_agent: String?
    -- Skill invocation context extracted by the message expander from the
    -- request text. Absent when the message did not trigger a skill.
    -- Populated by the same expand() call that fills llm_text.
    skill_invocation: SkillInvocation?
}

value ImageData {
    media_type: String
    -- Base64-encoded image bytes.
    data: String
}

value SkillInvocation {
    skill_name: String
    args: String?
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- SteeringQueue is a per-conversation ordered buffer of pending messages.
-- It is orthogonal to the conversation core_status: entries accumulate
-- while the conversation is busy and are delivered as a batch at the next
-- drain hook point (turn-end idle entry, or mid-turn LlmRequesting entry
-- from a tool round).
--
-- One SteeringQueue exists per Conversation (one-to-one, by construction).
entity SteeringQueue {
    conversation: bedrock.Conversation

    -- Ordered list of pending entries; front = next to be delivered.
    entries: List<SteerEntry>

    -- Derived: number of entries currently pending.
    depth: entries.count

    invariant DepthNonNegative {
        depth >= 0
    }

    invariant UniqueMessageIds {
        -- Each message_id appears at most once in the queue.
        for e in entries:
            entries.count(f => f.message_id = e.message_id) = 1
    }
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- REQ-STEER-001
-- A message sent while the conversation is busy is accepted as a steering
-- entry rather than rejected. It is appended to the queue and persisted
-- before the SSE acknowledgement is emitted.
rule EnqueueSteeringMessage {
    when: UserSendsMessage(conversation, text, llm_text?, images,
                           message_id, user_agent?, skill_invocation?)
    requires: conversation.is_busy
    requires: not conversation.is_terminal
    for q in SteeringQueue where q.conversation = conversation:
        -- Entry appended at the tail; all prior entries are undisturbed.
        ensures: q.entries.last = SteerEntry {
                     text: text,
                     llm_text: llm_text,
                     images: images,
                     message_id: message_id,
                     user_agent: user_agent,
                     skill_invocation: skill_invocation
                 }
        -- The client receives a zero-based position indicating its place in line.
        ensures: SteerMessageQueuedEmitted(conversation, message_id,
                     queue_position = q.depth)
        -- HTTP response confirms the message was accepted as a steering entry.
        ensures: ChatResponseSent(conversation, message_id, steering = true)

    @guidance
        -- queue_position is zero-based at the time of enqueue. The first message
        -- queued receives position 0, the second position 1, and so on. Position
        -- is not adjusted when earlier entries are cancelled; it reflects the
        -- snapshot at enqueue time.
        --
        -- @file references in text are expanded before constructing the SteerEntry;
        -- the expanded content is stored in llm_text. If expansion fails, the
        -- message is still enqueued with llm_text absent.
        --
        -- Persistence order (P1): enqueue_steer_message() reads the current queue
        -- from DB, appends the new SteerEntry, and writes the updated queue to DB
        -- *before* sending Event::SteerMessage to the executor channel. The HTTP
        -- response is returned only after the DB write succeeds. This guarantees
        -- that a crash between acceptance and executor processing does not lose
        -- the entry.
}

-- REQ-STEER-002
-- When a conversation transitions into idle and its queue is non-empty,
-- ALL queued entries are drained as a batch and delivered as UserMessages
-- in FIFO order. The conversation re-enters llm_requesting to respond.
rule DrainOnIdleEntry {
    when: conversation: bedrock.Conversation.core_status transitions_to idle
    -- Turn-end only: error dismissal (error -> idle) is the user clearing a
    -- banner, not a turn completing, so it must not drain the queue. The
    -- dismissal edge emits bedrock.ErrorDismissed; this guard excludes it so
    -- queued steers wait for an explicit retry/send. See bedrock's
    -- UserDismissesError.
    requires: not bedrock.ErrorDismissed(conversation)
    for q in SteeringQueue where q.conversation = conversation and q.depth > 0:
        -- The entire queue is taken; nothing remains.
        ensures: q.depth = 0
        -- Every drained entry becomes a UserMessage; FIFO order is preserved
        -- by the implementation (Vec iteration order = enqueue order).
        ensures: q.entries.all(e =>
                     bedrock.UserSendsMessage(conversation,
                         e.text, e.llm_text, e.images,
                         e.message_id, e.user_agent, e.skill_invocation))
        -- A single RequestLlm is issued after all persists, so the LLM call
        -- sees every freshly-persisted message.
        ensures: bedrock.RequestLlmIssued(conversation)

    @guidance
        -- Triggers on transitions whose destination state is idle and that
        -- represent turn completion (e.g., cancelling_tool -> idle,
        -- cancelling_sub_agents -> idle, llm_requesting -> idle). The one
        -- excluded source is error dismissal (error -> idle, bedrock's
        -- UserDismissesError): the requires guard above drops it because the
        -- user is clearing a banner, not completing a turn, so queued steers
        -- must wait for an explicit retry/send.
        --
        -- Drain-all (not one-at-a-time): the executor uses std::mem::take to swap
        -- the entire Vec<SteerEntry> out atomically. The bedrock arm for
        -- (Idle, SteerDrainedUserMessages) emits one Effect::persist_user_message
        -- per entry in iteration order, then Effect::PersistState, then
        -- Effect::ClearSteeringQueueEntries { message_ids }, then
        -- NotifyLlmRequesting, and finally Effect::RequestLlm. The effect loop
        -- runs persist effects serially, each allocating a sequential
        -- sequence_id, so transcript order is FIFO and matches enqueue order.
        --
        -- Single RequestLlm: only one is emitted regardless of how many entries
        -- were drained. The next LLM call sees all N messages as freshly-persisted
        -- transcript context.
        --
        -- Inline processing: the drain event is processed inside the same
        -- apply_transition_result call that triggered the hook, not via the
        -- outer event loop. This is what makes ordering deterministic.
        --
        -- Crash recovery: ClearSteeringQueueEntries removes ONLY the drained
        -- message_ids (not the whole queue), so a concurrent enqueue during
        -- the drain window is preserved. It runs AFTER persist effects, so a
        -- crash mid-drain leaves the drained entries in the DB queue. On
        -- restart the queue reloads; the next drain hook re-fires
        -- SteerDrainedUserMessages with the same entries; Effect::PersistMessage
        -- skips already-persisted entries via a storage.message_exists()
        -- precheck gated by an idempotent: bool flag (so non-replayable
        -- persists pay no extra DB query). At-least-once delivery without
        -- double-insertion.
        --
        -- FIFO is preserved: entries are stored in a Vec with append-at-tail
        -- enqueue. std::mem::take preserves Vec order; iteration in the bedrock
        -- arm emits persist effects in the same order.
}

-- REQ-STEER-005
-- When a conversation transitions into llm_requesting from a tool round
-- (executing_tools or awaiting_sub_agents) and the queue is non-empty,
-- ALL queued entries are drained and persisted as UserMessages in FIFO order
-- BEFORE the prior transition's RequestLlm spawns the LLM task. The
-- in-flight LLM call sees the steered messages deterministically.
rule DrainOnEnteringLlmRoundFromToolRound {
    when: conversation: bedrock.Conversation.core_status
        transitions_to llm_requesting
    requires: conversation.previous_core_status in {
        executing_tools, awaiting_sub_agents
    }
    for q in SteeringQueue where q.conversation = conversation and q.depth > 0:
        -- Drained ids removed from queue; concurrently-enqueued ids preserved.
        ensures: q.entries.all(e =>
                     bedrock.UserSendsMessage(conversation,
                         e.text, e.llm_text, e.images,
                         e.message_id, e.user_agent, e.skill_invocation))
        -- The bedrock arm itself does NOT emit a new RequestLlm. The executor's
        -- deferred-RequestLlm machinery (see @guidance) runs the original
        -- transition's RequestLlm AFTER drain persists, so the in-flight call
        -- sees the steered messages.
        ensures: not bedrock.NewRequestLlmIssuedByDrainArm(conversation)

    @guidance
        -- The bedrock state-machine transition that goes
        --   executing_tools -> llm_requesting  (or)
        --   awaiting_sub_agents -> llm_requesting
        -- emits Effect::RequestLlm as part of its effects (the conversation
        -- is going to ask the LLM to interpret the tool results).
        --
        -- The executor's `run_effects_with_inline_drain` handles this:
        --   1. Defers any Effect::RequestLlm from the original effects.
        --   2. Runs the remaining original effects.
        --   3. Synchronously transitions (LlmRequesting, SteerDrainedUserMessages)
        --      and runs its effects (N Effect::persist_user_message,
        --      Effect::PersistState, Effect::ClearSteeringQueueEntries).
        --   4. Runs the deferred RequestLlm. The spawned LLM task's
        --      build_llm_messages_static reads a DB that already contains the
        --      steered messages — deterministic, no race.
        --
        -- This eliminates the race that would otherwise occur if RequestLlm
        -- spawned the LLM task before the drain's persist effects ran. It also
        -- closes the failure mode where a no-tool LLM response would settle
        -- the conversation to Idle with steers persisted but unanswered.
        --
        -- ClearSteeringQueueEntries removes only the drained ids (not the whole
        -- queue), so a concurrent enqueue during the drain window is preserved.
        -- Crash recovery: queue updated AFTER persist effects, so a crash
        -- mid-drain reloads the drained entries on restart; idempotent
        -- PersistMessage (gated by idempotent: bool, via storage.message_exists)
        -- prevents double-insertion on re-drain.
}

-- REQ-STEER-003
-- A queued steering entry can be cancelled before it is drained.
-- Cancellation by message_id is idempotent: if the entry is already gone
-- (drained or never existed), the operation succeeds silently.
rule CancelSteeringMessage {
    when: UserCancelsSteeringMessage(conversation, message_id)
    for q in SteeringQueue where q.conversation = conversation:
        ensures: not q.entries.any(e => e.message_id = message_id)

    @guidance
        -- The HTTP response is 200 OK in all cases, including when no entry with
        -- the given message_id exists in the queue. The caller cannot distinguish
        -- a successful cancel from a cancel of an already-drained entry; this is
        -- intentional: the postcondition "entry is not in queue" holds in both cases.
        --
        -- Cancel sequence (P2): the handler updates the DB first, then sends
        -- Event::CancelSteerMessage{message_id} to the live executor (if one is
        -- currently loaded) via try_get_handle(). The executor removes the matching
        -- entry from its in-memory steering_queue without a further DB write.
        -- If no executor is running, the DB update alone is sufficient: the next
        -- executor to start loads the already-corrected queue from DB.
        --
        -- queue_position values reported in earlier SteerMessageQueuedEmitted
        -- events are not retroactively adjusted after a cancel. Clients should
        -- treat queue_position as an ordering hint at enqueue time, not a live index.
}

-- REQ-STEER-004
-- A terminal conversation cannot accept new steering entries.
rule TerminalConversationRejectsSteer {
    when: UserSendsMessage(conversation, _, _, _, message_id, _, _)
    requires: conversation.is_terminal

    ensures: SteerRejected(conversation, message_id)

    @guidance
        -- The same API endpoint handles both idle sends and steering sends.
        -- When the conversation is terminal (context_exhausted or terminal
        -- parent_status), the request is rejected before any queue logic runs.
        -- The HTTP response carries an error indicating the conversation cannot
        -- accept messages.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Each conversation has at most one SteeringQueue (one-to-one by construction).
invariant OneQueuePerConversation {
    for c in bedrock.Conversation:
        count(SteeringQueue where conversation = c) <= 1
}

-- The queue depth is always non-negative (also enforced at entity level).
invariant AllQueuesNonNegative {
    for q in SteeringQueue:
        q.depth >= 0
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor User {
    identified_by: bedrock.Parent
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface SteeringQueueApi {
    facing user: User

    context conversation: bedrock.Parent

    exposes:
        conversation.core_status
        conversation.is_busy

    provides:
        -- Enqueue or send (behaviour depends on conversation.is_busy at call time)
        UserSendsMessage(conversation, text, llm_text?, images,
                         message_id, user_agent?, skill_invocation?)
            when not conversation.is_terminal
        -- Cancel a specific queued message by its client-generated ID
        UserCancelsSteeringMessage(conversation, message_id)

    @guarantee IdempotentCancel
        -- Cancelling a message_id that is absent from the queue returns HTTP 200.
        -- No error is raised and no state change occurs.

    @guarantee SteerMessageQueuedAck
        -- When a message is accepted as a steering entry (conversation was busy
        -- at call time), the HTTP response body contains { steering: true } and
        -- an SSE event SteerMessageQueued { message_id, queue_position } is
        -- emitted to all connected clients before the response is flushed.

    @guarantee DirectSendTransparency
        -- When a message is sent while the conversation is idle, { steering: false }
        -- is returned and the message enters the normal bedrock delivery path.
        -- No SteerMessageQueued event is emitted.

    @guarantee PersistenceBeforeResponse
        -- In all cases that mutate the queue (enqueue, cancel), the DB reflects
        -- the new state before the HTTP response is returned to the caller.

    @guarantee MidTurnDrainSemantics
        -- Steers queued while the conversation is busy may be delivered at one
        -- of two points: turn-end (entering idle) or mid-turn (entering
        -- llm_requesting from executing_tools or awaiting_sub_agents) —
        -- whichever comes first. At each hook ALL queued entries drain together
        -- as a batch; the queue is never partially drained. The drained
        -- entries are persisted to the transcript BEFORE the LLM task is
        -- spawned (inline drain + deferred RequestLlm in the executor), so the
        -- in-flight LLM call deterministically observes the steered messages.

    @guarantee EnqueueDuringDrainPreserved
        -- A steering message enqueued while a drain is in progress is not lost.
        -- Effect::ClearSteeringQueueEntries removes only the specific drained
        -- message_ids (not the whole queue); the DB method
        -- Database::remove_steering_entries does read-filter-write under a
        -- transaction so a concurrent enqueue's read-append-write cannot be
        -- clobbered.
}
