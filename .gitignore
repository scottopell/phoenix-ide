static/dist/

# Local config (machine-specific LLM credentials)
.phoenix-ide.env

# Tools
# Ignore local Claude state, but track the committed Claude Code on the web
# setup hook + its registration so web sessions start with a warm toolchain.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/session-start.sh
.playwright-mcp/
.phoenix/
dogfood-output
scripts/install.sh

# UI audit screenshots — captured locally, not for git history
ui-audit/screenshots/
